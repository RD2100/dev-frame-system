{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test results phase result (dev team, test-results.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactPath", "summary", "passed", "failed", "blocked"],
  "properties": {
    "artifactPath": {
      "type": "string",
      "pattern": "^test-results\\.md$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "blocked": {
      "type": "integer",
      "minimum": 0
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "severity", "description"],
        "properties": {
          "taskId": { "type": "string", "pattern": "^TASK-\\d+$" },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor", "cosmetic"]
          },
          "description": { "type": "string", "minLength": 1 },
          "stepsToReproduce": { "type": "string" },
          "expectedResult": { "type": "string" },
          "actualResult": { "type": "string" }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
