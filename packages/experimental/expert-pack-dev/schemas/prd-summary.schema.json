{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRD phase result (dev team, prd.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactPath", "summary", "userStories"],
  "properties": {
    "artifactPath": {
      "type": "string",
      "pattern": "^prd\\.md$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "userStories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "capability", "value"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
