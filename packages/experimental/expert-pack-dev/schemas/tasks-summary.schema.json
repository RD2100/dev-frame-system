{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task breakdown phase result (dev team, tasks.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactPath", "summary", "tasks"],
  "properties": {
    "artifactPath": {
      "type": "string",
      "pattern": "^tasks\\.md$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "acceptanceCriteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^TASK-\\d+$" },
          "description": { "type": "string", "minLength": 1 },
          "acceptanceCriteria": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^TASK-\\d+$" }
          },
          "complexity": {
            "type": "string",
            "enum": ["S", "M", "L"]
          },
          "assignee": {
            "type": "string",
            "enum": ["engineer", "qa"]
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
