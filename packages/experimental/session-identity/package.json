    "@deepseek-ai/dsh-worktree-registry": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-experimental-project-contracts": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
