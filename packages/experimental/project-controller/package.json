{
  "name": "@deepseek-ai/dsh-experimental-project-controller",
  "description": "Cordis service owning the project task board: TaskState transitions with recovery triples, a bounded developing-task budget, project lifecycle, and the controller-only main-tree merge gate",
  "version": "0.1.2-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./consumer": {
      "types": "./lib/types/consumer.d.ts",
      "default": "./lib/consumer.js"
    },
    "./task-consumer": {
      "types": "./lib/types/task-consumer.d.ts",
      "default": "./lib/task-consumer.js"
    },
    "./delivery-consumer": {
      "types": "./lib/types/delivery-consumer.d.ts",
      "default": "./lib/delivery-consumer.js"
    },
    "./completion-consumer": {
      "types": "./lib/types/completion-consumer.d.ts",
      "default": "./lib/completion-consumer.js"
    },
    "./request-budget-consumer": {
      "types": "./lib/types/request-budget-consumer.d.ts",
      "default": "./lib/request-budget-consumer.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/consumer.js",
    "lib/task-consumer.js",
    "lib/delivery-consumer.js",
    "lib/completion-consumer.js",
    "lib/request-budget-consumer.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
