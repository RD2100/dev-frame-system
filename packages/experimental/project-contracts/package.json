{
  "name": "@deepseek-ai/dsh-experimental-project-contracts",
  "description": "Shared type vocabulary for the pluginized DSH agent hierarchy: roles, task states, branded ids, binding and task records, persistence seams, and stable error types",
  "version": "0.1.6-alpha.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/project-contracts"
  },
