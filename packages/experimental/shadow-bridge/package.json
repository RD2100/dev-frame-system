{
  "name": "@deepseek-ai/dsh-experimental-shadow-bridge",
  "description": "Host-side function plugin that forwards the shadow router's forwardable received work deliveries into the bound controller sessions' model-visible follow-ups, exactly once per delivery across restarts",
  "version": "0.1.2-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
