{
  "name": "@deepseek-ai/dsh-experimental-expert-pack-paper",
  "description": "Paper-research data pack for the expert-team plugin: ten Chinese-primary expert personas, a ten-phase human-gated pipeline with parallel review and revision, acceptance handoff checks, review skills, and phase-result JSON Schemas mounted through the core's Config.packs",
  "version": "0.1.6-alpha.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/expert-pack-paper"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "experts/**",
    "skills/**",
    "team.yml",
    "schemas/**"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
