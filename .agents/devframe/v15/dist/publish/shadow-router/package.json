{
  "name": "@deepseek-ai/dsh-experimental-shadow-router",
  "description": "Cordis service routing user intent between independent project roots: a durable controller-binding store, cross-root delivery persistence with distinct received and completed states, and the four model-facing project tools behind a Shadow-only whitelist",
  "version": "0.1.2-alpha.4",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-brand": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-experimental-session-identity": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-goal": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-workspace": ">=0.1.2-alpha.4 <1.0.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RD2100/dsh-devframe.git"
  }
}
