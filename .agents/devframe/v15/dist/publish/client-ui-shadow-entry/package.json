{
  "name": "@deepseek-ai/dsh-experimental-client-ui-shadow-entry",
  "description": "Web sidebar Shadow entry card: resident status surface over the Shadow controller",
  "version": "0.1.2-alpha.4",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RD2100/dsh-devframe.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-experimental-shadow-controller"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-experimental-shadow-controller": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-experimental-shadow-router": ">=0.1.2-alpha.4 <1.0.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-alpha.4 <1.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
