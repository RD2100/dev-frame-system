@@ -0,0 +1,140 @@
+// @vitest-environment jsdom
+/** CodeGraph context parser and read-only details preview coverage. */
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import type { ToolResultNode } from '@deepseek-ai/dsh-client-runtime/client'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import { zh } from '@deepseek-ai/dsh-client-ui-conversation/src/client/locales.ts'
+import { GraphContextBlock } from '../src/client/tool/graph/GraphContextBlock.tsx'
+import { ToolCallTree } from '../src/client/tool/ToolCallTree.tsx'
+import type { ToolTreeProps } from '../src/client/contract/slots.ts'
+import { ToolDetails } from '../src/client/tool/ToolDetails.tsx'
+import {
+  CODEGRAPH_CONTEXT_TOOL, graphContextModel,
+} from '../src/client/tool/graph/graph-context-model.ts'
+
+afterEach(cleanup)
+
+const t = makeTranslate(zh, commonZh)
+
+const payload = (over: Record<string, unknown> = {}): string => JSON.stringify({
+  status: 'matched',
+  workspace: { id: 'dev-frame-system', title: 'DevFrame' },
+  freshness: 'current',
+  trustedForCurrentRun: false,
+  summary: 'bounded graph context',
+  nodes: [
+    { id: 'file-a', kind: 'file', label: 'src/a.ts', source: 'src/a.ts', startLine: 1, endLine: 12 },
+    { id: 'fn-a', kind: 'function', label: 'buildGraph', source: 'src/a.ts', startLine: 4, endLine: 8 },
+  ],
+  edges: [{ id: 'edge-0', source: 'file-a', target: 'fn-a', kind: 'contains' }],
+  relatedFiles: ['src/a.ts'],
+  stats: { nodeCount: 2, edgeCount: 1, fileCount: 1, truncated: false },
+  ...over,
+})
+
+function result(text: string, over: Partial<ToolResultNode> = {}): ToolResultNode {
+  return {
+    kind: 'tool-result', seq: 1, time: 1, callId: 'graph-1',
+    call: { name: CODEGRAPH_CONTEXT_TOOL, argsRaw: '{}' }, callTime: 1,
+    content: [{ type: 'text', text }], isError: false,
+    callView: null, resultView: null, subCalls: [], ...over,
+  }
+}
+
+describe('graphContextModel', () => {
+  it('ignores unrelated tools and marks a running graph call', () => {
+    expect(graphContextModel(result('{}', { call: { name: 'read', argsRaw: '{}' } }))).toBeNull()
+    expect(graphContextModel({
+      callId: 'graph-1', name: CODEGRAPH_CONTEXT_TOOL, argsRaw: '{}', turn: 1, step: 1, time: 1,
+      callView: null, subCalls: [],
+    })).toEqual({ state: 'running' })
+  })
+
+  it('accepts the bounded untrusted projection and preserves safe metadata', () => {
+    const model = graphContextModel(result(payload()), 'D:/workspace')
+    expect(model?.state).toBe('ready')
+    if (model?.state !== 'ready') throw new Error('expected a ready graph context model')
+    expect(model.value.status).toBe('matched')
+    expect(model.value.freshness).toBe('current')
+    expect(model.value.trustedForCurrentRun).toBe(false)
+    expect(model.value.nodes.some(node => node.id === 'fn-a' && node.kind === 'function')).toBe(true)
+    expect(model.value.edges).toEqual([
+      { id: 'edge-0', source: 'file-a', target: 'fn-a', kind: 'contains' },
+    ])
+  })
+
+  it('fails closed for errors, empty output, malformed JSON, and trusted payloads', () => {
+    expect(graphContextModel(result('', { isError: true }))).toEqual({ state: 'unavailable', reason: 'error' })
+    expect(graphContextModel(result(''))).toEqual({ state: 'unavailable', reason: 'empty' })
+    expect(graphContextModel(result('{'))).toEqual({ state: 'unavailable', reason: 'invalid' })
+    expect(graphContextModel(result(payload({ trustedForCurrentRun: true })))).toEqual({ state: 'unavailable', reason: 'invalid' })
+  })
+
+  it('rejects unsafe paths and edges that escape the validated node set', () => {
+    expect(graphContextModel(result(payload({ relatedFiles: ['../secret.txt'] })))).toEqual({ state: 'unavailable', reason: 'invalid' })
+    expect(graphContextModel(result(payload({ edges: [{ source: 'file-a', target: 'missing', kind: 'contains' }] })))).toEqual({ state: 'unavailable', reason: 'invalid' })
+    expect(graphContextModel(result(payload({ summary: 'token=leaked' })))).toEqual({ state: 'unavailable', reason: 'invalid' })
+  })
+
+  it('renders bounded metadata, filters kinds, and exposes local node inspection', () => {
+    render(<GraphContextBlock model={graphContextModel(result(payload()), 'D:/workspace')!} t={t} />)
+    expect(screen.getByText('CodeGraph 上下文预览')).toBeTruthy()
+    expect(screen.getByText('非信任项目上下文')).toBeTruthy()
+    expect(screen.getByText('bounded graph context')).toBeTruthy()
+    expect(screen.getAllByRole('button')).toHaveLength(2)
+    fireEvent.change(screen.getByLabelText('节点类型'), { target: { value: 'function' } })
+    expect(screen.getAllByRole('button')).toHaveLength(1)
+    fireEvent.click(screen.getByRole('button', { name: /buildGraph/ }))
+    expect(screen.getByText(/function · fn-a/)).toBeTruthy()
+    expect(screen.getByText(/src\/a\.ts:4–8/)).toBeTruthy()
+  })
+
+  it('renders a localized unavailable state without exposing raw output', () => {
+    render(<GraphContextBlock model={{ state: 'unavailable', reason: 'invalid' }} t={t} />)
+    expect(screen.getByRole('status').textContent).toBe('CodeGraph 上下文暂不可用')
+    expect(screen.queryByText(/status/)).toBeNull()
+  })
+
+  it('takes over the production details branch and never falls back to raw JSON', () => {
+    const block = result(payload())
+    render(<ToolDetails
+      block={block}
+      cwd="D:/workspace"
+      useHostDescription={selector => selector(undefined)}
+      t={t}
+    />)
+    expect(screen.getByText('CodeGraph 上下文预览')).toBeTruthy()
+    expect(screen.queryByText(/trustedForCurrentRun/)).toBeNull()
+  })
+
+  it('opens the existing details column only for a settled graph call', () => {
+    const openDetails = vi.fn()
+    const node = {
+      key: 'graph-node', id: 'graph-1', kind: 'tool-call', target: 'chat', anchorSeq: 4,
+      location: {
+        kind: 'step',
+        turn: { turn: 2, start: undefined, end: undefined, status: 'closed', steps: [], data: { get: () => undefined } },
+        step: { turn: 2, step: 1, start: undefined, end: undefined, status: 'closed', data: { get: () => undefined } },
+      },
+      visibility: 'visible', data: { root: result(payload()) },
+    } as unknown as ToolTreeProps['node']
+    const renderSlot = ((_key, _owner, options) => options?.fallback ?? null) as ToolTreeProps['renderSlot']
+    render(<ToolCallTree {...({
+      renderSlot,
+      node,
+      openDetails,
+      openFile: vi.fn(),
+      inspectCall: vi.fn(),
+      useHostDescription: (selector => selector(undefined)) as ToolTreeProps['useHostDescription'],
+      t,
+    } as unknown as ToolTreeProps)} />)
+
+    fireEvent.click(screen.getByRole('button', { name: /Tool call/ }))
+    fireEvent.click(screen.getByRole('button', { name: '打开详情', exact: true }))
+    expect(openDetails).toHaveBeenCalledWith({
+      turnSeq: 2, stepSeq: 1, callId: 'graph-1', toolName: CODEGRAPH_CONTEXT_TOOL,
+    })
+  })
+})
