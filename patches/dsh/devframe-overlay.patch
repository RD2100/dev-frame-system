--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/MemoryCard.tsx
@@ -0,0 +1,104 @@
+import { useEffect, useState, type ChangeEvent } from 'react'
+import type { WorkspaceId, WorkspaceListState } from '@deepseek-ai/dsh-client-runtime/client'
+import type { SnapshotSelectorHook, TranslateNS } from '@deepseek-ai/dsh-client-ui-slots'
+import type {
+  DevFrameHealthSnapshot,
+  MemoryOpenResult,
+} from '@deepseek-ai/dsh-devframe-control-session/types'
+import { NS } from './locales.ts'
+import css from './MemoryCard.module.css'
+
+export interface MemoryCardProps {
+  readonly health: DevFrameHealthSnapshot | undefined
+  readonly useWorkspaces: SnapshotSelectorHook<WorkspaceListState>
+  readonly openMemory: (workspaceId: WorkspaceId) => Promise<MemoryOpenResult>
+  readonly refreshHealth: () => void
+  readonly t: TranslateNS<typeof NS>
+}
+
+type OpenState = 'idle' | 'opening' | 'opened' | 'missing' | 'stale' | 'unavailable'
+
+/** Workspace-scoped, pathless Obsidian opener for the Global Controller. */
+export function MemoryCard({ health, useWorkspaces, openMemory, refreshHealth, t }: MemoryCardProps) {
+  const workspaces = useWorkspaces(state => state.items)
+  const [selectedWorkspaceId, setSelectedWorkspaceId] = useState<WorkspaceId | undefined>(
+    workspaces[0]?.workspaceId,
+  )
+  const [openState, setOpenState] = useState<OpenState>('idle')
+  const memory = health?.items.find(item => item.id === 'memory')
+
+  useEffect(() => {
+    if (selectedWorkspaceId !== undefined
+      && workspaces.some(item => item.workspaceId === selectedWorkspaceId)) return
+    setSelectedWorkspaceId(workspaces[0]?.workspaceId)
+  }, [selectedWorkspaceId, workspaces])
+
+  // Let the Host perform the first probe when memory is still unprobed. The
+  // server remains the authority and will return a bounded unavailable result
+  // if the gateway or native opener is not ready.
+  const canOpen = memory !== undefined && selectedWorkspaceId !== undefined
+  const select = (event: ChangeEvent<HTMLSelectElement>): void => {
+    setSelectedWorkspaceId(event.target.value as WorkspaceId)
+    setOpenState('idle')
+  }
+  const open = (): void => {
+    if (memory === undefined || selectedWorkspaceId === undefined) return
+    setOpenState('opening')
+    void openMemory(selectedWorkspaceId).then((result) => {
+      setOpenState(result.opened
+        ? 'opened'
+        : result.status === 'current' ? 'unavailable' : result.status)
+      refreshHealth()
+    }).catch(() => {
+      setOpenState('unavailable')
+      refreshHealth()
+    })
+  }
+
+  return (
+    <div className={css.card} role="status">
+      <span className={css.title}>{t('global.memory')}</span>
+      {health === undefined
+        ? <span className={css.muted}>{t('health.unavailable')}</span>
+        : memory === undefined
+          ? <span className={css.muted}>{t('health.unavailable')}</span>
+          : <div className={css.statusRow}>
+            <span className={`${css.dot} ${css[memory.status]}`} aria-hidden="true" />
+            <span>memory</span>
+            <span>{t(`health.${memory.status}`)}</span>
+            {memory.reason !== undefined && <span className={css.reason}>{memory.reason}</span>}
+          </div>}
+      <span className={css.note}>{t('memory.browserBoundary')}</span>
+      {workspaces.length === 0
+        ? <span className={css.muted}>{t('project.empty')}</span>
+        : <div className={css.controls}>
+          <label className={css.label}>
+            <span>{t('memory.workspace')}</span>
+            <select
+              aria-label={t('memory.workspace')}
+              value={selectedWorkspaceId ?? ''}
+              onChange={select}
+            >
+              {workspaces.map(workspace => (
+                <option key={workspace.workspaceId} value={workspace.workspaceId}>
+                  {workspace.title}
+                </option>
+              ))}
+            </select>
+          </label>
+          <button
+            type="button"
+            className={css.open}
+            disabled={!canOpen || openState === 'opening'}
+            onClick={open}
+          >
+            {openState === 'opening' ? t('memory.openBusy') : t('memory.open')}
+          </button>
+        </div>}
+      {openState === 'opened' && <span className={css.success}>{t('memory.opened')}</span>}
+      {openState === 'missing' && <span className={css.muted}>{t('memory.noCurrent')}</span>}
+      {openState === 'stale' && <span className={css.muted}>{t('memory.stale')}</span>}
+      {openState === 'unavailable' && <span className={css.error} role="alert">{t('memory.openError')}</span>}
+    </div>
+  )
+}
