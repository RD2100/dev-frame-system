+/**
+ * Host Codex control-plane tests. These call the public ApiProxy methods so
+ * ownership, workspace resolution, provider projection, and URL validation
+ * are exercised together at the Host boundary.
+ */
+
+import { describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type {
+  CodexLoginStartResult,
+  CodexLoginStatus,
+  CodexSubscriptionCapabilities,
+} from '@deepseek-ai/dsh-agent-runtime-codex'
+import LlmRuntime from '@deepseek-ai/dsh-llm'
+import SessionStore from '@deepseek-ai/dsh-session'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import UserQuestionService from '@deepseek-ai/dsh-user-questions'
+import type { RpcRequest, RpcResponse } from '../src/api/rpc.ts'
+import { RpcId } from '../src/api/rpc.ts'
+import { createApiProxy } from '../src/api-proxy.ts'
+import ApiProxyService from '../src/index.ts'
+import { toFetchHandler } from '../src/fetch/handler.ts'
+import { InProcessApiClient } from '../src/fetch/client.ts'
+
+type Capabilities = (cwd: string, signal: AbortSignal) => Promise<CodexSubscriptionCapabilities>
+type LoginStart = (cwd: string, signal: AbortSignal) => Promise<CodexLoginStartResult>
+type LoginStatus = (attemptId: string) => CodexLoginStatus
+type LoginCancel = (attemptId: string, signal: AbortSignal) => Promise<CodexLoginStatus>
+
+interface FakeCodexService {
+  capabilities: ReturnType<typeof vi.fn<Capabilities>>
+  loginStart: ReturnType<typeof vi.fn<LoginStart>>
+  loginStatus: ReturnType<typeof vi.fn<LoginStatus>>
+  loginCancel: ReturnType<typeof vi.fn<LoginCancel>>
+}
+
+// The Host aggregate intentionally type-checks package tests against the
+// referenced apiproxy declaration output. Keep this test's wire view local so
+// a fresh checkout does not require generated `lib/types` artifacts first.
+type CodexAttemptId = string
+type CodexLoginAttemptStatus =
+  | { attemptId: CodexAttemptId; state: 'pending' }
+  | { attemptId: CodexAttemptId; state: 'completed' }
+  | { attemptId: CodexAttemptId; state: 'cancelled'; errorCode: 'CODEX_LOGIN_CANCELLED' }
+  | { attemptId: CodexAttemptId; state: 'failed'; errorCode: Exclude<string, 'CODEX_LOGIN_CANCELLED'> }
+type CodexStatusValue =
+  | { availability: 'ready' }
+  | { availability: 'login-required' }
+  | { availability: 'unsupported' }
+  | { availability: 'unavailable'; errorCode: 'CODEX_LOGIN_PROTOCOL_ERROR' | 'CODEX_LOGIN_PROCESS_ERROR' }
+  | CodexLoginAttemptStatus
+
+interface CodexHostApi {
+  codex: {
+    status(
+      request: RpcRequest<{ sessionId: SessionId; attemptId?: CodexAttemptId }>,
+      signal?: AbortSignal,
+    ): Promise<RpcResponse<CodexStatusValue>>
+    loginStart(request: RpcRequest<{ sessionId: SessionId }>, signal?: AbortSignal): Promise<RpcResponse<{
+      kind: 'success'
+      attemptId: CodexAttemptId
+      authUrl: string
+    } | { kind: 'failure'; errorCode: string }>>
+    loginCancel(
+      request: RpcRequest<{ sessionId: SessionId; attemptId: CodexAttemptId }>,
+      signal?: AbortSignal,
+    ): Promise<RpcResponse<CodexLoginAttemptStatus>>
+  }
+}
+
+interface CodexClient {
+  codex: {
+    status(payload: { sessionId: SessionId; attemptId?: CodexAttemptId }, signal?: AbortSignal): Promise<RpcResponse<CodexStatusValue>>
+    loginStart(payload: { sessionId: SessionId }, signal?: AbortSignal): Promise<RpcResponse<{
+      kind: 'success'
+      attemptId: CodexAttemptId
+      authUrl: string
+    } | { kind: 'failure'; errorCode: string }>>
+    loginCancel(
+      payload: { sessionId: SessionId; attemptId: CodexAttemptId },
+      signal?: AbortSignal,
+    ): Promise<RpcResponse<CodexLoginAttemptStatus>>
+  }
+}
+
+const AUTH_URL = [
+  'https://auth.openai.com/oauth/authorize?client_id=dsh',
+  '&redirect_uri=http%3A%2F%2Flocalhost%3A1455%2Fauth%2Fcallback&state=opaque',
+].join('')
+const ATTEMPTS = [
+  '11111111-1111-4111-8111-111111111111',
+  '22222222-2222-4222-8222-222222222222',
+  '33333333-3333-4333-8333-333333333333',
+  '44444444-4444-4444-8444-444444444444',
+  '55555555-5555-4555-8555-555555555555',
+  '66666666-6666-4666-8666-666666666666',
+  '77777777-7777-4777-8777-777777777777',
+] as const
+
+let nextRpc = 1
+let nextSession = 1
+
+function request<P>(payload: P): RpcRequest<P> {
+  return { rpcId: RpcId(`codex-${String(nextRpc++)}`), payload }
+}
+
+function expectValue<T>(response: RpcResponse<T>): T {
+  expect(response.result.ok).toBe(true)
+  if (!response.result.ok) throw new Error('expected successful response')
+  return response.result.value
+}
+
+function capabilities(
+  account: CodexSubscriptionCapabilities['account'] = {
+    available: true,
+    authKind: 'chatgpt',
+    planType: 'plus',
+    requiresOpenaiAuth: false,
+  },
+): CodexSubscriptionCapabilities {
+  return {
+    account,
+    models: [{
+      id: 'gpt-codex-fixture',
+      displayName: 'GPT Codex Fixture',
+      hidden: false,
+      reasoning: true,
+      supportedReasoningEfforts: ['minimal', 'high'],
+      defaultReasoningEffort: 'minimal',
+      isDefault: true,
+    }],
+  }
+}
+
+function fakeService(): FakeCodexService {
+  return {
+    capabilities: vi.fn<Capabilities>().mockResolvedValue(capabilities()),
+    loginStart: vi.fn<LoginStart>().mockResolvedValue({ attemptId: ATTEMPTS[0], authUrl: AUTH_URL }),
+    loginStatus: vi.fn<LoginStatus>().mockImplementation(attemptId => ({ attemptId, state: 'pending' })),
+    loginCancel: vi.fn<LoginCancel>().mockImplementation(async attemptId => ({
+      attemptId,
+      state: 'cancelled',
+      errorCode: 'CODEX_LOGIN_CANCELLED',
+    })),
+  }
+}
+
+async function harness(options: {
+  cwd?: string
+  service?: FakeCodexService
+  mountService?: boolean
+  productionService?: boolean
+} = {}): Promise<{ ctx: Context; api: CodexHostApi; sessionId: SessionId; service?: FakeCodexService }> {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SystemPrompt, { persona: '' })
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(UserQuestionService)
+  await ctx.plugin(AgentRegistry)
+  const session = ctx.sessions.create(undefined, {
+    meta: { cwd: options.cwd ?? '/fallback/project' },
+  })
+  const agent = {
+    id: session.id,
+    session,
+    status: 'running',
+    ctx,
+    inbox: { nextTurn: [], nextStep: [] },
+  } as unknown as Agent
+  ctx.agents.register(agent)
+  if (options.mountService !== false) {
+    const service = options.service ?? fakeService()
+    ctx.provide('codexSubscription', service as never)
+  }
+  const api = options.productionService
+    ? (() => {
+      ctx.provide('agentDefaultModel', {
+        currentSelection: () => ({ provider: 'deepseek-official', model: 'deepseek-chat' }),
+        saveSelection: async () => undefined,
+      })
+      return new ApiProxyService(ctx, {}) as unknown as CodexHostApi
+    })()
+    : createApiProxy(ctx, {
+      defaultModelSelection: () => ({ provider: 'deepseek-official', model: 'deepseek-chat' }),
+      cwd: '/fallback/project',
+    }) as unknown as CodexHostApi
+  return {
+    ctx,
+    api,
+    sessionId: session.id,
+    ...options.mountService === false ? {} : { service: options.service ?? (ctx.get('codexSubscription') as unknown as FakeCodexService) },
+  }
+}
+
+function registerAgent(ctx: Context, cwd: string): SessionId {
+  const session = ctx.sessions.create(`codex-extra-${String(nextSession++)}` as SessionId, { meta: { cwd } })
+  const agent = {
+    id: session.id,
+    session,
+    status: 'running',
+    ctx,
+    inbox: { nextTurn: [], nextStep: [] },
+  } as unknown as Agent
+  ctx.agents.register(agent)
+  return session.id
+}
+
+function isAttemptStatus(value: CodexStatusValue): value is CodexLoginAttemptStatus {
+  return 'attemptId' in value
+}
+
+function inProcess(api: CodexHostApi): InProcessApiClient & CodexClient {
+  const handler = toFetchHandler(api as unknown as Parameters<typeof toFetchHandler>[0])
+  // The Host aggregate may resolve the pre-generated client declaration before
+  // the new codex member is emitted; retain the runtime-verified bridge type.
+  // oxlint-disable-next-line typescript/no-unnecessary-type-assertion
+  return new InProcessApiClient(handler) as unknown as InProcessApiClient & CodexClient
+}
+
+describe('Host ApiProxy Codex control plane', () => {
