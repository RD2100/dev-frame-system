+/** Install the one-shot Host review submission tool on a live reviewer scope. */
+function installReviewSubmissionTool(
+  reviewer: Agent,
+  submit: (submission: PendingReviewSubmission) => void,
+): () => void {
+  let submitted = false
+  return reviewer.ctx.tools.register(defineTool({
+    name: TASK_REVIEW_SUBMIT_TOOL,
+    description: 'Submit exactly one independent DevFrame review verdict for the dispatched task.',
+    parameters: {
+      verdict: {
+        type: 'string',
+        required: true,
+        enum: ['pass', 'request_revision', 'blocked', 'human_required'],
+      },
+      findings: {
+        type: 'string',
+        required: true,
+        description: `Bounded review findings (maximum ${TASK_REVIEW_FINDINGS_MAX_CHARS} characters).`,
+      },
+    },
+    output: {
+      schema: {
+        type: 'object',
+        additionalProperties: false,
+        properties: { accepted: { type: 'boolean', required: true } },
+      },
+      render: (_args, value) => [{
+        type: 'text',
+        text: value.accepted ? 'review verdict accepted by DevFrame Host' : 'review verdict rejected',
+      }],
+    },
+    execute(args, exec) {
+      if (exec.agent !== reviewer || submitted) throw new ControlSessionError('TASK_INVALID')
+      const findings = normalizeReviewFindings(args.findings)
+      const verdict = args.verdict
+      const submission: PendingReviewSubmission = {
+        callId: String(exec.callId),
+        verdict,
+        findings,
+        findingsSha256: createHash('sha256').update(findings).digest('hex'),
+      }
+      submitted = true
+      submit(submission)
+      return Promise.resolve({ accepted: true })
+    },
+  }))
+}
