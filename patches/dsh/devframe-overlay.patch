+    const attempt = this.active?.attemptId === id ? this.active : this.last?.attemptId === id ? this.last : undefined
+    if (attempt === undefined) throw new CodexRuntimeError('CODEX_LOGIN_NOT_FOUND', 'Codex login attempt was not found')
+    if (attempt.state !== 'pending') return loginStatus(attempt)
+    attempt.cancelPromise ??= this.performCancel(attempt, signal)
+    return attempt.cancelPromise
+  }
+
+  async dispose(): Promise<void> {
+    if (this.disposed) {
+      if (this.cleanup !== undefined) await this.cleanup
+      return
+    }
+    this.disposed = true
+    const active = this.active
+    if (active !== undefined && active.state === 'pending') {
+      await this.settle(active, 'cancelled', 'CODEX_LOGIN_CANCELLED')
+    }
+    if (this.cleanup !== undefined) await this.cleanup
+  }
+
+  private async performCancel(attempt: LoginAttempt, signal: AbortSignal): Promise<CodexLoginStatus> {
+    // The official peer can emit account/login/completed before its cancel
+    // response. Mark the intent before writing the request so success=false is
+    // classified as a sanitized cancellation, not a process failure.
+    attempt.cancelRequested = true
+    try {
+      await attempt.process.cancel(signal)
+      return await this.waitForTerminal(attempt, signal)
+    } catch (error: unknown) {
+      if (attempt.state !== 'pending') return loginStatus(attempt)
+      if (signal.aborted) {
+        await this.settle(attempt, 'cancelled', 'CODEX_LOGIN_CANCELLED')
+        throw new CodexRuntimeError('CODEX_LOGIN_CANCELLED', 'Codex login was cancelled')
+      }
+      await this.settle(attempt, 'failed', loginFailureCode(error))
+      throw new CodexRuntimeError('CODEX_LOGIN_PROCESS_ERROR', 'Codex login cancellation failed')
+    }
+  }
+
+  private async waitForTerminal(attempt: LoginAttempt, signal: AbortSignal): Promise<CodexLoginStatus> {
+    if (attempt.state !== 'pending') return loginStatus(attempt)
+    if (signal.aborted) {
+      await this.settle(attempt, 'cancelled', 'CODEX_LOGIN_CANCELLED')
+      throw new CodexRuntimeError('CODEX_LOGIN_CANCELLED', 'Codex login was cancelled')
+    }
+    let timer: ReturnType<typeof setTimeout> | undefined
+    let rejectAbort!: (error: CodexRuntimeError) => void
+    const aborted = new Promise<never>((_resolve, reject) => { rejectAbort = reject })
+    const onAbort = (): void => { rejectAbort(new CodexRuntimeError('CODEX_LOGIN_CANCELLED', 'Codex login was cancelled')) }
+    signal.addEventListener('abort', onAbort, { once: true })
+    const timeout = new Promise<never>((_resolve, reject) => {
+      timer = setTimeout(() => {
+        reject(new CodexRuntimeError('CODEX_LOGIN_PROCESS_ERROR', 'Codex login completion timed out'))
+      }, LOGIN_COMPLETION_TIMEOUT_MS)
+    })
+    try {
+      return await Promise.race([attempt.terminal.promise, aborted, timeout])
+    } catch (error: unknown) {
+      const cancelled = signalWasAborted(signal)
+      await this.settle(attempt, cancelled ? 'cancelled' : 'failed', cancelled ? 'CODEX_LOGIN_CANCELLED' : 'CODEX_LOGIN_PROCESS_ERROR')
+      throw error
+    } finally {
+      signal.removeEventListener('abort', onAbort)
+      if (timer !== undefined) clearTimeout(timer)
+    }
+  }
+
+  private complete(attempt: LoginAttempt, event: CodexChatgptLoginCompleted): void {
+    if (attempt.state !== 'pending') {
+      this.fail(attempt, new CodexRuntimeError('CODEX_LOGIN_PROTOCOL_ERROR', 'Codex login completed out of order'))
+      return
+    }
+    const cancelled = attempt.startAbortRequested || attempt.cancelRequested
+    void this.settle(
+      attempt,
+      attempt.startAbortRequested ? 'cancelled' : event.success ? 'completed' : attempt.cancelRequested ? 'cancelled' : 'failed',
+      event.success ? attempt.startAbortRequested ? 'CODEX_LOGIN_CANCELLED' : undefined : cancelled ? 'CODEX_LOGIN_CANCELLED' : 'CODEX_LOGIN_PROCESS_ERROR',
+    )
+  }
+
+  private fail(attempt: LoginAttempt | undefined, error: unknown): void {
+    if (attempt === undefined || attempt.state !== 'pending') return
+    if (attempt.startAbortRequested) {
+      void this.settle(attempt, 'cancelled', 'CODEX_LOGIN_CANCELLED')
+      return
+    }
+    void this.settle(attempt, 'failed', loginFailureCode(error))
+  }
+
+  private async settle(attempt: LoginAttempt, state: LoginTerminalState, errorCode?: CodexLoginErrorCode): Promise<void> {
+    if (attempt.state !== 'pending') {
+      if (attempt.cleanupPromise !== undefined) await attempt.cleanupPromise
+      return
+    }
+    attempt.state = state
+    attempt.errorCode = errorCode
+    if (this.active === attempt) this.active = undefined
+    this.last = attempt
+    const processCleanup = attempt.process.dispose()
+    attempt.cleanupPromise = processCleanup.then(() => {}, () => {
+      attempt.state = 'failed'
+      attempt.errorCode = 'CODEX_LOGIN_PROCESS_ERROR'
+    })
+    this.cleanup = attempt.cleanupPromise
+    await attempt.cleanupPromise
+    attempt.terminal.resolve(loginStatus(attempt))
+  }
+}
+
+/**
+ * Agent-scoped provider runtime. It is intentionally not a Service: the later
+ * package Service creates/binds one instance during unpublished Agent setup.
+ */
+export class CodexManagedAgentRuntime implements AgentStepRuntime {
+  readonly provider = CODEX_SUBSCRIPTION_PROVIDER
+  readonly metadata = {
+    name: 'Codex subscription',
+    source: 'official app-server',
+    acceptsTools: false,
+  }
+
+  private process: CodexAgentProcess | undefined
+  private readonly capabilityProcesses = new Set<() => Promise<void>>()
+  private active = false
+  private disposed = false
+  private uncommittedThread = false
+  private disposePromise: Promise<void> | undefined
+
+  constructor(
+    private readonly agent: Agent,
+    private readonly options: CodexManagedAgentRuntimeOptions,
+  ) {
+    assertGraceMs(options.disposeGraceMs)
+  }
+
+  stream(input: AgentStepRuntimeInput): AsyncIterable<StreamChunk> {
+    if (this.disposed) return failedStream(new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex runtime was disposed'))
+    if (this.active) return failedStream(new CodexRuntimeError('CODEX_CONCURRENT_TURN', 'Codex permits one active turn per Agent'))
+    this.active = true
+    return this.runStream(input)
+  }
+
+  async capabilities(signal: AbortSignal): Promise<CodexSubscriptionCapabilities> {
+    if (this.disposed) throw new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex runtime was disposed')
+    const cwd = this.agent.session.header.cwd
+    if (cwd === undefined || !isAbsolute(cwd)) {
+      throw new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex Agent session had no trusted workspace')
+    }
+    return probeCodexSubscriptionCapabilities(cwd, {
+      ...this.options,
+      registerProcess: (dispose) => {
+        this.capabilityProcesses.add(dispose)
+        return () => { this.capabilityProcesses.delete(dispose) }
+      },
+    }, signal)
+  }
+
+  dispose(): Promise<void> {
+    if (this.disposePromise !== undefined) return this.disposePromise
+    this.disposed = true
+    this.disposePromise = (async () => {
+      const process = this.process
+      this.process = undefined
+      await Promise.all([
+        ...process === undefined ? [] : [process.dispose()],
+        ...[...this.capabilityProcesses].map(dispose => dispose()),
+      ])
+    })()
+    return this.disposePromise
+  }
+
+  private async *runStream(input: AgentStepRuntimeInput): AsyncIterable<StreamChunk> {
+    let process: CodexAgentProcess | undefined
+    let turnBound = false
+    let turnIdForEvent: string | undefined
+    let status: 'completed' | 'interrupted' | 'failed' = 'failed'
+    let terminal: FinishReason | undefined
+    let caughtError = false
+    try {
+      if (input.agent !== this.agent || input.request.provider !== CODEX_SUBSCRIPTION_PROVIDER) {
+        throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex Agent identity did not match')
+      }
+      if (input.tools !== undefined && input.tools.length > 0) {
+        throw new CodexRuntimeError('CODEX_UNSUPPORTED_CONTENT', 'Codex runtime does not accept tools')
+      }
+      const stepMessages = codexStepMessages(input.stepMessages)
+      textInputs(stepMessages)
+      const cwd = input.agent.session.header.cwd
+      if (cwd === undefined || !isAbsolute(cwd)) {
+        throw new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex Agent session had no trusted workspace')
+      }
+      const model = strictModelId(input.request.model, 'model', 'CODEX_PROTOCOL_ERROR')
+      const systemFingerprint = fingerprint(input.system)
+      process = await this.ensureProcess(cwd, input.signal)
+      const wire = process.currentWire()
+      const account = await wire.readAccount(input.signal)
+      this.assertAccount(account)
+      const models = await wire.readModels(input.signal)
+      const selectedModel = models.find(candidate => candidate.id === model)
+      if (selectedModel === undefined) {
+        throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex model was not verified by model/list')
+      }
+      const reasoningEffort = input.request.reasoningEffort
+      if (reasoningEffort !== undefined && !selectedModel.supportedReasoningEfforts.includes(reasoningEffort)) {
+        throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex reasoning effort was not verified by model/list')
+      }
+      await this.ensureThread(input.agent, wire, cwd, model, input.system, systemFingerprint, input.signal)
+
+      let stream: AsyncIterable<StreamChunk>
+      let abortTimer: ReturnType<typeof setTimeout> | undefined
+      let forcedCleanup: Promise<void> | undefined
+      let turnStartAttempted = false
+      let streamCompleted = false
+      const scheduleForcedCleanup = (): void => {
+        if (!input.signal.aborted || !turnBound || process === undefined || abortTimer !== undefined) return
+        abortTimer = setTimeout(() => {
+          if (input.signal.aborted && turnBound && process !== undefined) {
+            forcedCleanup ??= this.dropProcess(process)
+          }
+        }, assertGraceMs(this.options.disposeGraceMs))
+      }
+      const interrupt = (): void => {
+        wire.interrupt()
+        scheduleForcedCleanup()
+      }
+      input.signal.addEventListener('abort', interrupt, { once: true })
+      try {
+        turnStartAttempted = true
+        stream = await wire.startTurn({
+          messages: stepMessages,
+          model,
+          ...reasoningEffort === undefined ? {} : { effort: reasoningEffort },
+          dshTurn: input.turn,
+          dshStep: input.step,
+          signal: input.signal,
+          onActionRejected: (kind, decision) => {
+            input.agent.session.append('codex/action-rejected', {
+              kind,
+              decision,
+              turn: input.turn,
+              step: input.step,
+            })
+          },
+        })
+        const turnId = wire.currentTurnId
+        if (turnId === undefined) throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex turn identity was missing')
+        turnIdForEvent = turnId
+        input.agent.session.append('codex/turn-bound', {
+          turn: input.turn,
+          step: input.step,
+          turnId,
+          status: 'started',
+        })
+        turnBound = true
+        scheduleForcedCleanup()
+        for await (const chunk of stream) {
+          if (chunk.type === 'finish') terminal = chunk.reason
+          yield chunk
+        }
+        streamCompleted = true
+        status = input.signal.aborted
+          ? 'interrupted'
+          : terminal?.kind === 'stop' ? 'completed' : terminal?.kind === 'aborted' ? 'interrupted' : 'failed'
+      } catch (error: unknown) {
+        const normalized = runtimeError(error)
+        caughtError = true
+        status = input.signal.aborted && normalized.code === 'CODEX_CANCELLED' ? 'interrupted' : 'failed'
+        if (input.signal.aborted && !turnBound && turnStartAttempted) {
+          forcedCleanup ??= this.dropProcess(process)
+        }
+        throw input.signal.aborted && normalized.code === 'CODEX_CANCELLED'
+          ? new CodexRuntimeError('CODEX_CANCELLED', 'Codex turn was cancelled')
+          : normalized
+      } finally {
+        input.signal.removeEventListener('abort', interrupt)
+        if (abortTimer !== undefined) clearTimeout(abortTimer)
+        if (!caughtError && !streamCompleted && turnBound) {
+          status = 'interrupted'
+          forcedCleanup ??= this.dropProcess(process)
+        }
+        if (forcedCleanup !== undefined) await forcedCleanup
+        if (turnBound) {
+          if (!caughtError && status === 'failed') {
+            status = terminal?.kind === 'stop'
+              ? 'completed'
+              : terminal?.kind === 'aborted' || (terminal === undefined && input.signal.aborted)
+                ? 'interrupted'
+                : 'failed'
+          }
+          if (turnIdForEvent === undefined) {
+            throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex turn identity was lost')
+          }
+          input.agent.session.append('codex/turn-bound', {
+            turn: input.turn,
+            step: input.step,
+            // The wire clears active state when turn/completed arrives; retain
+            // the validated id captured at start for the durable projection.
+            turnId: turnIdForEvent,
+            status,
+          })
+        }
+      }
+    } catch (error: unknown) {
+      const normalized = runtimeError(error)
+      if (process !== undefined && (
+        normalized.code === 'CODEX_PROCESS_ERROR'
+        || normalized.code === 'CODEX_PROTOCOL_ERROR'
+        || (normalized.code === 'CODEX_CANCELLED' && !turnBound)
+      )) {
+        await this.dropProcess(process)
+      }
+      throw normalized
+    } finally {
+      this.active = false
+    }
+  }
+
+  private async ensureProcess(cwd: string, signal: AbortSignal): Promise<CodexAgentProcess> {
+    if (this.process !== undefined) return this.process
+    const process = new CodexAgentProcess(
+      cwd,
+      this.options.spawn,
+      assertGraceMs(this.options.disposeGraceMs),
+      this.options.codexHome,
+    )
+    this.process = process
+    try {
+      await process.start(signal)
+      return process
+    } catch (error: unknown) {
+      await this.dropProcess(process)
+      throw runtimeError(error)
+    }
+  }
+
+  private async dropProcess(process: CodexAgentProcess): Promise<void> {
+    if (this.process === process) this.process = undefined
+    await process.dispose()
+  }
+
+  private assertAccount(account: CodexAccountAvailability): void {
+    if (account.available && account.authKind === 'chatgpt') return
+    if (account.errorCode === 'protocol-error') {
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex account response was invalid')
+    }
+    if (account.authKind === 'none') throw new CodexRuntimeError('CODEX_NOT_AUTHENTICATED', 'Codex subscription is not authenticated')
+    throw new CodexRuntimeError('CODEX_UNSUPPORTED_ACCOUNT', 'Codex account is not a ChatGPT subscription')
+  }
+
+  private async ensureThread(
+    agent: Agent,
+    wire: CodexSubscriptionWire,
+    cwd: string,
+    model: string,
+    system: string | undefined,
+    systemFingerprint: string,
+    signal: AbortSignal,
+  ): Promise<void> {
+    const binding = readThreadBinding(agent)
+    if (binding !== undefined) {
+      // Codex v2 permits a model override on each turn and carries it forward
+      // as the thread's next-turn default. The durable binding proves the
+      // thread identity and base-instruction contract; the current model
+      // is supplied by this request and validated by model/list plus the wire
+      // response instead of being pinned to the model used at thread/start.
+      if (binding.systemFingerprint !== systemFingerprint
+        && binding.systemFingerprint !== legacyFingerprint(system, binding.model)) {
+        throw new CodexRuntimeError('CODEX_SYSTEM_CHANGED', 'Codex durable thread binding no longer matches')
+      }
+      if (wire.currentThreadId === undefined) {
+        await wire.resumeThread({ threadId: binding.threadId, cwd, model, baseInstructions: system ?? '', signal })
+      }
+      if (wire.currentThreadId !== binding.threadId) {
+        throw new CodexRuntimeError('CODEX_RESUME_MISMATCH', 'Codex durable thread identity did not match')
+      }
+      return
+    }
+    if (this.uncommittedThread || wire.currentThreadId !== undefined || hasPriorRuntimeHistory(agent)) {
+      throw new CodexRuntimeError('CODEX_RESUME_REQUIRED', 'Codex thread evidence was missing')
+    }
+    const threadId = await wire.startThread({
+      cwd,
+      model,
+      baseInstructions: system ?? '',
+      signal,
+    })
+    try {
+      agent.session.append('codex/thread-bound', {
+        threadId,
+        provider: CODEX_SUBSCRIPTION_PROVIDER,
+        model,
+        protocol: 'v2',
+        systemFingerprint,
+      })
+    } catch (_error: unknown) {
+      this.uncommittedThread = true
+      throw new CodexRuntimeError('CODEX_RESUME_REQUIRED', 'Codex thread binding could not be recorded')
+    }
+  }
+}
+
+/**
+ * Probe the native Codex subscription without creating an Agent or durable
+ * thread. The process is always disposed before the result is released.
+ *
+ * @param cwd - trusted absolute workspace directory for the app-server.
+ * @param options - provider-owned process seam and bounded teardown policy.
+ * @param signal - caller-owned cancellation signal for the probe.
+ * @returns sanitized account and dynamic model facts.
+ */
+export async function probeCodexSubscriptionCapabilities(
+  cwd: string,
+  options: CodexSubscriptionProbeOptions,
+  signal: AbortSignal,
+): Promise<CodexSubscriptionCapabilities> {
+  if (!isAbsolute(cwd)) {
+    throw new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex capability workspace was not absolute')
+  }
+  const process = new CodexAgentProcess(
+    cwd,
+    options.spawn,
+    assertGraceMs(options.disposeGraceMs),
+    options.codexHome,
+  )
+  const unregister = options.registerProcess?.(() => process.dispose())
+  try {
+    const wire = await process.start(signal)
+    const account = await wire.readAccount(signal)
+    if (!account.available || account.authKind !== 'chatgpt') return { account, models: [] }
+    const models = await wire.readModels(signal)
+    return { account, models }
+  } catch (error: unknown) {
+    throw runtimeError(error)
+  } finally {
+    try {
+      await process.dispose()
+    } finally {
+      unregister?.()
+    }
+  }
+}
+
+export type { CodexSubscriptionConfig }
