+
+const ID_PART_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/
+const CONTROLLER_IDENTITY_EVENT_TYPE = 'controller/identity' as const
+const CONTROLLER_RUN_SUMMARY_EVENT_TYPE = 'controller/run-summary' as const
+/** Guard reason for mutations outside the Global Controller's coordinator face. */
+const CONTROLLER_GUARD_REASON = 'DevFrame Global Controller is a coordinator: workspace mutations flow through dispatched Workers, not this session'
+/**
+ * The Global Controller's coordinator tool face: it may inspect and verify
+ * (read / search), and may use the two governed DevFrame project tools. It
+ * must not mutate the workspace directly — no shell, edit/write, or generic
+ * delegation tools — so code changes keep flowing through dispatched Workers
+ * (design §3 coordination surface; the restriction is the model-facing half
+ * of the same boundary the wire enforces on the browser).
+ */
+const CONTROLLER_ALLOWED_TOOLS: readonly string[] = ['read', 'glob', 'grep']
+const CONTROLLER_ALLOWED_TOOL_SET = new Set(CONTROLLER_ALLOWED_TOOLS)
+/**
+ * Keep ordinary Global Controller conversation separate from workspace
+ * inspection. The read-only tool face remains available; this guidance only
+ * prevents a harmless question such as "what can you do?" from turning into a
+ * directory passed to `read`, which native DSH correctly rejects.
+ */
+const GLOBAL_CONTROLLER_CONVERSATION_GUIDANCE = [
+  'DevFrame Global Controller conversation guidance:',
+  '- For ordinary questions about the controller, the project, or your capabilities, answer directly without calling filesystem tools.',
+  '- Inspect the workspace only when the user explicitly asks you to inspect files, search code, or verify project state.',
+  '- A directory is not a file: use `glob` to discover paths first and pass only a file path to `read`.',
+  '- Keep inspection bounded to the user request; do not probe the controller home broadly just to answer a conversational question.',
+].join('\n')
+
+interface ScopedSystemPrompt {
+  section(section: {
+    readonly name: string
+    readonly order: number
+    readonly text: string
+  }): unknown
+}
+
+function registerGlobalControllerConversationGuidance(agentCtx: Context): void {
+  // Lightweight Host fakes intentionally omit the native prompt registry. The
+  // production DSH composition mounts it before AgentLoop, so the guidance is
+  // scoped to this Agent and automatically disposed with its Context.
+  const systemPrompt = (agentCtx as unknown as { readonly systemPrompt?: ScopedSystemPrompt }).systemPrompt
+  systemPrompt?.section({
+    name: 'devframe:global-controller-conversation',
+    order: 50,
+    text: GLOBAL_CONTROLLER_CONVERSATION_GUIDANCE,
+  })
+}
+/** The mutable Host-owned restriction and one guard attached to a Global Agent. */
+interface ControllerToolFaceState {
+  restriction: () => void
+  readonly guard: () => void
+  presetId: string
+}
+
+/**
+ * The restriction is scoped to one live Agent and must be replaced when its
+ * preset changes. Keeping the disposer here avoids composing another
+ * intersecting mask, which would make a later switch back unable to restore a
+ * tool that was absent from the intermediate preset.
+ */
+const CONTROLLER_TOOL_FACES = new WeakMap<Agent, ControllerToolFaceState>()
+/**
+ * Startup records written by the native Web permission/sandbox services before
+ * a first turn. Older DevFrame Global sessions were created before the preset
+ * choice was persisted, so these records are safe to replay under `standard`.
+ * Project Controllers remain limited to this startup-only whitelist when no
+ * preset is known. Legacy Global Controllers may be adopted under `standard`
+ * when their persisted log has no `tool/*` history; native resume may append
+ * its normal seed boundary first, then migration appends
+ * `agent-preset/selected`, while existing events remain unchanged. A Global
+ * log with any `tool/*` history remains fail-closed.
+ */
+const CONTROLLER_PRESET_ADOPTION_EVENT_TYPES = new Set([
+  CONTROLLER_IDENTITY_EVENT_TYPE,
+  'session/end-seed',
+  'permission/preset',
+  'sandbox/mode',
+  'approval/policy',
+])
+
+function canAdoptControllerPreset(session: Session, role: ControllerRole): boolean {
+  if (role === 'global') return session.events.every(event => !event.type.startsWith('tool/'))
