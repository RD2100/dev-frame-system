+const TASK_CONTEXT_BASE_INSTRUCTION_SHA256 = createHash('sha256')
+  .update(TASK_CONTEXT_BASE_INSTRUCTION_TEXT)
+  .digest('hex')
+/** Byte size of the base instruction source. */
+const TASK_CONTEXT_BASE_INSTRUCTION_BYTES = new TextEncoder()
+  .encode(TASK_CONTEXT_BASE_INSTRUCTION_TEXT).length
