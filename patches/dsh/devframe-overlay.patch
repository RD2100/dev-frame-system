+/** Snapshot the live sessions as a durable persisted map for a restart resume. */
+function capturePersisted(test: ReturnType<typeof fakeSetup>): Map<SessionId, PersistedSession> {
+  const persisted = new Map<SessionId, PersistedSession>()
+  for (const [id, agent] of test.liveAgents) {
+    persisted.set(id, {
+      meta: structuredClone(agent.session.header),
+      events: structuredClone(agent.session.events),
+    })
+  }
+  return persisted
+}
