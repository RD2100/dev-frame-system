+        '',
+        failedSnapshot,
+      ].join('\n'),
+      MODE,
+    )
+  }, 120_000)
+
+  it('keeps the assembled snapshot inventory closed', async () => {
+    await assertFixtureInventory(SNAPSHOT_DIR, ['ui.expected.md'])
+  })
+})
