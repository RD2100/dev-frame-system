+    const list = vi.fn().mockResolvedValue({
+      result: { ok: true, value: { presets: [], authorable: false, hasDocument: false } },
+    })
+    ctx.provide('connection', { api: { agentPresets: { list } } } as never)
+    const remoteListeners = new Map<string, Set<(...args: unknown[]) => void>>()
+    const remoteOn = vi.fn((event: string, listener: (...args: unknown[]) => void) => {
+      const listeners = remoteListeners.get(event) ?? new Set<(...args: unknown[]) => void>()
+      listeners.add(listener)
+      remoteListeners.set(event, listeners)
+      return () => { listeners.delete(listener) }
+    })
+    const dispatchRemote = (event: string, ...args: unknown[]): void => {
+      for (const listener of remoteListeners.get(event) ?? []) listener(...args)
+    }
+    ctx.provide('remote', {
+      $on: remoteOn,
+      devframeControlSessions: {
+        readiness: vi.fn().mockResolvedValue({ ok: false, error: { code: 'unavailable' } }),
