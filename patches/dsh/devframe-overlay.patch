@@ -0,0 +1,66 @@
+import { useEffect, useState } from 'react'
+import type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type { WorkspaceId, WorkspaceView } from '@deepseek-ai/dsh-client-runtime/client'
+import type { ControlSessionKey } from './locales.ts'
+import { GlobalPromptRouter } from './global-prompt-router.ts'
+import css from './GlobalPromptTarget.module.css'
+
+export interface GlobalPromptTargetInjected {
+  readonly router: GlobalPromptRouter
+}
+
+export type GlobalPromptTargetProps =
+  PropsRuntime<'conversation.input.left'>
+  & PropsLocale<'client-ui-devframe-control-session'>
+  & InjectFace<GlobalPromptTargetInjected>
+
+function targetLabel(
+  workspace: WorkspaceView,
+  t: (key: ControlSessionKey) => string,
+): string {
+  return workspace.title.trim() === '' ? t('global.route.untitled') : workspace.title
+}
+
+/** Explicitly chooses a Project Loop target or work outside a project. */
+export function GlobalPromptTarget({
+  sessionId, useSessions, useWorkspaces, router, t,
+}: GlobalPromptTargetProps) {
+  const summary = useSessions(state => state.byId[sessionId])
+  const workspaces = useWorkspaces(state => state.items)
+  const isGlobal = summary?.devframeRole === 'global'
+  const routerTarget = router.target().workspaceId
+  const [selected, setSelected] = useState<string>(routerTarget ?? '')
+
+  useEffect(() => {
+    if (!isGlobal) return
+    const targetExists = selected === '' || workspaces.some(item => item.workspaceId === selected)
+    if (targetExists) return
+    setSelected('')
+    router.setTarget({})
+  }, [isGlobal, router, selected, workspaces])
+
+  if (!isGlobal) return null
+
+  return (
+    <label className={css.control}>
+      <span className={css.label}>{t('global.route.target')}</span>
+      <select
+        className={css.select}
+        aria-label={t('global.route.target')}
+        value={selected}
+        onChange={(event) => {
+          const value = event.target.value
+          setSelected(value)
+          router.setTarget(value === '' ? {} : { workspaceId: value as WorkspaceId })
+        }}
+      >
+        <option value="">{t('global.route.outside')}</option>
+        {workspaces.map(workspace => (
+          <option key={workspace.workspaceId} value={workspace.workspaceId}>
+            {targetLabel(workspace, t)}
+          </option>
+        ))}
+      </select>
+    </label>
+  )
+}
