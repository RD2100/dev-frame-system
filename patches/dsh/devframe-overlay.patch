--- /dev/null
+++ b/packages/core/agent-loop/tests/step-runtime.spec.ts
@@ -0,0 +1,323 @@
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import { describe, expect, it, vi } from 'vitest'
+import AgentRegistry, { type Agent, type AgentStepRuntime, type AgentStepRuntimeInput, type PreStepDecision } from '@deepseek-ai/dsh-agent'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { MockAdapter, textResponse, toolCallResponse } from './mock-adapter.ts'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import LlmRuntime from '@deepseek-ai/dsh-llm'
+import SessionStore from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+
+async function harness(adapter: MockAdapter): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  ctx.llm.registerAdapter(['mock'], adapter)
+  return ctx
+}
+
+function send(agent: { followup(message: ReturnType<typeof createUserMessage>): void }, text: string): void {
+  agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }))
+}
+
+function runtime(provider: string, stream: AgentStepRuntime['stream']): AgentStepRuntime {
+  return { provider, metadata: { name: provider, source: 'test' }, stream }
+}
+
+describe('AgentLoop AgentStepRuntime', () => {
+  it('passes the exact frozen request and assembled fields to the runtime without using the adapter', async () => {
+    const adapter = new MockAdapter([textResponse('adapter')])
+    const ctx = await harness(adapter)
+    ctx.systemPrompt.section({ name: 'runtime-system', order: 0, text: 'runtime system' })
+    const agent = ctx.agentLoop.create(SessionId('runtime-input'), { provider: 'direct', model: 'direct-model' })
+    const inputs: AgentStepRuntimeInput[] = []
+    const direct = runtime('direct', async function* (input) {
+      inputs.push(input)
+      for (const chunk of textResponse('runtime')) yield chunk
+    })
+    agent.ctx.agents.registerStepRuntime(agent, direct)
+
+    send(agent, 'hello runtime')
+    await agent.whenIdle()
+
+    expect(adapter.requests).toEqual([])
+    expect(inputs).toHaveLength(1)
+    const input = inputs[0]
+    expect(input).toBeDefined()
+    expect(input?.agent).toBe(agent)
+    expect(input?.turn).toBe(1)
+    expect(input?.step).toBe(1)
+    expect(input?.system).toContain('runtime system')
+    expect(input?.tools).toBeUndefined()
+    expect(input?.messages).toBe(input?.request.messages)
+    expect(input?.request).toMatchObject({ provider: 'direct', model: 'direct-model' })
+    expect(Object.isFrozen(input?.request)).toBe(true)
+    expect(input?.signal.aborted).toBe(false)
+    expect(agent.session.events.map(event => event.type)).toContain('assistant/message')
+  })
+
+  it('passes DSH tools and guidance to tool-capable runtimes by default', async () => {
+    const ctx = await harness(new MockAdapter([textResponse('adapter')]))
+    ctx.systemPrompt.section({ name: 'tool:echo', order: 100, text: 'Use the echo tool.' })
+    ctx.tools.register(defineContentToolFixture({
+      name: 'echo',
+      description: 'Echo text back to the caller.',
+      parameters: { text: { type: 'string' } },
+      async execute(args) {
+        return [{ type: 'text', text: `echo: ${args.text}` }]
+      },
+    }))
+    const agent = ctx.agentLoop.create(SessionId('runtime-tools-default'), { provider: 'direct', model: 'direct-model' })
+    const inputs: AgentStepRuntimeInput[] = []
+    const direct = runtime('direct', async function* (input) {
+      inputs.push(input)
+      for (const chunk of textResponse('runtime')) yield chunk
+    })
+    agent.ctx.agents.registerStepRuntime(agent, direct)
+
+    send(agent, 'use the available tool')
+    await agent.whenIdle()
+
+    expect(inputs[0]?.system).toContain('Use the echo tool.')
+    expect(inputs[0]?.tools?.map(tool => tool.name)).toEqual(['echo'])
+  })
+
+  it('separates each step input from the complete request history across turns', async () => {
+    const ctx = await harness(new MockAdapter([textResponse('adapter')]))
+    const agent = ctx.agentLoop.create(SessionId('runtime-step-messages'), { provider: 'direct', model: 'direct-model' })
+    const inputs: AgentStepRuntimeInput[] = []
+    const mutationResults: Array<{
+      arrayFrozen: boolean
+      messageFrozen: boolean
+      contentFrozen: boolean
+      arrayMutationRejected: boolean
+      contentMutationRejected: boolean
+    }> = []
+    const direct = runtime('direct', async function* (input) {
+      inputs.push(input)
+      const stepMessage = input.stepMessages[0]
+      if (stepMessage !== undefined) {
+        mutationResults.push({
+          arrayFrozen: Object.isFrozen(input.stepMessages),
+          messageFrozen: Object.isFrozen(stepMessage),
+          contentFrozen: Object.isFrozen(stepMessage.content),
+          arrayMutationRejected: !Reflect.set(input.stepMessages, '0', stepMessage),
+          contentMutationRejected: !Reflect.set(stepMessage.content[0]!, 'text', 'runtime mutation'),
+        })
+      }
+      for (const chunk of textResponse(`turn ${input.turn}`)) yield chunk
+    })
+    agent.ctx.agents.registerStepRuntime(agent, direct)
+
+    send(agent, 'first turn')
+    await agent.whenIdle()
+    send(agent, 'second turn')
+    await agent.whenIdle()
+
+    expect(inputs).toHaveLength(2)
+    expect(inputs[0]?.stepMessages).toBeDefined()
+    expect(inputs[1]?.stepMessages).toBeDefined()
+    expect(inputs[0]?.stepMessages).toHaveLength(1)
+    expect(inputs[1]?.stepMessages).toHaveLength(1)
+    expect(inputs[0]?.stepMessages[0]?.content).toEqual([{ type: 'text', text: 'first turn' }])
+    expect(inputs[1]?.stepMessages[0]?.content).toEqual([{ type: 'text', text: 'second turn' }])
+    expect(inputs[0]?.stepMessages).not.toBe(inputs[0]?.messages)
+    expect(inputs[1]?.stepMessages).not.toBe(inputs[1]?.messages)
+    expect(inputs[0]?.stepMessages[0]).not.toBe(inputs[0]?.messages[0])
+    expect(inputs[1]?.stepMessages[0]).not.toBe(inputs[1]?.messages[2])
+    expect(inputs[1]?.messages).toBe(inputs[1]?.request.messages)
+    expect(Object.isFrozen(inputs[1]?.request.messages)).toBe(true)
+    expect(Object.isFrozen(inputs[1]?.request.messages[0])).toBe(true)
+    expect(inputs[1]?.messages.map(message => message.content)).toEqual([
+      [{ type: 'text', text: 'first turn' }],
+      [{ type: 'text', text: 'turn 1' }],
+      [{ type: 'text', text: 'second turn' }],
+    ])
+    expect(mutationResults).toEqual([
+      {
+        arrayFrozen: true,
+        messageFrozen: true,
+        contentFrozen: true,
+        arrayMutationRejected: true,
+        contentMutationRejected: true,
+      },
+      {
+        arrayFrozen: true,
+        messageFrozen: true,
+        contentFrozen: true,
+        arrayMutationRejected: true,
+        contentMutationRejected: true,
+      },
+    ])
+    expect(agent.session.deriveMessages().map(message => message.content)).toEqual([
+      [{ type: 'text', text: 'first turn' }],
+      [{ type: 'text', text: 'turn 1' }],
+      [{ type: 'text', text: 'second turn' }],
+      [{ type: 'text', text: 'turn 2' }],
+    ])
+  })
+
+  it('reuses one detached step-message snapshot across runtime retries', async () => {
+    const ctx = await harness(new MockAdapter([textResponse('adapter')]))
+    const agent = ctx.agentLoop.create(SessionId('runtime-step-retry'), { provider: 'direct', model: 'direct-model' })
+    const inputs: AgentStepRuntimeInput[] = []
+    let attempts = 0
+    const direct = runtime('direct', async function* (input) {
+      inputs.push(input)
+      if (attempts++ === 0) {
+        yield { type: 'finish', reason: { kind: 'error', failure: { message: 'retry me', code: 'RETRY' } } }
+        return
+      }
+      for (const chunk of textResponse('retried')) yield chunk
+    })
+    agent.ctx.agents.registerStepRuntime(agent, direct)
+    ctx.on('agent/request-error', async ({ agent: subject }, next) => {
+      if (subject === agent) return { kind: 'retry' }
+      return await next()
+    })
+
+    send(agent, 'retry runtime')
+    await agent.whenIdle()
+
+    expect(inputs).toHaveLength(2)
+    expect(inputs[0]?.stepMessages).toBe(inputs[1]?.stepMessages)
+    expect(inputs[1]?.messages).toBe(inputs[1]?.request.messages)
+    const assistant = agent.session.events.findLast(event => event.type === 'assistant/message')
+    expect(assistant?.type === 'assistant/message' && assistant.data.message.content).toEqual([
+      { type: 'text', text: 'retried' },
+    ])
+  })
+
+  it('does not snapshot step messages on the ordinary adapter route', async () => {
+    const adapter = new MockAdapter([textResponse('adapter')])
+    const ctx = await harness(adapter)
+    const agent = ctx.agentLoop.create(SessionId('adapter-no-step-snapshot'), { provider: 'mock', model: 'mock' })
+    let decisionMessages: readonly object[] | undefined
+    ctx.on('agent/pre-step', async ({ agent: subject }, next): Promise<PreStepDecision> => {
+      const decision: PreStepDecision = await next()
+      if (subject === agent && decision.kind === 'enter') decisionMessages = decision.messages
+      return decision
+    })
+    const nativeStructuredClone = globalThis.structuredClone
+    const clone = vi.spyOn(globalThis, 'structuredClone').mockImplementation((value) => {
+      if (value === decisionMessages) throw new Error('adapter route must not snapshot step messages')
+      return nativeStructuredClone(value)
+    })
+    const errors: unknown[] = []
+    ctx.on('agent/error', ({ agent: subject, error }) => {
+      if (subject === agent) errors.push(error)
+    })
+
+    try {
+      send(agent, 'adapter fallback')
+      await agent.whenIdle()
+
+      expect(decisionMessages).toBeDefined()
+      expect(adapter.requests).toHaveLength(1)
+      expect(errors).toEqual([])
+    } finally {
+      clone.mockRestore()
+    }
+  })
+
+  it('rejects runtime tool-call chunks before DSH tool execution', async () => {
+    const adapter = new MockAdapter([textResponse('adapter')])
+    const ctx = await harness(adapter)
+    const agent = ctx.agentLoop.create(SessionId('runtime-tool-call'), { provider: 'direct', model: 'direct-model' })
+    const direct = runtime('direct', async function* () {
+      for (const chunk of toolCallResponse('runtime-call', 'dangerous', {})) yield chunk
+    })
+    agent.ctx.agents.registerStepRuntime(agent, direct)
+    const failures: unknown[] = []
+    ctx.on('agent/error', ({ agent: subject, error }) => {
+      if (subject === agent) failures.push(error)
+    })
+
+    send(agent, 'request a tool')
+    await agent.whenIdle()
+
+    expect(adapter.requests).toEqual([])
+    expect(failures).toHaveLength(1)
+    expect(failures[0]).toMatchObject({ code: 'RUNTIME_TOOL_CALL_UNSUPPORTED' })
+    expect(agent.session.events.some(event => event.type === 'assistant/chunk')).toBe(false)
+    expect(agent.session.events.some(event => event.type === 'tool/call')).toBe(false)
+    const ending = agent.session.events.findLast(event => event.type === 'turn/end')
+    expect(ending?.type === 'turn/end' && ending.data.reason).toMatchObject({ kind: 'error' })
+  })
+
+  it('registers through unpublished create setup, routes after publication, and cleans up on handle disposal', async () => {
+    const adapter = new MockAdapter([textResponse('adapter')])
+    const ctx = await harness(adapter)
+    const modelStream = vi.spyOn(ctx.llm, 'stream')
+    const prepareCall = vi.spyOn(ctx.llm, 'prepareCall')
+    const inputs: AgentStepRuntimeInput[] = []
+    const direct = runtime('direct', async function* (input) {
+      inputs.push(input)
+      for (const chunk of textResponse('runtime')) yield chunk
+    })
+    let setupAgent!: Agent
+    let setupLookup: AgentStepRuntime | undefined
+    const handle = await ctx.agents.create({
+      sessionId: SessionId('runtime-create-setup'),
+      agentOptions: { provider: 'direct', model: 'direct-model' },
+      setup: (agentCtx) => {
+        const agent = agentCtx.agent
+        if (agent === undefined) throw new Error('agent setup context has no agent')
+        setupAgent = agent
+        agentCtx.agents.registerStepRuntime(agent, direct)
+        setupLookup = agentCtx.agents.getStepRuntime(agent, direct.provider)
+      },
+    })
+
+    const agent = handle.agent
+    expect(setupAgent).toBe(agent)
+    expect(setupLookup).toBeUndefined()
+    expect(ctx.agents.getStepRuntime(agent, direct.provider)).toBe(direct)
+
+    const statuses: string[] = []
+    ctx.on('agent/status', ({ agent: subject, status }) => {
+      if (subject === agent) statuses.push(status)
+    })
+    send(agent, 'real setup route')
+    await agent.whenIdle()
+
+    expect(inputs).toHaveLength(1)
+    expect(modelStream).not.toHaveBeenCalled()
+    expect(prepareCall).not.toHaveBeenCalled()
+    expect(agent.session.events.map(event => event.type)).toContain('assistant/message')
+    expect(statuses).toEqual(['running', 'idle'])
+
+    await handle.dispose()
+    expect(ctx.agents.getStepRuntime(agent, direct.provider)).toBeUndefined()
+  })
+
+  it('passes the same turn signal to the runtime and observes cancellation', async () => {
+    const ctx = await harness(new MockAdapter([textResponse('adapter')]))
+    const agent = ctx.agentLoop.create(SessionId('runtime-cancel'), { provider: 'direct', model: 'direct-model' })
+    let runtimeSignal!: AbortSignal
+    const direct = runtime('direct', async function* ({ signal }) {
