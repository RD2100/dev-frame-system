--- /dev/null
+++ b/packages/core/agent/src/step-runtime.ts
@@ -0,0 +1,69 @@
+/**
+ * Agent-scoped provider runtime for one already assembled model step.
+ *
+ * The runtime is deliberately narrower than {@link AgentFactory}: the
+ * AgentLoop still owns turns, steps, session events, cancellation, and
+ * disposal. A provider only owns the metadata and stream for the exact step it
+ * receives.
+ *
+ * @module @deepseek-ai/dsh-agent/step-runtime
+ */
+
+import type {
+  GenerateOptions,
+  Message,
+  StreamChunk,
+  ToolSchema,
+} from '@deepseek-ai/dsh-llm'
+import type { Agent } from './runtime-types.ts'
+
+/** Provider-owned display facts for a step runtime. */
+export interface AgentStepRuntimeMetadata {
+  /** Human-readable provider/runtime name. */
+  readonly name: string
+  /** Optional source label, such as a native process or hosted service. */
+  readonly source?: string
+  /** Whether the runtime can receive DSH tool schemas and guidance (default true). */
+  readonly acceptsTools?: boolean
+}
+
+/** The exact inputs supplied to one provider-owned step stream. */
+export interface AgentStepRuntimeInput {
+  /** The exact live Agent whose loop owns this step. */
+  readonly agent: Agent
+  /** The DSH turn containing this step. */
+  readonly turn: number
+  /** The DSH step being executed. */
+  readonly step: number
+  /** The already assembled system prompt, if present. */
+  readonly system: string | undefined
+  /** The already assembled tool schemas, if present. */
+  readonly tools: readonly ToolSchema[] | undefined
+  /** The complete model-facing message history derived from the session. */
+  readonly messages: readonly Message[]
+  /**
+   * A detached, deep-frozen snapshot of the messages selected by this step's
+   * pre-step decision. This contains only the new or injected messages entering
+   * this DSH step, not the complete {@link messages} request history.
+   */
+  readonly stepMessages: readonly Message[]
+  /** The frozen, canonical request selected by the AgentLoop. */
+  readonly request: Readonly<GenerateOptions>
+  /** The same cancellation signal owned by the active DSH turn. */
+  readonly signal: AbortSignal
+}
+
+/** Provider-owned runtime for exactly one AgentLoop step. */
+export interface AgentStepRuntime {
+  /** Provider route selected by {@link AgentOptions.provider}. */
+  readonly provider: string
+  /** Provider/runtime metadata reserved for later host catalog consumers. */
+  readonly metadata: AgentStepRuntimeMetadata
+  /**
+   * Stream canonical chunks for one step. The runtime must not emit DSH
+   * tool-call blocks until an explicit tool bridge is installed.
+   * @param input - exact AgentLoop identity, request, assembled content, and signal.
+   * @returns the provider-owned canonical stream.
+   */
+  stream(input: AgentStepRuntimeInput): AsyncIterable<StreamChunk>
+}
diff --git a/packages/core/agent/tests/step-runtime.spec.ts b/packages/core/agent/tests/step-runtime.spec.ts
new file mode 100644
index 0000000000..4d28631558
--- /dev/null
+++ b/packages/core/agent/tests/step-runtime.spec.ts
@@ -0,0 +1,98 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { Session, SessionId } from '@deepseek-ai/dsh-session'
+import AgentRegistry, { Inbox, type Agent, type AgentStepRuntime } from '@deepseek-ai/dsh-agent'
+
+function stubAgent(rawId: string, ctx: Context): Agent {
+  const id = SessionId(rawId)
+  const session = Session.create(id)
+  return {
+    id,
+    options: {},
+    session,
+    inbox: new Inbox(session, { inserted: () => {}, discarded: () => {}, claimed: () => {} }),
+    status: 'idle',
+    ctx,
+    send: () => {},
+    followup: () => {},
+    steer: () => {},
+    inject: () => {},
+    cancel() {},
+    runMaintenance: task => task(new AbortController().signal),
+    whenIdle: () => Promise.resolve(),
+  }
+}
+
+function runtime(provider: string): AgentStepRuntime {
+  return {
+    provider,
+    metadata: { name: provider },
+    stream: async function* () {},
+  }
+}
+
+describe('AgentStepRuntime registration', () => {
+  it('registers during unpublished setup and becomes visible only at publication', async () => {
+    const ctx = new Context()
+    await ctx.plugin(AgentRegistry)
+    const runtimeA = runtime('direct-a')
+    let agent!: Agent
+    const setup = await ctx.plugin(Object.assign((inner: Context) => {
+      agent = stubAgent('unpublished', inner)
+      inner.agents.registerStepRuntime(agent, runtimeA)
+      expect(inner.agents.getStepRuntime(agent, runtimeA.provider)).toBeUndefined()
+    }, { inject: ['agents'] }))
+
+    const detach = ctx.agents.enter(agent, undefined)
+    ctx.agents.announce(agent)
+    expect(ctx.agents.getStepRuntime(agent, runtimeA.provider)).toBe(runtimeA)
+
+    detach()
+    expect(ctx.agents.getStepRuntime(agent, runtimeA.provider)).toBeUndefined()
+    await setup.dispose()
+  })
+
+  it('isolates registrations by Agent and rejects duplicate providers without replacing the original', async () => {
+    const ctx = new Context()
+    await ctx.plugin(AgentRegistry)
+    let first!: Agent
+    let second!: Agent
+    const owner = await ctx.plugin(Object.assign((inner: Context) => {
+      first = stubAgent('first', inner)
+      second = stubAgent('second', inner)
+      inner.agents.register(first)
+      inner.agents.register(second)
+      inner.agents.registerStepRuntime(first, runtime('direct'))
+      inner.agents.registerStepRuntime(second, runtime('direct'))
+    }, { inject: ['agents'] }))
+    const original = ctx.agents.getStepRuntime(first, 'direct')
+    expect(original).toBeDefined()
+    expect(ctx.agents.getStepRuntime(second, 'direct')).toBeDefined()
+
+    expect(() => owner.ctx.agents.registerStepRuntime(first, runtime('direct')))
+      .toThrow('step runtime for provider "direct" is already registered')
+    expect(ctx.agents.getStepRuntime(first, 'direct')).toBe(original)
+
+    await owner.dispose()
+    expect(ctx.agents.getStepRuntime(first, 'direct')).toBeUndefined()
+    expect(ctx.agents.getStepRuntime(second, 'direct')).toBeUndefined()
+  })
+
+  it('removes a setup-scoped registration when its owner fiber disposes', async () => {
+    const ctx = new Context()
+    await ctx.plugin(AgentRegistry)
+    const runtimeA = runtime('direct-a')
+    let agent!: Agent
+    const owner = await ctx.plugin(Object.assign((inner: Context) => {
+      agent = stubAgent('scoped', inner)
+      inner.agents.register(agent)
+      inner.agents.registerStepRuntime(agent, runtimeA)
+    }, { inject: ['agents'] }))
+
+    expect(ctx.agents.getStepRuntime(agent, runtimeA.provider)).toBe(runtimeA)
+
+    await owner.dispose()
+    expect(ctx.agents.getStepRuntime(agent, runtimeA.provider)).toBeUndefined()
+  })
+
+})
