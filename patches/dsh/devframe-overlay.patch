+
+/** The same thin DevFrame layer used by the profile parity surface test. */
+const DEVFRAME_PATCH_PATH = fileURLToPath(
+  new URL('../../../packages/bundle/devframe/cordis.patch.yml', import.meta.url),
+)
+const SNAPSHOT_DIR = fileURLToPath(new URL('./snapshots/codex-subscription-streaming', import.meta.url))
+const UI_EXPECTED = join(SNAPSHOT_DIR, 'ui.expected.md')
+const MODE = webSnapshotMode()
+const PROMPT = 'Run the Codex subscription streaming proof once.'
+const SECOND_PROMPT = 'Continue the same Codex subscription thread with Terra.'
+const DELTA_LINES = [
+  'Luna流式测试1',
+  'Luna流式测试2',
+  'Luna流式测试3',
+  'Luna流式测试4',
+  'Luna流式测试5',
+] as const
+const FINAL_TEXT = DELTA_LINES.join('\n')
+const REASONING_SUMMARY = '正在整理请求并准备流式回答。'
+const SECOND_DELTA_LINES = [
+  'Luna连续会话2-1',
+  'Luna连续会话2-2',
+  'Luna连续会话2-3',
+  'Luna连续会话2-4',
+  'Luna连续会话2-5',
+] as const
+const SECOND_FINAL_TEXT = SECOND_DELTA_LINES.join('\n')
+const CRASH_PROMPT = 'Trigger the Codex child-process crash for the assembled resume proof.'
+const RECOVERY_PROMPT = 'Recover the same Codex subscription thread after the child-process crash.'
+const RECOVERY_DELTA_LINES = [
+  'Terra恢复流式1',
+  'Terra恢复流式2',
+  'Terra恢复流式3',
+  'Terra恢复流式4',
