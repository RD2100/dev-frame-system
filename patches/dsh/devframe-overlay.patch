+/** Project official account/read into an allowlisted availability fact. */
+export function projectAccount(response: unknown): CodexAccountAvailability {
+  try {
+    const value = asObject(response, 'account/read response')
+    const requiresOpenaiAuth = value.requiresOpenaiAuth === true
+    const account = value.account
+    if (account === null || account === undefined) {
+      return { available: false, authKind: 'none', requiresOpenaiAuth, errorCode: 'not-authenticated' }
+    }
+    const record = asObject(account, 'account')
+    if (record.type !== 'chatgpt') {
+      return {
+        available: false,
+        authKind: record.type === 'apiKey' || record.type === 'api_key' ? 'apiKey' : 'unknown',
+        requiresOpenaiAuth,
+        errorCode: 'unsupported-account',
+      }
+    }
+    const canonicalPlans: Record<string, NonNullable<CodexAccountAvailability['planType']>> = {
+      free: 'free',
+      go: 'free',
+      plus: 'plus',
+      pro: 'pro',
+      prolite: 'pro',
+      team: 'business',
+      self_serve_business_prolite: 'business',
+      self_serve_business_usage_based: 'business',
+      business: 'business',
+      ent26: 'enterprise',
+      enterprise_cbp_automation: 'enterprise',
+      enterprise_cbp_usage_based: 'enterprise',
+      enterprise: 'enterprise',
+      edu: 'edu',
+      unknown: 'unknown',
+    }
+    const rawPlan = typeof record.planType === 'string' ? record.planType : 'unknown'
+    const planType = canonicalPlans[rawPlan] ?? 'unknown'
+    return {
+      available: true,
+      authKind: 'chatgpt',
+      requiresOpenaiAuth,
+      planType,
+    }
+  } catch (error: unknown) {
+    if (error instanceof CodexRuntimeError && error.code === 'CODEX_PROTOCOL_ERROR') {
+      return { available: false, authKind: 'unknown', requiresOpenaiAuth: false, errorCode: 'protocol-error' }
+    }
+    return { available: false, authKind: 'unknown', requiresOpenaiAuth: false, errorCode: 'protocol-error' }
+  }
+}
+
+/** Bounded capability query over one already initialized wire. */
+export async function listModels(
+  wire: JsonRpcLineTransport,
+  signal: AbortSignal,
+  fatal?: Promise<never>,
+): Promise<readonly CodexModelDescriptor[]> {
+  const result: CodexModelDescriptor[] = []
+  const seen = new Set<string>()
+  const cursors = new Set<string>()
+  let cursor: string | null = null
+  for (let page = 0; page < MAX_MODEL_PAGES; page += 1) {
+    const response = await safeRequest(wire.request('model/list', { cursor, limit: MAX_MODELS, includeHidden: false }), signal, fatal)
+    const projected = projectModels(response)
+    for (const model of projected) {
+      if (seen.has(model.id)) continue
+      seen.add(model.id)
+      result.push(model)
+      if (result.length >= MAX_MODELS) break
+    }
+    if (result.length >= MAX_MODELS) break
+    const raw = asObject(response, 'model/list response')
+    const next = raw.nextCursor
+    if (next === null || next === undefined) break
+    cursor = optionalString(next, 'model/list cursor') ?? null
+    if (cursor === null) break
+    if (cursors.has(cursor)) throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex model catalog repeated a cursor')
+    cursors.add(cursor)
+  }
+  return Object.freeze(result.slice(0, MAX_MODELS))
+}
+
+/** One bounded async stream of canonical text chunks. */
+class ChunkQueue implements AsyncIterable<StreamChunk> {
+  private readonly values: StreamChunk[] = []
+  private readonly waiters: Array<(result: IteratorResult<StreamChunk>) => void> = []
+  private ended = false
+  private failure: Error | undefined
+
+  push(value: StreamChunk): void {
+    if (this.ended) return
+    const waiter = this.waiters.shift()
+    if (waiter !== undefined) waiter({ done: false, value })
+    else this.values.push(value)
+  }
+
+  end(): void {
+    if (this.ended) return
+    this.ended = true
+    while (this.waiters.length > 0) {
+      const waiter = this.waiters.shift()
+      if (waiter !== undefined) waiter({ done: true, value: undefined })
+    }
+  }
+
+  fail(error: Error): void {
+    if (this.ended) return
+    this.failure = error
+    this.ended = true
+    while (this.waiters.length > 0) {
+      const waiter = this.waiters.shift()
+      if (waiter !== undefined) waiter({ done: true, value: undefined })
+    }
+  }
+
+  async *[Symbol.asyncIterator](): AsyncIterator<StreamChunk> {
+    for (;;) {
+      if (this.values.length > 0) {
+        const value = this.values.shift()
+        if (value !== undefined) yield value
+        continue
+      }
+      if (this.ended) {
+        if (this.failure !== undefined) throw this.failure
+        return
+      }
+      const next = await new Promise<IteratorResult<StreamChunk>>(resolve => this.waiters.push(resolve))
+      if (next.done) {
+        if (this.failure !== undefined) throw this.failure
+        return
+      }
+      yield next.value
+    }
+  }
+}
+
+interface TurnState {
+  readonly queue: ChunkQueue
+  readonly dshTurn: number
+  readonly dshStep: number
+  readonly onActionRejected: (kind: 'command' | 'file-change' | 'permissions' | 'user-input' | 'elicitation' | 'unknown', decision: 'cancel' | 'decline' | 'empty') => void
+  readonly items: Map<string, TurnItem>
+  readonly reasoningSummaries: Map<string, ReasoningSummaryState>
+  nextReasoningBlockIndex: number
+  totalOutputBytes: number
+  finalAnswerItemId?: string
+  streamedFinalAnswerItemId?: string
+  turnId?: string
+  pendingTurnId?: string
+  turnFailure?: TurnFailure
