+// @vitest-environment jsdom
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { bindSnapshotSelector } from '@deepseek-ai/dsh-client-web-react'
+import {
+  createSnapshotStore, type SessionId, type SessionListState, type SessionSummary,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { en, type ControlSessionKey } from '../src/client/locales.ts'
+import { GlobalPresetSelector } from '../src/client/GlobalPresetSelector.tsx'
+import type { GlobalPresetSelectorProps } from '../src/client/GlobalPresetSelector.tsx'
+import { GlobalPresetController, type GlobalPresetState } from '../src/client/global-preset-store.ts'
+
+afterEach(cleanup)
+
+const t = makeTranslate(en, {}) as (key: ControlSessionKey) => string
+const GLOBAL_ID = 'devframe-global:test' as SessionId
+
+const READY: GlobalPresetState = {
+  status: 'ready',
+  error: null,
+  options: [
+    { id: 'standard', trust: 'system', name: 'Standard' },
+    { id: 'minimal', trust: 'system', name: 'Minimal' },
+    { id: 'broken', trust: 'user', name: 'Broken', broken: 'invalid composition' },
+  ],
+}
+
+function deferred<T>() {
+  let resolve!: (value: T) => void
+  const promise = new Promise<T>((answer) => { resolve = answer })
+  return { promise, resolve }
+}
+
+function sessions(overrides: Partial<SessionSummary> = {}) {
+  return createSnapshotStore<SessionListState>({
+    ids: [GLOBAL_ID],
+    byId: {
+      [GLOBAL_ID]: {
+        id: GLOBAL_ID,
+        displayTitle: 'Global Controller',
+        devframeRole: 'global',
+        agentPreset: 'standard',
+        running: false,
+        blank: false,
+        updatedAt: 1,
+        ...overrides,
+      },
+    },
+    current: GLOBAL_ID,
+    phase: 'ready',
+    subagentsByParent: {},
+    jobsBySession: {},
+    currentAddress: undefined,
+  })
+}
+
+function renderSelector(
+  state: GlobalPresetState = READY,
+  sessionOverrides: Partial<SessionSummary> = {},
+  select = vi.fn(() => Promise.resolve(true)),
+) {
+  const presetStore = createSnapshotStore(state)
+  const sessionStore = sessions(sessionOverrides)
+  const load = vi.fn(() => Promise.resolve())
+  render(<GlobalPresetSelector {...({
+    sessionId: GLOBAL_ID,
+    useSessions: bindSnapshotSelector(sessionStore),
+    useGlobalPresets: bindSnapshotSelector(presetStore),
+    load,
+    select,
+    t,
+  } as unknown as GlobalPresetSelectorProps)} />)
+  return { presetStore, sessionStore, load, select }
+}
+
+describe('Global Controller preset selector', () => {
+  it('keeps the initial empty roster fail-closed', () => {
+    const { load } = renderSelector({ status: 'idle', error: null, options: [] })
+    const trigger = screen.getByRole('button', { name: en['global.preset.select'] })
+    expect(trigger).toHaveProperty('disabled', true)
+    expect(load).toHaveBeenCalledTimes(1)
+    fireEvent.click(trigger)
+    expect(screen.queryByRole('menu')).toBeNull()
+  })
+
+  it('renders one interactive selector from the live roster and marks the current row', () => {
+    const { load } = renderSelector()
+
+    expect(screen.getByRole('button', { name: en['global.preset.select'] })).toBeTruthy()
+    expect(load).toHaveBeenCalledTimes(1)
+    fireEvent.click(screen.getByRole('button', { name: en['global.preset.select'] }))
+
+    const standard = screen.getByRole('menuitem', { name: 'Standard' })
+    expect(standard.querySelector('svg')).not.toBeNull()
+    expect(screen.getByRole('menuitem', { name: 'Minimal' })).toBeTruthy()
+    expect(screen.getByRole('menuitem', { name: /Broken/ })).toHaveProperty('disabled', true)
+  })
+
+  it('re-reads the live roster when the menu opens', async () => {
+    const { load } = renderSelector()
+    fireEvent.click(screen.getByRole('button', { name: en['global.preset.select'] }))
+    await waitFor(() => { expect(load).toHaveBeenCalledTimes(2) })
+  })
+
+  it('allows retrying an initial roster failure before opening the menu', async () => {
+    const list = vi.fn()
+      .mockRejectedValueOnce(new Error('roster offline'))
+      .mockResolvedValueOnce({
+        result: {
+          ok: true,
+          value: { presets: READY.options, authorable: true, hasDocument: false },
+        },
+      })
+    const controller = new GlobalPresetController({ agentPresets: { list } } as never, vi.fn(async () => true))
+    const load = (): Promise<void> => controller.load()
+    render(<GlobalPresetSelector {...({
+      sessionId: GLOBAL_ID,
+      useSessions: bindSnapshotSelector(sessions()),
+      useGlobalPresets: bindSnapshotSelector(controller.store),
+      load,
+      select: (id: string) => controller.select(id),
+      t,
+    } as unknown as GlobalPresetSelectorProps)} />)
+
+    const trigger = screen.getByRole('button', { name: en['global.preset.select'] })
+    await waitFor(() => {
+      expect(controller.store.getSnapshot()).toMatchObject({
+        status: 'error',
+        error: { kind: 'roster', code: 'transport' },
+      })
+    })
+    expect(trigger).toHaveProperty('disabled', false)
+    fireEvent.click(trigger)
+    expect(screen.queryByRole('menu')).toBeNull()
+    await waitFor(() => {
+      expect(controller.store.getSnapshot()).toMatchObject({ status: 'ready' })
+      expect(list).toHaveBeenCalledTimes(2)
+    })
+    fireEvent.click(trigger)
+    expect(screen.getByRole('menuitem', { name: 'Minimal' })).toBeTruthy()
+    expect(list).toHaveBeenCalledTimes(3)
+  })
+
+  it('keeps the existing menu open while a real roster refresh is pending', async () => {
+    const secondRoster = deferred<unknown>()
+    const list = vi.fn()
+      .mockResolvedValueOnce({
+        result: {
+          ok: true,
+          value: { presets: READY.options, authorable: true, hasDocument: false },
+        },
+      })
+      .mockReturnValueOnce(secondRoster.promise)
+    const controller = new GlobalPresetController({ agentPresets: { list } } as never, vi.fn(async () => true))
+    render(<GlobalPresetSelector {...({
+      sessionId: GLOBAL_ID,
+      useSessions: bindSnapshotSelector(sessions()),
+      useGlobalPresets: bindSnapshotSelector(controller.store),
+      load: () => controller.load(),
+      select: (id: string) => controller.select(id),
+      t,
+    } as unknown as GlobalPresetSelectorProps)} />)
+
+    const trigger = screen.getByRole('button', { name: en['global.preset.select'] })
+    await waitFor(() => { expect(trigger).toHaveProperty('disabled', false) })
+    fireEvent.click(trigger)
+    expect(list).toHaveBeenCalledTimes(2)
+    expect(screen.getByRole('menuitem', { name: 'Minimal' })).toBeTruthy()
+
+    secondRoster.resolve({
+      result: {
+        ok: true,
+        value: {
+          presets: [...READY.options, { id: 'terra', trust: 'system', name: 'Terra' }],
+          authorable: true,
+          hasDocument: false,
+        },
+      },
+    })
+    await waitFor(() => { expect(screen.getByRole('menuitem', { name: 'Terra' })).toBeTruthy() })
+    expect(screen.getByRole('menu')).toBeTruthy()
+  })
+
+  it('calls the Global-only selection callback without a profile or session id', async () => {
+    const select = vi.fn(() => Promise.resolve(true))
+    const { sessionStore } = renderSelector(READY, {}, select)
+    fireEvent.click(screen.getByRole('button', { name: en['global.preset.select'] }))
+    fireEvent.click(screen.getByRole('menuitem', { name: 'Minimal' }))
+
+    await waitFor(() => { expect(select).toHaveBeenCalledWith('minimal') })
+    expect(select.mock.calls[0]).toEqual(['minimal'])
+    act(() => {
+      sessionStore.update((next) => {
+        next.byId[GLOBAL_ID] = { ...next.byId[GLOBAL_ID]!, agentPreset: 'minimal' }
+      })
+    })
+    expect(screen.getByRole('button', { name: en['global.preset.select'] }).textContent).toContain('Minimal')
+  })
+
+  it('fails closed for ordinary sessions and for running or pending Global sessions', () => {
+    const ordinary = renderSelector(READY, { devframeRole: 'project' })
+    expect(screen.queryByRole('button', { name: en['global.preset.select'] })).toBeNull()
+    cleanup()
+
+    renderSelector(READY, { running: true })
+    expect(screen.getByRole('button', { name: en['global.preset.select'] })).toHaveProperty('disabled', true)
+    cleanup()
+
+    renderSelector(READY, { pendingInteraction: 'approval' as never })
+    expect(screen.getByRole('button', { name: en['global.preset.select'] })).toHaveProperty('disabled', true)
+    expect(ordinary.load).not.toHaveBeenCalled()
+  })
+
+  it('shows a visible accessible error after the Host switch is rejected', async () => {
+    const select = vi.fn(() => Promise.resolve(false))
+    const { presetStore } = renderSelector(READY, {}, select)
+    // The injected callback owns the store transition in the assembled plugin;
+    // emulate that owner update here to keep this component test pure.
+    select.mockImplementation(async () => {
+      presetStore.set({ ...READY, status: 'ready', error: { kind: 'switch', code: 'rejected' } })
+      return false
+    })
+    fireEvent.click(screen.getByRole('button', { name: en['global.preset.select'] }))
+    fireEvent.click(screen.getByRole('menuitem', { name: 'Minimal' }))
+    await waitFor(() => {
+      expect(screen.getByRole('alert').textContent).toContain(en['global.preset.error.switch'])
+    })
+  })
+})
+
+describe('GlobalPresetController', () => {
+  it('keeps broken roster rows visible and delegates a successful switch', async () => {
+    const selectGlobalPreset = vi.fn(() => Promise.resolve(true))
+    const api = {
+      agentPresets: {
+        list: vi.fn().mockResolvedValue({
+          result: {
+            ok: true,
+            value: {
+              presets: READY.options,
+              authorable: true,
+              hasDocument: false,
+            },
+          },
+        }),
+      },
+    } as never
+    const controller = new GlobalPresetController(api, selectGlobalPreset)
+
+    await controller.load()
+    expect(controller.store.getSnapshot().options).toHaveLength(3)
+    expect(await controller.select('minimal')).toBe(true)
+    expect(selectGlobalPreset).toHaveBeenCalledWith('minimal')
+  })
+
+  it('preserves a ready roster after a transient switch failure so retry remains possible', async () => {
+    const selectGlobalPreset = vi.fn()
+      .mockRejectedValueOnce(new Error('socket details must not reach the UI'))
+      .mockResolvedValueOnce(true)
+    const api = {
+      agentPresets: {
+        list: vi.fn().mockResolvedValue({
+          result: {
+            ok: true,
+            value: { presets: READY.options, authorable: true, hasDocument: false },
+          },
+        }),
+      },
+    } as never
+    const controller = new GlobalPresetController(api, selectGlobalPreset)
+
+    await controller.load()
+    expect(await controller.select('minimal')).toBe(false)
+    expect(controller.store.getSnapshot()).toMatchObject({
+      status: 'ready',
+      error: { kind: 'switch', code: 'transport' },
+      options: READY.options,
+    })
+    expect(await controller.select('minimal')).toBe(true)
+    expect(controller.store.getSnapshot()).toMatchObject({ status: 'ready', error: null })
+    expect(selectGlobalPreset).toHaveBeenCalledTimes(2)
+  })
+
+  it('does not let an overlapping roster refresh clear a switch result', async () => {
+    const switchResult = deferred<boolean>()
+    const refreshResult = deferred<unknown>()
+    const list = vi.fn()
+      .mockResolvedValueOnce({
+        result: {
+          ok: true,
+          value: { presets: READY.options, authorable: true, hasDocument: false },
+        },
+      })
+      .mockReturnValueOnce(refreshResult.promise)
+    const selectGlobalPreset = vi.fn(() => switchResult.promise)
+    const controller = new GlobalPresetController({ agentPresets: { list } } as never, selectGlobalPreset)
+
+    await controller.load()
+    const switching = controller.select('minimal')
+    expect(controller.store.getSnapshot().status).toBe('saving')
+    const refreshing = controller.load()
+    expect(controller.store.getSnapshot().status).toBe('saving')
+
+    switchResult.resolve(false)
+    expect(await switching).toBe(false)
+    expect(controller.store.getSnapshot()).toMatchObject({
+      status: 'ready',
+      error: { kind: 'switch', code: 'rejected' },
+    })
+
+    refreshResult.resolve({
+      result: {
+        ok: true,
+        value: {
+          presets: [...READY.options, { id: 'terra', trust: 'system', name: 'Terra' }],
+          authorable: true,
+          hasDocument: false,
+        },
+      },
+    })
+    await refreshing
+    expect(controller.store.getSnapshot()).toMatchObject({
+      status: 'ready',
+      error: { kind: 'switch', code: 'rejected' },
+    })
+    expect(controller.store.getSnapshot().options.map(option => option.id)).toContain('terra')
+  })
+
+  it('surfaces transport failures instead of leaving a busy control', async () => {
+    const api = {
+      agentPresets: {
+        list: vi.fn().mockRejectedValue(new Error('roster offline')),
+      },
+    } as never
+    const controller = new GlobalPresetController(api, vi.fn())
+    await controller.load()
