+    await openButton.click()
+    await expect.poll(async () => (
+      await page.getByText('Opened in Obsidian', { exact: true }).count()
+      + await page.getByRole('alert').count()
+    ), { timeout: 15_000 }).toBe(1)
+    expect(await page.getByText('Opened in Obsidian', { exact: true }).isVisible()).toBe(true)
+
+    expect(nativeCalls).toHaveLength(1)
+    expect(nativeCalls[0]).toMatch(/^obsidian:\/\/open\?path=/u)
+    expect(await page.locator('body').innerText()).not.toContain('obsidian://')
+    expect(await page.locator('body').innerText()).not.toContain(scaffold.harnessHome)
+    const openedSnapshot = await captureStableAria(page, '[role="status"]', scaffold.workspaceCwd)
+
+    nativeFailure = true
+    await openButton.click()
+    await expect.poll(() => page.getByRole('alert').innerText(), { timeout: 15_000 })
+      .toBe('The memory note could not be opened. Try again later.')
+    expect(nativeCalls).toHaveLength(2)
+    expect(await page.locator('body').innerText()).not.toContain('obsidian://')
+    const failedSnapshot = await captureStableAria(page, '[role="status"]', scaffold.workspaceCwd)
