+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex returned a second streamed final answer')
+    }
+    if (state.streamedFinalAnswerItemId === undefined) {
+      state.streamedFinalAnswerItemId = item.id
+      state.queue.push({ type: 'block-start', index: 0, blockType: 'text' })
+    }
+    state.queue.push({ type: 'text-delta', index: 0, text })
+  }
+
+  private emitCompletedText(state: TurnState): void {
+    const completed = [...state.items.values()].filter(item => item.completed && item.type === 'agentMessage')
+    const final = completed.findLast(item => item.phase === 'final_answer')
+    const fallback = completed.findLast(item => item.phase === null || item.phase === undefined)
+    const selected = final ?? fallback
+    if (selected === undefined || selected.text.trim().length === 0) {
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex completed without a final answer')
+    }
+    if (state.streamedFinalAnswerItemId !== undefined) {
