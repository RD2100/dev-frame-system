index 0000000000..a322eb400f
--- /dev/null
+++ b/apps/web/tests/deepseek-inherited-key.e2e.ts
@@ -0,0 +1,68 @@
+// Keyless browser e2e: when the web process has inherited a fake
+// DEEPSEEK_API_KEY, the Models page must still let the operator replace it.
+// The scaffold keeps the shipped DeepSeek adapter mounted and seeds the fake
+// inherited value; the Web profile's allowManagedOverride makes the field
+// writable and stores the replacement in the isolated .credentials.yaml.
+import { readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { credentialRef } from '@deepseek-ai/dsh-credentials'
+import type { Browser, Page } from 'playwright'
+import { chromium } from 'playwright'
+import { afterAll, beforeAll, describe, expect, it, onTestFailed } from 'vitest'
+import { launchWebScaffold, watchConsole, type WebScaffold } from './scaffold.ts'
+import { ZH_BROWSER_LOCALE, saveFailureShot } from './support.ts'
+
+describe('web e2e: DeepSeek API key can replace an inherited environment key', () => {
+  let scaffold: WebScaffold
+  let browser: Browser
+  let page: Page
+  let tripwire: ReturnType<typeof watchConsole>
+
+  beforeAll(async () => {
+    scaffold = await launchWebScaffold({ deepSeekInheritedCredential: 'sk-inherited-fake' })
+    browser = await chromium.launch()
+    page = await browser.newPage({ viewport: { width: 1440, height: 960 }, locale: ZH_BROWSER_LOCALE })
+    tripwire = watchConsole(page)
+    await page.goto(scaffold.baseUrl, { waitUntil: 'load' })
+    await page.waitForSelector('[class*="frame"]', { timeout: 30_000 })
+  }, 120_000)
+
+  afterAll(async () => {
+    await browser?.close()
+    await scaffold?.close()
+  })
+
+  it('keeps the API key input editable and writes the replacement to .credentials.yaml', async () => {
+    onTestFailed(() => saveFailureShot(page, 'web-e2e-deepseek-inherited-key'))
+    await page.getByRole('button', { name: '设置', exact: true }).click()
+    const dialog = page.getByRole('dialog', { name: '设置' })
+    await dialog.waitFor({ timeout: 10_000 })
+    await dialog.getByRole('button', { name: '模型' }).click()
+    const deepSeekRow = dialog.getByText('DeepSeek', { exact: true }).first()
+    await deepSeekRow.waitFor({ timeout: 10_000 })
+    await deepSeekRow.locator('xpath=ancestor::li').getByRole('button', { name: '编辑' }).click()
+    const keyInput = dialog.getByLabel('API 密钥', { exact: true })
+    await keyInput.waitFor({ timeout: 10_000 })
+    expect(await keyInput.isDisabled()).toBe(false)
+
+    await keyInput.fill('sk-web-new-fake')
+    await dialog.getByRole('button', { name: '保存', exact: true }).click()
+    await expect.poll(
+      async () => dialog.getByLabel('API 密钥', { exact: true }).count(),
+      { timeout: 10_000 },
+    ).toBe(0)
+
+    const credentialFile = join(scaffold.harnessHome, '.credentials.yaml')
+    await expect.poll(
+      async () => readFile(credentialFile, 'utf8').catch(() => ''),
+      { timeout: 10_000 },
+    ).toContain('DEEPSEEK_API_KEY: sk-web-new-fake')
+
+    const resolved = await scaffold.ctx.credentials.resolve(credentialRef('DEEPSEEK_API_KEY'))
+    expect(resolved).toEqual({ value: 'sk-web-new-fake', source: 'file' })
+
+    expect(await page.content()).not.toContain('sk-web-new-fake')
+    expect(await page.content()).not.toContain('sk-inherited-fake')
+    expect(tripwire.pageErrors).toEqual([])
+  }, 60_000)
+})
