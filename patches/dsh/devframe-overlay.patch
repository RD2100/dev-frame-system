@@ -0,0 +1,310 @@
+/** Direct GPT subscription Service Provider for one Agent-scoped Codex runtime.
+ *
+ * @module @deepseek-ai/dsh-agent-runtime-codex
+ */
+
+import { Context, Service } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import { isAbsolute } from 'node:path'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { SubprocessRuntime } from '@deepseek-ai/dsh-subprocess'
+import type {} from '@deepseek-ai/dsh-agent'
+import type {} from '@deepseek-ai/dsh-subprocess'
+import {
+  CodexManagedAgentRuntime,
+  CodexLoginLifecycle,
+  probeCodexSubscriptionCapabilities,
+  resolveCodexSubscriptionHome,
+} from './runtime.ts'
+import type {
+  CodexManagedAgentRuntimeOptions,
+  CodexProcessSpawner,
+  CodexSubscriptionProbeOptions,
+} from './runtime.ts'
+import type {
+  CodexSubscriptionCapabilities,
+  CodexSubscriptionConfig,
+  CodexLoginStartResult,
+  CodexLoginStatus,
+} from './types.ts'
+import { CodexRuntimeError } from './types.ts'
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Direct GPT subscription capability and Agent binding service. */
+    codexSubscription: CodexSubscription
+  }
+}
+
+/** Services required by this provider's Service Definition. */
+export const inject = ['agents', 'subprocess'] as const
+
+/** Runtime-owned configuration; callers cannot select a command or route. */
+const Config = z.object({
+  disposeGraceMs: z.number().step(1).min(1).max(5_000),
+}) as z<CodexSubscriptionConfig>
+
+interface CapabilityFlight {
+  readonly key: string
+  readonly controller: AbortController
+  readonly promise: Promise<CodexSubscriptionCapabilities>
+  observers: number
+  settled: boolean
+}
+
+function capabilityCancelled(): CodexRuntimeError {
+  return new CodexRuntimeError('CODEX_CANCELLED', 'Codex capability probe was cancelled')
+}
+
+function capabilityError(error: unknown): CodexRuntimeError {
+  return error instanceof CodexRuntimeError
+    ? error
+    : new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex capability probe failed')
+}
+
+function capabilityKey(cwd: string): string {
+  if (typeof cwd !== 'string' || cwd.length === 0 || !isAbsolute(cwd) || cwd.includes('\0')) {
+    throw new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex capability workspace was invalid')
+  }
+  return process.platform === 'win32' ? cwd.replaceAll('\\', '/').toLowerCase() : cwd
+}
+
+/**
+ * Service Provider for direct GPT subscription sessions through Codex.
+ *
+ * The service is deliberately split from the AgentStepRuntime Consumer:
+ * `capabilities()` is a disposable account/model probe, while `bind()` is
+ * called only from an unpublished Agent setup to register one exact runtime.
+ */
+export class CodexSubscription extends Service {
+  static inject = [...inject]
+  static Config = Config
+
+  readonly config: CodexSubscriptionConfig
+  private readonly spawn: CodexProcessSpawner
+  private readonly bound = new WeakSet<Agent>()
+  private readonly runtimes = new Set<CodexManagedAgentRuntime>()
+  private readonly probes = new Set<() => Promise<void>>()
+  private readonly capabilityFlights = new Map<string, CapabilityFlight>()
+  private readonly login: CodexLoginLifecycle
+  private readonly codexHome: string
+  private disposed = false
+
+  constructor(ctx: Context, config: CodexSubscriptionConfig = {}) {
+    super(ctx, 'codexSubscription')
+    this.codexHome = resolveCodexSubscriptionHome(ctx.baseUrl)
+    this.config = Object.freeze({
+      ...config.disposeGraceMs === undefined ? {} : { disposeGraceMs: config.disposeGraceMs },
+    })
+    const subprocess: SubprocessRuntime = ctx.subprocess
+    // Keep the subprocess Service as the sole process-spawner seam. No caller
+    // input can replace argv, env, provider, or authentication at this layer.
+    this.spawn = spec => subprocess.spawn(spec)
+    this.login = new CodexLoginLifecycle({
+      spawn: this.spawn,
+      codexHome: this.codexHome,
+      ...this.config.disposeGraceMs === undefined
+        ? {}
+        : { disposeGraceMs: this.config.disposeGraceMs },
+    })
+    ctx.effect(() => async () => {
+      // Close the admission gate before taking teardown snapshots. A caller
+      // retaining this Service reference must not start work after unload has
+      // begun.
+      this.disposed = true
+      const flights = [...this.capabilityFlights.values()]
+      for (const flight of flights) flight.controller.abort()
+      await Promise.all([
+        ...[...this.runtimes].map(runtime => runtime.dispose()),
+        ...[...this.probes].map(dispose => dispose()),
+        ...flights.map(flight => flight.promise.catch(() => undefined)),
+        this.login.dispose(),
+      ])
+    }, 'codexSubscription.dispose()')
+  }
+
+  /**
+   * Read sanitized account and dynamic model facts for an absolute workspace.
+   * This operation starts one disposable app-server probe and never creates a
+   * durable thread or Agent runtime registration.
+   */
+  capabilities(cwd: string, signal: AbortSignal): Promise<CodexSubscriptionCapabilities> {
+    if (this.disposed) {
+      throw new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex subscription service was disposed')
+    }
+    if (signal.aborted) return Promise.reject(capabilityCancelled())
+    let key: string
+    try {
+      key = capabilityKey(cwd)
+    } catch (error: unknown) {
+      return Promise.reject(capabilityError(error))
+    }
+    let flight = this.capabilityFlights.get(key)
+    if (flight === undefined) {
+      const controller = new AbortController()
+      const options: CodexSubscriptionProbeOptions = {
+        spawn: this.spawn,
+        codexHome: this.codexHome,
+        ...this.config.disposeGraceMs === undefined
+          ? {}
+          : { disposeGraceMs: this.config.disposeGraceMs },
+        registerProcess: (dispose) => {
+          this.probes.add(dispose)
+          return () => { this.probes.delete(dispose) }
+        },
+      }
+      const promise = probeCodexSubscriptionCapabilities(cwd, options, controller.signal)
+      const createdFlight: CapabilityFlight = {
+        key,
+        controller,
+        promise,
+        observers: 0,
+        settled: false,
+      }
+      flight = createdFlight
+      this.capabilityFlights.set(key, createdFlight)
+      void promise.then(
+        () => { this.releaseCapabilityFlight(createdFlight) },
+        () => { this.releaseCapabilityFlight(createdFlight) },
+      )
+    }
+    return this.observeCapabilityFlight(flight, signal)
+  }
+
+  private releaseCapabilityFlight(flight: CapabilityFlight): void {
+    flight.settled = true
+    if (this.capabilityFlights.get(flight.key) === flight) this.capabilityFlights.delete(flight.key)
+  }
+
+  private observeCapabilityFlight(
+    flight: CapabilityFlight,
+    signal: AbortSignal,
+  ): Promise<CodexSubscriptionCapabilities> {
+    if (signal.aborted) return Promise.reject(capabilityCancelled())
+    flight.observers += 1
+    return new Promise<CodexSubscriptionCapabilities>((resolve, reject) => {
+      let observed = false
+      const release = (): void => {
+        if (observed) return
+        observed = true
+        signal.removeEventListener('abort', onAbort)
+        flight.observers -= 1
+        if (flight.observers === 0 && !flight.settled) flight.controller.abort()
+      }
+      const onAbort = (): void => {
+        release()
+        reject(capabilityCancelled())
+      }
+      signal.addEventListener('abort', onAbort, { once: true })
+      if (signal.aborted) {
+        onAbort()
+        return
+      }
+      void flight.promise.then(
+        (value) => {
+          if (observed) return
+          release()
+          resolve(value)
+        },
+        (error: unknown) => {
+          if (observed) return
+          release()
+          reject(capabilityError(error))
+        },
+      )
+    })
+  }
+
+  /** Start one native ChatGPT browser login and return only a DSH attempt id plus validated URL. */
+  loginStart(cwd: string, signal: AbortSignal): Promise<CodexLoginStartResult> {
+    if (this.disposed) {
+      return Promise.reject(new CodexRuntimeError('CODEX_LOGIN_PROCESS_ERROR', 'Codex subscription service was disposed'))
+    }
+    return this.login.start(cwd, signal)
+  }
+
+  /** Poll the current/last bounded login state without starting a process. */
+  loginStatus(attemptId: string): CodexLoginStatus {
+    if (this.disposed) {
+      throw new CodexRuntimeError('CODEX_LOGIN_PROCESS_ERROR', 'Codex subscription service was disposed')
+    }
+    return this.login.status(attemptId)
+  }
+
+  /** Cancel exactly one DSH-owned login attempt and await its process-tree teardown. */
+  loginCancel(attemptId: string, signal: AbortSignal): Promise<CodexLoginStatus> {
+    if (this.disposed) {
+      return Promise.reject(new CodexRuntimeError('CODEX_LOGIN_PROCESS_ERROR', 'Codex subscription service was disposed'))
+    }
+    return this.login.cancel(attemptId, signal)
+  }
+
+  /**
+   * Bind one Agent runtime during unpublished Agent setup.
+   *
+   * The exact Agent is taken from `agentCtx.agent`; a published Agent is
+   * rejected. Registration is owned by that setup fiber and its disposer
+   * awaits the runtime's process-tree teardown before removing the registry
+   * entry.
+   */
+  bind(agentCtx: Context): void {
+    if (this.disposed) {
+      throw new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex subscription service was disposed')
+    }
+    const agent = agentCtx.agent
+    if (agent === undefined) {
+      throw new Error('Codex subscription binding requires an Agent setup context')
+    }
+    if (this.ctx.agents.get(agent.id) !== undefined) {
+      throw new Error('Codex subscription binding must occur before Agent publication')
+    }
+    if (this.bound.has(agent)) {
+      throw new Error('Codex subscription runtime is already bound for this Agent')
+    }
+
+    const options: CodexManagedAgentRuntimeOptions = {
+      spawn: this.spawn,
+      codexHome: this.codexHome,
+      ...this.config.disposeGraceMs === undefined
+        ? {}
+        : { disposeGraceMs: this.config.disposeGraceMs },
+    }
+    const runtime = new CodexManagedAgentRuntime(agent, options)
+    let registration: (() => void) | undefined
+    try {
+      registration = agentCtx.agents.registerStepRuntime(agent, runtime)
+      this.bound.add(agent)
+      this.runtimes.add(runtime)
+      agentCtx.effect(() => async () => {
+        try {
+          await runtime.dispose()
+        } finally {
+          registration?.()
+          this.runtimes.delete(runtime)
+          this.bound.delete(agent)
+        }
+      }, `codexSubscription.bind(${agent.id})`)
+    } catch (error: unknown) {
+      registration?.()
+      this.runtimes.delete(runtime)
+      this.bound.delete(agent)
+      void runtime.dispose().catch(() => {})
+      throw error
+    }
+  }
+}
+
+export { CODEX_APP_SERVER_PROTOCOL, CODEX_SUBSCRIPTION_PROVIDER, CodexRuntimeError } from './types.ts'
+export type {
+  CodexAccountAvailability,
+  CodexModelDescriptor,
+  CodexSubscriptionCapabilities,
+  CodexSubscriptionConfig,
+  CodexLoginStartResult,
+  CodexLoginStatus,
+  CodexLoginState,
+  CodexLoginErrorCode,
+  CodexRuntimeFailureCode,
+} from './types.ts'
+
+export default CodexSubscription
