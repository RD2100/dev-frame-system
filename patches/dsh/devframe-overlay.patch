+    // The event vocabulary is declared by the DevFrame package; this focused
+    // Host test constructs the log shape directly (the Host derivation is
+    // deliberately decoupled from that package).
+    const raw = session as unknown as { append: (type: string, data: unknown) => unknown }
+    raw.append('controller/identity', identityPayload('global', 'devframe-global:attached'))
+
+    const response = await api.sessions.list(request({}))
+    expect(response.result.ok).toBe(true)
+    if (!response.result.ok) throw new Error('unreachable')
+    expect(response.result.value.items).toContainEqual(expect.objectContaining({
+      sessionId: 'devframe-global:attached',
+      devframeRole: 'global',
+    }))
+  })
+
+  it('projects devframeRole for a cold controller session from its persisted first event', async () => {
+    const meta = header('devframe-controller:workspace_a', 100)
+    const { api } = await harness({
+      list: () => Promise.resolve([meta]),
+      locate: () => undefined,
+      readFrom: async (id: SessionId) => ({
+        meta,
+        events: [{
+          type: 'controller/identity',
+          seq: 0,
+          time: 100,
+          data: identityPayload('project', id),
+        }] as SessionEvent[],
+      }),
+    })
+
+    const response = await api.sessions.list(request({}))
+    if (!response.result.ok) throw new Error('unreachable')
+    expect(response.result.value.items).toEqual([
+      expect.objectContaining({ sessionId: meta.id, devframeRole: 'project' }),
+    ])
+  })
+
+  it('keeps a near-prefix cold session visible when its first event is not a validated identity', async () => {
+    const meta = header('devframe-global:evil', 100)
+    const readFrom = vi.fn(async () => ({
+      meta,
+      events: [{ type: 'turn/start', seq: 0, time: 100, data: { turn: 1 } }] as SessionEvent[],
+    }))
+    const { api } = await harness({
+      list: () => Promise.resolve([meta]),
+      locate: () => undefined,
+      readFrom,
+    })
+
+    const response = await api.sessions.list(request({}))
+    if (!response.result.ok) throw new Error('unreachable')
+    expect(response.result.value.items).toEqual([
+      expect.objectContaining({ sessionId: meta.id }),
+    ])
+    expect(response.result.value.items[0]).not.toHaveProperty('devframeRole')
+  })
+
+  it('keeps a cold controller session visible when the role probe fails', async () => {
+    const meta = header('devframe-global:broken', 100)
+    const { api } = await harness({
+      list: () => Promise.resolve([meta]),
+      locate: () => undefined,
+      readFrom: async () => { throw new Error('simulated read failure') },
+    })
+
+    const response = await api.sessions.list(request({}))
+    if (!response.result.ok) throw new Error('unreachable')
+    expect(response.result.value.items).toEqual([
+      expect.objectContaining({ sessionId: meta.id }),
+    ])
+    expect(response.result.value.items[0]).not.toHaveProperty('devframeRole')
+  })
+
+  it('keeps a spoofed identity event visible on an ordinary session id', async () => {
+    // A schema-valid identity event on a session whose id carries no matching
+    // controller prefix must NOT earn the role: the role is bound to the id.
+    const { ctx, api } = await harness()
+    const session = ctx.sessions.create(sid('session-plain-1'), { meta: { cwd: '/proj' } })
+    const raw = session as unknown as { append: (type: string, data: unknown) => unknown }
+    raw.append('controller/identity', identityPayload('global', 'devframe-global:spoofed'))
+
+    const response = await api.sessions.list(request({}))
+    expect(response.result.ok).toBe(true)
+    if (!response.result.ok) throw new Error('unreachable')
+    const row = response.result.value.items.find(item => item.sessionId === 'session-plain-1')
+    expect(row).toBeDefined()
+    expect(row).not.toHaveProperty('devframeRole')
+  })
+
+  it('keeps a mismatched-role identity event visible on a controller session', async () => {
+    // A global-role identity event on a project-prefixed id (and vice versa)
+    // is a mismatched binding and must not project.
+    const { ctx, api } = await harness()
+    const session = ctx.sessions.create(sid('devframe-controller:workspace_b'), { meta: { cwd: '/proj' } })
+    const raw = session as unknown as { append: (type: string, data: unknown) => unknown }
+    raw.append('controller/identity', identityPayload('global', 'devframe-global:elsewhere'))
+
+    const response = await api.sessions.list(request({}))
+    if (!response.result.ok) throw new Error('unreachable')
+    const row = response.result.value.items.find(item => item.sessionId === 'devframe-controller:workspace_b')
+    expect(row).toBeDefined()
+    expect(row).not.toHaveProperty('devframeRole')
+  })
+})
