+import { useEffect, useState } from 'react'
+import type { FormEvent } from 'react'
+import type { WorkspaceId, WorkspaceListState } from '@deepseek-ai/dsh-client-runtime/client'
+import type { SnapshotSelectorHook, TranslateNS } from '@deepseek-ai/dsh-client-ui-slots'
+import type {
+  DevFrameLoopReview, DevFrameProjectLoopTrace,
+} from '@deepseek-ai/dsh-devframe-control-session/types'
+import type { ProjectAuthorityState } from './authority.ts'
+import { NS } from './locales.ts'
+import css from './ProjectLoopPanel.module.css'
+
+const MAX_OBJECTIVE_LENGTH = 2_000
+
+export interface ProjectLoopPanelProps {
+  useWorkspaces: SnapshotSelectorHook<WorkspaceListState>
+  useProjectAuthority: SnapshotSelectorHook<ProjectAuthorityState>
+  dispatchProjectLoop: (
+    workspaceId: WorkspaceId,
+    projectRoot: string,
+    objective: string,
+    requestIdempotencyKey: string,
+  ) => Promise<DevFrameProjectLoopTrace>
+  available?: boolean
+  t: TranslateNS<typeof NS>
+}
+
+function memoryStatusKey(status: DevFrameProjectLoopTrace['memoryStatus']):
+  `loop.memory.${DevFrameProjectLoopTrace['memoryStatus']}` {
+  return `loop.memory.${status}`
+}
+
+function reviewStatusKey(review: DevFrameLoopReview): `loop.review.${DevFrameLoopReview}` {
+  return `loop.review.${review}`
+}
+
+/** Operator entry for the Host-owned Global→Project governed loop. */
+export function ProjectLoopPanel({
+  useWorkspaces, useProjectAuthority, dispatchProjectLoop, available = true, t,
+}: ProjectLoopPanelProps) {
+  const workspaces = useWorkspaces(state => state.items)
+  const authority = useProjectAuthority(state => state)
+  const [selectedWorkspaceId, setSelectedWorkspaceId] = useState<WorkspaceId | undefined>(
+    workspaces[0]?.workspaceId,
+  )
+  const [objective, setObjective] = useState('')
+  const [running, setRunning] = useState(false)
+  const [result, setResult] = useState<DevFrameProjectLoopTrace | undefined>(undefined)
+  const [failed, setFailed] = useState(false)
+
+  useEffect(() => {
+    if (selectedWorkspaceId !== undefined
+      && workspaces.some(workspace => workspace.workspaceId === selectedWorkspaceId)) return
+    setSelectedWorkspaceId(workspaces[0]?.workspaceId)
+  }, [selectedWorkspaceId, workspaces])
+
+  const selectedWorkspace = workspaces.find(
+    workspace => workspace.workspaceId === selectedWorkspaceId,
+  ) ?? workspaces[0]
+  const selectedAuthority = selectedWorkspace === undefined
+    ? undefined
+    : authority[selectedWorkspace.workspaceId]
+  const canRun = available
+    && selectedAuthority?.status === 'bound'
+    && objective.trim().length > 0
+    && objective.length <= MAX_OBJECTIVE_LENGTH
+    && !running
+
+  if (workspaces.length === 0) {
+    return (
+      <div className={css.panel} role="status">
+        <span className={css.title}>{t('global.projectLoop')}</span>
+        <span className={css.empty}>{t('project.empty')}</span>
+      </div>
+    )
+  }
+
+  const submit = (event: FormEvent<HTMLFormElement>): void => {
+    event.preventDefault()
+    if (selectedWorkspace === undefined) return
+    if (!canRun) return
+    setRunning(true)
+    setFailed(false)
+    setResult(undefined)
+    void dispatchProjectLoop(
+      selectedWorkspace.workspaceId,
+      selectedWorkspace.path,
+      objective.trim(),
+      globalThis.crypto.randomUUID(),
+    ).then((trace) => {
+      setResult(trace)
+    }).catch(() => {
+      setFailed(true)
+    }).finally(() => {
+      setRunning(false)
+    })
+  }
+
+  return (
+    <form className={css.panel} onSubmit={submit}>
+      <span className={css.title}>{t('global.projectLoop')}</span>
+      <label className={css.label} htmlFor="devframe-project-loop-workspace">
+        {t('loop.project')}
+      </label>
+      <select
+        id="devframe-project-loop-workspace"
+        className={css.select}
+        value={selectedWorkspace?.workspaceId ?? ''}
+        disabled={running}
+        onChange={(event) => { setSelectedWorkspaceId(event.target.value as WorkspaceId) }}
+      >
+        {workspaces.map(workspace => (
+          <option key={workspace.workspaceId} value={workspace.workspaceId}>
+            {workspace.title}
+          </option>
+        ))}
+      </select>
+      <span className={css.hint}>
+        {!available
+          ? t('loop.unavailable')
+          : selectedAuthority?.status === 'bound' ? t('loop.bound') : t('loop.bindRequired')}
+      </span>
+      <label className={css.label} htmlFor="devframe-project-loop-objective">
+        {t('loop.objective')}
+      </label>
+      <textarea
+        id="devframe-project-loop-objective"
+        className={css.objective}
+        value={objective}
+        maxLength={MAX_OBJECTIVE_LENGTH}
+        disabled={running}
+        placeholder={t('loop.objectivePlaceholder')}
+        onChange={(event) => { setObjective(event.target.value) }}
+      />
+      <button type="submit" className={css.run} disabled={!canRun || selectedWorkspace === undefined}>
+        {running ? t('loop.running') : t('loop.run')}
+      </button>
+      {failed && <span className={css.error} role="alert">{t('loop.error')}</span>}
+      {result !== undefined && (
+        <span className={css.result} role="status" aria-live="polite">
+          {result.outcome === 'completed' ? t('loop.completed') : t('loop.failed')}
+          {' · '}
+          {t(reviewStatusKey(result.review))}
+          {' · '}
+          {t(memoryStatusKey(result.memoryStatus))}
+        </span>
+      )}
+    </form>
+  )
+}
