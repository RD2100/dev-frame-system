index 0000000000..bff2774243
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/readiness.ts
@@ -0,0 +1,154 @@
+import type { Context } from '@deepseek-ai/cordis'
+import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+import type { DevFrameReadinessSnapshot } from '@deepseek-ai/dsh-devframe-control-session/types'
+import { devframeRemoteFace, type DevFrameRemoteNamespace } from './remote-face.ts'
+
+/** The readiness subset consumed by the Global Controller sidebar action. */
+export type GlobalControllerReadinessState = DevFrameReadinessSnapshot
+
+type ReadinessMethod = NonNullable<DevFrameRemoteNamespace['readiness']>
+
+/**
+ * Delay between retries while the Host Remote face has not mounted yet.
+ * Browser plugins activate in parallel, so the `api-remotes` mount (an async
+ * `$mount` chain) can finish after this plugin's synchronous apply already
+ * started the poll; waiting through that window is required.
+ */
+export const DEVFRAME_REMOTE_RETRY_MS = 250
+
+/**
+ * Retry cap for the unmounted Remote face. A face that never arrives after
+ * the cap is a configuration failure and must fail closed instead of polling
+ * forever. The blocked state is terminal for this plugin instance (a page
+ * reload or plugin re-apply restarts the poll); the cap is generous enough
+ * for the in-process async mount chain, which settles in well under it.
+ */
+export const DEVFRAME_REMOTE_MAX_RETRIES = 30
+
+const INITIAL_READINESS: GlobalControllerReadinessState = {
+  status: 'blocked',
+  generation: 0,
+  revision: 0,
+  code: 'BOOTSTRAP_NOT_STARTED',
+}
+
+function blockedReadiness(): GlobalControllerReadinessState {
+  return {
+    status: 'blocked',
+    generation: 0,
+    revision: 0,
+    code: 'CONTROLLER_UNAVAILABLE',
+  }
+}
+
+/**
+ * Owns one cancellable readiness long-poll for the sidebar Global Controller.
+ * A stale or late Remote response cannot publish after restart or disposal.
+ */
+export class GlobalControllerReadiness {
+  readonly store: SnapshotStore<GlobalControllerReadinessState> = createSnapshotStore(INITIAL_READINESS)
+
+  private generation = 0
+  private abort: AbortController | undefined
+
+  /**
+   * Create one readiness poller.
+   * @param retryMs - interval between unmounted-face retries (tests override).
+   * @param maxRetries - retry cap before failing closed (tests override).
+   */
+  constructor(
+    private readonly retryMs = DEVFRAME_REMOTE_RETRY_MS,
+    private readonly maxRetries = DEVFRAME_REMOTE_MAX_RETRIES,
+  ) {}
+
+  /**
+   * Start one readiness generation against the Host Remote face.
+   * @param ctx - browser context; the face is resolved through the non-strict
+   * `ctx.get` lookup because the dynamically mounted namespace never enters a
+   * fiber's inject declaration (see `remote-face.ts`).
+   */
+  start(ctx: Context): void {
+    this.stop()
+    const generation = ++this.generation
+    const controller = new AbortController()
+    this.abort = controller
+    this.store.set({
+      status: 'starting',
+      generation: 0,
+      revision: 0,
+    })
+    void this.poll(ctx, controller.signal, generation)
+  }
+
+  /** Stop the current poll and fence all late responses. */
+  stop(): void {
+    this.generation += 1
+    this.abort?.abort()
+    this.abort = undefined
+  }
+
+  private async poll(
+    ctx: Context,
+    signal: AbortSignal,
+    generation: number,
+  ): Promise<void> {
+    let readiness = devframeRemoteFace(ctx)?.readiness
+    // The `api-remotes` mount is async while this plugin's apply is
+    // synchronous, so the face may not exist yet at first poll: retry the
+    // bounded window instead of failing closed on a startup race, then give
+    // up to the blocked state if the face truly never arrives.
+    let retries = 0
+    while (readiness === undefined) {
+      if (!this.isCurrent(generation, signal)) return
+      retries += 1
+      if (retries > this.maxRetries) {
+        this.publishBlocked(generation, signal)
+        return
+      }
+      await new Promise<void>((resolve) => { setTimeout(resolve, this.retryMs) })
+      if (!this.isCurrent(generation, signal)) return
+      readiness = devframeRemoteFace(ctx)?.readiness
+    }
+
+    let afterRevision = -1
+    let consecutiveFailures = 0
+    while (this.isCurrent(generation, signal)) {
+      let response: Awaited<ReturnType<ReadinessMethod>>
+      try {
+        response = await readiness(afterRevision, signal)
+      } catch {
+        consecutiveFailures += 1
+        if (consecutiveFailures > this.maxRetries) {
+          this.publishBlocked(generation, signal)
+          return
+        }
+        await new Promise<void>((resolve) => { setTimeout(resolve, this.retryMs) })
+        continue
+      }
+      if (!this.isCurrent(generation, signal)) return
+      if (!response.ok) {
+        // One transient Host failure must not strand the poll forever: retry
+        // the bounded window (same cap as the unmounted-face retry) before
+        // failing closed.
+        consecutiveFailures += 1
+        if (consecutiveFailures > this.maxRetries) {
+          this.publishBlocked(generation, signal)
+          return
+        }
+        await new Promise<void>((resolve) => { setTimeout(resolve, this.retryMs) })
+        continue
+      }
+      consecutiveFailures = 0
+      afterRevision = response.value.revision
+      this.store.set(response.value)
+    }
+  }
+
+  private publishBlocked(generation: number, signal: AbortSignal): void {
+    if (this.isCurrent(generation, signal)) this.store.set(blockedReadiness())
+  }
+
+  private isCurrent(generation: number, signal: AbortSignal): boolean {
+    return this.generation === generation && !signal.aborted
+  }
+}
