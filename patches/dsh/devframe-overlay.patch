+/** Derive a bounded, pathless report reference from native Worker events. */
+type SessionEvidenceSource = Pick<Session, 'id' | 'events'>
+
+function createTaskReportEvidence(
+  workerSession: SessionEvidenceSource,
+  assistantEvent: SessionEvent<'assistant/message'>,
+  turnEndEvent: SessionEvent<'turn/end'>,
+): TaskReportEvidenceV1 {
+  const outcome = turnEndEvent.data.reason.kind
+  if (outcome !== 'completed' && outcome !== 'max-tokens') {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  if (assistantEvent.data.turn !== turnEndEvent.data.turn
+    || assistantEvent.seq >= turnEndEvent.seq) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const requestHeader = [...workerSession.events].reverse().find(candidate => candidate.type === 'request/header'
+    && candidate.seq < assistantEvent.seq)
+  const sourceEventSeqs = [...new Set([
+    ...(assistantEvent.sourceEventSeqs ?? []),
+    ...requestHeader === undefined ? [] : [requestHeader.seq],
+    assistantEvent.seq,
+    turnEndEvent.seq,
+  ])].sort((left, right) => left - right)
+  if (sourceEventSeqs.length < 2 || sourceEventSeqs.length > 256
+    || sourceEventSeqs.some(seq => !Number.isSafeInteger(seq) || seq < 0)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const messageSha256 = createHash('sha256')
+    .update(JSON.stringify(assistantEvent.data.message))
+    .digest('hex')
+  const unsigned = {
+    schemaVersion: 1 as const,
+    kind: 'devframe/task-report' as const,
+    sessionId: workerSession.id,
+    messageId: String(assistantEvent.data.message.id),
+    assistantSeq: assistantEvent.seq,
+    turn: assistantEvent.data.turn,
+    step: assistantEvent.data.step,
+    turnEndSeq: turnEndEvent.seq,
+    outcome,
+    sourceEventSeqs,
+    messageSha256,
+    artifactRefs: [messageSha256],
+    trajectoryRefs: sourceEventSeqs.map(seq => ({ sessionId: workerSession.id, seq })),
+  }
+  return { ...unsigned, evidenceSha256: taskReportEvidenceDigest(unsigned) }
+}
