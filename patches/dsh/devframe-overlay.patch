+/** Package-owned invariant companion. @module @deepseek-ai/dsh-devframe-control-session/invariant */
+
+/* jscpd:ignore-start */
+import type { Context } from '@deepseek-ai/cordis'
+import type { InvariantInstaller } from '@deepseek-ai/dsh-invariants'
+
+const PACKAGE_NAME = '@deepseek-ai/dsh-devframe-control-session'
+
+/** Cordis companion plugin name. */
+export const name = 'devframe-control-session-invariant'
+/** Service required before the companion can reserve package ownership. */
+export const inject = ['invariants']
+
+/**
+ * No runtime invariant: controller identity is validated synchronously before
+ * Agent publication and again before a service-owned ready entry is returned.
+ */
+const install: InvariantInstaller = () => {}
+
+/**
+ * Register this package's invariant companion.
+ * @param ctx - Cordis context carrying the invariant service.
+ * @returns the installed registration's disposer after setup succeeds.
+ */
+export const apply = (ctx: Context): Promise<() => void> =>
+  Promise.resolve(ctx.invariants.register(PACKAGE_NAME, install))
+/* jscpd:ignore-end */
diff --git a/packages/devframe/control-session/src/memory.ts b/packages/devframe/control-session/src/memory.ts
new file mode 100644
index 0000000000..fc36d9f7d7
--- /dev/null
+++ b/packages/devframe/control-session/src/memory.ts
@@ -0,0 +1,512 @@
+/**
+ * Governed project-memory bridge and pathless loop/memory event folds.
+ *
+ * The bridge deliberately speaks the existing DevFrame memory MCP over a
+ * short-lived stdio process. DSH never reads a Vault, token, transcript, or
+ * auth file; it sends only the project id and bounded checkpoint facts.
+ *
+ * @module @deepseek-ai/dsh-devframe-control-session/memory
+ */
+
+import type { ChildProcessWithoutNullStreams, SpawnOptions } from 'node:child_process'
+import { spawn } from 'node:child_process'
+import { createInterface } from 'node:readline'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type {
+  DevFrameLoopChangeV1,
+  DevFrameLoopOperation,
+  DevFrameLoopReview,
+  DevFrameMemoryChangeV1,
+  DevFrameMemoryOperation,
+  DevFrameMemoryStatus,
+  DevFrameProjectLoopTrace,
+} from './types.ts'
+import { ControlSessionError } from './index.ts'
+
+/** Durable loop event type written only by the Host. */
+export const LOOP_CHANGE_EVENT_TYPE = 'devframe/loop' as const
+/** Durable governed-memory event type written only by the Host. */
+export const MEMORY_CHANGE_EVENT_TYPE = 'devframe/memory' as const
+
+const LOOP_KEYS = [
+  'schemaVersion', 'kind', 'version', 'operation', 'loopId', 'objectiveId',
+  'projectId', 'changedAt',
+] as const
+const MEMORY_KEYS = [
+  'schemaVersion', 'kind', 'version', 'operation', 'loopId', 'projectId',
+  'status', 'changedAt',
+] as const
+const LOOP_OPTIONAL_KEYS = [
+  'projectSessionId', 'runSessionId', 'requestIdempotencyKeyHash', 'outcome', 'review',
+] as const
+const MEMORY_OPTIONAL_KEYS = ['idempotencyKeyHash', 'memoryId'] as const
+const ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/u
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return false
+  const prototype = Object.getPrototypeOf(value) as object | null
+  return prototype === Object.prototype || prototype === null
+}
+
+function isId(value: unknown): value is string {
+  return typeof value === 'string' && ID_PATTERN.test(value)
+}
+
+function isEpochMs(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0
+}
+
+function exactKeys(
+  value: Record<string, unknown>,
+  required: readonly string[],
+  optional: readonly string[],
+): boolean {
+  const allowed = new Set([...required, ...optional])
+  return required.every(key => Object.hasOwn(value, key))
+    && Object.keys(value).every(key => allowed.has(key))
+}
+
+/** Validate one durable loop event with exact-key precision. */
+export function parseLoopChange(value: unknown): DevFrameLoopChangeV1 {
+  if (!isRecord(value) || !exactKeys(value, LOOP_KEYS, LOOP_OPTIONAL_KEYS)) {
+    throw new ControlSessionError('LOOP_INVALID')
+  }
+  if (value.schemaVersion !== 1 || value.kind !== 'loop' || value.version !== 1
+    || !isId(value.loopId) || !isId(value.objectiveId) || !isId(value.projectId)
+    || !isEpochMs(value.changedAt)) {
+    throw new ControlSessionError('LOOP_INVALID')
+  }
+  const operations = new Set<DevFrameLoopOperation>([
+    'start', 'memory-recall', 'route', 'dispatch', 'review', 'checkpoint', 'complete', 'fail',
+  ])
+  if (typeof value.operation !== 'string' || !operations.has(value.operation as DevFrameLoopOperation)) {
+    throw new ControlSessionError('LOOP_INVALID')
+  }
+  for (const key of ['projectSessionId', 'runSessionId', 'requestIdempotencyKeyHash'] as const) {
+    if (value[key] !== undefined && !isId(value[key])) throw new ControlSessionError('LOOP_INVALID')
+  }
+  if (value.outcome !== undefined
+    && value.outcome !== 'completed' && value.outcome !== 'failed' && value.outcome !== 'aborted') {
+    throw new ControlSessionError('LOOP_INVALID')
+  }
+  const reviews = new Set<DevFrameLoopReview>(['pending', 'passed', 'failed'])
+  if (value.review !== undefined
+    && (typeof value.review !== 'string' || !reviews.has(value.review as DevFrameLoopReview))) {
+    throw new ControlSessionError('LOOP_INVALID')
+  }
+  return value as unknown as DevFrameLoopChangeV1
+}
+
+/** Validate one durable memory event with exact-key precision. */
+export function parseMemoryChange(value: unknown): DevFrameMemoryChangeV1 {
+  if (!isRecord(value) || !exactKeys(value, MEMORY_KEYS, MEMORY_OPTIONAL_KEYS)) {
+    throw new ControlSessionError('MEMORY_INVALID')
+  }
+  if (value.schemaVersion !== 1 || value.kind !== 'memory' || value.version !== 1
+    || !isId(value.loopId) || !isId(value.projectId) || !isEpochMs(value.changedAt)) {
+    throw new ControlSessionError('MEMORY_INVALID')
+  }
+  const operations = new Set<DevFrameMemoryOperation>([
+    'bound', 'recall', 'write-requested', 'write-committed', 'write-unavailable', 'write-failed',
+  ])
+  const statuses = new Set<DevFrameMemoryStatus>([
+    'unknown', 'current', 'missing', 'stale', 'captured', 'duplicate', 'unavailable', 'failed',
+  ])
+  if (typeof value.operation !== 'string' || !operations.has(value.operation as DevFrameMemoryOperation)
+    || typeof value.status !== 'string' || !statuses.has(value.status as DevFrameMemoryStatus)) {
+    throw new ControlSessionError('MEMORY_INVALID')
+  }
+  for (const key of ['idempotencyKeyHash', 'memoryId'] as const) {
+    if (value[key] !== undefined && !isId(value[key])) throw new ControlSessionError('MEMORY_INVALID')
+  }
+  return value as unknown as DevFrameMemoryChangeV1
+}
+
+/** Fold the latest loop projection for one loop id. */
+export function foldLoop(
+  events: readonly SessionEvent[],
+  loopId: string,
+): DevFrameProjectLoopTrace | undefined {
+  let latest: DevFrameLoopChangeV1 | undefined
+  for (const [index, event] of events.entries()) {
+    if (event.type !== LOOP_CHANGE_EVENT_TYPE) continue
+    if (event.seq !== index) throw new ControlSessionError('LOOP_INVALID')
+    const change = parseLoopChange(event.data)
+    if (change.loopId === loopId) latest = change
+  }
+  if (latest === undefined) return undefined
+  return {
+    loopId: latest.loopId,
+    objectiveId: latest.objectiveId,
+    projectId: latest.projectId,
+    projectSessionId: latest.projectSessionId ?? '' as SessionId,
+    outcome: latest.outcome ?? 'aborted',
+    review: latest.review ?? 'failed',
+    memoryStatus: 'unknown',
+  }
+}
+
+/** Fold the latest governed-memory status for one loop id. */
+export function foldMemory(
+  events: readonly SessionEvent[],
+  loopId: string,
+): DevFrameMemoryChangeV1 | undefined {
+  let latest: DevFrameMemoryChangeV1 | undefined
+  for (const [index, event] of events.entries()) {
+    if (event.type !== MEMORY_CHANGE_EVENT_TYPE) continue
+    if (event.seq !== index) throw new ControlSessionError('MEMORY_INVALID')
+    const change = parseMemoryChange(event.data)
+    if (change.loopId === loopId) latest = change
+  }
+  return latest
+}
+
+/** A safe, pathless recall result returned by a MemoryGateway. */
+export interface MemoryRecallResult {
+  readonly status: Extract<DevFrameMemoryStatus, 'current' | 'missing' | 'stale'>
+  /** Bounded Working Plan text; present only when status is `current`. */
+  readonly plan?: string
+  /** Vault-relative note reference; never an absolute path and never browser-owned. */
+  readonly relativePath?: string
+  /** Provider-issued content hash, when supplied and valid. */
+  readonly planSha256?: string
+  /** Hash of the authoritative project source used for this plan. */
+  readonly sourceSha256?: string
+}
+
+export type { MemoryOpenResult } from './types.ts'
+
+/** A safe, pathless checkpoint result returned by a MemoryGateway. */
+export interface MemoryCheckpointResult {
+  readonly status: Extract<DevFrameMemoryStatus, 'captured' | 'duplicate'>
+  readonly memoryId?: string
+}
+
+export interface MemoryRecallRequest {
+  readonly projectId: string
+  readonly projectRoot: string
+  readonly signal?: AbortSignal
+}
+
+export interface MemoryCheckpointRequest {
+  readonly projectId: string
+  readonly projectRoot: string
+  readonly idempotencyKey: string
+  readonly sessionId: string
+  readonly goal: string
+  readonly outcome: 'completed' | 'failed' | 'aborted'
+  readonly signal?: AbortSignal
+}
+
+/** Host-owned adapter boundary for canonical DevFrame governed memory. */
+export interface DevFrameMemoryGateway {
+  recallProjectPlan(request: MemoryRecallRequest): Promise<MemoryRecallResult>
+  captureProjectCheckpoint(request: MemoryCheckpointRequest): Promise<MemoryCheckpointResult>
+}
+
+/** Bounded public category for an unavailable or rejected memory subprocess. */
+export type MemoryGatewayErrorCode = 'unavailable' | 'protocol' | 'rejected' | 'cancelled'
+
+export class MemoryGatewayError extends Error {
+  constructor(readonly code: MemoryGatewayErrorCode, options?: ErrorOptions) {
+    super(`DevFrame governed memory unavailable: ${code}`, options)
+    this.name = 'MemoryGatewayError'
+  }
+}
+
+interface MemoryGatewayOptions {
+  /** Host-owned executable; defaults to `DEVFRAME_MEMORY_MCP_COMMAND` or `devframe`. */
+  readonly command?: string
+  /** Host-owned argv prefix; defaults to `['memory', 'mcp-stdio']`. */
+  readonly args?: readonly string[]
+  /** Optional control-plane runtime directory, passed as a non-secret env value. */
+  readonly runtimeDir?: string
+  /** Bounded request lifetime. */
+  readonly timeoutMs?: number
+  /** Test seam; production uses node:child_process.spawn with shell disabled. */
+  readonly spawn?: SpawnLike
+}
+
+type SpawnLike = (
+  command: string,
+  args: readonly string[],
+  options: SpawnOptions,
+) => ChildProcessWithoutNullStreams
+
+interface JsonRpcResponse {
+  readonly id?: number
+  readonly result?: {
+    readonly content?: readonly { readonly type: string; readonly text?: string }[]
+    readonly isError?: boolean
+  }
+  readonly error?: { readonly code?: number; readonly message?: string }
+}
+
+const MAX_RPC_LINE = 10 * 1024 * 1024
+/** Keep recalled guidance below one model-context-sized durable message. */
+export const MEMORY_PLAN_MAX_CHARS = 16 * 1024
+const SHA256_PATTERN = /^[0-9a-f]{64}$/u
+const DEFAULT_TIMEOUT_MS = 15_000
+const MEMORY_RELATIVE_PATH_MAX_CHARS = 1_024
+
+/**
+ * Accept only the POSIX-style, Vault-relative path emitted by the Python
+ * memory authority. Empty, absolute, backslash, drive-letter, and traversal
+ * forms are rejected before any native opener can see them.
+ */
+export function isSafeMemoryRelativePath(value: unknown): value is string {
+  if (typeof value !== 'string' || value.length === 0 || value.length > MEMORY_RELATIVE_PATH_MAX_CHARS) {
+    return false
+  }
+  if (value.includes('\u0000') || value.includes('\\') || value.startsWith('/')
+    || /^[A-Za-z]:/u.test(value)) return false
+  const segments = value.split('/')
+  return segments.every(segment => segment.length > 0 && segment !== '.' && segment !== '..')
+}
+
+function safeProcessEnv(runtimeDir: string | undefined): NodeJS.ProcessEnv {
+  const env: NodeJS.ProcessEnv = {}
+  for (const key of ['PATH', 'Path', 'SystemRoot', 'TEMP', 'TMP', 'USERPROFILE', 'HOME', 'APPDATA']) {
+    const value = process.env[key]
+    if (value !== undefined) env[key] = value
+  }
+  for (const key of [
+    'DEVFRAME_RUNTIME_DIR',
+    'DEVFRAME_OBSIDIAN_MEMORY_ROOT',
+    'DEVFRAME_OBSIDIAN_MEMORY_READ_ONLY',
+  ]) {
+    const value = process.env[key]
+    if (value !== undefined) env[key] = value
+  }
+  if (runtimeDir !== undefined) env.DEVFRAME_RUNTIME_DIR = runtimeDir
+  return env
+}
+
+function parseToolPayload(response: JsonRpcResponse): Record<string, unknown> {
+  if (response.error !== undefined || response.result === undefined) {
+    throw new MemoryGatewayError('protocol')
+  }
+  const text = response.result.content?.find(item => item.type === 'text')?.text
+  if (typeof text !== 'string' || text.length > MAX_RPC_LINE || response.result.isError === true) {
+    throw new MemoryGatewayError('rejected')
+  }
+  try {
+    const value: unknown = JSON.parse(text)
+    if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+      throw new Error('not an object')
+    }
+    return value as Record<string, unknown>
+  } catch (failure) {
+    throw new MemoryGatewayError('protocol', { cause: failure })
+  }
+}
+
+function parseMemoryRecallPayload(payload: Record<string, unknown>): MemoryRecallResult {
+  const status = payload.status
+  if (status !== 'current' && status !== 'missing' && status !== 'stale') {
+    throw new MemoryGatewayError('protocol')
+  }
+  if (status !== 'current') return { status }
+
+  const plan = payload.plan
+  if (typeof plan !== 'string' || plan.length === 0 || plan.length > MEMORY_PLAN_MAX_CHARS
+    || plan.includes('\u0000')) {
+    throw new MemoryGatewayError('protocol')
+  }
+  const planSha256 = payload.planSha256
+  const sourceSha256 = payload.sourceSha256
+  const relativePath = payload.relativePath
+  if (relativePath !== undefined && !isSafeMemoryRelativePath(relativePath)) {
+    throw new MemoryGatewayError('protocol')
+  }
+  if (planSha256 !== undefined && (typeof planSha256 !== 'string' || !SHA256_PATTERN.test(planSha256))) {
+    throw new MemoryGatewayError('protocol')
+  }
+  if (sourceSha256 !== undefined && (typeof sourceSha256 !== 'string' || !SHA256_PATTERN.test(sourceSha256))) {
+    throw new MemoryGatewayError('protocol')
+  }
+  return {
+    status,
+    plan,
+    ...relativePath === undefined ? {} : { relativePath },
+    ...planSha256 === undefined ? {} : { planSha256 },
+    ...sourceSha256 === undefined ? {} : { sourceSha256 },
+  }
+}
+
+async function withMemoryProcess<T>(
+  request: MemoryRecallRequest | MemoryCheckpointRequest,
+  options: Required<Pick<MemoryGatewayOptions, 'command' | 'args' | 'timeoutMs'>>
+    & Pick<MemoryGatewayOptions, 'runtimeDir'>
+    & { readonly spawn: SpawnLike },
+  call: (request: (method: string, params?: Record<string, unknown>) => Promise<JsonRpcResponse>) => Promise<T>,
+): Promise<T> {
+  request.signal?.throwIfAborted()
+  const spawnFn = options.spawn
+  let child: ChildProcessWithoutNullStreams
+  try {
+    const spawnOptions: SpawnOptions = {
+      cwd: request.projectRoot,
+      shell: false,
+      windowsHide: true,
+      stdio: ['pipe', 'pipe', 'pipe'],
+      env: safeProcessEnv(options.runtimeDir),
+    }
+    child = spawnFn(options.command, [...options.args], spawnOptions)
+  } catch (failure) {
+    throw new MemoryGatewayError('unavailable', { cause: failure })
+  }
+  const lineReader = createInterface({ input: child.stdout })
+  let nextId = 0
+  let closed = false
+  const pending = new Map<number, { resolve: (value: JsonRpcResponse) => void; reject: (failure: unknown) => void }>()
+  const rejectPending = (failure: unknown): void => {
+    for (const entry of pending.values()) entry.reject(failure)
+    pending.clear()
+  }
+  const onLine = (line: string): void => {
+    if (line.length > MAX_RPC_LINE) {
+      rejectPending(new MemoryGatewayError('protocol'))
+      return
+    }
+    let value: unknown
+    try { value = JSON.parse(line) } catch { return }
+    if (value === null || typeof value !== 'object' || Array.isArray(value)) return
+    const response = value as JsonRpcResponse
+    if (typeof response.id !== 'number') return
+    const entry = pending.get(response.id)
+    if (entry === undefined) return
+    pending.delete(response.id)
+    entry.resolve(response)
+  }
+  lineReader.on('line', onLine)
+  const onError = (failure: unknown): void => {
+    rejectPending(new MemoryGatewayError('unavailable', { cause: failure }))
+  }
+  const onClose = (): void => {
+    closed = true
+    rejectPending(new MemoryGatewayError('unavailable'))
+  }
+  child.on('error', onError)
+  child.on('close', onClose)
+  const onAbort = (): void => {
+    rejectPending(new MemoryGatewayError('cancelled'))
+    if (!child.killed) child.kill()
+  }
+  request.signal?.addEventListener('abort', onAbort, { once: true })
+  const timer = setTimeout(() => {
+    rejectPending(new MemoryGatewayError('unavailable'))
+    child.kill()
+  }, options.timeoutMs)
+  const rpc = (method: string, params: Record<string, unknown> = {}): Promise<JsonRpcResponse> => {
+    if (closed || child.stdin.destroyed) return Promise.reject(new MemoryGatewayError('unavailable'))
+    const id = ++nextId
+    return new Promise<JsonRpcResponse>((resolve, reject) => {
+      pending.set(id, { resolve, reject })
+      try {
+        child.stdin.write(JSON.stringify({ jsonrpc: '2.0', id, method, params }) + '\n')
+      } catch (failure) {
+        pending.delete(id)
+        reject(new MemoryGatewayError('unavailable', { cause: failure }))
+      }
+    })
+  }
+  try {
+    await rpc('initialize', {
+      protocolVersion: '2025-06-18',
+      capabilities: {},
+      clientInfo: { name: 'dsh-devframe-control-session', version: '0.1' },
+    })
+    return await call(rpc)
+  } catch (failure) {
+    if (failure instanceof MemoryGatewayError) throw failure
+    throw new MemoryGatewayError('unavailable', { cause: failure })
+  } finally {
+    clearTimeout(timer)
+    request.signal?.removeEventListener('abort', onAbort)
+    rejectPending(new MemoryGatewayError('unavailable'))
+    lineReader.close()
+    const close = new Promise<void>((resolve) => {
+      if (closed || child.exitCode !== null) {
+        resolve()
+        return
+      }
+      child.once('close', () => { resolve() })
+    })
+    child.stdin.end()
+    if (!child.killed) child.kill()
+    let closeTimer: ReturnType<typeof setTimeout> | undefined
+    await Promise.race([
+      close,
+      new Promise<void>((resolve) => {
+        closeTimer = setTimeout(resolve, 1_000)
+      }),
+    ])
+    if (closeTimer !== undefined) clearTimeout(closeTimer)
+  }
+}
+
+function normalizeOptions(options: MemoryGatewayOptions): Required<Pick<MemoryGatewayOptions, 'command' | 'args' | 'timeoutMs'>>
+  & Pick<MemoryGatewayOptions, 'runtimeDir'> & { readonly spawn: SpawnLike } {
+  const command = options.command ?? process.env.DEVFRAME_MEMORY_MCP_COMMAND ?? 'devframe'
+  const args = options.args ?? ['memory', 'mcp-stdio']
+  const timeoutMs = options.timeoutMs ?? DEFAULT_TIMEOUT_MS
+  if (typeof command !== 'string' || command.trim().length === 0
+    || args.length > 16 || args.some(arg => typeof arg !== 'string' || arg.length > 64 * 1024)
+    || !Number.isSafeInteger(timeoutMs) || timeoutMs <= 0 || timeoutMs > 120_000) {
+    throw new Error('invalid governed memory process options')
+  }
+  return {
+    command,
+    args,
+    timeoutMs,
+    ...options.runtimeDir === undefined ? {} : { runtimeDir: options.runtimeDir },
+    spawn: options.spawn ?? ((program, argv, spawnOptions) => {
+      return spawn(program, [...argv], spawnOptions) as ChildProcessWithoutNullStreams
+    }),
+  }
+}
+
+/** Create the default adapter to DevFrame's existing project-bound memory MCP. */
+export function createDevFrameMcpMemoryGateway(options: MemoryGatewayOptions = {}): DevFrameMemoryGateway {
+  const normalized = normalizeOptions(options)
+  return {
+    async recallProjectPlan(request): Promise<MemoryRecallResult> {
+      const payload = await withMemoryProcess(request, normalized, async (rpc) => {
+        return parseToolPayload(await rpc('tools/call', {
+          name: 'recall_project_plan',
+          // The stdio server derives and binds the project id from cwd. Never
+          // send the DSH Workspace id as a forged cross-project selector.
+          arguments: {},
+        }))
+      })
+      return parseMemoryRecallPayload(payload)
+    },
+    async captureProjectCheckpoint(request): Promise<MemoryCheckpointResult> {
+      const payload = await withMemoryProcess(request, normalized, async (rpc) => {
+        return parseToolPayload(await rpc('tools/call', {
+          name: 'capture_project_checkpoint',
+          arguments: {
+            idempotencyKey: request.idempotencyKey,
+            sessionId: request.sessionId,
+            trigger: 'controller-loop',
+            goal: request.goal,
+            decisions: [],
+            failedAttempts: request.outcome === 'failed' ? ['project-controller-round-failed'] : [],
+            verification: [`project-controller:${request.outcome}`],
+            blockers: request.outcome === 'aborted' ? ['project-controller-round-aborted'] : [],
+            nextAction: request.outcome === 'completed' ? 'continue' : 'review-and-retry',
+          },
+        }))
+      })
+      const status = payload.status === 'captured' || payload.status === 'duplicate'
+        ? payload.status
+        : payload.duplicate === true ? 'duplicate'
+          : payload.created === true ? 'captured' : undefined
+      if (status === undefined) throw new MemoryGatewayError('protocol')
+      const memoryId = payload.memoryId
+      return { status, ...typeof memoryId === 'string' && ID_PATTERN.test(memoryId) ? { memoryId } : {} }
+    },
+  }
+}
diff --git a/packages/devframe/control-session/src/policy.ts b/packages/devframe/control-session/src/policy.ts
new file mode 100644
index 0000000000..2fc4243421
--- /dev/null
+++ b/packages/devframe/control-session/src/policy.ts
@@ -0,0 +1,616 @@
+/**
+ * Slice 1C-A ContextPacket / PolicyDecision / asset-freeze fold — pure
+ * functions only, no wiring.
+ *
+ * The three projections mirror the 1A/1B fold pattern over the Global
+ * Controller log (`task-board.ts`, `roster.ts`): every payload is validated in
+ * exact-key style, folds are last-wins, and the policy gate fails closed
+ * (missing / expired / conflict / over-budget / forbidden all fail before the
+ * first tool call — the wiring slice turns the deny decision into a
+ * `POLICY_DENIED` throw). The 1C event types (`policy/rule`, `run/frozen`, and
+ * `policy/decision`) are declared in the typed session vocabulary (types.ts
+ * lane / design §12). The folds still read the log through the structural
+ * {@link RawSessionEvent} shape so they can validate and replay a complete log
+ * without coupling to the SessionEventMap discriminant.
+ *
+ * @module @deepseek-ai/dsh-devframe-control-session/policy
+ */
+
+import { createHash } from 'node:crypto'
+import { ControlSessionError } from './index.ts'
+import type { PolicyDecisionV1 } from './types.ts'
+
+/** The durable event type carrying one PolicyRule mutation (Global log). */
+export const POLICY_RULE_EVENT_TYPE = 'policy/rule' as const
+
+/** The durable event type carrying one run asset-freeze snapshot. */
+export const RUN_FROZEN_EVENT_TYPE = 'run/frozen' as const
+
+/**
+ * The durable event type carrying one PolicyDecision (Global log; declared in
+ * the typed session vocabulary — types.ts SessionEventMap — from 1C-C on).
+ */
+export const POLICY_DECISION_EVENT_TYPE = 'policy/decision' as const
+
+/**
+ * Structural session event read by the 1C folds. Any real `SessionEvent[]` log
+ * is assignable to it (its `type` union widens to `string` and its `data` to
+ * `unknown`).
+ */
+export interface RawSessionEvent {
+  readonly type: string
+  readonly seq: number
+  readonly time: number
+  readonly data: unknown
+}
+
+/** The five PolicyDecision kinds (MVP Slice 1C). */
+export type PolicyDecisionKind =
+  | 'allow'
+  | 'draft_only'
+  | 'review_required'
+  | 'human_required'
+  | 'deny'
+
+/** The six ContextPacket roles (MVP Slice 1C). */
+export type ContextRole =
+  | 'planner'
+  | 'executor'
+  | 'verifier'
+  | 'reviewer'
+  | 'researcher'
+  | 'writer'
+
+/**
+ * Match constraints of one policy rule. Every PRESENT constraint must hold for
+ * the rule to match; an empty match (`{}`) matches everything.
+ */
+export interface PolicyRuleMatchV1 {
+  /** Matches the ContextPacket's role — the role IS the context kind. */
+  readonly contextKind?: string
+  /** Matches the tool action being evaluated (e.g. `edit`). */
+  readonly action?: string
+  /**
+   * Workspace scope. Fail-closed: a workspace-scoped rule never matches a
+   * packet that carries no workspace scope (this slice's packets never do).
+   */
+  readonly workspaceId?: string
+}
+
+/** One policy rule: match + decision + obligation/evidence/expiry (MVP four elements). */
+export interface PolicyRuleV1 {
+  readonly schemaVersion: 1
+  readonly id: string
+  readonly kind: PolicyDecisionKind
+  readonly match: PolicyRuleMatchV1
+  /** Human-visible obligation attached to the decision (e.g. "quote sources"). */
+  readonly obligation?: string
+  /** Reference to the evidence backing this rule (reference only, never a copy). */
+  readonly evidenceRef?: string
+  /** Epoch-ms expiry; absent = never expires. Expired rules are skipped. */
+  readonly expiresAt?: number
+}
+
+/** One context source: kind + stable ref + content sha256 + byte size. */
+export interface ContextSourceV1 {
+  readonly kind: string
+  readonly ref: string
+  readonly sha256: string
+  readonly bytes: number
+}
+
+/** The minimal ContextPacket one role receives (MVP Slice 1C four elements). */
+export interface ContextPacketV1 {
+  readonly schemaVersion: 1
+  readonly role: ContextRole
+  readonly sources: readonly ContextSourceV1[]
+  /** Sum of source bytes, stamped at assembly. */
+  readonly totalBytes: number
+  /** Assembly budget: totalBytes > maxBytes is rejected. */
+  readonly maxBytes: number
+  /** Epoch-ms assembly time (injected for deterministic tests). */
+  readonly assembledAt: number
+  /** Epoch-ms freshness bound; absent = never expires. */
+  readonly expiresAt?: number
+}
+
+/** One frozen asset of a Run snapshot. */
+export interface FrozenAssetEntryV1 {
+  readonly kind: string
+  readonly ref: string
+  readonly sha256: string
+  /** Publishing profile identity; absent assets fail closed as ASSET_UNATTESTED. */
+  readonly attestedBy?: string
+}
+
+/** The frozen asset snapshot of one Run (MVP: mid-run asset changes never mutate it). */
+export interface FrozenAssetV1 {
+  readonly schemaVersion: 1
+  readonly runId: string
+  readonly assets: readonly FrozenAssetEntryV1[]
+}
+
+/** The fail-closed result of one policy evaluation. */
+export interface PolicyEvaluation {
+  readonly kind: PolicyDecisionKind
+  /** `rule` when a rule matched; `no matching rule` for the default deny. */
+  readonly reason: 'rule' | 'no matching rule'
+  /** The matched rule; absent on the default deny. */
+  readonly rule?: PolicyRuleV1
+  readonly packet: ContextPacketV1
+}
+
+/** Input for one ContextPacket assembly (the pure, un-wired seam). */
+export interface AssembleContextPacketOptions {
+  readonly role: ContextRole
+  /** Source list; empty/absent means nothing was assembled (CONTEXT_MISSING). */
+  readonly sources: readonly ContextSourceV1[]
+  /** Assembly budget in bytes. */
+  readonly maxBytes: number
+  /** Epoch-ms freshness bound; absent = never expires. */
+  readonly expiresAt?: number
+  /** Epoch-ms "now" for expiry (injected for deterministic tests). */
+  readonly now?: number
+}
+
+const CONTEXT_REQUIRED_KEYS = [
+  'schemaVersion',
+  'role',
+  'sources',
+  'totalBytes',
+  'maxBytes',
+  'assembledAt',
+] as const
+const CONTEXT_OPTIONAL_KEYS = ['expiresAt'] as const
+const CONTEXT_SOURCE_KEYS = ['kind', 'ref', 'sha256', 'bytes'] as const
+
+const POLICY_RULE_REQUIRED_KEYS = ['schemaVersion', 'id', 'kind', 'match'] as const
+const POLICY_RULE_OPTIONAL_KEYS = ['obligation', 'evidenceRef', 'expiresAt'] as const
+const POLICY_RULE_MATCH_KEYS = ['contextKind', 'action', 'workspaceId'] as const
+
+const FROZEN_REQUIRED_KEYS = ['schemaVersion', 'runId', 'assets'] as const
+const FROZEN_ASSET_REQUIRED_KEYS = ['kind', 'ref', 'sha256'] as const
+const FROZEN_ASSET_OPTIONAL_KEYS = ['attestedBy'] as const
+
+const CONTEXT_ROLES = new Set<ContextRole>([
+  'planner', 'executor', 'verifier', 'reviewer', 'researcher', 'writer',
+])
+const POLICY_DECISION_KINDS = new Set<PolicyDecisionKind>([
+  'allow', 'draft_only', 'review_required', 'human_required', 'deny',
+])
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return false
+  const prototype: unknown = Object.getPrototypeOf(value)
+  return prototype === Object.prototype || prototype === null
+}
+
+function isNonEmptyString(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0
+}
+
+function isEpochMs(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0
+}
+
+/** A content-addressing sha256: exactly 64 lowercase/uppercase hex digits. */
+function isSha256Hex(value: unknown): value is string {
+  return typeof value === 'string' && /^[0-9a-f]{64}$/i.test(value)
+}
+
+/**
+ * Validate one ContextPacket with exact-key precision (mirroring
+ * `parseTaskPayload`): unknown keys, missing required keys, or mistyped fields
+ * are `CONTEXT_INVALID`. Then the fail-closed semantic checks run in a fixed
+ * order: missing sources → `CONTEXT_MISSING`, duplicate source refs →
+ * `CONTEXT_CONFLICT`, a totalBytes that does not equal the source sum
+ * (tamper) → `CONTEXT_INVALID`, over budget → `CONTEXT_OVER_BUDGET`, past
+ * expiry → `CONTEXT_EXPIRED`.
+ * @param value - the packet to validate (raw, untyped at the boundary).
+ * @param now - epoch-ms "now" for the expiry check (deterministic tests).
+ * @returns the validated, normalized ContextPacket.
+ */
+export function validateContextPacket(
+  value: unknown,
+  now: number = Date.now(),
+): ContextPacketV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('CONTEXT_INVALID')
+  const allowed = new Set<string>([...CONTEXT_REQUIRED_KEYS, ...CONTEXT_OPTIONAL_KEYS])
+  if (Object.keys(value).some(key => !allowed.has(key))) throw new ControlSessionError('CONTEXT_INVALID')
+  // CONTEXT_MISSING: a packet must carry at least one source; an absent,
+  // non-array, or empty source set means nothing was assembled (fail-closed).
+  if (!Array.isArray(value.sources) || value.sources.length === 0) {
+    throw new ControlSessionError('CONTEXT_MISSING')
+  }
+  for (const key of CONTEXT_REQUIRED_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('CONTEXT_INVALID')
+  }
+  const { schemaVersion, role, sources, totalBytes, maxBytes, assembledAt } = value
+  if (schemaVersion !== 1) throw new ControlSessionError('CONTEXT_INVALID')
+  if (typeof role !== 'string' || !CONTEXT_ROLES.has(role as ContextRole)) {
+    throw new ControlSessionError('CONTEXT_INVALID')
+  }
+  if (typeof totalBytes !== 'number' || !Number.isSafeInteger(totalBytes) || totalBytes < 0) {
+    throw new ControlSessionError('CONTEXT_INVALID')
+  }
+  if (typeof maxBytes !== 'number' || !Number.isSafeInteger(maxBytes) || maxBytes < 0) {
+    throw new ControlSessionError('CONTEXT_INVALID')
+  }
+  if (!isEpochMs(assembledAt)) throw new ControlSessionError('CONTEXT_INVALID')
+  // Every source is validated in exact-key style; the refs must be unique.
+  const parsedSources: ContextSourceV1[] = []
+  const refs = new Set<string>()
+  let sum = 0
+  for (const source of sources) {
+    const parsed = parseContextSource(source)
+    if (refs.has(parsed.ref)) throw new ControlSessionError('CONTEXT_CONFLICT')
+    refs.add(parsed.ref)
+    parsedSources.push(parsed)
+    sum += parsed.bytes
+  }
+  // A claimed totalBytes that does not match the source sum is tampering.
+  if (totalBytes !== sum) throw new ControlSessionError('CONTEXT_INVALID')
+  if (totalBytes > maxBytes) throw new ControlSessionError('CONTEXT_OVER_BUDGET')
+  const expiresAt = value.expiresAt
+  if (expiresAt !== undefined) {
+    if (!isEpochMs(expiresAt)) throw new ControlSessionError('CONTEXT_INVALID')
+    if (expiresAt < now) throw new ControlSessionError('CONTEXT_EXPIRED')
+  }
+  return {
+    schemaVersion: 1,
+    role: role as ContextRole,
+    sources: parsedSources,
+    totalBytes,
+    maxBytes,
+    assembledAt,
+    ...expiresAt === undefined ? {} : { expiresAt },
+  }
+}
+
+/**
+ * Validate one context source entry in exact-key style; any structural or
+ * typing violation is `CONTEXT_INVALID`.
+ * @param value - the raw source entry.
+ * @returns the validated source entry.
+ */
+function parseContextSource(value: unknown): ContextSourceV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('CONTEXT_INVALID')
+  const allowed = new Set<string>(CONTEXT_SOURCE_KEYS)
+  if (Object.keys(value).some(key => !allowed.has(key))) throw new ControlSessionError('CONTEXT_INVALID')
+  for (const key of CONTEXT_SOURCE_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('CONTEXT_INVALID')
+  }
+  const { kind, ref, sha256, bytes } = value
+  if (!isNonEmptyString(kind) || !isNonEmptyString(ref) || !isNonEmptyString(sha256)) {
+    throw new ControlSessionError('CONTEXT_INVALID')
+  }
+  if (typeof bytes !== 'number' || !Number.isSafeInteger(bytes) || bytes < 0) {
+    throw new ControlSessionError('CONTEXT_INVALID')
+  }
+  return { kind, ref, sha256, bytes }
+}
+
+/**
+ * Assemble one ContextPacket from its sources: sum the bytes, reject
+ * duplicates and the missing/empty case, enforce the byte budget, and stamp
+ * the assembly time. Fail-closed: any violation throws `CONTEXT_*` before the
+ * packet is ever handed to a Worker.
+ * @param options - role, sources, budget, optional expiry, and "now".
+ * @returns the assembled ContextPacket.
+ */
+export function assembleContextPacket(options: AssembleContextPacketOptions): ContextPacketV1 {
+  const now = options.now ?? Date.now()
+  if (!isEpochMs(now)) throw new ControlSessionError('CONTEXT_INVALID')
+  if (options.sources.length === 0) throw new ControlSessionError('CONTEXT_MISSING')
+  if (!CONTEXT_ROLES.has(options.role)) throw new ControlSessionError('CONTEXT_INVALID')
+  if (typeof options.maxBytes !== 'number' || !Number.isSafeInteger(options.maxBytes) || options.maxBytes < 0) {
+    throw new ControlSessionError('CONTEXT_INVALID')
+  }
+  const sources: ContextSourceV1[] = []
+  const refs = new Set<string>()
+  let totalBytes = 0
+  for (const source of options.sources) {
+    const parsed = parseContextSource(source)
+    if (refs.has(parsed.ref)) throw new ControlSessionError('CONTEXT_CONFLICT')
+    refs.add(parsed.ref)
+    sources.push(parsed)
+    totalBytes += parsed.bytes
+  }
+  if (totalBytes > options.maxBytes) throw new ControlSessionError('CONTEXT_OVER_BUDGET')
+  const expiresAt = options.expiresAt
+  if (expiresAt !== undefined) {
+    if (!isEpochMs(expiresAt)) throw new ControlSessionError('CONTEXT_INVALID')
+    if (expiresAt < now) throw new ControlSessionError('CONTEXT_EXPIRED')
+  }
+  return {
+    schemaVersion: 1,
+    role: options.role,
+    sources,
+    totalBytes,
+    maxBytes: options.maxBytes,
+    assembledAt: now,
+    ...expiresAt === undefined ? {} : { expiresAt },
+  }
+}
+
+/**
+ * Content digest of one ContextPacket: the stable evidence reference a
+ * `policy/decision` record carries (design §12.2, 引用不复制). The digest
+ * covers the role and the exact source set — never assembledAt/expiry, so the
+ * same context hashes identically across re-assembly.
+ * @param packet - the assembled ContextPacket.
+ * @returns the lowercase sha256 hex digest.
+ */
+export function contextPacketDigest(packet: ContextPacketV1): string {
+  return createHash('sha256')
+    .update(JSON.stringify({ role: packet.role, sources: packet.sources }))
+    .digest('hex')
+}
+
+/**
+ * Evaluate one action against the FOLDED policy rule set (one rule per id,
+ * last-wins, in first-seen order — see {@link foldPolicyRules}). Rules are
+ * matched in order, first-match-wins; an expired rule (expiresAt in the past)
+ * is SKIPPED — the safer choice, because a skipped rule falls through to the
+ * remaining rules and, with none left, to the fail-closed default deny. A rule
+ * matches only when every PRESENT `match` constraint holds; a workspace-scoped
+ * rule never matches a workspace-less packet.
+ * @param rules - the folded rule set (each id at most once).
+ * @param packet - the ContextPacket whose role is the context kind.
+ * @param action - the tool action being gated.
+ * @param now - epoch-ms "now" for rule expiry (deterministic tests).
+ * @returns the decision: the matched rule's kind, or the default `deny`.
+ */
+export function evaluatePolicy(
+  rules: readonly PolicyRuleV1[],
+  packet: ContextPacketV1,
+  action: string,
+  now: number = Date.now(),
+): PolicyEvaluation {
+  for (const rule of rules) {
+    if (rule.expiresAt !== undefined && rule.expiresAt < now) continue
+    if (!ruleMatches(rule, packet, action)) continue
+    return { kind: rule.kind, reason: 'rule', rule, packet }
+  }
+  // Fail-closed: no matching rule (or only expired ones) → default deny.
+  return { kind: 'deny', reason: 'no matching rule', packet }
+}
+
+/** Whether one rule's present match constraints all hold for the packet+action. */
+function ruleMatches(
+  rule: PolicyRuleV1,
+  packet: ContextPacketV1,
+  action: string,
+): boolean {
+  const { contextKind, action: matchAction, workspaceId } = rule.match
+  // The role IS the context kind: a packet assembled for a role is a context
+  // of that kind (MVP: each role receives its own minimal ContextPacket).
+  if (contextKind !== undefined && contextKind !== packet.role) return false
+  if (matchAction !== undefined && matchAction !== action) return false
+  // Fail-closed: a workspace-scoped rule cannot match a packet that carries no
+  // workspace scope (this slice's packets never carry one).
+  if (workspaceId !== undefined) return false
+  return true
+}
+
+/**
+ * Turn a non-`allow` evaluation into the fail-closed `POLICY_DENIED` throw the
+ * wiring layer raises BEFORE the first tool call (MVP Slice 1C: 越权/forbidden
+ * fail closed). `allow` passes through untouched.
+ * @param evaluation - the policy evaluation to gate on.
+ */
+export function assertPolicyAllowed(evaluation: PolicyEvaluation): void {
+  if (evaluation.kind !== 'allow') {
+    throw new ControlSessionError('POLICY_DENIED', { cause: new Error(evaluation.reason) })
+  }
+}
+
+/**
+ * Validate one `policy/rule` payload with exact-key precision; any structural,
+ * typing, or kind violation is `POLICY_INVALID`.
+ * @param value - the raw rule payload.
+ * @returns the validated, exact policy rule.
+ */
+function parsePolicyRulePayload(value: unknown): PolicyRuleV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('POLICY_INVALID')
+  const allowed = new Set<string>([...POLICY_RULE_REQUIRED_KEYS, ...POLICY_RULE_OPTIONAL_KEYS])
+  if (Object.keys(value).some(key => !allowed.has(key))) throw new ControlSessionError('POLICY_INVALID')
+  for (const key of POLICY_RULE_REQUIRED_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('POLICY_INVALID')
+  }
+  const { schemaVersion, id, kind, match } = value
+  if (schemaVersion !== 1) throw new ControlSessionError('POLICY_INVALID')
+  if (!isNonEmptyString(id)) throw new ControlSessionError('POLICY_INVALID')
+  if (typeof kind !== 'string' || !POLICY_DECISION_KINDS.has(kind as PolicyDecisionKind)) {
+    throw new ControlSessionError('POLICY_INVALID')
+  }
+  if (!isPlainRecord(match)) throw new ControlSessionError('POLICY_INVALID')
+  const matchAllowed = new Set<string>(POLICY_RULE_MATCH_KEYS)
+  if (Object.keys(match).some(key => !matchAllowed.has(key))) throw new ControlSessionError('POLICY_INVALID')
+  const contextKind = match.contextKind
+  if (contextKind !== undefined && !isNonEmptyString(contextKind)) throw new ControlSessionError('POLICY_INVALID')
+  const matchAction = match.action
+  if (matchAction !== undefined && !isNonEmptyString(matchAction)) throw new ControlSessionError('POLICY_INVALID')
+  const workspaceId = match.workspaceId
+  if (workspaceId !== undefined && !isNonEmptyString(workspaceId)) throw new ControlSessionError('POLICY_INVALID')
+  const obligation = value.obligation
+  if (obligation !== undefined && !isNonEmptyString(obligation)) throw new ControlSessionError('POLICY_INVALID')
+  const evidenceRef = value.evidenceRef
+  if (evidenceRef !== undefined && !isNonEmptyString(evidenceRef)) throw new ControlSessionError('POLICY_INVALID')
+  const expiresAt = value.expiresAt
+  if (expiresAt !== undefined && !isEpochMs(expiresAt)) throw new ControlSessionError('POLICY_INVALID')
+  return {
+    schemaVersion: 1,
+    id,
+    kind: kind as PolicyDecisionKind,
+    match: {
+      ...contextKind === undefined ? {} : { contextKind },
+      ...matchAction === undefined ? {} : { action: matchAction },
+      ...workspaceId === undefined ? {} : { workspaceId },
+    },
+    ...obligation === undefined ? {} : { obligation },
+    ...evidenceRef === undefined ? {} : { evidenceRef },
+    ...expiresAt === undefined ? {} : { expiresAt },
+  }
+}
+
+const POLICY_DECISION_REQUIRED_KEYS = ['schemaVersion', 'taskId', 'decision', 'changedAt'] as const
+const POLICY_DECISION_OPTIONAL_KEYS = ['reason', 'ruleId', 'packetDigest'] as const
+
+/**
+ * Validate one `policy/decision` payload with exact-key precision; any
+ * structural, typing, or kind violation is `DECISION_INVALID` (design §12.6:
+ * 伪造 policy/decision fail-closed). The Host is the only writer of the Global
+ * log, so this validator defends the append seam itself — the wiring layer
+ * routes every decision record through it before `session.append`.
+ * @param value - the raw decision payload (untyped at the boundary).
+ * @returns the validated, exact policy decision.
+ */
+export function parsePolicyDecisionPayload(value: unknown): PolicyDecisionV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('DECISION_INVALID')
+  const allowed = new Set<string>([...POLICY_DECISION_REQUIRED_KEYS, ...POLICY_DECISION_OPTIONAL_KEYS])
+  if (Object.keys(value).some(key => !allowed.has(key))) throw new ControlSessionError('DECISION_INVALID')
+  for (const key of POLICY_DECISION_REQUIRED_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('DECISION_INVALID')
+  }
+  const { schemaVersion, taskId, decision, changedAt } = value
+  if (schemaVersion !== 1) throw new ControlSessionError('DECISION_INVALID')
+  if (!isNonEmptyString(taskId)) throw new ControlSessionError('DECISION_INVALID')
+  if (typeof decision !== 'string' || !POLICY_DECISION_KINDS.has(decision as PolicyDecisionKind)) {
+    throw new ControlSessionError('DECISION_INVALID')
+  }
+  if (!isEpochMs(changedAt)) throw new ControlSessionError('DECISION_INVALID')
+  const reason = value.reason
+  if (reason !== undefined && !isNonEmptyString(reason)) throw new ControlSessionError('DECISION_INVALID')
+  const ruleId = value.ruleId
+  if (ruleId !== undefined && !isNonEmptyString(ruleId)) throw new ControlSessionError('DECISION_INVALID')
+  const packetDigest = value.packetDigest
+  if (packetDigest !== undefined && !isNonEmptyString(packetDigest)) {
+    throw new ControlSessionError('DECISION_INVALID')
+  }
+  return {
+    schemaVersion: 1,
+    taskId,
+    decision: decision as PolicyDecisionKind,
+    ...reason === undefined ? {} : { reason },
+    ...ruleId === undefined ? {} : { ruleId },
+    ...packetDigest === undefined ? {} : { packetDigest },
+    changedAt,
+  }
+}
+
+/**
+ * Fold the policy rule set from a session log — LAST `policy/rule` event per
+ * rule id (last-wins, mirroring the authority fold) in first-seen id order.
+ * Every payload is validated in exact-key style; any violation or a spliced
+ * log whose `seq` breaks contiguity is `POLICY_INVALID`. The returned set is
+ * what {@link evaluatePolicy} consumes (each id appears at most once).
+ * @param events - the Global Controller session event log.
+ * @param _taskId - reserved for task-scoped rule subsets: the 1C event
+ *   vocabulary carries no task scoping yet, so this slice folds the global
+ *   rule set.
+ * @returns the folded rules, last-wins per id, first-seen order.
+ */
+export function foldPolicyRules(
+  events: readonly RawSessionEvent[],
+  _taskId?: string,
+): PolicyRuleV1[] {
+  const order: string[] = []
+  const lastById = new Map<string, PolicyRuleV1>()
+  for (const [index, event] of events.entries()) {
+    if (event.type !== POLICY_RULE_EVENT_TYPE) continue
+    // The `seq = log.length` contiguity contract guards externally spliced logs.
+    if (event.seq !== index) throw new ControlSessionError('POLICY_INVALID')
+    const rule = parsePolicyRulePayload(event.data)
+    if (!lastById.has(rule.id)) order.push(rule.id)
+    lastById.set(rule.id, rule)
+  }
+  const rules: PolicyRuleV1[] = []
+  for (const id of order) {
+    const rule = lastById.get(id)
+    if (rule === undefined) continue
+    rules.push(rule)
+  }
+  return rules
+}
+
+/**
+ * Validate one `run/frozen` asset entry with exact-key precision; a non-sha256
+ * content hash is `ASSET_INVALID`.
+ * @param value - the raw frozen asset entry.
+ * @returns the validated entry.
+ */
+function parseFrozenAssetEntry(value: unknown): FrozenAssetEntryV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('ASSET_INVALID')
+  const allowed = new Set<string>([...FROZEN_ASSET_REQUIRED_KEYS, ...FROZEN_ASSET_OPTIONAL_KEYS])
+  if (Object.keys(value).some(key => !allowed.has(key))) throw new ControlSessionError('ASSET_INVALID')
+  for (const key of FROZEN_ASSET_REQUIRED_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('ASSET_INVALID')
+  }
+  const { kind, ref, sha256 } = value
+  if (!isNonEmptyString(kind) || !isNonEmptyString(ref)) throw new ControlSessionError('ASSET_INVALID')
+  // The asset content hash is the freeze guarantee; a non-sha256 value is
+  // corruption, never a tolerated "unknown hash".
+  if (!isSha256Hex(sha256)) throw new ControlSessionError('ASSET_INVALID')
+  const attestedBy = value.attestedBy
+  if (attestedBy !== undefined && !isNonEmptyString(attestedBy)) throw new ControlSessionError('ASSET_INVALID')
+  return {
+    kind,
+    ref,
+    sha256,
+    ...attestedBy === undefined ? {} : { attestedBy },
+  }
+}
+
+/**
+ * Validate one `run/frozen` payload with exact-key precision; any structural
+ * or typing violation is `ASSET_INVALID`.
+ * @param value - the raw frozen snapshot payload.
+ * @returns the validated snapshot.
+ */
+function parseFrozenPayload(value: unknown): FrozenAssetV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('ASSET_INVALID')
+  const allowed = new Set<string>(FROZEN_REQUIRED_KEYS)
+  if (Object.keys(value).some(key => !allowed.has(key))) throw new ControlSessionError('ASSET_INVALID')
+  for (const key of FROZEN_REQUIRED_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('ASSET_INVALID')
+  }
+  const { schemaVersion, runId, assets } = value
+  if (schemaVersion !== 1) throw new ControlSessionError('ASSET_INVALID')
+  if (!isNonEmptyString(runId)) throw new ControlSessionError('ASSET_INVALID')
+  if (!Array.isArray(assets)) throw new ControlSessionError('ASSET_INVALID')
+  const entries = assets.map(parseFrozenAssetEntry)
+  return { schemaVersion: 1, runId, assets: entries }
+}
+
+/**
+ * Fold the LAST `run/frozen` snapshot of one runId from a session log — the
+ * Run's frozen asset set. A snapshot is immutable once appended: mid-run asset
+ * changes never mutate it; they only produce a NEW snapshot that a later fold
+ * projects (MVP: "运行中改资产不改变已冻结 Run"). Every payload and asset
+ * entry is validated in exact-key style (sha256 enforced); any violation or a
+ * spliced log is `ASSET_INVALID`. The folded snapshot's assets must ALL carry
+ * an `attestedBy` publisher — an un-attested asset fails closed as
+ * `ASSET_UNATTESTED` (MVP: unknown identity shows `UNATTESTED_ASSET`).
+ * @param events - the Global Controller session event log.
+ * @param runId - the run whose frozen snapshot to fold.
+ * @returns the last frozen snapshot, or undefined when the run never froze.
+ */
+export function foldFrozenAssets(
+  events: readonly RawSessionEvent[],
+  runId: string,
+): FrozenAssetV1 | undefined {
+  let last: FrozenAssetV1 | undefined
+  for (const [index, event] of events.entries()) {
+    if (event.type !== RUN_FROZEN_EVENT_TYPE) continue
+    // The `seq = log.length` contiguity contract guards externally spliced logs.
+    if (event.seq !== index) throw new ControlSessionError('ASSET_INVALID')
+    const frozen = parseFrozenPayload(event.data)
+    if (frozen.runId !== runId) continue
+    last = frozen
+  }
+  if (last !== undefined && last.assets.some(asset => asset.attestedBy === undefined)) {
+    throw new ControlSessionError('ASSET_UNATTESTED')
+  }
+  return last
+}
diff --git a/packages/devframe/control-session/src/profile-fence.ts b/packages/devframe/control-session/src/profile-fence.ts
new file mode 100644
index 0000000000..f05eb904fa
--- /dev/null
+++ b/packages/devframe/control-session/src/profile-fence.ts
@@ -0,0 +1,487 @@
+/** Single-writer lifecycle fence for the canonical DevFrame Profile Host. */
+
+import { randomUUID } from 'node:crypto'
+import {
+  closeSync,
+  fstatSync,
+  fsyncSync,
+  lstatSync,
+  mkdirSync,
+  openSync,
+  readFileSync,
+  renameSync,
+  unlinkSync,
+  writeFileSync,
+  type Stats,
+} from 'node:fs'
+import { hostname as readHostname } from 'node:os'
+import { dirname, join } from 'node:path'
+import { setTimeout as delay } from 'node:timers/promises'
+import { resolveDshHome } from '@deepseek-ai/dsh-home-paths'
+
+const PROFILE_HOST_DIRECTORY = 'devframe'
+const PROFILE_HOST_LEASE_FILENAME = 'host-lease.json'
+const PROFILE_HOST_TRANSITION_FILENAME = 'host-lease.transition.json'
+const RECORD_KEYS = ['hostname', 'pid', 'startedAt', 'token', 'version'] as const
+const SORTED_RECORD_KEYS = [...RECORD_KEYS].sort()
+const UUID_V4_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/
+const HOSTNAME_CONTROL_PATTERN = /[\u0000-\u001f\u007f]/
+const TRANSIENT_RETRY_LIMIT = 16
+const TAKEOVER_CREATE_RETRY_LIMIT = 50
+const TAKEOVER_CREATE_RETRY_MS = 10
+
+/** Root-context key populated only while a canonical DevFrame Profile Host owns the fence. */
+export const DSH_PROFILE_HOST_FENCE_KEY = 'profileHostFence'
+
+/** Stable failure categories that never expose hostnames, paths, PIDs, or tokens. */
+export type ProfileHostFenceErrorCode =
+  | 'ACTIVE'
+  | 'FOREIGN_HOST'
+  | 'INVALID_RECORD'
+  | 'NOT_OWNER'
+  | 'OWNER_UNCERTAIN'
+  | 'FILESYSTEM'
+
+/** Bounded lifecycle-fence failure safe to surface without local owner details. */
+export class ProfileHostFenceError extends Error {
+  /**
+   * @param code - Stable failure category.
+   * @param options - Optional Host-only cause.
+   */
+  constructor(readonly code: ProfileHostFenceErrorCode, options?: ErrorOptions) {
+    super(`DevFrame Profile Host blocked: ${code}`, options)
+    this.name = 'ProfileHostFenceError'
+  }
+}
+
+/** Non-secret owner facts available to Host plugins and readiness checks. */
+export interface ProfileHostFenceOwner {
+  readonly pid: number
+  readonly hostname: string
+  readonly startedAt: string
+}
+
+/** Read-only root-context proof that this process owns the Profile Host fence. */
+export interface ProfileHostFence {
+  readonly owner: ProfileHostFenceOwner
+}
+
+/** Launcher-owned lifecycle handle. Only the launcher releases the fence. */
+export interface ProfileHostFenceLease extends ProfileHostFence {
+  /** Release ownership after every Host plugin has reached quiescence. */
+  release(): Promise<void>
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Present only on the canonical DevFrame Profile Host. */
+    profileHostFence?: ProfileHostFence
+  }
+}
+
+interface ProfileHostFenceRecord extends ProfileHostFenceOwner {
+  readonly version: 1
+  readonly token: string
+}
+
+interface OwnedFile {
+  readonly path: string
+  readonly record: ProfileHostFenceRecord
+  readonly raw: string
+  readonly stat: Stats
+}
+
+interface InspectedFile extends OwnedFile {}
+
+function errorCode(failure: unknown): string | undefined {
+  return typeof failure === 'object' && failure !== null && 'code' in failure
+    ? String((failure as NodeJS.ErrnoException).code)
+    : undefined
+}
+
+function fenceFailure(failure: unknown, fallback: ProfileHostFenceErrorCode): ProfileHostFenceError {
+  return failure instanceof ProfileHostFenceError
+    ? failure
+    : new ProfileHostFenceError(fallback, { cause: failure })
+}
+
+function sameFile(left: Stats, right: Stats): boolean {
+  return left.dev === right.dev && left.ino === right.ino
+}
+
+function localHostname(): string {
+  const value = readHostname().trim().toLowerCase()
+  if (value.length === 0 || value.length > 255 || HOSTNAME_CONTROL_PATTERN.test(value)) {
+    throw new ProfileHostFenceError('OWNER_UNCERTAIN')
+  }
+  return value
+}
+
+function exactKeys(value: Record<string, unknown>): boolean {
+  const actual = Object.keys(value).sort()
+  return actual.length === RECORD_KEYS.length
+    && actual.every((key, index) => key === SORTED_RECORD_KEYS[index])
+}
+
+function parseRecord(raw: string): ProfileHostFenceRecord {
+  let value: unknown
+  try {
+    value = JSON.parse(raw)
+  } catch (failure) {
+    throw new ProfileHostFenceError('INVALID_RECORD', { cause: failure })
+  }
+  if (typeof value !== 'object' || value === null || Array.isArray(value)
+    || !exactKeys(value as Record<string, unknown>)) {
+    throw new ProfileHostFenceError('INVALID_RECORD')
+  }
+  const record = value as Record<string, unknown>
+  if (record.version !== 1
+    || typeof record.token !== 'string' || !UUID_V4_PATTERN.test(record.token)
+    || typeof record.pid !== 'number' || !Number.isSafeInteger(record.pid) || record.pid <= 0
+    || typeof record.hostname !== 'string' || record.hostname.length === 0 || record.hostname.length > 255
+    || record.hostname !== record.hostname.toLowerCase() || HOSTNAME_CONTROL_PATTERN.test(record.hostname)
+    || typeof record.startedAt !== 'string') {
+    throw new ProfileHostFenceError('INVALID_RECORD')
+  }
+  const startedAt = Date.parse(record.startedAt)
+  if (!Number.isFinite(startedAt) || new Date(startedAt).toISOString() !== record.startedAt) {
+    throw new ProfileHostFenceError('INVALID_RECORD')
+  }
+  return record as unknown as ProfileHostFenceRecord
+}
+
+function lstatOptional(path: string): Stats | undefined {
+  try {
+    return lstatSync(path)
+  } catch (failure) {
+    if (errorCode(failure) === 'ENOENT') return undefined
+    throw fenceFailure(failure, 'FILESYSTEM')
+  }
+}
+
+function inspectFile(path: string): InspectedFile | undefined {
+  const before = lstatOptional(path)
+  if (before === undefined) return undefined
+  if (!before.isFile() || before.isSymbolicLink() || before.nlink !== 1) {
+    throw new ProfileHostFenceError('INVALID_RECORD')
+  }
+  let raw: string
+  try {
+    raw = readFileSync(path, 'utf8')
+  } catch (failure) {
+    if (errorCode(failure) === 'ENOENT') return undefined
+    throw fenceFailure(failure, 'FILESYSTEM')
+  }
+  const after = lstatOptional(path)
+  if (after === undefined) return undefined
+  if (!after.isFile() || after.isSymbolicLink() || after.nlink !== 1) {
+    throw new ProfileHostFenceError('INVALID_RECORD')
+  }
+  if (!sameFile(before, after)) throw new ProfileHostFenceError('OWNER_UNCERTAIN')
+  return { path, raw, stat: after, record: parseRecord(raw) }
+}
+
+function uniqueTombstone(path: string, phase: string, token: string): string {
+  for (let attempt = 0; attempt < TRANSIENT_RETRY_LIMIT; attempt += 1) {
+    const candidate = `${path}.${phase}.${token}.${randomUUID()}`
+    if (lstatOptional(candidate) === undefined) return candidate
+  }
+  throw new ProfileHostFenceError('OWNER_UNCERTAIN')
+}
+
+function cleanupCreatedFile(path: string, stat: Stats, token: string): void {
+  const current = lstatOptional(path)
+  if (current === undefined || !current.isFile() || current.isSymbolicLink()
+    || current.nlink !== 1 || !sameFile(current, stat)) return
+  const tombstone = uniqueTombstone(path, 'incomplete', token)
+  renameSync(path, tombstone)
+  unlinkSync(tombstone)
+}
+
+function createOwnedFile(path: string): OwnedFile | undefined {
+  const record: ProfileHostFenceRecord = {
+    version: 1,
+    token: randomUUID(),
+    pid: process.pid,
+    hostname: localHostname(),
+    startedAt: new Date().toISOString(),
+  }
+  const raw = `${JSON.stringify(record)}\n`
+  let descriptor: number
+  try {
+    descriptor = openSync(path, 'wx', 0o600)
+  } catch (failure) {
+    if (errorCode(failure) === 'EEXIST') return undefined
+    throw fenceFailure(failure, 'FILESYSTEM')
+  }
+  let stat: Stats | undefined
+  let writeFailure: unknown
+  try {
+    stat = fstatSync(descriptor)
+    writeFileSync(descriptor, raw, { encoding: 'utf8' })
+    fsyncSync(descriptor)
+  } catch (failure) {
+    writeFailure = failure
+  }
+  try {
+    closeSync(descriptor)
+  } catch (failure) {
+    writeFailure = writeFailure === undefined
+      ? failure
+      : new AggregateError([writeFailure, failure], 'Profile Host fence publication failed')
+  }
+  if (writeFailure !== undefined) {
+    try {
+      if (stat !== undefined) cleanupCreatedFile(path, stat, record.token)
+    } catch (cleanupFailure) {
+      throw new ProfileHostFenceError('FILESYSTEM', {
+        cause: new AggregateError([writeFailure, cleanupFailure], 'Profile Host fence publication cleanup failed'),
+      })
+    }
+    throw fenceFailure(writeFailure, 'FILESYSTEM')
+  }
+  if (stat === undefined) throw new ProfileHostFenceError('FILESYSTEM')
+  const published = inspectFile(path)
+  if (published === undefined || published.record.token !== record.token
+    || published.raw !== raw || !sameFile(published.stat, stat)) {
+    throw new ProfileHostFenceError('NOT_OWNER')
+  }
+  return published
+}
+
+function retireOwnedFile(owned: OwnedFile, phase: string): void {
+  const current = inspectFile(owned.path)
+  if (current === undefined || current.record.token !== owned.record.token
+    || current.raw !== owned.raw || !sameFile(current.stat, owned.stat)) {
+    throw new ProfileHostFenceError('NOT_OWNER')
+  }
+  const tombstone = uniqueTombstone(owned.path, phase, owned.record.token)
+  try {
+    renameSync(owned.path, tombstone)
+  } catch (failure) {
+    throw fenceFailure(failure, errorCode(failure) === 'ENOENT' ? 'NOT_OWNER' : 'FILESYSTEM')
+  }
+  const retired = inspectFile(tombstone)
+  if (retired === undefined || retired.record.token !== owned.record.token
+    || retired.raw !== owned.raw || !sameFile(retired.stat, owned.stat)) {
+    throw new ProfileHostFenceError('NOT_OWNER')
+  }
+  try {
+    unlinkSync(tombstone)
+  } catch (failure) {
+    if (errorCode(failure) !== 'ENOENT') throw fenceFailure(failure, 'FILESYSTEM')
+  }
+}
+
+function processIsAlive(pid: number): boolean {
+  try {
+    process.kill(pid, 0)
+    return true
+  } catch (failure) {
+    const code = errorCode(failure)
+    if (code === 'ESRCH') return false
+    if (code === 'EPERM') return true
+    throw new ProfileHostFenceError('OWNER_UNCERTAIN', { cause: failure })
+  }
+}
+
+function assertDeadLocalOwner(file: InspectedFile): void {
+  if (file.record.hostname !== localHostname()) throw new ProfileHostFenceError('FOREIGN_HOST')
+  if (processIsAlive(file.record.pid)) throw new ProfileHostFenceError('ACTIVE')
+}
+
+function transitionPath(home?: string): string {
+  return join(dirname(profileHostFencePath(home)), PROFILE_HOST_TRANSITION_FILENAME)
+}
+
+function ensureFenceDirectory(home?: string): void {
+  const directory = dirname(profileHostFencePath(home))
+  try {
+    mkdirSync(directory, { recursive: true, mode: 0o700 })
+  } catch (failure) {
+    throw fenceFailure(failure, 'FILESYSTEM')
+  }
+  const stat = lstatOptional(directory)
+  if (stat === undefined || !stat.isDirectory() || stat.isSymbolicLink()) {
+    throw new ProfileHostFenceError('FILESYSTEM')
+  }
+}
+
+function combineFailures(primary: unknown, cleanup: unknown): ProfileHostFenceError {
+  const bounded = fenceFailure(primary, 'FILESYSTEM')
+  return new ProfileHostFenceError(bounded.code, {
+    cause: new AggregateError([bounded, cleanup], 'Profile Host fence cleanup failed'),
+  })
+}
+
+class OwnedProfileHostFence implements ProfileHostFenceLease {
+  readonly owner: ProfileHostFenceOwner
+  private releaseOperation: Promise<void> | undefined
+  private released = false
+  private transitionFile: OwnedFile | undefined
+
+  constructor(
+    private readonly lease: OwnedFile,
+    private readonly transition: string,
+  ) {
+    this.owner = Object.freeze({
+      pid: lease.record.pid,
+      hostname: lease.record.hostname,
+      startedAt: lease.record.startedAt,
+    })
+  }
+
+  release(): Promise<void> {
+    if (this.released) return Promise.resolve()
+    if (this.releaseOperation !== undefined) return this.releaseOperation
+    const operation = Promise.resolve().then(() => { this.releaseOnce() })
+    this.releaseOperation = operation
+    void operation.then(
+      () => {
+        this.released = true
+        this.releaseOperation = undefined
+      },
+      () => { this.releaseOperation = undefined },
+    )
+    return operation
+  }
+
+  private releaseOnce(): void {
+    const transition = this.acquireTransition()
+    let failure: unknown
+    try {
+      retireOwnedFile(this.lease, 'released')
+    } catch (caught) {
+      failure = caught
+    }
+    try {
+      retireOwnedFile(transition, 'complete')
+      this.transitionFile = undefined
+    } catch (cleanupFailure) {
+      if (failure === undefined) throw fenceFailure(cleanupFailure, 'FILESYSTEM')
+      throw combineFailures(failure, cleanupFailure)
+    }
+    if (failure !== undefined) throw fenceFailure(failure, 'FILESYSTEM')
+  }
+
+  /**
+   * Reuse a transition record left by a failed release instead of creating a
+   * second marker. A different record at the same path is never ours and must
+   * fail closed; an absent record means the previous transition was retired
+   * successfully and a fresh marker is safe.
+   */
+  private acquireTransition(): OwnedFile {
+    if (this.transitionFile !== undefined) {
+      const current = inspectFile(this.transition)
+      if (current !== undefined) {
+        if (current.record.token !== this.transitionFile.record.token) {
+          throw new ProfileHostFenceError('OWNER_UNCERTAIN')
+        }
+        this.transitionFile = current
+        return current
+      }
+      this.transitionFile = undefined
+    }
+    const created = createOwnedFile(this.transition)
+    if (created === undefined) throw new ProfileHostFenceError('OWNER_UNCERTAIN')
+    this.transitionFile = created
+    return created
+  }
+}
+
+async function reclaimDeadOwner(
+  leasePath: string,
+  transition: string,
+): Promise<OwnedFile | undefined> {
+  const claim = createOwnedFile(transition)
+  if (claim === undefined) throw new ProfileHostFenceError('OWNER_UNCERTAIN')
+  let next: OwnedFile | undefined
+  let failure: unknown
+  let retry = false
+  try {
+    const existing = inspectFile(leasePath)
+    if (existing === undefined) {
+      retry = true
+    } else {
+      assertDeadLocalOwner(existing)
+      retireOwnedFile(existing, 'stale')
+      for (let attempt = 0; attempt < TAKEOVER_CREATE_RETRY_LIMIT; attempt += 1) {
+        next = createOwnedFile(leasePath)
+        if (next !== undefined) break
+        await delay(TAKEOVER_CREATE_RETRY_MS)
+      }
+      if (next === undefined) throw new ProfileHostFenceError('OWNER_UNCERTAIN')
+    }
+  } catch (caught) {
+    failure = caught
+  }
+  try {
+    retireOwnedFile(claim, 'complete')
+  } catch (cleanupFailure) {
+    failure = failure === undefined
+      ? fenceFailure(cleanupFailure, 'FILESYSTEM')
+      : combineFailures(failure, cleanupFailure)
+  }
+  if (failure !== undefined) {
+    if (next !== undefined) {
+      try {
+        retireOwnedFile(next, 'abandoned')
+      } catch (cleanupFailure) {
+        throw combineFailures(failure, cleanupFailure)
+      }
+    }
+    throw fenceFailure(failure, 'FILESYSTEM')
+  }
+  return retry ? undefined : next
+}
+
+/**
+ * Resolve the canonical lifecycle-fence file under the Harness home.
+ * @param home - Optional explicit Harness home, primarily for isolated launchers and tests.
+ * @returns the absolute lease-file path.
+ */
+export function profileHostFencePath(home?: string): string {
+  return join(resolveDshHome(home), PROFILE_HOST_DIRECTORY, PROFILE_HOST_LEASE_FILENAME)
+}
+
+/**
+ * Acquire the single-writer DevFrame Profile Host fence. A same-host record is
+ * reclaimable only when `kill(pid, 0)` reports `ESRCH`; live, inaccessible,
+ * foreign-host, malformed, and uncertain owners fail closed. Acquisition and
+ * release use exclusive-create records plus a serialized rename tombstone.
+ * @param home - Optional explicit Harness home, primarily for isolated launchers and tests.
+ * @returns a launcher-owned lease whose public owner projection excludes its token and path.
+ */
+export async function acquireProfileHostFence(home?: string): Promise<ProfileHostFenceLease> {
+  ensureFenceDirectory(home)
+  const leasePath = profileHostFencePath(home)
+  const transition = transitionPath(home)
+  for (let attempt = 0; attempt < TRANSIENT_RETRY_LIMIT; attempt += 1) {
+    if (inspectFile(transition) !== undefined) throw new ProfileHostFenceError('OWNER_UNCERTAIN')
+    const direct = createOwnedFile(leasePath)
+    if (direct !== undefined) {
+      try {
+        if (inspectFile(transition) === undefined) return new OwnedProfileHostFence(direct, transition)
+      } catch (postcheckFailure) {
+        try {
+          retireOwnedFile(direct, 'abandoned')
+        } catch (cleanupFailure) {
+          throw combineFailures(postcheckFailure, cleanupFailure)
+        }
+        throw fenceFailure(postcheckFailure, 'OWNER_UNCERTAIN')
+      }
+      try {
+        retireOwnedFile(direct, 'abandoned')
+      } catch (cleanupFailure) {
+        throw new ProfileHostFenceError('OWNER_UNCERTAIN', { cause: cleanupFailure })
+      }
+      throw new ProfileHostFenceError('OWNER_UNCERTAIN')
+    }
+    const existing = inspectFile(leasePath)
+    if (existing === undefined) continue
+    assertDeadLocalOwner(existing)
+    const recovered = await reclaimDeadOwner(leasePath, transition)
+    if (recovered !== undefined) return new OwnedProfileHostFence(recovered, transition)
+  }
+  throw new ProfileHostFenceError('OWNER_UNCERTAIN')
+}
diff --git a/packages/devframe/control-session/src/readiness.ts b/packages/devframe/control-session/src/readiness.ts
new file mode 100644
index 0000000000..942ff17aa7
--- /dev/null
+++ b/packages/devframe/control-session/src/readiness.ts
@@ -0,0 +1,157 @@
+import type {
+  DevFrameReadinessBlockedCode,
+  DevFrameReadinessSnapshot,
+} from './types.ts'
+
+/** Maximum duration of one readiness long poll before returning unchanged state. */
+export const DEVFRAME_READINESS_WAIT_MS = 20_000
+
+interface GenerationRecord {
+  readonly generation: number
+  readonly abort: AbortController
+}
+
+type ReadinessUpdate =
+  | { readonly status: 'starting'; readonly generation: number }
+  | { readonly status: 'ready'; readonly generation: number; readonly sessionId: string }
+  | {
+    readonly status: 'blocked'
+    readonly generation: number
+    readonly code: DevFrameReadinessBlockedCode
+  }
+  | { readonly status: 'stopping'; readonly generation: number }
+
+/** Generation ticket used by the bootstrap owner. */
+export interface DevFrameReadinessGeneration {
+  readonly generation: number
+  readonly signal: AbortSignal
+}
+
+function snapshotCopy(snapshot: DevFrameReadinessSnapshot): DevFrameReadinessSnapshot {
+  return { ...snapshot }
+}
+
+/**
+ * Monotonic readiness state with generation fencing and cancellable long polls.
+ * Old generations can finish, but can never publish over the current one.
+ */
+export class DevFrameReadinessState {
+  private generation = 0
+  private revision = 0
+  private active?: GenerationRecord
+  private value: DevFrameReadinessSnapshot = {
+    status: 'blocked',
+    generation: 0,
+    revision: 0,
+    code: 'BOOTSTRAP_NOT_STARTED',
+  }
+
+  private readonly waiters = new Set<() => void>()
+
+  /**
+   * Start a new generation and invalidate every older publisher.
+   * @returns the generation ticket for the bootstrap owner.
+   */
+  begin(): DevFrameReadinessGeneration {
+    this.active?.abort.abort()
+    const active: GenerationRecord = {
+      generation: ++this.generation,
+      abort: new AbortController(),
+    }
+    this.active = active
+    this.publish({ status: 'starting', generation: active.generation })
+    return { generation: active.generation, signal: active.abort.signal }
+  }
+
+  /**
+   * Publish a ready Session only when the caller still owns the generation.
+   * @param generation - generation ticket number.
+   * @param sessionId - durable Controller Session identifier.
+   * @returns whether the update was accepted.
+   */
+  ready(generation: number, sessionId: string): boolean {
+    if (!this.isCurrent(generation)) return false
+    this.publish({ status: 'ready', generation, sessionId })
+    return true
+  }
+
+  /**
+   * Publish one bounded failure only when the caller still owns the generation.
+   * @param generation - generation ticket number.
+   * @param code - stable readiness failure code.
+   * @returns whether the update was accepted.
+   */
+  blocked(generation: number, code: DevFrameReadinessBlockedCode): boolean {
+    if (!this.isCurrent(generation)) return false
+    this.publish({ status: 'blocked', generation, code })
+    return true
+  }
+
+  /**
+   * Stop admission and cancel in-flight work for the current generation.
+   * @param generation - generation ticket number.
+   * @returns whether the update was accepted.
+   */
+  stopping(generation: number): boolean {
+    if (!this.isCurrent(generation)) return false
+    this.publish({ status: 'stopping', generation })
+    this.active?.abort.abort()
+    return true
+  }
+
+  /**
+   * Whether a generation may still publish and admit work.
+   * @param generation - generation ticket number.
+   * @returns whether the generation is still current.
+   */
+  isCurrent(generation: number): boolean {
+    return this.active?.generation === generation && !this.active.abort.signal.aborted
+  }
+
+  /**
+   * Detached current state for direct Host callers and tests.
+   * @returns a copy of the current readiness snapshot.
+   */
+  snapshot(): DevFrameReadinessSnapshot {
+    return snapshotCopy(this.value)
+  }
+
+  /**
+   * Wait for a revision change, cancellation, or the bounded poll timeout.
+   * A future/stale revision returns immediately so a reconnect can recover.
+   * @param afterRevision - revision already observed by the caller.
+   * @param signal - cancellation signal for the long poll.
+   * @returns the latest readiness snapshot.
+   */
+  async wait(afterRevision: number, signal: AbortSignal): Promise<DevFrameReadinessSnapshot> {
+    if (!Number.isSafeInteger(afterRevision) || afterRevision < -1) {
+      throw new Error('DevFrame readiness revision must be an integer of at least -1')
+    }
+    if (afterRevision !== this.value.revision) return this.snapshot()
+    if (signal.aborted) throw new Error('DevFrame readiness wait aborted')
+
+    await new Promise<void>((resolve, reject) => {
+      let settled = false
+      const finish = (failure?: Error): void => {
+        if (settled) return
+        settled = true
+        clearTimeout(timer)
+        signal.removeEventListener('abort', onAbort)
+        this.waiters.delete(onChange)
+        if (failure === undefined) resolve()
+        else reject(failure)
+      }
+      const onChange = (): void => { finish() }
+      const onAbort = (): void => { finish(new Error('DevFrame readiness wait aborted')) }
+      const timer = setTimeout(onChange, DEVFRAME_READINESS_WAIT_MS)
+      this.waiters.add(onChange)
+      signal.addEventListener('abort', onAbort, { once: true })
+    })
+    return this.snapshot()
+  }
+
+  private publish(next: ReadinessUpdate): void {
+    this.value = { ...next, revision: ++this.revision }
+    for (const notify of [...this.waiters]) notify()
+  }
+}
diff --git a/packages/devframe/control-session/src/review.ts b/packages/devframe/control-session/src/review.ts
new file mode 100644
index 0000000000..954e51cc8c
--- /dev/null
+++ b/packages/devframe/control-session/src/review.ts
@@ -0,0 +1,329 @@
+/** Independent reviewer evidence and replay fold for the DevFrame Task Board. */
+
+import { createHash } from 'node:crypto'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import {
+  TASK_PAYLOAD_EXECUTE,
+  type TaskReviewEvidenceV1,
+  type TaskReviewReferenceV1,
+  type TaskReviewVerdict,
+} from './types.ts'
+import { ControlSessionError } from './index.ts'
+
+/** Durable event carrying one independent reviewer verdict. */
+export const TASK_REVIEW_EVENT_TYPE = 'task/review' as const
+
+/** Host-installed reviewer submission tool name. */
+export const TASK_REVIEW_SUBMIT_TOOL = 'devframe_submit_review' as const
+
+/** Maximum raw finding text retained in the physical reviewer Session. */
+export const TASK_REVIEW_FINDINGS_MAX_CHARS = 16_384
+
+const REQUIRED_KEYS = [
+  'schemaVersion', 'kind', 'version', 'taskId', 'executorWorkerId',
+  'executorReportSha256', 'reviewerWorkerId', 'reviewerSessionId',
+  'reviewerMessageId', 'reviewSubmissionCallId', 'reviewSubmissionSeq',
+  'reviewerAssistantSeq', 'reviewerTurn',
+  'reviewerStep', 'reviewerTurnEndSeq', 'reviewerSourceEventSeqs',
+  'reviewerMessageSha256', 'verdict', 'findingsSha256', 'changedAt',
+  'evidenceSha256',
+] as const
+const OPTIONAL_KEYS = ['revisionTaskId'] as const
+const VERDICTS = new Set<TaskReviewVerdict>([
+  'pass', 'request_revision', 'blocked', 'human_required',
+])
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return false
+  const prototype: unknown = Object.getPrototypeOf(value)
+  return prototype === Object.prototype || prototype === null
+}
+
+function isNonEmptyString(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0
+}
+
+function isPathlessId(value: unknown): value is string {
+  return isNonEmptyString(value) && !value.includes('/') && !value.includes('\\')
+}
+
+function isSha256Hex(value: unknown): value is string {
+  return typeof value === 'string' && /^[0-9a-f]{64}$/u.test(value)
+}
+
+function isSafeSeq(value: unknown): value is number {
+  return Number.isSafeInteger(value) && (value as number) >= 0
+}
+
+function isPositiveSafeInt(value: unknown): value is number {
+  return Number.isSafeInteger(value) && (value as number) > 0
+}
+
+function isEpochMs(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0
+}
+
+function canonicalReviewPayload(
+  evidence: Omit<TaskReviewEvidenceV1, 'evidenceSha256'>,
+): string {
+  return JSON.stringify({
+    schemaVersion: evidence.schemaVersion,
+    kind: evidence.kind,
+    version: evidence.version,
+    taskId: evidence.taskId,
+    executorWorkerId: evidence.executorWorkerId,
+    executorReportSha256: evidence.executorReportSha256,
+    reviewerWorkerId: evidence.reviewerWorkerId,
+    reviewerSessionId: evidence.reviewerSessionId,
+    reviewerMessageId: evidence.reviewerMessageId,
+    reviewSubmissionCallId: evidence.reviewSubmissionCallId,
+    reviewSubmissionSeq: evidence.reviewSubmissionSeq,
+    reviewerAssistantSeq: evidence.reviewerAssistantSeq,
+    reviewerTurn: evidence.reviewerTurn,
+    reviewerStep: evidence.reviewerStep,
+    reviewerTurnEndSeq: evidence.reviewerTurnEndSeq,
+    reviewerSourceEventSeqs: evidence.reviewerSourceEventSeqs,
+    reviewerMessageSha256: evidence.reviewerMessageSha256,
+    verdict: evidence.verdict,
+    findingsSha256: evidence.findingsSha256,
+    changedAt: evidence.changedAt,
+    ...evidence.revisionTaskId === undefined ? {} : { revisionTaskId: evidence.revisionTaskId },
+  })
+}
+
+/** Compute the canonical digest over one independent review reference. */
+export function taskReviewEvidenceDigest(
+  evidence: Omit<TaskReviewEvidenceV1, 'evidenceSha256'>,
+): string {
+  return createHash('sha256').update(canonicalReviewPayload(evidence)).digest('hex')
+}
+
+/** Validate one pathless review reference with exact-key and digest checks. */
+export function parseTaskReviewEvidence(value: unknown): TaskReviewEvidenceV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('TASK_INVALID')
+  const allowed = new Set<string>([...REQUIRED_KEYS, ...OPTIONAL_KEYS])
+  if (Object.keys(value).some(key => !allowed.has(key))) throw new ControlSessionError('TASK_INVALID')
+  for (const key of REQUIRED_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('TASK_INVALID')
+  }
+  const {
+    schemaVersion, kind, version, taskId, executorWorkerId,
+    executorReportSha256, reviewerWorkerId, reviewerSessionId,
+    reviewerMessageId, reviewSubmissionCallId, reviewSubmissionSeq,
+    reviewerAssistantSeq, reviewerTurn, reviewerStep,
+    reviewerTurnEndSeq, reviewerSourceEventSeqs, reviewerMessageSha256,
+    verdict, findingsSha256, changedAt, evidenceSha256,
+  } = value
+  const revisionTaskId = value.revisionTaskId
+  if (schemaVersion !== 1 || kind !== 'devframe/task-review' || version !== 1
+    || !isPathlessId(taskId) || !isPathlessId(executorWorkerId)
+    || !isSha256Hex(executorReportSha256) || !isPathlessId(reviewerWorkerId)
+    || !isPathlessId(reviewerSessionId) || !isPathlessId(reviewerMessageId)
+    || !isPathlessId(reviewSubmissionCallId) || !isSafeSeq(reviewSubmissionSeq)
+    || !isSafeSeq(reviewerAssistantSeq) || !isPositiveSafeInt(reviewerTurn)
+    || !isPositiveSafeInt(reviewerStep) || !isSafeSeq(reviewerTurnEndSeq)
+    || reviewSubmissionSeq >= reviewerAssistantSeq
+    || reviewerAssistantSeq >= reviewerTurnEndSeq
+    || !Array.isArray(reviewerSourceEventSeqs)
+    || reviewerSourceEventSeqs.length < 2 || reviewerSourceEventSeqs.length > 256
+    || !isSha256Hex(reviewerMessageSha256)
+    || typeof verdict !== 'string' || !VERDICTS.has(verdict as TaskReviewVerdict)
+    || !isSha256Hex(findingsSha256) || !isEpochMs(changedAt)
+    || !isSha256Hex(evidenceSha256)
+    || (revisionTaskId !== undefined && !isPathlessId(revisionTaskId))) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const seqs = reviewerSourceEventSeqs.map((seq) => {
+    if (!isSafeSeq(seq)) throw new ControlSessionError('TASK_INVALID')
+    return seq
+  })
+  for (let index = 1; index < seqs.length; index++) {
+    const previous = seqs[index - 1]
+    const current = seqs[index]
+    if (previous === undefined || current === undefined || current <= previous) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+  }
+  if (!seqs.includes(reviewSubmissionSeq)
+    || !seqs.includes(reviewerAssistantSeq)
+    || !seqs.includes(reviewerTurnEndSeq)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  // A bounded ProjectLoop may persist the reviewer's original
+  // `request_revision` verdict after its one allowed revision has already
+  // been consumed. In that terminal case there is deliberately no next task
+  // to reference; the ProjectLoop fold uses the reviewed revision-task id to
+  // settle the loop as failed without creating a nested task chain.
+  if (verdict !== 'request_revision' && revisionTaskId !== undefined) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const unsigned: Omit<TaskReviewEvidenceV1, 'evidenceSha256'> = {
+    schemaVersion: 1,
+    kind: 'devframe/task-review',
+    version: 1,
+    taskId,
+    executorWorkerId,
+    executorReportSha256,
+    reviewerWorkerId,
+    reviewerSessionId: reviewerSessionId as SessionId,
+    reviewerMessageId,
+    reviewSubmissionCallId,
+    reviewSubmissionSeq,
+    reviewerAssistantSeq,
+    reviewerTurn,
+    reviewerStep,
+    reviewerTurnEndSeq,
+    reviewerSourceEventSeqs: seqs,
+    reviewerMessageSha256,
+    verdict: verdict as TaskReviewVerdict,
+    findingsSha256,
+    changedAt,
+    ...revisionTaskId === undefined ? {} : { revisionTaskId },
+  }
+  if (taskReviewEvidenceDigest(unsigned) !== evidenceSha256) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  return { ...unsigned, evidenceSha256 }
+}
+
+export interface TaskReviewSubmission {
+  readonly verdict: TaskReviewVerdict
+  readonly findings: string
+}
+
+/** Parse the exact arguments persisted by the Host-installed review tool. */
+export function parseTaskReviewSubmission(value: unknown): TaskReviewSubmission {
+  if (!isPlainRecord(value)
+    || Object.keys(value).length !== 2
+    || typeof value.verdict !== 'string'
+    || !VERDICTS.has(value.verdict as TaskReviewVerdict)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  return {
+    verdict: value.verdict as TaskReviewVerdict,
+    findings: normalizeReviewFindings(value.findings),
+  }
+}
+
+/** Recover and verify raw findings from a persisted reviewer tool call. */
+export function recoverTaskReviewSubmission(
+  events: readonly SessionEvent[],
+  review: TaskReviewEvidenceV1,
+): TaskReviewSubmission {
+  const event = events.find(candidate => candidate.seq === review.reviewSubmissionSeq)
+  if (event === undefined || event.type !== 'tool/call'
+    || event.data.name !== TASK_REVIEW_SUBMIT_TOOL
+    || String(event.data.callId) !== review.reviewSubmissionCallId
+    || event.seq >= review.reviewerAssistantSeq) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(event.data.arguments)
+  } catch (failure) {
+    throw new ControlSessionError('TASK_INVALID', { cause: failure })
+  }
+  const submission = parseTaskReviewSubmission(parsed)
+  if (submission.verdict !== review.verdict
+    || createHash('sha256').update(submission.findings).digest('hex') !== review.findingsSha256) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  return submission
+}
+
+/** Validate the narrow pathless reference stored on a revision task. */
+export function parseTaskReviewReference(value: unknown): TaskReviewReferenceV1 {
+  if (!isPlainRecord(value)
+    || Object.keys(value).some(key => !['taskId', 'reviewEventSeq', 'reviewEvidenceSha256'].includes(key))
+    || Object.keys(value).length !== 3
+    || !isPathlessId(value.taskId)
+    || !isSafeSeq(value.reviewEventSeq)
+    || !isSha256Hex(value.reviewEvidenceSha256)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  return {
+    taskId: value.taskId,
+    reviewEventSeq: value.reviewEventSeq,
+    reviewEvidenceSha256: value.reviewEvidenceSha256,
+  }
+}
+
+/** The durable latest-review projection keyed by the executor task id. */
+export function foldTaskReviews(
+  events: readonly SessionEvent[],
+): ReadonlyMap<string, TaskReviewEvidenceV1> {
+  const reviews = new Map<string, TaskReviewEvidenceV1>()
+  const reportDigests = new Map<string, Set<string>>()
+  for (const [index, event] of events.entries()) {
+    if (event.type === 'task/change') {
+      if (!isPlainRecord(event.data) || event.data.operation !== 'report') continue
+      const report = event.data.reportRef
+      if (!isPlainRecord(report)
+        || typeof event.data.taskId !== 'string'
+        || typeof event.data.workerId !== 'string'
+        || event.data.payloadRef !== TASK_PAYLOAD_EXECUTE
+        || typeof report.evidenceSha256 !== 'string') continue
+      const key = `${event.data.taskId}\u0000${event.data.workerId}`
+      const digests = reportDigests.get(key) ?? new Set<string>()
+      digests.add(report.evidenceSha256)
+      reportDigests.set(key, digests)
+      continue
+    }
+    if (event.type !== TASK_REVIEW_EVENT_TYPE) continue
+    if (event.seq !== index) throw new ControlSessionError('TASK_INVALID')
+    const review = parseTaskReviewEvidence(event.data)
+    if (reviews.has(review.taskId)) throw new ControlSessionError('TASK_INVALID')
+    if (review.executorWorkerId === review.reviewerWorkerId) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    const reportKey = `${review.taskId}\u0000${review.executorWorkerId}`
+    if (!reportDigests.get(reportKey)?.has(review.executorReportSha256)) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    reviews.set(review.taskId, review)
+  }
+  return reviews
+}
+
+/** Build the reviewer context without copying the executor transcript. */
+export function createReviewerContext(
+  taskId: string,
+  executorWorkerId: string,
+  executorReportSha256: string,
+): string {
+  return [
+    'DevFrame independent review context (Host-authored, bounded):',
+    `Task: ${taskId}`,
+    `Executor Worker: ${executorWorkerId}`,
+    `Executor report digest: ${executorReportSha256}`,
+    'Inspect the workspace with the read-only tools, then call the review submission tool exactly once.',
+    'Use pass only when the reported work is independently acceptable; request_revision, blocked, or human_required remain non-terminal for the product.',
+  ].join('\n')
+}
+
+/** Build a bounded revision context from the reviewer’s physical transcript. */
+export function createRevisionContext(
+  review: TaskReviewEvidenceV1,
+  findings: string,
+): string {
+  return [
+    'DevFrame revision context (Host-authored, bounded):',
+    `Review task: ${review.taskId}`,
+    `Reviewer verdict: ${review.verdict}`,
+    `Review evidence digest: ${review.evidenceSha256}`,
+    '',
+    'Reviewer findings (physical context only; never copied into the Global log):',
+    findings,
+  ].join('\n')
+}
+
+/** Keep the tool argument within a bounded, credential-free physical message. */
+export function normalizeReviewFindings(value: unknown): string {
+  if (typeof value !== 'string') throw new ControlSessionError('TASK_INVALID')
+  const findings = value.trim()
+  if (findings.length === 0 || findings.length > TASK_REVIEW_FINDINGS_MAX_CHARS || findings.includes('\u0000')) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  return findings
+}
diff --git a/packages/devframe/control-session/src/roster.ts b/packages/devframe/control-session/src/roster.ts
new file mode 100644
index 0000000000..2d94af69d9
--- /dev/null
+++ b/packages/devframe/control-session/src/roster.ts
@@ -0,0 +1,445 @@
+/**
+ * Slice 1B Worker-roster fold over the Global Controller log.
+ *
+ * `roster/registered` is the durable, pathless record of the Host registering
+ * one Worker (its Controller Session id) under a stable role assignment.
+ * Locating a Worker folds the LAST event per workerId (never a fixed seq —
+ * mirroring `project-authority/bound`, §10.2); the dispatch gate's addressing
+ * comes only from this fold (never a free-text Agent name, hard stop §11.8).
+ *
+ * @module @deepseek-ai/dsh-devframe-control-session/roster
+ */
+
+import type { AgentHandle } from '@deepseek-ai/dsh-agent'
+import type { Session, SessionEvent } from '@deepseek-ai/dsh-session'
+import {
+  TASK_PAYLOAD_EXECUTE,
+  TASK_PAYLOAD_REVIEW,
+  TASK_PAYLOAD_WHITELIST,
+  type RosterRegisteredV1,
+  type RosterView,
+} from './types.ts'
+import { ControlSessionError } from './index.ts'
+
+/** The durable event type carrying one Host Worker-registration mutation. */
+export const ROSTER_EVENT_TYPE = 'roster/registered' as const
+
+/**
+ * Slice 1B capability whitelist (design §11.2/§11.6, fail-closed): a Worker
+ * may only be registered with capabilities it is actually allowed to consume.
+ * The fixed test payload remains the original Slice 1B path; the provider-
+ * neutral executor capability is admitted only for a workspace-scoped Worker
+ * and is still gated by the 1C PolicyDecision slot at dispatch time.
+ */
+const ROSTER_CAPABILITY_WHITELIST: ReadonlySet<string> = new Set([
+  TASK_PAYLOAD_WHITELIST,
+  TASK_PAYLOAD_EXECUTE,
+  TASK_PAYLOAD_REVIEW,
+])
+
+/** Slice 1B guard: at least one admitted capability, all inside the whitelist. */
+function capabilitiesSupported(capabilities: readonly string[]): boolean {
+  return capabilities.length > 0
+    && capabilities.every(capability => ROSTER_CAPABILITY_WHITELIST.has(capability))
+}
+
+const ROSTER_REQUIRED_KEYS = [
+  'schemaVersion',
+  'workerId',
+  'roleAssignment',
+  'profileId',
+  'capabilities',
+  'rosterRevision',
+  'status',
+  'registeredAt',
+] as const
+const ROSTER_OPTIONAL_KEYS = ['workspaceScope'] as const
+
+const ROSTER_STATUSES = new Set(['pending', 'ready', 'offline'])
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return false
+  const prototype: unknown = Object.getPrototypeOf(value)
+  return prototype === Object.prototype || prototype === null
+}
+
+function isNonEmptyString(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0
+}
+
+function isEpochMs(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0
+}
+
+/**
+ * Validate one `roster/registered` payload with exact-key precision, mirroring
+ * the authority event's `parseBoundPayload` style. Any structural, typing, or
+ * status violation is a `ROSTER_INVALID` failure.
+ * @param value - the event payload to validate.
+ * @returns the validated, exact roster payload.
+ */
+function parseRosterPayload(value: unknown): RosterRegisteredV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('ROSTER_INVALID')
+  const allowed = new Set<string>([...ROSTER_REQUIRED_KEYS, ...ROSTER_OPTIONAL_KEYS])
+  if (Object.keys(value).some(key => !allowed.has(key))) throw new ControlSessionError('ROSTER_INVALID')
+  for (const key of ROSTER_REQUIRED_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('ROSTER_INVALID')
+  }
+  const {
+    schemaVersion, workerId, roleAssignment, profileId, capabilities,
+    rosterRevision, status, registeredAt,
+  } = value
+  if (schemaVersion !== 1) throw new ControlSessionError('ROSTER_INVALID')
+  if (!isNonEmptyString(workerId) || !isNonEmptyString(roleAssignment) || !isNonEmptyString(profileId)) {
+    throw new ControlSessionError('ROSTER_INVALID')
+  }
+  if (!Array.isArray(capabilities)
+    || capabilities.some(capability => typeof capability !== 'string' || capability.length === 0)) {
+    throw new ControlSessionError('ROSTER_INVALID')
+  }
+  // The element check above narrows the raw payload value to a string array;
+  // re-type it so the exact-key projection below spreads a checked type.
+  const capabilityList = capabilities as readonly string[]
+  // CAS numbering starts at 1 (first registration: lastRevision 0 + 1).
+  if (typeof rosterRevision !== 'number' || !Number.isSafeInteger(rosterRevision) || rosterRevision < 1) {
+    throw new ControlSessionError('ROSTER_INVALID')
+  }
+  if (typeof status !== 'string' || !ROSTER_STATUSES.has(status)) {
+    throw new ControlSessionError('ROSTER_INVALID')
+  }
+  if (!isEpochMs(registeredAt)) throw new ControlSessionError('ROSTER_INVALID')
+  const workspaceScope = value.workspaceScope
+  if (workspaceScope !== undefined && !isNonEmptyString(workspaceScope)) {
+    throw new ControlSessionError('ROSTER_INVALID')
+  }
+  return {
+    schemaVersion: 1,
+    workerId,
+    roleAssignment,
+    profileId,
+    capabilities: [...capabilityList],
+    rosterRevision,
+    status: status as RosterRegisteredV1['status'],
+    registeredAt,
+    ...workspaceScope === undefined ? {} : { workspaceScope },
+  } as unknown as RosterRegisteredV1
+}
+
+/**
+ * Fold the LAST `roster/registered` event per workerId — the dispatch gate's
+ * addressing source. Per-worker roster revisions must be strictly increasing;
+ * any violation is `ROSTER_INVALID`. Quarantined events (appended but not
+ * durable after a failed flush) are SKIPPED by seq without re-indexing the
+ * log, so the `seq === index` contiguity check stays exact.
+ * @param events - the Global Controller session event log.
+ * @param excludedSeqs - seqs of quarantined (not-durable) events to skip.
+ * @returns a map of workerId → last registration state.
+ */
+export function foldRoster(
+  events: readonly SessionEvent[],
+  excludedSeqs?: ReadonlySet<number>,
+): ReadonlyMap<string, RosterView> {
+  const roster = new Map<string, RosterView>()
+  const revisions = new Map<string, number>()
+  for (const [index, event] of events.entries()) {
+    if (event.type !== ROSTER_EVENT_TYPE) continue
+    // The `seq = log.length` contiguity contract is enforced by Session on
+    // restore; re-checking here guards the fold against externally spliced logs.
+    if (event.seq !== index) throw new ControlSessionError('ROSTER_INVALID')
+    if (excludedSeqs !== undefined && excludedSeqs.has(event.seq)) continue
+    const registered = parseRosterPayload(event.data)
+    const previous = revisions.get(registered.workerId) ?? 0
+    if (registered.rosterRevision <= previous) throw new ControlSessionError('ROSTER_INVALID')
+    revisions.set(registered.workerId, registered.rosterRevision)
+    roster.set(registered.workerId, {
+      workerId: registered.workerId,
+      roleAssignment: registered.roleAssignment,
+      profileId: registered.profileId,
+      capabilities: registered.capabilities,
+      rosterRevision: registered.rosterRevision,
+      status: registered.status,
+      registeredAt: registered.registeredAt,
+      ...registered.workspaceScope === undefined ? {} : { workspaceScope: registered.workspaceScope },
+    })
+  }
+  return roster
+}
+
+/**
+ * Resolve one role assignment to its unique registered Worker.
+ * @param events - the Global Controller session event log.
+ * @param roleAssignment - the stable role key to resolve.
+ * @param expectedProfileId - the Host profile the worker must belong to.
+ * @returns the resolved worker view.
+ */
+export function resolveRosterWorker(
+  events: readonly SessionEvent[],
+  roleAssignment: string,
+  expectedProfileId: string,
+): RosterView {
+  const roster = foldRoster(events)
+  const candidates = [...roster.values()]
+    .filter(worker => worker.roleAssignment === roleAssignment && worker.profileId === expectedProfileId)
+  if (candidates.length === 0) throw new ControlSessionError('ROLE_UNASSIGNED')
+  if (candidates.length > 1) throw new ControlSessionError('ROLE_ASSIGNMENT_AMBIGUOUS')
+  const worker = candidates[0]
+  // The zero/one guards above prove presence; this is the no-assertion form.
+  if (worker === undefined) throw new ControlSessionError('ROLE_UNASSIGNED')
+  return worker
+}
+
+/** Input for one Host Worker-registration (design §11.2, reservation→flush→guard). */
+export interface RosterRegisterOptions {
+  /** The live Global Controller session (identity-validated on open). */
+  readonly session: Session
+  /** Caller-supplied stable Worker id (e.g. 'worker-executor-1'); the fold key. */
+  readonly workerId: string
+  /** Stable role key (e.g. 'executor'), bound at registration. */
+  readonly roleAssignment: string
+  /** Host-published profile identity; callers cannot choose it. */
+  readonly profileId: string
+  /** Optional Workspace id the Worker is scoped to; absent = global. */
+  readonly workspaceScope?: string
+  /** Capability keys admitted by the Host capability gate. */
+  readonly capabilities: readonly string[]
+  /** Cancellation for the append + flush sequence. */
+  readonly signal?: AbortSignal
+  /** Durability seam: resolves true only after the append is durable. */
+  readonly flush: (session: Session) => Promise<boolean>
+  /**
+   * Worker session creation seam. Called only after the reservation is durable
+   * and the guard passed; the Host owns the session lifecycle and selects the
+   * tool face from this folded Worker view.
+   */
+  readonly createWorker: (workerId: string, signal?: AbortSignal, worker?: RosterView) => Promise<AgentHandle>
+}
+
+/** Input for one Host offline observation (design §11.2, status ready → offline). */
+export interface RosterMarkOfflineOptions {
+  /** The live Global Controller session carrying the roster fold. */
+  readonly session: Session
+  /** The registered Worker id being deactivated. */
+  readonly workerId: string
+  /** Cancellation for the append + flush sequence. */
+  readonly signal?: AbortSignal
+  /** Durability seam: resolves true only after the append is durable. */
+  readonly flush: (session: Session) => Promise<boolean>
+}
+
+/**
+ * Host-owned CAS + flush roster writer over the Global Controller log,
+ * mirroring {@link ProjectAuthorityService}. Registrations are serialized per
+ * workerId on an in-process promise chain (registerWorker is a low-rate
+ * operation; cross-process concurrency is already fenced by the single-writer
+ * Host lease). The method resolves only after the flush reports durable.
+ */
+export class RosterService {
+  private readonly chains = new Map<string, Promise<unknown>>()
+  /**
+   * `roster/registered` events appended but NOT yet durable (their flush
+   * failed or was aborted). They remain in the in-memory session log (Session
+   * has no rollback), but they must not project into any view or conflict
+   * fold: a phantom pending reservation would block a fresh retry of the same
+   * workerId with `ROSTER_CONFLICT` while never being durable. They are
+   * dropped from folds until a later successful flush backfills them durably
+   * (mirrors the authority quarantine, authority.ts).
+   */
+  private readonly pending = new Map<string, readonly number[]>()
+
+  /**
+   * CAS-guard one Worker registration (reservation→flush→guard) and resolve
+   * only after both the pending and the ready append are durable.
+   * @param options - live Global session, identity, capabilities, and the seams.
+   * @returns the folded ready Worker view once durable.
+   */
+  register(options: RosterRegisterOptions): Promise<RosterView> {
+    const workerId = options.workerId
+    const prior = this.chains.get(workerId) ?? Promise.resolve()
+    const next = prior.then(
+      () => this.registerNow(options),
+      () => this.registerNow(options),
+    ).finally(() => {
+      if (this.chains.get(workerId) === next) this.chains.delete(workerId)
+    })
+    this.chains.set(workerId, next)
+    return next
+  }
+
+  /**
+   * Fold the roster projection of a session log, excluding appended-but-not-
+   * durable reservations (see {@link pending}). `ready`/`offline` appends are
+   * never quarantined: a failed ready flush leaves the worker registered in
+   * memory and the next full-session flush backfills it durably, so the fold
+   * reporting it is honest rather than phantom.
+   * @param events - the Global Controller session event log.
+   * @returns the projected roster, per workerId last-wins.
+   */
+  view(events: readonly SessionEvent[]): ReadonlyMap<string, RosterView> {
+    if (this.pending.size === 0) return foldRoster(events)
+    const excluded = new Set<number>()
+    for (const seqs of this.pending.values()) {
+      for (const seq of seqs) excluded.add(seq)
+    }
+    // Skip quarantined seqs WITHOUT re-indexing the log: the fold's
+    // `seq === index` contiguity check must stay exact (a compressed array
+    // would misalign every later event and throw ROSTER_INVALID).
+    return foldRoster(events, excluded)
+  }
+
+  /**
+   * Append `offline` for one registered Worker after its Agent was observed
+   * disposed, and resolve only after the flush is durable. Serialized with
+   * registrations on the same per-workerId chain so a concurrent ready append
+   * can never race the revision counter. Only a `ready` worker is deactivated;
+   * an unknown or never-ready worker is left untouched.
+   * @param options - live Global session, Worker id, and the flush seam.
+   */
+  markOffline(options: RosterMarkOfflineOptions): Promise<void> {
+    const workerId = options.workerId
+    const prior = this.chains.get(workerId) ?? Promise.resolve()
+    const next = prior.then(
+      () => this.markOfflineNow(options),
+      () => this.markOfflineNow(options),
+    ).finally(() => {
+      if (this.chains.get(workerId) === next) this.chains.delete(workerId)
+    })
+    this.chains.set(workerId, next)
+    return next
+  }
+
+  private async registerNow(options: RosterRegisterOptions): Promise<RosterView> {
+    options.signal?.throwIfAborted()
+    // --- 1. reservation (design §11.2) ---
+    // The conflict check folds the quarantine-aware view so a phantom
+    // reservation can never poison the workerId for the rest of the process.
+    const visible = this.view(options.session.events)
+    if (visible.has(options.workerId)) {
+      // CAS miss: no append, no flush.
+      throw new ControlSessionError('ROSTER_CONFLICT')
+    }
+    // The next CAS revision counts over the FULL fold (including quarantined
+    // reservations) so a retried reservation never reuses a revision number a
+    // phantom append already consumed: the durable log stays strictly
+    // increasing when the phantom is backfilled by a later flush.
+    const full = foldRoster(options.session.events)
+    const lastRevision = full.get(options.workerId)?.rosterRevision ?? 0
+    const rosterRevision = lastRevision + 1
+    const reservedSeq = options.session.seq
+    options.session.append(ROSTER_EVENT_TYPE, {
+      schemaVersion: 1,
+      workerId: options.workerId,
+      roleAssignment: options.roleAssignment,
+      profileId: options.profileId,
+      capabilities: [...options.capabilities],
+      rosterRevision,
+      status: 'pending',
+      registeredAt: Date.now(),
+      ...options.workspaceScope === undefined ? {} : { workspaceScope: options.workspaceScope },
+    })
+    // --- 2. flush ---
+    options.signal?.throwIfAborted()
+    let durable = false
+    try {
+      durable = await options.flush(options.session)
+    } catch (failure) {
+      this.quarantine(options.workerId, reservedSeq)
+      throw new ControlSessionError('DURABILITY_FAILED', { cause: failure })
+    }
+    if (!durable) {
+      this.quarantine(options.workerId, reservedSeq)
+      throw new ControlSessionError('DURABILITY_FAILED')
+    }
+    // --- 3. guard (design §11.2): fold uniqueness + identity + whitelist ---
+    const folded = foldRoster(options.session.events)
+    const reservation = folded.get(options.workerId)
+    if (reservation === undefined || reservation.status !== 'pending'
+      || reservation.profileId !== options.profileId
+      || reservation.roleAssignment.length === 0) {
+      throw new ControlSessionError('ROSTER_INVALID')
+    }
+    if (!capabilitiesSupported(options.capabilities)) {
+      throw new ControlSessionError('TASK_PAYLOAD_UNSUPPORTED')
+    }
+    if (options.capabilities.includes(TASK_PAYLOAD_EXECUTE)
+      && options.workspaceScope === undefined) {
+      throw new ControlSessionError('ROSTER_INVALID')
+    }
+    // The guard passed: the Host now creates the Worker session with the
+    // capability-derived tool face.
+    try {
+      await options.createWorker(options.workerId, options.signal, reservation)
+    } catch (failure) {
+      // The reservation stays durable as `pending`; no ready append is made.
+      throw failure instanceof ControlSessionError
+        ? failure
+        : new ControlSessionError('DURABILITY_FAILED', { cause: failure })
+    }
+    // The Worker session is live: promote the reservation to `ready`.
+    const readyRevision = reservation.rosterRevision + 1
+    options.session.append(ROSTER_EVENT_TYPE, {
+      schemaVersion: 1,
+      workerId: reservation.workerId,
+      roleAssignment: reservation.roleAssignment,
+      profileId: reservation.profileId,
+      capabilities: [...reservation.capabilities],
+      rosterRevision: readyRevision,
+      status: 'ready',
+      registeredAt: Date.now(),
+      ...reservation.workspaceScope === undefined ? {} : { workspaceScope: reservation.workspaceScope },
+    })
+    options.signal?.throwIfAborted()
+    try {
+      durable = await options.flush(options.session)
+    } catch (failure) {
+      throw new ControlSessionError('DURABILITY_FAILED', { cause: failure })
+    }
+    if (!durable) throw new ControlSessionError('DURABILITY_FAILED')
+    this.pending.delete(options.workerId)
+    const view = this.view(options.session.events).get(options.workerId)
+    if (view === undefined) throw new ControlSessionError('ROSTER_INVALID')
+    return view
+  }
+
+  private async markOfflineNow(options: RosterMarkOfflineOptions): Promise<void> {
+    options.signal?.throwIfAborted()
+    const folded = foldRoster(options.session.events)
+    const worker = folded.get(options.workerId)
+    // Only a `ready` Worker loses a live session; an unknown or never-ready
+    // registration has nothing to deactivate.
+    if (worker === undefined || worker.status !== 'ready') return
+    options.session.append(ROSTER_EVENT_TYPE, {
+      schemaVersion: 1,
+      workerId: worker.workerId,
+      roleAssignment: worker.roleAssignment,
+      profileId: worker.profileId,
+      capabilities: [...worker.capabilities],
+      rosterRevision: worker.rosterRevision + 1,
+      status: 'offline',
+      registeredAt: Date.now(),
+      ...worker.workspaceScope === undefined ? {} : { workspaceScope: worker.workspaceScope },
+    })
+    options.signal?.throwIfAborted()
+    try {
+      if (!await options.flush(options.session)) {
+        throw new ControlSessionError('DURABILITY_FAILED')
+      }
+    } catch (failure) {
+      throw failure instanceof ControlSessionError
+        ? failure
+        : new ControlSessionError('DURABILITY_FAILED', { cause: failure })
+    }
+  }
+
+  /**
+   * Quarantine one appended-but-not-durable reservation (identified by its
+   * seq) so views and conflict folds exclude it. A later successful flush of
+   * the same session drops it from the durable log's future — the quarantine
+   * itself is dropped by the next successful registration of that workerId.
+   * @param workerId - the worker whose pending set changes.
+   * @param seq - the appended reservation event's seq.
+   */
+  private quarantine(workerId: string, seq: number): void {
+    const pending = this.pending.get(workerId) ?? []
+    this.pending.set(workerId, [...pending, seq])
+  }
+}
diff --git a/packages/devframe/control-session/src/task-board.ts b/packages/devframe/control-session/src/task-board.ts
new file mode 100644
index 0000000000..83fea82f05
--- /dev/null
+++ b/packages/devframe/control-session/src/task-board.ts
@@ -0,0 +1,508 @@
+/**
+ * Slice 1B Task Board fold over the Global Controller log.
+ *
+ * `task/change` is the durable, pathless six-state index of one task. Only
+ * references (taskId / semanticMessageId / messageId / payloadRef) enter the
+ * log — never message bodies or transcripts (hard stop §11.8); the physical
+ * messages live in the Worker session. The fold is the idempotency and
+ * state-transition arbiter: a semantic key executes exactly once (§11.5) and
+ * illegal transitions are rejected.
+ *
+ * @module @deepseek-ai/dsh-devframe-control-session/task-board
+ */
+
+import { createHash } from 'node:crypto'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import {
+  TASK_REPORT_EVIDENCE_KIND,
+  type TaskBoardState,
+  type TaskBoardTaskView,
+  type TaskChangeV1,
+  type TaskReportEvidenceV1,
+  type TaskTrajectoryReferenceV1,
+} from './types.ts'
+import {
+  foldTaskReviews,
+  parseTaskReviewReference,
+} from './review.ts'
+import { foldEvaluationReceipts } from './evaluation.ts'
+import { ControlSessionError } from './index.ts'
+
+/** The durable event type carrying one Task Board mutation. */
+export const TASK_EVENT_TYPE = 'task/change' as const
+
+const TASK_REQUIRED_KEYS = [
+  'schemaVersion',
+  'kind',
+  'version',
+  'operation',
+  'taskId',
+  'semanticMessageId',
+  'workerId',
+  'payloadRef',
+  'changedAt',
+] as const
+const TASK_OPTIONAL_KEYS = [
+  'objectiveId',
+  'runId',
+  'messageId',
+  'replyTo',
+  'leaseExpiresAt',
+  'reportRef',
+  'reviewRef',
+] as const
+
+const TASK_REPORT_REQUIRED_KEYS = [
+  'schemaVersion',
+  'kind',
+  'sessionId',
+  'messageId',
+  'assistantSeq',
+  'turn',
+  'step',
+  'turnEndSeq',
+  'outcome',
+  'sourceEventSeqs',
+  'messageSha256',
+  'evidenceSha256',
+] as const
+const TASK_REPORT_OPTIONAL_KEYS = ['artifactRefs', 'trajectoryRefs'] as const
+const TASK_REPORT_OUTCOMES = new Set(['completed', 'max-tokens'])
+const TASK_REPORT_MAX_SOURCE_EVENTS = 256
+const TASK_REPORT_MAX_REFS = 256
+
+const TASK_OPERATIONS = new Set([
+  'queue', 'admit', 'ack', 'claim', 'start', 'report',
+  'fail', 'cancel', 'expire',
+])
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return false
+  const prototype: unknown = Object.getPrototypeOf(value)
+  return prototype === Object.prototype || prototype === null
+}
+
+function isNonEmptyString(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0
+}
+
+function isEpochMs(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0
+}
+
+function isSafeSeq(value: unknown): value is number {
+  return Number.isSafeInteger(value) && (value as number) >= 0
+}
+
+function isPositiveSafeInt(value: unknown): value is number {
+  return Number.isSafeInteger(value) && (value as number) > 0
+}
+
+function isPathlessId(value: unknown): value is string {
+  return isNonEmptyString(value) && !value.includes('/') && !value.includes('\\')
+}
+
+function isSha256Hex(value: unknown): value is string {
+  return typeof value === 'string' && /^[0-9a-f]{64}$/u.test(value)
+}
+
+/** Canonical JSON payload used for the evidence digest; excludes the digest itself. */
+function taskReportEvidencePayload(
+  evidence: Omit<TaskReportEvidenceV1, 'evidenceSha256'>,
+): string {
+  return JSON.stringify({
+    schemaVersion: evidence.schemaVersion,
+    kind: evidence.kind,
+    sessionId: evidence.sessionId,
+    messageId: evidence.messageId,
+    assistantSeq: evidence.assistantSeq,
+    turn: evidence.turn,
+    step: evidence.step,
+    turnEndSeq: evidence.turnEndSeq,
+    outcome: evidence.outcome,
+    sourceEventSeqs: evidence.sourceEventSeqs,
+    messageSha256: evidence.messageSha256,
+    ...evidence.artifactRefs === undefined ? {} : { artifactRefs: evidence.artifactRefs },
+    ...evidence.trajectoryRefs === undefined ? {} : { trajectoryRefs: evidence.trajectoryRefs },
+  })
+}
+
+/** Compute the stable SHA-256 over one normalized report evidence reference. */
+export function taskReportEvidenceDigest(
+  evidence: Omit<TaskReportEvidenceV1, 'evidenceSha256'>,
+): string {
+  return createHash('sha256').update(taskReportEvidencePayload(evidence)).digest('hex')
+}
+
+function parseTaskReportEvidence(value: unknown): TaskReportEvidenceV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('TASK_INVALID')
+  const allowed = new Set<string>([...TASK_REPORT_REQUIRED_KEYS, ...TASK_REPORT_OPTIONAL_KEYS])
+  if (Object.keys(value).some(key => !allowed.has(key))) throw new ControlSessionError('TASK_INVALID')
+  for (const key of TASK_REPORT_REQUIRED_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('TASK_INVALID')
+  }
+  const {
+    schemaVersion, kind, sessionId, messageId, assistantSeq, turn, step,
+    turnEndSeq, outcome, sourceEventSeqs, messageSha256, evidenceSha256,
+  } = value
+  const artifactRefs = value.artifactRefs
+  const trajectoryRefs = value.trajectoryRefs
+  if (artifactRefs !== undefined
+    && (!Array.isArray(artifactRefs) || artifactRefs.length > TASK_REPORT_MAX_REFS
+      || artifactRefs.some(ref => !isSha256Hex(ref)))) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const normalizedArtifactRefs = artifactRefs === undefined
+    ? undefined
+    : (artifactRefs as unknown[]).map((ref: unknown) => {
+      if (!isSha256Hex(ref)) throw new ControlSessionError('TASK_INVALID')
+      return ref
+    })
+  if (trajectoryRefs !== undefined
+    && (!Array.isArray(trajectoryRefs) || trajectoryRefs.length > TASK_REPORT_MAX_REFS)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  if (schemaVersion !== 1 || kind !== TASK_REPORT_EVIDENCE_KIND
+    || !isPathlessId(sessionId) || !isPathlessId(messageId)
+    || !isSafeSeq(assistantSeq) || !isSafeSeq(turnEndSeq)
+    || !isPositiveSafeInt(turn)
+    || !isPositiveSafeInt(step)
+    || assistantSeq >= turnEndSeq
+    || typeof outcome !== 'string' || !TASK_REPORT_OUTCOMES.has(outcome)
+    || !Array.isArray(sourceEventSeqs)
+    || sourceEventSeqs.length < 2 || sourceEventSeqs.length > TASK_REPORT_MAX_SOURCE_EVENTS
+    || !isSha256Hex(messageSha256) || !isSha256Hex(evidenceSha256)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const seqs = sourceEventSeqs.map((seq) => {
+    if (!isSafeSeq(seq)) throw new ControlSessionError('TASK_INVALID')
+    return seq
+  })
+  const refs = trajectoryRefs?.map((ref): TaskTrajectoryReferenceV1 => {
+    if (!isPlainRecord(ref) || !isPathlessId(ref.sessionId) || !isSafeSeq(ref.seq)) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    return { sessionId: ref.sessionId as TaskTrajectoryReferenceV1['sessionId'], seq: ref.seq }
+  })
+  for (let index = 1; index < seqs.length; index++) {
+    const previous = seqs[index - 1]
+    const current = seqs[index]
+    if (previous === undefined || current === undefined || current <= previous) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+  }
+  if (!seqs.includes(assistantSeq) || !seqs.includes(turnEndSeq)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const normalized = {
+    schemaVersion: 1 as const,
+    kind: TASK_REPORT_EVIDENCE_KIND,
+    sessionId: sessionId as TaskReportEvidenceV1['sessionId'],
+    messageId,
+    assistantSeq,
+    turn,
+    step,
+    turnEndSeq,
+    outcome: outcome as TaskReportEvidenceV1['outcome'],
+    sourceEventSeqs: seqs,
+    messageSha256,
+    ...normalizedArtifactRefs === undefined ? {} : { artifactRefs: normalizedArtifactRefs },
+    ...refs === undefined ? {} : { trajectoryRefs: refs },
+  }
+  if (taskReportEvidenceDigest(normalized) !== evidenceSha256) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  return { ...normalized, evidenceSha256 }
+}
+
+/**
+ * Validate one `task/change` payload with exact-key precision. Any structural,
+ * typing, or operation violation is a `TASK_INVALID` failure.
+ * @param value - the event payload to validate.
+ * @returns the validated, exact task payload.
+ */
+function parseTaskPayload(value: unknown): TaskChangeV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('TASK_INVALID')
+  const allowed = new Set<string>([...TASK_REQUIRED_KEYS, ...TASK_OPTIONAL_KEYS])
+  if (Object.keys(value).some(key => !allowed.has(key))) throw new ControlSessionError('TASK_INVALID')
+  for (const key of TASK_REQUIRED_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('TASK_INVALID')
+  }
+  const {
+    schemaVersion, kind, version, operation, taskId, semanticMessageId,
+    workerId, payloadRef, changedAt,
+  } = value
+  if (schemaVersion !== 1 || kind !== 'task' || version !== 1) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  if (typeof operation !== 'string' || !TASK_OPERATIONS.has(operation)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  if (!isNonEmptyString(taskId) || !isNonEmptyString(semanticMessageId)
+    || !isNonEmptyString(workerId) || !isNonEmptyString(payloadRef)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  if (!isEpochMs(changedAt)) throw new ControlSessionError('TASK_INVALID')
+  const objectiveId = value.objectiveId
+  if (objectiveId !== undefined && !isNonEmptyString(objectiveId)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const runId = value.runId
+  if (runId !== undefined && !isNonEmptyString(runId)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const messageId = value.messageId
+  if (messageId !== undefined && !isNonEmptyString(messageId)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const reportRef = value.reportRef === undefined
+    ? undefined : parseTaskReportEvidence(value.reportRef)
+  const reviewRef = value.reviewRef === undefined
+    ? undefined : parseTaskReviewReference(value.reviewRef)
+  const replyTo = value.replyTo
+  if (replyTo !== undefined
+    && (!isPlainRecord(replyTo)
+      || !isNonEmptyString(replyTo.sessionId)
+      || !isNonEmptyString(replyTo.messageId))) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const leaseExpiresAt = value.leaseExpiresAt
+  if (leaseExpiresAt !== undefined && !isEpochMs(leaseExpiresAt)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  return {
+    schemaVersion: 1,
+    kind: 'task',
+    version: 1,
+    operation: operation as TaskChangeV1['operation'],
+    taskId,
+    semanticMessageId,
+    workerId,
+    payloadRef,
+    changedAt,
+    ...objectiveId === undefined ? {} : { objectiveId },
+    ...runId === undefined ? {} : { runId },
+    ...messageId === undefined ? {} : { messageId },
+    ...reportRef === undefined ? {} : { reportRef },
+    ...reviewRef === undefined ? {} : { reviewRef },
+    ...replyTo === undefined ? {} : { replyTo: { sessionId: replyTo.sessionId, messageId: replyTo.messageId } },
+    ...leaseExpiresAt === undefined ? {} : { leaseExpiresAt },
+  } as unknown as TaskChangeV1
+}
+
+/** The foldable state machine: operation → resulting state, with guards. */
+function applyOperation(
+  state: TaskBoardState,
+  change: TaskChangeV1,
+): TaskBoardState {
+  const invalid = (): never => { throw new ControlSessionError('TASK_STATE_INVALID') }
+  switch (change.operation) {
+    case 'queue':
+      if (state.status !== 'queued') invalid()
+      return { status: 'queued' }
+    case 'admit':
+      // Idempotency arbiter (§11.5): admitted is the decision point; a
+      // re-admit of an executed semantic key is a duplicate, not a migration.
+      if (state.status === 'admitted' || state.status === 'acknowledged'
+        || state.status === 'claimed' || state.status === 'started'
+        || state.status === 'reported' || state.status === 'failed') {
+        throw new ControlSessionError('TASK_DUPLICATE')
+      }
+      if (state.status === 'cancelled') invalid()
+      return { status: 'admitted' }
+    case 'ack':
+      if (state.status !== 'admitted') invalid()
+      return { status: 'acknowledged' }
+    case 'claim':
+      if (state.status !== 'acknowledged') invalid()
+      return { status: 'claimed', ...change.leaseExpiresAt === undefined ? {} : { leaseExpiresAt: change.leaseExpiresAt } }
+    case 'start':
+      if (state.status !== 'claimed') invalid()
+      return { status: 'started' }
+    case 'report':
+      if (state.status !== 'started' && state.status !== 'claimed') invalid()
+      return { status: 'reported' }
+    case 'fail':
+      if (state.status === 'reported' || state.status === 'cancelled') invalid()
+      return { status: 'failed' }
+    case 'cancel':
+    case 'expire':
+      if (state.status === 'reported' || state.status === 'cancelled' || state.status === 'failed') invalid()
+      return { status: 'cancelled' }
+    /* v8 ignore next -- the operation union is exhaustive above */
+    default:
+      return invalid()
+  }
+}
+
+/**
+ * Fold the LAST `task/change` state of one task id from a session log — the
+ * idempotency and state-transition arbiter. Every task payload is validated
+ * in exact-key style and the state machine is strictly checked; any violation
+ * is `TASK_INVALID` / `TASK_STATE_INVALID` / `TASK_DUPLICATE`.
+ * @param events - the Global Controller session event log.
+ * @param taskId - the task to fold.
+ * @returns the last state, or `queued` when the log carries no such task.
+ */
+export function foldTask(
+  events: readonly SessionEvent[],
+  taskId: string,
+): TaskBoardState {
+  let state: TaskBoardState = { status: 'queued' }
+  for (const [index, event] of events.entries()) {
+    if (event.type !== TASK_EVENT_TYPE) continue
+    if (event.seq !== index) throw new ControlSessionError('TASK_INVALID')
+    const change = parseTaskPayload(event.data)
+    if (change.taskId !== taskId) continue
+    state = applyOperation(state, change)
+  }
+  return state
+}
+
+/**
+ * Whether one semantic message id has already been admitted (executed or
+ * in-flight) — the idempotency fold (§11.5): a re-dispatch with the same key
+ * is a duplicate, never a second execution.
+ * @param events - the Global Controller session event log.
+ * @param semanticMessageId - the business idempotency key.
+ * @returns true while any task for the key is queued/admitted or in flight.
+ */
+export function semanticKeyAdmitted(
+  events: readonly SessionEvent[],
+  semanticMessageId: string,
+): boolean {
+  const taskIds = new Set<string>()
+  for (const [index, event] of events.entries()) {
+    if (event.type !== TASK_EVENT_TYPE) continue
+    if (event.seq !== index) throw new ControlSessionError('TASK_INVALID')
+    const change = parseTaskPayload(event.data)
+    if (change.semanticMessageId !== semanticMessageId) continue
+    taskIds.add(change.taskId)
+  }
+  for (const taskId of taskIds) {
+    const state = foldTask(events, taskId)
+    // Terminal tasks (cancelled/failed — e.g. a lease-expiry abort, §11.6
+    // "semantic key 未执行可重投") free the key: a redispatch opens a NEW
+    // task instance under a fresh taskId and re-enters the state machine.
+    if (state.status !== 'cancelled' && state.status !== 'failed') return true
+  }
+  return false
+}
+
+/**
+ * Locate the LAST `task/change` event carrying one semantic message id — the
+ * existing-task reference an idempotent redispatch returns (design §11.5:
+ * "返回既有任务引用"). Every payload is validated in exact-key style; any
+ * violation is `TASK_INVALID`.
+ * @param events - the Global Controller session event log.
+ * @param semanticMessageId - the business idempotency key.
+ * @returns the last change for the key, or undefined when the log never saw it.
+ */
+export function findTaskBySemanticKey(
+  events: readonly SessionEvent[],
+  semanticMessageId: string,
+): TaskChangeV1 | undefined {
+  let found: TaskChangeV1 | undefined
+  for (const [index, event] of events.entries()) {
+    if (event.type !== TASK_EVENT_TYPE) continue
+    if (event.seq !== index) throw new ControlSessionError('TASK_INVALID')
+    const change = parseTaskPayload(event.data)
+    if (change.semanticMessageId !== semanticMessageId) continue
+    found = change
+  }
+  return found
+}
+
+/**
+ * The idempotency-claim adjudication of one observed inbox claim (design
+ * §11.5): a claim must carry the semantic key (`missing-key`) and the fold
+ * must arbitrate uniqueness — an in-flight key (`conflict`) or an already
+ * executed key (`duplicate`) is never re-claimed. The Host consults this
+ * BEFORE appending a `claim` event; a rejected observation appends nothing.
+ */
+export type ClaimAdjudication =
+  | { readonly kind: 'ok' }
+  | { readonly kind: 'missing-key' }
+  | { readonly kind: 'conflict' }
+  | { readonly kind: 'duplicate' }
+
+/**
+ * Adjudicate one claim observation over the Global Controller log.
+ * @param events - the Global Controller session event log.
+ * @param semanticMessageId - the claimed message's business key (may be absent).
+ * @returns the adjudication; only `ok` may proceed to append `claim`.
+ */
+export function adjudicateClaim(
+  events: readonly SessionEvent[],
+  semanticMessageId: string | undefined,
+): ClaimAdjudication {
+  if (semanticMessageId === undefined || semanticMessageId.length === 0) {
+    return { kind: 'missing-key' }
+  }
+  const last = findTaskBySemanticKey(events, semanticMessageId)
+  if (last === undefined) return { kind: 'missing-key' }
+  switch (last.operation) {
+    case 'claim':
+    case 'start':
+      // Another claim/start already owns the key: a second Worker (or a
+      // redelivered duplicate) is a conflict, never a migration.
+      return { kind: 'conflict' }
+    case 'report':
+    case 'fail':
+    case 'cancel':
+    case 'expire':
+      // The key already executed: the observation is a duplicate, discarded.
+      return { kind: 'duplicate' }
+    default:
+      return { kind: 'ok' }
+  }
+}
+
+/**
+ * Fold the whole Task Board over the Global Controller log — the pathless
+ * taskId → row projection every `task/change` consumer sees. Rows are kept in
+ * first-seen task order; each row carries the LAST event's references plus the
+ * folded six-state status. Every payload is validated in exact-key style and
+ * every task's state machine is strictly checked (any violation is
+ * `TASK_INVALID` / `TASK_STATE_INVALID` / `TASK_DUPLICATE`).
+ * @param events - the Global Controller session event log.
+ * @returns taskId → folded task row, in first-seen order.
+ */
+export function foldTaskBoard(
+  events: readonly SessionEvent[],
+): ReadonlyMap<string, TaskBoardTaskView> {
+  const order: string[] = []
+  const lastByTask = new Map<string, TaskChangeV1>()
+  for (const [index, event] of events.entries()) {
+    if (event.type !== TASK_EVENT_TYPE) continue
+    if (event.seq !== index) throw new ControlSessionError('TASK_INVALID')
+    const change = parseTaskPayload(event.data)
+    if (!lastByTask.has(change.taskId)) order.push(change.taskId)
+    lastByTask.set(change.taskId, change)
+  }
+  const board = new Map<string, TaskBoardTaskView>()
+  const reviews = foldTaskReviews(events)
+  const evaluations = foldEvaluationReceipts(events)
+  for (const taskId of order) {
+    const last = lastByTask.get(taskId)
+    if (last === undefined) continue
+    const state = foldTask(events, taskId)
+    const review = reviews.get(taskId)
+    const evaluation = evaluations.get(taskId)
+    board.set(taskId, {
+      taskId,
+      state: state.status,
+      workerId: last.workerId,
+      semanticMessageId: last.semanticMessageId,
+      payloadRef: last.payloadRef,
+      ...last.messageId === undefined ? {} : { messageId: last.messageId },
+      ...last.reportRef === undefined ? {} : { reportRef: last.reportRef },
+      ...review === undefined ? {} : { review },
+      ...evaluation === undefined ? {} : { evaluation },
+      ...last.reviewRef === undefined ? {} : { reviewRef: last.reviewRef },
+      ...last.objectiveId === undefined ? {} : { objectiveId: last.objectiveId },
+      ...last.leaseExpiresAt === undefined ? {} : { leaseExpiresAt: last.leaseExpiresAt },
+    })
+  }
+  return board
+}
diff --git a/packages/devframe/control-session/src/trajectory.ts b/packages/devframe/control-session/src/trajectory.ts
new file mode 100644
index 0000000000..a05d6435c5
--- /dev/null
+++ b/packages/devframe/control-session/src/trajectory.ts
@@ -0,0 +1,94 @@
+/** Read-only, bounded projection over native Worker Session events. */
+
+import type { SessionEvent, SessionId } from '@deepseek-ai/dsh-session'
+import type {
+  DevFrameTrajectoryItem,
+  DevFrameTrajectoryView,
+  TaskTrajectoryReferenceV1,
+} from './types.ts'
+import { ControlSessionError } from './index.ts'
+
+const MAX_ITEMS = 64
+const MAX_TOOL_NAME = 128
+const ALLOWED_EVENTS = new Set([
+  'request/header', 'request/context', 'turn/start', 'assistant/message',
+  'tool/call', 'tool/result', 'turn/end',
+])
+
+function boundedToken(value: unknown): string | undefined {
+  if (typeof value !== 'string' || value.length === 0 || value.length > 128) return undefined
+  if (!/^[A-Za-z0-9._:-]+$/u.test(value)) return undefined
+  return value
+}
+
+function isSafeSeq(value: unknown): value is number {
+  return Number.isSafeInteger(value) && (value as number) >= 0
+}
+
+function pathlessId(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 && value.length <= 256
+    && !value.includes('/') && !value.includes('\\')
+}
+
+function eventRow(event: SessionEvent): DevFrameTrajectoryItem | undefined {
+  if (!ALLOWED_EVENTS.has(event.type)) return undefined
+  const row: DevFrameTrajectoryItem = { seq: event.seq, type: event.type }
+  if (event.type === 'request/header') {
+    const provider = boundedToken(event.data.header.config.provider)
+    const model = boundedToken(event.data.header.config.model)
+    return {
+      ...row,
+      ...provider === undefined ? {} : { provider },
+      ...model === undefined ? {} : { model },
+    }
+  }
+  if (event.type === 'tool/call') {
+    const toolName = boundedToken(event.data.name)
+    return toolName === undefined || toolName.length > MAX_TOOL_NAME
+      ? row : { ...row, toolName }
+  }
+  return row
+}
+
+/** Project only allowlisted event facts; bodies, arguments, paths, and secrets never cross this boundary. */
+export function projectTrajectory(options: {
+  readonly taskId: string
+  readonly sessionId: SessionId
+  readonly events: readonly SessionEvent[]
+  readonly refs: readonly TaskTrajectoryReferenceV1[]
+  readonly afterSeq?: number
+  readonly limit?: number
+}): DevFrameTrajectoryView {
+  if (!pathlessId(options.taskId) || !pathlessId(options.sessionId)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const afterSeq = options.afterSeq ?? -1
+  const limit = options.limit ?? MAX_ITEMS
+  if (!Number.isSafeInteger(afterSeq) || afterSeq < -1
+    || !Number.isSafeInteger(limit) || limit < 1 || limit > MAX_ITEMS) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const referenced = new Set<number>()
+  for (const ref of options.refs) {
+    if (ref.sessionId !== options.sessionId || !isSafeSeq(ref.seq)) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    referenced.add(ref.seq)
+  }
+  const rows: DevFrameTrajectoryItem[] = []
+  for (const event of options.events) {
+    if (!referenced.has(event.seq) || event.seq <= afterSeq) continue
+    const row = eventRow(event)
+    if (row === undefined) continue
+    rows.push(row)
+    if (rows.length >= limit) break
+  }
+  const last = rows.at(-1)?.seq
+  return {
+    taskId: options.taskId,
+    sessionId: options.sessionId,
+    cursor: last ?? afterSeq,
+    items: rows,
+    ...last !== undefined && rows.length === limit ? { nextCursor: last } : {},
+  }
+}
