diff --git a/packages/client/ui-devframe-control-session/tests/global-prompt-router.client.spec.ts b/packages/client/ui-devframe-control-session/tests/global-prompt-router.client.spec.ts
new file mode 100644
index 0000000000..893077ea89
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/tests/global-prompt-router.client.spec.ts
@@ -0,0 +1,131 @@
+import { describe, expect, it, vi } from 'vitest'
+import { GlobalPromptRouter } from '../src/client/global-prompt-router.ts'
+import type {
+  ClientContext, SessionId, SessionListState, WorkspaceId, WorkspaceListState,
+} from '@deepseek-ai/dsh-client-runtime/client'
+
+const sessionId = 'devframe-global:profile-1' as SessionId
+const workspaceId = 'workspace-1' as WorkspaceId
+
+interface RouterContextDouble {
+  get(name: string): unknown
+  remote: object
+  dispatch: ReturnType<typeof vi.fn>
+  sessionsFace: { list: { getSnapshot(): SessionListState } }
+  workspacesFace: { list: { getSnapshot(): WorkspaceListState } }
+}
+
+function context(options: {
+  sessionRole?: 'global' | 'project'
+  workspaces?: WorkspaceListState['items']
+  dispatch?: ReturnType<typeof vi.fn>
+} = {}) {
+  const sessions: SessionListState = {
+    ids: [sessionId],
+    byId: {
+      [sessionId]: {
+        id: sessionId,
+        displayTitle: 'Global Controller',
+        devframeRole: options.sessionRole ?? 'global',
+        running: false,
+        blank: false,
+        updatedAt: 1,
+      },
+    },
+    current: sessionId,
+    phase: 'ready',
+    subagentsByParent: {},
+    jobsBySession: {},
+    currentAddress: undefined,
+  }
+  const workspaces: WorkspaceListState = {
+    items: options.workspaces ?? [{
+      workspaceId,
+      path: 'C:/workspace-1',
+      title: 'Workspace 1',
+      sessionIds: [],
+      createdAt: '2026-08-25T00:00:00.000Z',
+      updatedAt: '2026-08-25T00:00:00.000Z',
+    }],
+    archivedSessionIds: [],
+    state: 'idle',
+    phase: 'ready',
+    error: null,
+    baselinesReady: true,
+    recentWorkspaceId: workspaceId,
+  }
+  const dispatch = options.dispatch ?? vi.fn().mockResolvedValue({
+    loopId: 'loop-1', objectiveId: 'objective-1', projectId: workspaceId,
+    projectSessionId: 'project-session-1', outcome: 'completed', review: 'passed',
+    memoryStatus: 'current',
+  })
+  const sessionsFace = { list: { getSnapshot: () => sessions } }
+  const workspacesFace = { list: { getSnapshot: () => workspaces } }
+  const result: RouterContextDouble = {
+    get(name: string) {
+      if (name === 'sessions') return sessionsFace
+      if (name === 'workspaces') return workspacesFace
+      if (name === 'remote.devframeControlSessions') return { dispatchProjectLoop: dispatch }
+      return undefined
+    },
+    remote: {},
+    dispatch,
+    sessionsFace,
+    workspacesFace,
+  }
+  return result
+}
+
+describe('GlobalPromptRouter', () => {
+  it('routes an explicitly targeted Global queue message through Host Remote', async () => {
+    const ctx = context()
+    const router = new GlobalPromptRouter(ctx as unknown as ClientContext)
+    router.setTarget({ workspaceId })
+
+    await expect(router.route({ sessionId, text: '修复测试', mode: 'queue' })).resolves.toBe(true)
+    const calls = ctx.dispatch.mock.calls as unknown as Array<[Record<string, unknown>]>
+    expect(calls).toHaveLength(1)
+    const request = calls[0]?.[0]
+    expect(request).toMatchObject({
+      projectId: workspaceId,
+      projectRoot: 'C:/workspace-1',
+      objective: '修复测试',
+      maxGoalRounds: 1,
+    })
+    expect(typeof request?.requestIdempotencyKey).toBe('string')
+  })
+
+  it('keeps direct chat, steer, and non-Global sessions on the native prompt path', async () => {
+    const direct = new GlobalPromptRouter(context() as unknown as ClientContext)
+    await expect(direct.route({ sessionId, text: '直接问 GPT', mode: 'queue' })).resolves.toBe(false)
+
+    direct.setTarget({ workspaceId })
+    await expect(direct.route({ sessionId, text: '不要路由', mode: 'steer' })).resolves.toBe(false)
+
+    const project = new GlobalPromptRouter(context({ sessionRole: 'project' }) as unknown as ClientContext)
+    project.setTarget({ workspaceId })
+    await expect(project.route({ sessionId, text: '项目会话', mode: 'queue' })).resolves.toBe(false)
+  })
+
+  it('fails closed when an explicit project target is unavailable', async () => {
+    const router = new GlobalPromptRouter(context({ workspaces: [] }) as unknown as ClientContext)
+    router.setTarget({ workspaceId })
+    await expect(router.route({ sessionId, text: '目标已删除', mode: 'queue' })).rejects.toThrow(
+      'Global project target is no longer available.',
+    )
+
+    const base = context()
+    const noRemote = new GlobalPromptRouter({
+      get(name: string) {
+        if (name === 'sessions') return base.sessionsFace
+        if (name === 'workspaces') return base.workspacesFace
+        return undefined
+      },
+      remote: {},
+    } as unknown as ClientContext)
+    noRemote.setTarget({ workspaceId })
+    await expect(noRemote.route({ sessionId, text: 'Host 尚未就绪', mode: 'queue' })).rejects.toThrow(
+      'The DevFrame Host is still starting. Try again shortly.',
+    )
+  })
+})
diff --git a/packages/client/ui-devframe-control-session/tests/project-loop-panel.client.spec.tsx b/packages/client/ui-devframe-control-session/tests/project-loop-panel.client.spec.tsx
new file mode 100644
index 0000000000..9a50ac95c2
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/tests/project-loop-panel.client.spec.tsx
@@ -0,0 +1,131 @@
+// @vitest-environment jsdom
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type {
+  SessionId, WorkspaceId, WorkspaceListState,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import type { DevFrameProjectLoopTrace } from '@deepseek-ai/dsh-devframe-control-session/types'
+import { en } from '../src/client/locales.ts'
+import { ProjectLoopPanel } from '../src/client/ProjectLoopPanel.tsx'
+import type { ProjectAuthorityState } from '../src/client/authority.ts'
+
+const t = makeTranslate(en)
+const workspaceId = 'workspace-1' as WorkspaceId
+const workspaces: WorkspaceListState = {
+  items: [{
+    workspaceId,
+    path: 'C:/projects/one',
+    title: 'Project One',
+    sessionIds: [],
+    createdAt: '2026-08-15T00:00:00.000Z',
+    updatedAt: '2026-08-15T00:00:00.000Z',
+  }],
+  archivedSessionIds: [],
+  state: 'idle',
+  phase: 'ready',
+  error: null,
+  baselinesReady: true,
+  recentWorkspaceId: undefined,
+}
+
+function useWorkspaces<S>(selector: (state: WorkspaceListState) => S): S {
+  return selector(workspaces)
+}
+
+function useAuthority(state: ProjectAuthorityState) {
+  return <S,>(selector: (value: ProjectAuthorityState) => S): S => selector(state)
+}
+
+function trace(memoryStatus: DevFrameProjectLoopTrace['memoryStatus'] = 'captured'): DevFrameProjectLoopTrace {
+  return {
+    loopId: 'loop-1',
+    objectiveId: 'objective-1',
+    projectId: workspaceId,
+    projectSessionId: 'session-1' as SessionId,
+    goalId: 'goal-1',
+    revision: 1,
+    round: 1,
+    roundsCompleted: 1,
+    sessionId: 'session-1' as SessionId,
+    provider: 'test',
+    model: 'test-model',
+    outcome: 'completed',
+    review: 'pending',
+    memoryStatus,
+  }
+}
+
+describe('Project Loop panel', () => {
+  afterEach(() => { cleanup() })
+
+  it('submits one bounded Host loop with the selected native Workspace root', async () => {
+    const dispatch = vi.fn().mockResolvedValue(trace())
+    render(<ProjectLoopPanel
+      useWorkspaces={useWorkspaces}
+      useProjectAuthority={useAuthority({
+        [workspaceId]: { status: 'bound', workspaceId, profileId: 'profile-1' },
+      })}
+      dispatchProjectLoop={dispatch}
+      t={t}
+    />)
+
+    fireEvent.change(screen.getByLabelText('Objective'), { target: { value: '  inspect project  ' } })
+    fireEvent.click(screen.getByRole('button', { name: 'Run loop' }))
+    await vi.waitFor(() => {
+      expect(dispatch).toHaveBeenCalledWith(
+        workspaceId,
+        'C:/projects/one',
+        'inspect project',
+        expect.any(String),
+      )
+    })
+    expect(await screen.findByText('Project completed · Independent review pending · Memory checkpoint saved')).toBeTruthy()
+  })
+
+  it('keeps an unbound project fail-closed', () => {
+    const dispatch = vi.fn()
+    render(<ProjectLoopPanel
+      useWorkspaces={useWorkspaces}
+      useProjectAuthority={useAuthority({ [workspaceId]: { status: 'none' } })}
+      dispatchProjectLoop={dispatch}
+      t={t}
+    />)
+    fireEvent.change(screen.getByLabelText('Objective'), { target: { value: 'inspect' } })
+    expect(screen.getByRole('button', { name: 'Run loop' }).hasAttribute('disabled')).toBe(true)
+    expect(dispatch).not.toHaveBeenCalled()
+  })
+
+  it('keeps the loop disabled when the Host Remote capability is unavailable', () => {
+    const dispatch = vi.fn()
+    render(<ProjectLoopPanel
+      useWorkspaces={useWorkspaces}
+      useProjectAuthority={useAuthority({
+        [workspaceId]: { status: 'bound', workspaceId, profileId: 'profile-1' },
+      })}
+      dispatchProjectLoop={dispatch}
+      available={false}
+      t={t}
+    />)
+    fireEvent.change(screen.getByLabelText('Objective'), { target: { value: 'inspect' } })
+    expect(screen.getByRole('button', { name: 'Run loop' }).hasAttribute('disabled')).toBe(true)
+    expect(screen.getByText('The project loop is unavailable until the Host Remote is ready.')).toBeTruthy()
+    expect(dispatch).not.toHaveBeenCalled()
+  })
+
+  it('shows a generic retryable error when the Host loop rejects', async () => {
+    const dispatch = vi.fn().mockRejectedValue(new Error('private host detail'))
+    render(<ProjectLoopPanel
+      useWorkspaces={useWorkspaces}
+      useProjectAuthority={useAuthority({
+        [workspaceId]: { status: 'bound', workspaceId, profileId: 'profile-1' },
+      })}
+      dispatchProjectLoop={dispatch}
+      t={t}
+    />)
+    fireEvent.change(screen.getByLabelText('Objective'), { target: { value: 'inspect' } })
+    fireEvent.click(screen.getByRole('button', { name: 'Run loop' }))
+    expect((await screen.findByRole('alert')).textContent).toBe('The project loop failed. Try again.')
+    expect(screen.queryByText('private host detail')).toBeNull()
+  })
+})
