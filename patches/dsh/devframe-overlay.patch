diff --git a/packages/client/ui-devframe-control-session/src/client/GlobalPresetSelector.tsx b/packages/client/ui-devframe-control-session/src/client/GlobalPresetSelector.tsx
new file mode 100644
index 0000000000..88049095aa
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/GlobalPresetSelector.tsx
@@ -0,0 +1,117 @@
+import { useEffect, useState } from 'react'
+import type { SnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+import type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import { IconChevronDownOutline14, Menu } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { ControlSessionKey } from './locales.ts'
+import type { GlobalPresetError, GlobalPresetState } from './global-preset-store.ts'
+import css from './GlobalPresetSelector.module.css'
+
+/** Business face supplied by the Global Controller plugin registration. */
+export interface GlobalPresetSelectorInjected {
+  hooks: {
+    globalPresets: SnapshotStore<GlobalPresetState>
+  }
+  load: () => Promise<void>
+  select: (id: string) => Promise<boolean>
+}
+
+/** Props for the additive session-header action. */
+export type GlobalPresetSelectorProps =
+  PropsRuntime<'conversation.session.header.actions'>
+  & PropsLocale<'client-ui-devframe-control-session'>
+  & InjectFace<GlobalPresetSelectorInjected>
+
+function optionLabel(
+  option: GlobalPresetState['options'][number],
+  t: (key: ControlSessionKey) => string,
+): string {
+  const name = option.name ?? option.id
+  if (option.trust === 'user') return `${name} · ${t('global.preset.custom')}`
+  return name
+}
+
+function errorLabel(error: GlobalPresetError, t: (key: ControlSessionKey) => string): string {
+  return error.kind === 'roster'
+    ? t('global.preset.error.roster')
+    : t('global.preset.error.switch')
+}
+
+/** Render the Global-only interactive preset selector. */
+export function GlobalPresetSelector({
+  sessionId, useSessions, useGlobalPresets, load, select, t,
+}: GlobalPresetSelectorProps) {
+  const summary = useSessions(state => state.byId[sessionId])
+  const state = useGlobalPresets(snapshot => snapshot)
+  const [open, setOpen] = useState(false)
+  const isGlobal = summary?.devframeRole === 'global'
+  const selectedId = summary?.agentPreset
+  const running = summary?.running === true || summary?.pendingInteraction !== undefined
+  const busy = state.status === 'loading' || state.status === 'saving' || running
+  const retryableRosterFailure = state.status === 'error'
+    && state.error?.kind === 'roster'
+    && state.options.length === 0
+
+  useEffect(() => {
+    if (isGlobal) void load()
+  }, [isGlobal, load])
+
+  useEffect(() => {
+    if (!isGlobal || busy) setOpen(false)
+  }, [busy, isGlobal])
+
+  if (!isGlobal || selectedId === undefined) return null
+
+  const selected = state.options.find(option => option.id === selectedId)
+  const label = selected === undefined ? selectedId : optionLabel(selected, t)
+  const disabled = busy || (state.options.length === 0 && !retryableRosterFailure)
+  const items = state.options.map(option => ({
+    id: option.id,
+    label: option.broken === undefined
+      ? optionLabel(option, t)
+      : `${optionLabel(option, t)} · ${t('global.preset.broken')}`,
+    disabled: option.broken !== undefined,
+  }))
+
+  return (
+    <>
+      <Menu
+        open={open}
+        onClose={() => { setOpen(false) }}
+        items={items}
+        selectedId={selectedId}
+        onSelect={(id) => {
+          setOpen(false)
+          void select(id)
+        }}
+        align="end"
+        portal
+        anchor={(
+          <button
+            type="button"
+            className={css.selector}
+            aria-label={t('global.preset.select')}
+            aria-haspopup="menu"
+            aria-expanded={open}
+            disabled={disabled}
+            onClick={() => {
+              // Re-read on every open so a newly authored/deleted preset is
+              // never hidden behind the first mount's roster.
+              if (retryableRosterFailure) {
+                void load()
+                return
+              }
+              void load()
+              setOpen(value => !value)
+            }}
+          >
+            <span className={css.label}>{label}</span>
+            <IconChevronDownOutline14 className={css.chevron} />
+          </button>
+        )}
+      />
+      {state.error !== null && (
+        <span className={css.error} role="alert">{errorLabel(state.error, t)}</span>
+      )}
+    </>
+  )
+}
