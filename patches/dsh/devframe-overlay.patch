+/**
+ * Slice 0 Health checklist: every check reports a stable id with a tri-state
+ * verdict, pathless and credential-free. The checklist is the MVP READY
+ * surface — version, Host lease, event catalog, provider, project authority,
+ * memory, MCP, and write permissions.
+ */
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentDefaultModel from '@deepseek-ai/dsh-agent-default-model'
+import { DevFrameControlSessions } from '../src/index.ts'
+import { DSH_PROFILE_HOST_FENCE_KEY, type ProfileHostFence } from '../src/profile-fence.ts'
+
+const cleanups: Array<() => Promise<void>> = []
+
+afterEach(async () => {
+  for (const cleanup of cleanups.splice(0).reverse()) await cleanup()
+  vi.unstubAllEnvs()
+})
+
+async function boot(model?: { provider: string; model: string }): Promise<Context> {
+  const ctx = new Context()
+  // The service activation requires its injected seams; health reads only the
+  // fence, the model route, and the known event vocabulary, so minimal stubs
+  // suffice (mirrors the identity harness's provide-style boot).
+  ctx.provide('agents', { get: () => undefined } as never)
+  ctx.provide('sessions', { get: () => undefined, list: () => [] } as never)
+  ctx.provide('sessionPersistence', { list: () => Promise.resolve([]) } as never)
+  ctx.provide('workspaceRegistry', { get: () => undefined, list: () => [] } as never)
+  ctx.provide('tools', {} as never)
+  if (model !== undefined) {
+    await ctx.plugin(AgentDefaultModel, model)
+  }
+  await ctx.plugin(DevFrameControlSessions)
+  cleanups.push(async () => { await ctx.fiber.dispose() })
+  return ctx
+}
+
+function fence(): ProfileHostFence {
+  return { owner: { pid: 1, hostname: 'test', startedAt: '2026-01-01T00:00:00.000Z' } }
+}
+
+describe('Slice 0 Health checklist', () => {
+  it('reports every stable check id in order with pathless verdicts', async () => {
+    const ctx = await boot({ provider: 'p', model: 'm' })
+    const health = ctx.devframeControlSessions.healthSnapshot()
+    expect(health.items.map(item => item.id)).toEqual([
+      'dsh-version', 'host-lease', 'event-catalog', 'provider',
+      'project-authority', 'memory', 'mcp', 'write-permissions',
+    ])
+    expect(health.revision).toBeGreaterThan(0)
+    for (const item of health.items) {
+      expect(['ready', 'degraded', 'blocked']).toContain(item.status)
+      // Pathless: no backslash, no drive-letter or UNC prefix. Slice names
+      // like `1A/1C` are version tokens, not paths.
+      const text = JSON.stringify(item)
+      expect(text).not.toContain('\\')
+      expect(text).not.toMatch(/[A-Za-z]:[\\/]/u)
+      expect(text).not.toMatch(/^\/{2}/u)
+    }
+  })
+
+  it('ranks the version check ready with the running release', async () => {
+    const ctx = await boot()
+    const version = ctx.devframeControlSessions.healthSnapshot().items[0]
+    expect(version).toBeDefined()
+    expect(version).toMatchObject({ id: 'dsh-version', status: 'ready' })
+    expect(version?.reason).toMatch(/^dsh \d+\.\d+\.\d+/u)
+  })
+
+  it('ranks the Host lease degraded without a fence and ready with one', async () => {
+    const ctx = await boot()
+    const withoutFence = ctx.devframeControlSessions.healthSnapshot().items
+      .find(item => item.id === 'host-lease')
+    expect(withoutFence).toMatchObject({ id: 'host-lease', status: 'degraded' })
+
+    ctx.provide(DSH_PROFILE_HOST_FENCE_KEY, fence())
+    const withFence = ctx.devframeControlSessions.healthSnapshot().items
+      .find(item => item.id === 'host-lease')
+    expect(withFence).toMatchObject({ id: 'host-lease', status: 'ready' })
+  })
+
+  it('ranks the event catalog ready once controller/identity is in the known vocabulary', async () => {
+    const ctx = await boot()
+    const catalog = ctx.devframeControlSessions.healthSnapshot().items
+      .find(item => item.id === 'event-catalog')
+    expect(catalog).toMatchObject({ id: 'event-catalog', status: 'ready' })
+  })
+
+  it('ranks the provider check by the configured default model route', async () => {
+    const without = await boot()
+    expect(without.devframeControlSessions.healthSnapshot().items
+      .find(item => item.id === 'provider')).toMatchObject({ status: 'degraded' })
+
+    const withModel = await boot({ provider: 'deepseek-official', model: 'deepseek-v4-flash' })
+    expect(withModel.devframeControlSessions.healthSnapshot().items
+      .find(item => item.id === 'provider')).toMatchObject({ status: 'ready' })
+  })
+
+  it('ranks authority, memory, MCP, and write permissions by their slice stance', async () => {
+    const ctx = await boot()
+    const byId = Object.fromEntries(
+      ctx.devframeControlSessions.healthSnapshot().items.map(item => [item.id, item.status]),
+    )
+    expect(byId['project-authority']).toBe('blocked')
+    expect(byId['memory']).toBe('blocked')
+    expect(byId['mcp']).toBe('blocked')
+    // Slice 1A-D: project write dispatch is enabled once the authority and
+    // objective-routing gates exist, so the capability is no longer degraded.
+    expect(byId['write-permissions']).toBe('ready')
+  })
+
+  it('explains the authority stance with the bound-or-blocked reason', async () => {
+    const ctx = await boot()
+    const authority = ctx.devframeControlSessions.healthSnapshot().items
+      .find(item => item.id === 'project-authority')
+    // With no opened project controller the card is blocked; a bound project
+    // flips it ready (covered in authority.spec.ts with the real harness).
+    expect(authority).toMatchObject({
+      status: 'blocked',
+      reason: 'no bound project authority',
+      action: 'bind authority in the project controller',
+    })
+  })
+})
