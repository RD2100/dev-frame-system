+/**
+ * Data-only script for the direct-session architecture spike.
+ *
+ * The HTTP server remains the package's existing `startResponsesFixture`
+ * implementation. This module owns only the deterministic Responses script
+ * that makes the direct-session observations reproducible without network or
+ * credentials.
+ */
+
+/**
+ * Build the loopback Responses behaviours used by the architecture probe.
+ * @param {string} marker - random marker returned by the first two turns.
+ * @param {string} sideEffectPath - path a declined command must not create.
+ * @returns {readonly object[]} Responses fixture behaviours.
+ */
+export function directSessionResponsesPlan(marker, sideEffectPath) {
+  return [
+    { kind: 'complete', text: marker },
+    { kind: 'complete', text: marker },
+    {
+      kind: 'advertisedFunctionCall',
+      choices: [
+        {
+          name: 'exec_command',
+          arguments: {
+            cmd: process.platform === 'win32'
+              ? `cmd /c type nul > "${sideEffectPath}"`
+              : `touch "${sideEffectPath}"`,
+            sandbox_permissions: 'require_escalated',
+            justification: 'direct-session approval probe',
+          },
+        },
+        {
+          name: 'shell_command',
+          arguments: {
+            command: process.platform === 'win32'
+              ? `cmd /c type nul > "${sideEffectPath}"`
+              : `touch "${sideEffectPath}"`,
+            sandbox_permissions: 'require_escalated',
+            justification: 'direct-session approval probe',
+          },
+        },
+      ],
+    },
+    { kind: 'hold' },
+  ]
+}
+
