+
+    expect(opened.agent.session.events.length).toBe(eventsBefore)
+    expect(opened.agent.session.events
+      .filter(event => event.type === PROJECT_AUTHORITY_EVENT_TYPE)).toHaveLength(1)
+    // No append, no flush on the CAS miss.
+    expect(test.flush.mock.calls.length).toBe(flushesBefore)
+    // The correct expected revision still succeeds.
+    const rebound = await test.controller.bindProjectAuthority({
+      profileId: 'profile-1',
+      workspaceId: 'workspace-1',
+      expectedBoundRevision: 1,
