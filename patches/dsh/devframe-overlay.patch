+import { afterEach, describe, expect, it } from 'vitest'
+import { fileURLToPath } from 'node:url'
+import { Context } from '@deepseek-ai/cordis'
+import { boot } from '@deepseek-ai/dsh-app-boot'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { CallId } from '@deepseek-ai/dsh-llm'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { type ToolExecutionResult } from '@deepseek-ai/dsh-tools'
+import * as projectContext from '../src/project-context.ts'
+
+const active: Context[] = []
+
+afterEach(async () => {
+  for (const ctx of active.splice(0)) await ctx.fiber.dispose()
+})
+
+function agent(ctx: Context, cwd?: string): Agent {
+  void ctx
+  const session = {
+    id: SessionId(`project-context-${Math.random()}`),
+    header: {
+      ...cwd === undefined ? {} : { cwd },
+    },
+  }
+  return { id: session.id, session } as unknown as Agent
+}
+
+function health() {
+  return {
+    revision: 4,
+    items: [
+      { id: 'provider', status: 'ready' as const },
+      { id: 'mcp', status: 'blocked' as const, reason: 'external-brain MCP is not configured', action: 'Slice 0R' },
+    ],
+  }
+}
+
+function readiness() {
+  return { status: 'ready' as const, generation: 2, revision: 3, sessionId: 'controller-session' }
+}
+
+async function mount(options: {
+  cwd?: string
+  workspace?: { id: string; path: string; title: string } | undefined
+  registryError?: Error
+  includeControlSessions?: boolean
+} = {}) {
+  const ctx = new Context()
+  active.push(ctx)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  if (options.includeControlSessions !== false) {
+    ctx.provide('devframeControlSessions', {
+      readinessSnapshot: readiness,
+      healthSnapshot: health,
+    })
+  }
+  ctx.provide('workspaceRegistry', {
+    resolveByPath: async () => {
+      if (options.registryError !== undefined) throw options.registryError
+      return options.workspace
+    },
+  })
+  const fiber = await ctx.plugin(projectContext)
+  return { ctx, fiber, caller: agent(ctx, options.cwd) }
+}
+
+async function call(ctx: Context, caller: Agent): Promise<ToolExecutionResult> {
+  return ctx.tools.execute({
+    name: 'devframe_project_context',
+    arguments: {},
+    callId: CallId(`call-${Math.random()}`),
+    signal: new AbortController().signal,
+    agent: caller,
+  })
+}
+
+function value(result: ToolExecutionResult): Record<string, unknown> {
+  expect(result.isError).toBe(false)
+  if (result.isError) throw new Error('expected successful tool result')
+  const block = result.content[0]
+  if (block?.type !== 'text') throw new Error('expected text result')
+  return JSON.parse(block.text) as Record<string, unknown>
+}
+
+describe('DevFrame project context tool', () => {
+  it('registers one read-only tool and bounded guidance, then disposes it', async () => {
+    const mounted = await mount()
+    expect(mounted.ctx.tools.schemas().map(schema => schema.name)).toContain('devframe_project_context')
+    expect(mounted.ctx.tools.get('devframe_project_context')?.presentCall?.({})).toEqual({
+      card: 'generic', title: 'Read DevFrame project context', kind: 'read',
+    })
+    const section = (await mounted.ctx.systemPrompt.assemble()).sections.find(
+      item => item.name === 'tool:devframe-project-context',
+    )
+    expect(section?.text).toContain('read-only')
+    expect(section?.text).toContain('does not inspect files')
+
+    await mounted.fiber.dispose()
+    expect(mounted.ctx.tools.get('devframe_project_context')).toBeUndefined()
+    expect((await mounted.ctx.systemPrompt.assemble()).sections.some(
+      item => item.name === 'tool:devframe-project-context',
+    )).toBe(false)
+  })
+
+  it('matches the active registered workspace and returns only pathless projections', async () => {
+    const mounted = await mount({
+      cwd: 'C:\\work\\dev-frame-system',
+      workspace: { id: 'workspace-1', path: 'C:\\work\\dev-frame-system', title: 'dev-frame-system' },
+    })
+    const result = await call(mounted.ctx, mounted.caller)
+    expect(value(result)).toEqual({
+      status: 'matched',
+      workspace: { id: 'workspace-1', title: 'dev-frame-system' },
+      readiness: { status: 'ready', generation: 2, revision: 3 },
+      health: health(),
+    })
+    expect(JSON.stringify(result)).not.toContain('C:\\work\\dev-frame-system')
+  })
+
+  it('reports an unbound project when cwd is missing or not registered', async () => {
+    const noCwd = await mount()
+    expect(value(await call(noCwd.ctx, noCwd.caller))).toMatchObject({
+      status: 'unbound', workspace: null,
+    })
+
+    const foreign = await mount({ cwd: 'C:\\other', workspace: undefined })
+    expect(value(await call(foreign.ctx, foreign.caller))).toMatchObject({
+      status: 'unbound', workspace: null,
+    })
+  })
+
+  it('fails closed for missing services and registry failures without raw details', async () => {
+    const missing = await mount({ includeControlSessions: false, cwd: 'C:\\private\\project' })
+    const missingValue = value(await call(missing.ctx, missing.caller))
+    expect(missingValue).toMatchObject({ status: 'unavailable', workspace: null })
+    expect(JSON.stringify(missingValue)).not.toContain('private')
+
+    const failure = await mount({
+      cwd: 'C:\\private\\project',
+      registryError: new Error('permission denied: C:\\private\\project'),
+    })
+    const failureValue = value(await call(failure.ctx, failure.caller))
+    expect(failureValue).toMatchObject({ status: 'unavailable', workspace: null })
+    expect(JSON.stringify(failureValue)).not.toContain('permission')
+    expect(JSON.stringify(failureValue)).not.toContain('private')
+  })
+
+  it('is reachable through a real Loader composition with only the DevFrame row', async () => {
+    const baseConfig = fileURLToPath(new URL('../../../../apps/cli/tests/fixtures/memory-mcp-base.cordis.yml', import.meta.url))
+    const ctx = await boot(
+      'devframe-project-context-composition-test',
+      baseConfig,
+      [{ insert: [{ id: 'devframe-project-context', name: '@deepseek-ai/dsh-devframe/project-context' }] }],
+      (root) => {
+        root.loader.builtins['memory-test-system-prompt'] = SystemPrompt
+        root.loader.builtins['memory-test-tools'] = ToolRuntime
+        root.provide('devframeControlSessions', {
+          readinessSnapshot: readiness,
+          healthSnapshot: health,
+        })
+        root.provide('workspaceRegistry', {
+          resolveByPath: async (cwd: string) => ({ id: 'workspace-1', path: cwd, title: 'dev-frame-system' }),
