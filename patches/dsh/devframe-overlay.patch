+/**
+ * Model-facing, read-only CodeGraph context for the active DSH project.
+ *
+ * The caller deliberately owns neither a project selector nor an index. It
+ * derives the project from the active Agent session, performs a bounded
+ * status preflight, and invokes only CodeGraph's no-code JSON context command.
+ * Every returned node remains an untrusted context candidate.
+ * @module @deepseek-ai/dsh-devframe/codegraph-context
+ */
+
+import { dirname, isAbsolute, join, relative, sep } from 'node:path'
+import type { Context } from '@deepseek-ai/cordis'
+import { defineTool } from '@deepseek-ai/dsh-tools'
+import type { SubprocessHandle, SubprocessRuntime } from '@deepseek-ai/dsh-subprocess'
+import type { Workspace } from '@deepseek-ai/dsh-workspace'
+
+/** Cordis plugin name used by Loader diagnostics. */
+export const name = 'devframe-codegraph-context'
+
+/** Services needed to register the tool; workspace and subprocess are optional at call time. */
+export const inject = ['tools', 'systemPrompt']
+
+const MAX_TASK_LENGTH = 512
+const MAX_LABEL_LENGTH = 256
+const MAX_PATH_LENGTH = 512
+const MAX_OUTPUT_BYTES = 512_000
+const MAX_STATUS_OUTPUT_BYTES = 32_000
+const MAX_NODES = 64
+const MAX_EDGES = 128
+const MAX_RELATED_FILES = 64
+const MAX_STATS = 10_000_000
+const QUERY_TIMEOUT_MS = 15_000
+const PROCESS_GRACE_MS = 1_000
+
+const SAFE_ID = /^[A-Za-z0-9][-A-Za-z0-9._:]{0,127}$/
+const SAFE_RELATION = new Set([
+  'calls', 'contains', 'imports', 'implements', 'tests', 'depends_on',
+  'references', 'derived_from', 'uses', 'extends', 'inherits',
+])
+const SAFE_KIND = new Set([
+  'file', 'class', 'function', 'method', 'variable', 'constant', 'import',
+  'module', 'symbol',
+])
+const SENSITIVE = /(?:api[-_]?key|authorization|bearer|cookie|password|secret|token)|sk-(?:[A-Z]|[0-9]|_|-){12,}/i
+
+type ProjectStatus = 'matched' | 'unbound' | 'unavailable'
+type Freshness = 'current' | 'stale' | 'missing' | 'unknown'
+type ErrorCode =
+  | 'project_unbound'
+  | 'service_unavailable'
+  | 'executable_unavailable'
+  | 'status_failed'
+  | 'status_invalid'
+  | 'context_failed'
+  | 'context_invalid'
+  | 'timed_out'
+  | 'aborted'
+
+interface GraphNode {
+  readonly id: string
+  readonly kind: string
+  readonly label?: string
+  readonly source?: string
+  readonly startLine?: number
+  readonly endLine?: number
+}
+
+interface GraphEdge {
+  readonly id: string
+  readonly source: string
+  readonly target: string
+  readonly kind: string
+}
+
+interface GraphContextValue {
+  readonly status: ProjectStatus
+  readonly workspace: { readonly id: string; readonly title: string } | null
+  readonly freshness: Freshness
+  readonly trustedForCurrentRun: false
+  readonly summary: string | null
+  readonly nodes: GraphNode[]
+  readonly edges: GraphEdge[]
+  readonly relatedFiles: string[]
+  readonly stats: {
+    readonly nodeCount: number
+    readonly edgeCount: number
+    readonly fileCount: number
+    readonly truncated: boolean
+  }
+  readonly error?: ErrorCode
+}
+
+interface WorkspaceRegistryLike {
+  resolveByPath(path: string): Promise<Workspace | undefined>
+}
+
+interface ToolExecutionLike {
+  readonly signal: AbortSignal
+  readonly agent?: { readonly session: { readonly header: { readonly cwd?: string } } }
+}
+
+interface JsonObject {
+  readonly [key: string]: unknown
+}
+
+const OUTPUT = {
+  schema: {
+    type: 'object' as const,
+    additionalProperties: false,
+    properties: {
+      status: { type: 'string' as const, required: true, enum: ['matched', 'unbound', 'unavailable'] },
+      workspace: {
+        required: true,
+        oneOf: [
+          {
+            type: 'object' as const,
+            additionalProperties: false,
+            properties: {
+              id: { type: 'string' as const, required: true },
+              title: { type: 'string' as const, required: true },
+            },
+          },
+          { type: 'null' as const },
+        ],
+      },
+      freshness: {
+        type: 'string' as const,
+        required: true,
+        enum: ['current', 'stale', 'missing', 'unknown'],
+      },
+      trustedForCurrentRun: { type: 'boolean' as const, required: true },
+      summary: {
+        oneOf: [
+          { type: 'string' as const },
+          { type: 'null' as const },
+        ],
+      },
+      nodes: {
+        type: 'array' as const,
+        required: true,
+        items: {
+          type: 'object' as const,
+          additionalProperties: false,
+          properties: {
+            id: { type: 'string' as const, required: true },
+            kind: { type: 'string' as const, required: true },
+            label: { type: 'string' as const },
+            source: { type: 'string' as const },
+            startLine: { type: 'integer' as const },
+            endLine: { type: 'integer' as const },
+          },
+        },
+      },
+      edges: {
+        type: 'array' as const,
+        required: true,
+        items: {
+          type: 'object' as const,
+          additionalProperties: false,
+          properties: {
+            id: { type: 'string' as const, required: true },
+            source: { type: 'string' as const, required: true },
+            target: { type: 'string' as const, required: true },
+            kind: { type: 'string' as const, required: true },
+          },
+        },
+      },
+      relatedFiles: {
+        type: 'array' as const,
+        required: true,
+        items: { type: 'string' as const },
+      },
+      stats: {
+        type: 'object' as const,
+        additionalProperties: false,
+        required: true,
+        properties: {
+          nodeCount: { type: 'integer' as const, required: true },
+          edgeCount: { type: 'integer' as const, required: true },
+          fileCount: { type: 'integer' as const, required: true },
+          truncated: { type: 'boolean' as const, required: true },
+        },
+      },
+      error: {
+        type: 'string' as const,
+        enum: [
+          'project_unbound', 'service_unavailable', 'executable_unavailable',
+          'status_failed', 'status_invalid', 'context_failed',
+          'context_invalid', 'timed_out', 'aborted',
+        ],
+      },
+    },
+  },
+  render: (_args: unknown, value: GraphContextValue) => [{
+    type: 'text' as const,
+    text: JSON.stringify(value),
+  }],
+} as const
+
+function emptyStats(): GraphContextValue['stats'] {
+  return { nodeCount: 0, edgeCount: 0, fileCount: 0, truncated: false }
+}
+
+function result(
+  status: ProjectStatus,
+  workspace: GraphContextValue['workspace'],
+  freshness: Freshness,
+  error?: ErrorCode,
+): GraphContextValue {
+  return {
+    status,
+    workspace,
+    freshness,
+    trustedForCurrentRun: false,
+    summary: null,
+    nodes: [],
+    edges: [],
+    relatedFiles: [],
+    stats: emptyStats(),
+    ...(error === undefined ? {} : { error }),
+  }
+}
+
+function object(value: unknown): JsonObject | undefined {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return undefined
+  return value as JsonObject
+}
+
+function boundedText(value: unknown, max: number): string | undefined {
+  if (typeof value !== 'string' || value.length === 0 || value.length > max) return undefined
+  for (const char of value) {
+    if (ord(char) < 32) return undefined
+  }
+  if (SENSITIVE.test(value)) return undefined
+  return value
+}
+
+function ord(char: string): number {
+  return char.codePointAt(0) ?? 0
+}
+
+function boundedInteger(value: unknown, max = MAX_STATS): number | undefined {
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 0 || value > max) return undefined
+  return value
+}
+
+function safeId(value: unknown): string | undefined {
+  return typeof value === 'string' && SAFE_ID.test(value) ? value : undefined
+}
+
+function safeRelativePath(value: unknown, cwd: string): string | undefined {
+  if (typeof value !== 'string' || value.length === 0 || value.length > MAX_PATH_LENGTH) return undefined
+  let candidate = value
+  if (isAbsolute(candidate)) {
+    const rel = relative(cwd, candidate)
+    if (rel === '' || rel === '..' || rel.startsWith(`..${sep}`) || isAbsolute(rel)) return undefined
+    candidate = rel
+  }
+  if (candidate.startsWith('/') || candidate.startsWith('\\') || /^[A-Za-z]:/.test(candidate)) return undefined
+  if (candidate.includes('\\')) return undefined
+  if (candidate.split('/').some(part => part === '.' || part === '..' || part === '')) return undefined
+  return candidate
+}
+
+function safeWorkspace(workspace: Workspace): { id: string; title: string } | undefined {
+  const id = boundedText(String(workspace.id), MAX_LABEL_LENGTH)
+  const title = boundedText(workspace.title, MAX_LABEL_LENGTH)
+  return id === undefined || title === undefined ? undefined : { id, title }
+}
+
+function executableName(): string {
+  return process.platform === 'win32' ? 'codegraph.cmd' : 'codegraph'
+}
+
+function parseStatus(text: string): { freshness: Freshness; initialized: boolean } | undefined {
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(text)
+  } catch {
+    return undefined
+  }
+  const data = object(parsed)
+  if (data === undefined || typeof data.initialized !== 'boolean') return undefined
+  if (!data.initialized) return { freshness: 'missing', initialized: false }
+  const pending = object(data.pendingChanges)
+  if (pending === undefined) return { freshness: 'unknown', initialized: true }
+  const values = ['added', 'modified', 'removed'].map(key => boundedInteger(pending[key]))
+  if (values.some(value => value === undefined)) return undefined
+  return {
+    freshness: values.some(value => value !== 0) ? 'stale' : 'current',
+    initialized: true,
+  }
+}
+
+function parseContext(text: string, cwd: string): Omit<GraphContextValue, 'status' | 'workspace' | 'freshness' | 'trustedForCurrentRun' | 'error'> | undefined {
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(text)
+  } catch {
+    return undefined
+  }
+  const data = object(parsed)
+  if (data === undefined) return undefined
+  if (data.codeBlocks !== undefined && (!Array.isArray(data.codeBlocks) || data.codeBlocks.length !== 0)) return undefined
+  if (!Array.isArray(data.nodes) || data.nodes.length > MAX_NODES) return undefined
+  if (!Array.isArray(data.edges) || data.edges.length > MAX_EDGES) return undefined
+  if (!Array.isArray(data.relatedFiles) || data.relatedFiles.length > MAX_RELATED_FILES) return undefined
+
+  const nodes: GraphNode[] = []
+  const nodeIds = new Set<string>()
+  for (const raw of data.nodes) {
+    const node = object(raw)
+    if (node === undefined) return undefined
+    const id = safeId(node.id)
+    const kind = typeof node.kind === 'string' && SAFE_KIND.has(node.kind) ? node.kind : undefined
+    if (id === undefined || kind === undefined || nodeIds.has(id)) return undefined
+    const labelValue = node.name ?? node.qualifiedName
+    const label = labelValue === undefined ? undefined : boundedText(labelValue, MAX_LABEL_LENGTH)
+    if (labelValue !== undefined && label === undefined) return undefined
+    const sourceValue = node.filePath
+    const source = sourceValue === undefined || sourceValue === null
+      ? undefined
+      : safeRelativePath(sourceValue, cwd)
+    if (sourceValue !== undefined && sourceValue !== null && source === undefined) return undefined
+    const startLine = node.startLine === undefined || node.startLine === null ? undefined : boundedInteger(node.startLine, 10_000_000)
+    const endLine = node.endLine === undefined || node.endLine === null ? undefined : boundedInteger(node.endLine, 10_000_000)
+    if ((node.startLine !== undefined && node.startLine !== null && startLine === undefined)
+      || (node.endLine !== undefined && node.endLine !== null && endLine === undefined)) return undefined
+    nodeIds.add(id)
+    nodes.push({
+      id,
+      kind,
+      ...(label === undefined ? {} : { label }),
+      ...(source === undefined ? {} : { source }),
+      ...(startLine === undefined ? {} : { startLine }),
+      ...(endLine === undefined ? {} : { endLine }),
+    })
+  }
+
+  const edges: GraphEdge[] = []
+  const edgeIds = new Set<string>()
+  for (let index = 0; index < data.edges.length; index += 1) {
+    const edge = object(data.edges[index])
+    if (edge === undefined) return undefined
+    const source = safeId(edge.source)
+    const target = safeId(edge.target)
+    const kind = typeof edge.kind === 'string' && SAFE_RELATION.has(edge.kind) ? edge.kind : undefined
+    const id = edge.id === undefined || edge.id === null ? `edge-${index}` : safeId(edge.id)
+    if (id === undefined || source === undefined || target === undefined || kind === undefined
+      || !nodeIds.has(source) || !nodeIds.has(target) || edgeIds.has(id)) return undefined
+    edgeIds.add(id)
+    edges.push({ id, source, target, kind })
+  }
+
+  const relatedFiles: string[] = []
+  const relatedSet = new Set<string>()
+  for (const raw of data.relatedFiles) {
+    const file = safeRelativePath(raw, cwd)
+    if (file === undefined || relatedSet.has(file)) return undefined
+    relatedSet.add(file)
+    relatedFiles.push(file)
+  }
+  const summaryValue = data.summary
+  let summary: string | null
+  if (summaryValue === undefined || summaryValue === null) {
+    summary = null
+  } else {
+    const boundedSummary = boundedText(summaryValue, MAX_LABEL_LENGTH)
+    if (boundedSummary === undefined) return undefined
+    summary = boundedSummary
+  }
+  const statsRaw = object(data.stats)
+  const stats = statsRaw === undefined
+    ? { nodeCount: nodes.length, edgeCount: edges.length, fileCount: relatedFiles.length, truncated: false }
+    : {
+      nodeCount: boundedInteger(statsRaw.nodeCount) ?? nodes.length,
+      edgeCount: boundedInteger(statsRaw.edgeCount) ?? edges.length,
+      fileCount: boundedInteger(statsRaw.fileCount) ?? relatedFiles.length,
+      truncated: statsRaw.truncated === true,
+    }
+  return { summary, nodes, edges, relatedFiles, stats }
+}
+
+function classifyAbort(parent: AbortSignal, timedOut: boolean): ErrorCode {
+  if (parent.aborted) return 'aborted'
+  return timedOut ? 'timed_out' : 'context_failed'
+}
+
+interface CommandOutput {
+  readonly text: string
+  readonly failure?: ErrorCode
+}
+
+interface CommandPlan {
+  readonly executable: string
+  readonly argvPrefix: readonly string[]
+}
+
+/**
+ * Resolve CodeGraph's fixed launcher without asking the subprocess layer to
+ * execute a Windows .cmd file. Node 24 rejects direct .cmd spawn with EINVAL;
+ * CodeGraph's own npm shim documents the same no-shell workaround.
+ */
+async function resolveCommandPlan(
+  subprocess: { resolveExecutable(command: string, env?: Readonly<Record<string, string>>, signal?: AbortSignal): Promise<string> },
+  signal: AbortSignal,
+): Promise<CommandPlan> {
+  const launcher = await subprocess.resolveExecutable(executableName(), undefined, signal)
+  if (process.platform !== 'win32') return { executable: launcher, argvPrefix: [launcher] }
+  const node = await subprocess.resolveExecutable('node.exe', undefined, signal)
+  const shim = join(dirname(launcher), 'node_modules', '@colbymchenry', 'codegraph', 'npm-shim.js')
+  return { executable: node, argvPrefix: [node, shim] }
+}
+
+async function runCommand(
+  subprocess: SubprocessRuntime,
+  argv: readonly string[],
+  cwd: string,
+  parentSignal: AbortSignal,
+  maxBytes: number,
+): Promise<CommandOutput> {
+  if (parentSignal.aborted) return { text: '', failure: 'aborted' }
+  const controller = new AbortController()
+  let timedOut = false
+  const timer = setTimeout(() => {
+    timedOut = true
+    controller.abort()
+  }, QUERY_TIMEOUT_MS)
+  const onAbort = (): void => { controller.abort() }
+  parentSignal.addEventListener('abort', onAbort, { once: true })
+  let handle: SubprocessHandle | undefined
+  try {
+    handle = subprocess.spawn({
+      argv,
+      cwd,
+      stdio: {
+        stdin: 'ignore',
+        stdout: { maxBytes },
+        stderr: { maxBytes: 16_384 },
+      },
+      graceMs: PROCESS_GRACE_MS,
+      signal: controller.signal,
+    })
+    const outcome = await handle.done
+    const joined = await handle.waitForExit(AbortSignal.timeout(PROCESS_GRACE_MS))
+    if (!joined) {
+      handle.terminate()
+      return { text: '', failure: 'context_failed' }
+    }
+    if (outcome.signal !== null || outcome.exitCode !== 0) {
+      return { text: '', failure: 'context_failed' }
+    }
+    const output = handle.collected.stdout?.readFrom(0)
+    if (output === undefined || output.lossy || output.text.length > maxBytes) {
+      return { text: '', failure: 'context_invalid' }
+    }
+    return { text: output.text }
+  } catch {
+    if (handle !== undefined) handle.terminate()
+    return { text: '', failure: classifyAbort(parentSignal, timedOut) }
+  } finally {
+    clearTimeout(timer)
+    parentSignal.removeEventListener('abort', onAbort)
+  }
+}
+
+/** Execute one bounded CodeGraph observation for the active Agent project. */
+export async function readCodeGraphContext(
+  ctx: Context,
+  exec: ToolExecutionLike,
+  args: { task: string; max_nodes?: number },
+): Promise<GraphContextValue> {
+  const cwd = exec.agent?.session.header.cwd
+  if (cwd === undefined || cwd.trim() === '' || !isAbsolute(cwd)) {
+    return result('unbound', null, 'unknown', 'project_unbound')
+  }
+  const registry = ctx.get('workspaceRegistry') as WorkspaceRegistryLike | undefined
+  if (registry === undefined) return result('unavailable', null, 'unknown', 'service_unavailable')
+  let registered: Workspace | undefined
+  try {
+    registered = await registry.resolveByPath(cwd)
+  } catch {
+    return result('unavailable', null, 'unknown', 'service_unavailable')
+  }
+  if (registered === undefined) return result('unbound', null, 'unknown', 'project_unbound')
+  const workspace = safeWorkspace(registered)
+  if (workspace === undefined) return result('unavailable', null, 'unknown', 'service_unavailable')
+
+  const task = boundedText(args.task, MAX_TASK_LENGTH)
+  if (task === undefined || task.startsWith('-')) return result('unavailable', workspace, 'unknown', 'context_invalid')
+  const maxNodes = args.max_nodes ?? 32
+  if (!Number.isSafeInteger(maxNodes) || maxNodes < 1 || maxNodes > MAX_NODES) {
+    return result('unavailable', workspace, 'unknown', 'context_invalid')
+  }
+  const subprocess = ctx.get('subprocess')
+  if (subprocess === undefined) return result('unavailable', workspace, 'unknown', 'service_unavailable')
+  let commandPlan: CommandPlan
+  try {
+    commandPlan = await resolveCommandPlan(subprocess, exec.signal)
+  } catch {
+    return result('unavailable', workspace, 'unknown', exec.signal.aborted ? 'aborted' : 'executable_unavailable')
+  }
+
+  const statusOutput = await runCommand(
+    subprocess,
+    [...commandPlan.argvPrefix, 'status', '--json', cwd],
+    cwd,
+    exec.signal,
+    MAX_STATUS_OUTPUT_BYTES,
+  )
+  if (statusOutput.failure !== undefined) return result('unavailable', workspace, 'unknown', statusOutput.failure === 'context_failed' ? 'status_failed' : statusOutput.failure)
+  const status = parseStatus(statusOutput.text)
+  if (status === undefined) return result('unavailable', workspace, 'unknown', 'status_invalid')
+  if (!status.initialized) return result('unavailable', workspace, 'missing', 'status_failed')
+
+  const contextOutput = await runCommand(
+    subprocess,
+    [...commandPlan.argvPrefix, 'context', '--format', 'json', '--max-nodes', String(maxNodes), '--no-code', '--path', cwd, task],
+    cwd,
+    exec.signal,
+    MAX_OUTPUT_BYTES,
+  )
+  if (contextOutput.failure !== undefined) return result('unavailable', workspace, status.freshness, contextOutput.failure)
+  const parsed = parseContext(contextOutput.text, cwd)
+  if (parsed === undefined) return result('unavailable', workspace, status.freshness, 'context_invalid')
+  return {
+    status: 'matched',
+    workspace,
+    freshness: status.freshness,
+    trustedForCurrentRun: false,
+    ...parsed,
+  }
+}
+
+/** Register the explicit, bounded, read-only CodeGraph context tool. */
+export function apply(ctx: Context): void {
+  ctx.systemPrompt.section({
+    name: 'tool:devframe-codegraph-context',
+    order: 113,
+    text: 'Use devframe_codegraph_context only when structural repository context is needed. '
+      + 'It is read-only, bound to the active DSH project, status-preflighted, no-code, bounded, '
+      + 'and untrusted; it never initializes or refreshes CodeGraph, dispatches tasks, approves work, '
+      + 'writes memory/project state, or replaces native file/read tools.',
+  })
+  ctx.tools.register(defineTool({
+    name: 'devframe_codegraph_context',
+    description: 'Read bounded, no-code CodeGraph context for the active DSH project. '
+      + 'The task is the only required input; the project path and executable are derived by the host. '
+      + 'Results are stale/untrusted context candidates and never start or modify work.',
+    parameters: {
+      task: { type: 'string', required: true, description: 'A bounded structural question about the current project.' },
+      max_nodes: { type: 'integer', description: 'Maximum nodes to return (1-64; defaults to 32).' },
+    },
+    output: OUTPUT,
+    timeoutMs: QUERY_TIMEOUT_MS,
+    isConcurrencySafe: () => true,
+    execute: (args, exec) => readCodeGraphContext(ctx, exec, args),
+    presentCall: () => ({ card: 'generic', title: 'Read CodeGraph context', kind: 'read' }),
+  }))
+}
