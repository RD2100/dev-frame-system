diff --git a/packages/client/ui-tool/src/client/tool/graph/GraphContextBlock.tsx b/packages/client/ui-tool/src/client/tool/graph/GraphContextBlock.tsx
new file mode 100644
index 0000000000..db81acbd76
--- /dev/null
+++ b/packages/client/ui-tool/src/client/tool/graph/GraphContextBlock.tsx
@@ -0,0 +1,172 @@
+/** Read-only CodeGraph context preview for the selected Tool details panel. */
+import { useEffect, useMemo, useRef, useState } from 'react'
+import cytoscape from 'cytoscape'
+import type { ToolDetailsProps } from '../../contract/slots.ts'
+import type { GraphContextModel, GraphNode } from './graph-context-model.ts'
+import css from './GraphContextBlock.module.css'
+
+type Translate = ToolDetailsProps['t']
+
+interface GraphContextBlockProps {
+  readonly model: GraphContextModel
+  readonly t: Translate
+}
+
+interface CytoscapeSelection {
+  select: () => void
+}
+
+interface CytoscapeHandle {
+  getElementById: (id: string) => CytoscapeSelection
+}
+
+function lineRange(node: GraphNode): string | undefined {
+  if (node.startLine === undefined && node.endLine === undefined) return undefined
+  if (node.startLine !== undefined && node.endLine !== undefined) return `${node.startLine}–${node.endLine}`
+  return String(node.startLine ?? node.endLine)
+}
+
+/** Render the model-facing CodeGraph result without exposing raw wire text. */
+export function GraphContextBlock({ model, t }: GraphContextBlockProps) {
+  const containerRef = useRef<HTMLDivElement>(null)
+  const cyRef = useRef<CytoscapeHandle | null>(null)
+  const [kindFilter, setKindFilter] = useState('all')
+  const [selectedId, setSelectedId] = useState<string | null>(null)
+  const [rendererUnavailable, setRendererUnavailable] = useState(false)
+
+  const value = model.state === 'ready' ? model.value : null
+  const kinds = useMemo(() => value === null
+    ? []
+    : [...new Set(value.nodes.map(node => node.kind))].sort(), [value])
+  const visibleNodes = useMemo(() => value === null || kindFilter === 'all'
+    ? value?.nodes ?? []
+    : value.nodes.filter(node => node.kind === kindFilter), [kindFilter, value])
+  const visibleIds = useMemo(() => new Set(visibleNodes.map(node => node.id)), [visibleNodes])
+  const visibleEdges = useMemo(() => value?.edges.filter(edge => visibleIds.has(edge.source) && visibleIds.has(edge.target)) ?? [], [value, visibleIds])
+  const selected = selectedId === null ? undefined : visibleNodes.find(node => node.id === selectedId)
+
+  useEffect(() => {
+    if (value === null || containerRef.current === null) return undefined
+    const elements = [
+      ...visibleNodes.map((node, index) => ({
+        data: { id: node.id, label: node.label ?? node.id },
+        position: { x: 90 + (index % 4) * 150, y: 60 + Math.floor(index / 4) * 90 },
+      })),
+      ...visibleEdges.map(edge => ({
+        data: { id: edge.id, source: edge.source, target: edge.target, label: edge.kind },
+      })),
+    ]
+    try {
+      const instance = cytoscape({
+        container: containerRef.current,
+        elements,
+        layout: { name: 'preset', fit: true, padding: 20 },
+        minZoom: 0.35,
+        maxZoom: 2.5,
+        style: [
+          { selector: 'node', style: {
+            'background-color': '#5b8def',
+            color: '#182230',
+            label: 'data(label)',
+            'font-size': '10px',
+            'text-wrap': 'ellipsis',
+            'text-max-width': '120px',
+            'text-valign': 'center',
+            'text-halign': 'center',
+            width: '30px',
+            height: '30px',
+            'border-width': 1,
+            'border-color': '#2f5fac',
+          } },
+          { selector: 'edge', style: {
+            width: 1.5,
+            'line-color': '#9aa7bb',
+            'target-arrow-color': '#9aa7bb',
+            'target-arrow-shape': 'triangle',
+            'curve-style': 'bezier',
+          } },
+          { selector: ':selected', style: { 'overlay-color': '#2f5fac', 'overlay-opacity': 0.16 } },
+        ],
+      })
+      setRendererUnavailable(false)
+      cyRef.current = instance
+      instance.on('select', 'node', event => { setSelectedId(event.target.id()) })
+      return () => {
+        instance.destroy()
+        if (cyRef.current === instance) cyRef.current = null
+      }
+    } catch {
+      // A non-canvas test environment can still use the accessible node list.
+      setRendererUnavailable(true)
+      return undefined
+    }
+  }, [value, visibleEdges, visibleNodes])
+
+  if (model.state === 'running') {
+    return <div className={css.message} role="status">{t('graph.running')}</div>
+  }
+  if (model.state === 'unavailable') {
+    return <div className={css.message} role="status" data-graph-state="unavailable">{t('graph.unavailable')}</div>
+  }
+
+  const { stats, workspace } = model.value
+  return (
+    <div className={css.root} data-graph-state="ready">
+      <div className={css.heading}>
+        <div className={css.title}>{t('graph.title')}</div>
+        <span className={css.badge}>{t('graph.untrusted')}</span>
+      </div>
+      <dl className={css.meta}>
+        <div><dt>{t('graph.workspace')}</dt><dd>{workspace?.title ?? '—'}</dd></div>
+        <div><dt>{t('graph.freshness')}</dt><dd>{model.value.freshness}</dd></div>
+        <div><dt>{t('graph.nodes')}</dt><dd>{stats.nodeCount}</dd></div>
+        <div><dt>{t('graph.edges')}</dt><dd>{stats.edgeCount}</dd></div>
+      </dl>
+      {model.value.summary !== null ? <p className={css.summary}>{model.value.summary}</p> : null}
+      <label className={css.filter}>
+        <span>{t('graph.filter')}</span>
+        <select value={kindFilter} onChange={event => { setKindFilter(event.target.value); setSelectedId(null) }}>
+          <option value="all">{t('graph.allKinds')}</option>
+          {kinds.map(kind => <option key={kind} value={kind}>{kind}</option>)}
+        </select>
+      </label>
+      <div ref={containerRef} className={css.canvas} role="img" aria-label={t('graph.title')} data-testid="codegraph-canvas">
+        {rendererUnavailable ? <span className={css.canvasFallback}>{t('graph.unavailable')}</span> : null}
+      </div>
+      {visibleNodes.length === 0 ? <div className={css.empty}>{t('graph.noNodes')}</div> : (
+        <ul className={css.nodeList} aria-label={t('graph.nodes')}>
+          {visibleNodes.map(node => (
+            <li key={node.id}>
+              <button
+                type="button"
+                className={css.nodeButton}
+                data-node-id={node.id}
+                aria-pressed={selectedId === node.id}
+                onClick={() => {
+                  setSelectedId(node.id)
+                  cyRef.current?.getElementById(node.id).select()
+                }}
+              >
+                <span>{node.label ?? node.id}</span><small>{node.kind}</small>
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+      {selected !== undefined ? (
+        <section className={css.selected} aria-label={t('graph.nodeDetails')}>
+          <div className={css.sectionTitle}>{t('graph.nodeDetails')}</div>
+          <div className={css.selectedName}>{selected.label ?? selected.id}</div>
+          <div className={css.selectedMeta}>{selected.kind} · {selected.id}</div>
+          {selected.source !== undefined ? <div>{t('graph.source')}: {selected.source}{lineRange(selected) === undefined ? '' : `:${lineRange(selected)}`}</div> : null}
+        </section>
+      ) : <div className={css.hint}>{t('graph.selectNode')}</div>}
+      {model.value.relatedFiles.length > 0 ? (
+        <div className={css.files}>
+          <div className={css.sectionTitle}>{t('graph.files')}</div>
+          {model.value.relatedFiles.slice(0, 8).map(file => <code key={file}>{file}</code>)}
+        </div>
+      ) : null}
+    </div>
+  )
+}
diff --git a/packages/client/ui-tool/src/client/tool/graph/graph-context-model.ts b/packages/client/ui-tool/src/client/tool/graph/graph-context-model.ts
new file mode 100644
index 0000000000..8d0d5b086d
--- /dev/null
+++ b/packages/client/ui-tool/src/client/tool/graph/graph-context-model.ts
@@ -0,0 +1,254 @@
+/**
+ * Fail-closed presentation model for the read-only CodeGraph context tool.
+ *
+ * The model-facing tool deliberately returns untrusted JSON text. This module
+ * validates that text again at the UI boundary so a malformed or future wire
+ * payload never reaches a generic raw-output renderer or a graph instance.
+ */
+import type { ToolCallBlock } from '../models/tool-call-model.ts'
+
+/** Wire tool name owned by the DevFrame CodeGraph context caller. */
+export const CODEGRAPH_CONTEXT_TOOL = 'devframe_codegraph_context'
+
+const MAX_NODES = 64
+const MAX_EDGES = 128
+const MAX_RELATED_FILES = 64
+const MAX_LABEL_LENGTH = 256
+const MAX_PATH_LENGTH = 512
+const MAX_SUMMARY_LENGTH = 256
+const MAX_STATS = 10_000_000
+const SAFE_ID = /^[A-Za-z0-9][-A-Za-z0-9._:]{0,127}$/
+const SAFE_RELATION = new Set([
+  'calls', 'contains', 'imports', 'implements', 'tests', 'depends_on',
+  'references', 'derived_from', 'uses', 'extends', 'inherits',
+])
+const SAFE_KIND = new Set([
+  'file', 'class', 'function', 'method', 'variable', 'constant', 'import',
+  'module', 'symbol',
+])
+const SENSITIVE = /(?:api[-_]?key|authorization|bearer|cookie|password|secret|token)|sk-(?:[A-Z]|[0-9]|_|-){12,}/i
+
+/** Renderer state after validating one selected CodeGraph call. */
+export type GraphContextModel =
+  | { readonly state: 'running' }
+  | { readonly state: 'unavailable'; readonly reason: 'empty' | 'error' | 'invalid' }
+  | { readonly state: 'ready'; readonly value: GraphContextValue }
+
+/** Safe, display-only graph projection accepted by the UI. */
+export interface GraphContextValue {
+  readonly status: 'matched' | 'unbound' | 'unavailable'
+  readonly workspace: { readonly id: string; readonly title: string } | null
+  readonly freshness: 'current' | 'stale' | 'missing' | 'unknown'
+  readonly trustedForCurrentRun: false
+  readonly summary: string | null
+  readonly nodes: readonly GraphNode[]
+  readonly edges: readonly GraphEdge[]
+  readonly relatedFiles: readonly string[]
+  readonly stats: {
+    readonly nodeCount: number
+    readonly edgeCount: number
+    readonly fileCount: number
+    readonly truncated: boolean
+  }
+  readonly error?: string
+}
+
+/** A bounded graph node used by the renderer. */
+export interface GraphNode {
+  readonly id: string
+  readonly kind: string
+  readonly label?: string
+  readonly source?: string
+  readonly startLine?: number
+  readonly endLine?: number
+}
+
+/** A bounded graph edge used by the renderer. */
+export interface GraphEdge {
+  readonly id: string
+  readonly source: string
+  readonly target: string
+  readonly kind: string
+}
+
+interface JsonObject {
+  readonly [key: string]: unknown
+}
+
+function object(value: unknown): JsonObject | undefined {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return undefined
+  return value as JsonObject
+}
+
+function hasOnly(value: JsonObject, keys: readonly string[]): boolean {
+  const allowed = new Set(keys)
+  return Object.keys(value).every(key => allowed.has(key))
+}
+
+function boundedText(value: unknown, max: number): string | undefined {
+  if (typeof value !== 'string' || value.length === 0 || value.length > max) return undefined
+  for (const char of value) {
+    if ((char.codePointAt(0) ?? 0) < 32) return undefined
+  }
+  if (SENSITIVE.test(value)) return undefined
+  return value
+}
+
+function boundedInteger(value: unknown, max = MAX_STATS): number | undefined {
+  if (!Number.isSafeInteger(value) || typeof value !== 'number' || value < 0 || value > max) return undefined
+  return value
+}
+
+function safeId(value: unknown): string | undefined {
+  return typeof value === 'string' && SAFE_ID.test(value) ? value : undefined
+}
+
+function safeRelativePath(value: unknown, cwd: string | undefined): string | undefined {
+  if (typeof value !== 'string' || value.length === 0 || value.length > MAX_PATH_LENGTH) return undefined
+  if (SENSITIVE.test(value) || /[\u0000-\u001f]/.test(value)) return undefined
+  // The producer already normalizes paths relative to the active workspace.
+  // The UI never resolves or opens them, so an absolute path is not display-safe.
+  if (value.startsWith('/') || value.startsWith('\\') || /^[A-Za-z]:/.test(value)) return undefined
+  if (value.includes('\\') || value.split('/').some(part => part === '.' || part === '..' || part === '')) return undefined
+  // Keep cwd in the signature to make the project-binding requirement visible
+  // at the call site; no model-controlled path is resolved against it here.
+  void cwd
+  return value
+}
+
+function parseText(block: ToolCallBlock): string | undefined {
+  if (!('kind' in block)) return undefined
+  const textBlocks = block.content.filter(item => item.type === 'text')
+  if (textBlocks.length !== 1 || block.content.length !== 1) return undefined
+  const text = textBlocks[0]
+  return text?.type === 'text' ? text.text : undefined
+}
+
+function parseValue(text: string, cwd: string | undefined): GraphContextValue | undefined {
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(text)
+  } catch {
+    return undefined
+  }
+  const data = object(parsed)
+  if (data === undefined || !hasOnly(data, [
+    'status', 'workspace', 'freshness', 'trustedForCurrentRun', 'summary',
+    'nodes', 'edges', 'relatedFiles', 'stats', 'error',
+  ])) return undefined
+  const status = data.status
+  const freshness = data.freshness
+  if (status !== 'matched' && status !== 'unbound' && status !== 'unavailable') return undefined
+  if (freshness !== 'current' && freshness !== 'stale' && freshness !== 'missing' && freshness !== 'unknown') return undefined
+  if (data.trustedForCurrentRun !== false) return undefined
+  const workspaceValue = data.workspace
+  let workspace: GraphContextValue['workspace']
+  if (workspaceValue === null) {
+    workspace = null
+  } else {
+    const rawWorkspace = object(workspaceValue)
+    if (rawWorkspace === undefined || !hasOnly(rawWorkspace, ['id', 'title'])) return undefined
+    const id = boundedText(rawWorkspace.id, MAX_LABEL_LENGTH)
+    const title = boundedText(rawWorkspace.title, MAX_LABEL_LENGTH)
+    if (id === undefined || title === undefined) return undefined
+    workspace = { id, title }
+  }
+  const summaryValue = data.summary
+  let summary: string | null
+  if (summaryValue === null || summaryValue === undefined) {
+    summary = null
+  } else {
+    const boundedSummary = boundedText(summaryValue, MAX_SUMMARY_LENGTH)
+    if (boundedSummary === undefined) return undefined
+    summary = boundedSummary
+  }
+  if (!Array.isArray(data.nodes) || data.nodes.length > MAX_NODES) return undefined
+  if (!Array.isArray(data.edges) || data.edges.length > MAX_EDGES) return undefined
+  if (!Array.isArray(data.relatedFiles) || data.relatedFiles.length > MAX_RELATED_FILES) return undefined
+
+  const nodes: GraphNode[] = []
+  const nodeIds = new Set<string>()
+  for (const raw of data.nodes) {
+    const node = object(raw)
+    if (node === undefined || !hasOnly(node, ['id', 'kind', 'label', 'name', 'qualifiedName', 'source', 'filePath', 'startLine', 'endLine'])) return undefined
+    const id = safeId(node.id)
+    const kind = typeof node.kind === 'string' && SAFE_KIND.has(node.kind) ? node.kind : undefined
+    if (id === undefined || kind === undefined || nodeIds.has(id)) return undefined
+    const labelValue = node.label ?? node.name ?? node.qualifiedName
+    const label = labelValue === undefined ? undefined : boundedText(labelValue, MAX_LABEL_LENGTH)
+    if (labelValue !== undefined && label === undefined) return undefined
+    const sourceValue = node.source ?? node.filePath
+    const source = sourceValue === undefined || sourceValue === null
+      ? undefined : safeRelativePath(sourceValue, cwd)
+    if (sourceValue !== undefined && sourceValue !== null && source === undefined) return undefined
+    const startLine = node.startLine === undefined || node.startLine === null ? undefined : boundedInteger(node.startLine, MAX_STATS)
+    const endLine = node.endLine === undefined || node.endLine === null ? undefined : boundedInteger(node.endLine, MAX_STATS)
+    if ((node.startLine !== undefined && node.startLine !== null && startLine === undefined)
+      || (node.endLine !== undefined && node.endLine !== null && endLine === undefined)) return undefined
+    nodeIds.add(id)
+    nodes.push({
+      id, kind,
+      ...(label === undefined ? {} : { label }),
+      ...(source === undefined ? {} : { source }),
+      ...(startLine === undefined ? {} : { startLine }),
+      ...(endLine === undefined ? {} : { endLine }),
+    })
+  }
+
+  const edges: GraphEdge[] = []
+  const edgeIds = new Set<string>()
+  for (let index = 0; index < data.edges.length; index += 1) {
+    const edge = object(data.edges[index])
+    if (edge === undefined || !hasOnly(edge, ['id', 'source', 'target', 'kind'])) return undefined
+    const source = safeId(edge.source)
+    const target = safeId(edge.target)
+    const kind = typeof edge.kind === 'string' && SAFE_RELATION.has(edge.kind) ? edge.kind : undefined
+    const id = edge.id === undefined || edge.id === null ? `edge-${index}` : safeId(edge.id)
+    if (id === undefined || source === undefined || target === undefined || kind === undefined
+      || !nodeIds.has(source) || !nodeIds.has(target) || edgeIds.has(id)) return undefined
+    edgeIds.add(id)
+    edges.push({ id, source, target, kind })
+  }
+
+  const relatedFiles: string[] = []
+  const relatedSet = new Set<string>()
+  for (const raw of data.relatedFiles) {
+    const file = safeRelativePath(raw, cwd)
+    if (file === undefined || relatedSet.has(file)) return undefined
+    relatedSet.add(file)
+    relatedFiles.push(file)
+  }
+  const statsRaw = data.stats === undefined || data.stats === null ? undefined : object(data.stats)
+  if (data.stats !== undefined && data.stats !== null && (statsRaw === undefined || !hasOnly(statsRaw, ['nodeCount', 'edgeCount', 'fileCount', 'truncated']))) return undefined
+  const stats = statsRaw === undefined
+    ? { nodeCount: nodes.length, edgeCount: edges.length, fileCount: relatedFiles.length, truncated: false }
+    : {
+      nodeCount: boundedInteger(statsRaw.nodeCount) ?? nodes.length,
+      edgeCount: boundedInteger(statsRaw.edgeCount) ?? edges.length,
+      fileCount: boundedInteger(statsRaw.fileCount) ?? relatedFiles.length,
+      truncated: statsRaw.truncated === true,
+    }
+  if (statsRaw !== undefined && (typeof statsRaw.truncated !== 'boolean'
+    || boundedInteger(statsRaw.nodeCount) === undefined
+    || boundedInteger(statsRaw.edgeCount) === undefined
+    || boundedInteger(statsRaw.fileCount) === undefined)) return undefined
+  const error = data.error === undefined ? undefined : boundedText(data.error, MAX_LABEL_LENGTH)
+  if (data.error !== undefined && error === undefined) return undefined
+  return {
+    status, workspace, freshness, trustedForCurrentRun: false, summary,
+    nodes, edges, relatedFiles, stats,
+    ...(error === undefined ? {} : { error }),
+  }
+}
+
+/** Derive the bounded presentation model for a selected tool block. */
+export function graphContextModel(block: ToolCallBlock, cwd?: string): GraphContextModel | null {
+  const name = 'kind' in block ? block.call?.name : block.name
+  if (name !== CODEGRAPH_CONTEXT_TOOL) return null
+  if (!('kind' in block)) return { state: 'running' }
+  if (block.isError || block.error !== undefined) return { state: 'unavailable', reason: 'error' }
+  const text = parseText(block)
+  if (text === undefined || text.trim() === '') return { state: 'unavailable', reason: 'empty' }
+  const value = parseValue(text, cwd)
+  return value === undefined ? { state: 'unavailable', reason: 'invalid' } : { state: 'ready', value }
+}
