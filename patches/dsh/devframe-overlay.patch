+
+  it('fails open when the recalled plan contains secret-like content', async () => {
+    const gateway = { recallProjectPlan: vi.fn(async () => ({ status: 'current' as const, plan: 'unused' })) }
+    const unsafePlans = [
+      `Bearer ${'a'.repeat(24)}`,
