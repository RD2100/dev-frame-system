index 0000000000..e781acdda5
--- /dev/null
+++ b/apps/web/tests/fixtures/fake-claude-code-agent.mjs
@@ -0,0 +1,104 @@
+/**
+ * Test-only Claude Code CLI fixture for the external-agent route.
+ *
+ * The official Claude Agent SDK starts its CLI in stream-json mode. This
+ * fixture accepts the SDK's JSONL user frame and emits only bounded SDK
+ * messages: one visible text delta at a time followed by one successful
+ * result. It has no network, credential, shell, or filesystem behavior.
+ */
+
+import { createInterface } from 'node:readline'
+
+const SESSION_ID = 'external-claude-fixture-session'
+const UUID_PREFIX = '00000000-0000-4000-8000-0000000000'
+const DELTA_LINES = Object.freeze([
+  '外部 Claude 流式测试1',
+  '外部 Claude 流式测试2',
+  '外部 Claude 流式测试3',
+  '外部 Claude 流式测试4',
+  '外部 Claude 流式测试5',
+])
+const DELTA_DELAY_MS = 60
+const RESULT_DELAY_MS = 120
+const MAX_RUNTIME_MS = 10_000
+
+let started = false
+let completed = false
+let timer
+
+function isObject(value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+function send(message) {
+  process.stdout.write(`${JSON.stringify(message)}\n`)
+}
+
+function systemInit() {
+  send({
+    type: 'system',
+    subtype: 'init',
+    uuid: `${UUID_PREFIX}01`,
+    session_id: SESSION_ID,
+    cwd: process.cwd(),
+    tools: [],
+    model: 'claude-fixture',
+  })
+}
+
+function streamDelta(index, text) {
+  send({
+    type: 'stream_event',
+    event: {
+      type: 'content_block_delta',
+      index: 0,
+      delta: { type: 'text_delta', text },
+    },
+    parent_tool_use_id: null,
+    uuid: `${UUID_PREFIX}${String(index + 2).padStart(2, '0')}`,
+    session_id: SESSION_ID,
+  })
+}
+
+function finish() {
+  if (completed) return
+  completed = true
+  if (timer !== undefined) clearTimeout(timer)
+  send({
+    type: 'result',
+    subtype: 'success',
+    is_error: false,
+    result: DELTA_LINES.join('\n'),
+    uuid: `${UUID_PREFIX}08`,
+    session_id: SESSION_ID,
+  })
+  process.stdout.end(() => process.exit(0))
+}
+
+function start() {
+  if (started) return
+  started = true
+  systemInit()
+  for (const [index, line] of DELTA_LINES.entries()) {
+    setTimeout(() => {
+      if (completed) return
+      streamDelta(index, index === DELTA_LINES.length - 1 ? line : `${line}\n`)
+    }, DELTA_DELAY_MS * (index + 1))
+  }
+  setTimeout(finish, DELTA_DELAY_MS * DELTA_LINES.length + RESULT_DELAY_MS)
+  timer = setTimeout(finish, MAX_RUNTIME_MS)
+}
+
+const input = createInterface({ input: process.stdin, crlfDelay: Infinity })
+input.on('line', line => {
+  if (line.trim().length === 0) return
+  let frame
+  try {
+    frame = JSON.parse(line)
+  } catch {
+    return
+  }
+  if (!isObject(frame) || frame.type !== 'user') return
+  start()
+})
+
diff --git a/apps/web/tests/fixtures/fake-codex-external-agent-app-server.mjs b/apps/web/tests/fixtures/fake-codex-external-agent-app-server.mjs
new file mode 100644
index 0000000000..68af91d9bd
--- /dev/null
+++ b/apps/web/tests/fixtures/fake-codex-external-agent-app-server.mjs
@@ -0,0 +1,193 @@
+/**
+ * Test-only Codex app-server fixture for the external-agent route.
+ *
+ * The fixture speaks only JSON-RPC 2.0 line protocol over stdio. It has no
+ * network, credential, shell, or filesystem behavior. The external provider
+ * starts one ephemeral thread and one turn per durable DSH child activation.
+ */
+
+import { createInterface } from 'node:readline'
+
+const THREAD_ID = 'external-fixture-thread'
+const DELTA_LINES = Object.freeze([
+  '外部 Codex 流式测试1',
+  '外部 Codex 流式测试2',
+  '外部 Codex 流式测试3',
+  '外部 Codex 流式测试4',
+  '外部 Codex 流式测试5',
+])
+const DELTA_DELAY_MS = 60
+const COMPLETION_DELAY_MS = 120
+const MAX_TURN_MS = 10_000
+
+let activeTurn
+let turnNumber = 0
+
+function isObject(value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+function send(frame) {
+  process.stdout.write(`${JSON.stringify({ jsonrpc: '2.0', ...frame })}\n`)
+}
+
+function respond(frame, result) {
+  if (!Object.prototype.hasOwnProperty.call(frame, 'id')) return
+  send({ id: frame.id, result })
+}
+
+function respondError(frame, code, message) {
+  if (!Object.prototype.hasOwnProperty.call(frame, 'id')) return
+  send({ id: frame.id, error: { code, message } })
+}
+
+function notify(method, params) {
+  send({ method, params })
+}
+
+function schedule(turn, callback, delayMs) {
+  const timer = setTimeout(() => {
+    turn.timers.delete(timer)
+    if (activeTurn !== turn || turn.interrupted) return
+    callback()
+  }, delayMs)
+  turn.timers.add(timer)
+}
+
+function completeTurn(turn, status = 'completed') {
+  if (activeTurn !== turn || turn.interrupted) return
+  notify('turn/completed', {
+    threadId: THREAD_ID,
+    turn: { id: turn.id, status },
+  })
+  activeTurn = undefined
+}
+
+function interruptTurn() {
+  const turn = activeTurn
+  if (turn === undefined) return
+  turn.interrupted = true
+  for (const timer of turn.timers) clearTimeout(timer)
+  turn.timers.clear()
+  activeTurn = undefined
+  notify('turn/completed', {
+    threadId: THREAD_ID,
+    turn: { id: turn.id, status: 'interrupted' },
+  })
+}
+
+function startTurn(frame) {
+  if (activeTurn !== undefined) {
+    respondError(frame, -32000, 'external fixture already has an active turn')
+    return
+  }
+  const params = frame.params
+  if (!isObject(params)
+    || params.threadId !== THREAD_ID
+    || !Array.isArray(params.input)
+    || params.input.length === 0
+    || !params.input.every(input => isObject(input)
+      && input.type === 'text'
+      && typeof input.text === 'string'
+      && input.text.length > 0
+      && Array.isArray(input.text_elements)
+      && input.text_elements.length === 0)) {
+    respondError(frame, -32602, 'external fixture turn request failed its protocol guards')
+    return
+  }
+
+  turnNumber += 1
+  const turnId = `external-fixture-turn-${turnNumber}`
+  const itemId = `external-fixture-item-${turnNumber}`
+  const finalText = DELTA_LINES.join('\n')
+  const turn = {
+    id: turnId,
+    itemId,
+    finalText,
+    interrupted: false,
+    timers: new Set(),
+  }
+  activeTurn = turn
+
+  respond(frame, { turn: { id: turnId, status: 'inProgress' } })
+  notify('turn/started', {
+    threadId: THREAD_ID,
+    turn: { id: turnId, status: 'inProgress' },
+  })
+
+  for (const [index, line] of DELTA_LINES.entries()) {
+    schedule(turn, () => {
+      notify('item/agentMessage/delta', {
+        threadId: THREAD_ID,
+        turnId,
+        itemId,
+        delta: index === DELTA_LINES.length - 1 ? line : `${line}\n`,
+      })
+    }, DELTA_DELAY_MS * (index + 1))
+  }
+
+  schedule(turn, () => {
+    notify('item/completed', {
+      threadId: THREAD_ID,
+      turnId,
+      item: { type: 'agentMessage', id: itemId, text: finalText, phase: 'final_answer' },
+    })
+  }, DELTA_DELAY_MS * DELTA_LINES.length + COMPLETION_DELAY_MS)
+
+  schedule(turn, () => completeTurn(turn), DELTA_DELAY_MS * DELTA_LINES.length + COMPLETION_DELAY_MS * 2)
+  // A failed browser action must not leave a fixture process alive forever.
+  schedule(turn, () => interruptTurn(), MAX_TURN_MS)
+}
+
+function handleFrame(frame) {
+  if (frame.method === 'initialized') return
+
+  switch (frame.method) {
+    case 'initialize':
+      respond(frame, { userAgent: 'fake-codex-external-agent-app-server' })
+      return
+    case 'thread/start':
+      if (!isObject(frame.params)
+        || typeof frame.params.cwd !== 'string'
+        || frame.params.cwd.length === 0
+        || frame.params.ephemeral !== true) {
+        respondError(frame, -32602, 'external fixture thread request failed its protocol guards')
+        return
+      }
+      respond(frame, { thread: { id: THREAD_ID, ephemeral: true } })
+      return
+    case 'turn/start':
+      startTurn(frame)
+      return
+    case 'turn/interrupt':
+      if (!isObject(frame.params)
+        || frame.params.threadId !== THREAD_ID
+        || activeTurn === undefined
+        || frame.params.turnId !== activeTurn.id) {
+        respondError(frame, -32602, 'external fixture interrupt used invalid thread or turn')
+        return
+      }
+      interruptTurn()
+      respond(frame, {})
+      return
+    case 'thread/unsubscribe':
+      respond(frame, {})
+      return
+    default:
+      respondError(frame, -32601, `Method not found: ${String(frame.method)}`)
+  }
+}
+
+const input = createInterface({ input: process.stdin, crlfDelay: Infinity })
+input.on('line', line => {
+  if (line.trim().length === 0) return
+  let frame
+  try {
+    frame = JSON.parse(line)
+  } catch {
+    return
+  }
+  if (!isObject(frame) || typeof frame.method !== 'string') return
+  handleFrame(frame)
+})
+
diff --git a/apps/web/tests/fixtures/fake-codex-subscription-app-server.mjs b/apps/web/tests/fixtures/fake-codex-subscription-app-server.mjs
new file mode 100644
index 0000000000..fbacebbe44
--- /dev/null
+++ b/apps/web/tests/fixtures/fake-codex-subscription-app-server.mjs
@@ -0,0 +1,464 @@
+/**
+ * Test-only Codex subscription app-server fixture.
+ *
+ * The fixture speaks the official JSON-RPC 2.0 line protocol over stdio. It
+ * has no network, credential, shell, or filesystem behavior.
+ */
+
+import { spawn } from 'node:child_process'
+import { writeFileSync } from 'node:fs'
+import { createInterface } from 'node:readline'
+import { isAbsolute, normalize, relative } from 'node:path'
+
+const THREAD_ID = 'fixture-thread'
+const MODEL_ID = 'fixture-model'
+const TERRA_MODEL_ID = 'fixture-terra'
+const LOGIN_ID = 'fixture-login'
+const PUBLISHED_MODELS = new Set([MODEL_ID, TERRA_MODEL_ID])
+const FIRST_DELTA_LINES = Object.freeze([
+  'Luna流式测试1',
+  'Luna流式测试2',
+  'Luna流式测试3',
+  'Luna流式测试4',
+  'Luna流式测试5',
+])
+const SECOND_DELTA_LINES = Object.freeze([
+  'Luna连续会话2-1',
+  'Luna连续会话2-2',
+  'Luna连续会话2-3',
+  'Luna连续会话2-4',
+  'Luna连续会话2-5',
+])
+const RECOVERY_DELTA_LINES = Object.freeze([
+  'Terra恢复流式1',
+  'Terra恢复流式2',
+  'Terra恢复流式3',
+  'Terra恢复流式4',
+  'Terra恢复流式5',
+])
+const ACTIVE_DELTA = 'Luna取消前流式片段'
+const DELTA_DELAY_MS = 50
+const TERMINAL_DELAY_MS = 100
+const CRASH_DELAY_MS = 10
+const REASONING_SUMMARY_DELAY_MS = 10
+const ACTIVE_TURN_MAX_MS = 30_000
+const REASONING_SUMMARY = '正在整理请求并准备流式回答。'
+const EXPECTED_THREAD_CONFIG = Object.freeze({
+  skills: Object.freeze({ include_instructions: false }),
+  project_doc_max_bytes: 0,
+  model_reasoning_summary: 'concise',
+})
+
+let nextTurnNumber = 0
+let activeTurn
+let threadStarted = false
+let resumedThread = false
+let loginPending = false
+let crashAfterStart = process.env.DSH_TEST_FIXTURE_CRASH_AFTER_START === '1'
+const resumeOnly = process.env.DSH_TEST_FIXTURE_RESUME_ONLY === '1'
+const requireAuth = process.env.DSH_TEST_FIXTURE_REQUIRE_AUTH === '1'
+const activeTurnMode = process.env.DSH_TEST_FIXTURE_ACTIVE_TURN === '1'
+
+function markerPath(value, name) {
+  if (value === undefined) return undefined
+  if (!isAbsolute(value)) throw new Error(`${name} must be an absolute path`)
+  const candidate = normalize(value)
+  const fromCwd = relative(process.cwd(), candidate)
+  if (fromCwd.startsWith('..') || isAbsolute(fromCwd)) {
+    throw new Error(`${name} must stay inside the fixture cwd`)
+  }
+  return candidate
+}
+
+const turnReadyMarker = markerPath(
+  process.env.DSH_TEST_FIXTURE_TURN_READY_MARKER,
+  'DSH_TEST_FIXTURE_TURN_READY_MARKER',
+)
+const interruptMarker = markerPath(
+  process.env.DSH_TEST_FIXTURE_INTERRUPT_MARKER,
+  'DSH_TEST_FIXTURE_INTERRUPT_MARKER',
+)
+const descendantMarker = markerPath(
+  process.env.DSH_TEST_DESCENDANT_MARKER,
+  'DSH_TEST_DESCENDANT_MARKER',
+)
+
+function mark(path, value) {
+  if (path === undefined) return
+  writeFileSync(path, `${value}\n`, 'utf8')
+}
+
+if (descendantMarker !== undefined) {
+  const descendant = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { stdio: 'ignore' })
+  mark(descendantMarker, descendant.pid ?? '')
+}
+
+function modelForTurn(turnNumber) {
+  if (resumedThread) return turnNumber === 3 ? TERRA_MODEL_ID : undefined
+  if (turnNumber === 1) return MODEL_ID
+  if (turnNumber === 2) return TERRA_MODEL_ID
+  return undefined
+}
+
+function isObject(value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+function hasExpectedThreadConfig(value) {
+  if (!isObject(value) || Object.keys(value).length !== 3) return false
+  const skills = value.skills
+  return isObject(skills)
+    && Object.keys(skills).length === 1
+    && skills.include_instructions === EXPECTED_THREAD_CONFIG.skills.include_instructions
+    && value.project_doc_max_bytes === EXPECTED_THREAD_CONFIG.project_doc_max_bytes
+    && value.model_reasoning_summary === EXPECTED_THREAD_CONFIG.model_reasoning_summary
+}
+
+function hasExpectedThreadRequest(method, params) {
+  if (!isObject(params)
+    || typeof params.model !== 'string'
+    || !PUBLISHED_MODELS.has(params.model)
+    || params.modelProvider !== 'openai'
+    || typeof params.cwd !== 'string'
+    || !isAbsolute(params.cwd)
+    || normalize(params.cwd) !== normalize(process.cwd())
+    || params.approvalPolicy !== 'never'
+    || typeof params.baseInstructions !== 'string'
+    || !hasExpectedThreadConfig(params.config)) {
+    return false
+  }
+  if (method === 'thread/start') {
+    return params.model === MODEL_ID && params.sandbox === 'read-only' && params.ephemeral === false
+  }
+  return params.threadId === THREAD_ID
+}
+
+function hasExpectedTurnInput(value) {
+  return isObject(value)
+    && value.type === 'text'
+    && typeof value.text === 'string'
+    && value.text.length > 0
+    && Array.isArray(value.text_elements)
+    && value.text_elements.length === 0
+}
+
+function hasExpectedTurnRequest(params, expectedModel) {
+  const sandboxPolicy = isObject(params?.sandboxPolicy) ? params.sandboxPolicy : undefined
+  return isObject(params)
+    && params.threadId === THREAD_ID
+    && params.model === expectedModel
+    && params.approvalPolicy === 'never'
+    && sandboxPolicy !== undefined
+    && Object.keys(sandboxPolicy).length === 2
+    && sandboxPolicy.type === 'readOnly'
+    && sandboxPolicy.networkAccess === false
+    && Array.isArray(params.input)
+    && params.input.length > 0
+    && params.input.every(hasExpectedTurnInput)
+}
+
+function linesForTurn(turnNumber) {
+  if (resumedThread) return turnNumber === 3 ? RECOVERY_DELTA_LINES : undefined
+  if (turnNumber === 1) return FIRST_DELTA_LINES
+  if (turnNumber === 2) return SECOND_DELTA_LINES
+  return undefined
+}
+
+function send(frame) {
+  process.stdout.write(`${JSON.stringify({ jsonrpc: '2.0', ...frame })}\n`)
+}
+
+function respond(frame, result) {
+  if (!Object.prototype.hasOwnProperty.call(frame, 'id')) return
+  send({ id: frame.id, result })
+}
+
+function respondError(frame, code, message) {
+  if (!Object.prototype.hasOwnProperty.call(frame, 'id')) return
+  send({ id: frame.id, error: { code, message } })
+}
+
+function notify(method, params) {
+  send({ method, params })
+}
+
+function schedule(turn, callback, delayMs) {
+  const timer = setTimeout(() => {
+    turn.timers.delete(timer)
+    if (activeTurn !== turn || turn.interrupted) return
+    callback()
+  }, delayMs)
+  turn.timers.add(timer)
+}
+
+function completeTurn(turn, status = 'completed') {
+  if (activeTurn !== turn || turn.interrupted) return
+  notify('turn/completed', {
+    threadId: THREAD_ID,
+    turn: { id: turn.id, status },
+  })
+  activeTurn = undefined
+}
+
+function interruptTurn() {
+  const turn = activeTurn
+  if (turn === undefined) return
+  mark(interruptMarker, turn.id)
+  turn.interrupted = true
+  for (const timer of turn.timers) clearTimeout(timer)
+  turn.timers.clear()
+  activeTurn = undefined
+  notify('turn/completed', {
+    threadId: THREAD_ID,
+    turn: { id: turn.id, status: 'interrupted' },
+  })
+}
+
+function scheduleTurn(turn) {
+  if (activeTurnMode) {
+    mark(turnReadyMarker, turn.id)
+    schedule(turn, () => {
+      notify('item/reasoning/summaryPartAdded', {
+        threadId: THREAD_ID,
+        turnId: turn.id,
+        itemId: turn.reasoningItemId,
+        summaryIndex: 0,
+      })
+      notify('item/reasoning/summaryTextDelta', {
+        threadId: THREAD_ID,
+        turnId: turn.id,
+        itemId: turn.reasoningItemId,
+        summaryIndex: 0,
+        delta: REASONING_SUMMARY,
+      })
+    }, REASONING_SUMMARY_DELAY_MS)
+    schedule(turn, () => {
+      notify('item/agentMessage/delta', {
+        threadId: THREAD_ID,
+        turnId: turn.id,
+        itemId: turn.itemId,
+        delta: ACTIVE_DELTA,
+      })
+    }, DELTA_DELAY_MS)
+    // A failed browser action must not leave the fixture process unbounded.
+    // The active-turn canary normally interrupts much earlier than this cap.
+    schedule(turn, () => interruptTurn(), ACTIVE_TURN_MAX_MS)
+    return
+  }
+
+  schedule(turn, () => {
+    notify('item/reasoning/summaryPartAdded', {
+      threadId: THREAD_ID,
+      turnId: turn.id,
+      itemId: turn.reasoningItemId,
+      summaryIndex: 0,
+    })
+    notify('item/reasoning/summaryTextDelta', {
+      threadId: THREAD_ID,
+      turnId: turn.id,
+      itemId: turn.reasoningItemId,
+      summaryIndex: 0,
+      delta: REASONING_SUMMARY,
+    })
+  }, REASONING_SUMMARY_DELAY_MS)
+
+  schedule(turn, () => {
+    notify('item/completed', {
+      threadId: THREAD_ID,
+      turnId: turn.id,
+      item: { type: 'reasoning', id: turn.reasoningItemId },
+    })
+  }, REASONING_SUMMARY_DELAY_MS + 1)
+
+  for (const [index, line] of turn.lines.entries()) {
+    schedule(turn, () => {
+      notify('item/agentMessage/delta', {
+        threadId: THREAD_ID,
+        turnId: turn.id,
+        itemId: turn.itemId,
+        delta: index === turn.lines.length - 1 ? line : `${line}\n`,
+      })
+    }, DELTA_DELAY_MS * (index + 1))
+  }
+
+  schedule(turn, () => {
+    notify('item/completed', {
+      threadId: THREAD_ID,
+      turnId: turn.id,
+      completedAtMs: Date.now(),
+      item: {
+        type: 'agentMessage',
+        id: turn.itemId,
+        text: turn.finalText,
+        phase: 'final_answer',
+      },
+    })
+  }, DELTA_DELAY_MS * turn.lines.length + TERMINAL_DELAY_MS)
+
+  schedule(turn, () => completeTurn(turn), DELTA_DELAY_MS * turn.lines.length + TERMINAL_DELAY_MS * 2)
+}
+
+function handleFrame(frame) {
+  if (frame.method === 'initialized') return
+
+  switch (frame.method) {
+    case 'initialize':
+      respond(frame, { userAgent: 'fake-codex-subscription-app-server' })
+      return
+    case 'account/read':
+      respond(frame, {
+        account: requireAuth ? null : { type: 'chatgpt', email: null, planType: 'pro' },
+        requiresOpenaiAuth: requireAuth,
+      })
+      return
+    case 'account/login/start':
+      if (frame.params?.type !== 'chatgpt' || loginPending) {
+        respondError(frame, -32602, 'fixture login start used invalid state')
+        return
+      }
+      loginPending = true
+      respond(frame, {
+        type: 'chatgpt',
+        loginId: LOGIN_ID,
+        authUrl: 'https://auth.openai.com/oauth/authorize?redirect_uri=http%3A%2F%2Flocalhost%3A1455%2Fauth%2Fcallback&state=fixture',
+      })
+      return
+    case 'account/login/cancel':
+      if (frame.params?.loginId !== LOGIN_ID || !loginPending) {
+        respondError(frame, -32602, 'fixture login cancel used invalid state')
+        return
+      }
+      loginPending = false
+      respond(frame, {})
+      setTimeout(() => {
+        notify('account/login/completed', { loginId: LOGIN_ID, success: false, error: null })
+      }, 0)
+      return
+    case 'model/list':
+      respond(frame, {
+        data: [{
+          id: 'fixture-preset',
+          model: MODEL_ID,
+          displayName: 'Fixture Model',
+          hidden: false,
+          supportedReasoningEfforts: [{ reasoningEffort: 'minimal', description: 'Minimal' }],
+          defaultReasoningEffort: 'minimal',
+          isDefault: true,
+        }, {
+          id: 'fixture-terra-preset',
+          model: TERRA_MODEL_ID,
+          displayName: 'Fixture Terra',
+          hidden: false,
+          supportedReasoningEfforts: [{ reasoningEffort: 'minimal', description: 'Minimal' }],
+          defaultReasoningEffort: 'minimal',
+          isDefault: false,
+        }],
+        nextCursor: null,
+      })
+      return
+    case 'thread/start':
+    case 'thread/resume': {
+      if (!hasExpectedThreadRequest(frame.method, frame.params)) {
+        respondError(frame, -32602, 'fixture thread request failed its protocol guards')
+        return
+      }
+      if (frame.method === 'thread/start' && resumeOnly) {
+        respondError(frame, -32602, 'fixture requires thread/resume after the process crash')
+        return
+      }
+      const model = frame.params.model
+      if (frame.method === 'thread/start' && threadStarted) {
+        respondError(frame, -32602, 'fixture thread was already started')
+        return
+      }
+      threadStarted = true
+      resumedThread = frame.method === 'thread/resume'
+      if (resumedThread) nextTurnNumber = 2
+      respond(frame, {
+        model,
+        modelProvider: 'openai',
+        thread: { id: THREAD_ID, ephemeral: false },
+      })
+      return
+    }
+    case 'turn/start': {
+      if (activeTurn !== undefined) {
+        respondError(frame, -32000, 'fixture turn already active')
+        return
+      }
+      const expectedModel = modelForTurn(nextTurnNumber + 1)
+      if (!hasExpectedTurnRequest(frame.params, expectedModel)) {
+        respondError(frame, -32602, 'fixture turn request failed its protocol guards')
+        return
+      }
+      nextTurnNumber += 1
+      const turnId = `fixture-turn-${nextTurnNumber}`
+      const lines = linesForTurn(nextTurnNumber)
+      if (lines === undefined) {
+        respondError(frame, -32602, 'fixture has no output for this turn')
+        return
+      }
+      const turn = {
+        id: turnId,
+        itemId: `fixture-item-${turnId}`,
+        reasoningItemId: `fixture-reasoning-${turnId}`,
+        lines,
+        finalText: lines.join('\n'),
+        interrupted: false,
+        timers: new Set(),
+      }
+      activeTurn = turn
+      respond(frame, { turn: { id: turnId, status: 'inProgress' } })
+      const shouldCrash = crashAfterStart
+      crashAfterStart = false
+      if (shouldCrash) {
+        setTimeout(() => process.exit(17), CRASH_DELAY_MS)
+        return
+      }
+      notify('turn/started', {
+        threadId: THREAD_ID,
+        turn: { id: turnId, status: 'inProgress' },
+      })
+      notify('item/started', {
+        threadId: THREAD_ID,
+        turnId,
+        item: { type: 'reasoning', id: turn.reasoningItemId },
+      })
+      notify('item/started', {
+        threadId: THREAD_ID,
+        turnId,
+        item: { type: 'agentMessage', id: turn.itemId, phase: 'final_answer' },
+      })
+      scheduleTurn(turn)
+      return
+    }
+    case 'turn/interrupt':
+      if (frame.params?.threadId !== THREAD_ID
+        || activeTurn === undefined
+        || frame.params?.turnId !== activeTurn.id) {
+        respondError(frame, -32602, 'fixture interrupt used invalid thread or turn')
+        return
+      }
+      interruptTurn()
+      respond(frame, {})
+      return
+    case 'thread/unsubscribe':
+      respond(frame, {})
+      return
+    default:
+      respondError(frame, -32601, `Method not found: ${String(frame.method)}`)
+  }
+}
+
+const input = createInterface({ input: process.stdin, crlfDelay: Infinity })
+input.on('line', (line) => {
+  if (line.trim().length === 0) return
+  let frame
+  try {
+    frame = JSON.parse(line)
+  } catch {
+    return
+  }
+  if (frame === null || typeof frame !== 'object' || Array.isArray(frame) || typeof frame.method !== 'string') return
+  handleFrame(frame)
+})
