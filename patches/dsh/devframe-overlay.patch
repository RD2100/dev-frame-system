@@ -0,0 +1,204 @@
+/**
+ * Model-facing, read-only project identity and DevFrame readiness snapshot.
+ *
+ * The active Agent session is the only project selector. This deliberately
+ * does not accept a path or workspace id from the model, and it does not
+ * retrieve graph context or start a governed run.
+ * @module @deepseek-ai/dsh-devframe/project-context
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import { defineTool } from '@deepseek-ai/dsh-tools'
+import type {
+  DevFrameHealthItem,
+  DevFrameHealthSnapshot,
+  DevFrameReadinessSnapshot,
+} from '@deepseek-ai/dsh-devframe-control-session'
+import type { Workspace } from '@deepseek-ai/dsh-workspace'
+
+/** Cordis plugin name used by Loader diagnostics. */
+export const name = 'devframe-project-context'
+
+/** Services needed to register the tool and its model guidance. */
+export const inject = ['tools', 'systemPrompt']
+
+type ProjectStatus = 'matched' | 'unbound' | 'unavailable'
+
+interface ProjectContextValue {
+  readonly status: ProjectStatus
+  readonly workspace: { readonly id: string; readonly title: string } | null
+  readonly readiness: {
+    readonly status: DevFrameReadinessSnapshot['status']
+    readonly generation: number
+    readonly revision: number
+  }
+  readonly health: {
+    readonly revision: number
+    readonly items: DevFrameHealthItem[]
+  }
+}
+
+interface WorkspaceRegistryLike {
+  resolveByPath(path: string): Promise<Workspace | undefined>
+}
+
+interface ControlSessionsLike {
+  readinessSnapshot(): DevFrameReadinessSnapshot
+  healthSnapshot(): DevFrameHealthSnapshot
+}
+
+const OUTPUT = {
+  schema: {
+    type: 'object' as const,
+    additionalProperties: false,
+    properties: {
+      status: { type: 'string' as const, required: true, enum: ['matched', 'unbound', 'unavailable'] },
+      workspace: {
+        required: true,
+        oneOf: [
+          {
+            type: 'object' as const,
+            additionalProperties: false,
+            properties: {
+              id: { type: 'string' as const, required: true },
+              title: { type: 'string' as const, required: true },
+            },
+          },
+          { type: 'null' as const },
+        ],
+      },
+      readiness: {
+        type: 'object' as const,
+        additionalProperties: false,
+        required: true,
+        properties: {
+          status: {
+            type: 'string' as const,
+            required: true,
+            enum: ['starting', 'ready', 'blocked', 'stopping'],
+          },
+          generation: { type: 'integer' as const, required: true },
+          revision: { type: 'integer' as const, required: true },
+        },
+      },
+      health: {
+        type: 'object' as const,
+        additionalProperties: false,
+        required: true,
+        properties: {
+          revision: { type: 'integer' as const, required: true },
+          items: {
+            type: 'array' as const,
+            required: true,
+            items: {
+              type: 'object' as const,
+              additionalProperties: false,
+              properties: {
+                id: { type: 'string' as const, required: true },
+                status: { type: 'string' as const, required: true, enum: ['ready', 'degraded', 'blocked'] },
+                reason: { type: 'string' as const },
+                impact: { type: 'string' as const },
+                action: { type: 'string' as const },
+              },
+            },
+          },
+        },
+      },
+    },
+  },
+  render: (_args: unknown, value: ProjectContextValue) => [{
+    type: 'text' as const,
+    text: JSON.stringify(value),
+  }],
+} as const
+
+function readinessSummary(snapshot: DevFrameReadinessSnapshot): ProjectContextValue['readiness'] {
+  return {
+    status: snapshot.status,
+    generation: snapshot.generation,
+    revision: snapshot.revision,
+  }
+}
+
+function healthSummary(snapshot: DevFrameHealthSnapshot): ProjectContextValue['health'] {
+  return {
+    revision: snapshot.revision,
+    items: snapshot.items.map(item => ({
+      id: item.id,
+      status: item.status,
+      ...item.reason === undefined ? {} : { reason: item.reason },
+      ...item.impact === undefined ? {} : { impact: item.impact },
+      ...item.action === undefined ? {} : { action: item.action },
+    })),
+  }
+}
+
+function unavailable(controlSessions?: ControlSessionsLike): ProjectContextValue {
+  const readiness = controlSessions?.readinessSnapshot()
+  const health = controlSessions?.healthSnapshot()
+  return {
+    status: 'unavailable',
+    workspace: null,
+    readiness: readiness === undefined
+      ? { status: 'blocked', generation: 0, revision: 0 }
+      : readinessSummary(readiness),
+    health: health === undefined
+      ? { revision: 0, items: [] }
+      : healthSummary(health),
+  }
+}
+
+/** Execute one observation against the active Agent's native session cwd. */
+export async function readProjectContext(
+  ctx: Context,
+  exec: { agent?: { session: { header: { cwd?: string } } } },
+): Promise<ProjectContextValue> {
+  const controlSessions = ctx.get('devframeControlSessions') as ControlSessionsLike | undefined
+  if (controlSessions === undefined) return unavailable()
+
+  const cwd = exec.agent?.session.header.cwd
+  if (cwd === undefined || cwd.trim() === '') {
+    return {
+      ...unavailable(controlSessions),
+      status: 'unbound',
+    }
+  }
+
+  const registry = ctx.get('workspaceRegistry') as WorkspaceRegistryLike | undefined
+  if (registry === undefined) return unavailable(controlSessions)
+
+  let workspace: Workspace | undefined
+  try {
+    workspace = await registry.resolveByPath(cwd)
+  } catch {
+    return unavailable(controlSessions)
+  }
+
+  return {
+    status: workspace === undefined ? 'unbound' : 'matched',
+    workspace: workspace === undefined ? null : { id: String(workspace.id), title: workspace.title },
+    readiness: readinessSummary(controlSessions.readinessSnapshot()),
+    health: healthSummary(controlSessions.healthSnapshot()),
+  }
+}
+
+/** Register the explicit, argument-free project context tool. */
+export function apply(ctx: Context): void {
+  ctx.systemPrompt.section({
+    name: 'tool:devframe-project-context',
+    order: 112,
+    text: 'Use devframe_project_context to confirm the current registered project and DevFrame readiness. '
+      + 'It is read-only, derives the project from the active session, and does not inspect files, retrieve '
+      + 'CodeGraph context, dispatch tasks, approve work, or modify memory/project state.',
+  })
+  ctx.tools.register(defineTool({
+    name: 'devframe_project_context',
+    description: 'Read the current DSH session project binding and pathless DevFrame health/readiness. '
+      + 'This tool takes no arguments and never scans files or starts work.',
+    parameters: {},
+    output: OUTPUT,
+    isConcurrencySafe: () => true,
+    execute: (_args, exec) => readProjectContext(ctx, exec),
+    presentCall: () => ({ card: 'generic', title: 'Read DevFrame project context', kind: 'read' }),
+  }))
+}
diff --git a/packages/bundle/devframe/src/task-runner.ts b/packages/bundle/devframe/src/task-runner.ts
new file mode 100644
index 0000000000..3b208feab7
--- /dev/null
+++ b/packages/bundle/devframe/src/task-runner.ts
@@ -0,0 +1,168 @@
+/**
+ * DevFrame's one-shot project-task runner.
+ *
+ * It resolves an id or path through the native Workspace Registry, then calls
+ * the Host-owned Project Controller. Output deliberately contains no cwd or
+ * other caller/persistence values.
+ * @module @deepseek-ai/dsh-devframe/task-runner
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import { createHash } from 'node:crypto'
+import {
+  ControlSessionError,
+  type DevFrameProjectLoopTrace,
+} from '@deepseek-ai/dsh-devframe-control-session'
+import { WorkspaceId } from '@deepseek-ai/dsh-workspace'
+import type { Workspace } from '@deepseek-ai/dsh-workspace'
+import type { DevFrameTaskStartupValues } from './task-startup.ts'
+
+/** Stable Cordis plugin name. */
+export const name = 'devframe-task-runner'
+
+/** The runner is inert unless the task command provider published a request. */
+export const inject = []
+
+interface WorkspaceRegistryLike {
+  get(id: ReturnType<typeof WorkspaceId>): Workspace | undefined
+  resolveByPath(path: string): Promise<Workspace | undefined>
+  create(path: string): Promise<Workspace>
+}
+
+interface ControlSessionsLike {
+  dispatchProjectLoop(options: {
+    profileId: string
+    projectId: string
+    projectRoot: string
+    objective: string
+    maxGoalRounds: number
+    requestIdempotencyKey: string
+  }): Promise<DevFrameProjectLoopTrace>
+}
+
+/** Loader config for the one-shot runner; the startup provider is injected by the patch. */
+export interface DevFrameTaskRunnerConfig {
+  readonly request?: DevFrameTaskStartupValues
+}
+
+/** Process-facing effects kept injectable for the compose smoke and CLI tests. */
+export const internals: {
+  stdout: { write(chunk: string): unknown }
+  stderr: { write(chunk: string): unknown }
+} = {
+  stdout: process.stdout,
+  stderr: process.stderr,
+}
+
+/** Stable result shape; never include a filesystem path in either branch. */
+export interface DevFrameTaskResult {
+  readonly ok: boolean
+  readonly projectId?: string
+  readonly goalId?: string
+  readonly sessionId?: string
+  readonly outcome?: DevFrameProjectLoopTrace['outcome']
+  readonly error?: string
+}
+
+/**
+ * Resolve or register a project selector. A registered id wins; an unowned
+ * selector is treated as an explicit directory path and registered once.
+ * @param registry - native Workspace Registry facade.
+ * @param selector - workspace id or directory path supplied by the caller.
+ * @returns the canonical registered Workspace.
+ */
+export async function resolveProject(
+  registry: WorkspaceRegistryLike,
+  selector: string,
+): Promise<Workspace> {
+  const value = selector.trim()
+  if (value === '') throw new ControlSessionError('UNKNOWN_WORKSPACE')
+  // Workspace ids are native branded strings rather than a CLI-specific
+  // format. Always try the registry first, so future/non-UUID ids keep working.
+  const byId = registry.get(WorkspaceId(value))
+  if (byId !== undefined) return byId
+  try {
+    const existing = await registry.resolveByPath(value)
+    if (existing !== undefined) return existing
+  } catch (error) {
+    // A missing path is expected before create() performs the authoritative
+    // existing-directory check. Storage/permission failures must propagate so
+    // they cannot be mistaken for an unregistered project.
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
+  }
+  return await registry.create(value)
+}
+
+function resultFromTrace(trace: DevFrameProjectLoopTrace): DevFrameTaskResult {
+  return {
+    ok: trace.outcome === 'completed',
+    projectId: trace.projectId,
+    ...trace.goalId === undefined ? {} : { goalId: trace.goalId },
+    sessionId: trace.sessionId ?? trace.projectSessionId,
+    outcome: trace.outcome,
+  }
+}
+
+function errorCode(error: unknown): string {
+  return error instanceof ControlSessionError ? error.code : 'TASK_FAILED'
+}
+
+function emitResult(result: DevFrameTaskResult): void {
+  internals.stdout.write(`${JSON.stringify(result)}\n`)
+}
+
+/**
+ * Execute the task after the composed Loader tree has settled.
+ * @param ctx - composed DSH Host context.
+ * @param request - validated one-shot task request.
+ * @returns the pathless task result.
+ */
+export async function runTask(ctx: Context, request: DevFrameTaskStartupValues): Promise<DevFrameTaskResult> {
+  const loader = ctx.get('loader') as { await(): Promise<unknown> } | undefined
+  await loader?.await()
+  const registry = ctx.get('workspaceRegistry') as WorkspaceRegistryLike | undefined
+  const controlSessions = ctx.get('devframeControlSessions') as ControlSessionsLike | undefined
+  const identity = ctx.get('profileIdentity') as { id?: string } | undefined
+  if (registry === undefined || controlSessions === undefined || identity?.id === undefined) {
+    throw new ControlSessionError('MODEL_UNAVAILABLE')
+  }
+  const workspace = await resolveProject(registry, request.project)
+  // The Host owns the complete Global→Project route, governed-memory recall,
+  // bounded Project Controller run, review, and checkpoint lifecycle. The
+  // task runner only resolves the native Workspace and supplies its root.
+  const requestIdempotencyKey = createHash('sha256')
+    .update(JSON.stringify([request.project, request.objective, request.rounds]))
+    .digest('hex')
+  return resultFromTrace(await controlSessions.dispatchProjectLoop({
+    profileId: identity.id,
+    projectId: String(workspace.id),
+    projectRoot: workspace.path,
+    objective: request.objective,
+    maxGoalRounds: request.rounds,
+    requestIdempotencyKey,
+  }))
+}
+
+/** Mount the one-shot task runner and request bounded process teardown. */
+export function apply(ctx: Context, config: DevFrameTaskRunnerConfig): void {
+  if (config.request === undefined) return
+  const exit = ctx.get('appExit')
+  if (exit === undefined) {
+    throw new Error('devframe-task-runner: the launcher must provide ctx.appExit before the tree mounts')
+  }
+  let settled = false
+  const finish = (code: number): void => {
+    if (settled) return
+    settled = true
+    exit(code)
+  }
+  void runTask(ctx, config.request).then((result) => {
+    emitResult(result)
+    finish(result.ok ? 0 : 1)
+  }).catch((error: unknown) => {
+    const result: DevFrameTaskResult = { ok: false, error: errorCode(error) }
+    emitResult(result)
+    internals.stderr.write(`dsh: DevFrame task failed: ${result.error}\n`)
+    finish(1)
+  })
+}
diff --git a/packages/bundle/devframe/src/task-startup.ts b/packages/bundle/devframe/src/task-startup.ts
new file mode 100644
index 0000000000..867fdc52c5
--- /dev/null
+++ b/packages/bundle/devframe/src/task-startup.ts
@@ -0,0 +1,114 @@
+/**
+ * DevFrame's bounded project-task command-line provider.
+ *
+ * The launcher keeps the ordinary Web invocation unchanged: this provider
+ * publishes a value only when the inner `task` command is selected.
+ * @module @deepseek-ai/dsh-devframe/task-startup
+ */
+
+import { Command } from 'commander'
+import type { Context } from '@deepseek-ai/cordis'
+import { parseCmdline } from '@deepseek-ai/dsh-cmdline'
+
+/** Stable Cordis plugin name. */
+export const name = 'devframe-task-startup'
+
+/** This provider only needs the launcher's immutable command-line snapshot. */
+export const inject = ['cmdlineArgs']
+
+/** Service published for the task runner when `task` was requested. */
+export const DEVFRAME_TASK_STARTUP_SERVICE = 'devframeTaskStartup'
+
+/** Explicit opt-in required for the unfinished project-task tracer. */
+export const DEVFRAME_EXPERIMENTAL_TASKS_ENV = 'DSH_DEVFRAME_EXPERIMENTAL_TASKS'
+
+/** Parsed, pathless command options handed to the task runner. */
+export interface DevFrameTaskStartupValues {
+  /** Workspace id or directory selector supplied by the user. */
+  readonly project: string
+  /** Human objective forwarded to the bounded Project Controller. */
+  readonly objective: string
+  /** Maximum number of native Goal Rounds requested by this invocation. */
+  readonly rounds: 1 | 2
+}
+
+/**
+ * Whether the unfinished task tracer was explicitly enabled by the operator.
+ * The default is deliberately disabled while the permission and audit layers
+ * are incomplete; this is not the DevFrame security boundary.
+ * @param env - environment values to inspect.
+ * @returns true only for the explicit `1` switch value.
+ */
+export function experimentalTasksEnabled(
+  env: Readonly<Record<string, string | undefined>> = process.env,
+): boolean {
+  return env[DEVFRAME_EXPERIMENTAL_TASKS_ENV] === '1'
+}
+
+interface TaskOptions {
+  project?: string
+  objective?: string
+  rounds?: string
+}
+
+/** Create a fresh command tree so tests and embedded hosts can parse repeatedly. */
+function devFrameCommand(): Command {
+  const program = new Command()
+    .name('dsh --profile devframe')
+    .description('Run one bounded DevFrame task in a registered project.')
+    .helpOption('-h, --help', 'show this help')
+    .addHelpText('after', `
+Examples:
+  dsh --profile devframe task --project . --objective "run the focused tests"
+  dsh --profile devframe task --project <workspace-id> --objective "fix the failing test" --rounds 2
+`)
+
+  program
+    .command('task')
+    .description('dispatch one bounded project task through the DevFrame Controller')
+    .requiredOption('--project <workspace-id-or-path>', 'registered workspace id or existing directory')
+    .requiredOption('--objective <text>', 'bounded task objective')
+    .option('--rounds <1|2>', 'maximum Goal Rounds (default: 1)', '1')
+  return program
+}
+
+/**
+ * Parse the app-owned task command and publish it as a normal Cordis service.
+ * Only a first app argument of `task` belongs to this provider. Empty and Web
+ * arguments remain owned by `dsh-web-app`; this provider must never parse or
+ * reject flags such as `--port` and `--host`.
+ */
+export function apply(ctx: Context): void {
+  const cmdline = ctx.get('cmdlineArgs')
+  if (cmdline === undefined) {
+    throw new Error('devframe-task-startup: the launcher must provide ctx.cmdlineArgs before the tree mounts')
+  }
+  if (cmdline.get()[0] !== 'task') return
+
+  const program = devFrameCommand()
+  const task = program.commands.find(command => command.name() === 'task')
+  if (task === undefined) throw new Error('devframe-task-startup: task command was not registered')
+  task.action((_options: TaskOptions, command: Command) => {
+    if (!experimentalTasksEnabled()) {
+      command.error(`error: task is experimental and disabled by default; set ${DEVFRAME_EXPERIMENTAL_TASKS_ENV}=1 to enable`)
+    }
+    const options = command.opts<TaskOptions>()
+    const project = options.project?.trim() ?? ''
+    const objective = options.objective?.trim() ?? ''
+    const rounds = options.rounds?.trim() ?? '1'
+    if (project === '') command.error('error: --project cannot be empty')
+    if (objective === '') command.error('error: --objective cannot be empty')
+    if (rounds !== '1' && rounds !== '2') {
+      command.error(`error: --rounds must be 1 or 2, got ${JSON.stringify(rounds)}`)
+    }
+    ctx.provide(DEVFRAME_TASK_STARTUP_SERVICE, {
+      project,
+      objective,
+      rounds: rounds === '2' ? 2 : 1,
+    } satisfies DevFrameTaskStartupValues)
+  })
+  parseCmdline(ctx, program)
+}
+
+/** Exposed for parser tests without exposing the Host context. */
+export const internals = { devFrameCommand }
