+    controller: new DevFrameControlSessions(ctx, options.controlOptions),
+    create,
+    resume,
+    flush,
+    liveAgents,
+    liveSessions,
+    liveHandles,
+    publications,
+    disposedAgents,
+    toolsByAgent,
+  }
+}
+
+function taskChanges(session: Session): TaskChangeV1[] {
+  return session.events
+    .filter(event => event.type === TASK_EVENT_TYPE)
+    .map(event => event.data)
