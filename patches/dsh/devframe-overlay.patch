+/** Derive the pathless reviewer evidence from its native terminal turn. */
+function createTaskReviewEvidence(
+  workerSession: Session,
+  reviewerWorkerId: string,
+  target: ReviewTarget,
+  assistantEvent: SessionEvent<'assistant/message'>,
+  turnEndEvent: SessionEvent<'turn/end'>,
+  submission: PendingReviewSubmission,
+  revisionTaskId?: string,
+): TaskReviewEvidenceV1 {
+  const outcome = turnEndEvent.data.reason.kind
+  if (outcome !== 'completed' && outcome !== 'max-tokens') {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  if (assistantEvent.data.turn !== turnEndEvent.data.turn
+    || assistantEvent.seq >= turnEndEvent.seq
+    || reviewerWorkerId === target.workerId) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const submissionEvent = workerSession.events.find(event => event.type === 'tool/call'
+    && event.data.name === TASK_REVIEW_SUBMIT_TOOL
+    && String(event.data.callId) === submission.callId
+    && event.seq < assistantEvent.seq)
+  if (submissionEvent === undefined || submissionEvent.type !== 'tool/call') {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const sourceEventSeqs = [...new Set([
+    ...(assistantEvent.sourceEventSeqs ?? []),
+    submissionEvent.seq,
+    assistantEvent.seq,
+    turnEndEvent.seq,
+  ])].sort((left, right) => left - right)
+  if (sourceEventSeqs.length < 2 || sourceEventSeqs.length > 256
+    || sourceEventSeqs.some(seq => !Number.isSafeInteger(seq) || seq < 0)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const unsigned: Omit<TaskReviewEvidenceV1, 'evidenceSha256'> = {
+    schemaVersion: 1,
+    kind: 'devframe/task-review',
+    version: 1,
+    taskId: target.taskId,
+    executorWorkerId: target.workerId,
+    executorReportSha256: target.reportRef.evidenceSha256,
+    reviewerWorkerId,
+    reviewerSessionId: workerSession.id,
+    reviewerMessageId: String(assistantEvent.data.message.id),
+    reviewSubmissionCallId: submission.callId,
+    reviewSubmissionSeq: submissionEvent.seq,
+    reviewerAssistantSeq: assistantEvent.seq,
+    reviewerTurn: assistantEvent.data.turn,
+    reviewerStep: assistantEvent.data.step,
+    reviewerTurnEndSeq: turnEndEvent.seq,
+    reviewerSourceEventSeqs: sourceEventSeqs,
+    reviewerMessageSha256: createHash('sha256')
+      .update(JSON.stringify(assistantEvent.data.message))
+      .digest('hex'),
+    verdict: submission.verdict,
+    findingsSha256: submission.findingsSha256,
+    changedAt: Date.now(),
+    ...revisionTaskId === undefined ? {} : { revisionTaskId },
+  }
+  const evidence = { ...unsigned, evidenceSha256: taskReviewEvidenceDigest(unsigned) }
+  return parseTaskReviewEvidence(evidence)
+}
