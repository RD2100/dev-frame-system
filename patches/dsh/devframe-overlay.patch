+function sanitizedProtocolError(error: unknown): CodexRuntimeError {
+  if (error instanceof CodexRuntimeError) return error
+  if (error instanceof JsonRpcResponseError) return new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex protocol request failed')
