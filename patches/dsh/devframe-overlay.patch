@@ -0,0 +1,68 @@
+/**
+ * Test-only ACP agent fixture for the `@opencode` external route.
+ *
+ * It speaks the same JSON-RPC ACP surface as `opencode acp`, but never starts
+ * OpenCode, reads credentials, accesses the network, invokes a shell, or
+ * writes files. The parent test replaces only the profile-owned command after
+ * asserting that production requested `opencode acp`.
+ */
+
+import { Readable, Writable } from 'node:stream'
+import {
+  AgentSideConnection,
+  ndJsonStream,
+  PROTOCOL_VERSION,
+} from '@agentclientprotocol/sdk'
+
+const SESSION_ID = 'fake-opencode-acp-session'
+const LINES = Object.freeze([
+  '外部 OpenCode 流式测试1',
+  '外部 OpenCode 流式测试2',
+  '外部 OpenCode 流式测试3',
+  '外部 OpenCode 流式测试4',
+  '外部 OpenCode 流式测试5',
+])
+
+const wait = ms => new Promise(resolve => setTimeout(resolve, ms))
+
+function makeAgent(conn) {
+  let cancelled = false
+  return {
+    initialize: async () => ({
+      protocolVersion: PROTOCOL_VERSION,
+      agentCapabilities: {
+        loadSession: false,
+        promptCapabilities: { image: false, audio: false, embeddedContext: false },
+      },
+      authMethods: [],
+    }),
+    newSession: async () => ({ sessionId: SESSION_ID }),
+    authenticate: async () => {},
+    prompt: async params => {
+      cancelled = false
+      for (const [index, line] of LINES.entries()) {
+        await wait(60)
+        if (cancelled) return { stopReason: 'cancelled' }
+        await conn.sessionUpdate({
+          sessionId: params.sessionId,
+          update: {
+            sessionUpdate: 'agent_message_chunk',
+            content: { type: 'text', text: index === LINES.length - 1 ? line : `${line}\n` },
+          },
+        })
+      }
+      return { stopReason: 'end_turn' }
+    },
+    cancel: async () => {
+      cancelled = true
+    },
+  }
+}
+
+new AgentSideConnection(
+  makeAgent,
+  ndJsonStream(
+    Writable.toWeb(process.stdout),
+    Readable.toWeb(process.stdin),
+  ),
+)
