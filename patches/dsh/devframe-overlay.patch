+    active.push(ctx)
+    expect(ctx.tools.schemas().map(schema => schema.name)).toContain('devframe_codegraph_context')
+    expect(value(await call(ctx, agent()))).toMatchObject({ status: 'matched', workspace: { id: 'workspace-1' } })
+  })
+})
