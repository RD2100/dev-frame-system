diff --git a/packages/client/ui-devframe-control-session/src/client/GlobalControllerAction.tsx b/packages/client/ui-devframe-control-session/src/client/GlobalControllerAction.tsx
new file mode 100644
index 0000000000..1bd1128378
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/GlobalControllerAction.tsx
@@ -0,0 +1,259 @@
+import { useState } from 'react'
+import type { SessionId, SessionListState, WorkspaceId, WorkspaceListState } from '@deepseek-ai/dsh-client-runtime/client'
+import type {
+  PropsLocale, PropsRuntime, SnapshotSelectorHook,
+} from '@deepseek-ai/dsh-client-ui-slots'
+import type {} from '@deepseek-ai/dsh-client-ui-sidebar/client'
+import type {
+  DevFrameHealthSnapshot,
+  MemoryOpenResult,
+  DevFrameProjectLoopTrace,
+} from '@deepseek-ai/dsh-devframe-control-session/types'
+import {
+  IconCopyOutline16, IconEllipsisOutline16, Menu, writeClipboard,
+} from '@deepseek-ai/dsh-client-ui-primitives'
+import { HealthCard } from './HealthCard.tsx'
+import { MemoryCard } from './MemoryCard.tsx'
+import { ProjectPicker } from './ProjectPicker.tsx'
+import { ProjectLoopPanel } from './ProjectLoopPanel.tsx'
+import { TaskBoardPanel } from './TaskBoardPanel.tsx'
+import type { ProjectAuthorityState } from './authority.ts'
+import type { TaskBoardSnapshot, TaskTrajectorySnapshot } from './task-board-store.ts'
+import { NS } from './locales.ts'
+import type { GlobalControllerReadinessState } from './readiness.ts'
+import css from './GlobalControllerAction.module.css'
+
+const GLOBAL_SESSION_ID_PATTERN = /^devframe-global:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/
+
+function readinessSessionId(state: GlobalControllerReadinessState): SessionId | undefined {
+  if (state.status !== 'ready' || !GLOBAL_SESSION_ID_PATTERN.test(state.sessionId)) return undefined
+  return state.sessionId as SessionId
+}
+
+function unavailableProjectLoop(): Promise<DevFrameProjectLoopTrace> {
+  return Promise.reject(new Error('devframe: project loop remote unavailable'))
+}
+
+/** Props for the sidebar Global Controller entry. */
+export type GlobalControllerActionProps =
+  PropsRuntime<'sidebar.footer.action'>
+  & PropsLocale<typeof NS>
+  & {
+    /** Read the current session catalog through the framework-bound hook. */
+    useSessions: SnapshotSelectorHook<SessionListState>
+    /** Read the current workspace catalog through the framework-bound hook. */
+    useWorkspaces: SnapshotSelectorHook<WorkspaceListState>
+    /** Open the existing Host-owned Global Controller session. */
+    open: (sessionId: SessionId) => void
+    /** Open the workspace-scoped Project Controller through the Host Remote. */
+    openProjectController: (workspaceId: WorkspaceId) => void
+    /** Read the Host-owned readiness snapshot. */
+    useReadiness: SnapshotSelectorHook<GlobalControllerReadinessState>
+    /** Read the fetched Slice 0 Health snapshot (undefined until the first refresh). */
+    useHealth: SnapshotSelectorHook<DevFrameHealthSnapshot | undefined>
+    /** Fetch a fresh Health snapshot from the Host Remote face. */
+    refreshHealth: () => void
+    /** Open a Workspace's current governed Working Plan through the Host. */
+    openMemory?: (workspaceId: WorkspaceId) => Promise<MemoryOpenResult>
+    /** Read the per-workspace authority projections through the framework-bound hook. */
+    useProjectAuthority: SnapshotSelectorHook<ProjectAuthorityState>
+    /** CAS-bind project authority for one workspace; resolves when the Remote settles. */
+    bindProjectAuthority: (workspaceId: WorkspaceId) => Promise<void>
+    /** Refresh the authority projections for the given workspaces. */
+    refreshProjectAuthority: (workspaceIds: readonly WorkspaceId[]) => void
+    /** Read the fetched Task Board projection (undefined until the first refresh). */
+    useTaskBoard: SnapshotSelectorHook<TaskBoardSnapshot>
+    /** Fetch a fresh Task Board projection from the Host Remote face. */
+    refreshTaskBoard: () => void
+    /** Read the selected task's bounded trajectory projection. */
+    useTaskTrajectory?: SnapshotSelectorHook<TaskTrajectorySnapshot>
+    /** Fetch one task's bounded trajectory through the Host Remote face. */
+    refreshTaskTrajectory?: (taskId: string) => void
+    /** Run the bounded Host-owned Global→Project governed loop. */
+    dispatchProjectLoop?: (
+      workspaceId: WorkspaceId,
+      projectRoot: string,
+      objective: string,
+      requestIdempotencyKey?: string,
+    ) => Promise<DevFrameProjectLoopTrace>
+  }
+
+/** Small robot mark for the dedicated Global Controller entry. */
+function GlobalControllerIcon({ size }: { size: number }) {
+  return (
+    <svg
+      width={size}
+      height={size}
+      viewBox="0 0 16 16"
+      fill="none"
+      aria-hidden="true"
+    >
+      <path d="M8 2v1.5" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round" />
+      <circle cx="8" cy="1.5" r=".75" fill="currentColor" />
+      <rect x="2.5" y="4" width="11" height="9" rx="2.25" stroke="currentColor" strokeWidth="1.2" />
+      <circle cx="5.75" cy="8" r="1" fill="currentColor" />
+      <circle cx="10.25" cy="8" r="1" fill="currentColor" />
+      <path d="M5.5 10.75h5" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round" />
+    </svg>
+  )
+}
+
+/** Sidebar action that opens the existing profile-scoped Global Controller session. */
+export function GlobalControllerAction({
+  wide, useSessions, useWorkspaces, useReadiness, useHealth, refreshHealth,
+  open, openProjectController, useProjectAuthority, bindProjectAuthority,
+  refreshProjectAuthority, useTaskBoard, refreshTaskBoard, useTaskTrajectory,
+  refreshTaskTrajectory, t,
+  dispatchProjectLoop, openMemory,
+}: GlobalControllerActionProps) {
+  const readiness = useReadiness(state => state)
+  const readySessionId = readinessSessionId(readiness)
+  const globalSessionId = useSessions(state => (
+    readySessionId !== undefined && state.ids.includes(readySessionId)
+      ? readySessionId
+      : undefined
+  ))
+  const currentSessionId = useSessions(state => state.current)
+  const workspaceItems = useWorkspaces(state => state.items)
+  const ready = globalSessionId !== undefined
+  const current = ready && currentSessionId === globalSessionId
+  const [menuOpen, setMenuOpen] = useState(false)
+  const [healthOpen, setHealthOpen] = useState(false)
+  const [memoryOpen, setMemoryOpen] = useState(false)
+  const [projectsOpen, setProjectsOpen] = useState(false)
+  const [taskBoardOpen, setTaskBoardOpen] = useState(false)
+  const [projectLoopOpen, setProjectLoopOpen] = useState(false)
+  const runProjectLoop = dispatchProjectLoop ?? unavailableProjectLoop
+  const health = useHealth(state => state)
+  const action = (
+    <button
+      type="button"
+      className={wide ? css.action : `${css.action} ${css.collapsed}`}
+      aria-label={t('global.open')}
+      aria-current={current ? 'page' : undefined}
+      disabled={!ready}
+      onClick={() => {
+        if (globalSessionId !== undefined) open(globalSessionId)
+      }}
+    >
+      <GlobalControllerIcon size={wide ? 16 : 18} />
+      {wide && <span className={css.label}>{t('global.open')}</span>}
+      {!ready && wide && <span className={css.status}>{t('global.unavailable')}</span>}
+    </button>
+  )
+  return (
+    <div className={wide ? css.row : css.railRow}>
+      {action}
+      {wide && ready && (
+        <Menu
+          open={menuOpen}
+          onClose={() => { setMenuOpen(false) }}
+          items={[
+            { id: 'copy-session-id', label: t('global.copySessionId'), icon: <IconCopyOutline16 /> },
+            { id: 'health', label: t('global.health') },
+            { id: 'memory', label: t('global.memory') },
+            { id: 'projects', label: t('global.projectController') },
+            {
+              id: 'project-loop',
+              label: t('global.projectLoop'),
+              disabled: dispatchProjectLoop === undefined,
+            },
+            { id: 'task-board', label: t('global.taskBoard') },
+          ]}
+          onSelect={(id) => {
+            setMenuOpen(false)
+            if (id === 'copy-session-id') void writeClipboard(globalSessionId)
+            if (id === 'health') {
+              refreshHealth()
+              setHealthOpen(value => !value)
+              setMemoryOpen(false)
+              setProjectsOpen(false)
+              setTaskBoardOpen(false)
+              setProjectLoopOpen(false)
+            }
+            if (id === 'memory') {
+              refreshHealth()
+              setMemoryOpen(value => !value)
+              setHealthOpen(false)
+              setProjectsOpen(false)
+              setTaskBoardOpen(false)
+              setProjectLoopOpen(false)
+            }
+            if (id === 'projects') {
+              refreshProjectAuthority(workspaceItems.map(item => item.workspaceId))
+              setProjectsOpen(value => !value)
+              setHealthOpen(false)
+              setMemoryOpen(false)
+              setTaskBoardOpen(false)
+              setProjectLoopOpen(false)
+            }
+            if (id === 'project-loop') {
+              refreshProjectAuthority(workspaceItems.map(item => item.workspaceId))
+              setProjectLoopOpen(value => !value)
+              setHealthOpen(false)
+              setMemoryOpen(false)
+              setProjectsOpen(false)
+              setTaskBoardOpen(false)
+            }
+            if (id === 'task-board') {
+              refreshTaskBoard()
+              setTaskBoardOpen(value => !value)
+              setHealthOpen(false)
+              setMemoryOpen(false)
+              setProjectsOpen(false)
+              setProjectLoopOpen(false)
+            }
+          }}
+          portal
+          closeOnPointerLeave
+          anchor={(
+            <button
+              type="button"
+              className={css.menuButton}
+              aria-label={t('global.actions')}
+              onClick={(event) => { event.stopPropagation(); setMenuOpen(value => !value) }}
+            >
+              <IconEllipsisOutline16 />
+            </button>
+          )}
+        />
+      )}
+      {wide && healthOpen && <HealthCard health={health} t={t} />}
+      {wide && memoryOpen && (
+        <MemoryCard
+          health={health}
+          useWorkspaces={useWorkspaces}
+          openMemory={openMemory ?? (() => Promise.resolve({ opened: false, status: 'unavailable' as const }))}
+          refreshHealth={refreshHealth}
+          t={t}
+        />
+      )}
+      {wide && projectsOpen && (
+        <ProjectPicker
+          useWorkspaces={useWorkspaces}
+          openProjectController={openProjectController}
+          useProjectAuthority={useProjectAuthority}
+          bindProjectAuthority={bindProjectAuthority}
+          t={t}
+        />
+      )}
+      {wide && projectLoopOpen && (
+        <ProjectLoopPanel
+          useWorkspaces={useWorkspaces}
+          useProjectAuthority={useProjectAuthority}
+          dispatchProjectLoop={runProjectLoop}
+          available={dispatchProjectLoop !== undefined}
+          t={t}
+        />
+      )}
+      {wide && taskBoardOpen && (
+        <TaskBoardPanel
+          useTaskBoard={useTaskBoard}
+          useTaskTrajectory={useTaskTrajectory}
+          refreshTaskTrajectory={refreshTaskTrajectory}
+          t={t}
+        />
+      )}
+    </div>
+  )
+}
