index 0000000000..49af963fd4
--- /dev/null
+++ b/packages/devframe/control-session/src/authority.ts
@@ -0,0 +1,338 @@
+/**
+ * Slice 1A project-authority fold and Host bind seam.
+ *
+ * The `project-authority/bound` event is the durable, pathless record of the
+ * Host publishing project write authority over one Workspace to one profile.
+ * Locating authority is a pure fold over the session log (LAST bound event —
+ * never a fixed seq, because `agent-preset/selected` may occupy seq 1); the
+ * CAS + flush semantics live here and in {@link DevFrameControlSessions}.
+ *
+ * @module @deepseek-ai/dsh-devframe-control-session/authority
+ */
+
+import type { Session, SessionEvent } from '@deepseek-ai/dsh-session'
+import {
+  type DevFrameProjectAuthorityView,
+  type ProjectAuthorityBoundV1,
+  type ProjectControllerIdentityV1,
+} from './types.ts'
+import { ControlSessionError } from './index.ts'
+
+/** The durable event type carrying one Host-published project write authority. */
+export const PROJECT_AUTHORITY_EVENT_TYPE = 'project-authority/bound' as const
+
+const BOUND_REQUIRED_KEYS = [
+  'schemaVersion',
+  'workspaceId',
+  'profileId',
+  'resumePointer',
+  'boundRevision',
+  'boundAt',
+] as const
+const BOUND_OPTIONAL_KEYS = ['expiresAt'] as const
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return false
+  const prototype: unknown = Object.getPrototypeOf(value)
+  return prototype === Object.prototype || prototype === null
+}
+
+function isNonEmptyString(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0
+}
+
+function isEpochMs(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0
+}
+
+/**
+ * Validate one `project-authority/bound` payload with exact-key precision,
+ * mirroring the identity event's `parseIdentity` style. Any structural,
+ * typing, or seq-integrity violation is a `BOUND_INVALID` failure.
+ * @param value - the event payload to validate.
+ * @returns the validated, exact bound payload.
+ */
+function parseBoundPayload(value: unknown): ProjectAuthorityBoundV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('BOUND_INVALID')
+  const allowed = new Set<string>([...BOUND_REQUIRED_KEYS, ...BOUND_OPTIONAL_KEYS])
+  if (Object.keys(value).some(key => !allowed.has(key))) throw new ControlSessionError('BOUND_INVALID')
+  for (const key of BOUND_REQUIRED_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('BOUND_INVALID')
+  }
+  const { schemaVersion, workspaceId, profileId, resumePointer, boundRevision, boundAt } = value
+  if (schemaVersion !== 1) throw new ControlSessionError('BOUND_INVALID')
+  if (!isNonEmptyString(workspaceId) || !isNonEmptyString(profileId)) {
+    throw new ControlSessionError('BOUND_INVALID')
+  }
+  if (typeof resumePointer !== 'number' || !Number.isSafeInteger(resumePointer) || resumePointer < 0) {
+    throw new ControlSessionError('BOUND_INVALID')
+  }
+  // CAS numbering starts at 1 (first bind: lastRevision 0 + 1).
+  if (typeof boundRevision !== 'number' || !Number.isSafeInteger(boundRevision) || boundRevision < 1) {
+    throw new ControlSessionError('BOUND_INVALID')
+  }
+  if (!isEpochMs(boundAt)) throw new ControlSessionError('BOUND_INVALID')
+  const expiresAt = value.expiresAt
+  if (expiresAt !== undefined && !isEpochMs(expiresAt)) throw new ControlSessionError('BOUND_INVALID')
+  return {
+    schemaVersion: 1,
+    workspaceId,
+    profileId,
+    resumePointer,
+    boundRevision,
+    boundAt,
+    ...expiresAt === undefined ? {} : { expiresAt },
+  } as unknown as ProjectAuthorityBoundV1
+}
+
+/**
+ * Fold the LAST `project-authority/bound` event of a session log — the
+ * resumePointer anchor and CAS revision source (§10.2/§10.3). Every bound
+ * payload is validated in exact-key style and the CAS revisions must be
+ * strictly increasing; any violation is `BOUND_INVALID`.
+ * @param events - the session event log (identity + preset + bounds).
+ * @returns the last bound event and its seq, or undefined when never bound.
+ */
+export function foldProjectAuthority(
+  events: readonly SessionEvent[],
+  excludedSeqs?: ReadonlySet<number>,
+): { readonly bound: ProjectAuthorityBoundV1; readonly seq: number } | undefined {
+  let last: { bound: ProjectAuthorityBoundV1; seq: number } | undefined
+  let previousRevision = 0
+  for (const [index, event] of events.entries()) {
+    if (event.type !== PROJECT_AUTHORITY_EVENT_TYPE) continue
+    // The `seq = log.length` contiguity contract is enforced by Session on
+    // restore; re-checking here guards the fold against externally spliced logs.
+    if (event.seq !== index) throw new ControlSessionError('BOUND_INVALID')
+    // Quarantined (appended-but-not-durable) events are skipped by seq without
+    // re-indexing, keeping the contiguity check exact.
+    if (excludedSeqs !== undefined && excludedSeqs.has(event.seq)) continue
+    const bound = parseBoundPayload(event.data)
+    // Strictly decreasing revisions are corruption; EQUAL revisions are
+    // tolerated as a recovery artifact — a failed flush leaves its appended
+    // bound in the in-memory log, and the next full-session flush backfills
+    // it durably, so a retried bind can coexist with its phantom twin at the
+    // same revision. The fold is last-wins, so the newer event arbitrates.
+    if (bound.boundRevision < previousRevision) throw new ControlSessionError('BOUND_INVALID')
+    previousRevision = bound.boundRevision
+    last = { bound, seq: event.seq }
+  }
+  return last
+}
+
+/**
+ * Project the pathless authority view from a session log.
+ * @param events - the session event log.
+ * @param now - epoch-ms "now" for expiry (injected for deterministic tests).
+ * @param excludedSeqs - quarantined (appended-but-not-durable) seqs to skip.
+ * @returns bound / none / expired; an expired authority keeps its fields so a
+ *   client can show what expired and a CAS rebind can proceed.
+ */
+export function projectAuthorityView(
+  events: readonly SessionEvent[],
+  now: number = Date.now(),
+  excludedSeqs?: ReadonlySet<number>,
+): DevFrameProjectAuthorityView {
+  const folded = foldProjectAuthority(events, excludedSeqs)
+  if (folded === undefined) return { status: 'none' }
+  const { bound } = folded
+  const shared = {
+    workspaceId: bound.workspaceId,
+    profileId: bound.profileId,
+    resumePointer: bound.resumePointer,
+    boundRevision: bound.boundRevision,
+    boundAt: bound.boundAt,
+    ...bound.expiresAt === undefined ? {} : { expiresAt: bound.expiresAt },
+  }
+  if (bound.expiresAt !== undefined && bound.expiresAt < now) {
+    return { status: 'expired', ...shared }
+  }
+  return { status: 'bound', ...shared }
+}
+
+/**
+ * Assert that a live session is a Project Controller for exactly the given
+ * workspace/profile pair and that every prior bound belongs to that pair.
+ * Failures are `BOUND_INVALID` (the bind-only guard for forged or misplaced
+ * authority events; the identity itself was already validated on open).
+ * @param session - the live Project Controller session.
+ * @param workspaceId - the native Workspace id being bound.
+ * @param profileId - the Host-published profile identity.
+ */
+export function assertProjectAuthoritySession(
+  session: Session,
+  workspaceId: string,
+  profileId: string,
+): void {
+  const identities = session.events.filter(event => event.type === 'controller/identity')
+  const first = session.events[0]
+  if (identities.length !== 1
+    || first === undefined
+    || first !== identities[0]
+    || first.seq !== 0) {
+    throw new ControlSessionError('BOUND_INVALID')
+  }
+  // Re-enter the payload as unknown so the exact-key checks below see raw
+  // data, not the compile-time literal union (events come from disk).
+  const data: unknown = first.data
+  if (!isPlainRecord(data)
+    || data.schemaVersion !== 1
+    || data.role !== 'project'
+    || !isNonEmptyString(data.workspaceId)
+    || !isNonEmptyString(data.profileId)) {
+    throw new ControlSessionError('BOUND_INVALID')
+  }
+  const identity = data as unknown as ProjectControllerIdentityV1
+  if (identity.workspaceId !== workspaceId || identity.profileId !== profileId) {
+    throw new ControlSessionError('BOUND_INVALID')
+  }
+  for (const event of session.events) {
+    if (event.type !== PROJECT_AUTHORITY_EVENT_TYPE) continue
+    const bound = parseBoundPayload(event.data)
+    if (bound.workspaceId !== workspaceId || bound.profileId !== profileId) {
+      throw new ControlSessionError('BOUND_INVALID')
+    }
+  }
+}
+
+/** Input for one CAS-guarded Host bind of project write authority. */
+export interface BindProjectAuthorityOptions {
+  /** The live Project Controller session (identity-validated on open). */
+  readonly session: Session
+  /** Caller's expected last bound revision; 0 for the first bind. */
+  readonly expectedBoundRevision: number
+  /** Host-published profile identity; callers cannot choose it. */
+  readonly profileId: string
+  /** Native Workspace id being bound, matching the session identity. */
+  readonly workspaceId: string
+  /** Optional epoch-ms expiry; absent = never expires. */
+  readonly expiresAt?: number
+  /** Cancellation for the append + flush sequence. */
+  readonly signal?: AbortSignal
+  /** Durability seam: resolves true only after the append is durable. */
+  readonly flush: (session: Session) => Promise<boolean>
+}
+
+/**
+ * Host-owned CAS + flush binder for `project-authority/bound`. Binds for one
+ * Workspace are serialized on an in-process promise chain (bind is a low-rate
+ * operation); cross-process concurrency is already fenced by the single-writer
+ * Host lease. The method resolves only after the flush reports durable.
+ */
+export class ProjectAuthorityService {
+  private readonly chains = new Map<string, Promise<unknown>>()
+  /**
+   * Bound events appended but NOT yet durable (their flush failed or was
+   * aborted). They remain in the in-memory session log (Session has no
+   * rollback), but they must not project into any view or CAS fold: a
+   * phantom bound would show "bound" while never being durable and would
+   * reject a fresh client's legitimate rev-0 bind. They are dropped from
+   * folds until a later successful flush backfills them durably.
+   */
+  private readonly pending = new Map<string, readonly number[]>()
+
+  /**
+   * CAS-guard one bind and resolve only after the session flush is durable.
+   * @param options - live session, expected revision, identity, and the flush seam.
+   * @returns the pathless authority view (bound, or expired for a past expiry).
+   */
+  bind(options: BindProjectAuthorityOptions): Promise<DevFrameProjectAuthorityView> {
+    if (!Number.isSafeInteger(options.expectedBoundRevision) || options.expectedBoundRevision < 0) {
+      throw new ControlSessionError('AUTHORITY_BOUND_CONFLICT')
+    }
+    if (options.expiresAt !== undefined && !Number.isFinite(options.expiresAt)) {
+      throw new ControlSessionError('BOUND_INVALID')
+    }
+    const workspaceId = options.workspaceId
+    const prior = this.chains.get(workspaceId) ?? Promise.resolve()
+    const next = prior.then(
+      () => this.bindNow(options),
+      () => this.bindNow(options),
+    ).finally(() => {
+      if (this.chains.get(workspaceId) === next) this.chains.delete(workspaceId)
+    })
+    this.chains.set(workspaceId, next)
+    return next
+  }
+
+  /**
+   * Fold the authority projection of one session log, excluding bound events
+   * that were appended but never flushed durably (see {@link pending}).
+   * @param events - the session event log.
+   * @param workspaceId - the workspace whose pending bound events are excluded.
+   * @param now - epoch-ms "now" for expiry (injected for deterministic tests).
+   * @returns the pathless authority view.
+   */
+  view(
+    events: readonly SessionEvent[],
+    workspaceId: string,
+    now?: number,
+  ): DevFrameProjectAuthorityView {
+    const pendingEvents = this.pending.get(workspaceId)
+    if (pendingEvents === undefined || pendingEvents.length === 0) {
+      return projectAuthorityView(events, now)
+    }
+    // Skip quarantined seqs WITHOUT re-indexing: the fold's `seq === index`
+    // contiguity check must stay exact (a compressed array would misalign
+    // every later event and throw BOUND_INVALID).
+    return projectAuthorityView(events, now, new Set(pendingEvents))
+  }
+
+  private async bindNow(options: BindProjectAuthorityOptions): Promise<DevFrameProjectAuthorityView> {
+    options.signal?.throwIfAborted()
+    assertProjectAuthoritySession(options.session, options.workspaceId, options.profileId)
+    // CAS folds exclude quarantined (appended-but-not-durable) bounds so a
+    // phantom revision can neither admit a stale bind nor reject a fresh one.
+    const pendingSeqs = this.pending.get(options.workspaceId)
+    const excluded = pendingSeqs === undefined || pendingSeqs.length === 0
+      ? undefined
+      : new Set(pendingSeqs)
+    const folded = foldProjectAuthority(options.session.events, excluded)
+    const lastRevision = folded?.bound.boundRevision ?? 0
+    if (options.expectedBoundRevision !== lastRevision) {
+      // CAS miss: no append, no flush.
+      throw new ControlSessionError('AUTHORITY_BOUND_CONFLICT')
+    }
+    const boundRevision = lastRevision + 1
+    // The next event's seq is the log length; resumePointer IS this event's seq.
+    const resumePointer = options.session.seq
+    const boundAt = Date.now()
+    options.session.append(PROJECT_AUTHORITY_EVENT_TYPE, {
+      schemaVersion: 1,
+      workspaceId: options.workspaceId,
+      profileId: options.profileId,
+      resumePointer,
+      boundRevision,
+      boundAt,
+      ...options.expiresAt === undefined ? {} : { expiresAt: options.expiresAt },
+    })
+    options.signal?.throwIfAborted()
+    let durable = false
+    try {
+      durable = await options.flush(options.session)
+    } catch (failure) {
+      // The append stays in the in-memory log but is quarantined as pending
+      // (excluded from views and CAS folds) until a later flush backfills it.
+      this.quarantine(options.workspaceId, resumePointer)
+      throw new ControlSessionError('DURABILITY_FAILED', { cause: failure })
+    }
+    if (!durable) {
+      this.quarantine(options.workspaceId, resumePointer)
+      throw new ControlSessionError('DURABILITY_FAILED')
+    }
+    this.pending.delete(options.workspaceId)
+    return this.view(options.session.events, options.workspaceId)
+  }
+
+  /**
+   * Quarantine one appended-but-not-durable bound event (identified by its
+   * seq) so views and CAS folds exclude it. A later successful flush of the
+   * same session drops the quarantine.
+   * @param workspaceId - the workspace whose pending set changes.
+   * @param seq - the appended bound event's seq.
+   */
+  private quarantine(workspaceId: string, seq: number): void {
+    const pending = this.pending.get(workspaceId) ?? []
+    this.pending.set(workspaceId, [...pending, seq])
+  }
+}
