+  const expectedKeys = expected.role === 'global'
+    ? ['cwd', 'profileId', 'role', 'schemaVersion', 'sessionId']
+    : ['cwd', 'profileId', 'role', 'schemaVersion', 'sessionId', 'workspaceId']
