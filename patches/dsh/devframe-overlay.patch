+  }
+  vi.unstubAllEnvs()
+})
+
+async function harness(
+  withModel: boolean,
+  adapterMode: 'scripted' | 'review' = 'scripted',
+  reuse?: Pick<Harness, 'home' | 'projectRoot'>,
