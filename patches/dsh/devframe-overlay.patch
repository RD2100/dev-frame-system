+/** Convert only text user messages into official app-server input items. */
+export function textInputs(messages: readonly Message[]): Array<{ type: 'text'; text: string; text_elements: [] }> {
+  if (messages.length === 0) throw new CodexRuntimeError('CODEX_UNSUPPORTED_CONTENT', 'Codex requires a text step message')
+  if (messages.length > MAX_INPUT_MESSAGES) {
+    throw new CodexRuntimeError('CODEX_UNSUPPORTED_CONTENT', 'Codex received too many text messages')
+  }
+  let totalBytes = 0
+  return messages.map((message) => {
+    if (message.role !== 'user') throw new CodexRuntimeError('CODEX_UNSUPPORTED_CONTENT', 'Codex accepts user text messages only')
+    if (message.content.length === 0 || message.content.some(block => block.type !== 'text')) {
+      throw new CodexRuntimeError('CODEX_UNSUPPORTED_CONTENT', 'Codex accepts text content only')
+    }
+    const parts: string[] = []
+    let itemBytes = 0
+    for (const block of message.content) {
+      if (block.type !== 'text' || typeof block.text !== 'string') {
+        throw new CodexRuntimeError('CODEX_UNSUPPORTED_CONTENT', 'Codex accepts text content only')
+      }
+      const bytes = Buffer.byteLength(block.text, 'utf8')
+      if (itemBytes + bytes > MAX_ITEM_TEXT_BYTES || totalBytes + bytes > MAX_INPUT_TEXT_BYTES) {
+        throw new CodexRuntimeError('CODEX_UNSUPPORTED_CONTENT', 'Codex text input exceeded its bound')
+      }
+      parts.push(block.text)
+      itemBytes += bytes
+      totalBytes += bytes
+    }
+    const text = parts.join('')
+    if (itemBytes === 0 || text.length === 0) throw new CodexRuntimeError('CODEX_UNSUPPORTED_CONTENT', 'Codex rejects empty text content')
+    return { type: 'text', text, text_elements: [] }
+  })
+}
