diff --git a/packages/subprocess/subprocess-local/tests/spawn-windows.spec.ts b/packages/subprocess/subprocess-local/tests/spawn-windows.spec.ts
new file mode 100644
index 0000000000..b7196d0c4d
--- /dev/null
+++ b/packages/subprocess/subprocess-local/tests/spawn-windows.spec.ts
@@ -0,0 +1,38 @@
+import { describe, expect, it, vi } from 'vitest'
+
+const childProcessState = vi.hoisted(() => ({ calls: [] as unknown[][] }))
+
+vi.mock('node:child_process', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('node:child_process')>()
+  return {
+    ...actual,
+    spawn: (...args: Parameters<typeof actual.spawn>) => {
+      childProcessState.calls.push(args)
+      return actual.spawn(...args)
+    },
+  }
+})
+
+const { spawnSubprocess } = await import('../src/spawn.ts')
+
+describe('spawnSubprocess Windows process creation', () => {
+  it('hides the Codex child process console window', async () => {
+    childProcessState.calls.length = 0
+    const running = spawnSubprocess({
+      argv: [process.execPath, '-e', ''],
+      cwd: process.cwd(),
+      stdio: {
+        stdin: 'ignore',
+        stdout: { maxBytes: 1_000, spill: { maxBytes: 1_000 } },
+        stderr: { maxBytes: 1_000, spill: { maxBytes: 1_000 } },
+      },
+      graceMs: 1_000,
+    }, { platform: 'win32' })
+
+    await expect(running.done).resolves.toMatchObject({ exitCode: 0, signal: null })
+    const call = childProcessState.calls.at(-1)
+    expect(call?.[0]).toBe(process.execPath)
+    expect(call?.[1]).toEqual(['-e', ''])
+    expect(call?.[2]).toEqual(expect.objectContaining({ detached: false, windowsHide: true }))
+  })
+})
