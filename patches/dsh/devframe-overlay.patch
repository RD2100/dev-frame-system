+const TASK_CONTEXT_BASE_INSTRUCTION_SOURCE: ContextSourceV1 = {
+  kind: 'instruction',
+  ref: 'devframe/instruction/base-v1',
+  sha256: TASK_CONTEXT_BASE_INSTRUCTION_SHA256,
+  bytes: TASK_CONTEXT_BASE_INSTRUCTION_BYTES,
