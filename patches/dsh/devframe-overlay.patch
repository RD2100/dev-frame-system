+    ['unbound', { status: 'unbound' }],
+  ] as const)('leaves %s memory as a no-op', async (_label, value) => {
+    memory.readProjectMemory.mockResolvedValue({
+      status: value.status,
+      plan: null,
+      planSha256: null,
+      sourceSha256: null,
+      trustedForCurrentRun: false,
+    })
+    const agent = executionAgent()
+    const result = await appendMemoryRecall(
+      context(),
+      { agent, turn: 1, step: 1, signal: new AbortController().signal },
+      decision(),
+      { recallProjectPlan: vi.fn(async () => ({ status: 'current' as const, plan: 'unused' })) },
