+  const turnEnd = [...events].reverse().find((event): event is SessionEvent<'turn/end'> => event.type === 'turn/end')
+  if (turnEnd === undefined) return undefined
+  const assistant = [...events].reverse().find((event): event is SessionEvent<'assistant/message'> => (
+    event.type === 'assistant/message'
+    && event.seq < turnEnd.seq
+    && event.data.turn === turnEnd.data.turn
+  ))
+  return assistant === undefined ? undefined : { assistant, turnEnd }
