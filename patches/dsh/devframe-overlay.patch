+/**
+ * Read the post-preset tool catalog and intersect it with the executor face.
+ * A reduced deployment may not ship every standard tool; missing tools are
+ * omitted rather than turning a valid partial catalog into a setup failure.
+ */
+function availableWorkerTools(
+  agentCtx: Context,
+  agent: Agent,
+  candidates: readonly string[],
+): readonly string[] {
+  const schemas = typeof agentCtx.tools.schemas === 'function'
+    ? agentCtx.tools.schemas(agent)
+    : undefined
+  return schemas === undefined
+    ? candidates
+    : candidates.filter(name => schemas.some(schema => schema.name === name))
