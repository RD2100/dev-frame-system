+/** A drive-letter prefix (`C:` / `D:` …) marks a path-shaped reference. */
+const DRIVE_LETTER_PREFIX = /^[A-Za-z]:/
+
+/**
+ * Slice 1C-C first gate (design §12.9): a payload reference must be a
+ * non-empty, pathless id — no `/` or `\` separator and no drive-letter prefix.
+ * This runs BEFORE the 1B whitelist short-circuit and the policy slot, so a
+ * malformed reference is `TASK_PAYLOAD_UNSUPPORTED` (the "payload 引用校验"
+ * first gate) while a well-formed non-whitelisted reference falls through to
+ * the slot for policy adjudication. `fixed-test-payload` is unaffected.
+ * @param payloadRef - the caller-supplied payload reference.
+ * @returns whether the reference is a safe, pathless id.
+ */
+function isPathlessPayloadRef(payloadRef: string): boolean {
+  if (typeof payloadRef !== 'string' || payloadRef.length === 0) return false
+  // The first real capability uses a namespaced, pathless identifier. Keep
+  // arbitrary slash-shaped references rejected; only a Host-defined payload
+  // family may opt into the namespace form.
+  if (payloadRef === TASK_PAYLOAD_EXECUTE || payloadRef === TASK_PAYLOAD_REVIEW) return true
+  if (payloadRef.includes('/') || payloadRef.includes('\\')) return false
+  return !DRIVE_LETTER_PREFIX.test(payloadRef)
+}
