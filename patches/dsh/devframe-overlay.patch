+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry, { type Agent } from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import LlmRuntime, { createUserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { Session, SessionId } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import { MockAdapter, textResponse, toolCallResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+
+const memory = vi.hoisted(() => ({ readProjectMemory: vi.fn() }))
+vi.mock('../src/memory-context.ts', () => ({ readProjectMemory: memory.readProjectMemory }))
+
+import {
+  appendMemoryRecall,
+  apply,
+  type Config,
+} from '../src/memory-auto-context.ts'
+import * as memoryAutoContext from '../src/memory-auto-context.ts'
+
+const PROJECT_ROOT = 'D:/work/devframe'
+const active: Context[] = []
+
+afterEach(async () => {
+  memory.readProjectMemory.mockReset()
+  for (const ctx of active.splice(0)) await ctx.fiber.dispose()
+})
+
+function executionAgent(id = 'memory-auto-agent'): Agent {
+  const session = Session.create(SessionId(id))
+  return { session } as unknown as Agent
+}
+
+function decision(text = 'user request') {
+  return {
+    kind: 'enter' as const,
+    messages: [createUserMessage({
+      content: [{ type: 'text' as const, text }],
+      source: { kind: 'user' as const },
+    })],
+  }
+}
+
+function currentPlan(plan = 'Follow the current handoff and verify the smallest slice.') {
+  return {
+    status: 'current' as const,
+    plan,
+    planSha256: 'a'.repeat(64),
+    sourceSha256: 'b'.repeat(64),
+    trustedForCurrentRun: false as const,
+  }
+}
+
+function context(): Context {
+  return {} as Context
+}
+
+function requestText(request: { messages: readonly { content: readonly { type: string; text?: string }[] }[] }): string {
+  return request.messages
+    .flatMap(message => message.content)
+    .flatMap(block => block.type === 'text' && block.text !== undefined ? [block.text] : [])
+    .join('\n')
+}
+
+async function loopHarness(
+  adapter: MockAdapter,
+  config: Config = { enabled: true },
+): Promise<{ ctx: Context; agent: Agent }> {
+  const ctx = new Context()
+  active.push(ctx)
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(memoryAutoContext, config)
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const agent = ctx.agentLoop.create(
+    SessionId('memory-auto-loop'),
+    { provider: 'mock', model: 'mock' },
+    { cwd: PROJECT_ROOT },
+  )
+  return { ctx, agent }
+}
+
+describe('automatic governed-memory recall', () => {
+  it('appends one bounded, explicitly untrusted recall message for a current plan', async () => {
