+/**
+ * Validate and bound app-server input before it reaches the generic JSON-RPC
+ * transport. The generic transport intentionally ignores malformed lines and
+ * has an unbounded string buffer; the provider boundary must fail closed.
+ */
+class BoundedJsonlInput {
+  private readonly readable = new PassThrough()
+  private readonly frameParts: Buffer[] = []
+  private frameBytes = 0
+  private operationBytes = 0
+  private closed = false
+
+  constructor(
+    private readonly source: Readable,
+    private readonly onViolation: (error: CodexRuntimeError) => void,
+  ) {
+    source.on('data', this.onData)
+    source.on('error', this.onError)
+    source.on('end', this.onEnd)
+  }
+
+  stream(): Readable { return this.readable }
+
+  resetOperation(): void {
+    if (this.closed) return
+    if (this.frameBytes !== 0) {
+      this.violate('Codex protocol frame was incomplete')
+      return
+    }
+    this.operationBytes = 0
+  }
+
+  close(): void {
+    if (this.closed) return
+    this.closed = true
+    this.source.off('data', this.onData)
+    this.source.off('error', this.onError)
+    this.source.off('end', this.onEnd)
+    this.readable.end()
+  }
+
+  private readonly onData = (chunk: Buffer | string): void => {
+    if (this.closed) return
+    const bytes = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk)
+    let offset = 0
+    while (offset < bytes.length) {
+      const newline = bytes.indexOf(0x0a, offset)
+      const end = newline < 0 ? bytes.length : newline + 1
+      const part = bytes.subarray(offset, end)
+      if (this.frameBytes + part.length > MAX_INBOUND_FRAME_BYTES
+        || this.operationBytes + part.length > MAX_INBOUND_OPERATION_BYTES) {
+        this.violate('Codex protocol input exceeded its bound')
+        return
+      }
+      this.frameParts.push(part)
+      this.frameBytes += part.length
+      this.operationBytes += part.length
+      offset = end
+      if (newline < 0) continue
+      const frame = Buffer.concat(this.frameParts, this.frameBytes)
+      this.frameParts.length = 0
+      this.frameBytes = 0
+      if (!this.validateFrame(frame)) return
+      try {
+        this.readable.write(frame)
+      } catch {
+        this.violate('Codex protocol input failed')
+        return
+      }
+    }
+  }
+
+  private readonly onError = (): void => {
+    this.violate('Codex app-server input failed', 'CODEX_PROCESS_ERROR')
+  }
+
+  private readonly onEnd = (): void => {
+    if (this.frameBytes !== 0) {
+      this.violate('Codex protocol frame was unterminated')
+      return
+    }
+    this.violate('Codex app-server closed', 'CODEX_PROCESS_ERROR')
+  }
+
+  private validateFrame(frame: Buffer): boolean {
+    let line: string
+    try {
+      line = new TextDecoder('utf-8', { fatal: true }).decode(frame.subarray(0, frame.length - 1)).trim()
+    } catch {
+      this.violate('Codex protocol frame was not valid UTF-8')
+      return false
+    }
+    if (line.length === 0) return true
+    try {
+      const parsed: unknown = JSON.parse(line)
+      if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
+        this.violate('Codex protocol frame was invalid')
+        return false
+      }
+      return true
+    } catch {
+      this.violate('Codex protocol frame was invalid')
+      return false
+    }
+  }
+
+  private violate(message: string, code: 'CODEX_PROTOCOL_ERROR' | 'CODEX_PROCESS_ERROR' = 'CODEX_PROTOCOL_ERROR'): void {
+    if (this.closed) return
+    this.closed = true
+    this.source.off('data', this.onData)
+    this.source.off('error', this.onError)
+    this.source.off('end', this.onEnd)
+    this.readable.end()
+    this.onViolation(new CodexRuntimeError(code, message))
+  }
+}
