+import { describe, expect, it, vi } from 'vitest'
+import type {
+  ExternalAgentStartReceipt, IApiClient, SessionId, SubagentAddress,
+} from '@deepseek-ai/dsh-api-remotes/client'
+import type { ISessions } from '@deepseek-ai/dsh-client-runtime/client'
+import { MessageId } from '@deepseek-ai/dsh-llm/brand'
+import {
+  composePromptRouters, createExternalAgentSource, ExternalAgentPromptRouter,
+  parseExternalAgentPrompt,
+} from '../src/client/external-agent.ts'
+
+const parent = 'parent-session' as SessionId
+const child = 'child-session' as SessionId
+
+function sessionsDouble() {
+  const snapshot = { subagentsByParent: {} as Record<string, unknown> }
+  const refreshSubagents = vi.fn(async () => {
+    snapshot.subagentsByParent[parent] = {
+      entries: [{ kind: 'child', id: child, mode: 'continuable', label: '@codex', activity: 'running', hasChildren: false }],
+      parentAvailable: true,
+      state: 'ready',
+      error: null,
+    }
+  })
+  const openSubagent = vi.fn()
+  const sessions = {
+    list: { getSnapshot: () => snapshot },
+    refreshSubagents,
+    openSubagent,
+  } as unknown as ISessions
+  return { sessions, refreshSubagents, openSubagent }
+}
+
+function apiDouble() {
+  const start = vi.fn()
+  const api = { externalAgents: { start } } as unknown as Pick<IApiClient, 'externalAgents'>
+  return { api, start }
+}
+
+describe('external Agent prompt routing', () => {
+  it('submits the bounded payload and opens the Host-created child', async () => {
+    const { api, start } = apiDouble()
+    const { sessions, refreshSubagents, openSubagent } = sessionsDouble()
+    const receipt: ExternalAgentStartReceipt = {
+      parentSessionId: parent,
+      childSessionId: child,
+      messageId: MessageId('message-1'),
+      providerId: 'codex',
+      correlationId: 'corr-1',
+    }
+    start.mockResolvedValue({ result: { ok: true, value: receipt } })
+
+    const router = new ExternalAgentPromptRouter(api, sessions, {
+      providerIds: ['codex'],
+      requestId: () => 'corr-1',
+    })
+    await expect(router.route({ sessionId: parent, text: '@codex inspect the diff', mode: 'queue' })).resolves.toBe(true)
+    expect(start).toHaveBeenCalledWith({
+      sessionId: parent,
+      providerId: 'codex',
+      prompt: 'inspect the diff',
+      correlationId: 'corr-1',
+    })
+    expect(refreshSubagents).toHaveBeenCalledWith(parent)
+    const expected: SubagentAddress = { parentSessionId: parent, childSessionId: child, mode: 'continuable' }
+    expect(openSubagent).toHaveBeenCalledWith(expected)
+  })
+
+  it('does not claim references, unknown aliases, bare aliases, or steer sends', async () => {
+    const { api, start } = apiDouble()
+    const { sessions } = sessionsDouble()
+    const router = new ExternalAgentPromptRouter(api, sessions, { providerIds: ['codex'] })
+    for (const input of [
+      '@file/src/index.ts', '@session:abc', '@codex/file', '@unknown do work', '@codex',
+    ]) {
+      await expect(router.route({ sessionId: parent, text: input, mode: 'queue' })).resolves.toBe(false)
+    }
+    await expect(router.route({ sessionId: parent, text: '@codex do work', mode: 'steer' })).resolves.toBe(false)
+    expect(start).not.toHaveBeenCalled()
+  })
+
+  it('surfaces Host refusal instead of falling through to a normal model prompt', async () => {
+    const { api, start } = apiDouble()
+    const { sessions } = sessionsDouble()
+    start.mockResolvedValue({ result: { ok: false, error: { code: 'external-agent-provider-unavailable', message: 'Codex is unavailable' } } })
+    const router = new ExternalAgentPromptRouter(api, sessions, { providerIds: ['codex'] })
+    await expect(router.route({ sessionId: parent, text: '@codex do work', mode: 'queue' })).rejects.toThrow('Codex is unavailable')
+  })
+})
+
+describe('external Agent input source', () => {
+  it('offers only leading aliases and inserts a trailing space on pick', async () => {
+    const source = createExternalAgentSource(['codex', 'claude'])
+    const signal = new AbortController().signal
+    await expect(source.candidates({ sessionId: parent }, {
+      query: 'co', position: 'leading', signal,
+    })).resolves.toEqual([expect.objectContaining({ name: '@codex' })])
+    await expect(source.candidates({ sessionId: parent }, {
+      query: '', position: 'inline', signal,
+    })).resolves.toEqual([])
+    expect(source.onPick({
+      candidate: { name: '@codex' },
+      session: { sessionId: parent },
+      position: 'leading', via: 'menu',
+      span: { start: 0, end: 6, draftRev: 1 },
+    })).toEqual({ text: '@codex ' })
+  })
+
+  it('keeps the shared @ references parser-compatible', () => {
+    const providers = new Set(['codex'])
+    expect(parseExternalAgentPrompt('@codex review this', providers)).toEqual({
+      providerId: 'codex', prompt: 'review this',
+    })
+    expect(parseExternalAgentPrompt('@file/src/index.ts', providers)).toBeUndefined()
+    expect(parseExternalAgentPrompt('please @codex review this', providers)).toBeUndefined()
+  })
+})
+
+describe('prompt router composition', () => {
+  it('gives explicit external aliases precedence and preserves the existing router', async () => {
+    const external = { route: vi.fn().mockResolvedValue(false) }
+    const global = { route: vi.fn().mockResolvedValue(true) }
+    const composed = composePromptRouters(external, global)
+    const input = { sessionId: parent, text: 'ordinary objective', mode: 'queue' as const }
+    await expect(composed.route(input)).resolves.toBe(true)
+    expect(external.route).toHaveBeenCalledWith(input)
+    expect(global.route).toHaveBeenCalledWith(input)
+  })
+})
+
