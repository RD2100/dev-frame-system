+/**
+ * Pinned built-in openai selects Responses WebSocket for turn even when both
+ * websocket feature flags are disabled, so the local fixture accepts both the
+ * documented HTTP SSE path and the observed WebSocket path.
+ */
+async function startLoopbackResponsesFixture(text: string): Promise<LoopbackResponsesFixture> {
+  const requests: LoopbackResponsesRequest[] = []
+  const openResponses = new Set<ServerResponse>()
+  const openSockets = new Set<Duplex>()
+  const server = createServer((request, response) => {
+    openResponses.add(response)
+    response.on('close', () => { openResponses.delete(response) })
+    if (request.method !== 'POST' || request.url !== '/v1/responses') {
+      response.writeHead(404).end()
+      return
+    }
+    void readHttpBody(request).then((body) => {
+      requests.push({
+        method: request.method,
+        path: request.url,
+        headers: request.headers,
+        body: JSON.parse(body) as Record<string, unknown>,
+      })
+      response.writeHead(200, {
+        'content-type': 'text/event-stream',
+        'cache-control': 'no-cache',
+        connection: 'keep-alive',
+      })
+      for (const event of completeResponsesEvents(text)) {
+        response.write(`data: ${JSON.stringify(event)}\n\n`)
+      }
+      response.end('data: [DONE]\n\n')
+    }).catch((error: unknown) => {
+      response.destroy(error instanceof Error ? error : new Error(String(error)))
+    })
+  })
+  server.on('upgrade', (request, socket, head) => {
+    if (request.url !== '/v1/responses' || request.headers.upgrade?.toLowerCase() !== 'websocket') {
+      socket.destroy()
+      return
+    }
+    const key = request.headers['sec-websocket-key']
+    if (typeof key !== 'string') {
+      socket.destroy()
+      return
+    }
+    openSockets.add(socket)
+    socket.on('close', () => { openSockets.delete(socket) })
+    const accept = createHash('sha1').update(`${key}${WEBSOCKET_GUID}`).digest('base64')
+    socket.write([
+      'HTTP/1.1 101 Switching Protocols',
+      'Upgrade: websocket',
+      'Connection: Upgrade',
+      `Sec-WebSocket-Accept: ${accept}`,
+      '',
+      '',
+    ].join('\r\n'))
+    handleWebsocketFrames(socket, head, (payload) => {
+      requests.push({
+        method: 'GET',
+        path: request.url,
+        headers: request.headers,
+        body: JSON.parse(payload) as Record<string, unknown>,
+      })
+      for (const event of completeResponsesEvents(text)) sendWebsocketText(socket, event)
+    })
+  })
+  await new Promise<void>((resolve, reject) => {
+    server.once('error', reject)
+    server.listen(0, '127.0.0.1', () => {
+      server.off('error', reject)
+      resolve()
+    })
+  })
+  const address = server.address()
+  if (address === null || typeof address === 'string') {
+    throw new Error('loopback Responses fixture did not acquire a TCP port')
+  }
+  return {
+    baseUrl: `http://127.0.0.1:${address.port}/v1`,
+    requests,
+    async close(): Promise<void> {
+      for (const response of openResponses) response.destroy()
+      for (const socket of openSockets) socket.destroy()
+      server.closeAllConnections()
+      await new Promise<void>((resolve, reject) => {
+        server.close((error) => {
+          if (error !== undefined) reject(error)
+          else resolve()
+        })
+      })
+    },
+  }
+}
+
+function prompt(text: string): Message {
+  return {
+    id: `message-${text}` as Message['id'],
+    role: 'user',
+    content: [{ type: 'text', text }],
+    source: { kind: 'user' },
+  }
+}
+
+function tomlArray(values: string[]): string {
+  return `[${values.map(value => JSON.stringify(value)).join(', ')}]`
+}
+
+function markerCommand(markerPath: string): string {
+  return [
+    'const fs = require("node:fs")',
+    `const marker = ${JSON.stringify(markerPath)}`,
+    'fs.writeFileSync(marker, "spawned\\n")',
+  ].join(';')
+}
+
+function writeMaliciousCodexConfig(
+  home: string,
+  baseUrl: string,
+  notifierMarker: string,
+  mcpMarker: string,
+): void {
+  writeFileSync(join(home, 'config.toml'), [
+    'model_provider = "openai"',
+    `openai_base_url = "${baseUrl}"`,
+    'cli_auth_credentials_store = "ephemeral"',
+    'approval_policy = "never"',
+    'sandbox_mode = "read-only"',
+    'disable_response_storage = true',
+    'check_for_update_on_startup = false',
+    // The fixed production argv must replace this command with notify=[].
+    `notify = ${tomlArray([process.execPath, '-e', markerCommand(notifierMarker)])}`,
+    '',
+    '[analytics]',
+    'enabled = false',
+    '',
+    // This valid stdio entry is the regression canary: the pinned app-server
+    // currently starts it from ambient/project config despite feature flags.
+    '[mcp_servers.ambient-marker]',
+    `command = ${JSON.stringify(process.execPath)}`,
+    `args = ${tomlArray(['-e', markerCommand(mcpMarker)])}`,
+    '',
+  ].join('\n'))
+}
+
+function withParentCodexHome<T>(ambientCodexHome: string, action: () => T): T {
+  const previous = process.env.CODEX_HOME
+  process.env.CODEX_HOME = ambientCodexHome
+  try {
+    return action()
+  } finally {
+    if (previous === undefined) delete process.env.CODEX_HOME
+    else process.env.CODEX_HOME = previous
+  }
+}
+
+function ambientExecutorFindings(notifierMarker: string, mcpMarker: string): string[] {
+  const findings: string[] = []
+  if (existsSync(notifierMarker)) findings.push('notify')
+  if (existsSync(mcpMarker)) findings.push('mcp_servers.ambient-marker')
+  return findings
+}
+
+function assertAmbientExecutorFence(notifierMarker: string, mcpMarker: string): void {
+  const findings = ambientExecutorFindings(notifierMarker, mcpMarker)
+  if (findings.length > 0) {
+    throw new Error(`P0 ambient executor fence violation: spawned ${findings.join(', ')}`)
+  }
+}
+
+interface RawAmbientDiagnosticResult {
+  readonly notifications: string[]
+  readonly notifierSpawned: boolean
+  readonly mcpSpawned: boolean
+}
+
+async function waitForAmbientMarker(
+  notifierMarker: string,
+  mcpMarker: string,
+  timeoutMs: number,
+): Promise<void> {
+  const deadline = Date.now() + timeoutMs
+  while (!existsSync(notifierMarker) && !existsSync(mcpMarker) && Date.now() < deadline) {
+    await new Promise<void>(resolve => setTimeout(resolve, 25))
+  }
+}
+
+async function runRawAmbientDiagnostic(options: {
+  readonly subprocess: LocalSubprocessRuntime
+  readonly argv: string[]
+  readonly cwd: string
+  readonly env: Record<string, string>
+  readonly workspace: string
+  readonly notifierMarker: string
+  readonly mcpMarker: string
+}): Promise<RawAmbientDiagnosticResult> {
+  const child = options.subprocess.spawn({
+    argv: options.argv,
+    cwd: options.cwd,
+    stdio: { stdin: 'pipe', stdout: 'pipe', stderr: { maxBytes: 64_000 } },
+    graceMs: 2_000,
+    env: options.env,
+  })
+  handles.push(child)
+  expect(child.pid).toBeGreaterThan(0)
+  const managedPid = child.pid
+  expect(child.stdin).toBeDefined()
+  expect(child.stdout).toBeDefined()
+  const notifications: string[] = []
+  const transport = new JsonRpcLineTransport(child.stdout!, child.stdin!)
+  let diagnosticError: unknown
+  try {
+    transport.onNotification((method) => { notifications.push(method) })
+    transport.start()
+    const request = (method: string, params: object): Promise<unknown> => (
+      transport.request(method, params, AbortSignal.timeout(5_000))
+    )
+    await request('initialize', {
+      clientInfo: { name: 'deepseek-harness-ambient-diagnostic', title: 'DeepSeek Harness', version: '0.1.0' },
+      capabilities: { experimentalApi: false, requestAttestation: false },
+    })
+    transport.notify('initialized')
+    await transport.flush()
+    await request('account/login/start', {
+      type: 'apiKey', apiKey: 'dsh-test-only-loopback-key',
+    })
+    await request('thread/start', {
+      model: 'gpt-5.5',
+      modelProvider: 'openai',
+      cwd: options.workspace,
+      approvalPolicy: 'never',
+      sandbox: 'read-only',
+      ephemeral: false,
+    })
+    await waitForAmbientMarker(options.notifierMarker, options.mcpMarker, 2_000)
+  } catch (error: unknown) {
+    diagnosticError = error
+  } finally {
+    transport.close()
+    child.terminate()
+    expect(await child.waitForExit()).toBe(true)
+    expect(processIsAlive(managedPid)).toBe(false)
+    await child.done.catch(() => {})
+  }
+  const result = {
+    notifications,
+    notifierSpawned: existsSync(options.notifierMarker),
+    mcpSpawned: existsSync(options.mcpMarker),
+  }
+  if (diagnosticError !== undefined) {
+    const diagnosticMessage = diagnosticError instanceof Error
+      ? diagnosticError.message
+      : typeof diagnosticError === 'string' ? diagnosticError : 'non-error diagnostic failure'
+    throw new Error(
+      `raw ambient diagnostic failed: ${diagnosticMessage}`
+      + ` notifications=${notifications.join(',') || 'none'}`
+      + ` markers=${ambientExecutorFindings(options.notifierMarker, options.mcpMarker).join(',') || 'none'}`,
+      { cause: diagnosticError },
+    )
+  }
+  return result
+}
+
+async function isLoopbackPortFree(port: number): Promise<boolean> {
+  const server = createServer()
+  return await new Promise<boolean>((resolve) => {
+    const onError = (error: NodeJS.ErrnoException): void => {
+      server.off('listening', onListening)
+      server.close(() => { resolve(error.code !== 'EADDRINUSE') })
+    }
+    const onListening = (): void => {
+      server.off('error', onError)
+      server.close((error) => { resolve(error === undefined) })
+    }
+    server.once('error', onError)
+    server.once('listening', onListening)
+    server.listen({ host: '127.0.0.1', port, exclusive: true })
+  })
+}
+
+function loopbackCodexAppServerArgv(baseUrl: string): string[] {
+  const argv = codexAppServerArgv().slice()
+  const appServerIndex = argv.indexOf('app-server')
+  if (appServerIndex < 0) throw new Error('codex app-server argv is missing app-server')
+  argv.splice(appServerIndex, 0, '-c', `openai_base_url="${baseUrl}"`)
+  return argv
+}
