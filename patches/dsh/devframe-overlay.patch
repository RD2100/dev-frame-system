+
+const active: Context[] = []
+
+afterEach(async () => {
+  for (const ctx of active.splice(0)) await ctx.fiber.dispose()
+})
+
+const CWD = 'C:\\work\\dev-frame-system'
+
+function expectedCommandPrefix(): string[] {
+  return process.platform === 'win32'
+    ? [
+      'C:\\tools\\node.exe',
+      'C:\\tools\\node_modules\\@colbymchenry\\codegraph\\npm-shim.js',
+    ]
+    : ['C:\\tools\\codegraph']
+}
+
+function agent(cwd: string = CWD): Agent {
+  const session = {
+    id: SessionId(`codegraph-context-${Math.random()}`),
+    header: { cwd },
+  }
+  return { id: session.id, session } as unknown as Agent
+}
+
+function statusPayload(
+  pendingChanges: { added: number; modified: number; removed: number } = { added: 0, modified: 0, removed: 0 },
+): string {
+  return JSON.stringify({
+    initialized: true,
+    projectPath: CWD,
+    pendingChanges,
+    fileCount: 4,
+    nodeCount: 8,
+    edgeCount: 3,
+  })
+}
+
+function contextPayload(): string {
+  return JSON.stringify({
+    query: 'project route',
+    summary: 'Found 2 relevant code symbols across 2 files.',
+    nodes: [
+      {
+        id: 'function:one',
+        kind: 'function',
+        name: 'resolveProject',
+        filePath: 'packages/app/project.ts',
+        startLine: 10,
+        endLine: 20,
+      },
+      {
+        id: 'file:two',
+        kind: 'file',
+        name: 'project.ts',
+        filePath: 'packages/app/project.ts',
+      },
+    ],
+    edges: [
+      { id: 'edge:one', source: 'function:one', target: 'file:two', kind: 'contains' },
+    ],
+    codeBlocks: [],
+    relatedFiles: ['packages/app/project.ts'],
+    stats: { nodeCount: 2, edgeCount: 1, fileCount: 1, truncated: false },
+  })
+}
+
+type FakeResponse = {
+  readonly text: string
+  readonly exitCode?: number | null
+  readonly signal?: NodeJS.Signals | null
+  readonly waitForExit?: boolean
+}
+
+function fakeHandle(response: FakeResponse): SubprocessHandle {
+  return {
+    pid: 1,
+    stdin: undefined,
+    stdout: undefined,
+    stderr: undefined,
+    collected: {
+      stdout: {
+        readFrom: () => ({
+          text: response.text,
+          nextOffset: Buffer.byteLength(response.text),
+          lossy: false,
+        }),
+      },
+    },
+    done: Promise.resolve({ exitCode: response.exitCode ?? 0, signal: response.signal ?? null }),
+    terminate: () => undefined,
+    waitForExit: async () => response.waitForExit ?? true,
+  }
+}
+
+async function mount(options: {
+  readonly responses?: FakeResponse[]
+  readonly workspace?: { id: string; path: string; title: string }
+  readonly includeSubprocess?: boolean
+  readonly includeRegistry?: boolean
+} = {}) {
+  const ctx = new Context()
+  active.push(ctx)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  const calls: SubprocessSpawnSpec[] = []
+  const responses = [...(options.responses ?? [{ text: statusPayload() }, { text: contextPayload() }])]
+  if (options.includeRegistry !== false) {
+    ctx.provide('workspaceRegistry', {
+      resolveByPath: async () => options.workspace ?? { id: 'workspace-1', path: CWD, title: 'dev-frame-system' },
+    })
+  }
+  if (options.includeSubprocess !== false) {
+    ctx.provide('subprocess', {
+      resolveExecutable: async (command: string) => `C:\\tools\\${command}`,
+      spawn: (spec: SubprocessSpawnSpec) => {
+        calls.push(spec)
+        const response = responses.shift()
+        if (response === undefined) throw new Error('unexpected subprocess call')
+        return fakeHandle(response)
+      },
+    } as unknown as SubprocessRuntime)
+  }
+  const fiber = await ctx.plugin(codegraphContext)
+  return { ctx, fiber, calls }
+}
+
+async function call(ctx: Context, caller: Agent, task = 'project route'): Promise<ToolExecutionResult> {
+  return ctx.tools.execute({
+    name: 'devframe_codegraph_context',
+    arguments: { task },
+    callId: CallId(`call-${Math.random()}`),
+    signal: new AbortController().signal,
+    agent: caller,
+  })
+}
+
+function value(result: ToolExecutionResult): Record<string, unknown> {
+  expect(result.isError).toBe(false)
+  if (result.isError) throw new Error('expected successful tool result')
+  const block = result.content[0]
+  if (block?.type !== 'text') throw new Error('expected text result')
+  return JSON.parse(block.text) as Record<string, unknown>
+}
+
+describe('DevFrame CodeGraph context tool', () => {
+  it('registers guidance and disposes its model-facing tool', async () => {
+    const mounted = await mount()
+    expect(mounted.ctx.tools.schemas().map(schema => schema.name)).toContain('devframe_codegraph_context')
+    expect(mounted.ctx.tools.get('devframe_codegraph_context')?.presentCall?.({ task: 'project route' })).toEqual({
+      card: 'generic', title: 'Read CodeGraph context', kind: 'read',
+    })
+    const section = (await mounted.ctx.systemPrompt.assemble()).sections.find(
+      item => item.name === 'tool:devframe-codegraph-context',
+    )
+    expect(section?.text).toContain('status-preflighted')
+    expect(section?.text).toContain('never initializes')
+
+    await mounted.fiber.dispose()
+    expect(mounted.ctx.tools.get('devframe_codegraph_context')).toBeUndefined()
+  })
+
+  it('runs status before context with fixed no-code argv and returns stale untrusted context', async () => {
+    const mounted = await mount({
+      responses: [{ text: statusPayload({ added: 0, modified: 1, removed: 0 }) }, { text: contextPayload() }],
+    })
+    const output = value(await call(mounted.ctx, agent()))
+    expect(output).toMatchObject({
+      status: 'matched',
+      workspace: { id: 'workspace-1', title: 'dev-frame-system' },
+      freshness: 'stale',
+      trustedForCurrentRun: false,
+      summary: 'Found 2 relevant code symbols across 2 files.',
+      stats: { nodeCount: 2, edgeCount: 1, fileCount: 1, truncated: false },
+    })
+    expect(output.nodes).toEqual([
+      { id: 'function:one', kind: 'function', label: 'resolveProject', source: 'packages/app/project.ts', startLine: 10, endLine: 20 },
+      { id: 'file:two', kind: 'file', label: 'project.ts', source: 'packages/app/project.ts' },
+    ])
+    expect(output.edges).toEqual([{ id: 'edge:one', source: 'function:one', target: 'file:two', kind: 'contains' }])
+    expect(mounted.calls.map(call => call.argv)).toEqual([
+      [...expectedCommandPrefix(), 'status', '--json', CWD],
+      [...expectedCommandPrefix(), 'context', '--format', 'json', '--max-nodes', '32', '--no-code', '--path', CWD, 'project route'],
+    ])
+    expect(mounted.calls.every(call => call.stdio.stdin === 'ignore')).toBe(true)
+    expect(JSON.stringify(output)).not.toContain(CWD)
+  })
+
+  it('honors the bounded node argument and rejects status failure before context', async () => {
+    const mounted = await mount({ responses: [{ text: 'status failed', exitCode: 1 }] })
+    const output = value(await call(mounted.ctx, agent()))
+    expect(output).toMatchObject({ status: 'unavailable', error: 'status_failed', nodes: [], edges: [] })
+    expect(mounted.calls).toHaveLength(1)
+
+    const bounded = await mount({
+      responses: [{ text: statusPayload() }, { text: contextPayload() }],
+    })
+    const boundedResult = await bounded.ctx.tools.execute({
+      name: 'devframe_codegraph_context',
+      arguments: { task: 'project route', max_nodes: 7 },
+      callId: CallId('bounded'),
+      signal: new AbortController().signal,
+      agent: agent(),
+    })
+    expect(value(boundedResult)).toMatchObject({ status: 'matched' })
+    expect(bounded.calls[1]?.argv).toContain('--max-nodes')
+    expect(bounded.calls[1]?.argv).toContain('7')
+  })
+
+  it('fails closed for malformed, unsafe, missing-service, and unbound calls', async () => {
+    const malformed = await mount({ responses: [{ text: statusPayload() }, { text: JSON.stringify({ nodes: [], edges: [], codeBlocks: ['raw'] }) }] })
+    const malformedAgent = agent()
+    const malformedResult = await call(malformed.ctx, malformedAgent)
+    expect(value(malformedResult).error).toBe('context_invalid')
+
+    const unsafe = await mount({ responses: [{ text: statusPayload() }, { text: JSON.stringify({ nodes: [{ id: 'file:one', kind: 'file', filePath: 'C:\\private\\secret.ts' }], edges: [], relatedFiles: [], codeBlocks: [] }) }] })
+    const unsafeAgent = agent()
+    const unsafeResult = await call(unsafe.ctx, unsafeAgent)
+    expect(value(unsafeResult).error).toBe('context_invalid')
+
+    const missing = await mount({ includeSubprocess: false })
+    expect(value(await call(missing.ctx, agent())).error).toBe('service_unavailable')
+
+    const unbound = await mount({ includeRegistry: false })
+    expect(value(await call(unbound.ctx, agent())).error).toBe('service_unavailable')
+  })
+
+  it('does not spawn when the caller is already aborted', async () => {
+    const mounted = await mount()
+    const controller = new AbortController()
+    controller.abort()
+    const aborted = await mounted.ctx.tools.execute({
+      name: 'devframe_codegraph_context',
+      arguments: { task: 'project route' },
+      callId: CallId('aborted'),
+      signal: controller.signal,
+      agent: agent(),
+    })
+    expect(aborted.isError).toBe(true)
+    expect(aborted.error?.info).toMatchObject({ code: 'ABORTED_BEFORE_DISPATCH' })
+    expect(mounted.calls).toHaveLength(0)
+  })
+
+  it('is reachable through a real Loader composition', async () => {
+    const baseConfig = fileURLToPath(new URL('../../../../apps/cli/tests/fixtures/memory-mcp-base.cordis.yml', import.meta.url))
