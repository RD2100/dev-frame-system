+import type { Context } from '@deepseek-ai/cordis'
+import type { MemoryRecallResult } from '@deepseek-ai/dsh-devframe-control-session'
+import { describe, expect, it, vi } from 'vitest'
+import {
+  apply,
+  readProjectMemory,
+  type MemoryContextValue,
+} from '../src/memory-context.ts'
+
+const PROJECT_ROOT = 'D:/work/devframe'
+const PROJECT_ID = 'workspace-123'
+
+function context(registry?: { resolveByPath(path: string): Promise<unknown> }): Context {
+  return {
+    get(key: string) {
+      return key === 'workspaceRegistry' ? registry : undefined
+    },
+  } as unknown as Context
+}
+
+function execution(cwd?: string): { signal: AbortSignal; agent?: { session: { header: { cwd?: string } } } } {
+  return {
+    signal: new AbortController().signal,
+    ...cwd === undefined ? {} : { agent: { session: { header: { cwd } } } },
+  }
+}
+
+type MemoryGateway = {
+  readonly recallProjectPlan: (request: {
+    readonly projectId: string
+    readonly projectRoot: string
+    readonly signal?: AbortSignal
+  }) => Promise<MemoryRecallResult>
+}
+
+function gateway(result: MemoryRecallResult): MemoryGateway {
+  return { recallProjectPlan: vi.fn(async _request => result) }
+}
+
+describe('devframe memory context', () => {
+  it('derives the active workspace and returns only bounded advisory fields', async () => {
+    const resolveByPath = vi.fn(async () => ({ id: PROJECT_ID, path: PROJECT_ROOT }))
+    const adapter = gateway({
+      status: 'current',
+      plan: 'Follow the current handoff and verify the smallest slice.',
+      relativePath: 'wiki/memories/should-not-be-returned.md',
+      planSha256: 'a'.repeat(64),
+      sourceSha256: 'b'.repeat(64),
+    })
+
+    const value = await readProjectMemory(
+      context({ resolveByPath }),
+      execution(PROJECT_ROOT),
+      adapter,
+    )
+
+    expect(value).toEqual<MemoryContextValue>({
+      status: 'current',
+      plan: 'Follow the current handoff and verify the smallest slice.',
+      planSha256: 'a'.repeat(64),
+      sourceSha256: 'b'.repeat(64),
+      trustedForCurrentRun: false,
+    })
+    expect(resolveByPath).toHaveBeenCalledWith(PROJECT_ROOT)
+    expect(adapter.recallProjectPlan).toHaveBeenCalledWith(expect.objectContaining({
+      projectId: PROJECT_ID,
+      projectRoot: PROJECT_ROOT,
+    }))
+    expect(JSON.stringify(value)).not.toContain('wiki/memories')
+  })
+
+  it.each([
+    ['missing', { status: 'missing' }],
+    ['stale', { status: 'stale' }],
+  ] as const)('preserves a non-current status without plan content (%s)', async (_label, result) => {
+    const adapter = gateway(result)
+    const value = await readProjectMemory(
+      context({ resolveByPath: vi.fn(async () => ({ id: PROJECT_ID, path: PROJECT_ROOT })) }),
+      execution(PROJECT_ROOT),
+      adapter,
+    )
+
+    expect(value).toEqual({
+      status: result.status,
+      plan: null,
+      planSha256: null,
+      sourceSha256: null,
+      trustedForCurrentRun: false,
+    })
+  })
+
+  it('fails closed as unbound before touching the memory gateway', async () => {
+    const resolveByPath = vi.fn(async () => undefined)
+    const adapter = gateway({ status: 'current', plan: 'unexpected' })
+
+    await expect(readProjectMemory(context({ resolveByPath }), execution(PROJECT_ROOT), adapter))
+      .resolves.toMatchObject({ status: 'unbound', plan: null })
+    expect(adapter.recallProjectPlan).not.toHaveBeenCalled()
+  })
+
+  it.each([
+    ['missing cwd', execution()],
+    ['relative cwd', execution('relative/project')],
+  ])('does not resolve or spawn for %s', async (_label, exec) => {
+    const resolveByPath = vi.fn(async () => ({ id: PROJECT_ID, path: PROJECT_ROOT }))
+    const adapter = gateway({ status: 'current', plan: 'unexpected' })
+
+    await expect(readProjectMemory(context({ resolveByPath }), exec, adapter))
+      .resolves.toMatchObject({ status: 'unbound', plan: null })
+    expect(resolveByPath).not.toHaveBeenCalled()
+    expect(adapter.recallProjectPlan).not.toHaveBeenCalled()
+  })
+
+  it('degrades when the registry or the canonical gateway is unavailable', async () => {
+    await expect(readProjectMemory(context(), execution(PROJECT_ROOT), gateway({ status: 'current', plan: 'x' })))
+      .resolves.toMatchObject({ status: 'unavailable', plan: null })
+
+    const failing: MemoryGateway = {
+      recallProjectPlan: vi.fn(async (_request) => { throw new Error('offline') }),
+    }
+    await expect(readProjectMemory(
+      context({ resolveByPath: vi.fn(async () => ({ id: PROJECT_ID, path: PROJECT_ROOT })) }),
+      execution(PROJECT_ROOT),
+      failing,
+    )).resolves.toMatchObject({ status: 'unavailable', plan: null })
+  })
+
+  it('registers one explicit no-argument tool and no automatic callback', () => {
+    let registered: { name: string; parameters: unknown; description: string } | undefined
+    const sections: string[] = []
+    const ctx = {
+      systemPrompt: { section: vi.fn(({ name, text }: { name: string; text: string }) => sections.push(`${name}:${text}`)) },
+      tools: { register: vi.fn((tool: typeof registered) => { registered = tool }) },
+    } as unknown as Context
+
+    apply(ctx)
+
+    expect(registered?.name).toBe('devframe_memory_context')
+    expect(registered?.parameters).toEqual({ type: 'object', properties: {} })
+    expect(registered?.description).toContain('Takes no arguments')
+    expect(sections.join('\n')).toContain('does not inject memory automatically')
+  })
+})
