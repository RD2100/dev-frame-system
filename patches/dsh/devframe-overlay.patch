+
+  it('fails open for malformed recall payloads and invalid direct bounds', async () => {
+    const agent = executionAgent()
+    const gateway = { recallProjectPlan: vi.fn(async () => ({ status: 'current' as const, plan: 'unused' })) }
+    memory.readProjectMemory.mockResolvedValue({
