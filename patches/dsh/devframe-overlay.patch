+/** Public types for the direct Codex subscription runtime. */
+
+import type { AgentStepRuntime, AgentStepRuntimeInput } from '@deepseek-ai/dsh-agent'
+import type { SessionEventMap } from '@deepseek-ai/dsh-session'
+
+/** The only provider route owned by this package. */
+export const CODEX_SUBSCRIPTION_PROVIDER = 'codex-subscription' as const
+
+/** Protocol version pinned by the package's official-process tests. */
+export const CODEX_APP_SERVER_PROTOCOL = 'v2' as const
+
+/** Maximum bytes retained from an app-server stderr stream. */
+export const CODEX_STDERR_MAX_BYTES = 64_000
+
+/** Bounded model descriptor projected from `model/list`. */
+export interface CodexModelDescriptor {
+  readonly id: string
+  readonly displayName: string
+  readonly hidden: boolean
+  readonly reasoning: boolean
+  readonly supportedReasoningEfforts: readonly string[]
+  /** Catalog default; present only when it is one of the supported efforts. */
+  readonly defaultReasoningEffort?: string
+  readonly isDefault: boolean
+}
+
+/** Sanitized account availability facts; no email or credential material. */
+export interface CodexAccountAvailability {
+  readonly available: boolean
+  readonly authKind: 'chatgpt' | 'apiKey' | 'none' | 'unknown'
+  readonly planType?: 'free' | 'plus' | 'pro' | 'business' | 'edu' | 'enterprise' | 'unknown'
+  readonly requiresOpenaiAuth: boolean
+  readonly errorCode?: 'not-authenticated' | 'unsupported-account' | 'protocol-error' | 'transport-error'
+}
+
+/** Dynamic capability snapshot for a later Host consumer. */
+export interface CodexSubscriptionCapabilities {
+  readonly account: CodexAccountAvailability
+  readonly models: readonly CodexModelDescriptor[]
+}
+
+/** DSH-owned state for one native ChatGPT OAuth attempt. */
+export type CodexLoginState = 'pending' | 'completed' | 'cancelled' | 'failed'
+
+/** Sanitized terminal failure categories for the login control plane. */
+export type CodexLoginErrorCode =
+  | 'CODEX_LOGIN_NOT_FOUND'
+  | 'CODEX_LOGIN_ALREADY_ACTIVE'
+  | 'CODEX_LOGIN_PROTOCOL_ERROR'
+  | 'CODEX_LOGIN_PROCESS_ERROR'
+  | 'CODEX_LOGIN_CANCELLED'
+
+/** The only login material returned by the Service start operation. */
+export interface CodexLoginStartResult {
+  readonly attemptId: string
+  readonly authUrl: string
+}
+
+/** Bounded, sanitized login status. The official login id is never exposed. */
+export interface CodexLoginStatus {
+  readonly attemptId: string
+  readonly state: CodexLoginState
+  readonly errorCode?: CodexLoginErrorCode
+}
+
+/** Provider configuration; authentication and command selection are not configurable. */
+export interface CodexSubscriptionConfig {
+  readonly disposeGraceMs?: number
+}
+
+/** Stable provider-owned failure categories. */
+export type CodexRuntimeFailureCode =
+  | 'CODEX_NOT_AUTHENTICATED'
+  | 'CODEX_UNSUPPORTED_ACCOUNT'
+  | 'CODEX_PROTOCOL_ERROR'
+  | 'CODEX_PROCESS_ERROR'
+  | 'CODEX_RESUME_REQUIRED'
+  | 'CODEX_RESUME_MISMATCH'
+  | 'CODEX_UNSUPPORTED_CONTENT'
+  | 'CODEX_SYSTEM_CHANGED'
+  | 'CODEX_CONCURRENT_TURN'
+  | 'CODEX_CANCELLED'
+  | 'CODEX_LOGIN_NOT_FOUND'
+  | 'CODEX_LOGIN_ALREADY_ACTIVE'
+  | 'CODEX_LOGIN_PROTOCOL_ERROR'
+  | 'CODEX_LOGIN_PROCESS_ERROR'
+  | 'CODEX_LOGIN_CANCELLED'
+
+/** Provider-owned error with no raw wire, path, account, or stderr fields. */
+export class CodexRuntimeError extends Error {
+  readonly code: CodexRuntimeFailureCode
+
+  constructor(code: CodexRuntimeFailureCode, message: string) {
+    super(message)
+    this.name = 'CodexRuntimeError'
+    this.code = code
+  }
+}
+
+/** Payload for the durable thread binding record. */
+export interface CodexThreadBoundEvent {
+  readonly threadId: string
+  readonly provider: typeof CODEX_SUBSCRIPTION_PROVIDER
+  /** Model used when the durable Codex thread was created; later turns may override it. */
+  readonly model: string
+  readonly protocol: typeof CODEX_APP_SERVER_PROTOCOL
+  readonly systemFingerprint: string
+}
+
+/** Payload for one durable DSH-to-Codex turn association. */
+export interface CodexTurnBoundEvent {
+  readonly turn: number
+  readonly step: number
+  readonly turnId: string
+  readonly status: 'started' | 'completed' | 'interrupted' | 'failed'
+}
+
+/** Payload for one refused app-server action. */
+export interface CodexActionRejectedEvent {
+  readonly kind: 'command' | 'file-change' | 'permissions' | 'user-input' | 'elicitation' | 'unknown'
+  readonly decision: 'cancel' | 'decline' | 'empty'
+  readonly turn: number
+  readonly step: number
+}
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    /** Log-only durable Codex thread identity; no path or credential. */
+    'codex/thread-bound': CodexThreadBoundEvent
+    /** Log-only DSH/Codex turn association. */
+    'codex/turn-bound': CodexTurnBoundEvent
+    /** Log-only record of an unattended server action refusal. */
+    'codex/action-rejected': CodexActionRejectedEvent
+  }
+}
+
+/** Internal runtime factory used by the service and tests. */
+export interface CodexRuntimeFactory {
+  readonly provider: typeof CODEX_SUBSCRIPTION_PROVIDER
+  readonly metadata: AgentStepRuntime['metadata']
+  stream(input: AgentStepRuntimeInput): AsyncIterable<import('@deepseek-ai/dsh-llm').StreamChunk>
+}
+
+/** Return a compile-time reference to keep event declaration side effects loaded. */
+export type CodexSessionEvent = SessionEventMap[keyof SessionEventMap]
