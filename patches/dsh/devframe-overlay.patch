+import type {
+  ChatConversationViewNode, ConversationNodeDefinition,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import type { ObjectiveChangeV1 } from '@deepseek-ai/dsh-devframe-control-session/types'
+
+export type ObjectiveChatStatus = 'created' | 'routed' | 'completed' | 'cancelled'
+
+export interface ObjectiveChatData {
+  readonly objectiveId: string
+  readonly text: string
+  readonly workspaceId?: string
+  readonly status: ObjectiveChatStatus
+}
+
+interface ObjectiveState {
+  readonly objectiveId: string
+  readonly text: string
+  readonly workspaceId?: string
+  readonly status: ObjectiveChatStatus
+}
+
+declare module '@deepseek-ai/dsh-client-ui-conversation/client' {
+  interface ChatNodeDataMap {
+    'devframe-objective': ObjectiveChatData
+  }
+}
+
+function update(state: ObjectiveState, change: ObjectiveChangeV1): ObjectiveState {
+  if (change.operation === 'route') {
+    return { ...state, workspaceId: change.workspaceId, status: 'routed' }
+  }
+  if (change.operation === 'complete' || change.operation === 'cancel') {
+    return { ...state, status: change.operation === 'complete' ? 'completed' : 'cancelled' }
+  }
+  return state
+}
+
+/** Projects the durable Global objective record into the conversation. */
+export const objectiveDefinition: ConversationNodeDefinition<ObjectiveState> = {
+  kind: 'devframe-objective',
+  target: 'chat',
+  match: (event) => {
+    if (event.type !== 'objective/change') return null
+    return {
+      id: event.data.objectiveId,
+      role: event.data.operation === 'create' ? 'start' : 'update',
+    }
+  },
+  start: (_context, match) => {
+    if (match.event.type !== 'objective/change' || match.event.data.operation !== 'create') {
+      throw new Error('devframe-objective start requires objective create')
+    }
+    return {
+      objectiveId: match.event.data.objectiveId,
+      text: match.event.data.text,
+      status: 'created',
+    }
+  },
+  update: (context, match) => {
+    if (match.event.type !== 'objective/change') return context.state
+    return update(context.state, match.event.data)
+  },
+  buildViewNode: (context): ChatConversationViewNode | null => {
+    if (context.start === undefined || context.state === undefined) return null
+    return {
+      key: context.key,
+      kind: 'devframe-objective',
+      id: context.id,
+      target: 'chat',
+      anchorSeq: context.start.event.seq,
+      location: context.start.location,
+      visibility: 'visible',
+      data: context.state,
+    }
+  },
+}
