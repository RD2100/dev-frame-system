+import { fileURLToPath } from 'node:url'
+import { join } from 'node:path'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import type { Browser, Page } from 'playwright'
+import { chromium } from 'playwright'
+import { expect, describe, it, beforeAll, afterAll, onTestFailed } from 'vitest'
+import type { DevFrameMemoryGateway } from '@deepseek-ai/dsh-devframe-control-session'
+import {
+  assertFixtureInventory,
+  captureStableAria,
+  compareOrRefreshGolden,
+  launchWebScaffold,
+  watchConsole,
+  webSnapshotMode,
+  type WebScaffold,
+} from './scaffold.ts'
+import { connectFreshWorkspace, newEnglishPage, saveFailureShot } from './support.ts'
+
+const DEVFRAME_PATCH_PATH = fileURLToPath(
+  new URL('../../../packages/bundle/devframe/cordis.patch.yml', import.meta.url),
+)
+const SNAPSHOT_DIR = fileURLToPath(new URL('./snapshots/memory-opener', import.meta.url))
+const SNAPSHOT_PATH = join(SNAPSHOT_DIR, 'ui.expected.md')
+const MODE = webSnapshotMode()
+
+async function assertNoViteOverlay(page: Page): Promise<void> {
+  expect(await page.locator('vite-error-overlay').count()).toBe(0)
+  expect(await page.locator('[data-vite-error-overlay]').count()).toBe(0)
+}
+
+describe('web e2e: Host-owned memory opener', () => {
+  let scaffold: WebScaffold
+  let browser: Browser
+  let page: Page
+  let tripwire: ReturnType<typeof watchConsole>
+  let globalBootstrap: { stop(): Promise<void> } | undefined
+  let memoryRoot: string | undefined
+  const originalMemoryRoot = process.env.DEVFRAME_OBSIDIAN_MEMORY_ROOT
+  let nativeFailure = false
+  const nativeCalls: string[] = []
+  const consoleErrors: string[] = []
+
+  const memoryGateway: DevFrameMemoryGateway = {
+    recallProjectPlan: async () => ({
+      status: 'current',
+      relativePath: 'wiki/memories/project-now-current.md',
+      plan: 'Bounded assembled memory opener test.',
+    }),
+    captureProjectCheckpoint: async () => ({
+      status: 'captured',
+      memoryId: 'b'.repeat(64),
+    }),
+  }
+
+  beforeAll(async () => {
+    memoryRoot = await mkdtemp(join(tmpdir(), 'dsh-web-memory-vault-'))
+    process.env.DEVFRAME_OBSIDIAN_MEMORY_ROOT = memoryRoot
+    scaffold = await launchWebScaffold({
+      extraOverlayPath: DEVFRAME_PATCH_PATH,
+      testMemoryGateway: memoryGateway,
+      testNativeOpen: async (path) => {
+        nativeCalls.push(path)
+        if (nativeFailure) throw new Error('assembled native opener unavailable')
+      },
+    })
