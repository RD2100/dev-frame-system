+/**
+ * Resolve the semantic idempotency key embedded in one fixed test payload
+ * message (design §11.5): the Host tracks delivered messages by this key so a
+ * redelivered physical message can be recognized and its claim/start/report
+ * observations adjudicated. Foreign messages resolve to undefined.
+ * @param message - the delivered user message.
+ * @returns the embedded semantic key, or undefined when not a fixed payload.
+ */
+function payloadSemanticKey(message: UserMessage): string | undefined {
+  for (const block of message.content) {
+    if (block.type !== 'text') continue
+    try {
+      const parsed: unknown = JSON.parse(block.text)
+      if (isPlainRecord(parsed)
+        && typeof parsed.semanticMessageId === 'string'
+        && parsed.semanticMessageId.length > 0) {
+        return parsed.semanticMessageId
+      }
+    } catch {
+      // Not one of the Host's fixed payloads; leave it untracked.
+    }
+  }
+  return undefined
+}
