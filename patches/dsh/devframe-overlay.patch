@@ -0,0 +1,213 @@
+/**
+ * Test-only Codex app-server v2 fixture. It is a protocol peer, not a login
+ * implementation and never reads Codex auth/config files or credentials.
+ */
+
+import { createInterface } from 'node:readline'
+import { spawn } from 'node:child_process'
+import { writeFileSync } from 'node:fs'
+
+const threadId = 'fixture-thread'
+let turnNumber = 0
+let activeTurnId
+let activeTimer
+const delayMs = Number(process.env.DSH_TEST_FIXTURE_DELAY_MS ?? '0')
+const terminalDelayMs = Number(process.env.DSH_TEST_FIXTURE_TERMINAL_DELAY_MS ?? '0')
+const delayTurnStartMs = Number(process.env.DSH_TEST_FIXTURE_DELAY_TURN_START_MS ?? '0')
+const crashAfterStart = process.env.DSH_TEST_FIXTURE_CRASH_AFTER_START === '1'
+const resumeMismatch = process.env.DSH_TEST_FIXTURE_RESUME_MISMATCH === '1'
+const resumeFailure = process.env.DSH_TEST_FIXTURE_RESUME_FAILURE === '1'
+const invalidThreadId = process.env.DSH_TEST_FIXTURE_INVALID_THREAD_ID === '1'
+const accountProtocolError = process.env.DSH_TEST_FIXTURE_ACCOUNT_PROTOCOL_ERROR === '1'
+const accountMissing = process.env.DSH_TEST_FIXTURE_ACCOUNT_MISSING === '1'
+const hangAccount = process.env.DSH_TEST_FIXTURE_HANG_ACCOUNT === '1'
+const ignoreInterrupt = process.env.DSH_TEST_FIXTURE_IGNORE_INTERRUPT === '1'
+const allowModelSwitch = process.env.DSH_TEST_FIXTURE_ALLOW_MODEL_SWITCH === '1'
+const descendantMarker = process.env.DSH_TEST_DESCENDANT_MARKER
+const loginCompletion = process.env.DSH_TEST_LOGIN_COMPLETION ?? 'pending'
+const loginDelayMs = Number(process.env.DSH_TEST_LOGIN_DELAY_MS ?? '0')
+const loginStartDelayMs = Number(process.env.DSH_TEST_LOGIN_START_DELAY_MS ?? '0')
+const loginCompletionId = process.env.DSH_TEST_LOGIN_COMPLETION_ID ?? 'fixture-login-id'
+const loginError = process.env.DSH_TEST_LOGIN_ERROR ?? null
+const loginCrash = process.env.DSH_TEST_LOGIN_CRASH === '1'
+const loginAuthUrlKind = process.env.DSH_TEST_LOGIN_AUTH_URL_KIND ?? 'valid'
+const expectedThreadConfig = JSON.stringify({
+  skills: { include_instructions: false },
+  project_doc_max_bytes: 0,
+  model_reasoning_summary: 'concise',
+})
+let loginTimer
+let loginStartTimer
+
+if (descendantMarker !== undefined) {
+  const descendant = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { stdio: 'ignore' })
+  writeFileSync(descendantMarker, String(descendant.pid ?? ''))
+}
+
+function send(frame) {
+  process.stdout.write(`${JSON.stringify({ jsonrpc: '2.0', ...frame })}\n`)
+}
+
+function respond(id, result) {
+  send({ id, result })
+}
+
+function notify(method, params) {
+  send({ method, params })
+}
+
+function request(id, method, params) {
+  send({ id, method, params })
+}
+
+function rejectUnexpectedThreadConfig(frame) {
+  if (JSON.stringify(frame.params?.config) === expectedThreadConfig) return false
+  send({ id: frame.id, error: { code: -32602, message: 'fixture thread config mismatch' } })
+  return true
+}
+
+const input = createInterface({ input: process.stdin })
+input.on('line', (line) => {
+  let frame
+  try {
+    frame = JSON.parse(line)
+  } catch {
+    return
+  }
+  if (!frame || typeof frame !== 'object' || typeof frame.method !== 'string') return
+  const method = frame.method
+  if (method === 'initialize') {
+    respond(frame.id, { userAgent: 'dsh-codex-fixture' })
+    return
+  }
+  if (method === 'account/login/start') {
+    const authUrls = {
+      valid: 'https://auth.openai.com/oauth/authorize?client_id=dsh-fixture&redirect_uri=http%3A%2F%2Flocalhost%3A1455%2Fauth%2Fcallback&state=fixture',
+      redirect1457: 'https://auth.openai.com/oauth/authorize?client_id=dsh-fixture&redirect_uri=http%3A%2F%2Flocalhost%3A1457%2Fauth%2Fcallback&state=fixture',
+      origin: 'https://auth.openai.com/codex/login?fixture=1',
+      path: 'https://auth.openai.com/oauth/login?client_id=dsh-fixture&redirect_uri=http%3A%2F%2Flocalhost%3A1455%2Fauth%2Fcallback&state=fixture',
+      redirect: 'https://auth.openai.com/oauth/authorize?client_id=dsh-fixture&redirect_uri=http%3A%2F%2Flocalhost%3A9999%2Fauth%2Fcallback&state=fixture',
+      credentials: 'https://user:pass@auth.openai.com/oauth/authorize?client_id=dsh-fixture&redirect_uri=http%3A%2F%2Flocalhost%3A1455%2Fauth%2Fcallback&state=fixture',
+      hash: 'https://auth.openai.com/oauth/authorize?client_id=dsh-fixture&redirect_uri=http%3A%2F%2Flocalhost%3A1455%2Fauth%2Fcallback&state=fixture#secret',
+      scheme: 'http://auth.openai.com/oauth/authorize?client_id=dsh-fixture&redirect_uri=http%3A%2F%2Flocalhost%3A1455%2Fauth%2Fcallback&state=fixture',
+      long: `https://auth.openai.com/oauth/authorize?client_id=dsh-fixture&redirect_uri=http%3A%2F%2Flocalhost%3A1455%2Fauth%2Fcallback&state=${'x'.repeat(5000)}`,
+    }
+    const completeStart = () => {
+      loginStartTimer = undefined
+      respond(frame.id, { type: 'chatgpt', loginId: 'fixture-login-id', authUrl: authUrls[loginAuthUrlKind] ?? authUrls.valid })
+      if (loginCrash) {
+        setTimeout(() => process.exit(19), loginDelayMs)
+      } else if (loginCompletion !== 'pending') {
+        loginTimer = setTimeout(() => {
+          notify('account/login/completed', {
+            loginId: loginCompletionId,
+            success: loginCompletion === 'success',
+            error: loginError,
+          })
+        }, loginDelayMs)
+      }
+    }
+    if (loginStartDelayMs > 0) loginStartTimer = setTimeout(completeStart, loginStartDelayMs)
+    else completeStart()
+    return
+  }
+  if (method === 'account/login/cancel') {
+    if (loginStartTimer !== undefined) clearTimeout(loginStartTimer)
+    loginStartTimer = undefined
+    if (loginTimer !== undefined) clearTimeout(loginTimer)
+    respond(frame.id, {})
+    notify('account/login/completed', { loginId: 'fixture-login-id', success: false, error: 'cancelled by fixture' })
+    return
+  }
+  if (method === 'thread/start') {
+    if (rejectUnexpectedThreadConfig(frame)) return
+    const startedThreadId = invalidThreadId ? 'bad\nthread' : threadId
+    const model = typeof frame.params?.model === 'string' ? frame.params.model : 'fixture-model'
+    respond(frame.id, { model, modelProvider: 'openai', thread: { id: startedThreadId, ephemeral: false } })
+    return
+  }
+  if (method === 'thread/resume') {
+    if (rejectUnexpectedThreadConfig(frame)) return
+    if (resumeFailure) {
+      send({ id: frame.id, error: { code: -32000, message: 'resume failed' } })
+      return
+    }
+    const resumedThreadId = resumeMismatch ? 'fixture-other-thread' : threadId
+    const model = typeof frame.params?.model === 'string' ? frame.params.model : 'fixture-model'
+    respond(frame.id, { model, modelProvider: 'openai', thread: { id: resumedThreadId, ephemeral: false } })
+    return
+  }
+  if (method === 'model/list') {
+    const data = [{ id: 'fixture-preset', model: 'fixture-model', displayName: 'Fixture Model', hidden: false, supportedReasoningEfforts: [{ reasoningEffort: 'minimal', description: 'Minimal' }], defaultReasoningEffort: 'minimal', isDefault: true }]
+    if (allowModelSwitch) data.push({ id: 'fixture-terra-preset', model: 'fixture-terra', displayName: 'Fixture Terra', hidden: false, supportedReasoningEfforts: [{ reasoningEffort: 'minimal', description: 'Minimal' }], defaultReasoningEffort: 'minimal', isDefault: false })
+    respond(frame.id, {
+      data,
+      nextCursor: null,
+    })
+    return
+  }
+  if (method === 'account/read') {
+    if (hangAccount) return
+    if (accountProtocolError) {
+      respond(frame.id, { account: 'invalid', requiresOpenaiAuth: false })
+      return
+    }
+    if (accountMissing) {
+      respond(frame.id, { account: null, requiresOpenaiAuth: true })
+      return
+    }
+    respond(frame.id, { account: { type: 'chatgpt', email: null, planType: 'pro' }, requiresOpenaiAuth: false })
+    return
+  }
+  if (method === 'turn/start') {
+    turnNumber += 1
+    const turnId = `fixture-turn-${turnNumber}`
+    activeTurnId = turnId
+    const respondAndRun = () => {
+      respond(frame.id, { turn: { id: turnId, status: 'inProgress' } })
+      activeTimer = setTimeout(() => {
+        if (crashAfterStart) {
+          process.exit(17)
+        }
+        notify('turn/started', { threadId, turn: { id: turnId, status: 'inProgress' } })
+        request(`approval-${turnId}`, 'item/commandExecution/requestApproval', {
+          threadId, turnId, availableDecisions: ['decline'],
+        })
+        const itemId = `item-${turnId}`
+        notify('item/started', {
+          threadId, turnId, item: { type: 'agentMessage', id: itemId, phase: 'final_answer' },
+        })
+        notify('item/agentMessage/delta', { threadId, turnId, itemId, delta: 'fixture reply' })
+        const completeTurn = () => {
+          notify('item/completed', {
+            threadId, turnId, completedAtMs: Date.now(),
+            item: { type: 'agentMessage', id: itemId, text: 'fixture reply', phase: 'final_answer', memoryCitation: null },
+          })
+          notify('turn/completed', { threadId, turn: { id: turnId, status: 'completed' } })
+          activeTurnId = undefined
+          activeTimer = undefined
+        }
+        if (terminalDelayMs > 0) activeTimer = setTimeout(completeTurn, terminalDelayMs)
+        else completeTurn()
+      }, delayMs)
+    }
+    activeTimer = setTimeout(respondAndRun, delayTurnStartMs)
+    return
+  }
+  if (method === 'turn/interrupt') {
+    if (ignoreInterrupt) return
+    if (activeTimer !== undefined) clearTimeout(activeTimer)
+    if (activeTurnId !== undefined) {
+      notify('turn/completed', { threadId, turn: { id: activeTurnId, status: 'interrupted' } })
+      activeTurnId = undefined
+      activeTimer = undefined
+    }
+    respond(frame.id, {})
+    return
+  }
+  if (method === 'thread/unsubscribe') {
+    respond(frame.id, {})
+    return
+  }
+  respond(frame.id, {})
+})
