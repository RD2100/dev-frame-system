index 0000000000..49e4391e54
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/TaskBoardPanel.tsx
@@ -0,0 +1,151 @@
+import type { TaskBoardTaskView } from '@deepseek-ai/dsh-devframe-control-session/types'
+import type { SnapshotSelectorHook, TranslateNS } from '@deepseek-ai/dsh-client-ui-slots'
+import type { TaskBoardSnapshot, TaskTrajectorySnapshot } from './task-board-store.ts'
+import { NS } from './locales.ts'
+import css from './TaskBoardPanel.module.css'
+
+/** Props for the Task Board panel (design §11.3: six-state machine + terminals). */
+export interface TaskBoardPanelProps {
+  /** Read the fetched Task Board projection (undefined until the first refresh). */
+  useTaskBoard: SnapshotSelectorHook<TaskBoardSnapshot>
+  /** Read the selected task's bounded trajectory projection, when available. */
+  useTaskTrajectory?: SnapshotSelectorHook<TaskTrajectorySnapshot> | undefined
+  /** Fetch one task's bounded trajectory through the Host Remote. */
+  refreshTaskTrajectory?: ((taskId: string) => void) | undefined
+  t: TranslateNS<typeof NS>
+}
+
+/**
+ * State → badge style: every state and terminal gets its own visual.
+ * Values are `string | undefined` because the aggregate build enables
+ * `noUncheckedIndexedAccess`; the record is exhaustive over every state.
+ */
+const STATE_CLASS: Record<TaskBoardTaskView['state'], string | undefined> = {
+  queued: css.badgeQueued,
+  admitted: css.badgeAdmitted,
+  acknowledged: css.badgeAcknowledged,
+  claimed: css.badgeClaimed,
+  started: css.badgeStarted,
+  reported: css.badgeReported,
+  failed: css.badgeFailed,
+  cancelled: css.badgeCancelled,
+}
+
+const EVALUATION_CLASS: Record<NonNullable<TaskBoardTaskView['evaluation']>['outcome'], string | undefined> = {
+  pass: css.evaluationPass,
+  revise: css.evaluationRevise,
+  fail: css.evaluationFail,
+}
+
+const EVALUATION_LABEL: Record<NonNullable<TaskBoardTaskView['evaluation']>['outcome'], 'task.evaluation.pass' | 'task.evaluation.revise' | 'task.evaluation.fail'> = {
+  pass: 'task.evaluation.pass',
+  revise: 'task.evaluation.revise',
+  fail: 'task.evaluation.fail',
+}
+
+/** One folded task row: references only — never message bodies (hard stop §11.8). */
+function TaskRow({
+  task,
+  trajectory,
+  refreshTaskTrajectory,
+  t,
+}: {
+  task: TaskBoardTaskView
+  trajectory?: TaskTrajectorySnapshot | undefined
+  refreshTaskTrajectory?: ((taskId: string) => void) | undefined
+  t: TranslateNS<typeof NS>
+}) {
+  const trajectoryRefs = task.evaluation?.trajectoryRefs ?? task.reportRef?.trajectoryRefs ?? []
+  const trajectorySelected = trajectory?.taskId === task.taskId
+  return (
+    <li className={css.row}>
+      <span className={css.head}>
+        <span className={css.taskId}>{task.taskId}</span>
+        <span className={`${css.badge} ${STATE_CLASS[task.state]}`}>{t(`task.state.${task.state}`)}</span>
+        {task.evaluation !== undefined && (
+          <span className={`${css.badge} ${EVALUATION_CLASS[task.evaluation.outcome]}`}>
+            {t(EVALUATION_LABEL[task.evaluation.outcome])}
+          </span>
+        )}
+      </span>
+      <span className={css.meta}>
+        <span className={css.field}>
+          <span className={css.caption}>{t('task.worker')}</span> {task.workerId}
+        </span>
+        <span className={css.field}>
+          <span className={css.caption}>{t('task.semanticMessage')}</span> {task.semanticMessageId}
+        </span>
+        <span className={css.field}>
+          <span className={css.caption}>{t('task.payloadRef')}</span> {task.payloadRef}
+        </span>
+        {task.messageId !== undefined && (
+          <span className={css.field}>
+            <span className={css.caption}>{t('task.replyRef')}</span> {task.messageId}
+          </span>
+        )}
+      </span>
+      {refreshTaskTrajectory !== undefined && trajectoryRefs.length > 0 && (
+        <button
+          type="button"
+          className={css.trajectoryButton}
+          aria-pressed={trajectorySelected}
+          onClick={() => { refreshTaskTrajectory(task.taskId) }}
+        >
+          {t('task.trajectory.open')}
+        </button>
+      )}
+      {trajectorySelected && (
+        <div className={css.trajectory} role="group" aria-label={t('task.trajectory.title')}>
+          <span className={css.trajectorySummary}>
+            {t('task.trajectory.count')}: {trajectory.view.items.length}
+          </span>
+          <ul className={css.trajectoryList}>
+            {trajectory.view.items.map(item => (
+              <li key={item.seq} className={css.trajectoryRow}>
+                <span className={css.trajectorySeq}>{item.seq}</span>
+                <span>{item.type}</span>
+                {item.provider !== undefined && <span>{item.provider}</span>}
+                {item.model !== undefined && <span>{item.model}</span>}
+                {item.toolName !== undefined && <span>{item.toolName}</span>}
+              </li>
+            ))}
+          </ul>
+        </div>
+      )}
+    </li>
+  )
+}
+
+/** Pathless Task Board panel for the Global Controller entry (design §11.3/§11.4). */
+export function TaskBoardPanel({
+  useTaskBoard,
+  useTaskTrajectory,
+  refreshTaskTrajectory,
+  t,
+}: TaskBoardPanelProps) {
+  const board = useTaskBoard(state => state)
+  const trajectory = useTaskTrajectory?.(state => state)
+  const tasks = board === undefined
+    ? []
+    : Object.values(board.tasks)
+  return (
+    <div className={css.panel} role="status">
+      <span className={css.title}>{t('global.taskBoard')}</span>
+      {tasks.length === 0
+        ? <span className={css.empty}>{t('taskBoard.empty')}</span>
+        : (
+          <ul className={css.list}>
+            {tasks.map(task => (
+              <TaskRow
+                key={task.taskId}
+                task={task}
+                trajectory={trajectory}
+                refreshTaskTrajectory={refreshTaskTrajectory}
+                t={t}
+              />
+            ))}
+          </ul>
+        )}
+    </div>
+  )
+}
diff --git a/packages/client/ui-devframe-control-session/src/client/authority.ts b/packages/client/ui-devframe-control-session/src/client/authority.ts
new file mode 100644
index 0000000000..f521ac8745
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/authority.ts
@@ -0,0 +1,94 @@
+import type { Context } from '@deepseek-ai/cordis'
+import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+import type { WorkspaceId } from '@deepseek-ai/dsh-client-runtime/client'
+import type { DevFrameProjectAuthorityView } from '@deepseek-ai/dsh-devframe-control-session/types'
+import { devframeRemoteFace, type DevFrameRemoteNamespace } from './remote-face.ts'
+
+/** Per-workspace project-authority views, keyed by native Workspace id. */
+export type ProjectAuthorityState = Record<WorkspaceId, DevFrameProjectAuthorityView | undefined>
+
+/**
+ * Owns the fetched project-authority views for the Project Controller picker.
+ *
+ * The client has no append capability and no local source of truth: bound
+ * state only ever comes from the Host Remote return value (which resolves
+ * only after a successful Session flush — design §10.2/10.3). A failed or
+ * absent remote keeps the previous view instead of fabricating a status.
+ */
+export class ProjectAuthorityStore {
+  readonly store: SnapshotStore<ProjectAuthorityState> = createSnapshotStore({})
+
+  private refreshing = false
+
+  /**
+   * Fetch the current authority projection for the given workspaces.
+   * @param ctx - browser context; the face is resolved through the non-strict
+   * `ctx.get` lookup (see `remote-face.ts`).
+   * @param workspaceIds - workspaces to refresh.
+   * @returns whether at least one fresh view was stored.
+   */
+  async refresh(ctx: Context, workspaceIds: readonly WorkspaceId[]): Promise<boolean> {
+    if (this.refreshing || workspaceIds.length === 0) return false
+    this.refreshing = true
+    try {
+      const face = this.authorityFace(ctx)
+      if (face?.projectAuthority === undefined) return false
+      let changed = false
+      const next = { ...this.store.getSnapshot() }
+      for (const workspaceId of workspaceIds) {
+        try {
+          const response = await face.projectAuthority({ workspaceId })
+          if (response.ok) {
+            next[workspaceId] = response.value
+            changed = true
+          }
+        } catch {
+          // A failed single-workspace read keeps the previous view; the
+          // picker stays honest instead of dropping to a fabricated state.
+        }
+      }
+      if (changed) this.store.set(next)
+      return changed
+    } finally {
+      this.refreshing = false
+    }
+  }
+
+  /**
+   * CAS-bind project authority for one workspace.
+   *
+   * The client does not know the current revision out of band: it proposes
+   * the last observed `boundRevision` (0 on a first bind, per design §10.2)
+   * and lets the Host CAS reconcile. A conflict (`AUTHORITY_BOUND_CONFLICT`)
+   * or rejection re-reads the true state so the UI surfaces the newest view
+   * instead of a stale guess.
+   * @param ctx - browser context; the face is resolved through the non-strict
+   * `ctx.get` lookup.
+   * @param workspaceId - the workspace to bind.
+   * @returns whether the bind succeeded (remote returned a fresh bound view).
+   */
+  async bind(ctx: Context, workspaceId: WorkspaceId): Promise<boolean> {
+    const face = this.authorityFace(ctx)
+    if (face?.bindProjectAuthority === undefined) return false
+    const current = this.store.getSnapshot()[workspaceId]
+    const expectedBoundRevision = current?.boundRevision ?? 0
+    const response = await face.bindProjectAuthority({ workspaceId, expectedBoundRevision })
+    if (response.ok) {
+      this.store.update((draft) => { draft[workspaceId] = response.value })
+      return true
+    }
+    await this.refresh(ctx, [workspaceId])
+    return false
+  }
+
+  /**
+   * Resolve the Host Remote face. The generated namespace (regenerated with
+   * the Slice 1A remotes) already carries `bindProjectAuthority` /
+   * `projectAuthority`; the face is the standard non-strict lookup.
+   * @param ctx - browser context.
+   * @returns the generated face, or `undefined` when the Remote is not mounted.
+   */
+  private authorityFace(ctx: Context): DevFrameRemoteNamespace | undefined {
+    return devframeRemoteFace(ctx)
+  }
+}
diff --git a/packages/client/ui-devframe-control-session/src/client/definition.ts b/packages/client/ui-devframe-control-session/src/client/definition.ts
new file mode 100644
index 0000000000..8854e8fc10
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/definition.ts
@@ -0,0 +1,124 @@
+import type {
+  ChatConversationViewNode,
+  ConversationMatch,
+  ConversationNodeContext,
+  ConversationNodeDefinition,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import type { ControllerIdentityV1 } from '@deepseek-ai/dsh-devframe-control-session/types'
+import type { SessionEvent, SessionEventType } from '@deepseek-ai/dsh-session/types'
+import type { ControlSessionKey } from './locales.ts'
+
+declare module '@deepseek-ai/dsh-client-ui-conversation/client' {
+  interface ChatNodeDataMap {
+    'devframe-controller-identity': ControllerIdentityView
+  }
+}
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    'client-ui-devframe-control-session': ControlSessionKey
+  }
+}
+
+/** Privacy-bounded projection of one controller identity event. */
+export interface ControllerIdentityView {
+  readonly role: ControllerIdentityV1['role'] | 'unknown'
+  readonly sessionId: string
+  readonly scopeId: string
+  readonly schemaVersion: 1
+  readonly readiness: 'identity-recorded' | 'blocked'
+}
+
+const IDENTITY_EVENT_TYPE = 'controller/identity' as SessionEventType
+const ID_PART_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return false
+  const prototype = Reflect.getPrototypeOf(value)
+  return prototype === Object.prototype || prototype === null
+}
+
+function exactKeys(value: Record<string, unknown>, expected: readonly string[]): boolean {
+  const actual = Object.keys(value).sort()
+  const wanted = [...expected].sort()
+  return actual.length === wanted.length && actual.every((key, index) => key === wanted[index])
+}
+
+function validIdPart(value: unknown): value is string {
+  return typeof value === 'string' && ID_PART_PATTERN.test(value)
+}
+
+function blockedIdentity(): ControllerIdentityView {
+  return {
+    role: 'unknown',
+    sessionId: '',
+    scopeId: '',
+    schemaVersion: 1,
+    readiness: 'blocked',
+  }
+}
+
+function projectIdentity(value: unknown): ControllerIdentityView {
+  if (!isPlainRecord(value)
+    || value.schemaVersion !== 1
+    || !validIdPart(value.profileId)) return blockedIdentity()
+
+  if (value.role === 'global'
+    && exactKeys(value, ['cwd', 'profileId', 'role', 'schemaVersion', 'sessionId'])
+    && typeof value.cwd === 'string'
+    && value.cwd.length > 0
+    && value.sessionId === `devframe-global:${value.profileId}`) {
+    return {
+      role: 'global',
+      sessionId: value.sessionId,
+      scopeId: value.profileId,
+      schemaVersion: 1,
+      readiness: 'identity-recorded',
+    }
+  }
+
+  if (value.role === 'project'
+    && exactKeys(value, ['cwd', 'profileId', 'role', 'schemaVersion', 'sessionId', 'workspaceId'])
+    && typeof value.cwd === 'string'
+    && value.cwd.length > 0
+    && validIdPart(value.workspaceId)
+    && value.sessionId === `devframe-controller:${value.workspaceId}`) {
+    return {
+      role: 'project',
+      sessionId: value.sessionId,
+      scopeId: value.workspaceId,
+      schemaVersion: 1,
+      readiness: 'identity-recorded',
+    }
+  }
+
+  return blockedIdentity()
+}
+
+/** Project one required identity event while excluding every unlisted field. */
+export const controllerIdentityDefinition: ConversationNodeDefinition<ControllerIdentityView> = {
+  kind: 'devframe-controller-identity',
+  target: 'chat',
+  match: (event: SessionEvent) => event.type === IDENTITY_EVENT_TYPE && event.seq === 0
+    ? { id: `controller-identity:${event.seq}`, role: 'start' }
+    : null,
+  start: (_context: ConversationNodeContext<ControllerIdentityView>, match: ConversationMatch) =>
+    projectIdentity(match.event.data),
+  update: context => context.state,
+  publication: () => 'none',
+  buildViewNode: (context: ConversationNodeContext<ControllerIdentityView>) => {
+    const start = context.start
+    if (start === undefined) return null
+    const node: ChatConversationViewNode = {
+      key: context.key,
+      kind: context.kind,
+      id: context.id,
+      target: 'chat',
+      data: context.state,
+      anchorSeq: start.event.seq,
+      location: start.location,
+      visibility: 'visible',
+    }
+    return node
+  },
+}
diff --git a/packages/client/ui-devframe-control-session/src/client/external-agent.ts b/packages/client/ui-devframe-control-session/src/client/external-agent.ts
new file mode 100644
index 0000000000..86a4c36f84
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/external-agent.ts
@@ -0,0 +1,170 @@
+/** Browser-side direct `@provider` routing for Host-owned external Agents. */
+
+import type { IApiClient } from '@deepseek-ai/dsh-api-remotes/client'
+import type {
+  ExternalAgentStartReceipt, SubagentAddress, SessionId,
+} from '@deepseek-ai/dsh-api-remotes/client'
+import type { ClientContext, ISessions } from '@deepseek-ai/dsh-client-runtime/client'
+import type {
+  CandidateRequest, ClientSessionContext, InputTriggerCandidate, InputTriggerPick, InputTriggerSource,
+} from '@deepseek-ai/dsh-client-ui-input-trigger/client'
+import type {
+  ConversationPromptRouter, InputSubmitMode,
+} from '@deepseek-ai/dsh-client-ui-conversation/client'
+
+/**
+ * Stable aliases exposed by the DevFrame menu; executables stay Host-owned.
+ *
+ * Keep the default list limited to aliases that are actually registered with
+ * the continuable Host capability. A missing registration remains fail-closed
+ * at the routing boundary; provider executables and environments stay Host-owned.
+ */
+export const EXTERNAL_AGENT_PROVIDER_IDS = ['codex', 'claude', 'opencode'] as const
+
+const PROVIDER_ID = /^[a-z0-9][a-z0-9._-]{0,63}$/u
+
+/** Narrow input accepted by the router, kept separate from the trigger source. */
+export interface ExternalAgentPromptRouterOptions {
+  /** Provider aliases offered to the user and accepted by this router. */
+  readonly providerIds?: readonly string[]
+  /** Injectable id generator for deterministic unit tests. */
+  readonly requestId?: () => string
+}
+
+type ExternalAgentPromptInput = {
+  readonly sessionId: SessionId
+  readonly text: string
+  readonly mode: InputSubmitMode
+}
+
+/** Parse one leading `@provider prompt` line without consuming file/session mentions. */
+export function parseExternalAgentPrompt(
+  text: string,
+  providerIds: ReadonlySet<string>,
+): { providerId: string; prompt: string } | undefined {
+  const line = text.trim()
+  const match = /^@([a-z0-9][a-z0-9._-]{0,63})\s+([\s\S]+)$/u.exec(line)
+  if (match === null) return undefined
+  const providerId = match[1]
+  const rawPrompt = match[2]
+  if (providerId === undefined || rawPrompt === undefined) return undefined
+  const prompt = rawPrompt.trim()
+  if (!providerIds.has(providerId) || prompt === '') return undefined
+  return { providerId, prompt }
+}
+
+function requestId(): string {
+  return globalThis.crypto.randomUUID()
+}
+
+function providerSet(ids: readonly string[]): ReadonlySet<string> {
+  const accepted = new Set<string>()
+  for (const id of ids) if (PROVIDER_ID.test(id)) accepted.add(id)
+  return accepted
+}
+
+/**
+ * Routes a known leading provider token through the Host start seam, then
+ * opens the returned durable child through the normal Session catalog path.
+ */
+export class ExternalAgentPromptRouter implements ConversationPromptRouter {
+  private readonly providers: ReadonlySet<string>
+  private readonly makeRequestId: () => string
+
+  constructor(
+    private readonly api: Pick<IApiClient, 'externalAgents'>,
+    private readonly sessions: ISessions,
+    options: ExternalAgentPromptRouterOptions = {},
+  ) {
+    this.providers = providerSet(options.providerIds ?? EXTERNAL_AGENT_PROVIDER_IDS)
+    this.makeRequestId = options.requestId ?? requestId
+  }
+
+  /** Handle only queue submissions; steer sends remain native Session behavior. */
+  async route(input: ExternalAgentPromptInput): Promise<boolean> {
+    if (input.mode !== 'queue') return false
+    const parsed = parseExternalAgentPrompt(input.text, this.providers)
+    if (parsed === undefined) return false
+
+    const response = await this.api.externalAgents.start({
+      sessionId: input.sessionId,
+      providerId: parsed.providerId,
+      prompt: parsed.prompt,
+      correlationId: this.makeRequestId(),
+    })
+    if (!response.result.ok) {
+      throw new Error(response.result.error.message)
+    }
+    await this.openChild(input.sessionId, response.result.value)
+    return true
+  }
+
+  private async openChild(parentSessionId: SessionId, receipt: ExternalAgentStartReceipt): Promise<void> {
+    await this.sessions.refreshSubagents(parentSessionId)
+    const catalog = this.sessions.list.getSnapshot().subagentsByParent[parentSessionId]
+    const child = catalog?.entries.find(
+      entry => entry.kind === 'child' && entry.id === receipt.childSessionId,
+    )
+    if (child?.kind !== 'child' || child.mode !== 'continuable') {
+      throw new Error('The external Agent was accepted but its Session is not ready to open.')
+    }
+    const address: SubagentAddress = {
+      parentSessionId,
+      childSessionId: receipt.childSessionId,
+      mode: 'continuable',
+    }
+    this.sessions.openSubagent(address)
+  }
+}
+
+/**
+ * The `@` source only advertises leading provider aliases. The existing
+ * reference source remains the owner of `@file` and `@session` candidates.
+ */
+export function createExternalAgentSource(
+  providerIds: readonly string[] = EXTERNAL_AGENT_PROVIDER_IDS,
+): InputTriggerSource {
+  const providers = providerSet(providerIds)
+  return {
+    trigger: '@',
+    name: 'external-agent',
+    order: -10,
+    candidates(_session: ClientSessionContext, request: CandidateRequest) {
+      if (request.position !== 'leading') return Promise.resolve([])
+      const query = request.query
+      return Promise.resolve([...providers]
+        .filter(id => id.startsWith(query))
+        .map((id): InputTriggerCandidate => ({
+          name: `@${id}`,
+          description: 'Start a controlled external Agent',
+        })))
+    },
+    onPick(pick: InputTriggerPick) {
+      if (pick.position !== 'leading') return undefined
+      const id = pick.candidate.name.slice(1)
+      return pick.candidate.name.startsWith('@') && providers.has(id) ? { text: `@${id} ` } : undefined
+    },
+  }
+}
+
+/** Preserve existing prompt routers while giving explicit external aliases precedence. */
+export function composePromptRouters(
+  ...routers: readonly ConversationPromptRouter[]
+): ConversationPromptRouter {
+  return {
+    async route(input: ExternalAgentPromptInput) {
+      for (const router of routers) if (await router.route(input)) return true
+      return false
+    },
+  }
+}
+
+/** Register the `@` source in a client context. */
+export function registerExternalAgentSource(
+  ctx: ClientContext,
+  source: InputTriggerSource = createExternalAgentSource(),
+): () => void {
+  const inputTriggers = ctx.get('inputTriggers', false)
+  if (inputTriggers === undefined) throw new Error('ui-devframe-control-session: inputTriggers service unavailable')
+  return inputTriggers.registerSource(source)
+}
diff --git a/packages/client/ui-devframe-control-session/src/client/global-preset-store.ts b/packages/client/ui-devframe-control-session/src/client/global-preset-store.ts
new file mode 100644
index 0000000000..8337fb6937
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/global-preset-store.ts
@@ -0,0 +1,166 @@
+import type { IApiClient } from '@deepseek-ai/dsh-api-remotes/client'
+import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+
+/** One live roster row shown by the Global Controller selector. */
+export interface GlobalPresetOption {
+  readonly id: string
+  readonly trust: 'system' | 'user'
+  readonly name?: string
+  readonly description?: string
+  readonly broken?: string
+}
+
+/** Bounded, user-safe failure categories for roster and switch operations. */
+export type GlobalPresetErrorKind = 'roster' | 'switch'
+export type GlobalPresetErrorCode = 'transport' | 'rejected' | 'unavailable' | 'unknown'
+
+/** No Host or transport text crosses the Client/UI boundary. */
+export interface GlobalPresetError {
+  readonly kind: GlobalPresetErrorKind
+  readonly code: GlobalPresetErrorCode
+}
+
+/** Roster-backed state for the Global Controller header selector. */
+export interface GlobalPresetState {
+  readonly status: 'idle' | 'loading' | 'ready' | 'saving' | 'error' | 'unavailable'
+  readonly error: GlobalPresetError | null
+  readonly options: readonly GlobalPresetOption[]
+}
+
+const INITIAL: GlobalPresetState = {
+  status: 'idle',
+  error: null,
+  options: [],
+}
+
+function hostErrorCode(code: unknown): GlobalPresetErrorCode {
+  if (code === 'agent-preset-not-found' || code === 'agent-preset-invalid' || code === 'unavailable') {
+    return 'unavailable'
+  }
+  if (code === 'agent-preset-locked' || code === 'agent-preset-read-only' || code === 'rejected') {
+    return 'rejected'
+  }
+  return 'unknown'
+}
+
+function rosterError(code: GlobalPresetErrorCode): GlobalPresetError {
+  return { kind: 'roster', code }
+}
+
+function switchError(code: GlobalPresetErrorCode): GlobalPresetError {
+  return { kind: 'switch', code }
+}
+
+function failedStatus(options: readonly GlobalPresetOption[]): 'ready' | 'unavailable' {
+  return options.length === 0 ? 'unavailable' : 'ready'
+}
+
+/**
+ * Owns the live preset roster and the Host-backed Global preset switch.
+ *
+ * The current preset itself is deliberately not copied here: the session
+ * summary, folded from the Host's `agent-preset/selected` owner event, is the
+ * only source of truth for the header's selected row.
+ */
+export class GlobalPresetController {
+  readonly store: SnapshotStore<GlobalPresetState> = createSnapshotStore(INITIAL)
+
+  private loading: Promise<void> | undefined
+  private saving = false
+  private selectionRevision = 0
+
+  constructor(
+    private readonly api: Pick<IApiClient, 'agentPresets'>,
+    private readonly selectGlobalPreset: (id: string) => Promise<boolean>,
+  ) {}
+
+  /** Load the current Host roster; concurrent callers share the request. */
+  load(): Promise<void> {
+    if (this.loading !== undefined) return this.loading
+    const current = this.store.getSnapshot()
+    // A refresh of an already populated roster is deliberately non-blocking
+    // for the menu: stale options remain usable while the live list arrives.
+    // Only the first empty read enters `loading` and fail-closes the trigger.
+    this.set({
+      status: current.options.length === 0 ? 'loading' : current.status === 'saving' ? 'saving' : 'ready',
+      error: null,
+    })
+    const operation = this.read()
+    this.loading = operation
+    return operation.finally(() => {
+      if (this.loading === operation) this.loading = undefined
+    })
+  }
+
+  /** Apply one preset through the Global-only Host Remote. */
+  async select(id: string): Promise<boolean> {
+    if (this.saving) return false
+    const current = this.store.getSnapshot()
+    const option = current.options.find(entry => entry.id === id)
+    if (option === undefined || option.broken !== undefined) return false
+    this.selectionRevision += 1
+    this.saving = true
+    this.set({ status: 'saving', error: null })
+    try {
+      const accepted = await this.selectGlobalPreset(id)
+      if (!accepted) {
+        this.set({ status: failedStatus(current.options), error: switchError('rejected') })
+        return false
+      }
+      this.set({ status: 'ready', error: null })
+      return true
+    } catch {
+      this.set({ status: failedStatus(current.options), error: switchError('transport') })
+      return false
+    } finally {
+      this.saving = false
+    }
+  }
+
+  private set(patch: Partial<GlobalPresetState>): void {
+    this.store.set({ ...this.store.getSnapshot(), ...patch })
+  }
+
+  private async read(): Promise<void> {
+    const selectionRevision = this.selectionRevision
+    const savingAtStart = this.saving
+    try {
+      const response = await this.api.agentPresets.list({})
+      if (!response.result.ok) {
+        if (savingAtStart || this.saving || selectionRevision !== this.selectionRevision) return
+        const current = this.store.getSnapshot()
+        this.set({
+          status: current.options.length === 0 ? 'error' : 'ready',
+          error: rosterError(hostErrorCode(response.result.error.code)),
+        })
+        return
+      }
+      const options = response.result.value.presets.map(preset => ({
+        id: preset.id,
+        trust: preset.trust,
+        ...preset.name === undefined ? {} : { name: preset.name },
+        ...preset.description === undefined ? {} : { description: preset.description },
+        ...preset.broken === undefined ? {} : { broken: preset.broken },
+      }))
+      const current = this.store.getSnapshot()
+      if (savingAtStart || this.saving || selectionRevision !== this.selectionRevision) {
+        // A background refresh may replace stale rows, but it must not clear
+        // the switch's busy state or its bounded failure result.
+        this.set({ options, status: current.status, error: current.error })
+        return
+      }
+      this.set({
+        status: options.length === 0 ? 'unavailable' : 'ready',
+        error: null,
+        options,
+      })
+    } catch {
+      if (savingAtStart || this.saving || selectionRevision !== this.selectionRevision) return
+      const current = this.store.getSnapshot()
+      this.set({
+        status: current.options.length === 0 ? 'error' : 'ready',
+        error: rosterError('transport'),
+      })
+    }
+  }
+}
diff --git a/packages/client/ui-devframe-control-session/src/client/global-prompt-router.ts b/packages/client/ui-devframe-control-session/src/client/global-prompt-router.ts
new file mode 100644
index 0000000000..926cf65e19
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/global-prompt-router.ts
@@ -0,0 +1,68 @@
+import type {
+  ClientContext, ISessions, IWorkspaces, SessionId, WorkspaceId,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import { devframeRemoteFace } from './remote-face.ts'
+
+type GlobalPromptMode = 'queue' | 'steer'
+
+/** One explicit Global composer target. Empty means work outside a project. */
+export interface GlobalPromptTarget {
+  readonly workspaceId?: WorkspaceId
+}
+
+function requestKey(): string {
+  return globalThis.crypto.randomUUID()
+}
+
+/**
+ * Routes only explicitly targeted Global queue submissions into the Host's
+ * model-independent Project Loop Remote. Ordinary sessions, steer sends, and
+ * Global outside-project sends return false so the native Session prompt path
+ * is untouched.
+ */
+export class GlobalPromptRouter {
+  private workspaceId: WorkspaceId | undefined
+
+  constructor(private readonly ctx: ClientContext) {}
+
+  setTarget(target: GlobalPromptTarget): void {
+    this.workspaceId = target.workspaceId
+  }
+
+  target(): GlobalPromptTarget {
+    return this.workspaceId === undefined ? {} : { workspaceId: this.workspaceId }
+  }
+
+  async route(input: {
+    sessionId: SessionId
+    text: string
+    mode: GlobalPromptMode
+  }): Promise<boolean> {
+    const sessions: ISessions | undefined = this.ctx.get('sessions', false)
+    const summary = sessions?.list.getSnapshot().byId[input.sessionId]
+    if (summary?.devframeRole !== 'global' || input.mode !== 'queue') return false
+    const workspaceId = this.workspaceId
+    if (workspaceId === undefined) return false
+
+    const workspaces: IWorkspaces | undefined = this.ctx.get('workspaces', false)
+    const workspace = workspaces?.list.getSnapshot().items.find(
+      item => item.workspaceId === workspaceId,
+    )
+    if (workspace === undefined) {
+      throw new Error('Global project target is no longer available.')
+    }
+    const remote = devframeRemoteFace(this.ctx)
+    if (remote === undefined) {
+      throw new Error('The DevFrame Host is still starting. Try again shortly.')
+    }
+
+    await remote.dispatchProjectLoop({
+      projectId: workspace.workspaceId,
+      projectRoot: workspace.path,
+      objective: input.text,
+      maxGoalRounds: 1,
+      requestIdempotencyKey: requestKey(),
+    })
+    return true
+  }
+}
