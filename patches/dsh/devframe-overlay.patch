@@ -0,0 +1,152 @@
+/**
+ * Slice 1A-D objective-record fold and Host route seam.
+ *
+ * The `objective/change` event is the durable, pathless record of one Global
+ * Controller objective (create → route → complete/cancel), and `project/run`
+ * is the thin append-only Objective→Run association in a Project Controller
+ * log. Locating an objective is a pure fold over the Global session log with
+ * exact-key payload validation in the style of {@link foldProjectAuthority};
+ * the Host route method appends create + route and flushes before resolving.
+ *
+ * @module @deepseek-ai/dsh-devframe-control-session/goal-route
+ */
+
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import type { ObjectiveChangeV1 } from './types.ts'
+import { ControlSessionError } from './index.ts'
+
+/** The durable event type carrying one Global Controller objective mutation. */
+export const OBJECTIVE_CHANGE_EVENT_TYPE = 'objective/change' as const
+
+/** The durable event type carrying one Objective→Run association. */
+export const PROJECT_RUN_EVENT_TYPE = 'project/run' as const
+
+/** Structural bound for one objective text: non-empty and at most this many chars. */
+export const OBJECTIVE_MAX_TEXT_LENGTH = 2000
+
+const CREATE_KEYS = [
+  'schemaVersion',
+  'kind',
+  'version',
+  'operation',
+  'objectiveId',
+  'text',
+  'changedAt',
+] as const
+const ROUTE_KEYS = [
+  'schemaVersion',
+  'kind',
+  'version',
+  'operation',
+  'objectiveId',
+  'workspaceId',
+  'changedAt',
+] as const
+const TERMINAL_KEYS = [
+  'schemaVersion',
+  'kind',
+  'version',
+  'operation',
+  'objectiveId',
+  'changedAt',
+] as const
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return false
+  const prototype: unknown = Object.getPrototypeOf(value)
+  return prototype === Object.prototype || prototype === null
+}
+
+function isNonEmptyString(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0
+}
+
+function isEpochMs(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0
+}
+
+/**
+ * Validate one `objective/change` payload with exact-key precision, mirroring
+ * the identity/bound events' parse style. Any structural, typing, or size
+ * violation is an `OBJECTIVE_INVALID` failure.
+ * @param value - the event payload to validate.
+ * @returns the validated, exact objective change payload.
+ */
+export function parseObjectivePayload(value: unknown): ObjectiveChangeV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('OBJECTIVE_INVALID')
+  if (value.schemaVersion !== 1 || value.kind !== 'objective' || value.version !== 1) {
+    throw new ControlSessionError('OBJECTIVE_INVALID')
+  }
+  const operation = value.operation
+  if (operation !== 'create' && operation !== 'route' && operation !== 'complete' && operation !== 'cancel') {
+    throw new ControlSessionError('OBJECTIVE_INVALID')
+  }
+  const keys = operation === 'create'
+    ? CREATE_KEYS
+    : operation === 'route' ? ROUTE_KEYS : TERMINAL_KEYS
+  const allowed = new Set<string>(keys as readonly string[])
+  if (Object.keys(value).some(key => !allowed.has(key))
+    || keys.some(key => !Object.hasOwn(value, key))) {
+    throw new ControlSessionError('OBJECTIVE_INVALID')
+  }
+  if (!isNonEmptyString(value.objectiveId)) throw new ControlSessionError('OBJECTIVE_INVALID')
+  if (operation === 'create') {
+    const text = value.text
+    if (!isNonEmptyString(text) || text.length > OBJECTIVE_MAX_TEXT_LENGTH) {
+      throw new ControlSessionError('OBJECTIVE_INVALID')
+    }
+  }
+  if (operation === 'route' && !isNonEmptyString(value.workspaceId)) {
+    throw new ControlSessionError('OBJECTIVE_INVALID')
+  }
+  if (!isEpochMs(value.changedAt)) throw new ControlSessionError('OBJECTIVE_INVALID')
+  return value as unknown as ObjectiveChangeV1
+}
+
+/**
+ * The folded dispatch stance of one objective over a Global session log.
+ * Only the routed state is dispatchable; complete/cancel closes the record.
+ * The routed state carries the recorded objective text (from the create
+ * change) so the browser dispatch remote never re-sends caller text.
+ */
+export type FoldedObjective =
+  | { readonly status: 'none' }
+  | { readonly status: 'created' }
+  | { readonly status: 'routed'; readonly workspaceId: string; readonly text: string }
+  | { readonly status: 'terminal' }
+
+/**
+ * Fold the LAST `objective/change` state of one objective id from a session
+ * log — the dispatch gate's only source of truth (design §10.5 step 5). Every
+ * objective payload is validated in exact-key style; any violation is
+ * `OBJECTIVE_INVALID`.
+ * @param events - the Global Controller session event log.
+ * @param objectiveId - the objective record to fold.
+ * @returns the last state, or `none` when the log carries no such objective.
+ */
+export function foldObjective(
+  events: readonly SessionEvent[],
+  objectiveId: string,
+): FoldedObjective {
+  let folded: FoldedObjective = { status: 'none' }
+  let createdText: string | undefined
+  for (const event of events) {
+    if (event.type !== OBJECTIVE_CHANGE_EVENT_TYPE) continue
+    const change = parseObjectivePayload(event.data)
+    if (change.objectiveId !== objectiveId) continue
+    switch (change.operation) {
+      case 'create':
+        createdText = change.text
+        folded = { status: 'created' }
+        break
+      case 'route':
+        folded = { status: 'routed', workspaceId: change.workspaceId, text: createdText ?? '' }
+        break
+      case 'complete':
+      case 'cancel':
+        folded = { status: 'terminal' }
+        break
+    }
+  }
+  return folded
+}
