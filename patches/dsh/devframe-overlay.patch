+      },
+    )
+    active.push(ctx)
+    expect(ctx.tools.schemas().map(schema => schema.name)).toContain('devframe_project_context')
+    const result = await call(ctx, agent(ctx, 'C:\\work\\dev-frame-system'))
+    expect(value(result)).toMatchObject({
+      status: 'matched',
+      workspace: { id: 'workspace-1', title: 'dev-frame-system' },
+    })
