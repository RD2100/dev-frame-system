+import type {
+  ChatConversationViewNode, ConversationNodeDefinition,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import type {
+  DevFrameLoopChangeV1, DevFrameLoopReview, DevFrameMemoryChangeV1, DevFrameMemoryStatus,
+} from '@deepseek-ai/dsh-devframe-control-session/types'
+
+export type LoopChatStatus = 'running' | 'completed' | 'failed' | 'aborted'
+
+export interface LoopChatData {
+  readonly loopId: string
+  readonly objectiveId: string
+  readonly projectId: string
+  readonly status: LoopChatStatus
+  readonly review?: DevFrameLoopReview
+  readonly memoryStatus?: DevFrameMemoryStatus
+}
+
+interface LoopState extends LoopChatData {}
+
+declare module '@deepseek-ai/dsh-client-ui-conversation/client' {
+  interface ChatNodeDataMap {
+    'devframe-loop': LoopChatData
+  }
+}
+
+function statusOf(outcome: DevFrameLoopChangeV1['outcome']): LoopChatStatus {
+  if (outcome === 'completed') return 'completed'
+  if (outcome === 'failed') return 'failed'
+  return 'aborted'
+}
+
+function updateLoop(state: LoopState, change: DevFrameLoopChangeV1): LoopState {
+  if (change.operation === 'complete' || change.operation === 'fail') {
+    return {
+      ...state,
+      status: statusOf(change.outcome),
+      ...(change.review === undefined ? {} : { review: change.review }),
+    }
+  }
+  return {
+    ...state,
+    ...(change.review === undefined ? {} : { review: change.review }),
+  }
+}
+
+function updateMemory(state: LoopState, change: DevFrameMemoryChangeV1): LoopState {
+  return { ...state, memoryStatus: change.status }
+}
+
+/** Projects the Host-owned loop and governed-memory evidence into the chat. */
+export const loopDefinition: ConversationNodeDefinition<LoopState> = {
+  kind: 'devframe-loop',
+  target: 'chat',
+  match: (event) => {
+    if (event.type === 'devframe/loop') {
+      return { id: event.data.loopId, role: event.data.operation === 'start' ? 'start' : 'update' }
+    }
+    if (event.type === 'devframe/memory') return { id: event.data.loopId, role: 'update' }
+    return null
+  },
+  start: (_context, match) => {
+    if (match.event.type !== 'devframe/loop' || match.event.data.operation !== 'start') {
+      throw new Error('devframe-loop start requires loop start')
+    }
+    return {
+      loopId: match.event.data.loopId,
+      objectiveId: match.event.data.objectiveId,
+      projectId: match.event.data.projectId,
+      status: 'running',
+    }
+  },
+  update: (context, match) => {
+    if (match.event.type === 'devframe/loop') return updateLoop(context.state, match.event.data)
+    if (match.event.type === 'devframe/memory') return updateMemory(context.state, match.event.data)
+    return context.state
+  },
+  buildViewNode: (context): ChatConversationViewNode | null => {
+    if (context.start === undefined || context.state === undefined) return null
+    return {
+      key: context.key,
+      kind: 'devframe-loop',
+      id: context.id,
+      target: 'chat',
+      anchorSeq: context.start.event.seq,
+      location: context.start.location,
+      visibility: 'visible',
+      data: context.state,
+    }
+  },
+}
