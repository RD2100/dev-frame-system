+// Keyless assembled proof that the real Global → Project loop settles through
+// the independent reviewer instead of stopping at executor completion.
+import { fileURLToPath } from 'node:url'
+import { join } from 'node:path'
+import type { Browser, Page } from 'playwright'
+import { chromium } from 'playwright'
+import { afterEach, describe, expect, it, onTestFailed } from 'vitest'
+import {
+  assertFixtureInventory, launchWebScaffold, watchConsole, webSnapshotMode,
+  type WebScaffold,
+} from './scaffold.ts'
+import { connectFreshWorkspace, newEnglishPage, saveFailureShot } from './support.ts'
+
+const DEVFRAME_PATCH_PATH = fileURLToPath(
+  new URL('../../../packages/bundle/devframe/cordis.patch.yml', import.meta.url),
+)
+const SNAPSHOT_DIR = fileURLToPath(new URL('./snapshots/global-project-loop', import.meta.url))
+const FIXTURE = join(SNAPSHOT_DIR, 'session.jsonl')
+const OVERRIDE = join(SNAPSHOT_DIR, 'replay.override.json')
+const REVIEWER_FIXTURE = join(SNAPSHOT_DIR, 'reviewer-pass.jsonl')
+const MODE = webSnapshotMode()
+const WORKSPACE_NAME = 'global-project-loop-review'
+
+const MEMORY_GATEWAY = {
+  recallProjectPlan: async () => ({ status: 'missing' as const }),
+  captureProjectCheckpoint: async () => ({ status: 'captured' as const }),
+}
+
+describe('web e2e: Global composer settles through independent review', () => {
+  let scaffold: WebScaffold | undefined
+  let browser: Browser | undefined
+  let page: Page
+  let tripwire: ReturnType<typeof watchConsole>
+  let globalBootstrap: {
+    open(profileId: string): Promise<void>
+    stop(): Promise<void>
+  } | undefined
+
+  afterEach(async () => {
+    const failures: unknown[] = []
+    await browser?.close().catch((error: unknown) => failures.push(error))
+    browser = undefined
+    await globalBootstrap?.stop().catch((error: unknown) => failures.push(error))
+    globalBootstrap = undefined
+    const closing = scaffold
+    scaffold = undefined
+    await closing?.close().catch((error: unknown) => failures.push(error))
+    if (failures.length === 1) throw failures[0]
+    if (failures.length > 1) throw new AggregateError(failures, 'global-project-loop-review teardown failed')
+  })
+
+  it.skipIf(MODE === 'record')('renders executor completion, then durable reviewer pass', async () => {
+    onTestFailed(() => saveFailureShot(page, 'web-e2e-global-project-loop-review'))
+    scaffold = await launchWebScaffold({
+      extraOverlayPath: DEVFRAME_PATCH_PATH,
+      replayFixture: FIXTURE,
+      replayOverride: OVERRIDE,
+      replayChildFixtures: [REVIEWER_FIXTURE],
+      paceMs: 20,
+      testMemoryGateway: MEMORY_GATEWAY,
+    })
+    scaffold.ctx.provide('profileIdentity', { id: 'global-project-loop-review-e2e', name: 'devframe' })
+    const controlSessions = scaffold.ctx.get('devframeControlSessions') as {
+      beginGlobalBootstrap(): {
+        open(profileId: string): Promise<void>
+        stop(): Promise<void>
+      }
+    } | undefined
+    if (controlSessions === undefined) throw new Error('DevFrame control-session Host is not mounted')
+    globalBootstrap = controlSessions.beginGlobalBootstrap()
+    await globalBootstrap.open('global-project-loop-review-e2e')
+
+    browser = await chromium.launch()
+    page = await newEnglishPage(browser)
+    tripwire = watchConsole(page)
+    await page.goto(scaffold.baseUrl, { waitUntil: 'load' })
+    const controller = page.getByRole('button', { name: 'Global Controller', exact: true })
+    await controller.waitFor({ timeout: 30_000 })
+    await connectFreshWorkspace(page, scaffold.workspaceCwd, WORKSPACE_NAME)
+    await controller.click()
+
+    await page.getByRole('button', { name: 'Global Controller actions', exact: true }).click()
+    let menu = page.locator('[role="menu"]').last()
