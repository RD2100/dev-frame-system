+): ControllerToolFaceState | undefined {
+  const restriction = installControllerRestriction(agentCtx, agent)
+  // Restrictions control visibility; a scope-local preset may still contribute
+  // additional tools. The monotonic guard is the final authority and allows
+  // only the three read-only capabilities above.
+  const guard = agentCtx.tools.guard(execution => CONTROLLER_ALLOWED_TOOL_SET.has(execution.name)
