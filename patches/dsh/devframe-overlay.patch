@@ -0,0 +1,246 @@
+/**
+ * Durable, pathless evaluation receipts for the DevFrame Task Board.
+ *
+ * A receipt is derived from an existing independent review and references the
+ * already durable Worker evidence. It is not a Verdict and it never copies
+ * reviewer findings or transcript data into the Global Controller log.
+ */
+
+import { createHash } from 'node:crypto'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import {
+  EVALUATION_RECEIPT_KIND,
+  EVALUATION_RECEIPT_EVENT_TYPE,
+  type EvaluationOutcome,
+  type EvaluationReceiptV1,
+  type TaskReviewEvidenceV1,
+  type TaskTrajectoryReferenceV1,
+} from './types.ts'
+import { ControlSessionError } from './index.ts'
+import { TASK_REVIEW_EVENT_TYPE, parseTaskReviewEvidence } from './review.ts'
+
+const REQUIRED_KEYS = [
+  'schemaVersion', 'kind', 'version', 'receiptId', 'subjectTaskId',
+  'evaluatorTaskId', 'evaluatorRole', 'evaluatorSessionId',
+  'sourceReviewSha256', 'outcome', 'artifactRefs', 'trajectoryRefs',
+  'changedAt',
+] as const
+const OUTCOMES = new Set<EvaluationOutcome>(['pass', 'revise', 'fail'])
+const MAX_REFS = 256
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return false
+  const prototype: unknown = Object.getPrototypeOf(value)
+  return prototype === Object.prototype || prototype === null
+}
+
+function isPathlessId(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0
+    && value.length <= 256 && !value.includes('/') && !value.includes('\\')
+}
+
+function isSafeSeq(value: unknown): value is number {
+  return Number.isSafeInteger(value) && (value as number) >= 0
+}
+
+function isEpochMs(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0
+}
+
+function isSha256Hex(value: unknown): value is string {
+  return typeof value === 'string' && /^[0-9a-f]{64}$/u.test(value)
+}
+
+function parseTrajectoryRefs(value: unknown): readonly TaskTrajectoryReferenceV1[] {
+  if (!Array.isArray(value) || value.length > MAX_REFS) throw new ControlSessionError('TASK_INVALID')
+  const refs = value.map((candidate): TaskTrajectoryReferenceV1 => {
+    if (!isPlainRecord(candidate) || !isPathlessId(candidate.sessionId) || !isSafeSeq(candidate.seq)) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    return { sessionId: candidate.sessionId as TaskTrajectoryReferenceV1['sessionId'], seq: candidate.seq }
+  })
+  for (let index = 1; index < refs.length; index++) {
+    const previous = refs[index - 1]
+    const current = refs[index]
+    if (previous === undefined || current === undefined
+      || previous.sessionId > current.sessionId
+      || (previous.sessionId === current.sessionId && previous.seq >= current.seq)) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+  }
+  return refs
+}
+
+function canonicalReceiptPayload(
+  receipt: Omit<EvaluationReceiptV1, 'receiptId'>,
+): string {
+  return JSON.stringify({
+    schemaVersion: receipt.schemaVersion,
+    kind: receipt.kind,
+    version: receipt.version,
+    subjectTaskId: receipt.subjectTaskId,
+    evaluatorTaskId: receipt.evaluatorTaskId,
+    evaluatorRole: receipt.evaluatorRole,
+    evaluatorSessionId: receipt.evaluatorSessionId,
+    sourceReviewSha256: receipt.sourceReviewSha256,
+    outcome: receipt.outcome,
+    artifactRefs: receipt.artifactRefs,
+    trajectoryRefs: receipt.trajectoryRefs,
+  })
+}
+
+function receiptIdFor(receipt: Omit<EvaluationReceiptV1, 'receiptId'>): string {
+  return createHash('sha256').update(canonicalReceiptPayload(receipt)).digest('hex')
+}
+
+/** Convert the explicit reviewer vocabulary into the bounded evaluation vocabulary. */
+export function evaluationOutcomeForReview(verdict: TaskReviewEvidenceV1['verdict']): EvaluationOutcome {
+  if (verdict === 'pass') return 'pass'
+  if (verdict === 'request_revision') return 'revise'
+  return 'fail'
+}
+
+/** Create one deterministic receipt from a durable reviewer report. */
+export function createEvaluationReceipt(options: {
+  readonly subjectTaskId: string
+  readonly evaluatorTaskId: string
+  readonly evaluatorSessionId: EvaluationReceiptV1['evaluatorSessionId']
+  readonly sourceReviewSha256: string
+  readonly outcome: EvaluationOutcome
+  readonly artifactRefs: readonly string[]
+  readonly trajectoryRefs: readonly TaskTrajectoryReferenceV1[]
+}): EvaluationReceiptV1 {
+  const unsigned: Omit<EvaluationReceiptV1, 'receiptId'> = {
+    schemaVersion: 1,
+    kind: EVALUATION_RECEIPT_KIND,
+    version: 1,
+    subjectTaskId: options.subjectTaskId,
+    evaluatorTaskId: options.evaluatorTaskId,
+    evaluatorRole: 'reviewer',
+    evaluatorSessionId: options.evaluatorSessionId,
+    sourceReviewSha256: options.sourceReviewSha256,
+    outcome: options.outcome,
+    artifactRefs: [...options.artifactRefs],
+    trajectoryRefs: [...options.trajectoryRefs],
+    changedAt: Date.now(),
+  }
+  if (!isPathlessId(unsigned.subjectTaskId) || !isPathlessId(unsigned.evaluatorTaskId)
+    || !isPathlessId(unsigned.evaluatorSessionId)
+    || !isSha256Hex(unsigned.sourceReviewSha256)
+    || !OUTCOMES.has(unsigned.outcome)
+    || unsigned.artifactRefs.length > MAX_REFS
+    || unsigned.artifactRefs.some(ref => !isSha256Hex(ref))
+    || !isEpochMs(unsigned.changedAt)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  parseTrajectoryRefs(unsigned.trajectoryRefs)
+  return { ...unsigned, receiptId: receiptIdFor(unsigned) }
+}
+
+/** Parse a receipt with exact keys and deterministic id validation. */
+export function parseEvaluationReceipt(value: unknown): EvaluationReceiptV1 {
+  if (!isPlainRecord(value)) throw new ControlSessionError('TASK_INVALID')
+  if (Object.keys(value).some(key => !REQUIRED_KEYS.includes(key as typeof REQUIRED_KEYS[number]))) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  for (const key of REQUIRED_KEYS) {
+    if (!Object.hasOwn(value, key)) throw new ControlSessionError('TASK_INVALID')
+  }
+  const receipt = value
+  if (receipt.schemaVersion !== 1 || receipt.kind !== EVALUATION_RECEIPT_KIND
+    || receipt.version !== 1 || !isSha256Hex(receipt.receiptId)
+    || !isPathlessId(receipt.subjectTaskId) || !isPathlessId(receipt.evaluatorTaskId)
+    || receipt.evaluatorRole !== 'reviewer' || !isPathlessId(receipt.evaluatorSessionId)
+    || !isSha256Hex(receipt.sourceReviewSha256)
+    || typeof receipt.outcome !== 'string' || !OUTCOMES.has(receipt.outcome as EvaluationOutcome)
+    || !Array.isArray(receipt.artifactRefs) || receipt.artifactRefs.length > MAX_REFS
+    || receipt.artifactRefs.some(ref => !isSha256Hex(ref))
+    || !isEpochMs(receipt.changedAt)) {
+    throw new ControlSessionError('TASK_INVALID')
+  }
+  const artifactRefs = (receipt.artifactRefs as unknown[]).map((ref: unknown) => {
+    if (!isSha256Hex(ref)) throw new ControlSessionError('TASK_INVALID')
+    return ref
+  })
+  const trajectoryRefs = parseTrajectoryRefs(receipt.trajectoryRefs)
+  const normalized: Omit<EvaluationReceiptV1, 'receiptId'> = {
+    schemaVersion: 1,
+    kind: EVALUATION_RECEIPT_KIND,
+    version: 1,
+    subjectTaskId: receipt.subjectTaskId,
+    evaluatorTaskId: receipt.evaluatorTaskId,
+    evaluatorRole: 'reviewer',
+    evaluatorSessionId: receipt.evaluatorSessionId as EvaluationReceiptV1['evaluatorSessionId'],
+    sourceReviewSha256: receipt.sourceReviewSha256,
+    outcome: receipt.outcome as EvaluationOutcome,
+    artifactRefs,
+    trajectoryRefs,
+    changedAt: receipt.changedAt,
+  }
+  if (receiptIdFor(normalized) !== receipt.receiptId) throw new ControlSessionError('TASK_INVALID')
+  return { ...normalized, receiptId: receipt.receiptId }
+}
+
+function taskChangeRecords(events: readonly SessionEvent[]): readonly Record<string, unknown>[] {
+  return events.flatMap((event) => {
+    if (event.type !== 'task/change' || !isPlainRecord(event.data)) return []
+    return [event.data]
+  })
+}
+
+/** Fold the latest evaluation receipt per subject task, rejecting duplicates/tampering. */
+export function foldEvaluationReceipts(
+  events: readonly SessionEvent[],
+): ReadonlyMap<string, EvaluationReceiptV1> {
+  const reviews = new Map<string, TaskReviewEvidenceV1>()
+  const reports = taskChangeRecords(events)
+  for (const [index, event] of events.entries()) {
+    if (event.type !== TASK_REVIEW_EVENT_TYPE) continue
+    if (event.seq !== index) throw new ControlSessionError('TASK_INVALID')
+    const review = parseTaskReviewEvidence(event.data)
+    if (reviews.has(review.taskId)) throw new ControlSessionError('TASK_INVALID')
+    reviews.set(review.taskId, review)
+  }
+  const receipts = new Map<string, EvaluationReceiptV1>()
+  const evaluatorTasks = new Set<string>()
+  for (const [index, event] of events.entries()) {
+    if (event.type !== EVALUATION_RECEIPT_EVENT_TYPE) continue
+    if (event.seq !== index) throw new ControlSessionError('TASK_INVALID')
+    const receipt = parseEvaluationReceipt(event.data)
+    if (receipts.has(receipt.subjectTaskId) || evaluatorTasks.has(receipt.evaluatorTaskId)) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    const review = reviews.get(receipt.subjectTaskId)
+    if (review === undefined || review.evidenceSha256 !== receipt.sourceReviewSha256
+      || evaluationOutcomeForReview(review.verdict) !== receipt.outcome) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    const reviewerReport = reports.find(record => record.operation === 'report'
+      && record.taskId === receipt.evaluatorTaskId
+      && record.payloadRef === 'devframe/review'
+      && isPlainRecord(record.reportRef)
+      && record.reportRef.sessionId === receipt.evaluatorSessionId
+      && record.reportRef.messageSha256 === review.reviewerMessageSha256)
+    if (reviewerReport === undefined) throw new ControlSessionError('TASK_INVALID')
+    const subjectReport = reports.find(record => record.operation === 'report'
+      && record.taskId === review.taskId
+      && record.workerId === review.executorWorkerId
+      && isPlainRecord(record.reportRef)
+      && record.reportRef.evidenceSha256 === review.executorReportSha256)
+    if (subjectReport === undefined) throw new ControlSessionError('TASK_INVALID')
+    const subjectRef = isPlainRecord(subjectReport.reportRef)
+      ? subjectReport.reportRef : undefined
+    if (subjectRef === undefined) throw new ControlSessionError('TASK_INVALID')
+    const artifactRefs = Array.isArray(subjectRef.artifactRefs)
+      ? subjectRef.artifactRefs : []
+    const trajectoryRefs = Array.isArray(subjectRef.trajectoryRefs)
+      ? subjectRef.trajectoryRefs : []
+    if (JSON.stringify(artifactRefs) !== JSON.stringify(receipt.artifactRefs)
+      || JSON.stringify(trajectoryRefs) !== JSON.stringify(receipt.trajectoryRefs)) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    receipts.set(receipt.subjectTaskId, receipt)
+    evaluatorTasks.add(receipt.evaluatorTaskId)
+  }
+  return receipts
+}
