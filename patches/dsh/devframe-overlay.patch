+/** Agent-scoped managed runtime for the official Codex app-server process. */
+
+import { createHash, randomUUID } from 'node:crypto'
+import { lstatSync, mkdirSync, realpathSync } from 'node:fs'
+import { basename, isAbsolute, join, relative, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import type { Agent, AgentStepRuntime, AgentStepRuntimeInput } from '@deepseek-ai/dsh-agent'
+import type { FinishReason, Message, StreamChunk } from '@deepseek-ai/dsh-llm'
+import type { SubprocessHandle, SubprocessSpawnSpec } from '@deepseek-ai/dsh-subprocess'
+import {
+  CODEX_STDERR_MAX_BYTES,
+  CODEX_SUBSCRIPTION_PROVIDER,
+  CodexRuntimeError,
+  type CodexAccountAvailability,
+  type CodexLoginErrorCode,
+  type CodexLoginStartResult,
+  type CodexLoginStatus,
+  type CodexLoginState,
+  type CodexSubscriptionCapabilities,
+  type CodexSubscriptionConfig,
+  type CodexThreadBoundEvent,
+} from './types.ts'
+import {
+  codexAppServerArgv,
+  CodexLoginWire,
+  CodexSubscriptionWire,
+  type CodexChatgptLoginCompleted,
+  textInputs,
+} from './wire.ts'
+
+const DEFAULT_DISPOSE_GRACE_MS = 2_000
+const MAX_DISPOSE_GRACE_MS = 5_000
+const DISPOSE_TIMEOUT_MARGIN_MS = 250
+const LOGIN_COMPLETION_TIMEOUT_MS = 10_000
+const CODEX_SUBSCRIPTION_HOME_NAME = '.dsh-codex-subscription'
+const CODEX_MODEL_ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/
+const CODEX_REDUNDANT_CONTEXT_KINDS = new Set(['skill-catalog', 'tool'])
+const CODEX_REDUNDANT_CONTEXT_PLUGINS = new Set([
+  '@deepseek-ai/dsh-system-prompt',
+  'dsh-system-prompt',
+  'skill-catalog',
+])
+const CREDENTIAL_ENV_NAMES = [
+  'OPENAI_API_KEY',
+  'OPENAI_API_TOKEN',
+  'OPENAI_ACCESS_TOKEN',
+  'OPENAI_AUTH_TOKEN',
+  'CODEX_API_KEY',
+  'CODEX_API_TOKEN',
+  'CODEX_ACCESS_TOKEN',
+  'CODEX_AUTH_TOKEN',
+  'CODEX_SESSION_TOKEN',
+  'CHATGPT_API_KEY',
+  'CHATGPT_ACCESS_TOKEN',
+  'DEEPSEEK_API_KEY',
+  'ANTHROPIC_API_KEY',
+  'GITHUB_TOKEN',
+  'AWS_SECRET_ACCESS_KEY',
+  'AZURE_OPENAI_API_KEY',
+  // Do not let ambient routing or module-loader settings redirect the pinned
+  // official process. CODEX_HOME is tombstoned before the fixed home is set.
+  'OPENAI_BASE_URL',
+  'OPENAI_API_BASE',
+  'CODEX_BASE_URL',
+  'CODEX_OSS_BASE_URL',
+  'CODEX_OSS_PORT',
+  'OPENAI_ORGANIZATION',
+  'OPENAI_PROJECT',
+  'AZURE_OPENAI_ENDPOINT',
+  'CODEX_HOME',
+  'NODE_OPTIONS',
+  'NODE_PATH',
+] as const
+
+/** Test and host seam for the process boundary; it receives only fixed specs. */
+export type CodexProcessSpawner = (spec: SubprocessSpawnSpec) => SubprocessHandle
+
+/** Internal process options used by the Service Provider and package tests. */
+export interface CodexManagedAgentRuntimeOptions {
+  /** DSH-owned process boundary supplied by the later Service wrapper. */
+  readonly spawn: CodexProcessSpawner
+  /** Service-derived persistent home for this launcher profile. */
+  readonly codexHome: string
+  /** Bounded process-tree termination grace. */
+  readonly disposeGraceMs?: number
+}
+
+/** Options for a one-shot subscription capability probe. */
+/** Internal probe options used by the Service Provider and package tests. */
+export interface CodexSubscriptionProbeOptions {
+  /** DSH-owned process boundary supplied by the Service Provider. */
+  readonly spawn: CodexProcessSpawner
+  /** Service-derived persistent home for this launcher profile. */
+  readonly codexHome: string
+  /** Bounded process-tree termination grace. */
+  readonly disposeGraceMs?: number
+  /** Internal lifecycle hook used while an Agent-owned runtime is disposed. */
+  readonly registerProcess?: (dispose: () => Promise<void>) => () => void
+}
+
+function runtimeError(error: unknown): CodexRuntimeError {
+  if (error instanceof CodexRuntimeError) return error
+  return new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex app-server process failed')
+}
+
+function assertGraceMs(value: number | undefined): number {
+  const resolved = value ?? DEFAULT_DISPOSE_GRACE_MS
+  if (!Number.isFinite(resolved) || resolved <= 0 || resolved > MAX_DISPOSE_GRACE_MS) {
+    throw new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex process grace was invalid')
+  }
+  return Math.floor(resolved)
+}
+
+/**
