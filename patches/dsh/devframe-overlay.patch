+      [{ insert: [{ id: 'devframe-codegraph-context', name: '@deepseek-ai/dsh-devframe/codegraph-context' }] }],
+      (root) => {
+        root.loader.builtins['memory-test-system-prompt'] = SystemPrompt
+        root.loader.builtins['memory-test-tools'] = ToolRuntime
+        root.provide('workspaceRegistry', {
