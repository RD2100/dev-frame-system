@@ -0,0 +1,515 @@
+import { fileURLToPath } from 'node:url'
+import { createHash } from 'node:crypto'
+import { join } from 'node:path'
+import type { Browser, Locator, Page } from 'playwright'
+import { chromium } from 'playwright'
+import { expect, describe, it, beforeAll, afterAll, onTestFailed } from 'vitest'
+import type { SessionEvent, SessionId } from '@deepseek-ai/dsh-session'
+import type {
+  TaskReportEvidenceV1,
+  TaskReviewEvidenceV1,
+} from '../../../packages/devframe/control-session/src/types.ts'
+import { taskReportEvidenceDigest } from '../../../packages/devframe/control-session/src/task-board.ts'
+import { foldTaskBoard } from '../../../packages/devframe/control-session/src/task-board.ts'
+import {
+  TASK_REVIEW_EVENT_TYPE,
+  taskReviewEvidenceDigest,
+} from '../../../packages/devframe/control-session/src/review.ts'
+import { createEvaluationReceipt } from '../../../packages/devframe/control-session/src/evaluation.ts'
+import {
+  assertFixtureInventory,
+  captureStableAria,
+  compareOrRefreshGolden,
+  launchWebScaffold,
+  seedSession,
+  watchConsole,
+  webSnapshotMode,
+  type WebScaffold,
+} from './scaffold.ts'
+import { connectFreshWorkspace, newEnglishPage, saveFailureShot } from './support.ts'
+
+/** The same thin DevFrame layer mounted by the `devframe` profile. */
+const DEVFRAME_PATCH_PATH = fileURLToPath(
+  new URL('../../../packages/bundle/devframe/cordis.patch.yml', import.meta.url),
+)
+const SNAPSHOT_DIR = fileURLToPath(new URL('./snapshots/devframe-global-parity', import.meta.url))
+const SURFACE_EXPECTED = join(SNAPSHOT_DIR, 'surface.expected.md')
+const MODE = webSnapshotMode()
+const EVIDENCE_PROFILE_ID = 'devframe-web-evidence-e2e'
+const SUBJECT_TASK_ID = 'evidence-subject'
+const REVIEW_TASK_ID = 'evidence-review'
+const EXECUTOR_WORKER_ID = 'evidence-executor'
+const REVIEWER_WORKER_ID = 'evidence-reviewer'
+const EXECUTOR_SESSION_ID = `worker:${EXECUTOR_WORKER_ID}` as SessionId
+const REVIEWER_SESSION_ID = `worker:${REVIEWER_WORKER_ID}` as SessionId
+
+/** A minimal closed Worker Session used only to seed the keyless browser proof. */
+function evidenceFixture(kind: 'executor' | 'reviewer'): string {
+  const reviewer = kind === 'reviewer'
+  const messageId = reviewer ? 'evidence-review-message' : 'evidence-subject-message'
+  const body = reviewer
+    ? 'seeded reviewer body must stay in the Worker Session'
+    : 'seeded executor body must stay in the Worker Session'
+  const reviewTool = reviewer
+    ? [
+      JSON.stringify({
+        type: 'tool/call',
+        data: {
+          turn: 1,
+          step: 1,
+          callId: 'evidence-review-submit',
+          name: 'devframe_submit_review',
+          arguments: JSON.stringify({ verdict: 'pass', findings: 'seeded review evidence' }),
+        },
+      }),
+    ]
+    : []
+  return [
+    JSON.stringify({ type: 'session', version: 0, id: '{{sessionId}}', createdAt: 0 }),
+    JSON.stringify({
+      type: 'turn/start',
+      data: { turn: 1, trigger: { kind: 'message', source: { kind: 'user', rpcId: 'evidence-fixture' } } },
+    }),
+    JSON.stringify({
+      type: 'request/header',
+      data: { header: { config: { provider: 'deepseek-official', model: 'deepseek-v4-flash' } }, reason: 'initial' },
+    }),
+    ...reviewTool,
+    JSON.stringify({
+      type: 'assistant/message',
+      data: {
+        turn: 1,
+        step: 1,
+        message: {
+          role: 'assistant',
+          content: [{ type: 'text', text: body }],
+          source: { kind: 'model', provider: 'deepseek-official', model: 'deepseek-v4-flash' },
+          id: messageId,
+        },
+      },
+      sourceEventSeqs: reviewer ? [1, 2] : [1],
+      surfaceOp: 'append',
+    }),
+    JSON.stringify({ type: 'turn/end', data: { turn: 1, reason: { kind: 'completed' } } }),
+    '',
+  ].join('\n')
+}
+
+function eventOf<T extends SessionEvent['type']>(events: readonly SessionEvent[], type: T): SessionEvent & { type: T } {
+  const event = events.find(candidate => candidate.type === type)
+  if (event === undefined) throw new Error(`evidence fixture missing ${type}`)
+  return event as SessionEvent & { type: T }
+}
+
+/** Build the same pathless report reference the Host derives from a Worker turn. */
+function reportFor(sessionId: SessionId, events: readonly SessionEvent[]): TaskReportEvidenceV1 {
+  const request = eventOf(events, 'request/header')
+  const assistant = eventOf(events, 'assistant/message')
+  const end = eventOf(events, 'turn/end')
+  const sourceEventSeqs = [request.seq, assistant.seq, end.seq].sort((left, right) => left - right)
+  const messageSha256 = createHash('sha256').update(JSON.stringify(assistant.data.message)).digest('hex')
+  const unsigned: Omit<TaskReportEvidenceV1, 'evidenceSha256'> = {
+    schemaVersion: 1,
+    kind: 'devframe/task-report',
+    sessionId,
+    messageId: String(assistant.data.message.id),
+    assistantSeq: assistant.seq,
+    turn: assistant.data.turn,
+    step: assistant.data.step,
+    turnEndSeq: end.seq,
+    outcome: 'completed',
+    sourceEventSeqs,
+    messageSha256,
+    artifactRefs: [messageSha256],
+    trajectoryRefs: sourceEventSeqs.map(seq => ({ sessionId, seq })),
+  }
+  return { ...unsigned, evidenceSha256: taskReportEvidenceDigest(unsigned) }
+}
+
+function appendTaskLifecycle(
+  session: { append(type: 'task/change', data: unknown): unknown },
+  options: {
+    taskId: string
+    workerId: string
+    payloadRef: string
+    report: TaskReportEvidenceV1
+  },
+): void {
+  const base = {
+    schemaVersion: 1,
+    kind: 'task' as const,
+    version: 1 as const,
+    taskId: options.taskId,
+    semanticMessageId: `${options.taskId}-semantic`,
+    workerId: options.workerId,
+    payloadRef: options.payloadRef,
+    changedAt: 1_780_000_000_000,
+  }
+  for (const operation of ['queue', 'admit', 'ack', 'claim', 'start'] as const) {
+    session.append('task/change', { ...base, operation })
+  }
+  session.append('task/change', {
+    ...base,
+    operation: 'report',
+    messageId: options.report.messageId,
+    reportRef: options.report,
+  })
+}
+
+function seededReview(
+  subjectReport: TaskReportEvidenceV1,
+  reviewerReport: TaskReportEvidenceV1,
+  reviewerEvents: readonly SessionEvent[],
+): TaskReviewEvidenceV1 {
+  const submission = eventOf(reviewerEvents, 'tool/call')
+  const assistant = eventOf(reviewerEvents, 'assistant/message')
+  const end = eventOf(reviewerEvents, 'turn/end')
+  const request = eventOf(reviewerEvents, 'request/header')
+  const findings = 'seeded review evidence'
+  const unsigned: Omit<TaskReviewEvidenceV1, 'evidenceSha256'> = {
+    schemaVersion: 1,
+    kind: 'devframe/task-review',
+    version: 1,
+    taskId: SUBJECT_TASK_ID,
+    executorWorkerId: EXECUTOR_WORKER_ID,
+    executorReportSha256: subjectReport.evidenceSha256,
+    reviewerWorkerId: REVIEWER_WORKER_ID,
+    reviewerSessionId: REVIEWER_SESSION_ID,
+    reviewerMessageId: reviewerReport.messageId,
+    reviewSubmissionCallId: String(submission.data.callId),
+    reviewSubmissionSeq: submission.seq,
+    reviewerAssistantSeq: assistant.seq,
+    reviewerTurn: assistant.data.turn,
+    reviewerStep: assistant.data.step,
+    reviewerTurnEndSeq: end.seq,
+    reviewerSourceEventSeqs: [request.seq, submission.seq, assistant.seq, end.seq]
+      .sort((left, right) => left - right),
+    reviewerMessageSha256: reviewerReport.messageSha256,
+    verdict: 'pass',
+    findingsSha256: createHash('sha256').update(findings).digest('hex'),
+    changedAt: 1_780_000_000_001,
+  }
+  return { ...unsigned, evidenceSha256: taskReviewEvidenceDigest(unsigned) }
+}
+
+/** A Vite overlay is a product boot failure, not a valid browser surface. */
+async function assertNoViteOverlay(page: Page): Promise<void> {
+  expect(await page.locator('vite-error-overlay').count()).toBe(0)
+  expect(await page.locator('[data-vite-error-overlay]').count()).toBe(0)
+}
+
+/** Keep browser assertions on the project's Vitest + Playwright convention. */
+async function assertVisible(locator: Locator): Promise<void> {
+  await locator.waitFor({ state: 'visible', timeout: 15_000 })
+  expect(await locator.isVisible()).toBe(true)
+}
+
+describe('web e2e: DevFrame profile surface parity', () => {
+  let scaffold: WebScaffold
+  let browser: Browser
+  let page: Page
+  let tripwire: ReturnType<typeof watchConsole>
+  let globalBootstrap: { stop(): Promise<void> } | undefined
+  const consoleErrors: string[] = []
+
+  beforeAll(async () => {
+    scaffold = await launchWebScaffold({ extraOverlayPath: DEVFRAME_PATCH_PATH })
+    scaffold.ctx.provide('profileIdentity', { id: EVIDENCE_PROFILE_ID, name: 'devframe' })
+    const controlSessions = scaffold.ctx.get('devframeControlSessions') as {
+      beginGlobalBootstrap(): {
+        open(profileId: string): Promise<void>
+        stop(): Promise<void>
+      }
+    } | undefined
+    if (controlSessions === undefined) {
+      throw new Error('DevFrame profile overlay did not mount devframeControlSessions')
+    }
+    const bootstrap = controlSessions.beginGlobalBootstrap()
+    globalBootstrap = bootstrap
+    await bootstrap.open(EVIDENCE_PROFILE_ID)
+
+    // Seed two closed native Worker Sessions through the real persistence API,
+    // then append only pathless report/review/receipt references to the Global
+    // Controller log. The browser still crosses the production Remote wire.
+    await seedSession(scaffold, evidenceFixture('executor'), EXECUTOR_SESSION_ID)
+    await seedSession(scaffold, evidenceFixture('reviewer'), REVIEWER_SESSION_ID)
+    const service = scaffold.ctx.get('devframeControlSessions') as {
+      openGlobal(options: { profileId: string }): Promise<{
+        agent: { session: { id: SessionId; append(type: string, data: unknown): unknown } }
+      }>
+    }
+    const global = (await service.openGlobal({ profileId: EVIDENCE_PROFILE_ID })).agent
+    const executorEvents = (await scaffold.ctx.sessionPersistence.inspect(EXECUTOR_SESSION_ID)).events
+    const reviewerEvents = (await scaffold.ctx.sessionPersistence.inspect(REVIEWER_SESSION_ID)).events
+    const subjectReport = reportFor(EXECUTOR_SESSION_ID, executorEvents)
+    const reviewerReport = reportFor(REVIEWER_SESSION_ID, reviewerEvents)
+    appendTaskLifecycle(global.session, {
+      taskId: SUBJECT_TASK_ID,
+      workerId: EXECUTOR_WORKER_ID,
+      payloadRef: 'devframe/execute',
+      report: subjectReport,
+    })
+    appendTaskLifecycle(global.session, {
+      taskId: REVIEW_TASK_ID,
+      workerId: REVIEWER_WORKER_ID,
+      payloadRef: 'devframe/review',
+      report: reviewerReport,
+    })
+    const review = seededReview(subjectReport, reviewerReport, reviewerEvents)
+    global.session.append(TASK_REVIEW_EVENT_TYPE, review)
+    global.session.append('evaluation/receipt', createEvaluationReceipt({
+      subjectTaskId: SUBJECT_TASK_ID,
+      evaluatorTaskId: REVIEW_TASK_ID,
+      evaluatorSessionId: REVIEWER_SESSION_ID,
+      sourceReviewSha256: review.evidenceSha256,
+      outcome: 'pass',
+      artifactRefs: subjectReport.artifactRefs ?? [],
+      trajectoryRefs: subjectReport.trajectoryRefs ?? [],
+    }))
+    await scaffold.ctx.sessions.flush(global.session as never)
+    const globalEvents = (global.session as unknown as { events: readonly SessionEvent[] }).events
+    const seededBoard = foldTaskBoard(globalEvents).get(SUBJECT_TASK_ID)
+    if (seededBoard?.evaluation === undefined) {
+      throw new Error(`seeded evaluation did not fold: ${JSON.stringify(globalEvents)}`)
+    }
+    const persistedGlobal = await scaffold.ctx.sessionPersistence.inspect(global.session.id as SessionId)
+    const persistedEvents = (persistedGlobal as unknown as { events: readonly SessionEvent[] }).events
+    const persistedBoard = foldTaskBoard(persistedEvents).get(SUBJECT_TASK_ID)
+    if (persistedBoard?.evaluation === undefined) {
+      throw new Error(`seeded evaluation did not persist: ${JSON.stringify(persistedEvents)}`)
+    }
+
+    browser = await chromium.launch()
+    page = await newEnglishPage(browser)
+    tripwire = watchConsole(page)
+    page.on('console', (message) => {
+      if (message.type() === 'error') consoleErrors.push(message.text())
+    })
+    await page.goto(scaffold.baseUrl, { waitUntil: 'load' })
+    await page.getByRole('button', { name: 'Global Controller', exact: true })
+      .waitFor({ timeout: 30_000 })
+  }, 180_000)
+
+  afterAll(async () => {
+    await browser?.close()
+    await globalBootstrap?.stop()
+    await scaffold?.close()
+  })
+
+  it('keeps the blank composer, controller, and GPT model surface usable', async () => {
+    onTestFailed(() => saveFailureShot(page, 'web-e2e-devframe-global-parity'))
+
+    await connectFreshWorkspace(page, scaffold.workspaceCwd, 'devframe-parity')
+
+    const blankComposer = page.locator(
+      'textarea:enabled[placeholder="Describe what you want to build"]',
+    )
+    await assertVisible(blankComposer)
+    await assertVisible(page.getByText('Standard mode', { exact: true }))
+    await assertVisible(page.getByRole('button', {
+      name: 'Access mode, current: Workspace Write',
+      exact: true,
+    }))
+
+    const controller = page.locator('button[aria-label="Global Controller"]').first()
+    await assertVisible(controller)
+    await controller.click()
+    await assertVisible(page.getByRole('tab', { name: 'Chat', exact: true }))
+    await assertVisible(page.getByRole('tab', { name: 'Trajectory', exact: true }))
+
+    const presetTrigger = page.getByRole('button', {
+      name: 'Switch Global Controller preset',
+      exact: true,
+    })
+    await assertVisible(presetTrigger)
+    await expect.poll(() => presetTrigger.isEnabled(), { timeout: 15_000 }).toBe(true)
+    // The sidebar action owns the accessible Global label. The current-session
+    // breadcrumb also says Global Controller, but is disabled navigation chrome;
+    // it must not create a second actionable Global entry.
+    expect(await page.locator('button[aria-label="Global Controller"]').count()).toBe(1)
+    expect(await page.getByRole('button', {
+      name: 'Switch Global Controller preset',
+      exact: true,
+    }).count()).toBe(1)
+
+    const modelTrigger = page.getByRole('button', {
+      name: /^Select model, current DeepSeek-V4-Flash/,
+    })
+    // Wait for the configured native model to settle before capturing the
+    // parity surface; otherwise suite ordering can snapshot the transient
+    // unconfigured "Select model" placeholder.
+    await assertVisible(modelTrigger)
+
+    const surfaceSnapshots: string[] = []
+    surfaceSnapshots.push(await captureStableAria(page, 'body', scaffold.workspaceCwd))
+    await presetTrigger.click()
+    const presetMenu = page.locator('[role="menu"]').last()
