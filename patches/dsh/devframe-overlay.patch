+
+async function raceAbort<T>(promise: Promise<T>, signal: AbortSignal): Promise<T> {
+  if (signal.aborted) {
+    void promise.catch(() => {})
+    throw abortError(signal)
+  }
+  let rejectAbort!: (error: CodexRuntimeError) => void
+  const aborted = new Promise<never>((_resolve, reject) => { rejectAbort = reject })
+  const onAbort = (): void => { rejectAbort(abortError(signal)) }
+  signal.addEventListener('abort', onAbort, { once: true })
+  try {
+    return await Promise.race([promise, aborted])
+  } finally {
+    signal.removeEventListener('abort', onAbort)
+  }
+}
+
+/** Cross every JSON-RPC failure through the provider's sanitized taxonomy. */
+async function safeRequest<T>(promise: Promise<T>, signal: AbortSignal, fatal?: Promise<never>): Promise<T> {
+  try {
+    const guarded = fatal === undefined ? promise : Promise.race([promise, fatal])
+    return await raceAbort(guarded, signal)
+  } catch (error: unknown) {
+    throw sanitizedProtocolError(error)
+  }
+}
