+import { describe, expect, it } from 'vitest'
+import type {
+  ConversationMatch, ConversationNodeContext, ConversationContextReader,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import { loopDefinition } from '../src/client/loop-definition.ts'
+import { objectiveDefinition } from '../src/client/objective-definition.ts'
+
+const reader: ConversationContextReader = { previous: () => undefined }
+
+function match(event: unknown): ConversationMatch {
+  return { event: event as never, view: undefined, role: 'start', location: { kind: 'session' } }
+}
+
+function context<State>(state: State, start: ConversationMatch): ConversationNodeContext<State> & { readonly state: State }
+function context<State>(state: State | undefined, start: ConversationMatch): ConversationNodeContext<State>
+function context<State>(state: State | undefined, start: ConversationMatch): ConversationNodeContext<State> {
+  return {
+    key: `${start.event.type}:${start.event.seq}`,
+    kind: 'test',
+    id: 'id-1',
+    matches: [start],
+    start,
+    state,
+    current: new Map(),
+  }
+}
+
+describe('DevFrame Global conversation projections', () => {
+  it('keeps objective text and folds routing and terminal changes', () => {
+    const create = match({
+      type: 'objective/change', seq: 1,
+      data: { schemaVersion: 1, kind: 'objective', version: 1, operation: 'create', objectiveId: 'obj-1', text: '修复流式输出', changedAt: 1 },
+    })
+    type ObjectiveState = NonNullable<Parameters<typeof objectiveDefinition.start>[0]['state']>
+    const state = objectiveDefinition.start(context<ObjectiveState>(undefined, create), create, reader)
+    const routed = objectiveDefinition.update(context(state, create), {
+      ...create,
+      role: 'update',
+      event: { type: 'objective/change', seq: 2, data: { schemaVersion: 1, kind: 'objective', version: 1, operation: 'route', objectiveId: 'obj-1', workspaceId: 'workspace-1', changedAt: 2 } } as never,
+    })
+    const node = objectiveDefinition.buildViewNode?.(context(routed, create))
+    expect(node?.data).toMatchObject({ text: '修复流式输出', workspaceId: 'workspace-1', status: 'routed' })
+  })
+
+  it('folds loop terminal and memory evidence without exposing paths', () => {
+    const start = match({
+      type: 'devframe/loop', seq: 3,
+      data: { schemaVersion: 1, kind: 'loop', version: 1, operation: 'start', loopId: 'loop-1', objectiveId: 'obj-1', projectId: 'workspace-1', changedAt: 3 },
+    })
+    type LoopState = NonNullable<Parameters<typeof loopDefinition.start>[0]['state']>
+    const state = loopDefinition.start(context<LoopState>(undefined, start), start, reader)
+    const memory = {
+      ...start,
+      role: 'update' as const,
+      event: { type: 'devframe/memory', seq: 4, data: { schemaVersion: 1, kind: 'memory', version: 1, operation: 'recall', loopId: 'loop-1', projectId: 'workspace-1', status: 'current', changedAt: 4 } } as never,
+    }
+    const withMemory = loopDefinition.update(context(state, start), memory)
+    const terminal = loopDefinition.update(context(withMemory, start), {
+      ...start,
+      role: 'update',
+      event: { type: 'devframe/loop', seq: 5, data: { schemaVersion: 1, kind: 'loop', version: 1, operation: 'complete', loopId: 'loop-1', objectiveId: 'obj-1', projectId: 'workspace-1', outcome: 'completed', review: 'passed', changedAt: 5 } } as never,
+    })
+    const node = loopDefinition.buildViewNode?.(context(terminal, start))
+    expect(node?.data).toMatchObject({ status: 'completed', review: 'passed', memoryStatus: 'current' })
+    expect(JSON.stringify(node)).not.toContain('C:/')
+  })
+})
