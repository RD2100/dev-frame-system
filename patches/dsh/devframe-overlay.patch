@@ -0,0 +1,137 @@
+/** Package-owned durable Codex subscription event invariant. @module @deepseek-ai/dsh-agent-runtime-codex/invariant */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { InvariantInstaller } from '@deepseek-ai/dsh-invariants'
+import type { Session } from '@deepseek-ai/dsh-session'
+import type {
+  CodexActionRejectedEvent,
+  CodexThreadBoundEvent,
+  CodexTurnBoundEvent,
+} from './types.ts'
+import { CODEX_SUBSCRIPTION_PROVIDER, CODEX_APP_SERVER_PROTOCOL } from './types.ts'
+
+const PACKAGE_NAME = '@deepseek-ai/dsh-agent-runtime-codex'
+const CODEX_MODEL_ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/
+
+/** Cordis companion plugin name. */
+export const name = 'agent-runtime-codex-invariant'
+/** Services required before the companion can register. */
+export const inject = ['invariants']
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+function hasExactKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
+  return Object.keys(value).length === keys.length && keys.every(key => Object.hasOwn(value, key))
+}
+
+function validThreadBinding(value: unknown): value is CodexThreadBoundEvent {
+  if (!isRecord(value)) return false
+  return hasExactKeys(value, ['threadId', 'provider', 'model', 'protocol', 'systemFingerprint'])
+    && value.provider === CODEX_SUBSCRIPTION_PROVIDER
+    && value.protocol === CODEX_APP_SERVER_PROTOCOL
+    && typeof value.threadId === 'string'
+    && /^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$/.test(value.threadId)
+    && typeof value.model === 'string'
+    && CODEX_MODEL_ID_PATTERN.test(value.model)
+    && typeof value.systemFingerprint === 'string'
+    && /^[a-f0-9]{64}$/.test(value.systemFingerprint)
+}
+
+function validActionRejected(value: unknown): value is CodexActionRejectedEvent {
+  if (!isRecord(value)) return false
+  return hasExactKeys(value, ['kind', 'decision', 'turn', 'step'])
+    && (value.kind === 'command'
+    || value.kind === 'file-change'
+    || value.kind === 'permissions'
+    || value.kind === 'user-input'
+    || value.kind === 'elicitation'
+    || value.kind === 'unknown')
+    && (value.decision === 'cancel' || value.decision === 'decline' || value.decision === 'empty')
+    && typeof value.turn === 'number'
+    && typeof value.step === 'number'
+    && Number.isSafeInteger(value.turn)
+    && Number.isSafeInteger(value.step)
+    && value.turn >= 0
+    && value.step >= 0
+}
+
+function validTurnBinding(value: unknown): value is CodexTurnBoundEvent {
+  if (!isRecord(value)) return false
+  return hasExactKeys(value, ['turn', 'step', 'turnId', 'status'])
+    && typeof value.turn === 'number'
+    && typeof value.step === 'number'
+    && Number.isSafeInteger(value.turn)
+    && Number.isSafeInteger(value.step)
+    && value.turn >= 0
+    && value.step >= 0
+    && typeof value.turnId === 'string'
+    && /^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$/.test(value.turnId)
+    && (value.status === 'started'
+      || value.status === 'completed'
+      || value.status === 'interrupted'
+      || value.status === 'failed')
+}
+
+/**
+ * The durable action/turn projections are meaningful only after one matching
+ * thread binding has been committed to the same Session.
+ */
+const install: InvariantInstaller = (ctx, fail) => {
+  const bindings = new WeakMap<Session, CodexThreadBoundEvent>()
+  const activeTurns = new WeakMap<Session, CodexTurnBoundEvent>()
+  ctx.on('session/event', (session, event) => {
+    if (event.type === 'codex/thread-bound') {
+      if (!validThreadBinding(event.data)) {
+        fail('codex/thread-bound must carry one validated subscription binding')
+      }
+      if (bindings.has(session)) {
+        fail('codex/thread-bound must be unique per Session')
+      }
+      bindings.set(session, event.data)
+      return
+    }
+    if (event.type === 'codex/turn-bound') {
+      if (!bindings.has(session)) {
+        fail('codex/turn-bound requires an earlier codex/thread-bound event')
+      }
+      if (!validTurnBinding(event.data)) {
+        fail('codex/turn-bound must carry a bounded turn projection')
+      }
+      const current = activeTurns.get(session)
+      if (event.data.status === 'started') {
+        if (current !== undefined) {
+          fail('codex/turn-bound cannot start a second turn before the first ends')
+        }
+        activeTurns.set(session, event.data)
+      } else {
+        if (current === undefined) {
+          fail('codex/turn-bound terminal status requires an earlier started status')
+        } else if (current.turn !== event.data.turn
+          || current.step !== event.data.step
+          || current.turnId !== event.data.turnId) {
+          fail('codex/turn-bound terminal status did not match its started status')
+        }
+        activeTurns.delete(session)
+      }
+      return
+    }
+    if (event.type === 'codex/action-rejected') {
+      if (!bindings.has(session)) {
+        fail('codex/action-rejected requires an earlier codex/thread-bound event')
+      }
+      if (!validActionRejected(event.data)) {
+        fail('codex/action-rejected must carry a bounded rejection projection')
+      }
+      const current = activeTurns.get(session)
+      if (current !== undefined && (current.turn !== event.data.turn || current.step !== event.data.step)) {
+        fail('codex/action-rejected did not match the active turn projection')
+      }
+    }
+  }, { global: true })
+}
+
+/** Register the package's durable Codex event relation. */
+export const apply = (ctx: Context): Promise<() => void> =>
+  Promise.resolve(ctx.invariants.register(PACKAGE_NAME, install))
