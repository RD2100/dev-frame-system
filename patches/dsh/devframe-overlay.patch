+// ---------------------------------------------------------------------------
+// Slice 1C-B: the PolicyDecision slot inside dispatchTask (design §12.5).
+// The whitelist short-circuits BEFORE the slot (fixed-test-payload stays
+// byte-identical); real payloads are assembled into a ContextPacket, validated,
+// and decided by the folded `policy/rule` events — only `allow` reaches the
+// 1B queue/admit core. This slice's slot adjudicates only; the durable
+// `policy/decision` trail lands in 1C-C (see below), `context/packet` stays a
+// 1C-D projection-derived summary.
+// ---------------------------------------------------------------------------
+
+function policyRule(overrides: {
+  readonly id?: string
+  readonly kind?: 'allow' | 'draft_only' | 'review_required' | 'human_required' | 'deny'
+  readonly match?: PolicyRuleV1['match']
+  readonly expiresAt?: number
+} = {}): PolicyRuleV1 {
+  return {
+    schemaVersion: 1,
+    id: overrides.id ?? 'rule-1',
+    kind: overrides.kind ?? 'allow',
+    match: overrides.match ?? {},
+    ...overrides.expiresAt === undefined ? {} : { expiresAt: overrides.expiresAt },
+  }
+}
+
+function appendPolicyRule(session: Session, rule: PolicyRuleV1): void {
+  // `policy/rule` is a 1C local event type not yet in the typed vocabulary, so
+  // the append is structurally typed via an in-map key (the 1C-A folds read
+  // the same raw shape); the runtime never validates the type against the map.
+  session.append(POLICY_RULE_EVENT_TYPE as 'task/change', rule as never)
+}
