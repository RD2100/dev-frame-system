@@ -0,0 +1,778 @@
+/** Client-safe DevFrame Controller Session event contract. @module @deepseek-ai/dsh-devframe-control-session/types */
+
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { FrozenAssetV1, PolicyDecisionKind, PolicyRuleV1 } from './policy.ts'
+
+/**
+ * The original test-payload whitelist key (design §11.9/§12.9): the only
+ * payload reference admitted without a PolicyDecision. The provider-neutral
+ * executor capability is separate and always crosses the PolicyDecision slot.
+ * The dispatchTask short-circuit and roster gate read this constant — never
+ * re-declare the literal elsewhere.
+ */
+export const TASK_PAYLOAD_WHITELIST = 'fixed-test-payload' as const
+/** The whitelist key's literal type, for capability arrays and payload refs. */
+export type TaskPayloadWhitelist = typeof TASK_PAYLOAD_WHITELIST
+
+/** Controller roles supported by the Slice 0 identity tracer. */
+export type ControllerRole = 'global' | 'project'
+
+/** Profile-scoped Global Controller identity. */
+export interface GlobalControllerIdentityV1 {
+  readonly schemaVersion: 1
+  readonly role: 'global'
+  readonly sessionId: SessionId
+  readonly profileId: string
+  readonly cwd: string
+}
+
+/** Workspace-scoped Project Controller identity. */
+export interface ProjectControllerIdentityV1 {
+  readonly schemaVersion: 1
+  readonly role: 'project'
+  readonly sessionId: SessionId
+  readonly profileId: string
+  readonly workspaceId: string
+  readonly cwd: string
+}
+
+/** Exact versioned payload stored in the required log-only identity event. */
+export type ControllerIdentityV1 = GlobalControllerIdentityV1 | ProjectControllerIdentityV1
+
+/**
+ * Pathless completion record written to the stable Controller Session after
+ * one isolated Run Session settles.  The full model transcript remains in the
+ * child Run Session; this event is only the compact index the Controller may
+ * use on a later turn.
+ */
+export interface ControllerRunSummaryV1 {
+  readonly schemaVersion: 1
+  readonly runSessionId: SessionId
+  readonly parentSessionId: SessionId
+  readonly goalId: string
+  readonly revision: number
+  readonly round: number
+  readonly roundsCompleted: number
+  readonly provider: string
+  readonly model: string
+  readonly outcome: 'completed' | 'failed' | 'aborted'
+  readonly completedAt: number
+}
+
+/** Finite, client-safe reasons why the Global Controller is unavailable. */
+export type DevFrameReadinessBlockedCode =
+  | 'BOOTSTRAP_NOT_STARTED'
+  | 'PROFILE_IDENTITY_UNAVAILABLE'
+  | 'PROFILE_LEASE_UNAVAILABLE'
+  | 'LOADER_UNAVAILABLE'
+  | 'CONTROLLER_UNAVAILABLE'
+
+/** Global Controller startup has begun but no navigable Session is ready. */
+export interface DevFrameReadinessStarting {
+  readonly status: 'starting'
+  readonly generation: number
+  readonly revision: number
+}
+
+/** Global Controller startup completed and its Session may be opened. */
+export interface DevFrameReadinessReady {
+  readonly status: 'ready'
+  readonly generation: number
+  readonly revision: number
+  readonly sessionId: string
+}
+
+/** Global Controller startup stopped at one bounded failure category. */
+export interface DevFrameReadinessBlocked {
+  readonly status: 'blocked'
+  readonly generation: number
+  readonly revision: number
+  readonly code: DevFrameReadinessBlockedCode
+}
+
+/** The current bootstrap generation is withdrawing its owned Controller. */
+export interface DevFrameReadinessStopping {
+  readonly status: 'stopping'
+  readonly generation: number
+  readonly revision: number
+}
+
+/** Pathless, credential-free Global Controller readiness projection. */
+export type DevFrameReadinessSnapshot =
+  | DevFrameReadinessStarting
+  | DevFrameReadinessReady
+  | DevFrameReadinessBlocked
+  | DevFrameReadinessStopping
+
+/** One Slice 0 Health check: a stable id, a tri-state verdict, and bounded guidance. */
+export interface DevFrameHealthItem {
+  /** Stable check id, e.g. `host-lease`. */
+  readonly id: string
+  /** `ready` when the check passes; `degraded` when partial; `blocked` when missing. */
+  readonly status: 'ready' | 'degraded' | 'blocked'
+  /** One-line reason, pathless and credential-free. */
+  readonly reason?: string
+  /** What the user loses while the check is not ready. */
+  readonly impact?: string
+  /** Bounded remediation hint or the slice that owns the fix. */
+  readonly action?: string
+}
+
+/** Pathless, credential-free Slice 0 Health projection. */
+export interface DevFrameHealthSnapshot {
+  /** Monotonic revision; consumers re-render only on change. */
+  readonly revision: number
+  /** Every Slice 0 check, in stable order. */
+  readonly items: readonly DevFrameHealthItem[]
+}
+
+/**
+ * Durable payload of the Slice 1A `project-authority/bound` event: the Host
+ * publishing project write authority over one workspace to one profile.
+ * Pathless and credential-free (the cwd already lives in the identity event).
+ */
+export interface ProjectAuthorityBoundV1 {
+  readonly schemaVersion: 1
+  /** Native Workspace id, matching the identity event's scope id. */
+  readonly workspaceId: string
+  /** Host-published profile identity (ctx.get('profileIdentity')); callers cannot supply it. */
+  readonly profileId: string
+  /** This event's seq: the execution-continuity anchor (see resumePointer). */
+  readonly resumePointer: number
+  /** CAS optimistic-concurrency number, monotonically +1 from 0. */
+  readonly boundRevision: number
+  /** Epoch ms, observability only. */
+  readonly boundAt: number
+  /** Optional expiry; absent = never expires. "Not expired" checks read only this field. */
+  readonly expiresAt?: number
+}
+
+/** Pathless project-authority projection for clients and the Health card. */
+export interface DevFrameProjectAuthorityView {
+  readonly status: 'bound' | 'none' | 'expired'
+  readonly workspaceId?: string
+  readonly profileId?: string
+  /** Seq of the last flushed bound event; the dispatch-resume anchor. */
+  readonly resumePointer?: number
+  readonly boundRevision?: number
+  readonly boundAt?: number
+  readonly expiresAt?: number
+}
+
+/** One bounded Goal → Task → Run trace over the native DSH log. */
+export interface DevFrameGoalDispatchTrace {
+  /** Native Goal id from the durable `goal/change` event. */
+  readonly goalId: string
+  /** Goal revision observed after the bounded round settles. */
+  readonly revision: number
+  /** Task mapping: the number of admitted Goal Rounds. */
+  readonly round: number
+  /** Number of model turns that reached a durable `turn/end`. */
+  readonly roundsCompleted: number
+  /** Run mapping: the Global Controller's native Agent Session. */
+  readonly sessionId: SessionId
+  /** Stable Controller Session that owns this isolated Run, when applicable. */
+  readonly parentSessionId?: SessionId
+  /** Provider route selected by `ctx.agentDefaultModel`. */
+  readonly provider: string
+  /** Provider model selected by `ctx.agentDefaultModel`. */
+  readonly model: string
+  /** Bounded review outcome for the one admitted turn. */
+  readonly outcome: 'completed' | 'failed' | 'aborted'
+}
+
+/** A bounded Project Controller dispatch trace with no absolute path fields. */
+export interface DevFrameProjectGoalDispatchTrace extends DevFrameGoalDispatchTrace {
+  readonly projectId: string
+  /** The routed objective record this dispatch belongs to. */
+  readonly objectiveId: string
+}
+
+/** State-changing verbs recorded in the Global Controller `objective/change` log. */
+export type ObjectiveOperation = 'create' | 'route' | 'complete' | 'cancel'
+
+/** Target-record creation: structural-only objective text, never parsed. */
+export interface ObjectiveCreateChangeV1 {
+  readonly schemaVersion: 1
+  readonly kind: 'objective'
+  readonly version: 1
+  readonly operation: 'create'
+  readonly objectiveId: string
+  /** Structural-only target text: non-empty and length-bounded, no semantics. */
+  readonly text: string
+  /** Epoch ms, observability only. */
+  readonly changedAt: number
+}
+
+/** Milestone routing: binds the objective to one native Workspace. */
+export interface ObjectiveRouteChangeV1 {
+  readonly schemaVersion: 1
+  readonly kind: 'objective'
+  readonly version: 1
+  readonly operation: 'route'
+  readonly objectiveId: string
+  /** Native Workspace id the objective is routed to (= the Milestone). */
+  readonly workspaceId: string
+  /** Epoch ms, observability only. */
+  readonly changedAt: number
+}
+
+/** Terminal objective record: completed or cancelled; no longer dispatchable. */
+export interface ObjectiveTerminalChangeV1 {
+  readonly schemaVersion: 1
+  readonly kind: 'objective'
+  readonly version: 1
+  readonly operation: 'complete' | 'cancel'
+  readonly objectiveId: string
+  /** Epoch ms, observability only. */
+  readonly changedAt: number
+}
+
+/**
+ * Durable change union carried by the Global Controller's own session event.
+ * Mirrors the `goal/change` `{kind, version, operation}` style; one objective
+ * = one create + one route, terminal operations close the record.
+ */
+export type ObjectiveChangeV1 =
+  | ObjectiveCreateChangeV1
+  | ObjectiveRouteChangeV1
+  | ObjectiveTerminalChangeV1
+
+/**
+ * Thin append-only Objective→Run association recorded in the Project
+ * Controller log: the in-log index from a routed objective back to its native
+ * Goal record. Not a second mapping table; restart replays rebuild the chain.
+ */
+export interface ProjectRunV1 {
+  readonly schemaVersion: 1
+  readonly objectiveId: string
+  readonly goalId: string
+  readonly revision: number
+}
+
+/** Bounded lifecycle operations for one Global→Project automatic loop. */
+export type DevFrameLoopOperation =
+  | 'start' | 'memory-recall' | 'route' | 'dispatch' | 'review'
+  | 'checkpoint' | 'complete' | 'fail'
+
+/** Review state for a loop projection. Execution completion is not acceptance. */
+export type DevFrameLoopReview = 'pending' | 'passed' | 'failed'
+
+/** Pathless durable loop lifecycle record owned by the Host. */
+export interface DevFrameLoopChangeV1 {
+  readonly schemaVersion: 1
+  readonly kind: 'loop'
+  readonly version: 1
+  readonly operation: DevFrameLoopOperation
+  readonly loopId: string
+  readonly objectiveId: string
+  readonly projectId: string
+  readonly projectSessionId?: SessionId
+  readonly runSessionId?: SessionId
+  /** Hash of the caller request key; raw keys never enter durable history. */
+  readonly requestIdempotencyKeyHash?: string
+  readonly outcome?: 'completed' | 'failed' | 'aborted'
+  readonly review?: DevFrameLoopReview
+  readonly changedAt: number
+}
+
+/** Bounded status values returned by the canonical governed-memory adapter. */
+export type DevFrameMemoryStatus =
+  | 'unknown' | 'current' | 'missing' | 'stale' | 'captured' | 'duplicate'
+  | 'unavailable' | 'failed'
+
+/** Pathless result of a Host-owned request to open the current Working Plan. */
+export interface MemoryOpenResult {
+  readonly opened: boolean
+  readonly status: Extract<DevFrameMemoryStatus, 'current' | 'missing' | 'stale' | 'unavailable'>
+}
+
+/** Durable governed-memory lifecycle operations for one automatic loop. */
+export type DevFrameMemoryOperation =
+  | 'bound' | 'recall' | 'write-requested' | 'write-committed'
+  | 'write-unavailable' | 'write-failed'
+
+/** Pathless durable memory evidence; no Vault path or memory body is stored. */
+export interface DevFrameMemoryChangeV1 {
+  readonly schemaVersion: 1
+  readonly kind: 'memory'
+  readonly version: 1
+  readonly operation: DevFrameMemoryOperation
+  readonly loopId: string
+  readonly projectId: string
+  readonly status: DevFrameMemoryStatus
+  readonly idempotencyKeyHash?: string
+  readonly memoryId?: string
+  readonly changedAt: number
+}
+
+/** Pathless result of one Global→Project automatic loop. */
+export interface DevFrameProjectLoopTrace {
+  readonly loopId: string
+  readonly objectiveId: string
+  readonly projectId: string
+  readonly projectSessionId: SessionId
+  readonly runSessionId?: SessionId
+  /** Optional native Goal trace fields; present after a live dispatch. */
+  readonly goalId?: string
+  readonly revision?: number
+  readonly round?: number
+  readonly roundsCompleted?: number
+  readonly sessionId?: SessionId
+  readonly parentSessionId?: SessionId
+  readonly provider?: string
+  readonly model?: string
+  readonly outcome: 'completed' | 'failed' | 'aborted'
+  readonly review: DevFrameLoopReview
+  readonly memoryStatus: DevFrameMemoryStatus
+}
+
+/** Input for the Global Controller's one-call Project dispatch loop. */
+export interface DispatchProjectLoopOptions {
+  readonly profileId: string
+  readonly projectId: string
+  readonly projectRoot: string
+  readonly objective: string
+  readonly maxGoalRounds?: number
+  /** Stable caller key used to make transport retries return the same loop. */
+  readonly requestIdempotencyKey?: string
+  readonly signal?: AbortSignal
+}
+
+/** Input for routing one Global Controller objective record to a Workspace. */
+export interface RouteObjectiveOptions {
+  readonly profileId: string
+  /** Structural-only target text: non-empty and length-bounded, never parsed. */
+  readonly objective: string
+  /** Host-internal stable id used by an automatic loop retry. */
+  readonly objectiveId?: string
+  /** Native DSH Workspace id the objective is routed to (= the Milestone). */
+  readonly workspaceId: string
+  readonly signal?: AbortSignal
+}
+
+/** Pathless result of one objective route after the Global log is durable. */
+export interface RouteObjectiveResult {
+  readonly objectiveId: string
+  readonly workspaceId: string
+}
+
+/**
+ * Durable payload of the Slice 1B `roster/registered` event: the Host
+ * registering one Worker (its Controller Session id) under a stable role
+ * assignment. Pathless; the registration is the dispatch gate's only
+ * addressing source (never a free-text Agent name — hard stop §11.8).
+ */
+export interface RosterRegisteredV1 {
+  readonly schemaVersion: 1
+  /** Worker Session id: the unique dispatch target. */
+  readonly workerId: string
+  /** Stable role key (e.g. 'executor'), bound at registration. */
+  readonly roleAssignment: string
+  /** Host-published profile identity; callers cannot supply it. */
+  readonly profileId: string
+  /** Registered Workspace id; absent = global scope. */
+  readonly workspaceScope?: string
+  /** Capability keys; Slice 1B admits only 'fixed-test-payload'. */
+  readonly capabilities: readonly string[]
+  /** CAS optimistic-concurrency number, monotonically +1 from 0. */
+  readonly rosterRevision: number
+  /** pending = reserved; ready = Worker session created; offline = deactivated. */
+  readonly status: 'pending' | 'ready' | 'offline'
+  /** Epoch ms, observability only. */
+  readonly registeredAt: number
