+  private respondToRequests = false
+  spawnCalls = 0
+
+  resolveExecutable(command: string): Promise<string> {
+    return Promise.resolve(command)
+  }
+
+  spawn(_spec: SubprocessSpawnSpec): SubprocessHandle {
+    this.spawnCalls += 1
+    const stdin = new PassThrough()
+    const stdout = new PassThrough()
+    const done = Promise.withResolvers<{ exitCode: number | null; signal: NodeJS.Signals | null }>()
+    const exit = Promise.withResolvers<true>()
+    let buffered = ''
+    stdin.on('data', (chunk: Buffer | string) => {
+      buffered += chunk.toString()
+      for (;;) {
+        const newline = buffered.indexOf('\n')
+        if (newline < 0) break
+        const line = buffered.slice(0, newline)
+        buffered = buffered.slice(newline + 1)
+        if (line.length === 0) continue
+        const frame = JSON.parse(line) as { id?: unknown; method?: unknown }
+        if (typeof frame.id !== 'string' || typeof frame.method !== 'string') continue
+        if (this.respondToRequests) this.respond(stdout, frame.id, frame.method)
+        else this.pending.set(frame.id, { method: frame.method, output: stdout })
+      }
+    })
+    this.spawned.resolve(true)
+    return {
+      pid: 8_700 + this.spawnCalls,
+      stdin,
+      stdout,
+      stderr: undefined,
+      collected: {},
+      done: done.promise,
+      terminate: () => {
+        stdin.end()
+        stdout.end()
+        done.resolve({ exitCode: null, signal: 'SIGTERM' })
+        exit.resolve(true)
+      },
+      waitForExit: async () => {
