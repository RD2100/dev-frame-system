+        }
+        length = pending.readUInt32BE(6)
+        offset = 10
+      }
+      if (length > MAX_FIXTURE_BYTES) {
+        socket.destroy(new Error(`loopback Responses WebSocket frame exceeded ${MAX_FIXTURE_BYTES} bytes`))
+        return
+      }
+      const maskOffset = masked ? 4 : 0
+      if (masked && pending.length < offset + 4) return
+      const frameEnd = offset + maskOffset + length
+      if (pending.length < frameEnd) return
+      const mask = masked ? pending.subarray(offset, offset + 4) : undefined
+      const payload = Buffer.from(pending.subarray(offset + maskOffset, frameEnd))
+      pending = pending.subarray(frameEnd)
+      if (mask !== undefined) {
+        for (let index = 0; index < payload.length; index++) {
+          payload[index] = payload[index]! ^ mask[index % 4]!
+        }
+      }
+      if (!fin) {
+        if (opcode === 0 || fragmentedOpcode !== undefined) {
+          socket.destroy(new Error('loopback Responses WebSocket fragmentation is invalid'))
+          return
+        }
+        if (fragmentedBytes + payload.length > MAX_FIXTURE_BYTES) {
+          socket.destroy(new Error(`loopback Responses WebSocket fragments exceeded ${MAX_FIXTURE_BYTES} bytes`))
+          return
+        }
+        fragmentedOpcode = opcode
+        fragments = [payload]
+        fragmentedBytes = payload.length
+        continue
+      }
+      let completePayload = payload
+      let completeOpcode = opcode
+      if (opcode === 0) {
+        if (fragmentedOpcode === undefined) {
+          socket.destroy(new Error('loopback Responses WebSocket continuation is invalid'))
+          return
+        }
+        if (fragmentedBytes + payload.length > MAX_FIXTURE_BYTES) {
+          socket.destroy(new Error(`loopback Responses WebSocket fragments exceeded ${MAX_FIXTURE_BYTES} bytes`))
+          return
+        }
+        fragments.push(payload)
+        fragmentedBytes += payload.length
+        completePayload = Buffer.concat(fragments)
+        completeOpcode = fragmentedOpcode
+        fragmentedOpcode = undefined
+        fragments = []
+        fragmentedBytes = 0
+      } else if (fragmentedOpcode !== undefined) {
+        socket.destroy(new Error('loopback Responses WebSocket interleaving is invalid'))
+        return
+      }
+      if (completeOpcode === 0x8) {
+        sendWebsocketClose(socket)
+        return
+      }
+      if (completeOpcode === 0x9) {
+        if (!socket.destroyed) socket.write(websocketFrame(0xa, completePayload))
+        continue
+      }
+      if (completeOpcode === 0x1) {
+        onText(completePayload.toString('utf8'))
+      }
+    }
+  }
+  socket.on('data', (chunk: Buffer) => {
+    if (fragmentedBytes + pending.length + chunk.length > MAX_FIXTURE_BYTES) {
+      socket.destroy(new Error(`loopback Responses WebSocket pending data exceeded ${MAX_FIXTURE_BYTES} bytes`))
+      return
+    }
+    pending = Buffer.concat([pending, chunk])
+    parse()
+  })
+  socket.on('error', () => { socket.destroy() })
+  parse()
+}
