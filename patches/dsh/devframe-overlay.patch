+class ReviewAdapter extends LlmAdapter {
+  private reviewToolCalls = 0
+
+  override async *stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    const prompt = JSON.stringify(options.messages ?? [])
+    if (prompt.includes('DevFrame independent review context') && this.reviewToolCalls++ === 0) {
+      const argumentsJson = JSON.stringify({
+        verdict: 'request_revision',
+        findings: 'The bounded evaluator requests one revision.',
+      })
+      const id = CallId('evaluation-review-submit')
+      yield { type: 'block-start', index: 0, blockType: 'tool-call' }
+      yield { type: 'tool-call-delta', index: 0, id, name: 'devframe_submit_review', argumentsDelta: argumentsJson }
+      yield { type: 'block-end', index: 0, block: { type: 'tool-call', id, name: 'devframe_submit_review', arguments: argumentsJson } }
+      yield { type: 'finish', reason: { kind: 'tool-calls' } }
+      return
+    }
+    yield { type: 'block-start', index: 0, blockType: 'text' }
+    yield { type: 'block-end', index: 0, block: { type: 'text', text: 'bounded response' } }
+    yield { type: 'finish', reason: { kind: 'stop' } }
+  }
