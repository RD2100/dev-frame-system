@@ -0,0 +1,42 @@
+import type { Context } from '@deepseek-ai/cordis'
+// Side-effect type import: activates the generated namespace declaration
+// merge that supplies `TypertRemoteNamespaceMap` below.
+import type {} from '@deepseek-ai/dsh-devframe-control-session/remote'
+import type { TypertRemoteNamespaceMap } from '@deepseek-ai/dsh-typert-protocol'
+
+/**
+ * One resolved DevFrame Remote namespace face, taken from the generated
+ * Host Remote surface so client code never hand-declares a drifting shape.
+ */
+export type DevFrameRemoteNamespace = TypertRemoteNamespaceMap['devframeControlSessions']
+
+/**
+ * Resolve the mounted DevFrame Remote namespace through the non-strict root
+ * lookup.
+ *
+ * The namespace is installed dynamically by `api-remotes`' async `$mount`
+ * (gateway `RemoteNamespaceService`): it lives in the root service store but
+ * never in any fiber's inject declaration. Cordis property access
+ * (`ctx.remote.devframeControlSessions`) therefore trips the strict
+ * "without inject" fence in every phase — inside the apply runtime and after
+ * the tree settled — while the non-strict `ctx.get(name, false)` lookup
+ * succeeds. `undefined` is legitimate before the mount completes; callers
+ * treat it as "retry later".
+ * @param ctx - the browser context.
+ * @returns the namespace face, or `undefined` when not mounted yet.
+ */
+export function devframeRemoteFace(ctx: Context): DevFrameRemoteNamespace | undefined {
+  const face = ctx.get('remote.devframeControlSessions', false) as DevFrameRemoteNamespace | undefined
+  if (face !== undefined) return face
+  // Non-Cordis test harnesses provide a plain carrier as `ctx.remote` instead
+  // of mounting the namespace service; keep the property fallback for them.
+  try {
+    const remote = (ctx.remote as { devframeControlSessions?: DevFrameRemoteNamespace } | undefined)
+    return remote?.devframeControlSessions
+  } catch (error) {
+    // The only expected throw is the Cordis strict-lookup fence ("without
+    // inject"); anything else is a real fault and must surface, not hide.
+    if (error instanceof Error && error.message.includes('without inject')) return undefined
+    throw error
+  }
+}
diff --git a/packages/client/ui-devframe-control-session/src/client/task-board-store.ts b/packages/client/ui-devframe-control-session/src/client/task-board-store.ts
