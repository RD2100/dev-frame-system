+        'conversation.session.header.actions': { kind: 'list', scope: 'session' },
+        'sidebar.footer.action': { kind: 'list', scope: 'root' },
+      },
+    } as never, () => null)
+
+    const fiber = ctx.plugin({ inject: ['connection', 'slots', 'conversationEvents', 'locale', 'sessions', 'remote', 'inputTriggers'], apply })
+    await fiber.await()
+    expect(ctx.conversationEvents.entries()).toEqual(expect.arrayContaining([
+      controllerIdentityDefinition,
+    ]))
+    expect(ctx.conversationEvents.entries()).toHaveLength(3)
+    expect(ctx.slots.entries('conversation.chat.node')).toHaveLength(3)
+    const globalPresetEntry = ctx.slots.entries('conversation.session.header.actions')[0]
+    expect(globalPresetEntry?.component).toBe(GlobalPresetSelector)
+    expect(globalPresetEntry?.options).toMatchObject({ id: 'devframe-global-preset' })
+    expect(ctx.slots.entries('sidebar.footer.action')).toHaveLength(1)
+
+    const selector = (ctx.slots.entries('conversation.session.header.actions')[0]!.inject as unknown as () => {
+      load: () => Promise<void>
+    })()
+    await selector.load()
+    expect(list).toHaveBeenCalledTimes(1)
+    dispatchRemote('settings/document-updated', 'llm-deepseek', 1)
+    await Promise.resolve()
+    expect(list).toHaveBeenCalledTimes(1)
+    dispatchRemote('settings/document-updated', 'agent-presets', 1)
+    await vi.waitFor(() => { expect(list).toHaveBeenCalledTimes(2) })
+    // Let the controller clear its single-flight promise before exercising
+    // the second invalidator.
+    await Promise.resolve()
+    ctx.emit('connection/reset')
+    await vi.waitFor(() => { expect(list).toHaveBeenCalledTimes(3) })
+
+    await fiber.dispose()
+    dispatchRemote('settings/document-updated', 'agent-presets', 2)
+    ctx.emit('connection/reset')
+    await Promise.resolve()
+    expect(list).toHaveBeenCalledTimes(3)
+    expect(ctx.conversationEvents.entries()).toEqual([])
+    expect(ctx.slots.entries('conversation.chat.node')).toEqual([])
+
+    const replacement = ctx.plugin({ inject: ['connection', 'slots', 'conversationEvents', 'locale', 'sessions', 'remote', 'inputTriggers'], apply })
+    await replacement.await()
+    expect(ctx.conversationEvents.entries()).toEqual(expect.arrayContaining([
+      controllerIdentityDefinition,
+    ]))
+    expect(ctx.conversationEvents.entries()).toHaveLength(3)
+    expect(ctx.slots.entries('conversation.chat.node')).toHaveLength(3)
+    const replacementGlobalPresetEntry = ctx.slots.entries('conversation.session.header.actions')[0]
+    expect(replacementGlobalPresetEntry?.component).toBe(GlobalPresetSelector)
+    expect(replacementGlobalPresetEntry?.options).toMatchObject({ id: 'devframe-global-preset' })
+    expect(ctx.slots.entries('sidebar.footer.action')).toHaveLength(1)
+    await replacement.dispose()
+    await ctx.fiber.dispose()
+  })
