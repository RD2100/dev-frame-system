+  hostCtx: Context,
+  agentCtx: Context,
+  worker: RosterView,
+): AgentSetupCommit | Promise<AgentSetupCommit> {
+  const agent = agentCtx.agent
+  if (agent === undefined) throw new ControlSessionError('IDENTITY_INVALID')
+  const executionEnabled = worker.capabilities.includes(TASK_PAYLOAD_EXECUTE)
+  const reviewEnabled = worker.capabilities.includes(TASK_PAYLOAD_REVIEW)
+  if (!executionEnabled && !reviewEnabled) {
+    agentCtx.tools.restrict({ allow: [] })
+    agentCtx.tools.guard(() => WORKER_GUARD_REASON)
+    return { commit() {} }
+  }
+  const presets = hostCtx.get('agentPresets')
+  if (presets === undefined) throw new ControlSessionError('PRESET_UNAVAILABLE')
+  return presets.mount(agentCtx, PROJECT_AGENT_PRESET).then((mounted: { readonly id: string }) => {
+    if (mounted.id !== PROJECT_AGENT_PRESET) throw new ControlSessionError('PRESET_UNAVAILABLE')
+    const candidates = executionEnabled ? EXECUTOR_ALLOWED_TOOLS : REVIEWER_ALLOWED_TOOLS
+    const allowed = [...availableWorkerTools(agentCtx, agent, candidates)]
+    agentCtx.tools.restrict({ allow: allowed })
+    const toolSet = executionEnabled ? EXECUTOR_ALLOWED_TOOL_SET : REVIEWER_ALLOWED_TOOL_SET
+    const guardReason = executionEnabled
+      ? EXECUTOR_GUARD_REASON
+      : 'DevFrame reviewer Worker tool is outside its approved read-only face'
+    agentCtx.tools.guard(execution => toolSet.has(execution.name)
+      ? undefined : guardReason)
+    return { commit() {} }
+  }, (failure: unknown) => {
+    if (failure instanceof ControlSessionError) throw failure
+    throw new ControlSessionError('PRESET_UNAVAILABLE', { cause: failure })
+  })
+}
