+/** Build one bounded model-facing recall message without exposing Vault paths. */
+function createMemoryRecallMessage(recall: MemoryRecallResult): UserMessage | undefined {
+  if (recall.status !== 'current' || recall.plan === undefined) return undefined
+  if (recall.plan.length === 0 || recall.plan.length > MEMORY_PLAN_MAX_CHARS
+    || recall.plan.includes('\u0000')) {
+    throw new ControlSessionError('MEMORY_INVALID')
+  }
+  const hashLines = [
+    typeof recall.planSha256 === 'string' && /^[0-9a-f]{64}$/u.test(recall.planSha256)
+      ? `Plan hash: ${recall.planSha256}` : undefined,
+    typeof recall.sourceSha256 === 'string' && /^[0-9a-f]{64}$/u.test(recall.sourceSha256)
+      ? `Authority source hash: ${recall.sourceSha256}` : undefined,
+  ].filter((line): line is string => line !== undefined)
+  return createUserMessage({
+    content: [{
+      type: 'text',
+      text: [MEMORY_RECALL_CONTEXT_PREFIX, ...hashLines, '', recall.plan].join('\n'),
+    }],
+    source: { kind: 'plugin', plugin: 'devframe-memory', form: 'recall' },
+  })
