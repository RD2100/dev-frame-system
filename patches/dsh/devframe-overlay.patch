+import { afterEach, describe, expect, it } from 'vitest'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import {
+  createDevFrameMcpMemoryGateway,
+  foldMemory,
+  foldLoop,
+  MEMORY_CHANGE_EVENT_TYPE,
+  MEMORY_PLAN_MAX_CHARS,
+  LOOP_CHANGE_EVENT_TYPE,
+  parseMemoryChange,
+  parseLoopChange,
+} from '../src/memory.ts'
+
+const roots: string[] = []
+
+afterEach(async () => {
+  for (const root of roots.splice(0).reverse()) await rm(root, { recursive: true, force: true })
+})
+
+function event(type: string, seq: number, data: unknown): SessionEvent {
+  return { type, seq, time: Date.now(), data } as never
+}
+
+describe('governed memory event contracts', () => {
+  it('folds the latest exact-key memory state and rejects forged fields', () => {
+    const loopId = 'loop-1'
+    const projectId = 'project-1'
+    const events = [
+      event(MEMORY_CHANGE_EVENT_TYPE, 0, {
+        schemaVersion: 1, kind: 'memory', version: 1, operation: 'bound',
+        loopId, projectId, status: 'unknown', changedAt: 1,
+      }),
+      event(MEMORY_CHANGE_EVENT_TYPE, 1, {
+        schemaVersion: 1, kind: 'memory', version: 1, operation: 'write-committed',
+        loopId, projectId, status: 'captured', idempotencyKeyHash: 'a'.repeat(64), changedAt: 2,
+      }),
+    ]
+    expect(foldMemory(events, loopId)).toMatchObject({ operation: 'write-committed', status: 'captured' })
+    expect(() => parseMemoryChange({
+      schemaVersion: 1, kind: 'memory', version: 1, operation: 'bound',
+      loopId, projectId, status: 'unknown', changedAt: 1, forged: true,
+    })).toThrow(expect.objectContaining({ code: 'MEMORY_INVALID' }))
+  })
+
+  it('folds a loop projection and rejects a non-contiguous event log', () => {
+    const change = {
+      schemaVersion: 1, kind: 'loop', version: 1, operation: 'complete',
+      loopId: 'loop-1', objectiveId: 'objective-1', projectId: 'project-1',
+      projectSessionId: 'devframe-controller:project-1', outcome: 'completed',
+      review: 'passed', changedAt: 3,
+    }
+    expect(parseLoopChange(change)).toMatchObject({ operation: 'complete' })
+    expect(foldLoop([event(LOOP_CHANGE_EVENT_TYPE, 0, change)], 'loop-1')).toMatchObject({
+      objectiveId: 'objective-1', projectId: 'project-1', outcome: 'completed', review: 'passed',
+    })
+    expect(parseLoopChange({ ...change, review: 'pending' })).toMatchObject({ review: 'pending' })
+    expect(() => foldLoop([event(LOOP_CHANGE_EVENT_TYPE, 4, change)], 'loop-1'))
+      .toThrow(expect.objectContaining({ code: 'LOOP_INVALID' }))
+  })
+})
+
+describe('DevFrame memory MCP gateway', () => {
+  it('returns a bounded current Working Plan with hash provenance', async () => {
+    const root = await mkdtemp(join(tmpdir(), 'dsh-memory-gateway-'))
+    roots.push(root)
+    const server = [
+      "process.stdin.setEncoding('utf8');",
+      "let b=''; process.stdin.on('data',c=>{b+=c; let i; while((i=b.indexOf('\\n'))>=0){const r=JSON.parse(b.slice(0,i)); b=b.slice(i+1); const v=r.method==='tools/call'?{content:[{type:'text',text:JSON.stringify({status:'current',relativePath:'wiki/memories/project-now-current.md',plan:'## Keep the controller bounded\\n\\n- Reuse DSH session persistence.',planSha256:'a'.repeat(64),sourceSha256:'b'.repeat(64)})}]}:{}; process.stdout.write(JSON.stringify({jsonrpc:'2.0',id:r.id,result:v})+'\\n');}});",
+    ].join('')
+    const gateway = createDevFrameMcpMemoryGateway({
+      command: process.execPath,
+      args: ['-e', server],
+      timeoutMs: 5_000,
+    })
+    await expect(gateway.recallProjectPlan({ projectId: 'project-1', projectRoot: root }))
+      .resolves.toEqual({
+        status: 'current',
+        relativePath: 'wiki/memories/project-now-current.md',
+        plan: '## Keep the controller bounded\n\n- Reuse DSH session persistence.',
+        planSha256: 'a'.repeat(64),
+        sourceSha256: 'b'.repeat(64),
+      })
+  })
+
+  it('rejects an absolute or traversing current-note reference', async () => {
+    const root = await mkdtemp(join(tmpdir(), 'dsh-memory-gateway-'))
+    roots.push(root)
+    const server = [
+      "process.stdin.setEncoding('utf8');",
+      "let b=''; process.stdin.on('data',c=>{b+=c; let i; while((i=b.indexOf('\\n'))>=0){const r=JSON.parse(b.slice(0,i)); b=b.slice(i+1); const v=r.method==='tools/call'?{content:[{type:'text',text:JSON.stringify({status:'current',relativePath:'../outside.md',plan:'bounded'})}]}:{}; process.stdout.write(JSON.stringify({jsonrpc:'2.0',id:r.id,result:v})+'\\n');}});",
+    ].join('')
+    const gateway = createDevFrameMcpMemoryGateway({
+      command: process.execPath,
+      args: ['-e', server],
+      timeoutMs: 5_000,
+    })
+    await expect(gateway.recallProjectPlan({ projectId: 'project-1', projectRoot: root }))
+      .rejects.toMatchObject({ code: 'protocol' })
+  })
+
+  it('rejects an oversized current Working Plan before model injection', async () => {
+    const root = await mkdtemp(join(tmpdir(), 'dsh-memory-gateway-'))
+    roots.push(root)
+    const server = [
+      "process.stdin.setEncoding('utf8');",
+      `let b=''; process.stdin.on('data',c=>{b+=c; let i; while((i=b.indexOf('\\n'))>=0){const r=JSON.parse(b.slice(0,i)); b=b.slice(i+1); const v=r.method==='tools/call'?{content:[{type:'text',text:JSON.stringify({status:'current',plan:'x'.repeat(${MEMORY_PLAN_MAX_CHARS + 1})})}]}:{}; process.stdout.write(JSON.stringify({jsonrpc:'2.0',id:r.id,result:v})+'\\n');}});`,
+    ].join('')
+    const gateway = createDevFrameMcpMemoryGateway({
+      command: process.execPath,
+      args: ['-e', server],
+      timeoutMs: 5_000,
+    })
+    await expect(gateway.recallProjectPlan({ projectId: 'project-1', projectRoot: root }))
+      .rejects.toMatchObject({ code: 'protocol' })
+  })
+
+  it('uses a shell-free stdio process and returns only bounded statuses', async () => {
+    const root = await mkdtemp(join(tmpdir(), 'dsh-memory-gateway-'))
+    roots.push(root)
+    const server = [
+      "process.stdin.setEncoding('utf8');",
+      "let b=''; process.stdin.on('data',c=>{b+=c; let i; while((i=b.indexOf('\\n'))>=0){const r=JSON.parse(b.slice(0,i)); b=b.slice(i+1); let v={}; if(r.method==='tools/call'){v={content:[{type:'text',text:JSON.stringify(r.params.name==='recall_project_plan'?{status:'missing'}:{status:'captured',memoryId:'b'.repeat(64)})}]};} process.stdout.write(JSON.stringify({jsonrpc:'2.0',id:r.id,result:v})+'\\n');}});",
+    ].join('')
+    const gateway = createDevFrameMcpMemoryGateway({
+      command: process.execPath,
+      args: ['-e', server],
+      timeoutMs: 5_000,
+    })
+    await expect(gateway.recallProjectPlan({ projectId: 'project-1', projectRoot: root }))
+      .resolves.toEqual({ status: 'missing' })
+    await expect(gateway.captureProjectCheckpoint({
+      projectId: 'project-1', projectRoot: root, idempotencyKey: 'a'.repeat(64),
+      sessionId: 'devframe-controller:project-1', goal: 'bounded goal', outcome: 'completed',
+    })).resolves.toEqual({ status: 'captured', memoryId: 'b'.repeat(64) })
+  })
+
+  it('turns a missing executable into a bounded unavailable error', async () => {
+    const root = await mkdtemp(join(tmpdir(), 'dsh-memory-gateway-'))
+    roots.push(root)
+    const gateway = createDevFrameMcpMemoryGateway({
+      command: join(root, 'missing-memory-command.exe'),
+      timeoutMs: 1_000,
+    })
+    await expect(gateway.recallProjectPlan({ projectId: 'project-1', projectRoot: root }))
+      .rejects.toMatchObject({ code: 'unavailable' })
+  })
+
+  it('bounds a stalled memory process and returns an unavailable error', async () => {
+    const root = await mkdtemp(join(tmpdir(), 'dsh-memory-gateway-'))
+    roots.push(root)
+    const gateway = createDevFrameMcpMemoryGateway({
+      command: process.execPath,
+      args: ['-e', 'setTimeout(() => {}, 5_000)'],
+      timeoutMs: 50,
+    })
+
+    await expect(gateway.recallProjectPlan({ projectId: 'project-1', projectRoot: root }))
+      .rejects.toMatchObject({ code: 'unavailable' })
+  })
+})
