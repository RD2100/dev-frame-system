+++ b/packages/client/ui-devframe-control-session/src/client/task-board-store.ts
@@ -0,0 +1,93 @@
+import type { Context } from '@deepseek-ai/cordis'
+import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+import type {
+  DevFrameTaskBoardView,
+  DevFrameTrajectoryView,
+} from '@deepseek-ai/dsh-devframe-control-session/types'
+import { devframeRemoteFace } from './remote-face.ts'
+
+/**
+ * The fetched Task Board projection; `undefined` until the first successful
+ * refresh (design §11.3). Only references (taskId / messageId / payloadRef)
+ * cross the wire — never message bodies or transcripts (hard stop §11.8).
+ */
+export type TaskBoardSnapshot = DevFrameTaskBoardView | undefined
+
+/** One bounded, read-only trajectory projection selected from the Task Board. */
+export type TaskTrajectorySnapshot = {
+  readonly taskId: string
+  readonly view: DevFrameTrajectoryView
+} | undefined
+
+/**
+ * Owns the fetched Task Board projection for the Global Controller action.
+ *
+ * The client has no append capability and no local source of truth: the board
+ * only ever comes from the Host Remote `taskBoard` projection, which folds the
+ * Global Controller log server-side. A failed or absent remote keeps the
+ * previous view instead of fabricating a board (same honesty rule as
+ * `ProjectAuthorityStore`).
+ */
+export class TaskBoardStore {
+  readonly store: SnapshotStore<TaskBoardSnapshot> = createSnapshotStore(undefined)
+  readonly trajectoryStore: SnapshotStore<TaskTrajectorySnapshot> = createSnapshotStore(undefined)
+
+  private refreshing = false
+  private refreshingTrajectory = false
+
+  /**
+   * Fetch a fresh Task Board projection from the Host Remote face.
+   * @param ctx - browser context; the face is resolved through the non-strict
+   * `ctx.get` lookup (see `remote-face.ts`).
+   * @returns whether a fresh board was stored.
+   */
+  async refresh(ctx: Context): Promise<boolean> {
+    if (this.refreshing) return false
+    this.refreshing = true
+    try {
+      const face = devframeRemoteFace(ctx)
+      // Optional chaining: a runtime-stale face (bundle mounted before the
+      // taskBoard remote shipped) must fail closed, not throw.
+      if (face?.taskBoard === undefined) return false
+      const response = await face.taskBoard()
+      if (!response.ok) return false
+      const current = this.store.getSnapshot()
+      // Monotonic revision: consumers re-render only on change; a stale or
+      // equal snapshot never replaces a newer one.
+      if (current === undefined || response.value.revision > current.revision) {
+        this.store.set(response.value)
+      }
+      return true
+    } catch {
+      // A failed read keeps the previous view; the board stays honest instead
+      // of dropping to a fabricated state.
+      return false
+    } finally {
+      this.refreshing = false
+    }
+  }
+
+  /**
+   * Fetch the selected task's bounded native trajectory through the Host
+   * Remote. The client keeps only the latest selected projection and never
+   * folds or persists native Session events itself.
+   */
+  async refreshTrajectory(ctx: Context, taskId: string): Promise<boolean> {
+    if (this.refreshingTrajectory) return false
+    this.refreshingTrajectory = true
+    try {
+      const face = devframeRemoteFace(ctx)
+      if (face?.trajectory === undefined) return false
+      const response = await face.trajectory({ taskId, limit: 64 })
+      if (!response.ok) return false
+      this.trajectoryStore.set({ taskId, view: response.value })
+      return true
+    } catch {
+      // A failed read keeps the previous selection honest; the panel can be
+      // retried without fabricating an empty trajectory.
+      return false
+    } finally {
+      this.refreshingTrajectory = false
+    }
+  }
+}
