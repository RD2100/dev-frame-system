--- /dev/null
+++ b/packages/devframe/control-session/tests/policy.spec.ts
@@ -0,0 +1,476 @@
+/**
+ * Slice 1C-A tests: ContextPacket assembly/validation, PolicyDecision
+ * evaluation, the `policy/rule` fold, and the `run/frozen` asset-freeze fold.
+ * Pure functions only — no wiring, no session harness.
+ */
+
+import { describe, expect, it } from 'vitest'
+import {
+  POLICY_RULE_EVENT_TYPE,
+  RUN_FROZEN_EVENT_TYPE,
+  assertPolicyAllowed,
+  assembleContextPacket,
+  evaluatePolicy,
+  foldFrozenAssets,
+  foldPolicyRules,
+  parsePolicyDecisionPayload,
+  validateContextPacket,
+} from '../src/policy.ts'
+import type {
+  ContextPacketV1,
+  ContextRole,
+  ContextSourceV1,
+  FrozenAssetV1,
+  PolicyDecisionKind,
+  PolicyRuleMatchV1,
+  PolicyRuleV1,
+  RawSessionEvent,
+} from '../src/policy.ts'
+
+const NOW = 1_700_000_000_000
+const sha = (char: string): string => char.repeat(64)
+
+/** Rebase seq numbers onto array positions (folds require seq === index). */
+function withSeqs(events: RawSessionEvent[]): RawSessionEvent[] {
+  return events.map((event, index) => ({ ...event, seq: index }))
+}
+
+function ruleEvent(rule: PolicyRuleV1): RawSessionEvent {
+  return { type: POLICY_RULE_EVENT_TYPE, seq: 0, time: 0, data: rule }
+}
+
+function frozenEvent(frozen: FrozenAssetV1): RawSessionEvent {
+  return { type: RUN_FROZEN_EVENT_TYPE, seq: 0, time: 0, data: frozen }
+}
+
+function contextPacket(overrides: {
+  readonly role?: ContextRole
+  readonly sources?: readonly ContextSourceV1[]
+  readonly totalBytes?: number
+  readonly maxBytes?: number
+  readonly assembledAt?: number
+  readonly expiresAt?: number
+} = {}): ContextPacketV1 {
+  const sources = overrides.sources ?? [
+    { kind: 'prompt', ref: 'prompt/planner-v1', sha256: sha('a'), bytes: 100 },
+    { kind: 'skill', ref: 'skill/refactor', sha256: sha('b'), bytes: 250 },
+  ]
+  return {
+    schemaVersion: 1,
+    role: overrides.role ?? 'executor',
+    sources,
+    totalBytes: overrides.totalBytes ?? 350,
+    maxBytes: overrides.maxBytes ?? 1000,
+    assembledAt: overrides.assembledAt ?? NOW,
+    ...overrides.expiresAt === undefined ? {} : { expiresAt: overrides.expiresAt },
+  }
+}
+
+function rule(overrides: {
+  readonly id?: string
+  readonly kind?: PolicyDecisionKind
+  readonly match?: PolicyRuleMatchV1
+  readonly obligation?: string
+  readonly evidenceRef?: string
+  readonly expiresAt?: number
+} = {}): PolicyRuleV1 {
+  return {
+    schemaVersion: 1,
+    id: overrides.id ?? 'rule-1',
+    kind: overrides.kind ?? 'allow',
+    match: overrides.match ?? { action: 'edit' },
+    ...overrides.obligation === undefined ? {} : { obligation: overrides.obligation },
+    ...overrides.evidenceRef === undefined ? {} : { evidenceRef: overrides.evidenceRef },
+    ...overrides.expiresAt === undefined ? {} : { expiresAt: overrides.expiresAt },
+  }
+}
+
+function frozen(overrides: Partial<FrozenAssetV1> = {}): FrozenAssetV1 {
+  return {
+    schemaVersion: 1,
+    runId: 'run-1',
+    assets: [
+      { kind: 'prompt', ref: 'prompt/v1', sha256: sha('a'), attestedBy: 'profile-1' },
+    ],
+    ...overrides,
+  }
+}
+
+describe('Slice 1C-A ContextPacket assembly', () => {
+  it('assembles sources, sums bytes, and stamps the packet', () => {
+    const assembled = assembleContextPacket({
+      role: 'executor',
+      sources: [
+        { kind: 'prompt', ref: 'prompt/planner-v1', sha256: sha('a'), bytes: 100 },
+        { kind: 'skill', ref: 'skill/refactor', sha256: sha('b'), bytes: 250 },
+      ],
+      maxBytes: 1000,
+      now: NOW,
+    })
+    expect(assembled).toEqual({
+      schemaVersion: 1,
+      role: 'executor',
+      sources: [
+        { kind: 'prompt', ref: 'prompt/planner-v1', sha256: sha('a'), bytes: 100 },
+        { kind: 'skill', ref: 'skill/refactor', sha256: sha('b'), bytes: 250 },
+      ],
+      totalBytes: 350,
+      maxBytes: 1000,
+      assembledAt: NOW,
+    })
+    expect(assembled.expiresAt).toBeUndefined()
+    // A future expiry is stamped onto the packet.
+    const withExpiry = assembleContextPacket({
+      role: 'planner',
+      sources: [{ kind: 'prompt', ref: 'prompt/planner-v1', sha256: sha('a'), bytes: 10 }],
+      maxBytes: 100,
+      expiresAt: NOW + 60_000,
+      now: NOW,
+    })
+    expect(withExpiry.expiresAt).toBe(NOW + 60_000)
+  })
+
+  it('rejects an over-budget assembly with CONTEXT_OVER_BUDGET', () => {
+    expect(() => assembleContextPacket({
+      role: 'executor',
+      sources: [
+        { kind: 'prompt', ref: 'prompt/planner-v1', sha256: sha('a'), bytes: 600 },
+        { kind: 'skill', ref: 'skill/refactor', sha256: sha('b'), bytes: 500 },
+      ],
+      maxBytes: 1000,
+      now: NOW,
+    })).toThrow(expect.objectContaining({ code: 'CONTEXT_OVER_BUDGET' }))
+  })
+
+  it('rejects a past expiry with CONTEXT_EXPIRED', () => {
+    expect(() => assembleContextPacket({
+      role: 'executor',
+      sources: [{ kind: 'prompt', ref: 'prompt/planner-v1', sha256: sha('a'), bytes: 10 }],
+      maxBytes: 100,
+      expiresAt: NOW - 1_000,
+      now: NOW,
+    })).toThrow(expect.objectContaining({ code: 'CONTEXT_EXPIRED' }))
+  })
+
+  it('rejects missing sources with CONTEXT_MISSING', () => {
+    expect(() => assembleContextPacket({
+      role: 'executor',
+      sources: [],
+      maxBytes: 1000,
+      now: NOW,
+    })).toThrow(expect.objectContaining({ code: 'CONTEXT_MISSING' }))
+  })
+
+  it('rejects duplicate source refs with CONTEXT_CONFLICT', () => {
+    expect(() => assembleContextPacket({
+      role: 'executor',
+      sources: [
+        { kind: 'prompt', ref: 'prompt/planner-v1', sha256: sha('a'), bytes: 100 },
+        { kind: 'prompt', ref: 'prompt/planner-v1', sha256: sha('c'), bytes: 100 },
+      ],
+      maxBytes: 1000,
+      now: NOW,
+    })).toThrow(expect.objectContaining({ code: 'CONTEXT_CONFLICT' }))
+  })
+
+  it('rejects a malformed source entry with CONTEXT_INVALID', () => {
+    expect(() => assembleContextPacket({
+      role: 'executor',
+      sources: [{ kind: 'prompt', ref: 'prompt/planner-v1', bytes: 100 } as never],
+      maxBytes: 1000,
+      now: NOW,
+    })).toThrow(expect.objectContaining({ code: 'CONTEXT_INVALID' }))
+  })
+})
+
+describe('Slice 1C-A ContextPacket validation', () => {
+  it('accepts a well-formed packet and returns it', () => {
+    const packet = contextPacket()
+    expect(validateContextPacket(packet, NOW)).toEqual(packet)
+  })
+
+  it('rejects a forged payload as CONTEXT_INVALID', () => {
+    // Unknown extra key.
+    expect(() => validateContextPacket({ ...contextPacket(), forged: true }, NOW))
+      .toThrow(expect.objectContaining({ code: 'CONTEXT_INVALID' }))
+    // Missing required key.
+    const { role: _role, ...missingRole } = contextPacket()
+    expect(() => validateContextPacket(missingRole, NOW))
+      .toThrow(expect.objectContaining({ code: 'CONTEXT_INVALID' }))
+    // Role outside the six roles.
+    expect(() => validateContextPacket({ ...contextPacket(), role: 'nope' }, NOW))
+      .toThrow(expect.objectContaining({ code: 'CONTEXT_INVALID' }))
+    // Mistyped totalBytes.
+    expect(() => validateContextPacket({ ...contextPacket(), totalBytes: '350' }, NOW))
+      .toThrow(expect.objectContaining({ code: 'CONTEXT_INVALID' }))
+    // Tampered totalBytes that does not equal the source sum.
+    expect(() => validateContextPacket(contextPacket({ totalBytes: 500 }), NOW))
+      .toThrow(expect.objectContaining({ code: 'CONTEXT_INVALID' }))
+  })
+
+  it('rejects missing sources as CONTEXT_MISSING', () => {
+    const { sources: _sources, ...missingSources } = contextPacket()
+    expect(() => validateContextPacket(missingSources, NOW))
+      .toThrow(expect.objectContaining({ code: 'CONTEXT_MISSING' }))
+    expect(() => validateContextPacket(contextPacket({ sources: [] }), NOW))
+      .toThrow(expect.objectContaining({ code: 'CONTEXT_MISSING' }))
+  })
+
+  it('rejects duplicate source refs as CONTEXT_CONFLICT', () => {
+    expect(() => validateContextPacket(contextPacket({
+      sources: [
+        { kind: 'prompt', ref: 'prompt/planner-v1', sha256: sha('a'), bytes: 100 },
+        { kind: 'prompt', ref: 'prompt/planner-v1', sha256: sha('c'), bytes: 250 },
+      ],
+    }), NOW)).toThrow(expect.objectContaining({ code: 'CONTEXT_CONFLICT' }))
+  })
+
+  it('rejects an over-budget packet as CONTEXT_OVER_BUDGET', () => {
+    expect(() => validateContextPacket(contextPacket({ maxBytes: 300 }), NOW))
+      .toThrow(expect.objectContaining({ code: 'CONTEXT_OVER_BUDGET' }))
+  })
+
+  it('rejects a past-expiry packet as CONTEXT_EXPIRED', () => {
+    expect(() => validateContextPacket(contextPacket({ expiresAt: NOW - 1 }), NOW))
+      .toThrow(expect.objectContaining({ code: 'CONTEXT_EXPIRED' }))
+    // A future expiry validates fine.
+    expect(validateContextPacket(contextPacket({ expiresAt: NOW + 60_000 }), NOW).expiresAt)
+      .toBe(NOW + 60_000)
+  })
+})
+
+describe('Slice 1C-A PolicyDecision evaluation', () => {
+  const packet = contextPacket()
+
+  it('hits each of the five decision kinds', () => {
+    const kinds: readonly PolicyDecisionKind[] = [
+      'allow', 'draft_only', 'review_required', 'human_required', 'deny',
+    ]
+    for (const kind of kinds) {
+      const decision = evaluatePolicy([rule({ kind })], packet, 'edit', NOW)
+      expect(decision.kind).toBe(kind)
+      expect(decision.reason).toBe('rule')
+      expect(decision.rule?.id).toBe('rule-1')
+      expect(decision.packet).toBe(packet)
+    }
+  })
+
+  it('denies with no matching rule (fail-closed)', () => {
+    expect(evaluatePolicy([], packet, 'edit', NOW)).toEqual({
+      kind: 'deny',
+      reason: 'no matching rule',
+      packet,
+    })
+    // A rule whose constraints do not hold is "no match" too.
+    const otherAction = evaluatePolicy([rule({ match: { action: 'read' } })], packet, 'edit', NOW)
+    expect(otherAction.kind).toBe('deny')
+    expect(otherAction.reason).toBe('no matching rule')
+    const otherRole = evaluatePolicy(
+      [rule({ match: { contextKind: 'planner' } })],
+      packet,
+      'edit',
+      NOW,
+    )
+    expect(otherRole.kind).toBe('deny')
+  })
+
+  it('skips expired rules and falls through to the remaining rules', () => {
+    const live = rule({ id: 'live', kind: 'review_required', match: { action: 'edit' } })
+    const stale = rule({ id: 'stale', kind: 'deny', expiresAt: NOW - 1, match: { action: 'edit' } })
+    // Expired first, live second → the live rule wins.
+    expect(evaluatePolicy([stale, live], packet, 'edit', NOW).kind).toBe('review_required')
+    // Only an expired matching rule → default deny.
+    expect(evaluatePolicy([stale], packet, 'edit', NOW).kind).toBe('deny')
+  })
+
+  it('gates an expired-only rule set as POLICY_DENIED, never POLICY_EXPIRED', () => {
+    // 1C-A conclusion: an expired rule is SKIPPED, not refused — so an
+    // expired-only rule set falls through to the fail-closed default deny.
+    // The wiring gate therefore throws POLICY_DENIED; POLICY_EXPIRED belongs
+    // to a later decision-reference slice (a recorded decision whose expiresAt
+    // is past), not to rule expiry.
+    const stale = rule({ kind: 'allow', expiresAt: NOW - 1, match: { action: 'edit' } })
+    const decision = evaluatePolicy([stale], packet, 'edit', NOW)
+    expect(decision.kind).toBe('deny')
+    expect(decision.reason).toBe('no matching rule')
+    expect(() => { assertPolicyAllowed(decision) })
+      .toThrow(expect.objectContaining({ code: 'POLICY_DENIED' }))
+  })
+
+  it('evaluates the last-wins fold: two rules with the same id take the later one', () => {
+    const events = withSeqs([
+      ruleEvent(rule({ kind: 'deny', match: { action: 'edit' } })),
+      ruleEvent(rule({ kind: 'allow', match: { action: 'edit' } })),
+    ])
+    const folded = foldPolicyRules(events)
+    expect(folded).toHaveLength(1)
+    expect(folded[0]?.kind).toBe('allow')
+    expect(evaluatePolicy(folded, packet, 'edit', NOW).kind).toBe('allow')
+  })
+
+  it('matches on context kind through the packet role', () => {
+    const plannerPacket = contextPacket({ role: 'planner' })
+    const plannerRule = rule({ kind: 'allow', match: { contextKind: 'planner' } })
+    expect(evaluatePolicy([plannerRule], plannerPacket, 'edit', NOW).kind).toBe('allow')
+    expect(evaluatePolicy([plannerRule], packet, 'edit', NOW).kind).toBe('deny')
+  })
+
+  it('never lets a workspace-scoped rule match a workspace-less packet (fail-closed)', () => {
+    const scoped = rule({ kind: 'allow', match: { action: 'edit', workspaceId: 'ws-1' } })
+    expect(evaluatePolicy([scoped], packet, 'edit', NOW).kind).toBe('deny')
+  })
+
+  it('assertPolicyAllowed throws POLICY_DENIED before the first tool call for non-allow', () => {
+    const allowed = evaluatePolicy([rule({ kind: 'allow' })], packet, 'edit', NOW)
+    expect(() => { assertPolicyAllowed(allowed) }).not.toThrow()
+    const denied = evaluatePolicy([], packet, 'edit', NOW)
+    expect(() => { assertPolicyAllowed(denied) })
+      .toThrow(expect.objectContaining({ code: 'POLICY_DENIED' }))
+    const draft = evaluatePolicy([rule({ kind: 'draft_only' })], packet, 'edit', NOW)
+    expect(() => { assertPolicyAllowed(draft) })
+      .toThrow(expect.objectContaining({ code: 'POLICY_DENIED' }))
+  })
+})
+
+describe('Slice 1C-A policy rule fold', () => {
+  it('folds last-wins per id and keeps first-seen id order', () => {
+    const events = withSeqs([
+      ruleEvent(rule({ id: 'rule-a', kind: 'deny', match: { action: 'edit' } })),
+      ruleEvent(rule({ id: 'rule-b', kind: 'allow', match: { action: 'read' } })),
+      ruleEvent(rule({ id: 'rule-a', kind: 'review_required', match: { action: 'edit' } })),
+    ])
+    const folded = foldPolicyRules(events)
+    expect(folded.map(rule => rule.id)).toEqual(['rule-a', 'rule-b'])
+    expect(folded[0]).toMatchObject({ kind: 'review_required' })
+    expect(folded[1]).toMatchObject({ kind: 'allow' })
+  })
+
+  it('rejects a forged rule payload as POLICY_INVALID', () => {
+    const forged = ruleEvent({
+      schemaVersion: 1,
+      id: 'rule-1',
+      kind: 'allow',
+      match: { action: 'edit' },
+      forged: true,
+    } as never)
+    expect(() => foldPolicyRules(withSeqs([forged])))
+      .toThrow(expect.objectContaining({ code: 'POLICY_INVALID' }))
+  })
+
+  it('rejects a spliced log whose seq breaks contiguity as POLICY_INVALID', () => {
+    const events = [ruleEvent(rule()), ruleEvent(rule({ id: 'rule-2' }))]
+    events[1] = { ...events[1]!, seq: 5 }
+    expect(() => foldPolicyRules(events))
+      .toThrow(expect.objectContaining({ code: 'POLICY_INVALID' }))
+  })
+})
+
+describe('Slice 1C-A asset freeze fold', () => {
+  it('folds the last frozen snapshot per runId', () => {
+    const events = withSeqs([
+      frozenEvent(frozen({ assets: [
+        { kind: 'prompt', ref: 'prompt/v1', sha256: sha('a'), attestedBy: 'profile-1' },
+      ] })),
+      frozenEvent(frozen({ runId: 'run-2', assets: [
+        { kind: 'skill', ref: 'skill/v1', sha256: sha('b'), attestedBy: 'profile-1' },
+      ] })),
+      frozenEvent(frozen({ assets: [
+        { kind: 'prompt', ref: 'prompt/v2', sha256: sha('c'), attestedBy: 'profile-1' },
+      ] })),
+    ])
+    const folded = foldFrozenAssets(events, 'run-1')
+    expect(folded?.assets[0]).toMatchObject({ ref: 'prompt/v2', sha256: sha('c') })
+    // A run that never froze has no snapshot.
+    expect(foldFrozenAssets(events, 'run-3')).toBeUndefined()
+  })
+
+  it('rejects an un-attested asset as ASSET_UNATTESTED', () => {
+    const una = frozen({ assets: [
+      { kind: 'prompt', ref: 'prompt/v1', sha256: sha('a') },
+    ] })
+    expect(() => foldFrozenAssets(withSeqs([frozenEvent(una)]), 'run-1'))
+      .toThrow(expect.objectContaining({ code: 'ASSET_UNATTESTED' }))
+  })
+
+  it('rejects a forged frozen payload as ASSET_INVALID', () => {
+    // A non-sha256 content hash is corruption.
+    const badHash = frozen({ assets: [
+      { kind: 'prompt', ref: 'prompt/v1', sha256: 'not-a-sha', attestedBy: 'profile-1' },
+    ] })
+    expect(() => foldFrozenAssets(withSeqs([frozenEvent(badHash)]), 'run-1'))
+      .toThrow(expect.objectContaining({ code: 'ASSET_INVALID' }))
+    // An unknown extra key is forgery.
+    const forged = frozenEvent(frozen({ forged: true } as never))
+    expect(() => foldFrozenAssets(withSeqs([forged]), 'run-1'))
+      .toThrow(expect.objectContaining({ code: 'ASSET_INVALID' }))
+  })
+
+  it('mid-run asset changes never mutate the already-frozen snapshot', () => {
+    const first = frozen()
+    const events = withSeqs([ruleEvent(rule()), frozenEvent(first)])
+    const snapshot = foldFrozenAssets(events, 'run-1')
+    expect(snapshot?.assets[0]?.sha256).toBe(sha('a'))
+
+    // Mid-run changes arrive AFTER the freeze: a new rule and a new freeze.
+    const extended = withSeqs([
+      ...events,
+      ruleEvent(rule({ id: 'rule-2', match: { action: 'read' } })),
+      frozenEvent(frozen({ assets: [
+        { kind: 'prompt', ref: 'prompt/v2', sha256: sha('c'), attestedBy: 'profile-1' },
+      ] })),
+    ])
+    // The Run's frozen projection taken at freeze time is unchanged.
+    expect(snapshot?.assets[0]?.sha256).toBe(sha('a'))
+    expect(snapshot?.assets[0]?.ref).toBe('prompt/v1')
+    // Re-folding projects the NEW last snapshot; the old one is not mutated.
+    expect(foldFrozenAssets(extended, 'run-1')?.assets[0]?.sha256).toBe(sha('c'))
+    // The freeze fold is unaffected by the policy/rule events around it.
+    expect(foldPolicyRules(extended).map(rule => rule.id)).toEqual(['rule-1', 'rule-2'])
+  })
+})
+
+describe('Slice 1C-C policy/decision payload validation', () => {
+  const decision = (overrides: Record<string, unknown> = {}) => ({
+    schemaVersion: 1,
+    taskId: 'task-1',
+    decision: 'allow' as const,
+    reason: 'rule',
+    ruleId: 'rule-1',
+    packetDigest: sha('d'),
+    changedAt: NOW,
+    ...overrides,
+  })
+
+  it('accepts a well-formed decision record and returns it', () => {
+    expect(parsePolicyDecisionPayload(decision())).toMatchObject({
+      schemaVersion: 1,
+      taskId: 'task-1',
+      decision: 'allow',
+      reason: 'rule',
+      ruleId: 'rule-1',
+      packetDigest: sha('d'),
+      changedAt: NOW,
+    })
+  })
+
+  it('accepts the deny verdict shape too (the validator admits all five kinds)', () => {
+    expect(parsePolicyDecisionPayload(decision({ decision: 'deny' })).decision).toBe('deny')
+  })
+
+  it('rejects a forged payload as DECISION_INVALID', () => {
+    for (const forged of [
+      null,
+      'task-1',
+      decision({ forged: true } as never),
+      decision({ schemaVersion: 2 }),
+      decision({ taskId: '' }),
+      decision({ decision: 'execute' }),
+      decision({ changedAt: 'later' }),
+      decision({ reason: '' }),
+      decision({ ruleId: 7 }),
+    ]) {
+      expect(() => parsePolicyDecisionPayload(forged))
+        .toThrow(expect.objectContaining({ code: 'DECISION_INVALID' }))
+    }
+  })
+})
diff --git a/packages/devframe/control-session/tests/profile-fence-child.ts b/packages/devframe/control-session/tests/profile-fence-child.ts
new file mode 100644
