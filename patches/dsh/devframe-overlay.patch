+import type { Events } from '@deepseek-ai/cordis'
+import type { ConnectionHandle } from '@deepseek-ai/dsh-client-connection/client'
+import type {
+  ObservableSnapshot, SessionId, SessionListState, WorkspaceId,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import type { ClientContext } from '@deepseek-ai/dsh-client-runtime/client'
+// Type-only: activates the forwarded Host-event face for roster invalidation.
+import type {} from '@deepseek-ai/dsh-api-remotes/client'
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type {} from '@deepseek-ai/dsh-devframe-control-session/remote'
+import type {} from '@deepseek-ai/dsh-settings/types'
+import type { DevFrameProjectLoopTrace } from '@deepseek-ai/dsh-devframe-control-session/types'
+import { ProjectAuthorityStore } from './authority.ts'
+import { TaskBoardStore } from './task-board-store.ts'
+import { ControlIdentityView } from './ControlIdentityView.tsx'
+import { controllerIdentityDefinition } from './definition.ts'
+import { GlobalControllerAction } from './GlobalControllerAction.tsx'
+import { GlobalControllerHealth } from './health.ts'
+import { GlobalPresetSelector } from './GlobalPresetSelector.tsx'
+import { GlobalPresetController } from './global-preset-store.ts'
+import { GlobalPromptTarget } from './GlobalPromptTarget.tsx'
+import { GlobalPromptRouter } from './global-prompt-router.ts'
+import {
+  ExternalAgentPromptRouter,
+  composePromptRouters,
+  registerExternalAgentSource,
+} from './external-agent.ts'
+import { LoopPanel, ObjectivePanel } from './GlobalDispatchPanel.tsx'
+import { loopDefinition } from './loop-definition.ts'
+import { objectiveDefinition } from './objective-definition.ts'
+import { en, NS, zh } from './locales.ts'
+import { devframeRemoteFace } from './remote-face.ts'
+import { GlobalControllerReadiness } from './readiness.ts'
+
+const AGENT_PRESETS_NAMESPACE = 'agent-presets'
+
+type SettingsUpdatedRemote = {
+  $on(event: 'settings/document-updated', listener: Events['settings/document-updated']): () => void
+}
+
+type ConnectionEventService = {
+  on(event: 'connection/reset', listener: Events['connection/reset']): () => boolean
+}
+
+type SessionsService = {
+  list: ObservableSnapshot<SessionListState>
+  open(id: SessionId): void
+}
+
+/** Required browser services. */
+export const inject = [
+  'connection', 'slots', 'conversationEvents', 'locale', 'sessions', 'remote', 'inputTriggers',
+]
+
+/** Register the identity definition and its keyed renderer. @param ctx - browser context. */
+export function apply(ctx: ClientContext): void {
+  ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'ui-devframe-control-session: dictionaries')
+  ctx.conversationEvents.register(controllerIdentityDefinition)
+  ctx.conversationEvents.register(objectiveDefinition)
+  ctx.conversationEvents.register(loopDefinition)
+  const connection = ctx.get('connection') as ConnectionHandle
+  const sessions = ctx.get('sessions')
+  if (sessions === undefined) throw new Error('ui-devframe-control-session: sessions service unavailable')
+  const globalPromptRouter = new GlobalPromptRouter(ctx)
+  const externalPromptRouter = new ExternalAgentPromptRouter(connection.api, sessions)
+  ctx.provide('conversationPromptRouter', composePromptRouters(
+    externalPromptRouter,
+    globalPromptRouter,
+  ))
+  ctx.effect(
+    () => registerExternalAgentSource(ctx),
+    'ui-devframe-control-session: external-agent @ source',
+  )
+  const globalPresets = new GlobalPresetController(connection.api, async (agentPreset) => {
+    const response = await devframeRemoteFace(ctx)?.selectGlobalPreset({ agentPreset })
+    return response?.ok === true && response.value.agentPreset === agentPreset
+  })
+  ctx.effect(() => {
+    // The settings event covers external/default edits; reconnect covers a
+    // host whose preset files changed while this page was offline. Custom
+    // roster writes have no separate event, so the selector also refreshes on
+    // every open. Every disposer is owned by this fiber for HMR-safe remounts.
+    const refresh = (): void => { void globalPresets.load() }
+    const remote = ctx.get('remote') as unknown as SettingsUpdatedRemote
+    const events = ctx.events as unknown as ConnectionEventService
+    const onConnectionReset = (listener: () => void): (() => void) => {
+      return events.on('connection/reset', listener)
+    }
+    const disposers: Array<() => void> = [
+      remote.$on('settings/document-updated', (namespace) => {
+        if (namespace !== AGENT_PRESETS_NAMESPACE) return
+        refresh()
+      }),
+      onConnectionReset(() => { refresh() }),
+    ]
+    return () => { for (const dispose of disposers) dispose() }
+  }, 'ui-devframe-control-session: preset roster refresh')
+  const readiness = new GlobalControllerReadiness()
+  ctx.effect(() => {
+    readiness.start(ctx)
+    return () => { readiness.stop() }
+  }, 'ui-devframe-control-session: Host readiness')
+  ctx.slots.inject('conversation.chat.node', () => ctx.slots.register({
+    name: 'conversation.chat.node',
+    key: 'devframe-controller-identity',
+    locale: NS,
+    inject: () => ({
+      openFile: () => {},
+      inspectCall: () => {},
+      forkAt: () => {},
+      loadImage: () => Promise.resolve(''),
+      fileMentions: () => undefined,
+    }),
+  }, ControlIdentityView))
+  ctx.slots.inject('conversation.chat.node', () => ctx.slots.register({
+    name: 'conversation.chat.node',
+    key: 'devframe-objective',
+    locale: NS,
+    inject: () => ({
+      openFile: () => {},
+      inspectCall: () => {},
+      forkAt: () => {},
+      loadImage: () => Promise.resolve(''),
+      fileMentions: () => undefined,
+    }),
+  }, ObjectivePanel))
+  ctx.slots.inject('conversation.chat.node', () => ctx.slots.register({
+    name: 'conversation.chat.node',
+    key: 'devframe-loop',
+    locale: NS,
+    inject: () => ({
+      openFile: () => {},
+      inspectCall: () => {},
+      forkAt: () => {},
+      loadImage: () => Promise.resolve(''),
+      fileMentions: () => undefined,
+    }),
+  }, LoopPanel))
+  ctx.slots.inject('conversation.input.left', () => ctx.slots.register({
+    name: 'conversation.input.left',
+    id: 'devframe-global-prompt-target',
+    order: -20,
+    locale: NS,
+    inject: () => ({ router: globalPromptRouter }),
+  }, GlobalPromptTarget))
+  ctx.slots.inject('sidebar.footer.action', () => ctx.slots.register({
+    name: 'sidebar.footer.action',
+    id: 'devframe-global-controller',
+    order: -100,
+    locale: NS,
+    inject: () => {
+      const health = new GlobalControllerHealth()
+      const authority = new ProjectAuthorityStore()
+      const taskBoard = new TaskBoardStore()
+      const sessionsService = ctx.get('sessions') as unknown as SessionsService
+      const sessions = {
+        getSnapshot: () => sessionsService.list.getSnapshot(),
+        subscribe: (listener: () => void) => sessionsService.list.subscribe(listener),
+      }
+      return {
+        open: (sessionId: SessionId) => { sessionsService.open(sessionId) },
+        openProjectController: async (workspaceId: WorkspaceId) => {
+          const response = await devframeRemoteFace(ctx)?.openProject({ workspaceId })
+          if (response?.ok === true) {
+            sessionsService.open(response.value.id)
+          } else {
+            // A missing face (Remote not mounted) or a rejected open is a real
+            // failure the operator must see, not a silent no-op.
+            console.warn('devframe: openProjectController failed for workspace', workspaceId, response)
+          }
+        },
+        openMemory: async (workspaceId: WorkspaceId) => {
+          const response = await devframeRemoteFace(ctx)?.openMemory({ workspaceId })
+          if (response?.ok === true) return response.value
+          throw new Error('devframe: memory opener unavailable')
+        },
+        dispatchProjectLoop: async (
+          workspaceId: WorkspaceId,
+          projectRoot: string,
+          objective: string,
+          requestIdempotencyKey?: string,
+        ): Promise<DevFrameProjectLoopTrace> => {
+          const response = await devframeRemoteFace(ctx)?.dispatchProjectLoop({
+            projectId: workspaceId,
+            projectRoot,
+            objective,
+            maxGoalRounds: 1,
+            ...requestIdempotencyKey === undefined ? {} : { requestIdempotencyKey },
+          })
+          if (response?.ok === true) return response.value
+          throw new Error('devframe: project loop unavailable')
+        },
+        hooks: {
+          sessions,
+          readiness: readiness.store,
+          health: health.store,
+          projectAuthority: authority.store,
+          taskBoard: taskBoard.store,
+          taskTrajectory: taskBoard.trajectoryStore,
+        },
+        refreshHealth: () => { void health.refresh(ctx) },
+        refreshProjectAuthority: (workspaceIds: readonly WorkspaceId[]) => {
+          void authority.refresh(ctx, workspaceIds)
+        },
+        refreshTaskBoard: () => { void taskBoard.refresh(ctx) },
+        refreshTaskTrajectory: (taskId: string) => {
+          void taskBoard.refreshTrajectory(ctx, taskId)
+        },
+        bindProjectAuthority: (workspaceId: WorkspaceId) => {
+          return authority.bind(ctx, workspaceId).then(() => undefined)
+        },
+      }
+    },
+  }, GlobalControllerAction))
+  ctx.slots.inject('conversation.session.header.actions', () => ctx.slots.register({
+    name: 'conversation.session.header.actions',
+    id: 'devframe-global-preset',
+    order: -5,
+    locale: NS,
+    inject: () => ({
+      hooks: { globalPresets: globalPresets.store },
+      load: () => globalPresets.load(),
+      select: (id: string) => globalPresets.select(id),
+    }),
+  }, GlobalPresetSelector))
+}
