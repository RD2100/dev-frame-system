+
+function hashRequestIdempotencyKey(value: string | undefined): string | undefined {
+  if (value === undefined) return undefined
+  const normalized = value.trim()
+  requireIdPart(normalized)
+  return createHash('sha256').update(normalized).digest('hex')
+}
+
+function containsPath(parent: string, child: string): boolean {
+  const segment = relative(parent, child)
+  return segment === ''
+    || (segment !== '..' && !segment.startsWith(`..${sep}`) && !isAbsolute(segment))
+}
+
+/** Resolve the gateway-owned Vault-relative note into a Host-only Obsidian URI. */
+function memoryNoteUri(relativePath: string | undefined): string | undefined {
+  const vaultRoot = process.env.DEVFRAME_OBSIDIAN_MEMORY_ROOT?.trim()
+  if (vaultRoot === undefined || vaultRoot.length === 0 || !isAbsolute(vaultRoot)
+    || !isSafeMemoryRelativePath(relativePath)) return undefined
+  const root = resolve(vaultRoot)
+  const note = resolve(join(root, relativePath))
+  if (note === root || !containsPath(root, note)) return undefined
+  return `obsidian://open?path=${encodeURIComponent(note)}`
+}
