+import { existsSync } from 'node:fs'
+import { readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import type { Browser, Page } from 'playwright'
+import { chromium } from 'playwright'
+import { afterEach, describe, expect, it, onTestFailed } from 'vitest'
+import { CODEX_SUBSCRIPTION_PROVIDER } from '@deepseek-ai/dsh-agent-runtime-codex'
+import { codexAppServerArgv } from '../../../packages/core/agent-runtime-codex/src/wire.ts'
+import type { SessionEvent, SessionId } from '@deepseek-ai/dsh-session'
+import type { SubprocessHandle, SubprocessSpawnSpec } from '@deepseek-ai/dsh-subprocess'
+import SubprocessRuntime from '@deepseek-ai/dsh-subprocess-local'
+import {
+  launchWebScaffold,
+  webSnapshotMode,
+  watchConsole,
+  type WebScaffold,
+} from './scaffold.ts'
+import { connectFreshWorkspace, newEnglishPage, saveFailureShot } from './support.ts'
+
+const DEVFRAME_PATCH_PATH = fileURLToPath(
+  new URL('../../../packages/bundle/devframe/cordis.patch.yml', import.meta.url),
+)
+const MODE = webSnapshotMode()
+const PROMPT = 'Hold the Codex subscription turn open until I stop it.'
+const ACTIVE_DELTA = 'Luna取消前流式片段'
+const READY_MARKER = '.codex-active-turn-ready'
+const INTERRUPT_MARKER = '.codex-active-turn-interrupted'
+const DESCENDANT_MARKER = '.codex-active-turn-descendant.pid'
+
+let expectedWorkspaceCwd: string | undefined
+let expectedCodexHome: string | undefined
+let observedSpawnCount = 0
+let activeChild: SubprocessHandle | undefined
+let activeDescendantPid: number | undefined
+
+/** Keep the production Codex spawn contract fixed while replacing only argv. */
+class ActiveTurnSubprocessRuntime extends SubprocessRuntime {
+  override spawn(spec: SubprocessSpawnSpec): SubprocessHandle {
+    observedSpawnCount += 1
+    expect(spec.argv).toEqual(codexAppServerArgv())
+    expect(spec.cwd).toBe(expectedWorkspaceCwd)
+    expect(spec.stdio.stdin).toBe('pipe')
+    expect(spec.stdio.stdout).toBe('pipe')
+    const { stderr } = spec.stdio
+    if (typeof stderr !== 'object' || stderr === null) {
+      throw new Error('Codex spawn stderr must use bounded collection mode')
+    }
+    expect(typeof stderr.maxBytes).toBe('number')
+    expect(spec.env?.CODEX_HOME).toBe(expectedCodexHome)
+    for (const name of [
+      'OPENAI_API_KEY', 'OPENAI_API_TOKEN', 'OPENAI_ACCESS_TOKEN', 'OPENAI_AUTH_TOKEN',
+      'CODEX_API_KEY', 'CODEX_API_TOKEN', 'CODEX_ACCESS_TOKEN', 'CODEX_AUTH_TOKEN',
+      'CODEX_SESSION_TOKEN', 'CHATGPT_API_KEY', 'CHATGPT_ACCESS_TOKEN', 'DEEPSEEK_API_KEY',
+      'ANTHROPIC_API_KEY', 'GITHUB_TOKEN', 'AWS_SECRET_ACCESS_KEY', 'AZURE_OPENAI_API_KEY',
+      'OPENAI_BASE_URL', 'OPENAI_API_BASE', 'CODEX_BASE_URL', 'CODEX_OSS_BASE_URL',
+      'CODEX_OSS_PORT', 'OPENAI_ORGANIZATION', 'OPENAI_PROJECT', 'AZURE_OPENAI_ENDPOINT',
+      'NODE_OPTIONS', 'NODE_PATH',
+    ]) {
+      expect(spec.env?.[name]).toBeUndefined()
+    }
+    activeChild = super.spawn({
+      ...spec,
+      argv: [
+        process.execPath,
+        fileURLToPath(new URL('./fixtures/fake-codex-subscription-app-server.mjs', import.meta.url)),
+      ],
+      env: {
+        ...spec.env,
+        DSH_TEST_FIXTURE_ACTIVE_TURN: '1',
+        DSH_TEST_FIXTURE_TURN_READY_MARKER: join(spec.cwd, READY_MARKER),
+        DSH_TEST_FIXTURE_INTERRUPT_MARKER: join(spec.cwd, INTERRUPT_MARKER),
+        DSH_TEST_DESCENDANT_MARKER: join(spec.cwd, DESCENDANT_MARKER),
+      },
+    })
+    return activeChild
+  }
+}
+
+interface ObservedSessionEvent {
+  readonly sessionId: SessionId
+  readonly event: SessionEvent
+}
+
+function isProcessAlive(pid: number): boolean {
+  try {
+    process.kill(pid, 0)
+    return true
+  } catch {
+    return false
+  }
+}
+
+async function waitForProcessExit(pid: number, timeoutMs = 10_000): Promise<void> {
+  const deadline = Date.now() + timeoutMs
+  while (isProcessAlive(pid)) {
+    if (Date.now() >= deadline) throw new Error(`fixture descendant ${String(pid)} remained alive`)
+    await new Promise<void>(resolve => setTimeout(resolve, 50))
+  }
+}
+
+async function selectFixtureModel(page: Page): Promise<void> {
+  const modelTrigger = page.getByRole('button', { name: /^Select model, current / })
+  await modelTrigger.waitFor({ timeout: 15_000 })
+  await modelTrigger.click()
+  const modelMenu = page.locator('[role="menu"]').last()
+  await modelMenu.waitFor({ timeout: 10_000 })
+  await modelMenu.getByRole('menuitem', { name: /^Model DeepSeek-V4-Flash/ }).click()
+  const codexGroup = modelMenu.getByRole('group', {
+    name: /^(GPT subscription \(Codex\)|GPT 订阅（Codex）)$/,
+  })
+  await codexGroup.waitFor({ timeout: 15_000 })
+  await codexGroup.getByRole('menuitemradio', { name: 'Fixture Model', exact: true }).click()
+  await expect.poll(() => modelTrigger.getAttribute('aria-label'), { timeout: 15_000 })
+    .toContain('Fixture Model')
+}
+
+describe.skipIf(MODE === 'record')('web e2e: Codex active-turn cancellation', () => {
+  let scaffold: WebScaffold | undefined
+  let browser: Browser | undefined
+  let page: Page | undefined
+  let bootstrap: {
+    open(profileId: string): Promise<void>
+    stop(): Promise<void>
+  } | undefined
+  let tripwire: ReturnType<typeof watchConsole> | undefined
+  const sessionEvents: ObservedSessionEvent[] = []
+  const consoleErrors: string[] = []
+
+  afterEach(async () => {
+    const failures: unknown[] = []
+    const marker = expectedWorkspaceCwd === undefined
+      ? undefined
+      : join(expectedWorkspaceCwd, DESCENDANT_MARKER)
+    if (activeDescendantPid === undefined && marker !== undefined && existsSync(marker)) {
+      activeDescendantPid = Number(await readFile(marker, 'utf8').catch(() => '0'))
+    }
+    await browser?.close().catch((error: unknown) => failures.push(error))
+    browser = undefined
+    await bootstrap?.stop().catch((error: unknown) => failures.push(error))
+    bootstrap = undefined
+    const closing = scaffold
+    scaffold = undefined
+    await closing?.close().catch((error: unknown) => failures.push(error))
+    const child = activeChild
+    activeChild = undefined
+    if (child !== undefined) {
+      child.terminate()
+      await child.waitForExit(AbortSignal.timeout(10_000)).then((exited) => {
+        if (!exited) failures.push(new Error('Codex fixture process tree did not exit'))
+      }).catch((error: unknown) => failures.push(error))
+      await child.done.catch((error: unknown) => failures.push(error))
+    }
+    if (activeDescendantPid !== undefined && activeDescendantPid > 0) {
+      await waitForProcessExit(activeDescendantPid).catch((error: unknown) => failures.push(error))
+    }
+    expectedWorkspaceCwd = undefined
+    expectedCodexHome = undefined
+    activeDescendantPid = undefined
+    observedSpawnCount = 0
+    if (failures.length === 1) throw failures[0]
+    if (failures.length > 1) throw new AggregateError(failures, 'Codex active-turn teardown failed')
+  })
+
+  it('interrupts a live turn and joins the Codex process tree', async () => {
+    onTestFailed(() => {
+      if (page !== undefined) void saveFailureShot(page, 'web-e2e-codex-active-cancel')
+    })
+    scaffold = await launchWebScaffold({
+      extraOverlayPath: DEVFRAME_PATCH_PATH,
+      testSubprocessRuntime: ActiveTurnSubprocessRuntime,
+    })
+    expectedWorkspaceCwd = join(scaffold.workspaceCwd, 'workspace')
+    expectedCodexHome = join(
+      scaffold.harnessHome,
+      'profiles',
+      'scaffold',
+      '.dsh-codex-subscription',
+    )
+    sessionEvents.length = 0
+    consoleErrors.length = 0
+    scaffold.ctx.provide('profileIdentity', { id: 'codex-active-cancel-e2e', name: 'devframe' })
+    const controlSessions = scaffold.ctx.get('devframeControlSessions') as {
+      beginGlobalBootstrap(): {
+        open(profileId: string): Promise<void>
+        stop(): Promise<void>
+      }
+    } | undefined
+    if (controlSessions === undefined) {
+      throw new Error('DevFrame profile overlay did not mount devframeControlSessions')
+    }
+    bootstrap = controlSessions.beginGlobalBootstrap()
+    await bootstrap.open('codex-active-cancel-e2e')
+    scaffold.ctx.on('session/event', (session, event) => {
+      sessionEvents.push({ sessionId: session.id, event })
+    })
+
+    browser = await chromium.launch()
+    const activePage = await newEnglishPage(browser)
+    page = activePage
+    tripwire = watchConsole(activePage)
+    activePage.on('console', (message) => {
+      if (message.type() === 'error') consoleErrors.push(message.text())
+    })
+    await activePage.goto(scaffold.baseUrl, { waitUntil: 'load' })
+    await activePage.getByRole('button', { name: 'Global Controller', exact: true })
+      .waitFor({ timeout: 30_000 })
+    await connectFreshWorkspace(activePage, scaffold.workspaceCwd)
+    await selectFixtureModel(activePage)
+
+    const readyMarker = join(expectedWorkspaceCwd, READY_MARKER)
+    const interruptMarker = join(expectedWorkspaceCwd, INTERRUPT_MARKER)
+    const descendantMarker = join(expectedWorkspaceCwd, DESCENDANT_MARKER)
+    const settled = scaffold.whenTurnSettled(30_000)
+    const composer = activePage.locator('textarea:enabled[placeholder="Describe what you want to build"]')
+    await composer.fill(PROMPT)
+    await composer.press('Enter')
+
+    await expect.poll(() => existsSync(readyMarker), { timeout: 15_000 }).toBe(true)
+    await activePage.getByRole('button', { name: 'Stop generating', exact: true })
+      .waitFor({ timeout: 15_000 })
+    await expect.poll(
+      async () => (await activePage.locator('body').innerText()).includes(ACTIVE_DELTA),
+      { timeout: 15_000, message: 'the active Codex delta did not render before cancellation' },
+    ).toBe(true)
+    expect(await activePage.locator('[data-streaming="true"]').count()).toBeGreaterThan(0)
+
+    await activePage.getByRole('button', { name: 'Stop generating', exact: true }).click()
+    await expect.poll(() => existsSync(interruptMarker), { timeout: 15_000 }).toBe(true)
+    const sessionId = await settled
+
+    const matchingEvents = sessionEvents
+      .filter(record => record.sessionId === sessionId)
+      .map(record => record.event)
+    const turnEnds = matchingEvents.filter((event): event is SessionEvent<'turn/end'> => (
+      event.type === 'turn/end'
+    ))
+    expect(turnEnds).toHaveLength(1)
+    expect(turnEnds[0]?.data.reason.kind).toBe('aborted')
+    const threadBindings = matchingEvents.filter((event): event is SessionEvent<'codex/thread-bound'> => (
+      event.type === 'codex/thread-bound'
+    ))
+    expect(threadBindings).toHaveLength(1)
+    expect(threadBindings[0]?.data).toMatchObject({
+      threadId: 'fixture-thread',
+      provider: CODEX_SUBSCRIPTION_PROVIDER,
+      model: 'fixture-model',
+      protocol: 'v2',
+    })
+    const turnBindings = matchingEvents.filter((event): event is SessionEvent<'codex/turn-bound'> => (
+      event.type === 'codex/turn-bound'
+    ))
+    expect(turnBindings.map(event => event.data)).toEqual([
+      { turn: 1, step: 1, turnId: 'fixture-turn-1', status: 'started' },
+      { turn: 1, step: 1, turnId: 'fixture-turn-1', status: 'interrupted' },
+    ])
+    const persisted = await scaffold.ctx.sessionPersistence.load(sessionId)
+    expect(persisted.events.filter(event => event.type === 'turn/end').map(event => event.data.reason.kind))
+      .toEqual(['aborted'])
+    // Capability probes and the active turn may each own a Codex process;
+    // the active-turn path is proven by its marker/turn events below.
+    expect(observedSpawnCount).toBeGreaterThanOrEqual(1)
+    expect(activeChild).toBeDefined()
+    const descendantPid = Number(await readFile(descendantMarker, 'utf8'))
+    expect(descendantPid).toBeGreaterThan(0)
+    activeDescendantPid = descendantPid
+
+    await expect.poll(() => activePage.locator('[data-streaming="true"]').count(), { timeout: 15_000 }).toBe(0)
+    const bodyText = await activePage.locator('body').innerText()
+    expect(bodyText).not.toMatch(/raw provider error|connection lost|gap repair|discontinuous/i)
+    expect(await activePage.locator('vite-error-overlay').count()).toBe(0)
+    expect(consoleErrors).toEqual([])
+    expect(tripwire?.pageErrors).toEqual([])
+    expect(tripwire?.warnings).toEqual([])
+  }, 120_000)
+})
