+/** Project one official model/list response with hard bounds and no raw fields. */
+export function projectModels(response: unknown): readonly CodexModelDescriptor[] {
+  const value = asObject(response, 'model/list response')
+  const data = value.data
+  if (!Array.isArray(data)) throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex model catalog was invalid')
+  const models: CodexModelDescriptor[] = []
+  const seen = new Set<string>()
+  for (const entry of data) {
+    if (models.length >= MAX_MODELS) break
+    if (entry === null || typeof entry !== 'object' || Array.isArray(entry)) continue
+    const item = entry as JsonObject
+    const model = typeof item.model === 'string'
+      && /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/.test(item.model)
+      ? item.model
+      : undefined
+    const displayName = typeof item.displayName === 'string' && item.displayName.length > 0 && item.displayName.length <= MAX_STRING_LENGTH
+      ? item.displayName
+      : undefined
+    if (model === undefined || displayName === undefined || item.hidden !== false || seen.has(model)) continue
+    const rawEfforts = item.supportedReasoningEfforts
+    if (!Array.isArray(rawEfforts)) continue
+    const efforts: string[] = []
+    for (const effort of rawEfforts) {
+      const effortName = typeof effort === 'string'
+        ? effort
+        : effort !== null && typeof effort === 'object' && !Array.isArray(effort)
+          ? (effort as JsonObject).reasoningEffort
+          : undefined
+      if (typeof effortName !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$/.test(effortName)) continue
+      if (!efforts.includes(effortName)) efforts.push(effortName)
+      if (efforts.length >= MAX_REASONING_EFFORTS) break
+    }
+    const rawDefaultEffort = item.defaultReasoningEffort
+    const defaultReasoningEffort = typeof rawDefaultEffort === 'string'
+      && /^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$/.test(rawDefaultEffort)
+      && efforts.includes(rawDefaultEffort)
+      ? rawDefaultEffort
+      : undefined
+    seen.add(model)
+    models.push({
+      id: model,
+      displayName,
+      hidden: false,
+      reasoning: efforts.length > 0,
+      supportedReasoningEfforts: Object.freeze(efforts),
+      ...defaultReasoningEffort === undefined ? {} : { defaultReasoningEffort },
+      isDefault: item.isDefault === true,
+    })
+  }
+  return Object.freeze(models)
+}
