+  private observeFinalAnswer(state: TurnState, item: TurnItem): void {
+    if (item.phase !== 'final_answer') return
+    if (state.finalAnswerItemId !== undefined && state.finalAnswerItemId !== item.id) {
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex returned multiple final answers')
+    }
+    state.finalAnswerItemId = item.id
+  }
+
+  private emitFinalDelta(state: TurnState, item: TurnItem, text: string): void {
+    if (text.length === 0) return
