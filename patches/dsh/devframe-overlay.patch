+  get currentThreadId(): string | undefined { return this.threadId }
+
+  /** Current verified turn identity for the provider-owned durable binding. */
+  get currentTurnId(): string | undefined { return this.state?.turnId }
+
+  private fail(error: Error): void {
+    const sanitized = sanitizedProtocolError(error)
+    this.fatal.reject(sanitized)
