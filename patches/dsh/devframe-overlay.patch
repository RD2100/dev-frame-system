+function requireIdPart(value: string): string {
+  if (typeof value !== 'string' || !ID_PART_PATTERN.test(value)) {
+    throw new ControlSessionError('INVALID_ID')
+  }
+  return value
+}
+
+function revisionSemanticMessageId(taskId: string): string {
+  return requireIdPart(`${REVISION_SEMANTIC_PREFIX}${taskId}`)
+}
+
+function routedObjectiveText(events: readonly SessionEvent[], objectiveId: string | undefined): string | undefined {
+  if (objectiveId === undefined) return undefined
+  const folded = foldObjective(events, objectiveId)
+  return folded.status === 'routed' ? folded.text : undefined
