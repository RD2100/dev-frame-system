@@ -0,0 +1,137 @@
+import { describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import { SubagentError } from '@deepseek-ai/dsh-subagent'
+import { RpcId } from '../src/api/rpc.ts'
+import type { RpcRequest } from '../src/api/rpc.ts'
+import { createApiProxy } from '../src/api-proxy.ts'
+
+const sid = (value: string): SessionId => value as SessionId
+const parentId = sid('parent')
+
+function request<P>(payload: P): RpcRequest<P> {
+  return { rpcId: RpcId('external-agent-rpc'), payload }
+}
+
+function bench(options: { parentLive?: boolean } = {}) {
+  const parent = { id: parentId }
+  const getAgent = vi.fn((id: SessionId) => options.parentLive === false || id !== parentId ? undefined : parent)
+  const startContinuable = vi.fn(() => Promise.resolve({
+    childId: sid('external-child'),
+    messageId: 'external-message',
+  }))
+  const getProvider = vi.fn((name: string) => name === 'codex'
+    ? {
+      name,
+      externalAgentRuntime: true as const,
+      prepareContinuable: () => Promise.resolve({}),
+    }
+    : undefined)
+  const ctx = new Context()
+  ctx.provide('agents', { get: getAgent })
+  ctx.provide('subagents', { startContinuable, getProvider })
+  ctx.provide('userQuestions', { registerProvider: () => () => {} })
+  const api = createApiProxy(ctx, {
+    defaultModelSelection: () => ({ provider: 'p', model: 'm' }),
+    cwd: '/tmp',
+    externalAgentProviders: { codex: 'codex' },
+  })
+  return { api, parent, getAgent, startContinuable, getProvider }
+}
+
+describe('external-agent.start gateway', () => {
+  it('starts an allowlisted external child and makes retries idempotent', async () => {
+    const { api, parent, startContinuable } = bench()
+    const payload = {
+      sessionId: parentId,
+      providerId: 'codex',
+      prompt: 'inspect the failing stream',
+      correlationId: 'attempt-1',
+    }
+    const signal = new AbortController().signal
+    const first = await api.externalAgents.start(request(payload), signal)
+    const second = await api.externalAgents.start(request(payload), signal)
+    expect(first.result).toEqual({ ok: true, value: {
+      parentSessionId: parentId,
+      childSessionId: 'external-child',
+      messageId: 'external-message',
+      providerId: 'codex',
+      correlationId: 'attempt-1',
+    } })
+    expect(second.result).toEqual(first.result)
+    expect(startContinuable).toHaveBeenCalledOnce()
+    expect(startContinuable).toHaveBeenCalledWith(expect.objectContaining({
+      provider: 'codex',
+      label: '@codex',
+      request: expect.objectContaining({
+        parent,
+        prompt: [{ type: 'text', text: payload.prompt }],
+        agentOptions: { provider: 'codex', model: 'codex' },
+      }),
+      signal,
+    }))
+  })
+
+  it('refuses an unknown or non-external provider before child creation', async () => {
+    const { api, startContinuable, getProvider } = bench()
+    const unknown = await api.externalAgents.start(request({
+      sessionId: parentId, providerId: 'shell', prompt: 'run', correlationId: 'unknown',
+    }), new AbortController().signal)
+    expect(unknown.result).toMatchObject({ ok: false, error: {
+      code: 'external-agent-provider-unavailable', details: { providerId: 'shell' },
+    } })
+    expect(startContinuable).not.toHaveBeenCalled()
+
+    getProvider.mockReturnValueOnce({ name: 'codex' } as never)
+    const nonExternal = await api.externalAgents.start(request({
+      sessionId: parentId, providerId: 'codex', prompt: 'run', correlationId: 'non-external',
+    }), new AbortController().signal)
+    expect(nonExternal.result).toMatchObject({ ok: false, error: {
+      code: 'external-agent-provider-unavailable', details: { providerId: 'codex' },
+    } })
+    expect(startContinuable).not.toHaveBeenCalled()
+  })
+
+  it('rejects a reused correlation id whose request changed', async () => {
+    const { api, startContinuable } = bench()
+    const signal = new AbortController().signal
+    await api.externalAgents.start(request({
+      sessionId: parentId, providerId: 'codex', prompt: 'first', correlationId: 'same',
+    }), signal)
+    const response = await api.externalAgents.start(request({
+      sessionId: parentId, providerId: 'codex', prompt: 'tampered', correlationId: 'same',
+    }), signal)
+    expect(response.result).toMatchObject({ ok: false, error: {
+      code: 'external-agent-correlation-conflict', details: { correlationId: 'same' },
+    } })
+    expect(startContinuable).toHaveBeenCalledOnce()
+  })
+
+  it('maps missing parents, cancellation, and provider admission failures safely', async () => {
+    const absent = bench({ parentLive: false })
+    const absentResponse = await absent.api.externalAgents.start(request({
+      sessionId: parentId, providerId: 'codex', prompt: 'run', correlationId: 'absent',
+    }), new AbortController().signal)
+    expect(absentResponse.result).toMatchObject({ ok: false, error: {
+      code: 'subagent-parent-unavailable', details: { parentSessionId: parentId },
+    } })
+
+    const cancelled = bench()
+    const controller = new AbortController()
+    controller.abort()
+    const cancelledResponse = await cancelled.api.externalAgents.start(request({
+      sessionId: parentId, providerId: 'codex', prompt: 'run', correlationId: 'cancelled',
+    }), controller.signal)
+    expect(cancelledResponse.result).toMatchObject({ ok: false, error: { code: 'cancelled' } })
+
+    const rejected = bench()
+    rejected.startContinuable.mockRejectedValueOnce(new SubagentError('secret failure', 'DRAINING'))
+    const rejectedResponse = await rejected.api.externalAgents.start(request({
+      sessionId: parentId, providerId: 'codex', prompt: 'run', correlationId: 'rejected',
+    }), new AbortController().signal)
+    expect(rejectedResponse.result).toMatchObject({ ok: false, error: {
+      code: 'external-agent-start-rejected', details: { providerId: 'codex' },
+    } })
+  })
+})
+
