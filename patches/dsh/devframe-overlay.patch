+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex returned too many reasoning summaries')
+    }
+    const summary: ReasoningSummaryState = {
+      id,
+      blockIndex: state.nextReasoningBlockIndex,
