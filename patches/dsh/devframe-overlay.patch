+   * the capability whitelist), creates the Worker session only after the guard
+   * passes, and only then promotes the reservation to `ready` and flushes
+   * again. The returned view is pathless; the Global tool surface stays empty,
+   * so registration never touches project files.
+   * @param options - profile identity, Worker id, role key, capabilities, and cancellation.
+   * @returns the folded ready Worker view once durable.
+   */
+  async registerWorker(options: RegisterWorkerOptions): Promise<RosterView> {
+    const workerId = requireIdPart(options.workerId)
+    const roleAssignment = requireIdPart(options.roleAssignment)
+    if (!Array.isArray(options.capabilities)
+      || options.capabilities.some(capability => typeof capability !== 'string' || capability.length === 0)) {
+      throw new ControlSessionError('ROSTER_INVALID')
+    }
+    if (options.workspaceScope !== undefined
+      && (typeof options.workspaceScope !== 'string' || options.workspaceScope.length === 0)) {
+      throw new ControlSessionError('ROSTER_INVALID')
+    }
+    if (options.capabilities.includes(TASK_PAYLOAD_EXECUTE)) {
+      if (roleAssignment !== 'executor' || options.workspaceScope === undefined) {
+        throw new ControlSessionError('ROSTER_INVALID')
+      }
+      const workspace = this.hostCtx.workspaceRegistry.get(WorkspaceId(options.workspaceScope))
+      if (workspace === undefined) throw new ControlSessionError('UNKNOWN_WORKSPACE')
+      try {
+        if (await workspace.status() !== 'ok') throw new ControlSessionError('WORKSPACE_UNAVAILABLE')
+      } catch (failure) {
+        throw controlSessionFailure(failure, 'WORKSPACE_UNAVAILABLE')
+      }
+    }
+    if (options.capabilities.includes(TASK_PAYLOAD_REVIEW)) {
+      if (roleAssignment !== 'reviewer' || options.workspaceScope === undefined) {
+        throw new ControlSessionError('ROSTER_INVALID')
+      }
+      const workspace = this.hostCtx.workspaceRegistry.get(WorkspaceId(options.workspaceScope))
+      if (workspace === undefined) throw new ControlSessionError('UNKNOWN_WORKSPACE')
+      try {
+        if (await workspace.status() !== 'ok') throw new ControlSessionError('WORKSPACE_UNAVAILABLE')
+      } catch (failure) {
+        throw controlSessionFailure(failure, 'WORKSPACE_UNAVAILABLE')
+      }
+    }
+    const controller = await this.openGlobal({
+      profileId: options.profileId,
+      ...options.signal === undefined ? {} : { signal: options.signal },
+    })
+    return await this.roster.register({
+      session: controller.agent.session,
+      workerId,
+      roleAssignment,
+      profileId: options.profileId,
+      capabilities: options.capabilities.slice(),
+      ...options.workspaceScope === undefined ? {} : { workspaceScope: options.workspaceScope },
+      ...options.signal === undefined ? {} : { signal: options.signal },
+      flush: session => this.hostCtx.sessions.flush(session),
+      createWorker: (_workerId, signal, worker) => {
+        if (worker === undefined) throw new ControlSessionError('ROSTER_INVALID')
+        return this.openWorker(worker, signal)
+      },
+    })
+  }
+
+  /**
+   * Fold the pathless roster projection of the Global Controller session
+   * carrying the given session id. A live ready session is folded directly; a
+   * cold id is restored or created through the standard open path (no extra
+   * read path). Appended-but-not-durable reservations are excluded from the
+   * projection (same quarantine semantics as project authority).
+   * @param sessionId - the Global Controller session id.
+   * @returns the current pathless roster projection.
+   */
+  async rosterView(sessionId: SessionId): Promise<ReadonlyMap<string, RosterView>> {
+    const ready = this.ready.get(sessionId)
+    if (ready !== undefined) {
+      if (ready.expected.role !== 'global') throw new ControlSessionError('INVALID_ID')
+      return this.roster.view(ready.result.agent.session.events)
+    }
+    const idText = String(sessionId)
+    if (!idText.startsWith(GLOBAL_SESSION_PREFIX)) throw new ControlSessionError('INVALID_ID')
+    const identity = this.hostCtx.get(PROFILE_IDENTITY_KEY) as HostProfileIdentity | undefined
+    if (identity === undefined) throw new ControlSessionError('PROFILE_IDENTITY_UNAVAILABLE')
+    const result = await this.openGlobal({ profileId: identity.id })
+    if (result.id !== sessionId) throw new ControlSessionError('INVALID_ID')
+    return this.roster.view(result.agent.session.events)
+  }
+
+  /**
+   * Fold the pathless Task Board projection of the Global Controller session
+   * carrying the given session id. A live ready session is folded directly; a
+   * cold id is restored or created through the standard open path (no extra
+   * read path). Only references (taskId / messageId / payloadRef) enter the
+   * projection — never message bodies or transcripts (hard stop §11.8).
+   * @param sessionId - the Global Controller session id.
+   * @returns the current pathless Task Board projection.
+   */
+  async taskBoardView(sessionId: SessionId): Promise<ReadonlyMap<string, TaskBoardTaskView>> {
+    const ready = this.ready.get(sessionId)
+    if (ready !== undefined) {
+      if (ready.expected.role !== 'global') throw new ControlSessionError('INVALID_ID')
+      return foldTaskBoard(ready.result.agent.session.events)
+    }
+    const idText = String(sessionId)
+    if (!idText.startsWith(GLOBAL_SESSION_PREFIX)) throw new ControlSessionError('INVALID_ID')
+    const identity = this.hostCtx.get(PROFILE_IDENTITY_KEY) as HostProfileIdentity | undefined
+    if (identity === undefined) throw new ControlSessionError('PROFILE_IDENTITY_UNAVAILABLE')
+    const result = await this.openGlobal({ profileId: identity.id })
+    if (result.id !== sessionId) throw new ControlSessionError('INVALID_ID')
+    return foldTaskBoard(result.agent.session.events)
+  }
+
+  /**
+   * Dispatch one task to a registered Worker (design §11.3, reservation →
+   * guard → admit, then the six-state observation drive). The Host appends a
+   * `queue` reservation to the Global Controller log, flushes it, runs the
+   * admit pre-gate (roster ready, the Slice 1C PolicyDecision slot for
+   * non-whitelisted payloads, semantic key not executed, no cross-project
+   * routing), appends `admit`, flushes again, and only then delivers the task
+   * payload envelope into the Worker inbox with a `coordinator/relay` source.
+   * The returned receipt is pathless; `ack` is observed from the Worker's
+   * `agent/inbox/spliced` insert and the later claim/start/report states are
+   * driven by the observation hook registered for this dispatch (design
+   * §11.3). An already-admitted semantic key takes the idempotent redispatch
+   * path (design §11.5): no queue/admit, a fresh physical message, and the
+   * existing task reference with `duplicate: true`.
+   * @param options - profile identity, task id, semantic key, addressing,
+   *   payload ref, optional objective/reply/lease, and cancellation.
+   * @returns the pathless receipt once the delivered message is acknowledged.
+   */
+  async dispatchTask(options: DispatchTaskOptions): Promise<DispatchTaskResult> {
+    const taskId = requireIdPart(options.taskId)
+    const semanticMessageId = requireIdPart(options.semanticMessageId)
+    // Per-key serialization (review P1-2): two concurrent dispatches with the
+    // SAME semantic key must never interleave between their await-flush
+    // points — that would append two queue/admit pairs and strand a zombie
+    // task. Mirror the authority/roster per-entity promise chains.
+    const prior = this.taskChains.get(semanticMessageId) ?? Promise.resolve()
+    const next = prior.then(
+      () => this.dispatchTaskNow(options, taskId, semanticMessageId),
+      () => this.dispatchTaskNow(options, taskId, semanticMessageId),
+    ).finally(() => {
+      if (this.taskChains.get(semanticMessageId) === next) this.taskChains.delete(semanticMessageId)
+    })
+    this.taskChains.set(semanticMessageId, next)
+    return next
+  }
+
+  private async dispatchTaskNow(
+    options: DispatchTaskOptions,
+    taskId: string,
+    semanticMessageId: string,
+  ): Promise<DispatchTaskResult> {
+    // Slice 1C-C first gate (design §12.9): the payload REFERENCE shape is
+    // validated before the 1B whitelist short-circuit and the policy slot — an
+    // empty or path-shaped reference (separator / drive letter) is
+    // TASK_PAYLOAD_UNSUPPORTED; a well-formed non-whitelisted reference falls
+    // through to the slot. `fixed-test-payload` passes unchanged.
+    if (!isPathlessPayloadRef(options.payloadRef)) {
+      throw new ControlSessionError('TASK_PAYLOAD_UNSUPPORTED')
+    }
+    const workerId = requireIdPart(options.workerId)
+    if (options.leaseMs !== undefined
+      && (!Number.isSafeInteger(options.leaseMs) || options.leaseMs <= 0)) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    if (options.ackTimeoutMs !== undefined
+      && (!Number.isSafeInteger(options.ackTimeoutMs) || options.ackTimeoutMs <= 0)) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    if (options.replyTo !== undefined
+      && (typeof options.replyTo.sessionId !== 'string' || options.replyTo.sessionId.length === 0
+        || typeof options.replyTo.messageId !== 'string' || options.replyTo.messageId.length === 0)) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    const controller = await this.openGlobal({
+      profileId: options.profileId,
+      ...options.signal === undefined ? {} : { signal: options.signal },
+    })
+    const globalSession = controller.agent.session
+    // Restart recovery (design §11.6 TASK_ABORTED_ON_RESTART): observation
+    // hooks are process-local and die with the Host. A task left `claimed` or
+    // `started` past its lease after a restart is aborted (expire) so its
+    // semantic key becomes re-dispatchable; tasks without a lease keep their
+    // state (no reliable liveness judgement) until a fresh dispatch re-arms.
+    this.recoverAbortedTasks(globalSession)
+    // The admit pre-gate (design §11.3/§11.6): fail before any append so a
+    // rejected dispatch leaves no reservation behind.
+    const worker = this.resolveDispatchWorker(
+      globalSession.events,
+      options.profileId,
+      workerId,
+      options.roleAssignment,
+    )
+    const reviewTarget = options.payloadRef === TASK_PAYLOAD_REVIEW
+      ? this.resolveReviewTarget(globalSession.events, options.reviewOfTaskId, worker)
+      : undefined
+    if (options.payloadRef === TASK_PAYLOAD_REVIEW
+      && (worker.roleAssignment !== 'reviewer' || !worker.capabilities.includes(TASK_PAYLOAD_REVIEW))) {
+      throw new ControlSessionError('ROSTER_INVALID')
+    }
+    if (options.payloadRef !== TASK_PAYLOAD_REVIEW && options.reviewOfTaskId !== undefined) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    const requestedObjectiveId = reviewTarget?.objectiveId ?? options.objectiveId
+    const objectiveId = this.guardTaskObjective(globalSession.events, requestedObjectiveId, worker)
+    if (options.payloadRef === TASK_PAYLOAD_EXECUTE && objectiveId === undefined) {
+      throw new ControlSessionError('OBJECTIVE_INVALID')
+    }
+    const reviewRef = options.reviewRef === undefined
+      ? undefined : parseTaskReviewReference(options.reviewRef)
+    if (reviewRef !== undefined) {
+      this.assertRevisionDispatch(globalSession.events, taskId, worker, objectiveId, reviewRef)
+    }
+    const base: TaskDispatchBase = {
+      taskId,
+      semanticMessageId,
+      workerId: worker.workerId,
+      payloadRef: options.payloadRef,
+      ...objectiveId === undefined ? {} : { objectiveId },
+      ...options.replyTo === undefined ? {} : { replyTo: options.replyTo },
+      ...options.reviewOfTaskId === undefined ? {} : { reviewOfTaskId: requireIdPart(options.reviewOfTaskId) },
+      ...reviewRef === undefined ? {} : { reviewRef },
+    }
+    // Slice 1C PolicyDecision slot (design §12.5): the whitelist short-circuits
+    // BEFORE the slot so the 1B-proven fixed-test-payload path is byte-identical.
+    // Real payloads are assembled into a ContextPacket, validated against the
+    // frozen run assets, and decided by the policy fold; only `allow` proceeds.
+    if (options.payloadRef !== TASK_PAYLOAD_WHITELIST) {
+      const decision = this.assertTaskDispatchEnabled(globalSession, worker, options)
+      // Slice 1C-C decision trail (design §12.5 step 4): an `allow` verdict is
+      // appended and flushed BEFORE the queue reservation, so the decision is
+      // durable before any Worker turn exists. A denied dispatch never reaches
+      // this line (the slot throws POLICY_DENIED) — deny leaves no record.
+      this.appendPolicyDecision(globalSession, taskId, decision)
+      await this.flushTaskChangeOrThrow(globalSession, options.signal)
+    }
+    // Idempotency arbiter (design §11.5): an admitted semantic key never
+    // queues/admits again; the redispatch is a delivery-layer at-least-once
+    // retry with a fresh physical message id.
+    if (semanticKeyAdmitted(globalSession.events, semanticMessageId)) {
+      return await this.redispatchTask(globalSession, base, options.profileId, options.signal)
+    }
+    // ① queue (reservation) — the payload reference, addressing, and keys enter
+    // the event; the message body never does (hard stop §11.8).
+    this.appendTaskChange(globalSession, base, { operation: 'queue' })
+    await this.flushTaskChangeOrThrow(globalSession, options.signal)
+    // ③ admit — the six-state decision point; the fold arbitrates re-admit.
+    this.appendTaskChange(globalSession, base, { operation: 'admit' })
+    await this.flushTaskChangeOrThrow(globalSession, options.signal)
+    // Register the observation hook BEFORE delivery so the inserted splice is
+    // never missed, then deliver (the ack insert is synchronous in followup).
+    const workerAgent = await this.resolveWorkerAgent(worker, options.signal)
+    const observer = this.observeTask({
+      profileId: options.profileId,
+      globalSession,
+      workerSession: workerAgent.session,
+      workerAgent,
+      base,
+      ...reviewTarget === undefined ? {} : { reviewTarget },
+      ...options.leaseMs === undefined ? {} : { leaseMs: options.leaseMs },
+    })
+    try {
+      const objective = routedObjectiveText(globalSession.events, base.objectiveId)
+      const message = this.deliverTaskMessage(globalSession, workerAgent, base, objective, reviewTarget)
+      await this.waitForTaskAck(
+        observer.ack,
+        options.ackTimeoutMs ?? TASK_ACK_WINDOW_MS,
+        options.signal,
+      )
+      const state = foldTask(globalSession.events, taskId).status
+      return {
+        taskId,
+        state,
+        messageId: String(message.id),
+        duplicate: false,
+        ...objectiveId === undefined ? {} : { objectiveId },
+      }
+    } catch (failure) {
+      observer.dispose()
+      throw controlSessionFailure(failure, 'DURABILITY_FAILED')
+    }
+  }
+
+  /** Resolve one reported executor task as the only admissible review input. */
+  private resolveReviewTarget(
+    events: readonly SessionEvent[],
+    reviewOfTaskId: string | undefined,
+    reviewer: RosterView,
+  ): ReviewTarget {
+    if (reviewOfTaskId === undefined) throw new ControlSessionError('TASK_INVALID')
+    const taskId = requireIdPart(reviewOfTaskId)
+    const target = foldTaskBoard(events).get(taskId)
+    if (target === undefined || target.state !== 'reported'
+      || target.payloadRef !== TASK_PAYLOAD_EXECUTE
+      || target.reportRef === undefined
+      || target.workerId === reviewer.workerId) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    if (foldTaskReviews(events).has(taskId)) {
+      throw new ControlSessionError('TASK_DUPLICATE')
+    }
+    if (reviewer.workspaceScope !== undefined) {
+      if (target.objectiveId === undefined) throw new ControlSessionError('CROSS_PROJECT_TASK')
+      const objective = foldObjective(events, target.objectiveId)
+      if (objective.status !== 'routed' || objective.workspaceId !== reviewer.workspaceScope) {
+        throw new ControlSessionError('CROSS_PROJECT_TASK')
+      }
+    }
+    return {
+      taskId,
+      workerId: target.workerId,
+      reportRef: target.reportRef,
+      ...target.objectiveId === undefined ? {} : { objectiveId: target.objectiveId },
+    }
+  }
+
+  /** Verify a Host-created revision reference against the durable review fold. */
+  private assertRevisionDispatch(
+    events: readonly SessionEvent[],
+    taskId: string,
+    worker: RosterView,
+    objectiveId: string | undefined,
+    reference: TaskReviewReferenceV1,
+  ): void {
+    if (worker.roleAssignment !== 'executor'
+      || !worker.capabilities.includes(TASK_PAYLOAD_EXECUTE)) {
+      throw new ControlSessionError('ROSTER_INVALID')
+    }
+    const event = events.find(candidate => candidate.seq === reference.reviewEventSeq)
+    if (event === undefined || event.type !== TASK_REVIEW_EVENT_TYPE) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    const review = parseTaskReviewEvidence(event.data)
+    if (review.evidenceSha256 !== reference.reviewEvidenceSha256
+      || review.verdict !== 'request_revision'
+      || review.revisionTaskId !== taskId) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+    const target = foldTaskBoard(events).get(review.taskId)
+    if (target === undefined || target.state !== 'reported' || target.reportRef === undefined
+      || target.workerId !== worker.workerId
+      || target.reportRef.evidenceSha256 !== review.executorReportSha256
+      || target.objectiveId !== objectiveId) {
+      throw new ControlSessionError('TASK_INVALID')
+    }
+  }
+
+  /**
+   * Resolve the dispatch addressing to one registered Worker and gate its
+   * status (design §11.2/§11.6). Role addressing resolves through
+   * {@link resolveRosterWorker} (zero/multiple matches are
+   * `ROLE_UNASSIGNED`/`ROLE_ASSIGNMENT_AMBIGUOUS`); a role-resolved Worker
+   * must agree with the caller's explicit workerId. Worker-id addressing folds
+   * the roster view directly. A missing, not-ready, or offline Worker fails
+   * closed with no append.
+   * @param events - the Global Controller session event log.
+   * @param profileId - the Host publishing profile identity.
+   * @param workerId - the caller's explicit Worker id (roster fold key).
+   * @param roleAssignment - optional role key to resolve instead.
+   * @returns the ready Worker view.
+   */
+  private resolveDispatchWorker(
+    events: readonly SessionEvent[],
+    profileId: string,
+    workerId: string,
+    roleAssignment: string | undefined,
+  ): RosterView {
+    let worker: RosterView
+    if (roleAssignment !== undefined) {
+      const role = requireIdPart(roleAssignment)
+      worker = resolveRosterWorker(events, role, profileId)
+      if (worker.workerId !== workerId) {
+        throw new ControlSessionError('ROLE_ASSIGNMENT_AMBIGUOUS')
+      }
+    } else {
+      const workerBy = this.roster.view(events).get(workerId)
+      if (workerBy === undefined) throw new ControlSessionError('WORKER_NOT_REGISTERED')
+      worker = workerBy
+    }
+    if (worker.status === 'offline') throw new ControlSessionError('WORKER_OFFLINE')
+    if (worker.status !== 'ready') throw new ControlSessionError('WORKER_NOT_READY')
+    return worker
+  }
+
+  /**
+   * Guard the optional objective association (design §11.3): a provided
+   * `objectiveId` must fold to a routed objective, and its workspace must not
+   * cross the Worker's registered workspace scope (`CROSS_PROJECT_TASK`). A
+   * global-scope Worker (no `workspaceScope`) accepts any routed objective.
+   * @param events - the Global Controller session event log.
+   * @param objectiveId - the optional routed objective record id.
+   * @param worker - the resolved ready Worker view.
+   * @returns the validated objective id (undefined when none was provided).
+   */
+  private guardTaskObjective(
+    events: readonly SessionEvent[],
+    objectiveId: string | undefined,
+    worker: RosterView,
+  ): string | undefined {
+    if (objectiveId === undefined) return undefined
+    const folded = foldObjective(events, objectiveId)
+    if (folded.status !== 'routed') throw new ControlSessionError('OBJECTIVE_INVALID')
+    if (worker.workspaceScope !== undefined && worker.workspaceScope !== folded.workspaceId) {
+      throw new ControlSessionError('CROSS_PROJECT_TASK')
+    }
+    return objectiveId
+  }
+
+  /**
+   * Map a Worker's registered role key onto the six ContextPacket roles
+   * (design §12.3). Slice 1B registers only 'executor'; a role key outside the
+   * six defaults to 'executor' (the 1B-proven template). Only the role KEY is
+   * defaulted — the policy decision itself always fails closed.
+   * @param worker - the resolved ready Worker view.
+   * @returns the ContextPacket role used for assembly.
+   */
+  private contextRoleForWorker(worker: RosterView): ContextRole {
+    return CONTEXT_ROLE_KEYS.has(worker.roleAssignment)
+      ? worker.roleAssignment as ContextRole
+      : 'executor'
+  }
+
+  /**
+   * Slice 1C PolicyDecision slot (design §12.5): assemble the Worker's minimal
+   * ContextPacket, validate it fail-closed, fold the Global policy/rule set,
+   * and gate the dispatch on the decision — only `allow` returns; every other
+   * kind (deny / draft_only / review_required / human_required — the five-class
+   * execution paths land in 1C-D) throws POLICY_DENIED before an event is
+   * appended or a Worker turn is created (no append, no delivery).
+   *
+   * Slice 1C-C scope: the slot adjudicates and RETURNS the allow evaluation;
+   * the caller appends the `policy/decision` record and flushes it before the
+   * queue reservation (deny leaves no record). `context/packet` is NOT
+   * appended in this slice — the packet summary is a taskBoardView-derived
+   * projection, and the 1C-D probe can append the durable record if the
+   * browser needs it. Rules are folded from
+   * `policy/rule` events already on the Global log; the production rule
+   * configuration surface is a later slice, so tests inject them directly.
+   * Frozen-run snapshot sourcing (foldRunFrozen over the Project Controller
+   * log + runId plumbing) is a 1C-D leftover — this slice assembles from the
+   * Host-provided role template only (design §12.3 "配置化角色模板").
+   * @param globalSession - the live Global Controller session (rules fold source).
+   * @param worker - the resolved ready Worker view (role mapping).
+   * @param options - the dispatch options (payloadRef is the adjudicated action).
+   * @returns the `allow` evaluation; non-allow throws POLICY_DENIED.
+   */
+  private assertTaskDispatchEnabled(
+    globalSession: Session,
+    worker: RosterView,
+    options: DispatchTaskOptions,
+  ): PolicyEvaluation {
+    const role = this.contextRoleForWorker(worker)
+    // Assemble (design §12.3): minimal sources under the role budget.
+    // Over-budget or missing-source assemblies fail closed as CONTEXT_* here,
+    // before the packet is ever handed to a Worker (hard stop §12.8: no
+    // truncated concatenation).
+    const packet = this.assembleDispatchContextPacket(role)
+    // Validate (design §12.3 full table): exact-key + fail-closed checks at the
+    // slot boundary so a forged assembly cannot slip through (CONTEXT_INVALID /
+    // MISSING / CONFLICT / OVER_BUDGET / EXPIRED).
+    validateContextPacket(packet)
+    // Decide (design §12.5 step 3): fold the Global `policy/rule` events (1C-A
+    // local event types, not yet in the typed vocabulary) and evaluate the
+    // request action — the payload reference — against the packet. An expired
+    // rule is SKIPPED (1C-A), so an expired-only rule set falls through to the
+    // fail-closed default deny — POLICY_DENIED, never POLICY_EXPIRED.
+    const decision = evaluatePolicy(
+      foldPolicyRules(globalSession.events),
+      packet,
+      options.payloadRef,
+    )
+    // Gate (design §12.5): only `allow` proceeds; the caller appends the
+    // durable decision record for it. Every other kind throws here, so a
+    // denied dispatch leaves no `policy/decision` record (deny 无痕).
+    assertPolicyAllowed(decision)
+    return decision
+  }
+
+  /**
+   * Assemble the ContextPacket the policy slot adjudicates: the Host-provided
+   * role template (design §12.3 "配置化角色模板"), defaulting to the single
+   * frozen base instruction source, under the role's byte budget. The
+   * CONTEXT_* fail-closed rows of the §12.6 negative table are reachable
+   * through the Host template (missing / conflict / over-budget) — the pure
+   * assembly and validation functions own the exact-key checks.
+   * @param role - the ContextPacket role mapped from the Worker's role key.
+   * @returns the assembled ContextPacket (never handed to a Worker unvalidated).
+   */
+  private assembleDispatchContextPacket(role: ContextRole): ContextPacketV1 {
+    return assembleContextPacket({
+      role,
+      sources: this.controlOptions.contextPacketSources ?? [TASK_CONTEXT_BASE_INSTRUCTION_SOURCE],
+      maxBytes: TASK_CONTEXT_BUDGET_BYTES[role],
+    })
+  }
+
+  /**
+   * Append one durable `policy/decision` record to the Global Controller log
+   * for an `allow` evaluation (design §12.2/§12.5 step 4). Only references
+   * (taskId / ruleId / packet digest) enter the log — never a payload body,
+   * path, or credential. The caller flushes the session right after.
+   * @param session - the Global Controller session.
+   * @param taskId - the semantic task id this decision adjudicates.
+   * @param decision - the `allow` evaluation to record.
+   */
+  private appendPolicyDecision(
+    session: Session,
+    taskId: string,
+    decision: PolicyEvaluation,
+  ): void {
+    // Every decision record defends the append seam through the exact-key
+    // validator (design §12.6 伪造 policy/decision → DECISION_INVALID).
+    parsePolicyDecisionPayload({
+      schemaVersion: 1,
+      taskId,
+      decision: decision.kind,
+      reason: decision.reason,
+      ...decision.rule === undefined ? {} : { ruleId: decision.rule.id },
+      packetDigest: contextPacketDigest(decision.packet),
+      changedAt: Date.now(),
+    })
+    session.append(POLICY_DECISION_EVENT_TYPE, {
+      schemaVersion: 1,
+      taskId,
+      decision: decision.kind,
+      reason: decision.reason,
+      ...decision.rule === undefined ? {} : { ruleId: decision.rule.id },
+      packetDigest: contextPacketDigest(decision.packet),
+      changedAt: Date.now(),
+    })
+  }
+
+  /**
+   * The idempotent redispatch path (design §11.5): the semantic key is already
+   * admitted, so no queue/admit is appended; the delivery layer retries with a
+   * fresh physical message and the caller receives the EXISTING task
+   * reference plus `duplicate: true`. The state machine never migrates and the
+   * observation arbiter discards any later duplicate claim/start/report.
+   * @param globalSession - the live Global Controller session.
+   * @param base - the dispatch addressing and keys.
+   * @param signal - cancellation for the Worker resolution.
+   * @returns the existing task receipt with `duplicate: true`.
+   */
+  private async redispatchTask(
+    globalSession: Session,
+    base: TaskDispatchBase,
+    profileId: string,
+    signal: AbortSignal | undefined,
+  ): Promise<DispatchTaskResult> {
+    const existing = findTaskBySemanticKey(globalSession.events, base.semanticMessageId)
+    if (existing === undefined) throw new ControlSessionError('TASK_DUPLICATE')
+    const worker = foldRoster(globalSession.events).get(base.workerId)
+    if (worker === undefined) throw new ControlSessionError('WORKER_NOT_REGISTERED')
+    const workerAgent = await this.resolveWorkerAgent(worker, signal)
+    const objective = routedObjectiveText(globalSession.events, base.objectiveId)
+    const reviewTarget = base.payloadRef === TASK_PAYLOAD_REVIEW
+      ? this.resolveReviewTarget(globalSession.events, base.reviewOfTaskId, worker)
+      : undefined
+    this.observeTask({
+      profileId,
+      globalSession,
+      workerSession: workerAgent.session,
+      workerAgent,
+      base,
+      ...reviewTarget === undefined ? {} : { reviewTarget },
+    })
+    const message = this.deliverTaskMessage(globalSession, workerAgent, base, objective, reviewTarget)
+    const state = foldTask(globalSession.events, existing.taskId).status
+    return {
+      taskId: existing.taskId,
+      state,
+      messageId: String(message.id),
+      duplicate: true,
+      ...existing.objectiveId === undefined ? {} : { objectiveId: existing.objectiveId },
+    }
+  }
+
+  /**
+   * Resolve the live Worker Agent for delivery: the registered Worker session
+   * is live in this process after registration; a Host restart leaves the
+   * roster durably `ready` but the Agent cold, so the durable Worker session
+   * is resumed through {@link openWorker} before delivery (design §11.2).
+   * @param worker - the durable registered Worker view.
+   * @param signal - cancellation for the resume.
+   * @returns the live Worker Agent.
+   */
+  private async resolveWorkerAgent(worker: RosterView, signal?: AbortSignal): Promise<Agent> {
+    const live = this.hostCtx.agents.get(workerSessionId(worker.workerId))
+    if (live !== undefined) return live
+    const handle = await this.openWorker(worker, signal)
+    return handle.agent
+  }
+
+  /**
+   * Build and deliver one task envelope into the Worker inbox (design
+   * §11.3/§11.4). Real execution receives a separate Host-authored context
+   * message in the Worker session; the coordinator relay remains a thin
+   * reference envelope. The insert splice is synchronous, so the observation
+   * hook appends `ack` during this call.
+   * @param globalSession - the live Global Controller session (the sender).
+   * @param workerAgent - the live Worker Agent receiving the relay.
+   * @param base - the dispatch addressing and keys.
+   * @param objective - the already-routed objective text for real execution.
+   * @returns the delivered immutable message (its id is the ack reference).
+   */
+  private deliverTaskMessage(
+    globalSession: Session,
+    workerAgent: Agent,
+    base: TaskDispatchBase,
+    objective?: string,
+    reviewTarget?: ReviewTarget,
+  ): UserMessage {
+    if (base.payloadRef === TASK_PAYLOAD_EXECUTE) {
+      if (objective === undefined || objective.length === 0) {
+        throw new ControlSessionError('OBJECTIVE_INVALID')
+      }
+      workerAgent.inject(createWorkerTaskContext(objective, base.payloadRef))
+    }
+    if (base.payloadRef === TASK_PAYLOAD_REVIEW) {
+      if (reviewTarget === undefined) throw new ControlSessionError('TASK_INVALID')
+      workerAgent.inject(createUserMessage({
+        content: [{
+          type: 'text',
+          text: createReviewerContext(
+            reviewTarget.taskId,
+            reviewTarget.workerId,
+            reviewTarget.reportRef.evidenceSha256,
+          ),
+        }],
+        source: { kind: 'plugin', plugin: 'devframe-review-context' },
+      }))
+    }
+    if (base.reviewRef !== undefined) {
+      const revision = this.revisionContexts.get(base.taskId)
+      if (revision === undefined) throw new ControlSessionError('TASK_INVALID')
+      workerAgent.inject(createUserMessage({
+        content: [{ type: 'text', text: createRevisionContext(revision.review, revision.findings) }],
+        source: { kind: 'plugin', plugin: 'devframe-revision-context' },
+      }))
+    }
+    const message = createUserMessage({
+      content: [{ type: 'text', text: buildFixedTaskPayloadText(base) }],
+      source: { kind: 'coordinator', form: 'relay', senderSessionId: globalSession.id },
+    })
+    workerAgent.followup(message)
+    return message
+  }
+
+  /**
+   * Register the per-dispatch observation hook (design §11.3): the Host folds
+   * the Worker's durable `agent/inbox/spliced` inserts (ack) and persistent
+   * removals (claim), then `request/header` (start) and `assistant/message`
+   * (report) into `task/change` events on the Global log, each append + flush.
+   * The hook lives past {@link dispatchTask}'s return and disposes itself when
+   * the task reaches a terminal state. Observation failures are logged, never
+   * propagated into the Worker's event dispatch.
+   * @param options - Global/Worker sessions, the dispatch base, and the lease.
+   * @returns the ack promise and the observer disposer.
+   */
+  /**
+   * Reconstruct durable `request_revision` continuations after a Host restart.
+   * The Global log carries only the review reference; raw findings are read
+   * back from the cited reviewer Session and never copied into Global events.
+   * Missing or tampered physical evidence stays pending and is logged as a
+   * bounded recovery failure rather than being guessed or silently dropped.
+   */
+  private async recoverPendingRevisions(
+    globalSession: Session,
+    profileId: string,
+  ): Promise<void> {
+    let reviews: ReadonlyMap<string, TaskReviewEvidenceV1>
+    let board: ReadonlyMap<string, TaskBoardTaskView>
+    try {
+      reviews = foldTaskReviews(globalSession.events)
+      board = foldTaskBoard(globalSession.events)
+    } catch (failure) {
+      this.hostCtx.logger.warn(`devframe review recovery blocked: ${String(failure)}`)
+      return
+    }
+    for (const review of reviews.values()) {
+      const revisionTaskId = review.revisionTaskId
+      if (review.verdict !== 'request_revision' || revisionTaskId === undefined) continue
+      if (isProjectLoopRevisionTaskId(review.taskId)) continue
+      const existing = board.get(revisionTaskId)
+      if (existing !== undefined
+        && (existing.payloadRef !== TASK_PAYLOAD_EXECUTE
+          || existing.state === 'reported'
+          || existing.state === 'failed'
+          || existing.state === 'cancelled')) continue
+      const target = board.get(review.taskId)
+      if (target === undefined || target.state !== 'reported'
+        || target.payloadRef !== TASK_PAYLOAD_EXECUTE
+        || target.objectiveId === undefined) {
+        this.hostCtx.logger.warn(`devframe review recovery pending: ${review.taskId} target is not a reported execute task`)
+        continue
+      }
+      let findings: string
+      try {
+        const inspection = await this.hostCtx.sessionPersistence.inspect(review.reviewerSessionId)
+        findings = recoverTaskReviewSubmission(inspection.events, review).findings
+      } catch (failure) {
+        this.hostCtx.logger.warn(`devframe review recovery pending: ${review.taskId} reviewer evidence unavailable (${String(failure)})`)
+        continue
+      }
+      const reference: TaskReviewReferenceV1 = {
+        taskId: review.taskId,
+        reviewEventSeq: globalSession.events.find(event => event.type === TASK_REVIEW_EVENT_TYPE
+          && event.data.evidenceSha256 === review.evidenceSha256)?.seq ?? -1,
+        reviewEvidenceSha256: review.evidenceSha256,
+      }
+      if (reference.reviewEventSeq < 0) {
+        this.hostCtx.logger.warn(`devframe review recovery blocked: ${review.taskId} review event is not durable`)
+        continue
+      }
+      this.revisionContexts.set(revisionTaskId, { review, findings })
+      try {
+        await this.dispatchTask({
+          profileId,
+          taskId: revisionTaskId,
+          semanticMessageId: existing?.semanticMessageId ?? revisionSemanticMessageId(revisionTaskId),
+          workerId: target.workerId,
+          roleAssignment: 'executor',
+          objectiveId: target.objectiveId,
+          payloadRef: TASK_PAYLOAD_EXECUTE,
+          reviewRef: reference,
+        })
+      } catch (failure) {
+        this.hostCtx.logger.warn(`devframe review recovery pending: ${review.taskId} revision dispatch failed (${String(failure)})`)
+      } finally {
+        this.revisionContexts.delete(revisionTaskId)
+      }
+    }
+  }
+
+  /**
+   * Abort tasks stranded past their lease after a Host restart (design §11.6
+   * `TASK_ABORTED_ON_RESTART`): observation hooks are process-local, so a
+   * claimed/started task whose lease expired while the Host was down is
+   * folded and closed with an `expire` append. The semantic key becomes
+   * re-dispatchable; tasks without a lease keep their state (no reliable
+   * liveness judgement) until a fresh dispatch re-arms observation.
+   * @param globalSession - the Global Controller session log.
+   */
+  private recoverAbortedTasks(globalSession: Session): void {
+    const now = Date.now()
+    const events = globalSession.events
+    // taskId → last task/change payload (to rebuild the dispatch base).
+    const lastChange = new Map<string, { semanticMessageId: string; workerId: string; payloadRef: string }>()
+    for (const event of events) {
+      if (event.type !== TASK_EVENT_TYPE) continue
+      const data = event.data as { taskId?: unknown; semanticMessageId?: unknown; workerId?: unknown; payloadRef?: unknown }
+      if (typeof data.taskId !== 'string'
+        || typeof data.semanticMessageId !== 'string'
+        || typeof data.workerId !== 'string'
+        || typeof data.payloadRef !== 'string') continue
+      lastChange.set(data.taskId, {
+        semanticMessageId: data.semanticMessageId,
+        workerId: data.workerId,
+        payloadRef: data.payloadRef,
+      })
+    }
+    for (const [taskId, fields] of lastChange) {
+      const state = foldTask(events, taskId)
+      if (state.status !== 'claimed' && state.status !== 'started') continue
+      const lease = state.status === 'claimed' ? state.leaseExpiresAt : undefined
+      if (lease === undefined || lease > now) continue
+      this.appendTaskChange(globalSession, {
+        taskId,
+        semanticMessageId: fields.semanticMessageId,
+        workerId: fields.workerId,
+        payloadRef: fields.payloadRef,
+      }, { operation: 'expire' })
+      this.hostCtx.logger.warn(
+        `devframe task: ${taskId} aborted after restart, lease expired (TASK_ABORTED_ON_RESTART)`,
+      )
+    }
+  }
+
+  private observeTask(options: {
+    readonly profileId?: string
+    readonly globalSession: Session
+    readonly workerSession: Session
+    readonly workerAgent: Agent
+    readonly base: TaskDispatchBase
+    readonly reviewTarget?: ReviewTarget
+    readonly leaseMs?: number
+  }): { readonly ack: Promise<void>; dispose(): void } {
+    const { profileId, globalSession, workerSession, workerAgent, base, reviewTarget, leaseMs } = options
+    // Seed the inbox projection from the splices already on the Worker log,
+    // then observe only events appended after registration.
+    const inbox: Record<InboxTarget, UserMessage[]> = { 'next-turn': [], 'next-step': [] }
+    const baseSeq = workerSession.seq
+    for (const event of workerSession.events) {
+      if (event.type !== 'agent/inbox/spliced') continue
+      applyInboxSplice(inbox, event.data)
+    }
+    const tracked = new Map<string, string>()
+    let ackAppended = false
+    let claimSeq = -1
+    let claimedMessageId: string | undefined
+    let leaseExpiresAt: number | undefined
+    let leaseTimer: ReturnType<typeof setTimeout> | undefined
+    let assistantEvent: SessionEvent<'assistant/message'> | undefined
+    let reviewSubmission: PendingReviewSubmission | undefined
+    let disposeReviewTool: (() => void) | undefined
+    let ackResolve: (() => void) | undefined
+    const ack = new Promise<void>((resolve) => { ackResolve = resolve })
+    let disposed = false
+
+    const appendChange = (change: TaskChangeAppend): void => {
+      this.appendTaskChange(globalSession, base, change)
+      void this.flushTaskChange(globalSession)
+    }
+
+    const checkLease = (): void => {
+      try {
+        const state = foldTask(globalSession.events, base.taskId)
+        if (state.status === 'claimed' || state.status === 'started') {
+          appendChange({ operation: 'expire' })
+          this.hostCtx.logger.warn(`devframe task: ${base.taskId} lease expired (TASK_LEASE_EXPIRED)`)
+        }
+      } catch (failure) {
+        this.hostCtx.logger.warn(`devframe task: ${base.taskId} lease check failed: ${String(failure)}`)
+      } finally {
+        dispose()
+      }
+    }
+
+    const dispose = (): void => {
+      if (disposed) return
+      disposed = true
+      if (leaseTimer !== undefined) clearTimeout(leaseTimer)
+      try {
+        disposeReviewTool?.()
+      } catch (failure) {
+        this.hostCtx.logger.warn(`devframe task: ${base.taskId} review tool cleanup failed: ${String(failure)}`)
+      }
+      detach()
+    }
+
+    const onEvent = (session: Session, event: SessionEvent): void => {
+      // Only events appended after registration are observed; the initial fold
+      // already applied every splice at or before baseSeq.
+      if (session !== workerSession || event.seq < baseSeq) return
+      try {
+        switch (event.type) {
+          case 'agent/inbox/spliced': {
+            const splice = event.data
+            const removed = inbox[splice.target]
+              .slice(splice.start, splice.start + (splice.removedCount ?? 0))
+            applyInboxSplice(inbox, splice)
+            // ack: the inserted physical message is durable (design §11.3).
+            for (const message of splice.inserted) {
+              const key = payloadSemanticKey(message)
+              if (key === undefined || key !== base.semanticMessageId) continue
+              tracked.set(String(message.id), key)
+              if (!ackAppended) {
+                // Only the first insert for an admitted key appends `ack`; a
+                // re-delivery's insert is tracked but never migrates the
+                // state machine (design §11.5).
+                if (foldTask(globalSession.events, base.taskId).status === 'admitted') {
+                  appendChange({ operation: 'ack', messageId: String(message.id) })
+                  ackAppended = true
+                  ackResolve?.()
+                }
+              }
+            }
+            // claim: the persistent removal of a tracked message (design §11.3).
+            if (removed.length > 0 && splice.outcome === undefined) {
+              for (const message of removed) {
+                const key = tracked.get(String(message.id)) ?? payloadSemanticKey(message)
+                if (key === undefined || key !== base.semanticMessageId) {
+                  // Hard stop §11.5: a claim must carry the semantic key.
+                  this.hostCtx.logger.warn(`devframe task: ${base.taskId} claim observation missing semantic key (TASK_CLAIM_MISSING_KEY)`)
+                  continue
+                }
+                const adjudication = adjudicateClaim(globalSession.events, key)
+                if (adjudication.kind === 'conflict') {
+                  this.hostCtx.logger.warn(`devframe task: ${base.taskId} claim conflict, observation discarded (TASK_CLAIM_CONFLICT)`)
+                  continue
+                }
+                if (adjudication.kind === 'duplicate') {
+                  this.hostCtx.logger.warn(`devframe task: ${base.taskId} duplicate claim observation discarded (TASK_DUPLICATE)`)
+                  continue
+                }
+                if (adjudication.kind !== 'ok') continue
+                leaseExpiresAt = leaseMs === undefined ? undefined : Date.now() + leaseMs
+                appendChange({
+                  operation: 'claim',
+                  messageId: String(message.id),
+                  ...leaseExpiresAt === undefined ? {} : { leaseExpiresAt },
+                })
+                claimSeq = event.seq
+                claimedMessageId = String(message.id)
+                if (leaseMs !== undefined) {
+                  leaseTimer = setTimeout(checkLease, leaseMs)
+                }
+                break
+              }
+            }
+            break
+          }
+          case 'request/header': {
+            // started: the first model request after the claim (design §11.3).
+            if (claimSeq < 0 || event.seq <= claimSeq) break
+            if (foldTask(globalSession.events, base.taskId).status !== 'claimed') break
+            appendChange({
+              operation: 'start',
+              ...claimedMessageId === undefined ? {} : { messageId: claimedMessageId },
+            })
+            break
+          }
+          case 'assistant/message': {
+            const state = foldTask(globalSession.events, base.taskId)
+            if (state.status !== 'claimed' && state.status !== 'started') break
+            // lease (design §11.6): a reply past the lease is expired, never
+            // reported; the semantic key stays re-dispatchable.
+            if (leaseExpiresAt !== undefined && Date.now() > leaseExpiresAt) {
+              appendChange({ operation: 'expire' })
+              this.hostCtx.logger.warn(`devframe task: ${base.taskId} reply past lease (TASK_LEASE_EXPIRED)`)
+              dispose()
+              break
+            }
+            if (base.payloadRef === TASK_PAYLOAD_EXECUTE || base.payloadRef === TASK_PAYLOAD_REVIEW) {
+              // Real executor reports require the terminal turn boundary; the
+              // next `turn/end` event will bind the final assistant step.
+              assistantEvent = event
+              break
+            }
+            appendChange({ operation: 'report', messageId: String(event.data.message.id) })
+            dispose()
+            break
+          }
+          case 'turn/end': {
+            if (base.payloadRef !== TASK_PAYLOAD_EXECUTE
+              && base.payloadRef !== TASK_PAYLOAD_REVIEW) break
+            const state = foldTask(globalSession.events, base.taskId)
+            if (state.status !== 'claimed' && state.status !== 'started') break
+            if (leaseExpiresAt !== undefined && Date.now() > leaseExpiresAt) {
+              appendChange({ operation: 'expire' })
+              this.hostCtx.logger.warn(`devframe task: ${base.taskId} terminal turn past lease (TASK_LEASE_EXPIRED)`)
+              dispose()
+              break
+            }
+            if (assistantEvent === undefined) {
+              appendChange({ operation: 'fail' })
+              this.hostCtx.logger.warn(`devframe task: ${base.taskId} terminal turn has no assistant reply (TASK_REPORT_MISSING)`)
+              dispose()
+              break
+            }
+            try {
+              const reportRef = createTaskReportEvidence(workerSession, assistantEvent, event)
+              if (base.payloadRef === TASK_PAYLOAD_REVIEW) {
+                if (reviewSubmission === undefined || reviewTarget === undefined || profileId === undefined) {
+                  appendChange({ operation: 'fail' })
+                  this.hostCtx.logger.warn(`devframe task: ${base.taskId} reviewer did not submit a verdict (TASK_REVIEW_MISSING)`)
+                } else {
+                  void this.finalizeReview({
+                    profileId,
+                    globalSession,
+                    workerSession,
+                    workerId: base.workerId,
+                    base,
+                    reviewTarget,
+                    assistantEvent,
+                    turnEndEvent: event,
+                    reportRef,
+                    submission: reviewSubmission,
+                  }).catch((failure: unknown) => {
+                    this.hostCtx.logger.warn(`devframe task: ${base.taskId} review finalization failed: ${String(failure)}`)
+                  })
+                }
+              } else {
+                appendChange({
+                  operation: 'report',
+                  messageId: reportRef.messageId,
+                  reportRef,
+                })
+                if (base.reviewRef !== undefined
+                  && isProjectLoopTargetTaskId(base.reviewRef.taskId)) {
+                  void this.scheduleProjectLoopRereview({
+                    profileId: profileId ?? '',
+                    globalSession,
+                    revisionTaskId: base.taskId,
+                    reviewTargetTaskId: base.reviewRef.taskId,
+                  }).catch((failure: unknown) => {
+                    this.hostCtx.logger.warn(`devframe loop re-review scheduling failed: ${String(failure)}`)
+                  })
+                }
+              }
+            } catch (failure) {
+              appendChange({ operation: 'fail' })
+              this.hostCtx.logger.warn(`devframe task: ${base.taskId} report evidence invalid (TASK_REPORT_INVALID): ${String(failure)}`)
+            }
+            dispose()
+            break
+          }
+          case 'user/message': {
+            // A→B bypass audit (design §11.6, hard stop §11.8): the Worker's
+            // relay is the only governance delivery. The first real executor
+            // also receives one Host-authored task-context injection before
+            // the relay; it is physical Worker context, not another delivery
+            // path and never enters the Task Board view.
+            const source = (event.data as { source?: { kind?: unknown; form?: unknown } }).source
+            const isContext = source?.kind === 'plugin'
+              && (event.data as { source?: { plugin?: unknown } }).source?.plugin === 'devframe-task-context'
+            if (!isContext && (source === undefined || source.kind !== 'coordinator' || source.form !== 'relay')) {
+              this.hostCtx.logger.warn(
+                `devframe task: ${base.taskId} worker received a non-relay message (UNTRACKED_MESSAGE)`,
+              )
+            }
+            break
+          }
+          default:
+            break
+        }
+      } catch (failure) {
+        this.hostCtx.logger.warn(`devframe task: ${base.taskId} observation failed: ${String(failure)}`)
+      }
+    }
+    let detach = (): void => {}
+    detach = this.hostCtx.on('session/event', onEvent)
+    if (base.payloadRef === TASK_PAYLOAD_REVIEW) {
+      if (reviewTarget === undefined) throw new ControlSessionError('TASK_INVALID')
+      disposeReviewTool = installReviewSubmissionTool(workerAgent, (submission) => {
+        reviewSubmission = submission
+      })
+    }
+    return { ack, dispose }
+  }
+
+  /** Persist one reviewer verdict, then schedule only an explicitly requested revision. */
+  private async finalizeReview(options: {
+    readonly profileId: string
+    readonly globalSession: Session
+    readonly workerSession: Session
+    readonly workerId: string
+    readonly base: TaskDispatchBase
+    readonly reviewTarget: ReviewTarget
+    readonly assistantEvent: SessionEvent<'assistant/message'>
+    readonly turnEndEvent: SessionEvent<'turn/end'>
+    readonly reportRef: TaskReportEvidenceV1
+    readonly submission: PendingReviewSubmission
+  }): Promise<void> {
+    const loopRevisionTarget = isProjectLoopRevisionTaskId(options.reviewTarget.taskId)
+    const revisionTaskId = options.submission.verdict !== 'request_revision'
+      ? undefined
+      : loopRevisionTarget
+        ? undefined
+        : isProjectLoopTargetTaskId(options.reviewTarget.taskId)
+          ? projectLoopRevisionTaskId(options.reviewTarget.taskId)
+          : randomUUID()
+    const review = createTaskReviewEvidence(
+      options.workerSession,
+      options.workerId,
+      options.reviewTarget,
+      options.assistantEvent,
+      options.turnEndEvent,
+      options.submission,
+      revisionTaskId,
+    )
+    // The reviewer Task itself becomes evidence-linked before the independent
+    // review event; both are flushed together as one durable Global boundary.
+    this.appendTaskChange(options.globalSession, options.base, {
+      operation: 'report',
+      messageId: options.reportRef.messageId,
+      reportRef: options.reportRef,
+    })
+    const reviewEventSeq = options.globalSession.seq
+    options.globalSession.append(TASK_REVIEW_EVENT_TYPE, review)
+    const existingReceipt = foldEvaluationReceipts(options.globalSession.events).get(review.taskId)
+    if (existingReceipt === undefined) {
+      const receipt = createEvaluationReceipt({
+        subjectTaskId: review.taskId,
+        evaluatorTaskId: options.base.taskId,
+        evaluatorSessionId: options.workerSession.id,
+        sourceReviewSha256: review.evidenceSha256,
+        outcome: evaluationOutcomeForReview(review.verdict),
+        artifactRefs: options.reviewTarget.reportRef.artifactRefs ?? [],
+        trajectoryRefs: options.reviewTarget.reportRef.trajectoryRefs ?? [],
+      })
+      options.globalSession.append(EVALUATION_RECEIPT_EVENT_TYPE, receipt)
+    }
+    await this.flushTaskChangeOrThrow(options.globalSession, undefined)
+    await this.settleProjectLoopReview(options.globalSession, review)
+    if (revisionTaskId === undefined || loopRevisionTarget) return
+
+    const reference: TaskReviewReferenceV1 = {
+      taskId: options.reviewTarget.taskId,
+      reviewEventSeq,
+      reviewEvidenceSha256: review.evidenceSha256,
+    }
+    const objectiveId = options.reviewTarget.objectiveId
+    if (objectiveId === undefined) throw new ControlSessionError('OBJECTIVE_INVALID')
+    this.revisionContexts.set(revisionTaskId, {
+      review,
+      findings: options.submission.findings,
+    })
+    try {
+      await this.dispatchTask({
+        profileId: options.profileId,
+        taskId: revisionTaskId,
+        semanticMessageId: revisionSemanticMessageId(revisionTaskId),
+        workerId: options.reviewTarget.workerId,
+        roleAssignment: 'executor',
+        objectiveId,
+        payloadRef: TASK_PAYLOAD_EXECUTE,
+        reviewRef: reference,
+      })
+    } finally {
+      this.revisionContexts.delete(revisionTaskId)
+    }
+  }
+
+  /** Ensure one stable, workspace-scoped Worker exists for ProjectLoop review. */
+  private async ensureProjectLoopWorker(options: {
+    readonly globalSession: Session
+    readonly profileId: string
+    readonly workerId: string
+    readonly roleAssignment: 'executor' | 'reviewer'
+    readonly workspaceId: string
+  }): Promise<RosterView> {
+    const existing = this.roster.view(options.globalSession.events).get(options.workerId)
+    if (existing !== undefined) {
+      if (existing.profileId !== options.profileId
+        || existing.roleAssignment !== options.roleAssignment
+        || existing.workspaceScope !== options.workspaceId
+        || existing.status === 'offline'
+        || existing.status === 'pending'
+        || (options.roleAssignment === 'executor'
+          ? !existing.capabilities.includes(TASK_PAYLOAD_EXECUTE)
+          : !existing.capabilities.includes(TASK_PAYLOAD_REVIEW))) {
+        throw new ControlSessionError(existing.status === 'offline' ? 'WORKER_OFFLINE' : 'ROSTER_INVALID')
+      }
+      return existing
+    }
+    return await this.registerWorker({
+      profileId: options.profileId,
+      workerId: options.workerId,
+      roleAssignment: options.roleAssignment,
+      workspaceScope: options.workspaceId,
+      capabilities: [options.roleAssignment === 'executor' ? TASK_PAYLOAD_EXECUTE : TASK_PAYLOAD_REVIEW],
+    })
+  }
+
+  /** Add only the narrow Host-owned policy slots needed by automatic review. */
+  private async ensureProjectLoopPolicies(
+    globalSession: Session,
+  ): Promise<void> {
+    const expected = [
+      {
+        id: PROJECT_LOOP_EXECUTE_POLICY_ID,
+        contextKind: 'executor',
+        action: TASK_PAYLOAD_EXECUTE,
+      },
+      {
+        id: PROJECT_LOOP_REVIEW_POLICY_ID,
+        contextKind: 'reviewer',
+        action: TASK_PAYLOAD_REVIEW,
+      },
+    ] as const
+    const rules = foldPolicyRules(globalSession.events)
+    let changed = false
+    for (const requirement of expected) {
+      const matching = rules.find(rule => (
+        (rule.expiresAt === undefined || rule.expiresAt >= Date.now())
+        && rule.match.workspaceId === undefined
+        && (rule.match.contextKind === undefined || rule.match.contextKind === requirement.contextKind)
+        && (rule.match.action === undefined || rule.match.action === requirement.action)
+      ))
+      if (matching !== undefined) {
+        if (matching.kind !== 'allow') throw new ControlSessionError('POLICY_DENIED')
+        continue
+      }
+      globalSession.append(POLICY_RULE_EVENT_TYPE, {
+        schemaVersion: 1,
+        id: requirement.id,
+        kind: 'allow',
+        match: { contextKind: requirement.contextKind, action: requirement.action },
+        obligation: requirement.contextKind === 'reviewer' ? 'reviewer-approval' : 'bounded-execution',
+      })
+      changed = true
+    }
+    if (changed) await this.flushTaskChangeOrThrow(globalSession, undefined)
+  }
+
+  /** Materialize the real native Project Controller turn as one report-only task. */
+  private async materializeProjectLoopExecution(options: {
+    readonly globalSession: Session
+    readonly loopId: string
+    readonly objectiveId: string
+    readonly projectId: string
+    readonly projectTrace: DevFrameProjectGoalDispatchTrace
+    readonly executorWorkerId: string
+  }): Promise<{ readonly taskId: string; readonly reportRef: TaskReportEvidenceV1 } | undefined> {
+    if (options.projectTrace.outcome !== 'completed') return undefined
+    const existingTaskId = projectLoopTargetTaskId(options.loopId)
+    const existing = foldTaskBoard(options.globalSession.events).get(existingTaskId)
+    if (existing?.reportRef !== undefined) return { taskId: existingTaskId, reportRef: existing.reportRef }
+    const inspection = await this.hostCtx.sessionPersistence.inspect(options.projectTrace.sessionId)
+    const terminal = terminalGoalEvidence(inspection.events)
+    if (terminal === undefined) return undefined
+    const reportRef = createTaskReportEvidence(
+      { id: inspection.meta.id, events: inspection.events },
+      terminal.assistant,
+      terminal.turnEnd,
+    )
+    const base: TaskDispatchBase = {
+      taskId: existingTaskId,
+      semanticMessageId: existingTaskId,
+      workerId: options.executorWorkerId,
+      payloadRef: TASK_PAYLOAD_EXECUTE,
+      objectiveId: options.objectiveId,
+    }
+    const syntheticMessageId = `${existingTaskId}:message`
+    this.appendTaskChange(options.globalSession, base, { operation: 'queue' })
+    this.appendTaskChange(options.globalSession, base, { operation: 'admit' })
+    this.appendTaskChange(options.globalSession, base, { operation: 'ack', messageId: syntheticMessageId })
+    this.appendTaskChange(options.globalSession, base, { operation: 'claim', messageId: syntheticMessageId })
+    this.appendTaskChange(options.globalSession, base, { operation: 'start', messageId: syntheticMessageId })
+    this.appendTaskChange(options.globalSession, base, {
+      operation: 'report', messageId: reportRef.messageId, reportRef,
+    })
+    await this.flushTaskChangeOrThrow(options.globalSession, undefined)
+    return { taskId: existingTaskId, reportRef }
+  }
+
+  /** Start the one bounded reviewer dispatch for a completed ProjectLoop. */
+  private async startProjectLoopReview(options: {
+    readonly profileId: string
+    readonly projectId: string
+    readonly loopId: string
+    readonly objectiveId: string
+    readonly projectTrace: DevFrameProjectGoalDispatchTrace
+  }): Promise<void> {
+    const prior = this.loopReviewDispatches.get(options.loopId)
+    if (prior !== undefined) return prior
+    const operation = (async (): Promise<void> => {
+      const global = await this.openGlobal({ profileId: options.profileId })
+      const executorWorkerId = `${PROJECT_LOOP_EXECUTOR_PREFIX}${options.projectId}`
+      const reviewerWorkerId = `${PROJECT_LOOP_REVIEWER_PREFIX}${options.projectId}`
+      await this.ensureProjectLoopPolicies(global.agent.session)
+      await this.ensureProjectLoopWorker({
+        globalSession: global.agent.session,
+        profileId: options.profileId,
+        workerId: executorWorkerId,
+        roleAssignment: 'executor',
+        workspaceId: options.projectId,
+      })
+      const reviewer = await this.ensureProjectLoopWorker({
+        globalSession: global.agent.session,
+        profileId: options.profileId,
+        workerId: reviewerWorkerId,
+        roleAssignment: 'reviewer',
+        workspaceId: options.projectId,
+      })
+      const target = await this.materializeProjectLoopExecution({
+        globalSession: global.agent.session,
+        loopId: options.loopId,
+        objectiveId: options.objectiveId,
+        projectId: options.projectId,
+        projectTrace: options.projectTrace,
+        executorWorkerId,
+      })
+      if (target === undefined) {
+        this.hostCtx.logger.warn(`devframe loop review pending: no terminal report for ${options.loopId}`)
+        return
+      }
+      const reviewTaskId = projectLoopReviewTaskId(target.taskId)
+      const board = foldTaskBoard(global.agent.session.events)
+      if (board.has(reviewTaskId) || foldTaskReviews(global.agent.session.events).has(target.taskId)) return
+      await this.dispatchTask({
+        profileId: options.profileId,
+        taskId: reviewTaskId,
+        semanticMessageId: reviewTaskId,
+        workerId: reviewer.workerId,
+        roleAssignment: 'reviewer',
+        payloadRef: TASK_PAYLOAD_REVIEW,
+        reviewOfTaskId: target.taskId,
+      })
+    })()
+    this.loopReviewDispatches.set(options.loopId, operation)
+    try {
+      await operation
+    } finally {
+      if (this.loopReviewDispatches.get(options.loopId) === operation) this.loopReviewDispatches.delete(options.loopId)
+    }
+  }
+
+  /** Dispatch the existing reviewer again after the one bounded revision task reports. */
+  private async scheduleProjectLoopRereview(options: {
+    readonly profileId: string
+    readonly globalSession: Session
+    readonly revisionTaskId: string
+    readonly reviewTargetTaskId: string
+  }): Promise<void> {
+    if (options.profileId.length === 0 || !isProjectLoopTargetTaskId(options.reviewTargetTaskId)) return
+    const reviews = foldTaskReviews(options.globalSession.events)
+    const initialReview = reviews.get(options.reviewTargetTaskId)
+    if (initialReview?.verdict !== 'request_revision') return
+    const board = foldTaskBoard(options.globalSession.events)
+    const revision = board.get(options.revisionTaskId)
+    if (revision?.state !== 'reported' || revision.reportRef === undefined) return
+    const reviewTaskId = projectLoopReviewTaskId(options.revisionTaskId)
+    if (board.has(reviewTaskId) || reviews.has(options.revisionTaskId)) return
+    await this.dispatchTask({
+      profileId: options.profileId,
+      taskId: reviewTaskId,
+      semanticMessageId: reviewTaskId,
+      workerId: initialReview.reviewerWorkerId,
+      roleAssignment: 'reviewer',
+      payloadRef: TASK_PAYLOAD_REVIEW,
+      reviewOfTaskId: options.revisionTaskId,
+    })
+  }
+
+  /** Fold one reviewer verdict back into the durable ProjectLoop result. */
+  private async settleProjectLoopReview(
+    globalSession: Session,
+    review: TaskReviewEvidenceV1,
+  ): Promise<void> {
+    const loopId = projectLoopIdFromTaskId(review.taskId)
+    if (loopId === undefined) return
+    const current = foldLoop(globalSession.events, loopId)
+    if (current === undefined) return
+    if (review.verdict === 'request_revision' && isProjectLoopTargetTaskId(review.taskId)) return
+    const settled: 'passed' | 'failed' = review.verdict === 'pass' ? 'passed' : 'failed'
+    if (current.review === settled && current.outcome === 'completed') return
+    const change = {
+      schemaVersion: 1 as const,
+      kind: 'loop' as const,
+      version: 1 as const,
+      loopId,
+      objectiveId: current.objectiveId,
+      projectId: current.projectId,
+      projectSessionId: current.projectSessionId,
+      outcome: current.outcome,
+      review: settled,
+      changedAt: Date.now(),
+    }
+    this.appendLoopChange(globalSession, { ...change, operation: 'review' })
+    this.appendLoopChange(globalSession, { ...change, operation: 'complete' })
+    await this.flushLoopSession(globalSession, undefined)
+  }
+
+  /**
+   * Wait for the delivered message's inbox insert to be observed, bounded by
+   * the ack window and the caller's cancellation (design §11.6:
+   * `DISPATCH_NOT_ACKNOWLEDGED` / `DISPATCH_CANCELLED`).
+   * @param ack - the observation's ack promise.
+   * @param windowMs - the durability window.
+   * @param signal - caller cancellation.
+   */
+  private waitForTaskAck(
+    ack: Promise<void>,
+    windowMs: number,
+    signal: AbortSignal | undefined,
+  ): Promise<void> {
+    if (signal?.aborted ?? false) throw new ControlSessionError('DISPATCH_CANCELLED')
+    return new Promise<void>((resolve, reject) => {
+      const timer = setTimeout(() => {
+        reject(new ControlSessionError('DISPATCH_NOT_ACKNOWLEDGED'))
+      }, windowMs)
+      const onAbort = (): void => {
+        clearTimeout(timer)
+        reject(new ControlSessionError('DISPATCH_CANCELLED'))
+      }
+      signal?.addEventListener('abort', onAbort, { once: true })
+      ack.then(
+        () => {
+          clearTimeout(timer)
+          signal?.removeEventListener('abort', onAbort)
+          resolve()
+        },
+        (failure: unknown) => {
+          clearTimeout(timer)
+          signal?.removeEventListener('abort', onAbort)
+          reject(failure instanceof Error
+            ? failure
+            : new ControlSessionError('DURABILITY_FAILED', { cause: failure }))
+        },
+      )
+    })
+  }
+
+  /**
+   * Append one exact-key `task/change` payload to the Global Controller log.
+   * The payload mirrors the design §11.3 contract exactly: references only,
+   * no message bodies or transcripts.
+   * @param session - the Global Controller session.
+   * @param base - the dispatch addressing and keys.
+   * @param change - the operation and its optional references.
+   */
+  private appendTaskChange(
+    session: Session,
+    base: TaskDispatchBase,
+    change: TaskChangeAppend,
+  ): void {
+    session.append(TASK_EVENT_TYPE, {
+      schemaVersion: 1,
+      kind: 'task',
+      version: 1,
+      operation: change.operation,
+      taskId: base.taskId,
+      semanticMessageId: base.semanticMessageId,
+      workerId: base.workerId,
+      payloadRef: base.payloadRef,
+      changedAt: Date.now(),
+      ...base.objectiveId === undefined ? {} : { objectiveId: base.objectiveId },
+      ...base.replyTo === undefined ? {} : { replyTo: { sessionId: base.replyTo.sessionId, messageId: base.replyTo.messageId } },
+      ...change.messageId === undefined ? {} : { messageId: change.messageId },
+      ...change.reportRef === undefined ? {} : { reportRef: change.reportRef },
+      ...base.reviewRef === undefined ? {} : { reviewRef: base.reviewRef },
+      ...change.reviewRef === undefined ? {} : { reviewRef: change.reviewRef },
+      ...change.leaseExpiresAt === undefined ? {} : { leaseExpiresAt: change.leaseExpiresAt },
+    })
+  }
+
+  /** Flush one Task Board mutation; failures are logged, never propagated. */
+  private async flushTaskChange(session: Session): Promise<void> {
+    try {
+      await this.flushTaskChangeOrThrow(session, undefined)
+    } catch (failure) {
+      this.hostCtx.logger.warn(`devframe task: durability flush failed: ${String(failure)}`)
+    }
+  }
+
+  /** Flush the Global Controller session and fail closed on a non-durable outcome. */
+  private async flushTaskChangeOrThrow(
+    session: Session,
+    signal: AbortSignal | undefined,
+  ): Promise<void> {
+    signal?.throwIfAborted()
+    let durable = false
+    try {
+      durable = await this.hostCtx.sessions.flush(session)
+    } catch (failure) {
+      throw new ControlSessionError('DURABILITY_FAILED', { cause: failure })
+    }
+    if (!durable) throw new ControlSessionError('DURABILITY_FAILED')
+  }
+
+  /**
+   * Route one Global Controller objective to a Workspace: append one
+   * `objective/change` create + one route to the Global session log (design
+   * §10.4: one objective = one target record + routing), flush, and resolve
+   * only after the log is durable. The returned ids are pathless; the Global
+   * tool surface stays empty, so routing never touches project files.
+   * @param options - profile identity, structural-only objective text, Workspace id.
+   * @returns the pathless objective route once durable.
+   */
+  async routeObjective(options: RouteObjectiveOptions): Promise<RouteObjectiveResult> {
+    const objective = typeof options.objective === 'string' ? options.objective.trim() : ''
+    if (objective.length === 0 || objective.length > OBJECTIVE_MAX_TEXT_LENGTH) {
+      throw new ControlSessionError('OBJECTIVE_INVALID')
+    }
+    const workspaceId = requireIdPart(options.workspaceId)
+    const controller = await this.openGlobal({
+      profileId: options.profileId,
+      ...options.signal === undefined ? {} : { signal: options.signal },
+    })
+    const objectiveId = options.objectiveId === undefined
+      ? randomUUID()
+      : requireIdPart(options.objectiveId)
+    const changedAt = Date.now()
+    controller.agent.session.append(OBJECTIVE_CHANGE_EVENT_TYPE, {
+      schemaVersion: 1,
+      kind: 'objective',
+      version: 1,
+      operation: 'create',
+      objectiveId,
+      text: objective,
+      changedAt,
+    })
+    controller.agent.session.append(OBJECTIVE_CHANGE_EVENT_TYPE, {
+      schemaVersion: 1,
+      kind: 'objective',
+      version: 1,
+      operation: 'route',
+      objectiveId,
+      workspaceId,
+      changedAt,
+    })
+    options.signal?.throwIfAborted()
+    let durable = false
+    try {
+      durable = await this.hostCtx.sessions.flush(controller.agent.session)
+    } catch (failure) {
+      throw new ControlSessionError('DURABILITY_FAILED', { cause: failure })
+    }
+    if (!durable) throw new ControlSessionError('DURABILITY_FAILED')
+    return { objectiveId, workspaceId }
+  }
+
+  /**
+   * Run the first complete Global→Project loop through one Host call. The
+   * explicit Workspace is validated before the memory subprocess is started;
+   * the existing authority and objective gates remain authoritative. Memory
+   * is governed and create-only, but unavailable memory degrades the evidence
+   * channel rather than turning a completed project run into a false failure.
+   */
+  async dispatchProjectLoop(options: DispatchProjectLoopOptions): Promise<DevFrameProjectLoopTrace> {
+    const requestHash = hashRequestIdempotencyKey(options.requestIdempotencyKey)
+    if (requestHash === undefined) return await this.runProjectLoop(options, undefined)
+    const mapKey = `${options.profileId}:${requestHash}`
+    const inFlight = this.loopRequests.get(mapKey)
+    if (inFlight !== undefined) return await inFlight
+    const operation = (async (): Promise<DevFrameProjectLoopTrace> => {
+      const replay = await this.replayProjectLoop(options, requestHash)
+      if (replay !== undefined) return replay
+      return await this.runProjectLoop(options, requestHash)
+    })()
+    this.loopRequests.set(mapKey, operation)
+    try {
+      return await operation
+    } finally {
+      if (this.loopRequests.get(mapKey) === operation) this.loopRequests.delete(mapKey)
+    }
+  }
+
+  private async replayProjectLoop(
+    options: DispatchProjectLoopOptions,
+    requestHash: string,
+  ): Promise<DevFrameProjectLoopTrace | undefined> {
+    const global = await this.openGlobal({
+      profileId: options.profileId,
+      ...options.signal === undefined ? {} : { signal: options.signal },
+    })
+    let start: ReturnType<typeof parseLoopChange> | undefined
+    for (const event of global.agent.session.events) {
+      if (event.type !== LOOP_CHANGE_EVENT_TYPE) continue
+      const change = parseLoopChange(event.data)
+      if (change.operation !== 'start' || change.requestIdempotencyKeyHash !== requestHash) continue
+      if (start !== undefined && start.loopId !== change.loopId) {
+        throw new ControlSessionError('LOOP_IDEMPOTENCY_CONFLICT')
+      }
+      start = change
+    }
+    if (start === undefined) return undefined
+    if (start.projectId !== options.projectId) {
+      throw new ControlSessionError('LOOP_IDEMPOTENCY_CONFLICT')
+    }
+    const objective = foldObjective(global.agent.session.events, start.objectiveId)
+    if (objective.status === 'routed'
+      && (objective.workspaceId !== options.projectId || objective.text !== options.objective.trim())) {
+      throw new ControlSessionError('LOOP_IDEMPOTENCY_CONFLICT')
+    }
+    const latest = [...global.agent.session.events].reverse().find((event) => {
+      if (event.type !== LOOP_CHANGE_EVENT_TYPE) return false
+      return parseLoopChange(event.data).loopId === start.loopId
+    })
+    if (latest?.type !== LOOP_CHANGE_EVENT_TYPE) return undefined
+    const latestChange = parseLoopChange(latest.data)
+    if (latestChange.operation !== 'complete' && latestChange.operation !== 'fail') {
+      throw new ControlSessionError('LOOP_IN_PROGRESS')
+    }
+    const folded = foldLoop(global.agent.session.events, start.loopId)
+    if (folded === undefined) throw new ControlSessionError('LOOP_INVALID')
+    const memory = foldMemory(global.agent.session.events, start.loopId)
+    const projectSessionId = String(folded.projectSessionId).length > 0
+      ? folded.projectSessionId
+      : projectControllerSessionId(start.projectId)
+    return {
+      ...folded,
+      projectSessionId,
+      sessionId: projectSessionId,
+      memoryStatus: memory?.status ?? 'unknown',
+    }
+  }
+
+  private async runProjectLoop(
+    options: DispatchProjectLoopOptions,
+    requestIdempotencyKeyHash: string | undefined,
+  ): Promise<DevFrameProjectLoopTrace> {
+    const objective = typeof options.objective === 'string' ? options.objective.trim() : ''
+    if (objective.length === 0 || objective.length > OBJECTIVE_MAX_TEXT_LENGTH) {
+      throw new ControlSessionError('OBJECTIVE_INVALID')
+    }
+    const maxGoalRounds = options.maxGoalRounds ?? 1
+    if (maxGoalRounds !== 1 && maxGoalRounds !== 2) {
+      throw new ControlSessionError('INVALID_GOAL_BUDGET')
+    }
+    const projectId = requireIdPart(options.projectId)
+    const projectRoot = typeof options.projectRoot === 'string' ? options.projectRoot.trim() : ''
+    if (projectRoot.length === 0) throw new ControlSessionError('INVALID_PROJECT_ROOT')
+    let canonicalRoot: string
+    try {
+      canonicalRoot = await canonicalizeWatchPath(projectRoot)
+    } catch (failure) {
+      throw new ControlSessionError('INVALID_PROJECT_ROOT', { cause: failure })
+    }
+    const workspace = this.hostCtx.workspaceRegistry.get(WorkspaceId(projectId))
+    if (workspace === undefined) throw new ControlSessionError('UNKNOWN_WORKSPACE')
+    if (canonicalRoot !== workspace.path) throw new ControlSessionError('PROJECT_ROOT_MISMATCH')
+    try {
+      if (await workspace.status() !== 'ok') throw new ControlSessionError('WORKSPACE_UNAVAILABLE')
+    } catch (failure) {
+      throw controlSessionFailure(failure, 'WORKSPACE_UNAVAILABLE')
+    }
+
+    // Authority is an explicit safety decision. The loop never grants it as a
+    // side effect of convenience dispatch.
+    const project = await this.openProject({
+      profileId: options.profileId,
+      workspaceId: projectId,
+      ...options.signal === undefined ? {} : { signal: options.signal },
+    })
+    const authority = this.authority.view(project.agent.session.events, projectId)
+    if (authority.status === 'none') throw new ControlSessionError('AUTHORITY_NOT_BOUND')
+    if (authority.status === 'expired') throw new ControlSessionError('AUTHORITY_EXPIRED')
+    if (authority.profileId !== options.profileId) throw new ControlSessionError('IDENTITY_INVALID')
+
+    const loopId = requestIdempotencyKeyHash === undefined
+      ? randomUUID()
+      : `devframe-loop:${requestIdempotencyKeyHash}`
+    const objectiveId = randomUUID()
+    const global = await this.openGlobal({
+      profileId: options.profileId,
+      ...options.signal === undefined ? {} : { signal: options.signal },
+    })
+    this.appendLoopChange(global.agent.session, {
+      schemaVersion: 1,
+      kind: 'loop',
+      version: 1,
+      operation: 'start',
+      loopId,
+      objectiveId,
+      projectId,
+      ...requestIdempotencyKeyHash === undefined ? {} : { requestIdempotencyKeyHash },
+      changedAt: Date.now(),
+    })
+    await this.flushLoopStage(global.agent.session, options.signal, loopId, objectiveId, projectId)
+    let route: RouteObjectiveResult
+    try {
+      route = await this.routeObjective({
+        profileId: options.profileId,
+        objective,
+        objectiveId,
+        workspaceId: projectId,
+        ...options.signal === undefined ? {} : { signal: options.signal },
+      })
+    } catch (failure) {
+      await this.terminateLoop(global.agent.session, loopId, objectiveId, projectId, options.signal?.aborted ? 'aborted' : 'failed')
+      if (options.signal?.aborted) throw failure
+      throw controlSessionFailure(failure, 'DURABILITY_FAILED')
+    }
+    this.appendLoopChange(global.agent.session, {
+      schemaVersion: 1,
+      kind: 'loop',
+      version: 1,
+      operation: 'route',
+      loopId,
+      objectiveId: route.objectiveId,
+      projectId,
+      changedAt: Date.now(),
+    })
+    this.appendMemoryChange(global.agent.session, {
+      schemaVersion: 1,
+      kind: 'memory',
+      version: 1,
+      operation: 'bound',
+      loopId,
+      projectId,
+      status: 'unknown',
+      changedAt: Date.now(),
+    })
+    await this.flushLoopStage(global.agent.session, options.signal, loopId, route.objectiveId, projectId)
+
+    let memoryStatus: DevFrameMemoryStatus = 'unknown'
+    let memoryRecall: MemoryRecallResult | undefined
+    try {
+      const recall: MemoryRecallRequest = {
+        projectId,
+        projectRoot: canonicalRoot,
+        ...options.signal === undefined ? {} : { signal: options.signal },
+      }
+      const recalled = await this.memoryGateway.recallProjectPlan(recall)
+      memoryRecall = recalled
+      memoryStatus = recalled.status
+      this.memoryHealth = 'ready'
+      this.appendMemoryChange(global.agent.session, {
+        schemaVersion: 1,
+        kind: 'memory',
+        version: 1,
+        operation: 'recall',
+        loopId,
+        projectId,
+        status: recalled.status,
+        changedAt: Date.now(),
+      })
+    } catch (failure) {
+      try {
+        options.signal?.throwIfAborted()
+      } catch (abortFailure) {
+        await this.terminateLoop(global.agent.session, loopId, route.objectiveId, projectId, 'aborted')
+        throw abortFailure
+      }
+      memoryStatus = failure instanceof MemoryGatewayError ? 'unavailable' : 'failed'
+      this.memoryHealth = 'blocked'
+      this.hostCtx.logger.warn(`devframe memory: recall degraded (${memoryStatus})`)
+      this.appendMemoryChange(global.agent.session, {
+        schemaVersion: 1,
+        kind: 'memory',
+        version: 1,
+        operation: 'recall',
+        loopId,
+        projectId,
+        status: memoryStatus,
+        changedAt: Date.now(),
+      })
+    }
+    this.appendLoopChange(global.agent.session, {
+      schemaVersion: 1,
+      kind: 'loop',
+      version: 1,
+      operation: 'memory-recall',
+      loopId,
+      objectiveId: route.objectiveId,
+      projectId,
+      changedAt: Date.now(),
+    })
+    await this.flushLoopStage(global.agent.session, options.signal, loopId, route.objectiveId, projectId)
+
+    let projectTrace: DevFrameProjectGoalDispatchTrace
+    try {
+      projectTrace = await this.dispatchProjectGoal({
+        profileId: options.profileId,
+        projectId,
+        projectRoot: canonicalRoot,
+        objectiveId: route.objectiveId,
+        maxGoalRounds,
+        ...memoryRecall === undefined ? {} : { memoryRecall },
+        ...options.signal === undefined ? {} : { signal: options.signal },
+      })
+    } catch (failure) {
+      await this.terminateLoop(
+        global.agent.session,
+        loopId,
+        route.objectiveId,
+        projectId,
+        options.signal?.aborted ? 'aborted' : 'failed',
+      )
+      if (options.signal?.aborted) throw failure
+      throw controlSessionFailure(failure, 'DURABILITY_FAILED')
+    }
+
+    this.appendLoopChange(global.agent.session, {
+      schemaVersion: 1,
+      kind: 'loop',
+      version: 1,
+      operation: 'dispatch',
+      loopId,
+      objectiveId: route.objectiveId,
+      projectId,
+      projectSessionId: projectTrace.sessionId,
+      changedAt: Date.now(),
+    })
+    // A bounded Project Goal completion is execution evidence only. The
+    // independent reviewer/evaluation path owns acceptance; until it is
+    // attached to this convenience loop, expose an explicit pending state
+    // instead of manufacturing a passing review from the executor outcome.
+    const review = projectTrace.outcome === 'completed' ? 'pending' : 'failed'
+    this.appendLoopChange(global.agent.session, {
+      schemaVersion: 1,
+      kind: 'loop',
+      version: 1,
+      operation: 'review',
+      loopId,
+      objectiveId: route.objectiveId,
+      projectId,
+      projectSessionId: projectTrace.sessionId,
+      outcome: projectTrace.outcome,
+      review,
+      changedAt: Date.now(),
+    })
+    await this.flushLoopStage(global.agent.session, options.signal, loopId, route.objectiveId, projectId)
+    if (projectTrace.outcome === 'completed') {
+      void this.startProjectLoopReview({
+        profileId: options.profileId,
+        projectId,
+        loopId,
+        objectiveId: route.objectiveId,
+        projectTrace,
+      }).catch((failure: unknown) => {
+        this.hostCtx.logger.warn(`devframe loop review dispatch failed: ${String(failure)}`)
+      })
+    }
+
+    const idempotencyKey = createHash('sha256').update(loopId).digest('hex')
+    this.appendMemoryChange(global.agent.session, {
+      schemaVersion: 1,
+      kind: 'memory',
+      version: 1,
+      operation: 'write-requested',
+      loopId,
+      projectId,
+      status: 'unknown',
+      idempotencyKeyHash: idempotencyKey,
+      changedAt: Date.now(),
+    })
+    await this.flushLoopStage(global.agent.session, options.signal, loopId, route.objectiveId, projectId)
+    try {
+      const checkpoint: MemoryCheckpointRequest = {
+        projectId,
+        projectRoot: canonicalRoot,
+        idempotencyKey,
+        sessionId: projectTrace.sessionId,
+        goal: objective,
+        outcome: projectTrace.outcome,
+        ...options.signal === undefined ? {} : { signal: options.signal },
+      }
+      const written = await this.memoryGateway.captureProjectCheckpoint(checkpoint)
+      memoryStatus = written.status
+      this.memoryHealth = 'ready'
+      this.appendMemoryChange(global.agent.session, {
+        schemaVersion: 1,
+        kind: 'memory',
+        version: 1,
+        operation: 'write-committed',
+        loopId,
+        projectId,
+        status: written.status,
+        idempotencyKeyHash: idempotencyKey,
+        ...written.memoryId === undefined ? {} : { memoryId: written.memoryId },
+        changedAt: Date.now(),
+      })
+    } catch (failure) {
+      try {
+        options.signal?.throwIfAborted()
+      } catch (abortFailure) {
+        await this.terminateLoop(global.agent.session, loopId, route.objectiveId, projectId, 'aborted')
+        throw abortFailure
+      }
+      memoryStatus = failure instanceof MemoryGatewayError ? 'unavailable' : 'failed'
+      this.memoryHealth = 'blocked'
+      this.hostCtx.logger.warn(`devframe memory: checkpoint degraded (${memoryStatus})`)
+      this.appendMemoryChange(global.agent.session, {
+        schemaVersion: 1,
+        kind: 'memory',
+        version: 1,
+        operation: failure instanceof MemoryGatewayError && failure.code === 'unavailable'
+          ? 'write-unavailable' : 'write-failed',
+        loopId,
+        projectId,
+        status: memoryStatus,
+        idempotencyKeyHash: idempotencyKey,
+        changedAt: Date.now(),
+      })
+    }
+    this.appendLoopChange(global.agent.session, {
+      schemaVersion: 1,
+      kind: 'loop',
+      version: 1,
+      operation: 'checkpoint',
+      loopId,
+      objectiveId: route.objectiveId,
+      projectId,
+      projectSessionId: projectTrace.sessionId,
+      outcome: projectTrace.outcome,
+      review,
+      changedAt: Date.now(),
+    })
+    this.appendLoopChange(global.agent.session, {
+      schemaVersion: 1,
+      kind: 'loop',
+      version: 1,
+      operation: 'complete',
+      loopId,
+      objectiveId: route.objectiveId,
+      projectId,
+      projectSessionId: projectTrace.sessionId,
+      outcome: projectTrace.outcome,
+      review,
+      changedAt: Date.now(),
+    })
+    await this.flushLoopStage(global.agent.session, options.signal, loopId, route.objectiveId, projectId)
+    return {
+      loopId,
+      objectiveId: route.objectiveId,
+      projectId,
+      projectSessionId: projectTrace.sessionId,
+      goalId: projectTrace.goalId,
+      revision: projectTrace.revision,
+      round: projectTrace.round,
+      roundsCompleted: projectTrace.roundsCompleted,
+      sessionId: projectTrace.sessionId,
+      ...projectTrace.parentSessionId === undefined ? {} : { parentSessionId: projectTrace.parentSessionId },
+      provider: projectTrace.provider,
+      model: projectTrace.model,
+      outcome: projectTrace.outcome,
+      review,
+      memoryStatus,
+    }
+  }
+
+  private appendLoopChange(session: Session, change: SessionEventMap['devframe/loop']): void {
+    session.append(LOOP_CHANGE_EVENT_TYPE, change)
+  }
+
+  private appendMemoryChange(session: Session, change: SessionEventMap['devframe/memory']): void {
+    session.append(MEMORY_CHANGE_EVENT_TYPE, change)
+  }
+
+  private async terminateLoop(
+    session: Session,
+    loopId: string,
+    objectiveId: string,
+    projectId: string,
+    outcome: 'failed' | 'aborted',
+  ): Promise<void> {
+    this.appendLoopChange(session, {
+      schemaVersion: 1,
+      kind: 'loop',
+      version: 1,
+      operation: 'fail',
+      loopId,
+      objectiveId,
+      projectId,
+      outcome,
+      review: 'failed',
+      changedAt: Date.now(),
+    })
+    await this.flushLoopSession(session, undefined).catch(() => undefined)
+  }
+
+  private async flushLoopStage(
+    session: Session,
+    signal: AbortSignal | undefined,
+    loopId: string,
+    objectiveId: string,
+    projectId: string,
+  ): Promise<void> {
+    try {
+      await this.flushLoopSession(session, signal)
+    } catch (failure) {
+      if (signal?.aborted) {
+        await this.terminateLoop(session, loopId, objectiveId, projectId, 'aborted')
+      }
+      throw failure
+    }
+  }
+
+  private async flushLoopSession(session: Session, signal: AbortSignal | undefined): Promise<void> {
+    signal?.throwIfAborted()
+    if (!await this.hostCtx.sessions.flush(session)) throw new ControlSessionError('DURABILITY_FAILED')
+  }
+
+  /**
+   * CAS-guard one Host bind of project write authority and resolve only after
+   * the appended bound event is durable. The controller session is opened
+   * through the ready path, so identity validation runs before any append.
+   * @param options - profile identity, Workspace id, expected revision, optional expiry.
+   * @returns the pathless authority view once durable.
+   */
+  async bindProjectAuthority(options: {
+    readonly profileId: string
+    readonly workspaceId: string
+    readonly expectedBoundRevision: number
+    readonly expiresAt?: number
+    readonly signal?: AbortSignal
+  }): Promise<DevFrameProjectAuthorityView> {
+    const result = await this.openProject({
+      profileId: options.profileId,
+      workspaceId: options.workspaceId,
+      ...options.signal === undefined ? {} : { signal: options.signal },
+    })
+    return await this.authority.bind({
+      session: result.agent.session,
+      expectedBoundRevision: options.expectedBoundRevision,
+      profileId: options.profileId,
+      workspaceId: options.workspaceId,
+      ...options.expiresAt === undefined ? {} : { expiresAt: options.expiresAt },
+      ...options.signal === undefined ? {} : { signal: options.signal },
+      flush: session => this.hostCtx.sessions.flush(session),
+    })
+  }
+
+  /**
+   * Fold the pathless authority projection of one controller session id.
+   * A live ready session is folded directly; a cold project id is restored or
+   * created through the standard open path (no extra read path).
+   * @param sessionId - the Project Controller session id.
+   * @returns the current pathless authority view.
+   */
+  async projectAuthorityView(sessionId: SessionId): Promise<DevFrameProjectAuthorityView> {
+    const prefix = 'devframe-controller:'
+    const idText = String(sessionId)
+    if (!idText.startsWith(prefix)) throw new ControlSessionError('UNKNOWN_WORKSPACE')
+    const workspaceId = idText.slice(prefix.length)
+    const ready = this.ready.get(sessionId)
+    if (ready !== undefined) {
+      return this.authority.view(ready.result.agent.session.events, workspaceId)
+    }
+    const workspace = this.hostCtx.workspaceRegistry.get(WorkspaceId(workspaceId))
+    if (workspace === undefined) throw new ControlSessionError('UNKNOWN_WORKSPACE')
+    const identity = this.hostCtx.get(PROFILE_IDENTITY_KEY) as HostProfileIdentity | undefined
+    if (identity === undefined) throw new ControlSessionError('PROFILE_IDENTITY_UNAVAILABLE')
+    const result = await this.open({
+      role: 'project',
+      profileId: identity.id,
+      cwd: workspace.path,
+      workspace,
+      sessionId,
+    })
+    return this.authority.view(result.agent.session.events, workspaceId)
+  }
+
+  /**
+   * Dispatch one direct human objective through the existing Goal Round driver
+   * in a fresh child Run Session.
+   *
+   * The stable Global Controller remains the parent anchor. Goal creation and
+   * the admitted Goal Round are durable events in the child session; only a
+   * compact `controller/run-summary` is appended to the parent so later runs
+   * do not inherit the previous run's transcript.
+   * @param options - bounded objective, profile identity, and optional cancellation signal.
+   * @returns a pathless trace after the child Run and parent summary flushes complete.
+   */
+  async dispatchGlobalGoal(options: DispatchGlobalGoalOptions): Promise<DevFrameGoalDispatchTrace> {
+    const objective = typeof options.objective === 'string' ? options.objective.trim() : ''
+    if (objective.length === 0) throw new ControlSessionError('GOALS_UNAVAILABLE')
+    if (options.maxGoalRounds !== undefined && options.maxGoalRounds !== 1) {
+      throw new ControlSessionError('INVALID_GOAL_BUDGET')
+    }
+    const model = this.resolveModelOptions()
+    const goals = this.hostCtx.get('goals')
+    if (goals === undefined || this.hostCtx.get('agentLoop') === undefined) {
+      throw new ControlSessionError('MODEL_UNAVAILABLE')
+    }
+    const controller = await this.openGlobal({
+      profileId: options.profileId,
+      ...options.signal === undefined ? {} : { signal: options.signal },
+    })
+    if (controller.agent.options.provider !== model.provider || controller.agent.options.model !== model.model) {
+      // A controller opened without a configured route cannot be upgraded in
+      // place: fail closed instead of silently dispatching through an empty or
+      // stale model identity.
+      throw new ControlSessionError('MODEL_UNAVAILABLE')
+    }
+
+    // The stable Controller is an anchor and coordinator, not an ever-growing
+    // model transcript.  Every bounded automatic task gets a fresh child
+    // session whose native parentSession points back to that anchor.
+    const run = await this.createGlobalRun(controller, model, options.signal)
+    try {
+      const trace = await this.dispatchGoal(run, objective, options.signal, model, 1)
+      const isolatedTrace: DevFrameGoalDispatchTrace = {
+        ...trace,
+        parentSessionId: controller.id,
+      }
+      await this.appendRunSummary(controller.agent.session, isolatedTrace)
+      return isolatedTrace
+    } finally {
+      await run.handle.dispose()
+    }
+  }
+
+  /**
+   * Create one fresh Global Run Session without copying any Controller
+   * messages.  The parentSession header is the only lineage link.
+   * @param parent - stable Global Controller anchor.
+   * @param model - already validated provider/model route.
+   * @param signal - optional caller cancellation.
+   * @returns the child run as a ControlSessionResult plus its owner handle.
+   */
+  private async createGlobalRun(
+    parent: ControlSessionResult,
+    model: Required<Pick<AgentOptions, 'provider' | 'model'>>,
+    signal?: AbortSignal,
+  ): Promise<ControlSessionResult & { readonly handle: AgentHandle }> {
+    const sessionId = newControllerRunSessionId()
+    try {
+      const handle = await this.hostCtx.agents.create({
+        sessionId,
+        meta: {
+          ...parent.agent.session.header.cwd === undefined ? {} : { cwd: parent.agent.session.header.cwd },
+          parentSession: parent.id,
+          origin: 'subagent',
+          delegationDepth: 1,
+        },
+        agentOptions: model,
+        ...signal === undefined ? {} : { signal },
+        setup: agentCtx => configureGlobalRunAgent(agentCtx),
+      })
+      return {
+        id: sessionId,
+        role: 'global',
+        agent: handle.agent,
+        handle,
+      }
+    } catch (failure) {
+      throw controlSessionFailure(failure, 'DURABILITY_FAILED')
+    }
+  }
+
+  /**
+   * Write only a compact, pathless index to the stable Controller Session.
+   * The child transcript is never copied into the parent log.
+   * @param parentSession - stable Controller Session receiving the index.
+   * @param trace - settled isolated Run trace.
+   * @returns after the summary event is durable.
+   */
+  private async appendRunSummary(parentSession: Session, trace: DevFrameGoalDispatchTrace): Promise<void> {
+    const parentSessionId = trace.parentSessionId
+    if (parentSessionId === undefined) throw new ControlSessionError('IDENTITY_INVALID')
+    const summary: ControllerRunSummaryV1 = {
+      schemaVersion: 1,
+      runSessionId: trace.sessionId,
+      parentSessionId,
+      goalId: trace.goalId,
+      revision: trace.revision,
+      round: trace.round,
+      roundsCompleted: trace.roundsCompleted,
+      provider: trace.provider,
+      model: trace.model,
+      outcome: trace.outcome,
+      completedAt: Date.now(),
+    }
+    parentSession.append(CONTROLLER_RUN_SUMMARY_EVENT_TYPE, summary)
+    if (!await this.hostCtx.sessions.flush(parentSession)) {
+      throw new ControlSessionError('DURABILITY_FAILED')
+    }
+  }
+
+  /**
+   * Remote dispatch face for the browser surface. The profile identity is
+   * taken from the Host context, never from the caller — the browser cannot
+   * forge which profile owns the dispatch (same pattern as
+   * `remoteBindProjectAuthority`). The `objectiveId` must reference an
+   * objective already routed to the target workspace (design §10.4/10.5).
+   * @param request - project id/root, routed objective id, and bounded budget.
+   * @param signal - transport cancellation.
+   * @returns the pathless dispatch trace once durable.
+   */
+  @Remote('dispatchProjectGoal')
+  async remoteDispatchProjectGoal(
+    request: {
+      projectId: string
+      projectRoot: string
+      objectiveId: string
+      maxGoalRounds?: number
+    },
+    signal: AbortSignal,
+  ): Promise<DevFrameProjectGoalDispatchTrace> {
+    signal.throwIfAborted()
+    const identity = this.hostCtx.get(PROFILE_IDENTITY_KEY) as HostProfileIdentity | undefined
+    if (identity === undefined) throw new ControlSessionError('PROFILE_IDENTITY_UNAVAILABLE')
+    return await this.dispatchProjectGoal({
+      profileId: identity.id,
+      projectId: request.projectId,
+      projectRoot: request.projectRoot,
+      objectiveId: request.objectiveId,
+      ...request.maxGoalRounds === undefined ? {} : { maxGoalRounds: request.maxGoalRounds },
+      signal,
+    })
+  }
+
+  /**
+   * Dispatch one bounded objective through a project-scoped Agent.
+   *
+   * Slice 1A: the authority gate (bound → unexpired → matching identity) and
+   * the objective route gate (routed to this exact workspace) run before the
+   * native Goal Round driver is entered. The identity-only {@link openProject}
+   * path stays available regardless of authority state.
+   * @param options - project identity, expected root, objective, and signal.
+   * @returns a pathless trace after the native Session flush succeeds.
+   */
+  async dispatchProjectGoal(options: DispatchProjectGoalOptions): Promise<DevFrameProjectGoalDispatchTrace> {
+    // The objective text may come from the caller (CLI/task runner) or be
+    // omitted (browser remote: the routed objective record owns the text, so
+    // the caller never re-sends it — design §10.4). Structural length checks
+    // run here; presence is finalized after the objective fold below.
+    const callerObjective = typeof options.objective === 'string' ? options.objective.trim() : ''
+    if (callerObjective.length > OBJECTIVE_MAX_TEXT_LENGTH) {
+      throw new ControlSessionError('OBJECTIVE_INVALID')
+    }
+    const maxGoalRounds = options.maxGoalRounds ?? 1
+    if (maxGoalRounds !== 1 && maxGoalRounds !== 2) {
+      throw new ControlSessionError('INVALID_GOAL_BUDGET')
+    }
+    const projectId = requireIdPart(options.projectId)
+    const projectRoot = typeof options.projectRoot === 'string' ? options.projectRoot.trim() : ''
+    if (projectRoot.length === 0) throw new ControlSessionError('INVALID_PROJECT_ROOT')
+    let canonicalRoot: string
+    try {
+      canonicalRoot = await canonicalizeWatchPath(projectRoot)
+    } catch (failure) {
+      throw new ControlSessionError('INVALID_PROJECT_ROOT', { cause: failure })
+    }
+    const workspace = this.hostCtx.workspaceRegistry.get(WorkspaceId(projectId))
+    if (workspace === undefined) throw new ControlSessionError('UNKNOWN_WORKSPACE')
+    if (canonicalRoot !== workspace.path) throw new ControlSessionError('PROJECT_ROOT_MISMATCH')
+    let status: Awaited<ReturnType<Workspace['status']>>
+    try {
+      status = await workspace.status()
+    } catch (failure) {
+      throw controlSessionFailure(failure, 'WORKSPACE_UNAVAILABLE')
+    }
+    if (status !== 'ok') throw new ControlSessionError('WORKSPACE_UNAVAILABLE')
+
+    const model = this.resolveModelOptions()
+    const goals = this.hostCtx.get('goals')
+    if (goals === undefined || this.hostCtx.get('agentLoop') === undefined) {
+      throw new ControlSessionError('MODEL_UNAVAILABLE')
+    }
+    const controller = await this.openProject({
+      profileId: options.profileId,
+      workspaceId: projectId,
+      ...options.signal === undefined ? {} : { signal: options.signal },
+    })
+    if (controller.agent.options.provider !== model.provider || controller.agent.options.model !== model.model) {
+      throw new ControlSessionError('MODEL_UNAVAILABLE')
+    }
+    // Slice 1A authority gate (design §10.5, steps 2-4): project write
+    // dispatch requires a bound, unexpired authority for this exact profile.
+    // The service view excludes pending (appended-but-not-durable) bounds, so
+    // a phantom bound can never admit dispatch.
+    const authority = this.authority.view(controller.agent.session.events, projectId)
+    if (authority.status === 'none') throw new ControlSessionError('AUTHORITY_NOT_BOUND')
+    if (authority.status === 'expired') throw new ControlSessionError('AUTHORITY_EXPIRED')
+    if (authority.profileId !== options.profileId) throw new ControlSessionError('IDENTITY_INVALID')
+    // Slice 1A-D objective routing (design §10.5, step 5): the dispatched
+    // objective must exist in the Global Controller log and be routed to THIS
+    // exact project. The fold reads only durable objective records; nothing is
+    // guessed from the objective text (hard stop §10.8).
+    const global = await this.openGlobal({
+      profileId: options.profileId,
+      ...options.signal === undefined ? {} : { signal: options.signal },
+    })
+    const folded = foldObjective(global.agent.session.events, options.objectiveId)
+    if (folded.status !== 'routed') throw new ControlSessionError('OBJECTIVE_INVALID')
+    if (folded.workspaceId !== projectId) throw new ControlSessionError('CROSS_PROJECT_OBJECTIVE')
+    const objective = callerObjective.length > 0 ? callerObjective : folded.text
+    if (objective.length === 0 || objective.length > OBJECTIVE_MAX_TEXT_LENGTH) {
+      throw new ControlSessionError('OBJECTIVE_INVALID')
+    }
+    const recalledMessage = options.memoryRecall === undefined
+      ? undefined
+      : createMemoryRecallMessage(options.memoryRecall)
+    if (recalledMessage !== undefined) controller.agent.inject(recalledMessage)
+    const trace = await this.dispatchGoal(
+      controller,
+      objective,
+      options.signal,
+      model,
+      maxGoalRounds,
+      (goal) => {
+        // Design §10.4: right after the Goal is created, record the thin
+        // append-only Objective→Run association in the Project Controller log
+        // so restart replay can rebuild the "goal → run" chain in-log.
+        // If the dispatch then fails (timeout/cancel) before the final flush,
+        // this association rides the next full-session flush — it references
+        // a goal that never ran, which is semantically benign and in-log
+        // consistent (review note P2#5: documented, not a correctness issue).
+        controller.agent.session.append(PROJECT_RUN_EVENT_TYPE, {
+          schemaVersion: 1,
+          objectiveId: options.objectiveId,
+          goalId: goal.id,
+          revision: goal.revision,
+        })
+      },
+    )
+    return { ...trace, projectId, objectiveId: options.objectiveId }
+  }
+
+  /** Drive the native Goal Round lifecycle shared by Global and Project calls. */
+  private async dispatchGoal(
+    controller: ControlSessionResult,
+    objective: string,
+    signal: AbortSignal | undefined,
+    model: Required<Pick<AgentOptions, 'provider' | 'model'>>,
+    maxGoalRounds: 1 | 2,
+    onGoalCreated?: (goal: { readonly id: string; readonly revision: number }) => void,
+  ): Promise<DevFrameGoalDispatchTrace> {
+    const beforeSeq = controller.agent.session.seq
+    const turnEnds: SessionEvent<'turn/end'>[] = []
+    const turnEnd = Promise.withResolvers<SessionEvent<'turn/end'>>()
+    const disposeEvent = this.hostCtx.on('session/event', (session, event) => {
+      if (session !== controller.agent.session || event.seq <= beforeSeq || event.type !== 'turn/end') return
+      turnEnds.push(event)
+      if (event.data.reason.kind !== 'completed' || turnEnds.length >= maxGoalRounds) turnEnd.resolve(event)
+    })
+    const timeoutSignal = AbortSignal.timeout(DISPATCH_TIMEOUT_PER_ROUND_MS * maxGoalRounds)
+    const dispatchSignal = signal === undefined
+      ? timeoutSignal
+      : AbortSignal.any([signal, timeoutSignal])
+    let goal
+    let lifecycleSettled = false
+    try {
+      dispatchSignal.throwIfAborted()
+      const goals = this.hostCtx.get('goals')
+      if (goals === undefined) throw new ControlSessionError('GOALS_UNAVAILABLE')
+      const current = goals.get(controller.agent)
+      if (current !== undefined && current.phase !== 'complete') {
+        // A prior bounded invocation can leave its durable goal blocked or
+        // paused after reaching its cap, cancellation, or a driver failure.
+        // A new explicit task may close that historical goal before creating
+        // its own; an armed active goal still owns the Agent and must not be
+        // silently replaced by a concurrent caller.
+        const recoverable = current.phase === 'blocked'
+          || current.phase === 'paused'
+          || current.activation === 'disarmed'
+        if (!recoverable) throw new ControlSessionError('GOALS_UNAVAILABLE')
+        goals.complete(controller.agent, { id: current.id, revision: current.revision })
+      }
+      goal = goals.create(controller.agent, { objective, maxGoalRounds })
+      onGoalCreated?.(goal)
+      let onAbort: (() => void) | undefined
+      const abortPromise = new Promise<never>((_resolve, reject) => {
+        onAbort = (): void => {
+          const reason: unknown = dispatchSignal.reason
+          reject(reason instanceof Error
+            ? reason
+            : new Error('Global Goal dispatch aborted', { cause: reason }))
+        }
+        dispatchSignal.addEventListener('abort', onAbort, { once: true })
+      })
+      const ended = await Promise.race([
+        turnEnd.promise,
+        abortPromise,
+      ])
+      lifecycleSettled = true
+      if (onAbort !== undefined) dispatchSignal.removeEventListener('abort', onAbort)
+      await controller.agent.whenIdle()
+      if (!await this.hostCtx.sessions.flush(controller.agent.session)) {
+        throw new ControlSessionError('DURABILITY_FAILED')
+      }
+      if (ended.data.reason.kind === 'aborted') {
+        return this.dispatchTrace(controller.agent, goal, 'aborted', model, turnEnds.length)
+      }
+      if (ended.data.reason.kind === 'completed') {
+        return this.dispatchTrace(controller.agent, goal, 'completed', model, turnEnds.length)
+      }
+      return this.dispatchTrace(controller.agent, goal, 'failed', model, turnEnds.length)
+    } catch (failure) {
+      if (goal !== undefined && !lifecycleSettled) {
+        controller.agent.cancel({ kind: 'parent' })
+        await controller.agent.whenIdle().catch(() => undefined)
+      }
+      if (dispatchSignal.aborted) {
+        const code = timeoutSignal.aborted && !(signal?.aborted ?? false)
+          ? 'DISPATCH_TIMEOUT'
+          : 'DISPATCH_CANCELLED'
+        throw new ControlSessionError(code, { cause: failure })
+      }
+      throw controlSessionFailure(failure, 'DURABILITY_FAILED')
+    } finally {
+      disposeEvent()
+    }
+  }
+
+  /** Resolve the configured model route used by newly opened controllers. */
+  private resolveModelOptions(): Required<Pick<AgentOptions, 'provider' | 'model'>> {
+    const defaults = this.hostCtx.get('agentDefaultModel')
+    if (defaults === undefined) throw new ControlSessionError('MODEL_UNAVAILABLE')
+    const selection = defaults.currentSelection()
+    if (selection.provider.length === 0 || selection.model.length === 0) {
+      throw new ControlSessionError('MODEL_UNAVAILABLE')
+    }
+    return { provider: selection.provider, model: selection.model }
+  }
+
+  /** Build a detached, pathless trace from the settled Goal Round turn. */
+  private dispatchTrace(
+    agent: Agent,
+    goal: {
+      readonly id: string
+      readonly revision: number
+      readonly phase: 'active' | 'paused' | 'blocked' | 'complete'
+      readonly roundsStarted: number
+      readonly maxGoalRounds: number
+    },
+    status: 'completed' | 'failed' | 'aborted',
+    model: Required<Pick<AgentOptions, 'provider' | 'model'>>,
+    roundsCompleted: number,
+  ): DevFrameGoalDispatchTrace {
+    const header = agent.session.events.findLast(event => event.type === 'request/header')
+    const provider = header?.type === 'request/header' ? header.data.header.config.provider : model.provider
+    const modelId = header?.type === 'request/header' ? header.data.header.config.model : model.model
+    return {
+      goalId: goal.id,
+      revision: goal.revision,
+      round: roundsCompleted,
+      roundsCompleted,
+      sessionId: agent.session.id,
+      provider,
+      model: modelId,
+      outcome: status,
+    }
+  }
+
+  /**
+   * Open the stable Global Controller for one provisioned profile.
+   * @param options - Explicit persistent profile identity and cancellation.
+   * @returns the ready identity-only controller.
+   */
+  async openGlobal(options: OpenGlobalControllerOptions): Promise<ControlSessionResult> {
+    if (this.bootstrap?.stopping) throw new ControlSessionError('HOST_STOPPING')
+    const profileId = requireIdPart(options.profileId)
+    let cwd: string
+    try {
+      cwd = await canonicalizeWatchPath(dshHomePath('devframe-control'))
+    } catch (failure) {
+      throw new ControlSessionError('CONTROL_CWD_UNAVAILABLE', { cause: failure })
+    }
+    if (this.hostCtx.workspaceRegistry.list().some(workspace => pathsOverlap(cwd, workspace.path))) {
+      throw new ControlSessionError('GLOBAL_CWD_CONFLICT')
+    }
+    try {
+      // The controller directory is a Host-owned tool root, not a project
+      // checkout. Create it only after the overlap check so a misconfigured
+      // DSH_HOME cannot silently write inside a registered workspace.
+      await mkdir(cwd, { recursive: true })
+      cwd = await canonicalizeWatchPath(cwd)
+    } catch (failure) {
+      throw new ControlSessionError('CONTROL_CWD_UNAVAILABLE', { cause: failure })
+    }
+    if (this.hostCtx.workspaceRegistry.list().some(workspace => pathsOverlap(cwd, workspace.path))) {
+      throw new ControlSessionError('GLOBAL_CWD_CONFLICT')
+    }
+    const result = await this.open({
+      role: 'global',
+      profileId,
+      cwd,
+      sessionId: globalControllerSessionId(profileId),
+    }, options.signal)
+    const recoveryKey = String(result.id)
+    if (!this.revisionRecoveries.has(recoveryKey)) {
+      this.revisionRecoveries.add(recoveryKey)
+      try {
+        await this.recoverPendingRevisions(result.agent.session, profileId)
+      } catch (failure) {
+        this.hostCtx.logger.warn(`devframe review recovery blocked: ${String(failure)}`)
+      }
+    }
+    return result
+  }
+
+  /**
+   * Serialize and commit one preset switch for the exact Host-owned Global
+   * Controller. Unknown or broken presets leave the composition and event log
+   * unchanged. A restriction refresh failure rolls back when possible and
+   * otherwise leaves the scoped tool face fail-closed.
+   * @param options - profile identity, requested preset, and cancellation.
+   * @returns the committed preset id.
+   */
+  async selectGlobalPreset(options: SelectGlobalPresetOptions): Promise<{ agentPreset: string }> {
+    const profileId = requireIdPart(options.profileId)
+    const agentPreset = requireIdPart(options.agentPreset)
+    const sessionId = globalControllerSessionId(profileId)
+    const prior = this.presetSwitches.get(sessionId) ?? Promise.resolve({ agentPreset })
+    const next = prior.then(
+      () => this.selectGlobalPresetNow({
+        profileId,
+        agentPreset,
+        ...options.signal === undefined ? {} : { signal: options.signal },
+      }),
+      () => this.selectGlobalPresetNow({
+        profileId,
+        agentPreset,
+        ...options.signal === undefined ? {} : { signal: options.signal },
+      }),
+    ).finally(() => {
+      if (this.presetSwitches.get(sessionId) === next) this.presetSwitches.delete(sessionId)
+    })
+    this.presetSwitches.set(sessionId, next)
+    return await next
+  }
+
+  private async selectGlobalPresetNow(
+    options: SelectGlobalPresetOptions,
+  ): Promise<{ agentPreset: string }> {
+    options.signal?.throwIfAborted()
+    const controller = await this.openGlobal({
+      profileId: options.profileId,
+      ...options.signal === undefined ? {} : { signal: options.signal },
+    })
+    const agent = controller.agent
+    const presets = this.hostCtx.get('agentPresets')
+    if (presets === undefined) throw new ControlSessionError('PRESET_UNAVAILABLE')
+
+    // runMaintenance reserves the exact idle phase before any async recompose;
+    // followups sent during this window are latched by ReactLoopAgent and
+    // replayed only after the composition, tool face, and event commit settle.
+    return await runControllerMaintenance(agent, async (maintenanceSignal) => {
+      const merged = mergeControllerSignals(options.signal, maintenanceSignal)
+      try {
+        merged.signal.throwIfAborted()
+        const state = CONTROLLER_TOOL_FACES.get(agent)
+        if (state === undefined) throw new ControlSessionError('PRESET_UNAVAILABLE')
+        if (state.presetId === options.agentPreset) {
+          return { agentPreset: state.presetId }
+        }
+
+        let recomposed = false
+        try {
+          const mounted = await presets.recompose(agent.ctx, options.agentPreset)
+          if (mounted.id !== options.agentPreset) throw new ControlSessionError('PRESET_UNAVAILABLE')
+          recomposed = true
+          merged.signal.throwIfAborted()
+          replaceControllerRestriction(agent.ctx, agent, state)
+          merged.signal.throwIfAborted()
+          agent.session.append('agent-preset/selected', { agentPreset: mounted.id })
+          state.presetId = mounted.id
+          return { agentPreset: mounted.id }
+        } catch (failure) {
+          if (!recomposed) throw controlSessionFailure(failure, 'PRESET_UNAVAILABLE')
+          try {
+            await this.rollbackGlobalPreset(agent, state, options.agentPreset)
+          } catch (rollbackFailure) {
+            throw rollbackFailure instanceof ControlSessionError
+              ? rollbackFailure
+              : new ControlSessionError('PRESET_UNAVAILABLE', {
+                cause: new AggregateError([failure, rollbackFailure], 'Global Controller preset rollback failed'),
+              })
+          }
+          throw controlSessionFailure(failure, 'PRESET_UNAVAILABLE')
+        }
+      } finally {
+        merged.dispose()
+      }
+    })
+  }
+
+  private async rollbackGlobalPreset(
+    agent: Agent,
+    state: ControllerToolFaceState,
+    failedPreset: string,
+  ): Promise<void> {
+    // This is called only from the runMaintenance callback above. Rollback
+    // therefore shares the same reserved Agent boundary as the failed switch.
+    const presets = this.hostCtx.get('agentPresets')
+    if (presets === undefined) throw new ControlSessionError('PRESET_UNAVAILABLE')
+    const previousPreset = state.presetId
+    try {
+      await presets.recompose(agent.ctx, previousPreset)
+      replaceControllerRestriction(agent.ctx, agent, state)
+      state.presetId = previousPreset
+    } catch (failure) {
+      // replaceControllerRestriction already attempts allow: [] on refresh
+      // failure. Repeat it here after a recompose failure to keep the
+      // fail-closed invariant explicit at the rollback boundary.
+      try {
+        state.restriction()
+        state.restriction = agent.ctx.tools.restrict({ allow: [] })
+      } catch (failClosedFailure) {
+        throw new ControlSessionError('PRESET_UNAVAILABLE', {
+          cause: new AggregateError([failure, failClosedFailure], `failed to roll back preset ${failedPreset}`),
+        })
+      }
+      throw new ControlSessionError('PRESET_UNAVAILABLE', { cause: failure })
+    }
+  }
+
+  /**
+   * Open the stable Project Controller for one native DSH workspace.
+   * @param options - Explicit persistent profile and workspace identities.
+   * @returns the ready identity-only controller.
+   */
+  async openProject(options: OpenProjectControllerOptions): Promise<ControlSessionResult> {
+    const profileId = requireIdPart(options.profileId)
+    const workspaceId = requireIdPart(options.workspaceId)
+    const workspace = this.hostCtx.workspaceRegistry.get(WorkspaceId(workspaceId))
+    if (workspace === undefined) throw new ControlSessionError('UNKNOWN_WORKSPACE')
+    let status: Awaited<ReturnType<Workspace['status']>>
+    try {
+      status = await workspace.status()
+    } catch (failure) {
+      throw controlSessionFailure(failure, 'WORKSPACE_UNAVAILABLE')
+    }
+    if (status !== 'ok') throw new ControlSessionError('WORKSPACE_UNAVAILABLE')
+    await ensureProjectPresetAvailable(this.hostCtx)
+    return this.open({
+      role: 'project',
+      profileId,
+      cwd: workspace.path,
+      workspace,
+      sessionId: projectControllerSessionId(workspaceId),
+    }, options.signal)
+  }
+
+  /**
+   * Resolve and open the current governed Working Plan for one Workspace.
+   * All filesystem and native-app details remain Host-owned; callers receive
+   * only a bounded status projection.
+   */
+  async openMemory(options: OpenMemoryOptions): Promise<MemoryOpenResult> {
+    const workspaceId = requireIdPart(options.workspaceId)
+    const workspace = this.hostCtx.workspaceRegistry.get(WorkspaceId(workspaceId))
+    if (workspace === undefined) throw new ControlSessionError('UNKNOWN_WORKSPACE')
+    let status: Awaited<ReturnType<Workspace['status']>>
+    try {
+      status = await workspace.status()
+    } catch (failure) {
+      throw controlSessionFailure(failure, 'WORKSPACE_UNAVAILABLE')
+    }
+    if (status !== 'ok') throw new ControlSessionError('WORKSPACE_UNAVAILABLE')
+
+    let recalled: MemoryRecallResult
+    try {
+      recalled = await this.memoryGateway.recallProjectPlan({
+        projectId: workspaceId,
+        projectRoot: workspace.path,
+        ...options.signal === undefined ? {} : { signal: options.signal },
+      })
+      this.memoryHealth = 'ready'
+    } catch (_failure) {
+      try {
+        options.signal?.throwIfAborted()
+      } catch (abortFailure) {
+        throw abortFailure
+      }
+      this.memoryHealth = 'blocked'
+      this.hostCtx.logger.warn('devframe memory: open degraded (unavailable)')
+      return { opened: false, status: 'unavailable' }
+    }
+    if (recalled.status !== 'current') {
+      return { opened: false, status: recalled.status }
+    }
+    const target = memoryNoteUri(recalled.relativePath)
+    if (target === undefined) {
+      this.memoryHealth = 'blocked'
+      return { opened: false, status: 'unavailable' }
+    }
+    const apiProxy = this.hostCtx.get('apiProxy') as HostPathOpener | undefined
+    const openPath = apiProxy?.host?.openPath
+    if (openPath === undefined) {
+      this.memoryHealth = 'blocked'
+      return { opened: false, status: 'unavailable' }
+    }
+    const signal = options.signal ?? new AbortController().signal
+    try {
+      const response = await openPath({
+        rpcId: randomUUID(),
+        payload: { path: target },
+      }, signal)
+      if (!nativeOpenSucceeded(response)) {
+        this.memoryHealth = 'blocked'
+        return { opened: false, status: 'unavailable' }
+      }
+    } catch (failure) {
+      try {
+        options.signal?.throwIfAborted()
+      } catch (abortFailure) {
+        throw abortFailure
+      }
+      this.memoryHealth = 'blocked'
+      this.hostCtx.logger.warn(`devframe memory: native open degraded (${failure instanceof Error ? failure.name : 'error'})`)
+      return { opened: false, status: 'unavailable' }
+    }
+    return { opened: true, status: 'current' }
+  }
+
+  /**
+   * Open (resume or materialize) the stable Worker session for one registered
+   * Worker. Deliberately NOT routed through {@link open}: a
+   * Worker is an ordinary Session with no `controller/identity` event and no
+   * `validateControllerSession`, so the controller open path's identity
+   * invariants do not apply (design §11.2/§11.8). The path mirrors
+   * {@link restoreOrCreate}: try resume; when the session is absent, prepare a
+   * fresh session under the dedicated worker cwd, append the native
+   * `session/end-seed` seed-boundary marker as its only durable event (a
+   * fresh seedless Session is otherwise empty, and the persistence layer
+   * refuses to materialize an empty log), persist it, and resume again. The
+   * registration chain serializes creations per workerId, so no two opens can
+   * race the same id.
+   * @param worker - the durable roster view selecting the Worker capability
+   *   face and optional Workspace scope.
+   * @param signal - cancellation for load/setup and the durability flush.
+   * @returns the live Worker handle after its session flush reports durable.
+   */
+  private async openWorker(worker: RosterView, signal?: AbortSignal): Promise<AgentHandle> {
+    const workerId = requireIdPart(worker.workerId)
+    const sessionId = workerSessionId(workerId)
+    if (this.hostCtx.agents.get(sessionId) !== undefined
+      || this.hostCtx.sessions.get(sessionId) !== undefined) {
+      throw new ControlSessionError('LIVE_COLLISION')
+    }
+    const executionEnabled = worker.capabilities.includes(TASK_PAYLOAD_EXECUTE)
+    const reviewEnabled = worker.capabilities.includes(TASK_PAYLOAD_REVIEW)
+    const workspaceEnabled = executionEnabled || reviewEnabled
+    const configuredModel = workspaceEnabled ? this.resolveModelOptions() : this.optionalModelOptions()
+    let cwd: string
+    if (workspaceEnabled) {
+      if (worker.workspaceScope === undefined) throw new ControlSessionError('ROSTER_INVALID')
+      const workspace = this.hostCtx.workspaceRegistry.get(WorkspaceId(worker.workspaceScope))
+      if (workspace === undefined) throw new ControlSessionError('UNKNOWN_WORKSPACE')
+      try {
+        if (await workspace.status() !== 'ok') throw new ControlSessionError('WORKSPACE_UNAVAILABLE')
+        cwd = await canonicalizeWatchPath(workspace.path)
+      } catch (failure) {
+        throw controlSessionFailure(failure, 'WORKSPACE_UNAVAILABLE')
+      }
+    } else {
+      try {
+        cwd = await canonicalizeWatchPath(dshHomePath('devframe-worker'))
+      } catch (failure) {
+        throw new ControlSessionError('CONTROL_CWD_UNAVAILABLE', { cause: failure })
+      }
+    }
+    const setup = (agentCtx: Context): AgentSetupCommit | Promise<AgentSetupCommit> => (
+      configureWorkerAgent(this.hostCtx, agentCtx, worker)
+    )
+    let handle: AgentHandle
+    try {
+      handle = await this.hostCtx.agents.resume({
+        resumeSessionId: sessionId,
+        ...configuredModel === undefined ? {} : { agentOptions: configuredModel },
+        ...signal === undefined ? {} : { signal },
+        setup,
+      })
+    } catch (resumeFailure) {
+      let headers
+      try {
+        headers = await this.hostCtx.sessionPersistence.list(signal)
+      } catch (listFailure) {
+        throw new ControlSessionError('PERSISTENCE_UNAVAILABLE', { cause: listFailure })
+      }
+      if (headers.some(header => header.id === sessionId)) {
+        // A persisted Worker session failed to resume. Unlike controllers it
+        // has no identity event to re-validate, so fail closed rather than
+        // pretending it is fresh.
+        throw new ControlSessionError('PERSISTENCE_UNAVAILABLE', { cause: resumeFailure })
+      }
+      if (this.hostCtx.agents.get(sessionId) !== undefined
+        || this.hostCtx.sessions.get(sessionId) !== undefined) {
+        throw new ControlSessionError('LIVE_COLLISION')
+      }
+      try {
+        signal?.throwIfAborted()
+        const session = this.hostCtx.sessions.prepare(sessionId, {
+          meta: {
+            cwd,
+            ...workspaceEnabled ? { agentPreset: PROJECT_AGENT_PRESET } : {},
+          },
+        })
+        // No `controller/identity` append: the Worker's durable addressing is
+        // the Global roster fold. The seed-boundary marker keeps the log
+        // non-empty so the persistence layer materializes the session.
+        session.append('session/end-seed', {})
+        await this.hostCtx.sessionPersistence.create(session.header)
+        await this.hostCtx.sessionPersistence.append(session.id, session.events)
+        handle = await this.hostCtx.agents.resume({
+          resumeSessionId: sessionId,
+          ...configuredModel === undefined ? {} : { agentOptions: configuredModel },
+          ...signal === undefined ? {} : { signal },
+          setup,
+        })
+      } catch (materializeFailure) {
+        throw controlSessionFailure(materializeFailure, 'DURABILITY_FAILED')
+      }
+    }
+
+    try {
+      if (workspaceEnabled) {
+        const resumedCwd = handle.agent.session.header.cwd
+        if (resumedCwd === undefined || await canonicalizeWatchPath(resumedCwd) !== cwd) {
+          throw new ControlSessionError('IDENTITY_INVALID')
+        }
+      }
+      if (!await this.hostCtx.sessions.flush(handle.agent.session)) {
+        throw new ControlSessionError('DURABILITY_FAILED')
+      }
+      return handle
+    } catch (failure) {
+      await handle.dispose().catch(() => undefined)
+      throw controlSessionFailure(failure, 'DURABILITY_FAILED')
+    }
+  }
+
+  /**
+   * Slice 1B-B offline observation: fold every live Global Controller roster
+   * for the disposed Worker and append `offline` (design §11.2). Only a
+   * Worker that reached `ready` is deactivated by its Agent's disappearance;
+   * a pending reservation has no live session to lose and must keep its
+   * conflict semantics. Best-effort: failures are reported by the listener's
+   * caller, never propagated into the agent disposal path.
+   * @param agent - the disposed Agent.
+   */
+  private async observeWorkerDisposed(agent: Agent): Promise<void> {
+    const idText = String(agent.id)
+    if (!idText.startsWith(WORKER_SESSION_PREFIX)) return
+    const workerId = idText.slice(WORKER_SESSION_PREFIX.length)
+    for (const entry of this.ready.values()) {
+      if (entry.expected.role !== 'global') continue
+      const worker = foldRoster(entry.result.agent.session.events).get(workerId)
+      if (worker === undefined || worker.status !== 'ready') continue
+      await this.roster.markOffline({
+        session: entry.result.agent.session,
+        workerId,
+        flush: session => this.hostCtx.sessions.flush(session),
+      })
+      return
+    }
+  }
+
+  private open(expected: ExpectedIdentity, signal?: AbortSignal): Promise<ControlSessionResult> {
+    const ready = this.ready.get(expected.sessionId)
+    if (ready !== undefined) {
+      if (!sameExpected(ready.expected, expected)) throw new ControlSessionError('LIVE_COLLISION')
+      const liveAgent = this.hostCtx.agents.get(expected.sessionId)
+      const liveSession = this.hostCtx.sessions.get(expected.sessionId)
+      if (liveAgent === undefined && liveSession === undefined) {
+        // A caller-owned Cordis generation may have disposed the handle while
+        // this longer-lived service survived. Retire only a fully absent entry;
+        // any partial or replacement owner remains a hard collision.
+        this.ready.delete(expected.sessionId)
+      } else if (liveAgent !== ready.handle.agent
+        || liveSession !== ready.handle.agent.session) {
+        throw new ControlSessionError('LIVE_COLLISION')
+      } else {
+        validateControllerSession(ready.handle.agent, expected)
+        return Promise.resolve(ready.result)
+      }
+    }
+    const active = this.pending.get(expected.sessionId)
+    if (active !== undefined) {
+      if (!sameExpected(active.expected, expected)) {
+        return Promise.reject(new ControlSessionError('LIVE_COLLISION'))
+      }
+      return active.operation
+    }
+    if (this.hostCtx.agents.get(expected.sessionId) !== undefined
+      || this.hostCtx.sessions.get(expected.sessionId) !== undefined) {
+      return Promise.reject(new ControlSessionError('LIVE_COLLISION'))
+    }
+    const operation = this.restoreOrCreate(expected, signal)
+      .finally(() => this.pending.delete(expected.sessionId))
+    this.pending.set(expected.sessionId, { expected, operation })
+    return operation
+  }
+
+  private async restoreOrCreate(expected: ExpectedIdentity, signal?: AbortSignal): Promise<ControlSessionResult> {
+    let handle: AgentHandle
+    const configuredModel = this.optionalModelOptions()
+    try {
+      handle = await this.hostCtx.agents.resume({
+        resumeSessionId: expected.sessionId,
+        ...configuredModel === undefined ? {} : { agentOptions: configuredModel },
+        ...signal === undefined ? {} : { signal },
+        setup: (agentCtx) => {
+          return configureControllerAgent(this.hostCtx, agentCtx, expected)
+        },
+      })
+    } catch (resumeFailure) {
+      let headers
+      try {
+        headers = await this.hostCtx.sessionPersistence.list(signal)
+      } catch (listFailure) {
+        throw new ControlSessionError('PERSISTENCE_UNAVAILABLE', { cause: listFailure })
+      }
+      if (headers.some(header => header.id === expected.sessionId)) {
+        throw new ControlSessionError('IDENTITY_INVALID', { cause: resumeFailure })
+      }
+      if (this.hostCtx.agents.get(expected.sessionId) !== undefined
+        || this.hostCtx.sessions.get(expected.sessionId) !== undefined) {
+        throw new ControlSessionError('LIVE_COLLISION')
+      }
+      try {
+        signal?.throwIfAborted()
+        const session = this.hostCtx.sessions.prepare(expected.sessionId, {
+          meta: {
+            cwd: expected.cwd,
+            // Both controller roles compose the shipped coding preset: the
+            // project controller needs it for its agent surface, and the
+            // Global Controller composes the same tool registry so its
+            // coordinator restrict() whitelist (read/glob/grep/bash) can name
+            // real global tools instead of throwing "unknown global tool".
+            agentPreset: PROJECT_AGENT_PRESET,
+          },
+        })
+        session.append(CONTROLLER_IDENTITY_EVENT_TYPE, expectedPayload(expected))
+        validateControllerSessionRecord(session, expected)
+        const previous = this.unmaterialized.get(expected.sessionId)
+        if (previous === undefined) {
+          await this.hostCtx.sessionPersistence.create(session.header)
+          this.unmaterialized.set(expected.sessionId, expected)
+        } else if (!sameExpected(previous, expected)) {
+          throw new ControlSessionError('LIVE_COLLISION')
+        }
+        await this.hostCtx.sessionPersistence.append(session.id, session.events)
+        this.unmaterialized.delete(expected.sessionId)
+        handle = await this.hostCtx.agents.resume({
+          resumeSessionId: expected.sessionId,
+          ...configuredModel === undefined ? {} : { agentOptions: configuredModel },
+          ...signal === undefined ? {} : { signal },
+          setup: (agentCtx) => {
+            return configureControllerAgent(this.hostCtx, agentCtx, expected)
+          },
+        })
+      } catch (materializeFailure) {
+        throw controlSessionFailure(materializeFailure, 'DURABILITY_FAILED')
+      }
+    }
+
+    try {
+      validateControllerSession(handle.agent, expected)
+      if (!await this.hostCtx.sessions.flush(handle.agent.session)) {
+        throw new ControlSessionError('DURABILITY_FAILED')
+      }
+      if (expected.workspace !== undefined) await expected.workspace.attachSession(expected.sessionId)
+      const result: ControlSessionResult = {
+        id: expected.sessionId,
+        role: expected.role,
+        agent: handle.agent,
+      }
+      const entry: ReadyEntry = { expected, handle, result }
+      this.ready.set(expected.sessionId, entry)
+      handle.agent.ctx.effect(() => () => {
+        if (this.ready.get(expected.sessionId) === entry) {
+          this.ready.delete(expected.sessionId)
+        }
+      }, `devframeControlSessions.ready(${expected.sessionId})`)
+      return result
+    } catch (failure) {
+      return disposeAfterFailure(handle, controlSessionFailure(failure, 'DURABILITY_FAILED'))
+    }
+  }
+
+  /** Best-effort model options for identity-only opens; dispatch requires them. */
+  /** Best-effort model options for identity-only opens; dispatch requires them. */
+  private optionalModelOptions(): AgentOptions | undefined {
+    const defaults = this.hostCtx.get('agentDefaultModel')
+    if (defaults === undefined) return undefined
+    const selection = defaults.currentSelection()
+    if (selection.provider.length === 0 || selection.model.length === 0) return undefined
+    return { provider: selection.provider, model: selection.model }
+  }
+
+  private async releaseOwned(result: ControlSessionResult): Promise<void> {
+    const entry = this.ready.get(result.id)
+    if (entry === undefined || entry.result.agent !== result.agent) return
+    this.ready.delete(result.id)
+    try {
+      await entry.handle.dispose()
+    } catch (failure) {
+      throw new ControlSessionError('DURABILITY_FAILED', { cause: failure })
+    }
+  }
+}
+
+export default DevFrameControlSessions
