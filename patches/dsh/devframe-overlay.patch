+/**
+ * Slice 1C context-packet tests: the six-role table-driven assembly and
+ * digest stability (design §12.7 first canary row — each role receives the
+ * minimal ContextPacket its duty needs). Pure functions only; the dispatch
+ * wiring itself is covered by task.spec (slot) and policy.spec (validation).
+ */
+
+import { describe, expect, it } from 'vitest'
+import {
+  assembleContextPacket,
+  contextPacketDigest,
+  validateContextPacket,
+} from '../src/policy.ts'
+import type {
+  ContextRole,
+  ContextSourceV1,
+} from '../src/policy.ts'
+
+const NOW = 1_700_000_000_000
+const sha = (char: string): string => char.repeat(64)
+
+/** The six §12.3 roles and the byte budget each dispatch maps onto (index.ts). */
+const ROLE_BUDGETS: readonly [role: ContextRole, maxBytes: number][] = [
+  ['planner', 64 * 1024],
+  ['executor', 64 * 1024],
+  ['verifier', 48 * 1024],
+  ['reviewer', 48 * 1024],
+  ['researcher', 64 * 1024],
+  ['writer', 96 * 1024],
+]
+
+const baseSource: ContextSourceV1 = {
+  kind: 'prompt',
+  ref: 'devframe/base-instructions',
+  sha256: sha('a'),
+  bytes: 512,
+}
+
+describe('Slice 1C six-role ContextPacket table', () => {
+  it.each(ROLE_BUDGETS)(
+    'assembles the %s role packet: sources present, budget respected, digest stable',
+    (role, maxBytes) => {
+      const packet = assembleContextPacket({ role, sources: [baseSource], maxBytes, now: NOW })
+      expect(packet.schemaVersion).toBe(1)
+      expect(packet.role).toBe(role)
+      expect(packet.sources).toEqual([baseSource])
+      expect(packet.totalBytes).toBe(baseSource.bytes)
+      expect(packet.totalBytes).toBeLessThanOrEqual(maxBytes)
+      expect(packet.assembledAt).toBe(NOW)
+
+      // Every assembled packet round-trips the exact-key validator untouched.
+      expect(validateContextPacket(packet, NOW)).toEqual(packet)
+
+      // Content digest is a stable evidence ref: same packet, same digest.
+      expect(contextPacketDigest(packet)).toBe(contextPacketDigest(packet))
+    },
+  )
+
+  it('keeps the digest sensitive to the role (a reviewer packet never hashes like an executor one)', () => {
+    const packet = (role: ContextRole) =>
+      assembleContextPacket({ role, sources: [baseSource], maxBytes: 48 * 1024, now: NOW })
+    expect(contextPacketDigest(packet('executor'))).not.toBe(contextPacketDigest(packet('reviewer')))
+  })
+
+  it('digest changes when the source set changes (evidence ref tracks the assembled context)', () => {
+    const before = assembleContextPacket({
+      role: 'executor',
+      sources: [baseSource],
+      maxBytes: 64 * 1024,
+      now: NOW,
+    })
+    const after = assembleContextPacket({
+      role: 'executor',
+      sources: [{ ...baseSource, ref: 'devframe/base-instructions/v2' }],
+      maxBytes: 64 * 1024,
+      now: NOW,
+    })
+    expect(contextPacketDigest(after)).not.toBe(contextPacketDigest(before))
+  })
+})
