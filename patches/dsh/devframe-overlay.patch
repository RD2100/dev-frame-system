+    expect(recalls).toHaveLength(1)
+    expect(memory.readProjectMemory).toHaveBeenCalledTimes(1)
+    expect(adapter.requests).toHaveLength(2)
+  })
+
+  it('does not append after a downstream pre-step rejection', async () => {
+    memory.readProjectMemory.mockResolvedValue(currentPlan())
+    const adapter = new MockAdapter([textResponse('must not run')])
+    const { ctx, agent } = await loopHarness(adapter)
+    ctx.on('agent/pre-step', async () => ({ kind: 'reject' as const }))
+
+    agent.followup(createUserMessage({
+      content: [{ type: 'text', text: 'blocked' }],
+      source: { kind: 'user' },
+    }))
+    await agent.whenIdle()
+
+    expect(memory.readProjectMemory).not.toHaveBeenCalled()
+    expect(adapter.requests).toHaveLength(0)
+    expect(agent.session.events.some(event => (
+      event.type === 'user/message'
+      && event.data.source.kind === 'plugin'
+      && event.data.source.plugin === 'devframe-memory'
