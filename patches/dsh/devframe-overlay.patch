+function captureRequests(handle: SubprocessHandle, requests: Array<Record<string, unknown>>): void {
+  const stdin = handle.stdin
+  if (stdin === undefined) throw new Error('fixture stdin was not piped')
+  let pending = ''
+  const originalWrite = stdin.write.bind(stdin) as unknown as (...args: unknown[]) => unknown
+  const writer = stdin as unknown as { write: (...args: unknown[]) => unknown }
+  writer.write = (...args: unknown[]): unknown => {
+    const value = args[0]
+    if (typeof value === 'string' || Buffer.isBuffer(value)) {
+      pending += value.toString()
+      for (;;) {
+        const newline = pending.indexOf('\n')
+        if (newline < 0) break
+        const line = pending.slice(0, newline)
+        pending = pending.slice(newline + 1)
+        if (line.length === 0) continue
+        const parsed: unknown = JSON.parse(line)
+        if (parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed)) {
+          requests.push(parsed as Record<string, unknown>)
+        }
+      }
+    }
+    return originalWrite(...args as [string | Uint8Array, ...unknown[]])
+  }
