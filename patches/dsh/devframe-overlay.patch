+    expect(taskChanges(global.session).map(change => change.operation)).toEqual(['queue', 'admit', 'ack'])
+    expect(taskChanges(global.session)[0]?.payloadRef).toBe('real-project-payload')
+    // The physical envelope reached the Worker inbox (the fake delivery seam
+    // splices the message in; a real Worker loop would also project it as a
+    // `user/message`), carrying the real payload reference.
+    const workerSession = test.liveAgents.get(workerSessionId('worker-executor-1'))!.session
+    const insert = workerSession.events.find(event =>
+      event.type === 'agent/inbox/spliced'
+      && event.data.inserted.some(message => message.id === receipt.messageId))
+    expect(insert).toBeDefined()
+    if (insert?.type === 'agent/inbox/spliced') {
+      const message = insert.data.inserted.find(candidate => candidate.id === receipt.messageId)
+      const textBlock = message?.content.find(
+        (block): block is { type: 'text'; text: string } => block.type === 'text',
+      )
+      const payload = JSON.parse(textBlock?.text ?? '{}') as Record<string, unknown>
+      expect(payload.payloadRef).toBe('real-project-payload')
+    }
+  })
+
+  it('denies a real payload when the only rule does not match (no matching rule → fail-closed)', async () => {
+    const test = fakeSetup()
+    const global = (await test.controller.openGlobal({ profileId: 'profile-1' })).agent
+    await registerExecutor(test.controller)
+    // An allow rule for the planner context never matches the executor packet.
+    appendPolicyRule(global.session, policyRule({
+      id: 'allow-planner',
+      kind: 'allow',
+      match: { contextKind: 'planner' },
+    }))
+
+    await expect(test.controller.dispatchTask({
+      profileId: 'profile-1',
+      taskId: 'task-1',
+      semanticMessageId: 'semantic-1',
+      workerId: 'worker-executor-1',
+      payloadRef: 'real-project-payload',
+    })).rejects.toMatchObject({ code: 'POLICY_DENIED' })
+    expect(taskChanges(global.session)).toHaveLength(0)
+  })
+})
+
+// ---------------------------------------------------------------------------
+// Slice 1C-C: the `policy/decision` decision trail (design §12.2/§12.5 step 4),
+// the §12.9 first gate, and the §12.6 negative table at the slot boundary.
+// The slot appends exactly one `policy/decision` record for an ALLOWED
+// dispatch and flushes it BEFORE the queue reservation; a denied dispatch
+// leaves no record (deny 无痕). The CONTEXT_* rows are driven through the REAL
+// dispatch path via the Host role template (design §12.3 "配置化角色模板").
+// ---------------------------------------------------------------------------
+
+const sha64 = (char: string): string => char.repeat(64)
+
+function policyDecisions(session: Session): PolicyDecisionV1[] {
+  return session.events
+    .filter(event => event.type === POLICY_DECISION_EVENT_TYPE)
+    .map(event => event.data)
+}
+
+describe('Slice 1C-C first gate: payloadRef reference shape (design §12.9)', () => {
+  it('rejects an empty or path-shaped payload reference as TASK_PAYLOAD_UNSUPPORTED BEFORE the slot', async () => {
+    const test = fakeSetup()
+    const global = (await test.controller.openGlobal({ profileId: 'profile-1' })).agent
+    await registerExecutor(test.controller)
+    // Even an allow rule cannot rescue a malformed reference: the first gate
+    // (design §12.9 "payload 引用校验") runs before the whitelist short-circuit
+    // and the policy slot, so no decision and no task event can appear.
+    appendPolicyRule(global.session, policyRule({ id: 'allow-all', kind: 'allow', match: {} }))
+    const eventsBefore = global.session.events.length
+    const malformed = ['dir/task', 'dir\\task', 'C:task', 'C:\\task', ''] as const
+    for (const [index, payloadRef] of malformed.entries()) {
+      await expect(test.controller.dispatchTask({
+        profileId: 'profile-1',
+        taskId: 'task-1',
+        semanticMessageId: `semantic-malformed-${index}`,
+        workerId: 'worker-executor-1',
+        payloadRef,
+      })).rejects.toMatchObject({ code: 'TASK_PAYLOAD_UNSUPPORTED' })
+    }
+    expect(global.session.events.length).toBe(eventsBefore)
+    expect(policyDecisions(global.session)).toHaveLength(0)
+    expect(taskChanges(global.session)).toHaveLength(0)
+    const workerSession = test.liveAgents.get(workerSessionId('worker-executor-1'))!.session
+    expect(workerSession.events.some(event => event.type === 'user/message')).toBe(false)
+  })
+})
+
+describe('Slice 1C-C PolicyDecision trail in dispatchTask (design §12.2/§12.5)', () => {
+  it('appends and flushes one policy/decision record BEFORE queue when the slot allows', async () => {
+    const test = fakeSetup()
+    const global = (await test.controller.openGlobal({ profileId: 'profile-1' })).agent
+    await registerExecutor(test.controller)
+    appendPolicyRule(global.session, policyRule({
+      id: 'allow-executor',
+      kind: 'allow',
+      match: { contextKind: 'executor' },
+    }))
+
+    const receipt = await test.controller.dispatchTask({
+      profileId: 'profile-1',
+      taskId: 'task-1',
+      semanticMessageId: 'semantic-1',
+      workerId: 'worker-executor-1',
+      payloadRef: 'real-project-payload',
+    })
+    expect(receipt).toMatchObject({ taskId: 'task-1', state: 'acknowledged', duplicate: false })
+    // Exactly one allow decision, with the matched rule and the packet digest.
+    const decisions = policyDecisions(global.session)
+    expect(decisions).toHaveLength(1)
+    expect(decisions[0]).toMatchObject({
+      schemaVersion: 1,
+      taskId: 'task-1',
+      decision: 'allow',
+      reason: 'rule',
+      ruleId: 'allow-executor',
+    })
+    expect(decisions[0]?.packetDigest).toMatch(/^[0-9a-f]{64}$/)
+    expect(decisions[0]?.changedAt).toBeGreaterThan(0)
+    // The decision precedes the queue reservation (design §12.5: flush 后才继续).
+    const decisionIndex = global.session.events.findIndex(event => event.type === POLICY_DECISION_EVENT_TYPE)
+    const queueIndex = global.session.events.findIndex(event => event.type === TASK_EVENT_TYPE)
+    expect(decisionIndex).toBeGreaterThanOrEqual(0)
+    expect(queueIndex).toBeGreaterThan(decisionIndex)
+    // The trail was flushed with the Global session (the dispatch succeeding is
+    // itself the durable-flush proof — a failed flush throws DURABILITY_FAILED).
+    expect(test.flush).toHaveBeenCalled()
+    expect(test.flush.mock.calls.some(([session]) => session.id === global.session.id)).toBe(true)
+  })
+
+  it('leaves no policy/decision record when the slot denies (deny 无痕)', async () => {
+    const test = fakeSetup()
+    const global = (await test.controller.openGlobal({ profileId: 'profile-1' })).agent
+    await registerExecutor(test.controller)
+    appendPolicyRule(global.session, policyRule({
+      id: 'deny-real',
+      kind: 'deny',
+      match: { action: 'real-project-payload' },
+    }))
+    const eventsBefore = global.session.events.length
+
+    await expect(test.controller.dispatchTask({
+      profileId: 'profile-1',
+      taskId: 'task-1',
+      semanticMessageId: 'semantic-1',
+      workerId: 'worker-executor-1',
+      payloadRef: 'real-project-payload',
+    })).rejects.toMatchObject({ code: 'POLICY_DENIED' })
+    expect(global.session.events.length).toBe(eventsBefore)
+    expect(policyDecisions(global.session)).toHaveLength(0)
+    expect(taskChanges(global.session)).toHaveLength(0)
+  })
+
+  it('treats an expired rule as no match: POLICY_DENIED, never POLICY_EXPIRED', async () => {
+    const test = fakeSetup()
+    const global = (await test.controller.openGlobal({ profileId: 'profile-1' })).agent
+    await registerExecutor(test.controller)
+    // An expired ALLOW rule is skipped by evaluatePolicy (1C-A), so the packet
+    // falls through to the fail-closed default deny. The slot gates with
+    // POLICY_DENIED — the POLICY_EXPIRED code belongs to a later decision-
+    // reference slice, not to rule expiry.
+    appendPolicyRule(global.session, policyRule({
+      id: 'expired-allow',
+      kind: 'allow',
+      match: { contextKind: 'executor' },
+      expiresAt: Date.now() - 1,
+    }))
+
+    await expect(test.controller.dispatchTask({
+      profileId: 'profile-1',
+      taskId: 'task-1',
+      semanticMessageId: 'semantic-1',
+      workerId: 'worker-executor-1',
+      payloadRef: 'real-project-payload',
+    })).rejects.toMatchObject({ code: 'POLICY_DENIED' })
+    expect(policyDecisions(global.session)).toHaveLength(0)
+    expect(taskChanges(global.session)).toHaveLength(0)
+  })
+})
+
+describe('Slice 1C-C CONTEXT_* negative rows at the slot (design §12.6)', () => {
+  it('fails closed with CONTEXT_OVER_BUDGET even with an allow rule: no append, no delivery', async () => {
+    const test = fakeSetup({
+      controlOptions: {
+        contextPacketSources: [{
+          kind: 'instruction',
+          ref: 'devframe/instruction/huge-v1',
+          sha256: sha64('f'),
+          bytes: 1024 * 1024,
+        }],
+      },
+    })
+    const global = (await test.controller.openGlobal({ profileId: 'profile-1' })).agent
+    await registerExecutor(test.controller)
+    appendPolicyRule(global.session, policyRule({ id: 'allow-all', kind: 'allow', match: {} }))
+    const eventsBefore = global.session.events.length
+
+    await expect(test.controller.dispatchTask({
+      profileId: 'profile-1',
+      taskId: 'task-1',
+      semanticMessageId: 'semantic-1',
+      workerId: 'worker-executor-1',
+      payloadRef: 'real-project-payload',
+    })).rejects.toMatchObject({ code: 'CONTEXT_OVER_BUDGET' })
+    // The packet check precedes the decision: no allow record, no queue/admit,
+    // no Worker turn (hard stop §12.8: no truncated concatenation).
+    expect(global.session.events.length).toBe(eventsBefore)
+    expect(policyDecisions(global.session)).toHaveLength(0)
+    expect(taskChanges(global.session)).toHaveLength(0)
+    const workerSession = test.liveAgents.get(workerSessionId('worker-executor-1'))!.session
+    expect(workerSession.events.some(event => event.type === 'user/message')).toBe(false)
+  })
+
+  it('fails closed with CONTEXT_MISSING when the role template assembles nothing', async () => {
+    const test = fakeSetup({ controlOptions: { contextPacketSources: [] } })
+    const global = (await test.controller.openGlobal({ profileId: 'profile-1' })).agent
+    await registerExecutor(test.controller)
+    appendPolicyRule(global.session, policyRule({ id: 'allow-all', kind: 'allow', match: {} }))
+    const eventsBefore = global.session.events.length
+
+    await expect(test.controller.dispatchTask({
+      profileId: 'profile-1',
+      taskId: 'task-1',
+      semanticMessageId: 'semantic-1',
+      workerId: 'worker-executor-1',
+      payloadRef: 'real-project-payload',
+    })).rejects.toMatchObject({ code: 'CONTEXT_MISSING' })
+    expect(global.session.events.length).toBe(eventsBefore)
+    expect(policyDecisions(global.session)).toHaveLength(0)
+    expect(taskChanges(global.session)).toHaveLength(0)
+  })
+
+  it('fails closed with CONTEXT_CONFLICT on a duplicate source ref in the role template', async () => {
+    const shared: ContextSourceV1 = {
+      kind: 'skill',
+      ref: 'skill/refactor',
+      sha256: sha64('b'),
+      bytes: 250,
+    }
+    const test = fakeSetup({
+      controlOptions: { contextPacketSources: [shared, { ...shared }] },
+    })
+    const global = (await test.controller.openGlobal({ profileId: 'profile-1' })).agent
+    await registerExecutor(test.controller)
+    appendPolicyRule(global.session, policyRule({ id: 'allow-all', kind: 'allow', match: {} }))
+    const eventsBefore = global.session.events.length
+
+    await expect(test.controller.dispatchTask({
+      profileId: 'profile-1',
+      taskId: 'task-1',
+      semanticMessageId: 'semantic-1',
+      workerId: 'worker-executor-1',
+      payloadRef: 'real-project-payload',
+    })).rejects.toMatchObject({ code: 'CONTEXT_CONFLICT' })
+    expect(global.session.events.length).toBe(eventsBefore)
+    expect(policyDecisions(global.session)).toHaveLength(0)
+    expect(taskChanges(global.session)).toHaveLength(0)
+  })
+})
