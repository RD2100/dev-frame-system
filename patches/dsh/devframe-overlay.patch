+  constructor(ctx: Context, options: DevFrameControlSessionsOptions = {}) {
+    super(ctx, 'devframeControlSessions')
+    this.hostCtx = ctx
+    this.controlOptions = options
+    this.memoryGateway = options.memoryGateway ?? createDevFrameMcpMemoryGateway()
+    // Slice 1B-B offline observation (design §11.2): when a Worker Agent
+    // disappears the Host appends `offline` to the Global roster. The
+    // listener is tied to this fiber, so a Host shutdown (which unloads this
+    // service before the agent registry) never races a dying persistence —
+    // offline is only recorded for disposals observed while the service is
+    // live. Best-effort by design: an observation failure is logged, never
+    // propagated (the roster event stream stays the source of truth).
+    this.hostCtx.on('agent/disposed', ({ agent }) => {
+      void this.observeWorkerDisposed(agent).catch((failure: unknown) => {
+        this.hostCtx.logger.warn(`devframe roster: offline observation failed: ${String(failure)}`)
+      })
+    })
+  }
+
+  /**
+   * Begin one HMR-safe Global Controller bootstrap generation.
+   * @returns the generation-owned start/block/stop controls.
+   */
+  beginGlobalBootstrap(): DevFrameGlobalBootstrapGeneration {
+    const ticket = this.readinessState.begin()
+    const record: BootstrapRecord = { generation: ticket.generation, stopping: false }
+    this.bootstrap = record
+
+    const open = async (profileId: string): Promise<void> => {
+      if (record.operation !== undefined) return record.operation
+      const operation = this.openGlobal({ profileId, signal: ticket.signal })
+        .then((result) => {
+          record.result = result
+          this.readinessState.ready(record.generation, result.id)
+        })
+        .catch((failure: unknown) => {
+          if (!ticket.signal.aborted) {
+            // Fail-loud: a blocked controller with no visible cause is a
+            // debugging trap (observed in the real-home deployment: readiness
+            // showed CONTROLLER_UNAVAILABLE with zero logs). The category
+            // stays bounded; the message keeps the stable prefix only.
+            console.error(`devframe bootstrap: openGlobal failed: ${String(failure)}`)
+            let cause: unknown = failure instanceof Error ? failure.cause : undefined
+            while (cause !== undefined) {
+              const detail = cause instanceof Error
+                ? cause.message
+                : typeof cause === 'string' ? cause : '<non-error cause>'
+              console.error(`  cause: ${detail}`)
+              cause = cause instanceof Error ? cause.cause : undefined
+            }
+            this.hostCtx.logger.warn(`devframe bootstrap: openGlobal failed: ${String(failure)}`)
+            this.readinessState.blocked(record.generation, 'CONTROLLER_UNAVAILABLE')
+          }
+        })
+      record.operation = operation
+      await operation
+    }
+
+    const stop = async (): Promise<void> => {
+      if (record.stopping) {
+        await record.operation
+        return
+      }
+      record.stopping = true
+      this.readinessState.stopping(record.generation)
+      await record.operation
+      const result = record.result
+      if (result !== undefined) await this.releaseOwned(result)
+      if (this.bootstrap === record) this.bootstrap = undefined
+    }
+
+    return {
+      generation: record.generation,
+      signal: ticket.signal,
+      open,
+      block: (code) => { this.readinessState.blocked(record.generation, code) },
+      stop,
+    }
+  }
+
+  /**
+   * Return the current pathless readiness projection for Host diagnostics and tests.
+   * @returns a detached readiness snapshot without absolute paths or credentials.
+   */
+  readinessSnapshot(): DevFrameReadinessSnapshot {
+    return this.readinessState.snapshot()
+  }
+
+  /**
+   * Compute the pathless Slice 0 Health checklist. Every item is a stable id
+   * with a tri-state verdict and bounded guidance; no path, credential, or
+   * prompt ever enters the projection. The checklist is the MVP READY-001..004
+   * surface: version, Host lease, event catalog, provider, project authority,
+   * memory, MCP, and write permissions.
+   * @returns the detached health snapshot.
+   */
+  healthSnapshot(): DevFrameHealthSnapshot {
+    const items: DevFrameHealthItem[] = [
+      {
+        id: 'dsh-version',
+        status: 'ready',
+        reason: `dsh ${DSH_VERSION}`,
+      },
+      this.hostCtx.get(DSH_PROFILE_HOST_FENCE_KEY) === undefined
+        ? {
+          id: 'host-lease',
+          status: 'degraded',
+          reason: 'no single-writer Host fence in this composition',
+          impact: 'a second launcher could race the profile host',
+          action: 'boot through the devframe profile launcher',
+        }
+        : { id: 'host-lease', status: 'ready' },
+      KNOWN_SESSION_EVENT_TYPES.has(CONTROLLER_IDENTITY_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(CONTROLLER_RUN_SUMMARY_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(PROJECT_AUTHORITY_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(OBJECTIVE_CHANGE_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(PROJECT_RUN_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(LOOP_CHANGE_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(MEMORY_CHANGE_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(ROSTER_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(TASK_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(TASK_REVIEW_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(POLICY_RULE_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(RUN_FROZEN_EVENT_TYPE)
+        && KNOWN_SESSION_EVENT_TYPES.has(POLICY_DECISION_EVENT_TYPE)
+        ? { id: 'event-catalog', status: 'ready' }
+        : {
+          id: 'event-catalog',
+          status: 'blocked',
+          reason: 'controller/identity, controller/run-summary, project-authority/bound, objective/change, project/run, devframe/loop, devframe/memory, roster/registered, task/change, task/review, policy/rule, run/frozen, or policy/decision is missing from the known event vocabulary',
+          impact: 'controller logs would be refused on resume',
+          action: 'regenerate the persistence catalog',
+        },
+      ...this.providerHealthItem(),
+      this.projectAuthorityHealthItem(),
+      this.memoryHealth === 'ready'
+        ? { id: 'memory', status: 'ready', reason: 'governed project memory available' }
+        : {
+          id: 'memory',
+          status: 'blocked',
+          reason: this.memoryHealth === 'blocked'
+            ? 'governed project memory is unavailable'
+            : 'governed project memory has not been probed',
+          impact: 'automatic loops continue without a memory checkpoint',
+          action: 'run a governed Global→Project loop to probe memory',
+        },
+      {
+        id: 'mcp',
+        status: 'blocked',
+        reason: 'external-brain MCP is not configured',
+        impact: 'no web-AI binding',
+        action: 'Slice 0R',
+      },
+      {
+        id: 'write-permissions',
+        status: 'ready',
+        reason: 'project write dispatch is gated by authority and objective routing',
+        impact: 'controllers run project tasks only after the gates pass',
+        action: 'bind authority, then route the objective in the global controller',
+      },
+    ]
+    return { revision: ++this.healthRevision, items }
+  }
+
+  /** One checklist item for the configured default model route. */
+  private providerHealthItem(): DevFrameHealthItem[] {
+    const defaults = this.hostCtx.get('agentDefaultModel')
+    const selection = defaults?.currentSelection()
+    if (selection === undefined || selection.provider.length === 0 || selection.model.length === 0) {
+      return [{
+        id: 'provider',
+        status: 'degraded',
+        reason: 'no default model route is configured',
+        impact: 'Global dispatch is unavailable',
+        action: 'configure a model in Settings → Models',
+      }]
+    }
+    return [{ id: 'provider', status: 'ready' }]
+  }
+
+  /**
+   * One checklist item for the project-authority stance. The Global Controller
+   * has no single project, so the check folds every currently open Project
+   * Controller: ready as soon as any project authority is bound, otherwise
+   * blocked (the minimal Slice 1A-A/B increment; per-project expiry is
+   * reported by the authority view itself).
+   */
+  /**
+   * Health `project-authority` item. LIVE-ONLY scope (design §10.1-B): it
+   * folds only controller sessions currently open in this process, so after a
+   * restart a durable bound shows `blocked` until the project controller is
+   * opened again (a cold fold would need an extra read path the health card
+   * deliberately avoids; `projectAuthorityView(sessionId)` covers the cold
+   * fold on demand).
+   */
+  private projectAuthorityHealthItem(): DevFrameHealthItem {
+    let bound = false
+    for (const entry of this.ready.values()) {
+      if (entry.expected.role !== 'project') continue
+      const workspaceId = entry.expected.workspace === undefined
+        ? undefined
+        : String(entry.expected.workspace.id)
+      if (workspaceId !== undefined
+        && this.authority.view(entry.result.agent.session.events, workspaceId).status === 'bound') {
+        bound = true
+        break
+      }
+    }
+    if (bound) {
+      return { id: 'project-authority', status: 'ready', reason: 'project authority bound' }
+    }
+    return {
+      id: 'project-authority',
+      status: 'blocked',
+      reason: 'no bound project authority',
+      impact: 'project controllers are identity-only',
+      action: 'bind authority in the project controller',
+    }
+  }
