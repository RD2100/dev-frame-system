+      const buffer = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk, 'utf8')
+      bodyBytes += buffer.length
+      if (bodyBytes > MAX_FIXTURE_BYTES) {
+        rejectOversized()
+        return
+      }
+      chunks.push(buffer)
+    })
+    request.on('end', () => {
