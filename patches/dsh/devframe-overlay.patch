+import type { Context } from '@deepseek-ai/cordis'
+import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+import type { DevFrameHealthSnapshot } from '@deepseek-ai/dsh-devframe-control-session/types'
+import { devframeRemoteFace } from './remote-face.ts'
+
+/**
+ * Owns one fetched Slice 0 Health snapshot for the Global Controller card.
+ * A failed or absent remote keeps the last value; the card renders an
+ * unavailable state instead of claiming stale health.
+ */
+export class GlobalControllerHealth {
+  readonly store: SnapshotStore<DevFrameHealthSnapshot | undefined> = createSnapshotStore(undefined)
+
+  private inFlight = false
+
+  /**
+   * Fetch the current health snapshot from the Host Remote face.
+   * @param ctx - browser context; the face is resolved through the non-strict
+   * `ctx.get` lookup (see `remote-face.ts`).
+   * @returns whether a fresh snapshot was stored.
+   */
+  async refresh(ctx: Context): Promise<boolean> {
+    if (this.inFlight) return false
+    this.inFlight = true
+    try {
+      const response = await devframeRemoteFace(ctx)?.health()
+      if (response?.ok === true) {
+        this.store.set(response.value)
+        return true
+      }
+      return false
+    } catch {
+      return false
+    } finally {
+      this.inFlight = false
+    }
+  }
+}
