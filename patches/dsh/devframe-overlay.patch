@@ -0,0 +1,223 @@
+// Keyless assembled proof of the real Global → Project dispatch path. The
+// browser selects a workspace in the Global composer, the Host performs the
+// existing authority/loop/memory gates, and the Project Controller runs one
+// native Agent Loop turn before the Global loop projection completes.
+import { fileURLToPath } from 'node:url'
+import { readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import type { Browser, Page } from 'playwright'
+import { chromium } from 'playwright'
+import { afterEach, describe, expect, it, onTestFailed } from 'vitest'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import {
+  assertFixtureInventory, captureStableAria, compareOrRefreshGolden,
+  launchWebScaffold, parseSeedFixture, watchConsole, webSnapshotMode, type WebScaffold,
+} from './scaffold.ts'
+import { connectFreshWorkspace, newEnglishPage, saveFailureShot } from './support.ts'
+
+const DEVFRAME_PATCH_PATH = fileURLToPath(
+  new URL('../../../packages/bundle/devframe/cordis.patch.yml', import.meta.url),
+)
+const SNAPSHOT_DIR = fileURLToPath(new URL('./snapshots/global-project-loop', import.meta.url))
+const FIXTURE = join(SNAPSHOT_DIR, 'session.jsonl')
+const OVERRIDE = join(SNAPSHOT_DIR, 'replay.override.json')
+const UI_EXPECTED = join(SNAPSHOT_DIR, 'ui.expected.md')
+const TASK_BOARD_SEED = join(SNAPSHOT_DIR, 'task-board-seed.jsonl')
+const MODE = webSnapshotMode()
+const WORKSPACE_NAME = 'global-project-loop'
+
+const MEMORY_GATEWAY = {
+  recallProjectPlan: async () => ({ status: 'missing' as const }),
+  captureProjectCheckpoint: async () => ({ status: 'captured' as const }),
+}
+
+function globalLoopOperations(events: readonly { sessionId: string; event: SessionEvent }[]): string[] {
+  return events.flatMap(({ event }) => event.type === 'devframe/loop' ? [event.data.operation] : [])
+}
+
+describe('web e2e: Global composer dispatches one governed Project Loop', () => {
+  let scaffold: WebScaffold | undefined
+  let browser: Browser | undefined
+  let page: Page
+  let tripwire: ReturnType<typeof watchConsole>
+  const observed: { sessionId: string; event: SessionEvent }[] = []
+  let globalBootstrap: {
+    open(profileId: string): Promise<void>
+    stop(): Promise<void>
+  } | undefined
+
+  afterEach(async () => {
+    const failures: unknown[] = []
+    await browser?.close().catch((error: unknown) => failures.push(error))
+    browser = undefined
+    await globalBootstrap?.stop().catch((error: unknown) => failures.push(error))
+    globalBootstrap = undefined
+    const closing = scaffold
+    scaffold = undefined
+    await closing?.close().catch((error: unknown) => failures.push(error))
+    if (failures.length === 1) throw failures[0]
+    if (failures.length > 1) throw new AggregateError(failures, 'global-project-loop teardown failed')
+  })
+
+  it.skipIf(MODE === 'record')('completes the real browser-to-Host-to-AgentLoop path', async () => {
+    onTestFailed(() => saveFailureShot(page, 'web-e2e-global-project-loop'))
+    scaffold = await launchWebScaffold({
+      extraOverlayPath: DEVFRAME_PATCH_PATH,
+      replayFixture: FIXTURE,
+      replayOverride: OVERRIDE,
+      paceMs: 20,
+      testMemoryGateway: MEMORY_GATEWAY,
+    })
+    scaffold.ctx.provide('profileIdentity', { id: 'global-project-loop-e2e', name: 'devframe' })
+    const controlSessions = scaffold.ctx.get('devframeControlSessions') as {
+      beginGlobalBootstrap(): {
+        open(profileId: string): Promise<void>
+        stop(): Promise<void>
+      }
+    } | undefined
+    if (controlSessions === undefined) throw new Error('DevFrame control-session Host is not mounted')
+    globalBootstrap = controlSessions.beginGlobalBootstrap()
+    await globalBootstrap.open('global-project-loop-e2e')
+    const globalService = scaffold.ctx.get('devframeControlSessions') as {
+      openGlobal(options: { profileId: string }): Promise<{
+        agent: { session: { append(type: string, data: unknown): unknown } }
+      }>
+    }
+    const global = await globalService.openGlobal({ profileId: 'global-project-loop-e2e' })
+    const seedEvents = parseSeedFixture(await readFile(TASK_BOARD_SEED, 'utf8')).events
+    for (const event of seedEvents) {
+      if (event.type !== 'task/change' && event.type !== 'task/review' && event.type !== 'evaluation/receipt') continue
+      global.agent.session.append(event.type, event.data)
+    }
+    await scaffold.ctx.sessions.flush(global.agent.session as never)
+    scaffold.ctx.on('session/event', (session, event: SessionEvent) => {
+      observed.push({ sessionId: String(session.id), event })
+    })
+
+    browser = await chromium.launch()
+    page = await newEnglishPage(browser)
+    tripwire = watchConsole(page)
+    await page.goto(scaffold.baseUrl, { waitUntil: 'load' })
+    const controller = page.getByRole('button', { name: 'Global Controller', exact: true })
+    await controller.waitFor({ timeout: 30_000 })
+    await connectFreshWorkspace(page, scaffold.workspaceCwd, WORKSPACE_NAME)
+    await controller.click()
+
+    // Bind the explicit project authority through the existing Project
+    // Controller panel. The Global composer never bypasses this Host gate.
+    await page.getByRole('button', { name: 'Global Controller actions', exact: true }).click()
+    let menu = page.locator('[role="menu"]').last()
+    await menu.getByRole('menuitem', { name: 'Project Controller', exact: true }).click()
+    const bind = page.getByRole('button', { name: 'Bind', exact: true })
+    await bind.waitFor({ timeout: 15_000 })
+    await bind.click()
+    await expect.poll(() => page.getByText(/Bound(?: and ready)?/u).count(), { timeout: 15_000 })
+      .toBeGreaterThan(0)
+
+    // Close the picker, return to the Global composer, and target the connected
+    // workspace. The chat path is intentionally exercised instead of the
+    // separate operator panel.
+    await page.getByRole('button', { name: 'Global Controller actions', exact: true }).click()
+    menu = page.locator('[role="menu"]').last()
+    await menu.getByRole('menuitem', { name: 'Project Controller', exact: true }).click()
+    const target = page.getByRole('combobox', { name: 'Send to', exact: true })
+    await target.waitFor({ timeout: 15_000 })
+    await target.selectOption({ label: WORKSPACE_NAME })
+    expect(await target.inputValue()).not.toBe('')
+
+    const objective = 'Run one bounded project loop and report the verified result.'
+    const input = page.locator('textarea:enabled').first()
+    await input.waitFor({ timeout: 15_000 })
+    await input.fill(objective)
+    await input.press('Enter')
+
+    const loop = page.locator('[data-devframe-loop][data-status="completed"]')
+    await loop.waitFor({ timeout: 60_000 })
+    expect(await page.locator('[data-devframe-loop]').count()).toBe(1)
+    expect(await loop.innerText()).toContain('Project completed')
+    expect(await loop.innerText()).toContain('Independent review pending')
+    expect(await loop.innerText()).not.toContain('Passed')
+    expect(await loop.innerText()).toContain('Memory checkpoint saved')
+
+    // Slice 3C: the Task Board is a fresh Host projection, not chat state.
+    // Close and reopen it to prove the same pathless view remains available
+    // after the Global Controller action is remounted/toggled.
+    const actions = page.getByRole('button', { name: 'Global Controller actions', exact: true })
+    await actions.click()
+    menu = page.locator('[role="menu"]').last()
+    await menu.getByRole('menuitem', { name: 'Task Board', exact: true }).click()
+    const taskBoard = page.locator('[role="status"]').filter({ hasText: 'Task Board' }).last()
+    await taskBoard.waitFor({ timeout: 15_000 })
+    await expect.poll(() => taskBoard.innerText(), { timeout: 15_000 }).toContain('seed-task')
+    const firstTaskBoardText = await taskBoard.innerText()
+    expect(firstTaskBoardText).toContain('seed-task')
+    expect(firstTaskBoardText).toContain('Reported')
+    expect(firstTaskBoardText).toContain('Evaluation passed')
+    expect(firstTaskBoardText).toContain('seed-review-task')
+    expect(firstTaskBoardText).not.toContain(scaffold.workspaceCwd)
+    expect(firstTaskBoardText).not.toContain('bounded response')
+    expect(firstTaskBoardText).not.toContain('seeded reviewer body')
+
+    await actions.click()
+    menu = page.locator('[role="menu"]').last()
+    await menu.getByRole('menuitem', { name: 'Task Board', exact: true }).click()
+    await actions.click()
+    menu = page.locator('[role="menu"]').last()
+    await menu.getByRole('menuitem', { name: 'Task Board', exact: true }).click()
+    const reopenedTaskBoard = page.locator('[role="status"]').filter({ hasText: 'Task Board' }).last()
+    await reopenedTaskBoard.waitFor({ timeout: 15_000 })
+    expect(await reopenedTaskBoard.innerText()).toBe(firstTaskBoardText)
+
+    // Slice 3E: restart the Host bootstrap and read the same durable Global
+    // projection again; the browser/client snapshot is not the authority.
+    await actions.click()
+    menu = page.locator('[role="menu"]').last()
+    await menu.getByRole('menuitem', { name: 'Task Board', exact: true }).click()
+    await globalBootstrap.stop()
+    globalBootstrap = undefined
+    const restartedBootstrap = controlSessions.beginGlobalBootstrap()
+    globalBootstrap = restartedBootstrap
+    await restartedBootstrap.open('global-project-loop-e2e')
+    const restartedActions = page.getByRole('button', { name: 'Global Controller actions', exact: true })
+    await restartedActions.waitFor({ timeout: 15_000 })
+    await restartedActions.click()
+    menu = page.locator('[role="menu"]').last()
+    await menu.getByRole('menuitem', { name: 'Task Board', exact: true }).click()
+    const replayedTaskBoard = page.locator('[role="status"]').filter({ hasText: 'Task Board' }).last()
+    await replayedTaskBoard.waitFor({ timeout: 15_000 })
+    await expect.poll(() => replayedTaskBoard.innerText(), { timeout: 15_000 }).toContain('seed-task')
+    expect(await replayedTaskBoard.innerText()).toBe(firstTaskBoardText)
+
+    const operations = globalLoopOperations(observed)
+    expect(operations).toEqual([
+      'start', 'route', 'memory-recall', 'dispatch', 'review', 'checkpoint', 'complete',
+    ])
+    const dispatch = observed.find(({ event }) => (
+      event.type === 'devframe/loop' && event.data.operation === 'dispatch'
+    ))
+    expect(dispatch?.event.type).toBe('devframe/loop')
+    if (dispatch?.event.type !== 'devframe/loop') throw new Error('missing project dispatch event')
+    const projectSessionId = dispatch.event.data.projectSessionId
+    expect(projectSessionId).toBeTruthy()
+    const projectEvents = observed
+      .filter(({ sessionId }) => sessionId === projectSessionId)
+      .map(({ event }) => event.type)
+    expect(projectEvents).toContain('request/header')
+    expect(projectEvents).toContain('assistant/message')
+    expect(projectEvents).toContain('turn/end')
+
+    const snapshot = await captureStableAria(page, '[data-devframe-loop]', scaffold.workspaceCwd)
+    await compareOrRefreshGolden(UI_EXPECTED, snapshot, MODE)
+    expect(await page.locator('vite-error-overlay').count()).toBe(0)
+    expect(await page.locator('[data-vite-error-overlay]').count()).toBe(0)
+    expect(tripwire.pageErrors).toEqual([])
+    expect(tripwire.warnings).toEqual([])
+  }, 120_000)
+
+  it.skipIf(MODE === 'record')('keeps the assembled fixture inventory closed', async () => {
+    await assertFixtureInventory(SNAPSHOT_DIR, [
+      'replay.override.json', 'reviewer-pass.jsonl', 'session.jsonl',
+      'task-board-seed.jsonl', 'ui.expected.md',
+    ])
+  })
+})
