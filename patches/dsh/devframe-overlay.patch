+function replaceControllerRestriction(
+  agentCtx: Context,
+  agent: Agent,
+  state: ControllerToolFaceState,
+): void {
+  const previous = state.restriction
+  state.restriction = () => undefined
+  try {
+    previous()
+    state.restriction = installControllerRestriction(agentCtx, agent)
+  } catch (failure) {
+    try {
+      state.restriction = agentCtx.tools.restrict({ allow: [] })
+    } catch (failClosedFailure) {
+      throw new ControlSessionError('PRESET_UNAVAILABLE', {
+        cause: new AggregateError([failure, failClosedFailure], 'Global Controller tool face failed closed'),
+      })
+    }
+    throw failure
+  }
