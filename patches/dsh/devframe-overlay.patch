+    'turn/started', 'turn/completed', 'item/agentMessage/delta', 'item/plan/delta', 'item/completed', 'item/started',
+    'item/reasoning/summaryPartAdded', 'item/reasoning/summaryTextDelta', 'item/reasoning/textDelta',
+    // Official lifecycle/telemetry notifications observed on a text-only turn;
+    // their payload is intentionally not projected into DSH.
+    'thread/started', 'thread/status/changed', 'thread/tokenUsage/updated',
+    'turn/diff/updated', 'turn/plan/updated', 'model/rerouted', 'model/verification',
+    'model/safetyBuffering/updated', 'warning', 'guardianWarning', 'deprecationNotice',
