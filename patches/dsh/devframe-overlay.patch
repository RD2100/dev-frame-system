+/**
+ * Host-published DevFrame controller role: the sessions.list summary earns
+ * `devframeRole` only from a validated first `controller/identity` event, on
+ * both the attached and the cold persisted path. A near-prefix id without a
+ * validated identity event — or a failed probe — stays visible.
+ */
+
+import { describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SessionStore, { SessionId, type SessionEvent, type SessionHeader } from '@deepseek-ai/dsh-session'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import UserQuestionService from '@deepseek-ai/dsh-user-questions'
+import type { RpcRequest } from '@deepseek-ai/dsh-host-apiproxy/api/rpc'
+import { RpcId } from '@deepseek-ai/dsh-host-apiproxy/api/rpc'
+import { createApiProxy } from '@deepseek-ai/dsh-host-apiproxy'
+
+const sid = (id: string): SessionId => id as SessionId
+
+let nextRpc = 1
+function request<P>(payload: P): RpcRequest<P> {
+  return { rpcId: RpcId(`devframe-role-${String(nextRpc++)}`), payload }
+}
+
+function header(id: string, createdAt = 100): SessionHeader {
+  return { version: 0, id: sid(id), createdAt, cwd: '/proj' }
+}
+
+/** A minimal host boot with a stubbed cold persistence seam. */
+async function harness(persistence?: unknown) {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(UserQuestionService)
+  if (persistence !== undefined) ctx.provide('sessionPersistence', persistence as never)
+  const api = createApiProxy(ctx, { defaultModelSelection: () => ({ provider: 'p', model: 'm' }), cwd: '/tmp' })
+  return { ctx, api }
+}
+
+/** Valid identity payload as the DevFrame Slice 0 service writes it. */
+function identityPayload(role: 'global' | 'project', sessionId: string): Record<string, unknown> {
+  return role === 'global'
+    ? { schemaVersion: 1, role, sessionId, profileId: 'p', cwd: '/proj' }
