+async function startAppServer(harness: SessionHarness): Promise<DirectAppServer> {
+  const child = harness.ctx.subprocess.spawn({
+    argv: codexAppServerArgv(),
+    cwd: harness.workspace,
+    stdio: { stdin: 'pipe', stdout: 'pipe', stderr: { maxBytes: MAX_STDERR_BYTES } },
+    graceMs: 2_000,
+    env: harness.env,
+  })
+  if (child.stdin === undefined || child.stdout === undefined) {
+    child.terminate()
+    await child.waitForExit()
+    throw new Error('direct-session: app-server did not expose stdio pipes')
+  }
+  const events: ObservedFrame[] = []
+  const approvals: ApprovalObservation[] = []
+  let closeError: Error | undefined
+  let closed = false
+  const transport = new JsonRpcLineTransport(
+    child.stdout as NonNullable<SubprocessHandle['stdout']>,
+    child.stdin as NonNullable<SubprocessHandle['stdin']>,
+  )
+  transport.onNotification((method, params) => {
+    events.push({ kind: 'notification', method, params })
+  })
+  transport.onRequest((method, params) => {
+    const eventIndex = events.push({ kind: 'request', method, params }) - 1
+    if (method === 'item/commandExecution/requestApproval' || method === 'item/fileChange/requestApproval') {
+      const available = params.availableDecisions
+      const decision: 'cancel' | 'decline' = Array.isArray(available) && available.includes('cancel')
+        ? 'cancel'
+        : 'decline'
+      approvals.push({ method, decision, eventIndex })
+      return Promise.resolve({ decision })
+    }
+    if (method === 'item/permissions/requestApproval') return Promise.resolve({ permissions: {}, scope: 'turn' })
+    if (method === 'item/tool/requestUserInput') return Promise.resolve({ answers: {} })
+    if (method === 'mcpServer/elicitation/request') {
+      return Promise.resolve({ action: 'decline', content: null, _meta: null })
+    }
+    return Promise.reject(new Error(`direct-session: unsupported app-server request ${method}`))
+  })
+  transport.start()
+  const app: DirectAppServer = {
+    child,
+    transport,
+    events,
+    approvals,
+    cwd: harness.workspace,
+    close: async () => {
+      if (closed) return
+      closed = true
+      transport.close()
+      try {
+        child.stdin?.end()
+      } catch (error: unknown) {
+        closeError = error instanceof Error ? error : new Error(String(error))
+      }
+      try {
+        child.terminate()
+        await child.waitForExit()
+      } catch (error: unknown) {
+        closeError = error instanceof Error ? error : new Error(String(error))
+      }
+      try {
+        await child.done
+      } catch (error: unknown) {
+        closeError = error instanceof Error ? error : new Error(String(error))
+      }
+    },
