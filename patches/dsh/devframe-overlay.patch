+  // the mounted agent preset. Read the post-mount catalog so a reduced test or
+  // deployment can still fail closed without turning a valid partial catalog
+  // into an "unknown global tool" setup error.
+  const schemas = typeof agentCtx.tools.schemas === 'function'
+    ? agentCtx.tools.schemas(agent)
+    : undefined
