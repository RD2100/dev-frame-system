+/** Zod schemas for the bounded Host Codex login contract. */
+
+import { z } from 'zod'
+import type { Wire } from './rpc.schema.ts'
+import { sessionIdSchema } from './sessions.schema.ts'
+import type {
+  CodexAttemptId, CodexAvailability, CodexLoginAttemptStatus,
+  CodexLoginCancelRequest, CodexLoginErrorCode, CodexLoginStartRequest, CodexLoginStartValue,
+  CodexStatusRequest, CodexStatusValue,
+} from './codex.ts'
+
+/** Exact lowercase UUID v4 form minted for a DSH login attempt. */
+const CODEX_ATTEMPT_ID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/
+
+/** CodexAttemptId schema; the cast is the sole brand boundary for this id. */
+export const codexAttemptIdSchema = z
+  .string()
+  .max(36)
+  .regex(CODEX_ATTEMPT_ID_PATTERN) as unknown as z.ZodType<CodexAttemptId>
+
+/** Public login failure categories; provider-specific detail stays outside this contract. */
+export const codexLoginErrorCodeSchema = z.union([
+  z.literal('CODEX_LOGIN_NOT_FOUND'),
+  z.literal('CODEX_LOGIN_ALREADY_ACTIVE'),
+  z.literal('CODEX_LOGIN_PROTOCOL_ERROR'),
+  z.literal('CODEX_LOGIN_PROCESS_ERROR'),
+  z.literal('CODEX_LOGIN_CANCELLED'),
+]) satisfies z.ZodType<CodexLoginErrorCode>
+
+/** The bounded browser material returned by a successful start. Trust checks belong to the Host implementation. */
+export const codexAuthUrlSchema = z.string().min(1).max(4096)
+
+/** Route availability value. */
+export const codexAvailabilitySchema = z.discriminatedUnion('availability', [
+  z.object({ availability: z.literal('ready') }),
+  z.object({ availability: z.literal('login-required') }),
+  z.object({ availability: z.literal('unsupported') }),
+  z.object({
+    availability: z.literal('unavailable'),
+    errorCode: z.union([
+      z.literal('CODEX_LOGIN_PROTOCOL_ERROR'),
+      z.literal('CODEX_LOGIN_PROCESS_ERROR'),
+    ]),
+  }),
+]) satisfies z.ZodType<Wire<CodexAvailability>>
+
+/** Attempt status value. */
+export const codexLoginAttemptStatusSchema = z.discriminatedUnion('state', [
+  z.object({ attemptId: codexAttemptIdSchema, state: z.literal('pending') }),
+  z.object({ attemptId: codexAttemptIdSchema, state: z.literal('completed') }),
+  z.object({
+    attemptId: codexAttemptIdSchema,
+    state: z.literal('cancelled'),
+    errorCode: z.literal('CODEX_LOGIN_CANCELLED'),
+  }),
+  z.object({
+    attemptId: codexAttemptIdSchema,
+    state: z.literal('failed'),
+    errorCode: z.union([
+      z.literal('CODEX_LOGIN_NOT_FOUND'),
+      z.literal('CODEX_LOGIN_ALREADY_ACTIVE'),
+      z.literal('CODEX_LOGIN_PROTOCOL_ERROR'),
+      z.literal('CODEX_LOGIN_PROCESS_ERROR'),
+    ]),
+  }),
+]) satisfies z.ZodType<Wire<CodexLoginAttemptStatus>>
+
+/** status response value: availability or the requested attempt status. */
+export const codexStatusValueSchema = z.union([
+  codexAvailabilitySchema,
+  codexLoginAttemptStatusSchema,
+]) satisfies z.ZodType<Wire<CodexStatusValue>>
+
+/** loginStart response value: success carries both start fields; failure carries only its code. */
+export const codexLoginStartValueSchema = z.discriminatedUnion('kind', [
+  z.object({
+    kind: z.literal('success'),
+    attemptId: codexAttemptIdSchema,
+    authUrl: codexAuthUrlSchema,
+  }),
+  z.object({
+    kind: z.literal('failure'),
+    errorCode: codexLoginErrorCodeSchema,
+  }),
+]) satisfies z.ZodType<Wire<CodexLoginStartValue>>
+
+/** status request payload. */
+export const codexStatusRequestSchema = z.object({
+  sessionId: sessionIdSchema,
+  attemptId: codexAttemptIdSchema.optional(),
+}) satisfies z.ZodType<Wire<CodexStatusRequest>>
+
+/** loginStart request payload. */
+export const codexLoginStartRequestSchema = z.object({
+  sessionId: sessionIdSchema,
+}) satisfies z.ZodType<Wire<CodexLoginStartRequest>>
+
+/** loginCancel request payload. */
+export const codexLoginCancelRequestSchema = z.object({
+  sessionId: sessionIdSchema,
+  attemptId: codexAttemptIdSchema,
+}) satisfies z.ZodType<Wire<CodexLoginCancelRequest>>
