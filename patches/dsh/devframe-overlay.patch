+        <>
+          <div
+            data-chain-overlay-fallback={slotKey}
+            style={{ display: elected === null ? 'contents' : 'none' }}
+          >
+            {opts.fallback ?? null}
+          </div>
+          {elected}
+        </>
+      )
+    }
+    return elected ?? <>{opts?.fallback ?? null}</>
+  }
+  // list: one row per id cell — the cell's shadowing winner, or the crash
