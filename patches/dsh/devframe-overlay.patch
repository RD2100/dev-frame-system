@@ -0,0 +1,62 @@
+# The thin DevFrame layer over dsh-web-app. Controller identity remains owned
+# by the Host service; the browser row only projects its client-safe event.
+
+- insert:
+    # Host-owned external-agent route. The browser may request only the fixed
+    # aliases; provider commands and environments remain profile-owned.
+    - id: subagent-acp
+      name: '@deepseek-ai/dsh-subagent-acp'
+      config:
+        providerName: acp
+        command: opencode
+        args:
+          - acp
+        permission: reject
+        env: {}
+
+    - id: subagent-codex
+      name: '@deepseek-ai/dsh-subagent-codex'
+
+    - id: subagent-claude-code
+      name: '@deepseek-ai/dsh-subagent-claude-code'
+
+    - id: devframe-control-session
+      name: '@deepseek-ai/dsh-devframe-control-session'
+
+    - id: devframe-project-context
+      name: '@deepseek-ai/dsh-devframe/project-context'
+
+    - id: devframe-codegraph-context
+      name: '@deepseek-ai/dsh-devframe/codegraph-context'
+
+    - id: devframe-memory-context
+      name: '@deepseek-ai/dsh-devframe/memory-context'
+
+    # Automatic governed-memory recall is candidate-only and opt-in. Keep it
+    # disabled until keyless latency/noise/privacy evidence is accepted.
+    - id: devframe-memory-auto-context
+      name: '@deepseek-ai/dsh-devframe/memory-auto-context'
+      config:
+        enabled: false
+
+    # CLI provider/runner: with no inner command the provider publishes
+    # nothing and the ordinary Web profile remains unchanged.
+    - id: devframe-task-startup
+      name: '@deepseek-ai/dsh-devframe/task-startup'
+
+    - id: devframe-task-runner
+      name: '@deepseek-ai/dsh-devframe/task-runner'
+      config:
+        # `ctx.get` is the non-blocking lookup: ordinary Web launches have no
+        # task request, so the runner receives `undefined` and stays inert.
+        request: !!js ctx.get('devframeTaskStartup')
+
+    - id: client-ui-devframe-control-session
+      name: '@deepseek-ai/dsh-client-ui-devframe-control-session'
+
+- id: api-gateway
+  config:
+    externalAgentProviders:
+      codex: codex
+      claude: claude-code
+      opencode: acp
