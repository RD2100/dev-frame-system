+    : new ControlSessionError(fallback, { cause: failure })
+}
+
+interface MergedControllerSignal {
+  readonly signal: AbortSignal
+  readonly dispose: () => void
+}
+
+/** Merge caller cancellation with the Agent's maintenance cancellation boundary. */
+function mergeControllerSignals(
+  caller: AbortSignal | undefined,
+  maintenance: AbortSignal,
+): MergedControllerSignal {
+  const controller = new AbortController()
+  const sources = caller === undefined ? [maintenance] : [caller, maintenance]
+  const listeners: Array<{
+    readonly source: AbortSignal
+    readonly listener: (event: Event) => void
+  }> = []
+  const abortFrom = (source: AbortSignal): void => {
+    if (!controller.signal.aborted) controller.abort(source.reason)
+  }
+
+  for (const source of sources) {
+    if (controller.signal.aborted) break
+    if (source.aborted) {
+      abortFrom(source)
+      break
+    }
+    const listener = (_event: Event): void => {
+      abortFrom(source)
+    }
+    source.addEventListener('abort', listener, { once: true })
+    listeners.push({ source, listener })
+  }
+
+  return {
+    signal: controller.signal,
+    dispose: () => {
+      for (const { source, listener } of listeners) {
+        source.removeEventListener('abort', listener)
+      }
+    },
+  }
+}
+
+/** Reserve the exact Agent idle boundary; active work has one stable error. */
+function runControllerMaintenance<T>(
+  agent: Agent,
+  job: (signal: AbortSignal) => Promise<T>,
+): Promise<T> {
+  try {
+    return agent.runMaintenance(job)
+  } catch (failure) {
+    throw new ControlSessionError('PRESET_SWITCH_RUNNING', { cause: failure })
+  }
