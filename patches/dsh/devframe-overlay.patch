+    const state: TurnState = {
+      queue: new ChunkQueue(),
+      dshTurn: options.dshTurn,
+      dshStep: options.dshStep,
+      onActionRejected: options.onActionRejected,
+      items: new Map(),
+      reasoningSummaries: new Map(),
+      nextReasoningBlockIndex: 1,
+      totalOutputBytes: 0,
+    }
+    this.state = state
+    try {
+      const response = asObject(await safeRequest(this.transport.request('turn/start', {
+        threadId: this.threadId,
