+}
+
+function healthSnapshot(): DevFrameHealthSnapshot {
+  return {
+    revision: 1,
+    items: [
+      { id: 'dsh-version', status: 'ready', reason: 'dsh 0.1.0-rc.5' },
+      { id: 'host-lease', status: 'degraded', reason: 'no fence', action: 'boot through the devframe launcher' },
+      { id: 'write-permissions', status: 'blocked', reason: 'disabled until Slice 1A/1C' },
