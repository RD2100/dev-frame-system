+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { DevFrameControlSessions } from '../src/index.ts'
+import { WorkspaceId } from '@deepseek-ai/dsh-workspace'
+import type { Workspace } from '@deepseek-ai/dsh-workspace/types'
+
+const roots: string[] = []
+const contexts: Context[] = []
+
+afterEach(async () => {
+  for (const ctx of contexts.splice(0).reverse()) await ctx.fiber.dispose()
+  for (const root of roots.splice(0).reverse()) await rm(root, { recursive: true, force: true })
+  vi.unstubAllEnvs()
+})
+
+function workspaceFixture(path: string): Workspace {
+  return {
+    id: WorkspaceId('workspace-1'),
+    path,
+    title: 'Workspace',
+    createdAt: '2026-08-25T00:00:00.000Z',
+    updatedAt: '2026-08-25T00:00:00.000Z',
+    sessionIds: [],
+    setTitle: async () => undefined,
+    attachSession: async () => undefined,
+    insertSessionBefore: async () => undefined,
+    detachSession: async () => undefined,
+    status: async () => 'ok',
+  }
+}
+
+async function boot(options: {
+  readonly memoryGateway?: unknown
+  readonly apiProxy?: unknown
+  readonly workspace?: Workspace
+}) {
+  const ctx = new Context()
+  contexts.push(ctx)
+  const workspace = options.workspace
+  ctx.provide('agents', { get: () => undefined } as never)
+  ctx.provide('sessions', { get: () => undefined, list: () => [] } as never)
+  ctx.provide('sessionPersistence', { list: () => Promise.resolve([]) } as never)
+  ctx.provide('workspaceRegistry', {
+    get: (id: ReturnType<typeof WorkspaceId>) => workspace?.id === id ? workspace : undefined,
+    list: () => workspace === undefined ? [] : [workspace],
+  } as never)
+  ctx.provide('tools', {} as never)
+  if (options.apiProxy !== undefined) ctx.provide('apiProxy', options.apiProxy as never)
+  await ctx.plugin(DevFrameControlSessions, {
+    memoryGateway: options.memoryGateway as never,
+  })
+  ctx.provide('profileIdentity', { id: 'profile-1', name: 'Test profile' } as never)
+  return ctx
+}
+
+describe('Host-owned Obsidian memory opener', () => {
+  it('opens only the server-resolved current note and returns no URI', async () => {
+    const vault = await mkdtemp(join(tmpdir(), 'dsh-memory-vault-'))
+    roots.push(vault)
+    vi.stubEnv('DEVFRAME_OBSIDIAN_MEMORY_ROOT', vault)
+    const workspaceRoot = await mkdtemp(join(tmpdir(), 'dsh-memory-project-'))
+    roots.push(workspaceRoot)
+    const openPath = vi.fn(async () => ({
+      rpcId: 'memory-open-test',
+      result: { ok: true, value: { opened: true } },
+    }))
+    const gateway = {
+      recallProjectPlan: vi.fn(async () => ({
+        status: 'current' as const,
+        relativePath: 'wiki/memories/project-now-current.md',
+        plan: 'bounded',
+      })),
+      captureProjectCheckpoint: vi.fn(),
+    }
+    const ctx = await boot({
+      workspace: workspaceFixture(workspaceRoot),
+      memoryGateway: gateway,
+      apiProxy: { host: { openPath } },
+    })
+    const result = await (ctx.devframeControlSessions as unknown as {
+      remoteOpenMemory(request: { workspaceId: string }, signal: AbortSignal): Promise<unknown>
+    }).remoteOpenMemory({ workspaceId: 'workspace-1' }, new AbortController().signal)
+    expect(result).toEqual({ opened: true, status: 'current' })
+    expect(openPath).toHaveBeenCalledTimes(1)
+    const calls = openPath.mock.calls as unknown as readonly [[{ payload: { path: string } }, AbortSignal]]
+    const request = calls[0][0]
+    expect(request.payload.path).toMatch(/^obsidian:\/\/open\?path=/u)
+    expect(request.payload.path).toContain(encodeURIComponent(join(vault, 'wiki/memories/project-now-current.md')))
+    expect(JSON.stringify(result)).not.toContain('obsidian')
+    expect(JSON.stringify(result)).not.toContain(vault)
+  })
+
+  it('returns a pathless unavailable result when native opening is not mounted', async () => {
+    const vault = await mkdtemp(join(tmpdir(), 'dsh-memory-vault-'))
+    roots.push(vault)
+    vi.stubEnv('DEVFRAME_OBSIDIAN_MEMORY_ROOT', vault)
+    const workspaceRoot = await mkdtemp(join(tmpdir(), 'dsh-memory-project-'))
+    roots.push(workspaceRoot)
+    const gateway = {
+      recallProjectPlan: vi.fn(async () => ({
+        status: 'current' as const,
+        relativePath: 'wiki/memories/project-now-current.md',
+        plan: 'bounded',
+      })),
+      captureProjectCheckpoint: vi.fn(),
+    }
+    const ctx = await boot({ workspace: workspaceFixture(workspaceRoot), memoryGateway: gateway })
+    const result = await (ctx.devframeControlSessions as unknown as {
+      remoteOpenMemory(request: { workspaceId: string }, signal: AbortSignal): Promise<unknown>
+    }).remoteOpenMemory({ workspaceId: 'workspace-1' }, new AbortController().signal)
+    expect(result).toEqual({ opened: false, status: 'unavailable' })
+    expect(JSON.stringify(result)).not.toContain(vault)
+  })
+})
