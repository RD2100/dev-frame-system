+    expect(planner).toMatchObject({ workerId: 'worker-planner-1', roleAssignment: 'planner' })
+  })
+})
diff --git a/packages/devframe/control-session/tests/task-board.spec.ts b/packages/devframe/control-session/tests/task-board.spec.ts
new file mode 100644
index 0000000000..dac3317ed5
--- /dev/null
+++ b/packages/devframe/control-session/tests/task-board.spec.ts
@@ -0,0 +1,321 @@
+/**
+ * Slice 1B Task Board fold: the six-state machine, idempotency arbiter, and
+ * strict-transition rejection over a Global Controller log.
+ */
+
+import { describe, expect, it } from 'vitest'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import {
+  TASK_EVENT_TYPE,
+  adjudicateClaim,
+  foldTask,
+  foldTaskBoard,
+  semanticKeyAdmitted,
+  taskReportEvidenceDigest,
+} from '../src/task-board.ts'
+import {
+  TASK_REVIEW_EVENT_TYPE,
+  foldTaskReviews,
+  taskReviewEvidenceDigest,
+} from '../src/review.ts'
+import type { TaskChangeV1, TaskReviewEvidenceV1 } from '../src/types.ts'
+
+function change(
+  operation: TaskChangeV1['operation'],
+  overrides: Partial<Omit<TaskChangeV1, 'operation'>> = {},
+): SessionEvent {
+  return {
+    type: TASK_EVENT_TYPE,
+    seq: 0,
+    time: 0,
+    data: {
+      schemaVersion: 1,
+      kind: 'task',
+      version: 1,
+      operation,
+      taskId: 'task-1',
+      semanticMessageId: 'semantic-1',
+      workerId: 'worker-executor-1',
+      payloadRef: 'fixed-test-payload',
+      changedAt: 0,
+      ...overrides,
+    },
+  }
+}
+
+/** Rebase seq numbers onto array positions (fold requires seq === index). */
+function withSeqs(events: SessionEvent[]): SessionEvent[] {
+  return events.map((event, index) => ({ ...event, seq: index }))
+}
+
+describe('Slice 1B task board fold', () => {
+  it('folds the full six-state chain queued → admitted → acknowledged → claimed → started → reported', () => {
+    const events = withSeqs([
+      change('queue'),
+      change('admit'),
+      change('ack'),
+      change('claim', { leaseExpiresAt: 1_000 }),
+      change('start'),
+      change('report'),
+    ])
+    expect(foldTask(events, 'task-1')).toEqual({ status: 'reported' })
+  })
+
+  it('starts at queued for an unknown task and stays queued after queue', () => {
+    expect(foldTask([], 'task-missing')).toEqual({ status: 'queued' })
+    expect(foldTask(withSeqs([change('queue')]), 'task-missing')).toEqual({ status: 'queued' })
+  })
+
+  it('rejects an illegal transition with TASK_STATE_INVALID', () => {
+    // start before claim.
+    expect(() => foldTask(withSeqs([
+      change('queue'),
+      change('admit'),
+      change('ack'),
+      change('start'),
+    ]), 'task-1')).toThrow(expect.objectContaining({ code: 'TASK_STATE_INVALID' }))
+    // report before start.
+    expect(() => foldTask(withSeqs([
+      change('queue'),
+      change('admit'),
+      change('report'),
+    ]), 'task-1')).toThrow(expect.objectContaining({ code: 'TASK_STATE_INVALID' }))
+  })
+
+  it('rejects a re-admit of an admitted semantic key as TASK_DUPLICATE', () => {
+    expect(() => foldTask(withSeqs([
+      change('queue'),
+      change('admit'),
+      change('admit'),
+    ]), 'task-1')).toThrow(expect.objectContaining({ code: 'TASK_DUPLICATE' }))
+  })
+
+  it('folds fail and cancel terminals and blocks further migration', () => {
+    expect(foldTask(withSeqs([
+      change('queue'),
+      change('admit'),
+      change('fail'),
+    ]), 'task-1')).toEqual({ status: 'failed' })
+    expect(foldTask(withSeqs([
+      change('queue'),
+      change('cancel'),
+    ]), 'task-1')).toEqual({ status: 'cancelled' })
+    // Report after a terminal is illegal.
+    expect(() => foldTask(withSeqs([
+      change('queue'),
+      change('cancel'),
+      change('report'),
+    ]), 'task-1')).toThrow(expect.objectContaining({ code: 'TASK_STATE_INVALID' }))
+  })
+
+  it('folds per-task state independently and ignores other tasks', () => {
+    const events = withSeqs([
+      change('queue'),
+      change('admit'),
+      change('queue', { taskId: 'task-2', semanticMessageId: 'semantic-2' }),
+    ])
+    expect(foldTask(events, 'task-1')).toEqual({ status: 'admitted' })
+    expect(foldTask(events, 'task-2')).toEqual({ status: 'queued' })
+  })
+
+  it('rejects a malformed payload as TASK_INVALID', () => {
+    const bad = withSeqs([change('queue', { payloadRef: '' })])
+    expect(() => foldTask(bad, 'task-1'))
+      .toThrow(expect.objectContaining({ code: 'TASK_INVALID' }))
+  })
+
+  it('rejects a spliced log whose seq breaks contiguity', () => {
+    const events = [change('queue'), change('admit')]
+    // Force seq 5 on the second event without rebasing.
+    events[1] = { ...events[1]!, seq: 5 }
+    expect(() => foldTask(events, 'task-1'))
+      .toThrow(expect.objectContaining({ code: 'TASK_INVALID' }))
+  })
+
+  it('folds a durable report evidence reference and rejects tampering', () => {
+    const unsigned = {
+      schemaVersion: 1 as const,
+      kind: 'devframe/task-report' as const,
+      sessionId: 'worker-session-1' as SessionId,
+      messageId: 'assistant-message-1',
+      assistantSeq: 3,
+      turn: 1,
+      step: 1,
+      turnEndSeq: 8,
+      outcome: 'completed' as const,
+      sourceEventSeqs: [3, 8],
+      messageSha256: '0'.repeat(64),
+    }
+    const reportRef = {
+      ...unsigned,
+      evidenceSha256: taskReportEvidenceDigest(unsigned),
+    }
+    const events = withSeqs([
+      change('queue'),
+      change('admit'),
+      change('ack'),
+      change('claim'),
+      change('start'),
+      change('report', { messageId: reportRef.messageId, reportRef, payloadRef: 'devframe/execute' }),
+    ])
+    expect(foldTask(events, 'task-1')).toEqual({ status: 'reported' })
+    const tampered = withSeqs([
+      change('queue'),
+      change('admit'),
+      change('ack'),
+      change('claim'),
+      change('start'),
+      change('report', {
+        messageId: reportRef.messageId,
+        reportRef: { ...reportRef, evidenceSha256: 'f'.repeat(64) },
+      }),
+    ])
+    expect(() => foldTask(tampered, 'task-1'))
+      .toThrow(expect.objectContaining({ code: 'TASK_INVALID' }))
+  })
+
+  it('reports semantic-key admission exactly once across retries', () => {
+    const events = withSeqs([
+      change('queue', { taskId: 'task-a' }),
+      change('admit', { taskId: 'task-a' }),
+      // A retry with the same semantic key but a fresh physical id: the key is
+      // already admitted — the dispatch gate consults `semanticKeyAdmitted`
+      // before admitting the retry (foldTask itself folds per taskId, so the
+      // cross-task duplicate is the gate's arbiter, not the fold's).
+      change('queue', { taskId: 'task-b', semanticMessageId: 'semantic-1' }),
+    ])
+    expect(semanticKeyAdmitted(events, 'semantic-1')).toBe(true)
+    expect(semanticKeyAdmitted(events, 'semantic-other')).toBe(false)
+    // The retry task's own fold stays queued (its admit was never allowed).
+    expect(foldTask(events, 'task-b')).toEqual({ status: 'queued' })
+  })
+
+  it('folds an independent review and rejects self-review, duplicate, or digest tampering', () => {
+    const reportUnsigned = {
+      schemaVersion: 1 as const,
+      kind: 'devframe/task-report' as const,
+      sessionId: 'executor-session-1' as SessionId,
+      messageId: 'executor-message-1',
+      assistantSeq: 3,
+      turn: 1,
+      step: 1,
+      turnEndSeq: 8,
+      outcome: 'completed' as const,
+      sourceEventSeqs: [3, 8],
+      messageSha256: '0'.repeat(64),
+    }
+    const reportRef = { ...reportUnsigned, evidenceSha256: taskReportEvidenceDigest(reportUnsigned) }
+    const reviewUnsigned: Omit<TaskReviewEvidenceV1, 'evidenceSha256'> = {
+      schemaVersion: 1,
+      kind: 'devframe/task-review',
+      version: 1,
+      taskId: 'task-1',
+      executorWorkerId: 'worker-executor-1',
+      executorReportSha256: reportRef.evidenceSha256,
+      reviewerWorkerId: 'worker-reviewer-1',
+      reviewerSessionId: 'reviewer-session-1' as SessionId,
+      reviewerMessageId: 'reviewer-message-1',
+      reviewSubmissionCallId: 'review-submit-1',
+      reviewSubmissionSeq: 10,
+      reviewerAssistantSeq: 12,
+      reviewerTurn: 1,
+      reviewerStep: 1,
+      reviewerTurnEndSeq: 17,
+      reviewerSourceEventSeqs: [10, 12, 17],
+      reviewerMessageSha256: '1'.repeat(64),
+      verdict: 'request_revision',
+      findingsSha256: '2'.repeat(64),
+      changedAt: 0,
+      revisionTaskId: 'task-revision-1',
+    }
+    const review: TaskReviewEvidenceV1 = {
+      ...reviewUnsigned,
+      evidenceSha256: taskReviewEvidenceDigest(reviewUnsigned),
+    }
+    const events = withSeqs([
+      change('queue'),
+      change('admit'),
+      change('ack'),
+      change('claim'),
+      change('start'),
+      change('report', { messageId: reportRef.messageId, reportRef, payloadRef: 'devframe/execute' }),
+      { type: TASK_REVIEW_EVENT_TYPE, seq: 0, time: 0, data: review },
+      change('queue', {
+        taskId: 'task-revision-1',
+        semanticMessageId: 'semantic-revision-1',
+        reviewRef: { taskId: 'task-1', reviewEventSeq: 6, reviewEvidenceSha256: review.evidenceSha256 },
+      }),
+    ])
+    expect(foldTaskReviews(events).get('task-1')).toEqual(review)
+    expect(foldTaskBoard(events).get('task-1')?.review).toEqual(review)
+    expect(foldTaskBoard(events).get('task-revision-1')?.reviewRef).toEqual({
+      taskId: 'task-1',
+      reviewEventSeq: 6,
+      reviewEvidenceSha256: review.evidenceSha256,
+    })
+
+    const tampered = events.map(event => event.type === TASK_REVIEW_EVENT_TYPE
+      ? { ...event, data: { ...event.data, evidenceSha256: 'f'.repeat(64) } }
+      : event)
+    expect(() => foldTaskReviews(tampered)).toThrow(expect.objectContaining({ code: 'TASK_INVALID' }))
+    const selfReview = { ...review, reviewerWorkerId: review.executorWorkerId }
+    const selfReviewEvents = events.map(event => event.type === TASK_REVIEW_EVENT_TYPE
+      ? { ...event, data: { ...selfReview, evidenceSha256: taskReviewEvidenceDigest(selfReview) } }
+      : event)
+    expect(() => foldTaskReviews(selfReviewEvents)).toThrow(expect.objectContaining({ code: 'TASK_INVALID' }))
+    const duplicate = withSeqs([...events, { type: TASK_REVIEW_EVENT_TYPE, seq: 0, time: 0, data: review }])
+    expect(() => foldTaskReviews(duplicate)).toThrow(expect.objectContaining({ code: 'TASK_INVALID' }))
+  })
+})
+
+describe('Slice 1B claim adjudication arbiter (design §11.5)', () => {
+  it('rejects a claim with no semantic key as missing-key', () => {
+    expect(adjudicateClaim([], undefined)).toEqual({ kind: 'missing-key' })
+    expect(adjudicateClaim([], '')).toEqual({ kind: 'missing-key' })
+    // A key the log never admitted is also missing.
+    expect(adjudicateClaim(withSeqs([change('queue')]), 'semantic-unknown'))
+      .toEqual({ kind: 'missing-key' })
+  })
+
+  it('flags a second claim of an in-flight key as conflict', () => {
+    const claimed = withSeqs([
+      change('queue'),
+      change('admit'),
+      change('ack'),
+      change('claim'),
+    ])
+    expect(adjudicateClaim(claimed, 'semantic-1')).toEqual({ kind: 'conflict' })
+    // started also owns the key.
+    const started = withSeqs([
+      change('queue'),
+      change('admit'),
+      change('ack'),
+      change('claim'),
+      change('start'),
+    ])
+    expect(adjudicateClaim(started, 'semantic-1')).toEqual({ kind: 'conflict' })
+  })
+
+  it('flags a late claim of an executed key as duplicate', () => {
+    for (const terminal of ['report', 'fail', 'cancel', 'expire'] as const) {
+      const events = withSeqs([
+        change('queue'),
+        change('admit'),
+        change('ack'),
+        change('claim'),
+        change(terminal),
+      ])
+      expect(adjudicateClaim(events, 'semantic-1')).toEqual({ kind: 'duplicate' })
+    }
+  })
+
+  it('admits a claim while the key is queued, admitted, or acknowledged', () => {
+    const events = withSeqs([
+      change('queue'),
+      change('admit'),
+      change('ack'),
+    ])
+    expect(adjudicateClaim(events, 'semantic-1')).toEqual({ kind: 'ok' })
+  })
+})
diff --git a/packages/devframe/control-session/tests/task.spec.ts b/packages/devframe/control-session/tests/task.spec.ts
new file mode 100644
index 0000000000..bda27fdc97
--- /dev/null
+++ b/packages/devframe/control-session/tests/task.spec.ts
@@ -0,0 +1,1602 @@
+/**
+ * Slice 1B-C / 1B-D task dispatch tests: the `dispatchTask` six-state mainline
+ * (queue → admit → ack → claim → start → report) over a REAL harness Worker
+ * turn, the idempotent redispatch path, claim conflict / missing-key
+ * adjudication, the lease expiry path, the observation-hook unit drive, the
+ * taskBoard projection, and the design §11.6 negative gates.
+ */
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import Loader from '@deepseek-ai/cordis-plugin-loader'
+import Include from '@deepseek-ai/cordis-plugin-include'
+import AgentPresets from '@deepseek-ai/dsh-agent-presets'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import type {
+  Agent,
+  AgentHandle,
+  CreateAgentOptions,
+  ResumeAgentOptions,
+} from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import AgentDefaultModel from '@deepseek-ai/dsh-agent-default-model'
+import * as AgentInstructions from '@deepseek-ai/dsh-agent-instructions'
+import LocalFileSystem from '@deepseek-ai/dsh-fs-local'
+import LlmRuntime, {
+  LlmAdapter,
+  createAssistantMessage,
+  createUserMessage,
+} from '@deepseek-ai/dsh-llm'
+import type { GenerateOptions, StreamChunk, UserMessage } from '@deepseek-ai/dsh-llm'
+import JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import SessionStore, {
+  SESSION_FORMAT_VERSION,
+  Session,
+  SessionId,
+} from '@deepseek-ai/dsh-session'
+import type { SessionEvent, SessionHeader } from '@deepseek-ai/dsh-session'
+import { scopeTarget } from '@deepseek-ai/dsh-scope'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import {
+  DevFrameControlSessions,
+  buildFixedTaskPayloadText,
+  globalControllerSessionId,
+  workerSessionId,
+} from '../src/index.ts'
+import type { DevFrameControlSessionsOptions } from '../src/index.ts'
+import { foldRoster } from '../src/roster.ts'
+import {
+  TASK_EVENT_TYPE,
+  foldTask,
+  foldTaskBoard,
+  semanticKeyAdmitted,
+} from '../src/task-board.ts'
+import type { PolicyDecisionV1, TaskChangeV1 } from '../src/types.ts'
+import { POLICY_DECISION_EVENT_TYPE, POLICY_RULE_EVENT_TYPE } from '../src/policy.ts'
+import type { ContextSourceV1, PolicyRuleV1 } from '../src/policy.ts'
+
+// ---------------------------------------------------------------------------
+// REAL harness (AgentLoop + ScriptedAdapter), mirroring dispatch.spec.
+// ---------------------------------------------------------------------------
+
+class ScriptedAdapter extends LlmAdapter {
+  readonly requests: GenerateOptions[] = []
+
+  constructor(private readonly delayMs = 0) { super() }
+
+  override async *stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    this.requests.push(options)
+    if (this.delayMs > 0) await new Promise(resolve => setTimeout(resolve, this.delayMs))
+    yield { type: 'block-start', index: 0, blockType: 'text' }
+    yield { type: 'block-end', index: 0, block: { type: 'text', text: 'worker reply' } }
+    yield { type: 'finish', reason: { kind: 'stop' } }
+  }
+}
+
+interface RealHarness {
+  readonly ctx: Context
+  readonly home: string
+  readonly adapter: ScriptedAdapter
+}
+
+const realHarnesses: RealHarness[] = []
+
+async function realHarness(delayMs = 0): Promise<RealHarness> {
+  const home = await mkdtemp(join(tmpdir(), 'dsh-devframe-task-'))
+  const presetRoot = join(home, 'agent-presets')
+  await mkdir(join(presetRoot, 'standard'), { recursive: true })
+  await writeFile(join(presetRoot, 'standard', 'agent.cordis.yml'), [
+    '- id: tool-fs',
+    "  name: '@deepseek-ai/dsh-tool-fs'",
+    '',
+  ].join('\n'))
+  vi.stubEnv('DSH_HOME', home)
+  const ctx = new Context()
+  realHarnesses.push({ ctx, home, adapter: new ScriptedAdapter(delayMs) })
+  ctx.baseUrl = pathToFileURL(join(process.cwd(), 'packages/devframe/control-session')).href + '/'
+  await ctx.plugin(Loader)
+  ctx.loader.builtins.include = Include
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(LocalFileSystem, { cwd: '/' })
+  await ctx.plugin(AgentInstructions, { maxBytes: 64 * 1024 })
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(AgentDefaultModel, {
+    provider: 'deepseek-official',
+    model: 'deepseek-v4-flash',
+  })
+  await ctx.plugin(JsonlSessionPersistence, { root: join(home, 'sessions'), compression: 'none' })
+  await ctx.plugin(AgentPresets, {
+    default: 'standard',
+    roots: [{ path: presetRoot, trust: 'system' }],
+    includeUserRoot: false,
+  })
+  ctx.provide('workspaceRegistry', {
+    get: () => undefined,
+    list: () => [],
+  } as never)
+  await ctx.plugin(DevFrameControlSessions)
+  ctx.llm.registerAdapter(['deepseek-official'], realHarnesses.at(-1)!.adapter)
+  return realHarnesses.at(-1)!
+}
+
+// ---------------------------------------------------------------------------
+// FAKE harness (roster.spec style) for hook-unit and negative drives.
+// ---------------------------------------------------------------------------
+
+interface PersistedSession {
+  readonly meta: SessionHeader
+  readonly events: readonly SessionEvent[]
+}
+
+type FlushOutcome = boolean | Error
+
+interface FakeHarnessOptions {
+  readonly persisted?: ReadonlyMap<SessionId, PersistedSession>
+  readonly flushOutcomes?: readonly FlushOutcome[]
+  /**
+   * Delivery seam: what the Worker Agent's `followup` does with a relayed
+   * message. Default appends the `agent/inbox/spliced` insert and emits
+   * `session/event` (the real inbox behavior); passing a no-op simulates a
+   * delivery that never persists (DISPATCH_NOT_ACKNOWLEDGED).
+   */
+  readonly followup?: (session: Session, message: UserMessage) => void
+  /**
+   * Host-side Slice 1C-C slot configuration (design §12.3 role template): lets
+   * tests drive the CONTEXT_* fail-closed rows of the §12.6 negative table
+   * through the REAL dispatch path.
+   */
+  readonly controlOptions?: DevFrameControlSessionsOptions
+}
+
+const fakeContexts: Context[] = []
+const fakeDirs: string[] = []
+
+function fakeHeader(id: SessionId, cwd?: string): SessionHeader {
+  return {
+    version: SESSION_FORMAT_VERSION,
+    id,
+    createdAt: 1,
+    ...cwd === undefined ? {} : { cwd },
+  }
+}
+
+function createToolHooks() {
+  return {
+    restrict: vi.fn((_filter: { readonly allow?: readonly string[]; readonly deny?: readonly string[] }) => () => undefined),
+    guard: vi.fn((_guard: (execution: unknown) => string | undefined) => () => undefined),
+  }
+}
+
+/** Emit one `session/event` exactly like the SessionStore does (scoped carrier). */
+function emitSessionEvent(ctx: Context, session: Session, event: SessionEvent): void {
+  ctx.emit(scopeTarget(session, undefined), 'session/event', session, event as never)
+}
+
+function defaultFollowup(ctx: Context) {
+  return (session: Session, message: UserMessage): void => {
+    const event = session.append('agent/inbox/spliced', {
+      target: 'next-turn',
+      start: 0,
+      inserted: [message],
+    })
+    emitSessionEvent(ctx, session, event)
+  }
+}
+
+function fakeSetup(options: FakeHarnessOptions = {}) {
+  const ctx = new Context()
+  fakeContexts.push(ctx)
+  const persisted = new Map(options.persisted ?? [])
+  const flushOutcomes = [...options.flushOutcomes ?? [true]]
+  const pendingHeaders = new Map<SessionId, SessionHeader>()
+  const liveAgents = new Map<SessionId, Agent>()
+  const liveSessions = new Map<SessionId, Session>()
+  const liveHandles = new Map<SessionId, AgentHandle>()
+  const publications: Array<{ agent: Agent }> = []
+  const disposedAgents: Agent[] = []
+  const toolsByAgent = new Map<SessionId, ReturnType<typeof createToolHooks>>()
+  const followup = options.followup ?? defaultFollowup(ctx)
+
+  const publish = async (
+    session: Session,
+    agentSetup: CreateAgentOptions['setup'],
+  ): Promise<AgentHandle> => {
+    const tools = createToolHooks()
+    const mutableAgent = {
+      id: session.id,
+      session,
+      ctx,
+      followup: vi.fn((message: UserMessage) => { followup(session, message) }),
+    }
+    const agent = mutableAgent as unknown as Agent
+    mutableAgent.ctx = ctx.extend({ agent, tools })
+    const setupCommit = await agentSetup?.(mutableAgent.ctx)
+    setupCommit?.commit()
+    publications.push({ agent })
+    toolsByAgent.set(session.id, tools)
+    liveSessions.set(session.id, session)
+    liveAgents.set(session.id, agent)
+    let disposed = false
+    const handle: AgentHandle = {
+      agent,
+      dispose: vi.fn(async () => {
+        if (disposed) return
+        disposed = true
+        disposedAgents.push(agent)
+        if (liveAgents.get(session.id) === agent) liveAgents.delete(session.id)
+        if (liveSessions.get(session.id) === session) liveSessions.delete(session.id)
+        if (liveHandles.get(session.id) === handle) liveHandles.delete(session.id)
+      }),
+    }
+    liveHandles.set(session.id, handle)
+    return handle
+  }
+
+  const create = vi.fn(async (agentOptions: CreateAgentOptions): Promise<AgentHandle> => {
+    const session = Session.create(
+      agentOptions.sessionId,
+      agentOptions.seed,
+      fakeHeader(agentOptions.sessionId, agentOptions.meta?.cwd),
+    )
+    return publish(session, agentOptions.setup)
+  })
+  const resume = vi.fn(async (agentOptions: ResumeAgentOptions): Promise<AgentHandle> => {
+    const record = persisted.get(agentOptions.resumeSessionId)
+    if (record === undefined) throw new Error('persisted session not found')
+    const session = Session.fromRestore(
+      agentOptions.resumeSessionId,
+      structuredClone(record.events),
+      structuredClone(record.meta),
+    )
+    return publish(session, agentOptions.setup)
+  })
+  const agents = {
+    get: (id: SessionId) => liveAgents.get(id),
+    create,
+    resume,
+  }
+  const flush = vi.fn(async (session: Session): Promise<boolean> => {
+    expect(liveSessions.get(session.id)).toBe(session)
+    const outcome = flushOutcomes.shift() ?? true
+    if (outcome instanceof Error) throw outcome
+    return outcome
+  })
+  const sessions = {
+    get: (id: SessionId) => liveSessions.get(id),
+    prepare: (id: SessionId, options?: {
+      readonly meta?: { readonly cwd?: string; readonly agentPreset?: string }
+    }) => Session.create(id, undefined, fakeHeader(id, options?.meta?.cwd)),
+    flush,
+  }
+  const list = vi.fn(async () => [...persisted.values()].map(record => structuredClone(record.meta)))
+  const persistenceCreate = vi.fn(async (meta: SessionHeader) => {
+    if (persisted.has(meta.id) || pendingHeaders.has(meta.id)) throw new Error('identity already exists')
+    pendingHeaders.set(meta.id, structuredClone(meta))
+  })
+  const persistenceAppend = vi.fn(async (id: SessionId, events: readonly SessionEvent[]) => {
+    const meta = pendingHeaders.get(id)
+    if (meta === undefined) throw new Error('identity was not created')
+    persisted.set(id, {
+      meta: structuredClone(meta),
+      events: structuredClone(events),
+    })
+    pendingHeaders.delete(id)
+  })
+
+  ctx.provide('agents', agents as never)
+  ctx.provide('sessions', sessions as never)
+  ctx.provide('sessionPersistence', {
+    list,
+    create: persistenceCreate,
+    append: persistenceAppend,
+  } as never)
+  ctx.provide('agentPresets', {
+    resolve: vi.fn(async (id?: string) => ({
+      id: id ?? 'standard',
+      path: 'test-only',
+      trust: 'system' as const,
+    })),
+    mount: vi.fn(async (_agentCtx: Context, id?: string) => ({
