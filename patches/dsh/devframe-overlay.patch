+    if (phase === null) {
+      if (item.phase === undefined) item.phase = null
+      return
+    }
+    if (item.phase !== undefined && item.phase !== null && item.phase !== phase) {
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex changed an agent message phase')
+    }
+    item.phase = phase
+  }
