+    if (thread.ephemeral !== false) throw new CodexRuntimeError('CODEX_RESUME_MISMATCH', 'Codex resume returned an invalid thread lifetime')
+    const actualModel = modelId(response.model, 'thread/resume model')
+    if (actualModel !== model) throw new CodexRuntimeError('CODEX_RESUME_MISMATCH', 'Codex resume changed the requested model')
+    if (response.modelProvider !== 'openai') throw new CodexRuntimeError('CODEX_RESUME_MISMATCH', 'Codex resume changed the requested provider')
