+/**
+ * Host-owned Codex login contract. The wire exposes only a
+ * bounded DSH attempt identity and sanitized availability/state values.
+ */
+
+import type { Branded } from '@deepseek-ai/dsh-brand'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { RpcRequest, RpcResponse } from './rpc.ts'
+
+/** Opaque DSH-owned identity for one bounded login attempt. */
+export type CodexAttemptId = Branded<'codex-attempt-id'>
+
+/** The five public failure categories for Codex login operations. */
+export type CodexLoginErrorCode =
+  | 'CODEX_LOGIN_NOT_FOUND'
+  | 'CODEX_LOGIN_ALREADY_ACTIVE'
+  | 'CODEX_LOGIN_PROTOCOL_ERROR'
+  | 'CODEX_LOGIN_PROCESS_ERROR'
+  | 'CODEX_LOGIN_CANCELLED'
+
+/** Discriminant values for a login attempt's lifecycle state. */
+export type CodexLoginState = 'pending' | 'completed' | 'cancelled' | 'failed'
+
+/** Host-visible availability of the Codex subscription route. */
+export type CodexAvailability =
+  | { availability: 'ready' }
+  | { availability: 'login-required' }
+  | { availability: 'unsupported' }
+  | { availability: 'unavailable'; errorCode: 'CODEX_LOGIN_PROTOCOL_ERROR' | 'CODEX_LOGIN_PROCESS_ERROR' }
+
+/** Sanitized status of one DSH-owned login attempt. */
+export type CodexLoginAttemptStatus =
+  | { attemptId: CodexAttemptId; state: 'pending' }
+  | { attemptId: CodexAttemptId; state: 'completed' }
+  | { attemptId: CodexAttemptId; state: 'cancelled'; errorCode: 'CODEX_LOGIN_CANCELLED' }
+  | {
+    attemptId: CodexAttemptId
+    state: 'failed'
+    errorCode: Exclude<CodexLoginErrorCode, 'CODEX_LOGIN_CANCELLED'>
+  }
+
+/** Value returned by status: route availability or a requested attempt status. */
+export type CodexStatusValue = CodexAvailability | CodexLoginAttemptStatus
+
+/** Value returned by loginStart; failure never carries start-only fields. */
+export type CodexLoginStartValue =
+  | { kind: 'success'; attemptId: CodexAttemptId; authUrl: string }
+  | { kind: 'failure'; errorCode: CodexLoginErrorCode }
+
+/** Request for route availability or one attempt's status. */
+export interface CodexStatusRequest {
+  sessionId: SessionId
+  attemptId?: CodexAttemptId
+}
+
+/** Request to start one login attempt for a session. */
+export interface CodexLoginStartRequest {
+  sessionId: SessionId
+}
+
+/** Request to cancel one login attempt for a session. */
+export interface CodexLoginCancelRequest {
+  sessionId: SessionId
+  attemptId: CodexAttemptId
+}
+
+/** Host Codex login methods exposed through the RPC contract. */
+export interface CodexApi {
+  /**
+   * Reads route availability, or the attempt status named by the optional id.
+   * @param request - Session and optional DSH attempt identity.
+   * @param signal - Optional cancellation for provider inspection.
+   * @returns A sanitized availability or attempt status value.
+   */
+  status(
+    request: RpcRequest<CodexStatusRequest>,
+    signal?: AbortSignal,
+  ): Promise<RpcResponse<CodexStatusValue>>
+
+  /**
+   * Starts one bounded login attempt.
