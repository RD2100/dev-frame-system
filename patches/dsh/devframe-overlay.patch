+/**
+ * Keep the production Codex process specification fixed while substituting
+ * only the executable with the test-only JSON-RPC app-server fixture.
+ */
+class LocalSubprocessRuntime extends SubprocessRuntime {
+  override spawn(spec: SubprocessSpawnSpec): SubprocessHandle {
+    const spawnOrdinal = observedSpawnCount + 1
+    observedSpawnCount = spawnOrdinal
+    // Validate the production launch boundary without importing a source file
+    // from another composite project (which would make the web typecheck
+    // rewrite a cross-project `.ts` path unsafely).
+    expect(spec.argv[0]).toBe(process.execPath)
+    expect(spec.argv[1]).toMatch(/[\\/]codex\.js$/)
+    expect(spec.argv).toContain('app-server')
+    expect(spec.argv.at(-1)).toBe('--stdio')
+    expect(spec.argv.some(arg => arg.startsWith('chatgpt_base_url='))).toBe(true)
+    expect(spec.argv.some(arg => arg.startsWith('openai_base_url='))).toBe(true)
+    expect(spec.stdio.stdin).toBe('pipe')
+    expect(spec.stdio.stdout).toBe('pipe')
+    const { stderr } = spec.stdio
+    if (typeof stderr !== 'object' || stderr === null) {
+      throw new Error('Codex spawn stderr must use bounded collection mode')
+    }
+    expect(typeof stderr.maxBytes).toBe('number')
+    expect(spec.cwd).toBe(expectedWorkspaceCwd)
+    expect(spec.env?.CODEX_HOME).toBe(expectedCodexHome)
+    expect(spec.env?.OPENAI_API_KEY).toBeUndefined()
+    expect(spec.env?.OPENAI_ACCESS_TOKEN).toBeUndefined()
+    expect(spec.env?.DEEPSEEK_API_KEY).toBeUndefined()
+    expect(spec.env?.OPENAI_BASE_URL).toBeUndefined()
+    expect(spec.env?.CODEX_BASE_URL).toBeUndefined()
+    expect(spec.env?.NODE_OPTIONS).toBeUndefined()
+    expect(spec.env?.NODE_PATH).toBeUndefined()
+    const child = super.spawn({
+      ...spec,
+      argv: [
+        process.execPath,
+        fileURLToPath(new URL('./fixtures/fake-codex-subscription-app-server.mjs', import.meta.url)),
+      ],
+    })
+    return child
+  }
+}
+
+/** Make the capability probe report login-required without touching real auth. */
+class AuthRequiredSubprocessRuntime extends LocalSubprocessRuntime {
+  override spawn(spec: SubprocessSpawnSpec): SubprocessHandle {
+    return super.spawn({
+      ...spec,
+      env: { ...spec.env, DSH_TEST_FIXTURE_REQUIRE_AUTH: '1' },
+    })
+  }
+}
+
+/** Arm the first live process for a deterministic crash, then require resume. */
+class CrashResumeSubprocessRuntime extends LocalSubprocessRuntime {
+  private crashArmed = false
+  private resumeOnly = false
+  private crashObserved = Promise.resolve()
+  private resolveCrash: (() => void) | undefined
+
+  armCrash(): void {
+    this.crashArmed = true
+    this.resumeOnly = false
+    this.crashObserved = new Promise<void>((resolve) => {
+      this.resolveCrash = resolve
+    })
+  }
+
+  waitForCrash(): Promise<void> {
+    return this.crashObserved
+  }
+
+  override spawn(spec: SubprocessSpawnSpec): SubprocessHandle {
+    const env = {
+      ...spec.env,
+      ...(this.crashArmed ? { DSH_TEST_FIXTURE_CRASH_AFTER_START: '1' } : {}),
+      ...(this.resumeOnly ? { DSH_TEST_FIXTURE_RESUME_ONLY: '1' } : {}),
+    }
+    const child = super.spawn({ ...spec, env })
+    void child.done.then((outcome) => {
+      if (outcome.exitCode !== 17) return
+      this.crashArmed = false
+      this.resumeOnly = true
+      this.resolveCrash?.()
+      this.resolveCrash = undefined
+    }, () => undefined)
+    return child
+  }
+}
