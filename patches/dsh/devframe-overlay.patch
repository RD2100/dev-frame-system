+import type { DevFrameHealthSnapshot } from '@deepseek-ai/dsh-devframe-control-session/types'
+import type { TranslateNS } from '@deepseek-ai/dsh-client-ui-slots'
+import { NS } from './locales.ts'
+import css from './HealthCard.module.css'
+
+/** Props for the Slice 0 Health card. */
+export interface HealthCardProps {
+  readonly health: DevFrameHealthSnapshot | undefined
+  readonly t: TranslateNS<typeof NS>
+  /** Optional title and item filter for a focused health projection. */
+  readonly title?: string
+  readonly itemIds?: readonly string[]
+  /** Bounded operator guidance shown below a successful projection. */
+  readonly note?: string
+}
+
+/** One checklist row: status dot, stable id, and bounded guidance. */
+function HealthItem({ item, t }: {
+  item: DevFrameHealthSnapshot['items'][number]
+  t: TranslateNS<typeof NS>
+}) {
+  return (
+    <li className={css.item}>
+      <span className={`${css.dot} ${css[item.status]}`} aria-hidden="true" />
+      <span className={css.id}>{item.id}</span>
+      <span className={css.status}>{t(`health.${item.status}`)}</span>
+      {item.reason !== undefined && <span className={css.reason}>{item.reason}</span>}
+      {item.impact !== undefined && <span className={css.impact}>{t('health.impact')}: {item.impact}</span>}
+      {item.action !== undefined && <span className={css.action}>{t('health.action')}: {item.action}</span>}
+    </li>
+  )
+}
+
+/** Pathless Slice 0 Health checklist card for the Global Controller entry. */
+export function HealthCard({ health, t, title = t('global.health'), itemIds, note }: HealthCardProps) {
+  if (health === undefined) {
+    return (
+      <div className={css.card} role="status">
+        <span className={css.title}>{title}</span>
+        <span className={css.unavailable}>{t('health.unavailable')}</span>
+      </div>
+    )
+  }
+  const items = itemIds === undefined
+    ? health.items
+    : health.items.filter(item => itemIds.includes(item.id))
+  return (
+    <div className={css.card} role="status">
+      <span className={css.title}>{title}</span>
+      {items.length === 0
+        ? <span className={css.unavailable}>{t('health.unavailable')}</span>
+        : <ul className={css.list}>
+          {items.map(item => <HealthItem key={item.id} item={item} t={t} />)}
+        </ul>}
+      {note !== undefined && <span className={css.unavailable}>{note}</span>}
+    </div>
+  )
+}
