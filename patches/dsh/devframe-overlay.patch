+
+  it('serializes concurrent binds on the same workspace: exactly one wins', async () => {
+    const fixture = workspaceFixture(resolve('registered-workspace'))
+    const test = setup({ workspace: fixture.workspace })
+    await test.controller.openProject({ profileId: 'profile-1', workspaceId: 'workspace-1' })
+
+    const results = await Promise.allSettled([
+      test.controller.bindProjectAuthority({
+        profileId: 'profile-1',
