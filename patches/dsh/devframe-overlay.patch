+
+  it('recalls once per turn but not on a tool continuation step', async () => {
+    memory.readProjectMemory.mockResolvedValue(currentPlan())
+    const adapter = new MockAdapter([
+      toolCallResponse('tick-1', 'tick', {}),
+      textResponse('done'),
+    ])
+    const { ctx, agent } = await loopHarness(adapter)
+    ctx.tools.register(defineContentToolFixture({
+      name: 'tick',
+      description: 'test continuation',
+      parameters: {},
+      execute: async () => [{ type: 'text' as const, text: 'ok' }],
+    }))
+
+    agent.followup(createUserMessage({
+      content: [{ type: 'text', text: 'go' }],
+      source: { kind: 'user' },
+    }))
+    await agent.whenIdle()
+
+    const recalls = agent.session.events.filter(event => (
