+async function probeCapability(
+  app: DirectAppServer,
+  method: CapabilityObservation['method'],
+): Promise<CapabilityObservation> {
+  try {
+    const response = object(await app.transport.request(method, {}), `${method} response`)
+    if (method === 'model/list') {
+      const modelIds: string[] = []
+      const modelDisplayNames: string[] = []
+      let defaultModelId: string | undefined
+      const entries = Array.isArray(response.data) ? response.data.slice(0, 64) : []
+      for (const entry of entries) {
+        if (entry === null || typeof entry !== 'object' || Array.isArray(entry)) continue
+        const model = entry as JsonObject
+        const id = typeof model.id === 'string' && model.id.length > 0
+          ? model.id
+          : typeof model.model === 'string' && model.model.length > 0 ? model.model : undefined
+        if (id !== undefined) {
+          modelIds.push(id)
+          if (model.isDefault === true) defaultModelId = id
+        }
+        if (typeof model.displayName === 'string' && model.displayName.length > 0) {
+          modelDisplayNames.push(model.displayName)
+        }
+      }
+      return {
+        method,
+        status: 'available',
+        modelIds: [...new Set(modelIds)],
+        modelDisplayNames: [...new Set(modelDisplayNames)],
+        ...(defaultModelId === undefined ? {} : { defaultModelId }),
+      }
+    }
+    const account = response.account
+    const accountObject = account !== null && typeof account === 'object' && !Array.isArray(account)
+      ? account as JsonObject
+      : undefined
+    const authModeValue = response.authMode ?? accountObject?.type
+    const authMode = authModeValue === 'apiKey' || authModeValue === 'api_key'
+      ? 'apiKey'
+      : authModeValue === 'chatgpt' || authModeValue === 'oauth' || authModeValue === 'none'
+        ? authModeValue
+        : undefined
+    const planTypeValue = response.planType ?? accountObject?.planType
+    const planType = planTypeValue === 'free'
+      || planTypeValue === 'plus'
+      || planTypeValue === 'pro'
+      || planTypeValue === 'business'
+      || planTypeValue === 'edu'
+      || planTypeValue === 'enterprise'
+      ? planTypeValue
+      : undefined
+    return {
+      method,
+      status: 'available',
+      accountPresent: account !== null && account !== undefined,
+      ...(typeof response.requiresOpenaiAuth === 'boolean'
+        ? { requiresOpenaiAuth: response.requiresOpenaiAuth }
+        : {}),
+      ...(authMode === undefined ? {} : { authMode }),
+      ...(planType === undefined ? {} : { planType }),
+    }
+  } catch (error: unknown) {
+    return { method, status: 'rejected', error: capabilityError(error) }
+  }
+}
+
+async function startThread(app: DirectAppServer): Promise<{ readonly id: string; readonly ephemeral: boolean }> {
+  const result = object(await app.transport.request('thread/start', {
+    cwd: app.cwd,
+    ephemeral: false,
+  }), 'thread/start result')
+  const thread = object(result.thread, 'thread/start thread')
+  return {
+    id: string(thread.id, 'thread/start thread id'),
+    ephemeral: thread.ephemeral === true,
+  }
+}
+
+async function resumeThread(
+  app: DirectAppServer,
+  threadId: string,
+): Promise<{
+  readonly status: 'available' | 'rejected'
+  readonly id?: string
+  readonly error?: { readonly code: number | undefined; readonly category: 'rpc-error' | 'transport-error' | 'thread-id-mismatch' }
+}> {
+  try {
+    const result = object(await app.transport.request('thread/resume', { threadId }), 'thread/resume result')
+    const thread = object(result.thread, 'thread/resume thread')
+    const resumedId = string(thread.id, 'thread/resume thread id')
+    if (resumedId !== threadId) {
+      return {
+        status: 'rejected',
+        error: {
+          code: undefined,
+          category: 'thread-id-mismatch',
+        },
+      }
+    }
+    return { status: 'available', id: resumedId }
+  } catch (error: unknown) {
+    const failure = capabilityError(error)
+    return { status: 'rejected', error: { ...failure } }
+  }
+}
+
+async function runTurn(
+  app: DirectAppServer,
+  threadId: string,
+  text: string,
+): Promise<{ readonly id: string; readonly frames: readonly ObservedFrame[] }> {
+  const startIndex = app.events.length
+  const result = object(await app.transport.request('turn/start', {
+    threadId,
+    input: [{ type: 'text', text, text_elements: [] }],
+  }), 'turn/start result')
+  const turn = object(result.turn, 'turn/start turn')
+  const turnId = string(turn.id, 'turn/start turn id')
+  await waitFor(
+    () => app.events.slice(startIndex).find(event => (
+      event.method === 'turn/completed'
+      && event.params.threadId === threadId
+      && object(event.params.turn, 'turn/completed turn').id === turnId
+    )),
+    `turn/completed ${turnId}`,
+  )
+  return { id: turnId, frames: app.events.slice(startIndex) }
+}
+
+function finalAgentMessage(frames: readonly ObservedFrame[]): string | undefined {
+  for (const frame of frames) {
+    if (frame.method !== 'item/completed') continue
+    const item = object(frame.params.item, 'item/completed item')
+    if (item.type === 'agentMessage' && (item.phase === 'final_answer' || item.phase === null) && typeof item.text === 'string') {
+      return item.text
+    }
+  }
+  return undefined
+}
+
+function hasMarkerReference(body: JsonObject, marker: string): boolean {
+  if (JSON.stringify(body).includes(marker)) return true
+  return typeof body.previous_response_id === 'string' && body.previous_response_id.length > 0
+}
+
+function collectedStderr(app: DirectAppServer): string {
+  return app.child.collected.stderr?.readFrom(0).text ?? ''
+}
