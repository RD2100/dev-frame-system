--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/ProjectPicker.tsx
@@ -0,0 +1,116 @@
+import { useState } from 'react'
+import type { WorkspaceId, WorkspaceListState } from '@deepseek-ai/dsh-client-runtime/client'
+import type { SnapshotSelectorHook, TranslateNS } from '@deepseek-ai/dsh-client-ui-slots'
+import type { DevFrameProjectAuthorityView } from '@deepseek-ai/dsh-devframe-control-session/types'
+import type { ProjectAuthorityState } from './authority.ts'
+import { NS } from './locales.ts'
+import css from './ProjectPicker.module.css'
+
+/** Props for the Project Controller picker. */
+export interface ProjectPickerProps {
+  /** Read the workspace catalog through the framework-bound hook. */
+  useWorkspaces: SnapshotSelectorHook<WorkspaceListState>
+  /** Open the workspace-scoped Project Controller through the Host Remote. */
+  openProjectController: (workspaceId: WorkspaceId) => void
+  /** Read the per-workspace authority projections through the framework-bound hook. */
+  useProjectAuthority: SnapshotSelectorHook<ProjectAuthorityState>
+  /**
+   * CAS-bind project authority for one workspace; resolves when the Host
+   * Remote return settles (success or conflict), clearing the busy state.
+   */
+  bindProjectAuthority: (workspaceId: WorkspaceId) => Promise<void>
+  t: TranslateNS<typeof NS>
+}
+
+/**
+ * Compact authority badge text, pathless and credential-free (design §10.3).
+ * An undefined view (refresh not delivered yet) renders no badge rather than
+ * claiming a fabricated state.
+ */
+function authorityBadge(
+  view: DevFrameProjectAuthorityView | undefined,
+  t: TranslateNS<typeof NS>,
+): string | undefined {
+  if (view === undefined) return undefined
+  if (view.status === 'bound') {
+    const revision = view.boundRevision === undefined
+      ? ''
+      : ` · ${t('project.boundRevision')} ${view.boundRevision}`
+    const resume = view.resumePointer === undefined
+      ? ''
+      : ` · ${t('project.boundResume')} ${view.resumePointer}`
+    return `${t('project.bound')}${revision}${resume}`
+  }
+  return view.status === 'expired' ? t('project.expired') : t('project.notBound')
+}
+
+/** Pick one native Workspace, inspect its authority, and open its Project Controller. */
+export function ProjectPicker({
+  useWorkspaces, openProjectController, useProjectAuthority, bindProjectAuthority, t,
+}: ProjectPickerProps) {
+  const workspaces = useWorkspaces(state => state.items)
+  const authority = useProjectAuthority(state => state)
+  const [bindingId, setBindingId] = useState<WorkspaceId | undefined>(undefined)
+  if (workspaces.length === 0) {
+    return (
+      <div className={css.panel} role="status">
+        <span className={css.title}>{t('global.projectController')}</span>
+        <span className={css.empty}>{t('project.empty')}</span>
+      </div>
+    )
+  }
+  return (
+    <div className={css.panel} role="status">
+      <span className={css.title}>{t('global.projectController')}</span>
+      <ul className={css.list}>
+        {workspaces.map((workspace) => {
+          const view = authority[workspace.workspaceId]
+          const busy = bindingId === workspace.workspaceId
+          // Bind is offered while the row is not bound; an undefined view
+          // (authority not delivered yet) still offers it — the Host CAS
+          // reconciles a stale proposal and the follow-up refresh surfaces
+          // the true state.
+          const bindable = view === undefined || view.status !== 'bound'
+          return (
+            <li key={workspace.workspaceId} className={css.row}>
+              <span className={css.name}>{workspace.title}</span>
+              {view !== undefined && (
+                <span className={`${css.badge} ${
+                  view.status === 'bound'
+                    ? css.badgeBound
+                    : view.status === 'expired'
+                      ? css.badgeExpired
+                      : css.badgeNone
+                }`}>
+                  {authorityBadge(view, t)}
+                </span>
+              )}
+              {bindable && (
+                <button
+                  type="button"
+                  className={css.bind}
+                  disabled={busy}
+                  onClick={() => {
+                    setBindingId(workspace.workspaceId)
+                    void bindProjectAuthority(workspace.workspaceId).finally(() => {
+                      setBindingId(current => current === workspace.workspaceId ? undefined : current)
+                    })
+                  }}
+                >
+                  {busy ? t('project.bindBusy') : t('project.bind')}
+                </button>
+              )}
+              <button
+                type="button"
+                className={css.open}
+                onClick={() => { openProjectController(workspace.workspaceId) }}
+              >
+                {t('project.open')}
+              </button>
+            </li>
+          )
+        })}
+      </ul>
+    </div>
+  )
+}
