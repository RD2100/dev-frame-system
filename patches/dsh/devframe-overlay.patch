+        throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex streamed answer was not the completed final answer')
+      }
+      return
+    }
+    state.queue.push({ type: 'block-start', index: 0, blockType: 'text' })
+    state.queue.push({ type: 'text-delta', index: 0, text: selected.text })
+  }
+
+  private approvalDecision(params: JsonObject): 'cancel' | 'decline' {
+    if (params.availableDecisions === undefined || params.availableDecisions === null) return 'decline'
+    if (!Array.isArray(params.availableDecisions) || params.availableDecisions.some(decision => typeof decision !== 'string')) {
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex approval decisions were invalid')
+    }
+    if (params.availableDecisions.includes('cancel')) return 'cancel'
+    if (params.availableDecisions.includes('decline')) return 'decline'
+    throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex offered no safe approval decision')
+  }
+
+  private handleRequest(method: string, params: JsonObject): Promise<unknown> {
+    try {
+      const kind = method === 'item/commandExecution/requestApproval'
+        ? 'command'
+        : method === 'item/fileChange/requestApproval'
+          ? 'file-change'
+          : method === 'item/permissions/requestApproval'
+            ? 'permissions'
+            : method === 'item/tool/requestUserInput'
+              ? 'user-input'
+              : method === 'mcpServer/elicitation/request'
+                ? 'elicitation'
+                : 'unknown'
+      const state = this.ensureCoordinates(params, true, kind === 'elicitation')
+      if (kind === 'unknown') throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex sent an unsupported server request')
+      const decision = kind === 'command' || kind === 'file-change'
+        ? this.approvalDecision(params)
+        : kind === 'elicitation' ? 'decline' : 'empty'
+      state.onActionRejected(kind, decision)
+      if (kind === 'permissions') return Promise.resolve({ permissions: {}, scope: 'turn' })
+      if (kind === 'user-input') return Promise.resolve({ answers: {} })
+      if (kind === 'elicitation') return Promise.resolve({ action: 'decline', content: null, _meta: null })
+      return Promise.resolve({ decision })
+    } catch (error: unknown) {
+      const normalized = sanitizedProtocolError(error)
+      this.fail(normalized)
+      return Promise.reject(normalized)
+    }
+  }
+
+  private handleNotification(method: string, params: JsonObject): void {
+    if (method === 'error') {
+      const active = this.ensureCoordinates(params, true)
+      if (params.willRetry !== undefined && typeof params.willRetry !== 'boolean') {
+        throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex error retry flag was invalid')
+      }
+      const error = params.error === undefined ? undefined : asObject(params.error, 'Codex turn error')
+      // The app-server may emit transient upstream errors (for example while
+      // reconnecting) before the terminal turn/completed notification. Keep
+      // the turn alive when it explicitly promises an automatic retry.
+      if (params.willRetry === true) return
+      active.turnFailure = codexTurnFailure(error)
+      return
+    }
+    if (!this.knownNotifications.has(method)) {
+      this.diagnostics?.onUnknownNotification?.(method)
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex sent an unknown notification')
+    }
+    if (method === 'item/plan/delta') {
+      this.ensureCoordinates(params, true)
+      nonEmptyString(params.itemId, 'plan item id')
+      if (typeof params.delta !== 'string' || params.delta.length > MAX_STRING_LENGTH) {
+        throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex plan delta was invalid')
+      }
+      return
+    }
+    if (method === 'turn/started') {
+      const turn = asObject(params.turn, 'turn/started turn')
+      const id = opaqueId(turn.id, 'turn/started turn id')
+      const active = this.ensureCoordinates({ ...params, turnId: id }, true)
+      if (active.turnId !== undefined && active.turnId !== id) throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex turn/start mismatch')
+      return
+    }
+    if (method === 'turn/completed') {
+      const turn = asObject(params.turn, 'turn/completed turn')
+      const id = opaqueId(turn.id, 'turn/completed turn id')
+      const active = this.ensureCoordinates({ ...params, turnId: id }, true)
+      const status = turn.status
+      if (status !== 'completed' && status !== 'interrupted' && status !== 'failed') {
+        throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex turn status was invalid')
+      }
+      if (status === 'failed' && active.turnFailure === undefined && turn.error !== undefined) {
+        active.turnFailure = codexTurnFailure(asObject(turn.error, 'Codex turn completion error'))
+      }
+      if (status === 'completed') this.emitCompletedText(active)
+      active.queue.push({
+        type: 'finish',
+        reason: status === 'completed'
+          ? { kind: 'stop' }
+          : status === 'interrupted'
+            ? { kind: 'aborted', failure: { message: 'Codex turn was interrupted', code: 'CODEX_CANCELLED' } }
+            : { kind: 'error', failure: active.turnFailure ?? { message: 'Codex turn failed', code: 'CODEX_PROCESS_ERROR' } },
+      })
+      active.queue.end()
+      this.state = undefined
+      return
+    }
+    if (method === 'item/reasoning/summaryPartAdded') {
+      const active = this.ensureCoordinates(params, true)
+      const itemId = nonEmptyString(params.itemId, 'reasoning summary item id')
+      const summaryIndex = boundedInteger(params.summaryIndex, 'reasoning summary index', MAX_OUTPUT_ITEMS)
+      this.observeReasoningSummaryPart(active, itemId, summaryIndex)
+      return
+    }
+    if (method === 'item/reasoning/summaryTextDelta') {
+      const active = this.ensureCoordinates(params, true)
+      const itemId = nonEmptyString(params.itemId, 'reasoning summary item id')
+      const summaryIndex = boundedInteger(params.summaryIndex, 'reasoning summary index', MAX_OUTPUT_ITEMS)
+      this.emitReasoningSummaryDelta(active, itemId, summaryIndex, params.delta)
+      return
+    }
+    if (!['item/agentMessage/delta', 'item/completed', 'item/started'].includes(method)) {
+      if (this.threadId !== undefined && params.threadId !== undefined && params.threadId !== this.threadId) {
+        throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex sent a cross-thread lifecycle frame')
+      }
+      return
+    }
+    const active = this.ensureCoordinates(params, true)
+    if (method === 'item/agentMessage/delta') {
+      const itemId = nonEmptyString(params.itemId, 'agent message item id')
+      const item = this.ensureItem(active, itemId)
+      if (item.completed) throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex sent a delta after item completion')
+      if (item.type !== undefined && item.type !== 'agentMessage') {
+        throw new CodexRuntimeError('CODEX_UNSUPPORTED_CONTENT', 'Codex returned a non-message text delta')
+      }
+      item.type = 'agentMessage'
+      if (params.phase !== undefined) this.setMessagePhase(item, this.messagePhase(params.phase))
+      this.observeFinalAnswer(active, item)
+      this.appendItemText(active, item, params.delta, true)
+      if (typeof params.delta === 'string' && item.phase === 'final_answer') {
+        this.emitFinalDelta(active, item, params.delta)
+      }
+      return
+    }
+    if (method === 'item/started') {
+      const item = asObject(params.item, 'item/started item')
+      if (typeof item.type !== 'string') throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex item type was invalid')
+      if (!SUPPORTED_THREAD_ITEM_TYPES.has(item.type)) {
+        throw new CodexRuntimeError('CODEX_UNSUPPORTED_CONTENT', 'Codex returned an unsupported action item')
+      }
+      const itemId = nonEmptyString(item.id, 'item/started item id')
+      const stateItem = this.ensureItem(active, itemId)
+      if (stateItem.type !== undefined && stateItem.type !== item.type) {
+        throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex changed an item type')
+      }
+      stateItem.type = item.type
+      if (item.type === 'agentMessage' && item.phase !== undefined) {
+        this.setMessagePhase(stateItem, this.messagePhase(item.phase))
+        this.observeFinalAnswer(active, stateItem)
+      }
+      return
+    }
+    if (method === 'item/completed') {
+      const item = asObject(params.item, 'item/completed item')
+      if (typeof item.type !== 'string') throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex item type was invalid')
+      if (!SUPPORTED_THREAD_ITEM_TYPES.has(item.type)) {
+        throw new CodexRuntimeError('CODEX_UNSUPPORTED_CONTENT', 'Codex returned an unsupported action item')
+      }
+      const itemId = nonEmptyString(item.id, 'item/completed item id')
+      const stateItem = this.ensureItem(active, itemId)
+      if (stateItem.completed) throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex completed an item twice')
+      if (stateItem.type !== undefined && stateItem.type !== item.type) {
+        throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex changed an item type')
+      }
+      stateItem.type = item.type
+      if (item.type !== 'agentMessage') {
+        stateItem.completed = true
+        return
+      }
+      if (item.phase !== undefined) this.setMessagePhase(stateItem, this.messagePhase(item.phase))
+      this.observeFinalAnswer(active, stateItem)
+      this.validateCompletedText(active, stateItem, item.text)
+      stateItem.completed = true
+      return
+    }
+  }
+}
+
+/** Keep the exported bound visible to tests and package consumers. */
+export const MAX_CODEX_STDERR_BYTES = CODEX_STDERR_MAX_BYTES
+
+/** Internal completion projection; the official error text is deliberately dropped. */
+export interface CodexChatgptLoginCompleted {
+  readonly success: boolean
+}
+
+/**
+ * Narrow account-login adapter for the official ChatGPT browser flow.
+ *
+ * This is intentionally separate from the text-turn adapter: it exposes no
+ * generic request method, stores no raw error, and only accepts the exact
+ * login notification needed by the lifecycle owner.
+ */
+export class CodexLoginWire {
+  private readonly transport: JsonRpcLineTransport
+  private readonly inputGuard: BoundedJsonlInput
+  private readonly fatal = Promise.withResolvers<never>()
+  private expectedLoginId: string | undefined
+  private closed = false
+  private completed = false
+  private failed = false
+
+  constructor(
+    input: Readable,
+    output: Writable,
+    private readonly onCompleted: (event: CodexChatgptLoginCompleted) => void,
+    private readonly onFailure: (error: CodexRuntimeError) => void,
+  ) {
+    this.inputGuard = new BoundedJsonlInput(input, (error) => { this.fail(error) })
+    this.transport = new JsonRpcLineTransport(this.inputGuard.stream(), output)
+    void this.fatal.promise.catch(() => {})
+    this.transport.onRequest(() => {
+      this.fail(new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex login sent an unsupported request'))
+      return Promise.reject(new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex login sent an unsupported request'))
+    })
+    this.transport.onNotification((method, params) => {
+      try {
+        this.handleNotification(method, params)
+      } catch (error: unknown) {
+        this.fail(error instanceof CodexRuntimeError
+          ? error
+          : new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex login notification was invalid'))
+      }
+    })
+    output.on('error', () => { this.fail(new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex login output failed')) })
+  }
+
+  start(): void { this.transport.start() }
+
+  async initialize(signal: AbortSignal): Promise<void> {
+    return initializeAppServerTransport(this.inputGuard, this.transport, signal, this.fatal.promise)
+  }
+
+  async startChatgpt(signal: AbortSignal): Promise<string> {
+    if (this.expectedLoginId !== undefined || this.completed || this.closed) {
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex login was already started')
+    }
+    this.inputGuard.resetOperation()
+    const response = asObject(await safeRequest(this.transport.request('account/login/start', { type: 'chatgpt' }), signal, this.fatal.promise), 'account login response')
+    if (response.type !== 'chatgpt') throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex did not start ChatGPT login')
+    const officialLoginId = opaqueId(response.loginId, 'login id')
+    const authUrl = validateChatgptAuthUrl(response.authUrl)
+    this.expectedLoginId = officialLoginId
+    return authUrl
+  }
+
+  async cancelChatgpt(signal: AbortSignal): Promise<void> {
+    const loginId = this.expectedLoginId
+    if (loginId === undefined || this.completed || this.closed) {
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex login was not pending')
+    }
+    this.inputGuard.resetOperation()
+    await safeRequest(this.transport.request('account/login/cancel', { loginId }), signal, this.fatal.promise)
+  }
+
+  close(): void {
+    if (this.closed) return
+    this.closed = true
+    this.inputGuard.close()
+    this.transport.close()
+  }
+
+  private handleNotification(method: string, params: unknown): void {
+    // The official peer broadcasts this global status snapshot while a login
+    // process starts. It is unrelated to DSH login state; intentionally do
+    // not inspect its payload (which includes machine/account metadata).
+    if (method === 'remoteControl/status/changed') return
+    if (method === 'account/updated') {
+      const value = asObject(params, 'account update')
+      const keys = Object.keys(value)
+      if (keys.length > 32 || keys.some(key => key.length === 0 || key.length > 128)) {
+        throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex account update was invalid')
+      }
+      return
+    }
+    if (method !== 'account/login/completed') {
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex login sent an unknown notification')
+    }
+    if (this.completed) throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex login completed twice')
+    const value = asObject(params, 'account login completion')
+    const loginId = opaqueId(value.loginId, 'login completion id')
+    if (this.expectedLoginId === undefined || loginId !== this.expectedLoginId) {
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex login completion did not match the active login')
+    }
+    if (typeof value.success !== 'boolean') {
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex login completion status was invalid')
+    }
+    if (value.error !== null && typeof value.error !== 'string') {
+      throw new CodexRuntimeError('CODEX_PROTOCOL_ERROR', 'Codex login completion error was invalid')
+    }
+    this.completed = true
+    this.onCompleted({ success: value.success })
+  }
+
+  private fail(error: CodexRuntimeError): void {
+    if (this.failed || this.closed) return
+    this.failed = true
+    const sanitized = error instanceof CodexRuntimeError
+      ? error
+      : new CodexRuntimeError('CODEX_PROCESS_ERROR', 'Codex login process failed')
+    this.fatal.reject(sanitized)
+    this.onFailure(sanitized)
+  }
+}
diff --git a/packages/core/agent-runtime-codex/tests/fixtures/fake-app-server.mjs b/packages/core/agent-runtime-codex/tests/fixtures/fake-app-server.mjs
