+class ScriptedAdapter extends LlmAdapter {
+  readonly requests: GenerateOptions[] = []
+
+  override async *stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    this.requests.push(options)
+    yield { type: 'block-start', index: 0, blockType: 'text' }
+    yield { type: 'block-end', index: 0, block: { type: 'text', text: 'bounded response' } }
+    yield { type: 'finish', reason: { kind: 'stop' } }
+  }
+}
+
+class ProjectLoopReviewAdapter extends ScriptedAdapter {
+  constructor(private readonly alwaysRequestRevision = false) {
+    super()
+  }
+
+  private readonly reviewedTasks = new Set<string>()
+  private reviewCount = 0
+
+  override async *stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    const prompt = JSON.stringify(options.messages ?? [])
+    const matches = [...prompt.matchAll(/Task: ([A-Za-z0-9._:-]+)/gu)]
+    const taskId = matches.at(-1)?.[1]
+    if (prompt.includes('DevFrame independent review context') && taskId !== undefined
+      && !this.reviewedTasks.has(taskId)) {
+      this.reviewedTasks.add(taskId)
+      const reviewNumber = this.reviewCount++
+      const verdict = this.alwaysRequestRevision || reviewNumber === 0
+        ? 'request_revision' : 'pass'
+      const argumentsJson = JSON.stringify({
+        verdict,
+        findings: verdict === 'pass' ? 'The bounded revision is independently acceptable.' : 'The first execution requires one bounded revision.',
+      })
+      const id = CallId(`loop-review-submit-${reviewNumber}`)
+      yield { type: 'block-start', index: 0, blockType: 'tool-call' }
+      yield { type: 'tool-call-delta', index: 0, id, name: 'devframe_submit_review', argumentsDelta: argumentsJson }
+      yield { type: 'block-end', index: 0, block: { type: 'tool-call', id, name: 'devframe_submit_review', arguments: argumentsJson } }
+      yield { type: 'finish', reason: { kind: 'tool-calls' } }
+      return
+    }
+    yield* super.stream(options)
+  }
+}
