+import type { Browser, Page } from 'playwright'
+import { chromium } from 'playwright'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+import { newEnglishPage } from './support.ts'
+
+const LIVE_ENABLED = process.env.DSH_LIVE_CODEX_SMOKE === '1'
+const LIVE_BASE_URL = process.env.DSH_LIVE_BASE_URL ?? 'http://127.0.0.1:4569'
+const FIRST_MARKER = 'DF-LIVE-CODEX-ROUND-1'
+const SECOND_MARKER = 'DF-LIVE-CODEX-ROUND-2'
+
+function assertLoopbackUrl(value: string): string {
+  let url: URL
+  try {
+    url = new URL(value)
+  } catch {
+    throw new Error('DSH live smoke requires a valid local DSH base URL')
+  }
+  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
+    throw new Error('DSH live smoke accepts only HTTP(S)')
+  }
+  if (!['127.0.0.1', 'localhost', '[::1]'].includes(url.hostname)) {
+    throw new Error('DSH live smoke accepts only a loopback DSH endpoint')
+  }
+  return url.href.replace(/\/$/u, '')
+}
+
+function assistantSteps(page: Page) {
+  return page.locator('[data-chat-flow-kind="assistant-step"]')
+}
+
+async function assertNoViteOverlay(page: Page): Promise<void> {
+  expect(await page.locator('vite-error-overlay').count()).toBe(0)
+  expect(await page.locator('[data-vite-error-overlay]').count()).toBe(0)
+}
+
+async function openNewConversation(page: Page): Promise<void> {
+  const newSession = page.getByRole('button', { name: /^(New session|新会话)$/u }).first()
+  await newSession.waitFor({ timeout: 20_000 })
+  await newSession.click()
+  const composer = page.locator('textarea:enabled').first()
+  if (await composer.count() > 0) return
+
+  // A running DSH may require choosing one of its already registered
+  // workspaces before the new conversation becomes writable. Never browse the
+  // filesystem here: use only the existing workspace picker surface.
+  const picker = page.getByRole('textbox', { name: /^(Choose workspace|选择工作区)$/u })
+  if (await picker.count() === 0) {
+    throw new Error('DSH live smoke could not open a writable conversation')
+  }
+  await picker.click()
+  const dialog = page.getByRole('dialog').last()
+  await dialog.waitFor({ timeout: 15_000 })
+  const options = dialog.locator('[role="option"], [role="treeitem"]')
+  if (await options.count() === 0) {
+    throw new Error('DSH live smoke found no registered workspace')
+  }
+  await options.first().click()
+  await page.locator('textarea:enabled').first().waitFor({ timeout: 15_000 })
+}
+
+async function selectCodexModel(page: Page, index: number): Promise<string> {
+  const trigger = page.getByRole('button', { name: /^Select model, current /u }).first()
+  await trigger.waitFor({ timeout: 20_000 })
+  await trigger.click()
+  const menu = page.locator('[role="menu"]').last()
+  await menu.waitFor({ timeout: 10_000 })
+  const loginAction = menu.getByRole('button', { name: /Get login link|Open ChatGPT login/u }).first()
+  if (await loginAction.count() > 0) {
+    throw new Error('DSH live smoke reports login required; no OAuth action was opened')
+  }
+  // The shipped composer opens a two-level picker: the first menu exposes a
+  // `Model`/`模型` row, and the provider groups are mounted after that row is
+  // activated. Keep the live probe aligned with the real UI instead of
+  // treating the provider groups as direct children of the trigger menu.
+  const modelEntry = menu.getByRole('menuitem', { name: /^(Model|模型)(?:\s|$)/u }).first()
+  if (await modelEntry.count() > 0) {
+    await modelEntry.click()
+  }
+  // Opening the row can move the provider groups into a sibling popup, so
+  // resolve the visible group from the page rather than pinning it to the
+  // first-level menu element.
+  // Provider-group labels are localized and may be rendered in a sibling
+  // popup. The Codex catalog itself has a stable GPT- model-name prefix, so
+  // use the visible radio items as the contract and keep the assertion
+  // independent of the menu's presentation hierarchy.
+  const models = page.getByRole('menuitemradio').filter({ hasText: /GPT-/u })
+  await expect.poll(() => models.count(), { timeout: 20_000 }).toBeGreaterThan(0)
+  const count = await models.count()
+  if (count <= index) {
+    throw new Error(`DSH live smoke exposes ${count} Codex model(s); model switching needs at least ${index + 1}`)
+  }
+  const model = models.nth(index)
+  const name = (await model.innerText()).trim()
+  await model.click()
+  await expect.poll(() => trigger.getAttribute('aria-label'), { timeout: 15_000 }).toContain(name)
+  return name
+}
+
+async function waitForAssistantAnswer(
+  page: Page,
+  marker: string,
+): Promise<{ readonly text: string; readonly ttftMs: number }> {
+  const steps = assistantSteps(page)
+  await expect.poll(() => steps.count(), { timeout: 30_000 }).toBeGreaterThan(0)
+  const { ttftMs } = await page.evaluate(async (expectedMarker) => {
+    const startedAt = performance.now()
+    return await new Promise<{ readonly ttftMs: number }>((resolve, reject) => {
+      let streamingSeen = false
+      let settled = false
+      function inspect(): void {
+        if (document.querySelector('[data-streaming="true"]') !== null) streamingSeen = true
+        const assistants = document.querySelectorAll('[data-chat-flow-kind="assistant-step"]')
+        const text = assistants.item(assistants.length - 1)?.textContent ?? ''
+        if (!streamingSeen || !text.includes(expectedMarker) || settled) return
+        settled = true
+        window.clearTimeout(timeout)
+        observer.disconnect()
+        resolve({ ttftMs: performance.now() - startedAt })
+      }
+      const observer = new MutationObserver(() => { inspect() })
+      const timeout = window.setTimeout(() => {
+        if (settled) return
+        settled = true
+        observer.disconnect()
+        reject(new Error('DSH live smoke saw no streamed assistant marker'))
+      }, 120_000)
+      observer.observe(document.body, { attributes: true, childList: true, characterData: true, subtree: true })
+      inspect()
+    })
+  }, marker)
+  const assistant = steps.last()
+  await expect.poll(() => page.locator('[data-streaming="true"]').count(), { timeout: 120_000 })
+    .toBe(0)
+  const text = ((await assistant.textContent()) ?? '').trim().replace(/\r\n/gu, '\n')
+  expect(text).toContain(marker)
+  expect(text.split(marker).length - 1).toBe(1)
+  return { text, ttftMs }
+}
+
+describe.skipIf(!LIVE_ENABLED)('live e2e: GPT subscription Codex', () => {
+  let browser: Browser | undefined
+  let page: Page
+  const pageErrors: string[] = []
+  const warnings: string[] = []
+  let liveUrl: string
+
+  beforeAll(async () => {
+    liveUrl = assertLoopbackUrl(LIVE_BASE_URL)
+    browser = await chromium.launch()
+    page = await newEnglishPage(browser)
+    page.on('pageerror', (error) => { pageErrors.push(error.message) })
+    page.on('console', (message) => {
+      if (message.type() === 'warning') warnings.push(message.text())
+    })
+    await page.goto(liveUrl, { waitUntil: 'load' })
+    await page.getByRole('button', { name: /^(Global Controller|总控)$/u }).waitFor({ timeout: 30_000 })
+    await openNewConversation(page)
+  }, 180_000)
+
+  afterAll(async () => {
+    await browser?.close()
+  })
+
+  it('streams before completion, switches models, and preserves the same conversation after reload', async () => {
+    const firstModel = await selectCodexModel(page, 0)
+    const firstComposer = page.locator('textarea:enabled').last()
+    await firstComposer.fill([
+      'Do not call tools. Reply with exactly five short lines.',
+      `Include the exact marker ${FIRST_MARKER} once on the first line.`,
+      'Keep the remaining lines concise.',
+    ].join(' '))
+    const firstSentAt = performance.now()
+    await firstComposer.press('Enter')
+    const first = await waitForAssistantAnswer(page, FIRST_MARKER)
+    const firstElapsedMs = performance.now() - firstSentAt
+    expect(first.ttftMs).toBeGreaterThanOrEqual(0)
+    expect(firstElapsedMs).toBeGreaterThanOrEqual(first.ttftMs)
+
+    const secondModel = await selectCodexModel(page, 1)
+    expect(secondModel).not.toBe(firstModel)
+    const secondComposer = page.locator('textarea:enabled').last()
+    await secondComposer.fill([
+      'Do not call tools. Continue this same conversation in one short line.',
+      `Repeat ${FIRST_MARKER} exactly once and append ${SECOND_MARKER}.`,
+    ].join(' '))
+    await secondComposer.press('Enter')
+    const second = await waitForAssistantAnswer(page, SECOND_MARKER)
+    expect(second.text).toContain(FIRST_MARKER)
+    expect(second.text.split(FIRST_MARKER).length - 1).toBe(1)
+
+    await page.reload({ waitUntil: 'load' })
+    await page.getByRole('button', { name: /^(Global Controller|总控)$/u }).waitFor({ timeout: 30_000 })
+    await expect.poll(async () => (await page.locator('body').innerText()).includes(FIRST_MARKER), {
+      timeout: 60_000,
+      message: 'DSH live smoke conversation did not survive reload',
+    }).toBe(true)
+    const body = await page.locator('body').innerText()
+    expect(body).toContain(SECOND_MARKER)
+    expect(body).not.toMatch(/raw provider error|auth\.json|cookie|access[_ -]?token/iu)
+    await assertNoViteOverlay(page)
+    expect(pageErrors).toEqual([])
+    expect(warnings).toEqual([])
+  }, 300_000)
+})
