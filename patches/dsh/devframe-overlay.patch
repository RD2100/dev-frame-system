+        return true
+      },
+    }
+  }
+
+  release(): void {
+    this.respondToRequests = true
+    for (const [id, request] of this.pending) this.respond(request.output, id, request.method)
+    this.pending.clear()
+  }
+
+  spawnTerminal(_spec: SubprocessTerminalSpawnSpec): Promise<SubprocessTerminalHandle> {
+    return Promise.reject(new Error('capability fixture does not spawn terminals'))
+  }
