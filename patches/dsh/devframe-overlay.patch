+describe.skipIf(MODE === 'record')('web e2e: CodeGraph context preview', () => {
+  let scaffold: WebScaffold
+  let browser: Browser
+  let page: Page
+  let tripwire: ReturnType<typeof watchConsole>
+
+  beforeAll(async () => {
+    scaffold = await launchWebScaffold({ extraOverlayPath: DEVFRAME_PATCH_PATH })
+    await seedSession(scaffold, await readFile(SEED, 'utf8'), SEED_ID)
+    browser = await chromium.launch()
+  }, 120_000)
+
+  afterAll(async () => {
+    await browser?.close()
+    await scaffold?.close()
+  })
+
+  it('opens the bounded graph in details without raw payload or browser errors', async () => {
+    onTestFailed(() => saveFailureShot(page, 'web-e2e-graph-context-preview'))
+    page = await newEnglishPage(browser)
+    tripwire = watchConsole(page)
+    const sessionBaseline = page.waitForResponse(response => (
+      response.request().method() === 'POST'
+      && new URL(response.url()).pathname === '/api/session.list'
+    ), { timeout: 30_000 })
+    await page.goto(scaffold.baseUrl, { waitUntil: 'load' })
+    await sessionBaseline
+
+    const searchButton = page.getByRole('button', { name: 'Search sessions' })
+    await searchButton.waitFor({ timeout: 30_000 })
+    if (await searchButton.getAttribute('aria-expanded') !== 'true') await searchButton.click()
+    const search = page.getByPlaceholder('Search sessions', { exact: false })
+    await search.fill('Open the CodeGraph context')
+    const result = page.getByRole('tree', { name: 'Search results' }).getByRole('treeitem')
+    await expect.poll(() => result.count(), { timeout: 20_000 }).toBe(1)
+    await result.click()
+    const chatTab = page.getByRole('tab', { name: 'Chat', exact: true })
+    await chatTab.click()
+    await expect.poll(() => chatTab.getAttribute('aria-selected')).toBe('true')
+
+    const graphRow = page.locator('[data-tool="devframe_codegraph_context"]').first()
+    await graphRow.waitFor({ timeout: 20_000 })
+    await graphRow.click()
+    await graphRow.getByRole('button', { name: 'View details', exact: true }).click()
+
+    const details = page.locator('[data-graph-state="ready"]')
+    await details.waitFor({ timeout: 15_000 })
+    await details.getByText('CodeGraph context preview', { exact: true }).waitFor()
+    await details.getByText('Untrusted project context', { exact: true }).waitFor()
+    await details.getByText('buildGraph', { exact: true }).waitFor()
+    expect(await details.locator('pre').count()).toBe(0)
+    expect(await details.locator('[data-testid="codegraph-canvas"]').count()).toBe(1)
+
+    await page.setViewportSize({ width: 390, height: 900 })
+    await details.getByText('CodeGraph context preview', { exact: true }).waitFor()
+    const viewport = await page.evaluate(() => ({
+      clientWidth: document.documentElement.clientWidth,
+      scrollWidth: document.documentElement.scrollWidth,
+    }))
+    expect(viewport.scrollWidth).toBeLessThanOrEqual(viewport.clientWidth + 1)
+    expect(await details.locator('[data-testid="codegraph-canvas"]').count()).toBe(1)
+
+    expect({ pageErrors: tripwire.pageErrors, warnings: tripwire.warnings }).toEqual({ pageErrors: [], warnings: [] })
+  }, 90_000)
+})
