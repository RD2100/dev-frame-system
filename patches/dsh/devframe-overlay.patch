diff --git a/packages/client/ui-devframe-control-session/src/client/GlobalDispatchPanel.tsx b/packages/client/ui-devframe-control-session/src/client/GlobalDispatchPanel.tsx
new file mode 100644
index 0000000000..d398bcaef9
--- /dev/null
+++ b/packages/client/ui-devframe-control-session/src/client/GlobalDispatchPanel.tsx
@@ -0,0 +1,101 @@
+import type { PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type {
+  DevFrameLoopReview, DevFrameMemoryStatus,
+} from '@deepseek-ai/dsh-devframe-control-session/types'
+import type { ControlSessionKey } from './locales.ts'
+import type { LoopChatStatus } from './loop-definition.ts'
+import type { ObjectiveChatStatus } from './objective-definition.ts'
+import css from './GlobalDispatchPanel.module.css'
+
+type ObjectivePanelProps = PropsRuntime<'conversation.chat.node', 'devframe-objective'>
+  & PropsLocale<'client-ui-devframe-control-session'>
+
+type LoopPanelProps = PropsRuntime<'conversation.chat.node', 'devframe-loop'>
+  & PropsLocale<'client-ui-devframe-control-session'>
+
+function objectiveStatus(status: ObjectiveChatStatus, t: ObjectivePanelProps['t']): string {
+  switch (status) {
+    case 'created': return t('objective.created')
+    case 'routed': return t('objective.routed')
+    case 'completed': return t('objective.completed')
+    case 'cancelled': return t('objective.cancelled')
+    default: return status satisfies never
+  }
+}
+
+function loopStatus(status: LoopChatStatus, t: LoopPanelProps['t']): string {
+  switch (status) {
+    case 'running': return t('loop.running')
+    case 'completed': return t('loop.completed')
+    case 'failed': return t('loop.failed')
+    case 'aborted': return t('loop.aborted')
+    default: return status satisfies never
+  }
+}
+
+function loopReview(review: DevFrameLoopReview, t: LoopPanelProps['t']): string {
+  switch (review) {
+    case 'pending': return t('loop.review.pending')
+    case 'passed': return t('loop.review.passed')
+    case 'failed': return t('loop.review.failed')
+    default: return review satisfies never
+  }
+}
+
+const MEMORY_KEYS: Record<DevFrameMemoryStatus, ControlSessionKey> = {
+  unknown: 'loop.memory.unknown',
+  current: 'loop.memory.current',
+  missing: 'loop.memory.missing',
+  stale: 'loop.memory.stale',
+  captured: 'loop.memory.captured',
+  duplicate: 'loop.memory.duplicate',
+  unavailable: 'loop.memory.unavailable',
+  failed: 'loop.memory.failed',
+}
+
+/** Durable objective receipt rendered in the Global conversation. */
+export function ObjectivePanel({ node, t }: ObjectivePanelProps) {
+  return (
+    <section className={css.root} data-devframe-objective data-status={node.data.status}>
+      <div className={css.heading}>
+        <span className={css.kind}>{t('objective.title')}</span>
+        <span className={css.status}>{objectiveStatus(node.data.status, t)}</span>
+      </div>
+      <p className={css.text}>{node.data.text}</p>
+      {node.data.workspaceId !== undefined && (
+        <div className={css.meta}>
+          <span>{t('objective.project')}</span>
+          <code>{node.data.workspaceId}</code>
+        </div>
+      )}
+    </section>
+  )
+}
+
+/** Durable Host loop receipt rendered beside the routed objective. */
+export function LoopPanel({ node, t }: LoopPanelProps) {
+  return (
+    <section className={css.root} data-devframe-loop data-status={node.data.status}>
+      <div className={css.heading}>
+        <span className={css.kind}>{t('loop.title')}</span>
+        <span className={css.status}>{loopStatus(node.data.status, t)}</span>
+      </div>
+      <div className={css.meta}>
+        <span>{t('loop.project')}</span>
+        <code>{node.data.projectId}</code>
+      </div>
+      {node.data.review !== undefined && (
+        <div className={css.meta}>
+          <span>{t('loop.review')}</span>
+          <span>{loopReview(node.data.review, t)}</span>
+        </div>
+      )}
+      {node.data.memoryStatus !== undefined && (
+        <div className={css.meta}>
+          <span>{t('loop.memoryStatus')}</span>
+          <span>{t(MEMORY_KEYS[node.data.memoryStatus])}</span>
+        </div>
+      )}
+    </section>
+  )
+}
