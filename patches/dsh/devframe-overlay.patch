+describe('Global Controller readiness remote projection', () => {
+  /** Mock browser context whose non-strict `get` resolves the mounted face. */
+  const readinessCtx = (face: unknown): Context => ({
+    get: (name: string, _strict?: boolean) =>
+      name === 'remote.devframeControlSessions' ? face : undefined,
+    remote: {},
+  }) as unknown as Context
+
+  it('uses the Host readiness snapshot and advances the exact revision cursor', async () => {
+    const readiness = vi.fn()
+      .mockResolvedValueOnce({
+        ok: true,
+        value: {
+          status: 'ready',
+          generation: 4,
+          revision: 7,
+          sessionId: 'devframe-global:profile-current',
+        },
+      })
+      .mockImplementation(() => new Promise(() => {}))
+    const controller = new GlobalControllerReadiness()
+    controller.start(readinessCtx({ readiness }))
+    await vi.waitFor(() => {
+      expect(controller.store.getSnapshot()).toMatchObject({
+        status: 'ready',
+        sessionId: 'devframe-global:profile-current',
+      })
+    })
+    expect(readiness).toHaveBeenNthCalledWith(1, -1, expect.any(AbortSignal))
+    expect(readiness).toHaveBeenNthCalledWith(2, 7, expect.any(AbortSignal))
+    controller.stop()
+  })
+
+  it('fails closed on a remote failure and fences a late response after disposal', async () => {
+    const absent = new GlobalControllerReadiness(10, 3)
+    absent.start(readinessCtx(undefined))
+    await vi.waitFor(() => {
+      expect(absent.store.getSnapshot()).toMatchObject({
+        status: 'blocked',
+        code: 'CONTROLLER_UNAVAILABLE',
+      })
+    })
+    absent.stop()
+
+    const failure = vi.fn().mockResolvedValue({ ok: false, error: { code: 'unavailable' } })
+    const controller = new GlobalControllerReadiness(10, 3)
+    controller.start(readinessCtx({ readiness: failure }))
+    await vi.waitFor(() => {
+      expect(controller.store.getSnapshot()).toMatchObject({
+        status: 'blocked',
+        code: 'CONTROLLER_UNAVAILABLE',
+      })
+    })
+
+    let resolveLate: ((value: unknown) => void) | undefined
+    const late = vi.fn().mockImplementation(() => new Promise((resolve) => { resolveLate = resolve }))
+    controller.start(readinessCtx({ readiness: late }))
+    controller.stop()
+    resolveLate?.({
+      ok: true,
+      value: {
+        status: 'ready',
+        generation: 8,
+        revision: 9,
+        sessionId: 'devframe-global:profile-old',
+      },
+    })
+    await Promise.resolve()
+    expect(controller.store.getSnapshot().status).toBe('starting')
+  })
+
+  it('waits out the browser startup race when the Remote face mounts late', async () => {
+    // The `api-remotes` mount is async while this plugin's apply is
+    // synchronous: the first poll sees no face, a later poll must find it.
+    let mounted = false
+    const readinessMock = vi.fn()
+      .mockResolvedValueOnce({
+        ok: true,
+        value: {
+          status: 'ready',
+          generation: 2,
+          revision: 3,
+          sessionId: 'devframe-global:profile-late-mount',
+        },
+      })
+      .mockImplementation(() => new Promise(() => {}))
+    const ctx = {
+      get: (name: string, _strict?: boolean) => {
+        if (name !== 'remote.devframeControlSessions') return undefined
+        return mounted ? { readiness: readinessMock } : undefined
+      },
+      remote: {},
+    }
+    const controller = new GlobalControllerReadiness(10, 100)
+    controller.start(ctx as never)
+    await Promise.resolve()
+    // Still retrying while the face is absent — not failed closed.
+    expect(controller.store.getSnapshot().status).toBe('starting')
+    mounted = true
+    await vi.waitFor(() => {
+      expect(controller.store.getSnapshot()).toMatchObject({
+        status: 'ready',
+        sessionId: 'devframe-global:profile-late-mount',
+      })
+    })
+    expect(readinessMock).toHaveBeenCalledWith(-1, expect.any(AbortSignal))
+    controller.stop()
+  })
+
+  it('recovers from transient Host failures instead of failing closed', async () => {
+    const readiness = vi.fn()
+      .mockResolvedValueOnce({ ok: false, error: { code: 'unavailable' } })
+      .mockResolvedValueOnce({
+        ok: true,
+        value: {
+          status: 'ready',
+          generation: 5,
+          revision: 6,
+          sessionId: 'devframe-global:profile-recovered',
+        },
+      })
+      .mockImplementation(() => new Promise(() => {}))
+    const controller = new GlobalControllerReadiness(10, 100)
+    controller.start(readinessCtx({ readiness }))
+    await vi.waitFor(() => {
+      expect(controller.store.getSnapshot()).toMatchObject({
+        status: 'ready',
+        sessionId: 'devframe-global:profile-recovered',
+      })
+    })
+    controller.stop()
+  })
+})
