+    expect(section).not.toHaveBeenCalled()
+  })
+
+  it('runs through the real AgentLoop and logs recall before the first request', async () => {
+    memory.readProjectMemory.mockResolvedValue(currentPlan())
+    const adapter = new MockAdapter([textResponse('done')])
+    const { ctx, agent } = await loopHarness(adapter)
+
+    agent.followup(createUserMessage({
+      content: [{ type: 'text', text: 'go' }],
+      source: { kind: 'user' },
+    }))
+    await agent.whenIdle()
+
+    const recallEvents = agent.session.events.filter(event => (
+      event.type === 'user/message'
+      && event.data.source.kind === 'plugin'
+      && event.data.source.plugin === 'devframe-memory'
+    ))
+    const firstStep = agent.session.events.find(event => event.type === 'step/start')
+    expect(recallEvents).toHaveLength(1)
+    expect(firstStep?.type).toBe('step/start')
+    expect(recallEvents[0]!.seq).toBeGreaterThan(firstStep!.seq)
+    expect(requestText(adapter.requests[0]!)).toContain('Governed Working Plan')
+    expect(agent.session.events.filter(event => event.type === 'request/header')).toHaveLength(1)
+    expect(JSON.stringify(agent.session.events.filter(event => event.type === 'request/header')))
+      .not.toContain('Governed Working Plan')
+    expect(memory.readProjectMemory).toHaveBeenCalledTimes(1)
+    void ctx
