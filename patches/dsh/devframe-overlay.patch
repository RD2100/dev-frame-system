+
+// Slice 1B delivery attribution (design §11.3): the Host relays a fixed test
+// payload into the Worker inbox with the same `coordinator/relay` source the
+// subagent-control `send_message` seam already proved (the sender session is
+// the Global Controller, never a free-text Agent name).
+declare module '@deepseek-ai/dsh-llm' {
+  interface MessageSourceMap {
+    coordinator: {
+      readonly kind: 'coordinator'
+      readonly form: 'relay'
+      readonly senderSessionId: SessionId
+    }
+  }
+}
+
+export * from './types.ts'
+export * from './profile-fence.ts'
+export * from './goal-route.ts'
+export * from './roster.ts'
+export * from './task-board.ts'
+export * from './review.ts'
